+                    put_stream_pending_token,
+                    put_stream_value_off,
+                    put_stream_total_len,
+                    put_stream_tail_begin,
+                    put_stream_host_generation,
+                    put_stream_host_dst,
+                    max_keys,
+                    dir_entry_stride,
+                    dir_gen,
+                    commit_entry_staging_addr,
+                    noc_index,
+                    stage_pcie_xy_enc,
+                    value_gen,
