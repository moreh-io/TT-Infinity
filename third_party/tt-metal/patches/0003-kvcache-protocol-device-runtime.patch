+#ifndef KVM_SERVER_PUT_LEASE_EVICT
+#define KVM_SERVER_PUT_LEASE_EVICT 1
+#endif
+static_assert(
+    KVM_SERVER_PUT_LEASE_EVICT == 0 || KVM_SERVER_PUT_LEASE_EVICT == 1, "KVM_SERVER_PUT_LEASE_EVICT must be 0 or 1");
+constexpr bool kPutLeaseCanEvict = KVM_SERVER_PUT_LEASE_EVICT != 0;
+#ifndef KVM_SERVER_PUT_LEASE_EVICT_ON_REPEAT_ONLY
+#define KVM_SERVER_PUT_LEASE_EVICT_ON_REPEAT_ONLY 1
+#endif
+static_assert(
+    KVM_SERVER_PUT_LEASE_EVICT_ON_REPEAT_ONLY == 0 || KVM_SERVER_PUT_LEASE_EVICT_ON_REPEAT_ONLY == 1,
+    "KVM_SERVER_PUT_LEASE_EVICT_ON_REPEAT_ONLY must be 0 or 1");
+constexpr bool kPutLeaseEvictOnRepeatOnly = KVM_SERVER_PUT_LEASE_EVICT_ON_REPEAT_ONLY != 0;
+
+// Read host memory into L1 over the NoC in NOC_MAX_BURST_SIZE bursts. src_addr is the host buffer's
+// 64-bit local offset, which can exceed 32 bits, so the stateful
+// 64-bit read is required (the plain noc_async_read local-address form cannot carry it). read_cmd_buf is
+// fully reprogrammed each call (CQ_NOC_SNDL), so this interleaves safely with ordinary reads/writes. The
+// caller drains with a read barrier.
+FORCE_INLINE void kvm_wide_read_sysmem(
+    uint32_t noc, uint64_t src_noc_encoding, uint64_t src_addr, uint32_t dst_addr, uint32_t len_bytes) {
+    while (len_bytes > NOC_MAX_BURST_SIZE) {
+        noc_read_with_state<noc_mode, read_cmd_buf, CQ_NOC_SNDL, CQ_NOC_SEND, CQ_NOC_WAIT>(
+            noc, src_noc_encoding, src_addr, dst_addr, NOC_MAX_BURST_SIZE);
+        len_bytes -= NOC_MAX_BURST_SIZE;
+        src_addr += NOC_MAX_BURST_SIZE;
+        dst_addr += NOC_MAX_BURST_SIZE;
+    }
+    noc_read_with_state<noc_mode, read_cmd_buf, CQ_NOC_SNDL, CQ_NOC_SEND, CQ_NOC_WAIT>(
+        noc, src_noc_encoding, src_addr, dst_addr, len_bytes);
+}
+
+// Gather a range of interleaved device-heap units and append it to a contiguous mapped-host value.
+// batch_index persists across ranges so the same two scratch halves pipeline ordinary and streamed pushes.
+FORCE_INLINE void kvm_push_chunk_range(
+    uint32_t noc,
+    uint32_t base_unit,
+    uint32_t total_len,
+    uint32_t begin_chunk,
+    uint32_t end_chunk,
+    uint32_t stage_pcie_xy_enc,
+    uint64_t host_dst,
+    const InterleavedAddrGen<true>& value_gen,
+    uint32_t scratch,
+    uint32_t& batch_index) {
+    for (uint32_t base = begin_chunk; base < end_chunk; base += kMovePushBatch, ++batch_index) {
+        const uint32_t this_batch = (end_chunk - base < kMovePushBatch) ? (end_chunk - base) : kMovePushBatch;
+        const uint32_t half = (batch_index & 1u) * kMovePushBatch * kMaxChunkValueBytes;
+        for (uint32_t k = 0; k < this_batch; ++k) {
+            const uint32_t stream_pos = (base + k) * kMaxChunkValueBytes;
+            const uint32_t remaining = total_len - stream_pos;
+            const uint32_t chunk_bytes = (remaining < kMaxChunkValueBytes) ? remaining : kMaxChunkValueBytes;
+            noc_async_read(
+                value_gen.get_noc_addr(base_unit + base + k, 0),
+                scratch + half + k * kMaxChunkValueBytes,
+                (chunk_bytes + 31u) & ~31u);
+        }
+        noc_async_read_barrier();
+        if (batch_index != 0) {
+            noc_async_write_barrier();
+        }
+
+        const uint32_t batch_span = this_batch * kMaxChunkValueBytes;
+        const uint32_t batch_left = total_len - base * kMaxChunkValueBytes;
+        uint32_t write_bytes = (batch_span < batch_left) ? batch_span : batch_left;
+        write_bytes = (write_bytes + 31u) & ~31u;
+        uint32_t src = scratch + half;
+        uint64_t dst = host_dst + static_cast<uint64_t>(base) * kMaxChunkValueBytes;
+        while (write_bytes != 0) {
+            const uint32_t burst = (write_bytes > NOC_MAX_BURST_SIZE) ? NOC_MAX_BURST_SIZE : write_bytes;
+            noc_wwrite_with_state<noc_mode, write_cmd_buf, CQ_NOC_SNDL, CQ_NOC_SEND, CQ_NOC_WAIT, true, false>(
+                noc, src, stage_pcie_xy_enc, dst, burst, 1);
+            src += burst;
+            dst += burst;
+            write_bytes -= burst;
+        }
+    }
+}
+
+// Copy a complete device value after landed. This is the fallback for non-streamed and queued PUTs.
+FORCE_INLINE void kvm_push_evicted_value(
+    uint32_t noc,
+    uint32_t value_off,
+    uint32_t total_len,
+    uint32_t stage_pcie_xy_enc,
+    uint64_t host_dst,
+    const InterleavedAddrGen<true>& value_gen) {
+    const uint32_t num_chunks = chunk_count_for(total_len);
+    cb_reserve_back(kGetValueCbId, 2 * kMovePushBatch);
+    // Full-CB reserve makes every page available, but the ring pointer may have been rotated by a
+    // preceding GET. Raw double-buffer addressing must start at the allocation base, not that pointer.
+    const auto& scratch_cb = get_local_cb_interface(kGetValueCbId);
+    const uint32_t scratch = scratch_cb.fifo_limit - scratch_cb.fifo_size;
+    noc_write_init_state<write_cmd_buf>(noc, NOC_UNICAST_WRITE_VC);
+    uint32_t batch_index = 0;
+    kvm_push_chunk_range(
+        noc,
+        value_off / kMaxChunkValueBytes,
+        total_len,
+        0,
+        num_chunks,
+        stage_pcie_xy_enc,
+        host_dst,
+        value_gen,
+        scratch,
+        batch_index);
+    noc_async_write_barrier();
+}
+
+// Copy every complete prefix group while the client sends the following group to device DRAM.
+FORCE_INLINE bool kvm_push_streamed_prefix(
+    uint32_t noc,
+    uint32_t value_off,
+    uint32_t total_len,
+    uint32_t stage_pcie_xy_enc,
+    uint64_t host_dst,
+    const InterleavedAddrGen<true>& value_gen,
+    volatile tt_l1_ptr uint32_t* progress,
+    uint32_t& progress_seen,
+    volatile tt_l1_ptr uint32_t* termination_ptr,
+    uint32_t* tail_begin) {
+    const uint32_t num_chunks = chunk_count_for(total_len);
+    *tail_begin = ((num_chunks - 1) / kPutStreamProgressChunks) * kPutStreamProgressChunks;
+    ASSERT(*tail_begin != 0);
+    cb_reserve_back(kGetValueCbId, 2 * kMovePushBatch);
+    const auto& scratch_cb = get_local_cb_interface(kGetValueCbId);
+    const uint32_t scratch = scratch_cb.fifo_limit - scratch_cb.fifo_size;
+    noc_write_init_state<write_cmd_buf>(noc, NOC_UNICAST_WRITE_VC);
+    uint32_t batch_index = 0;
+    for (uint32_t begin = 0; begin < *tail_begin; begin += kPutStreamProgressChunks) {
+        while (true) {
+            invalidate_l1_cache();
+            if (*progress != progress_seen) {
+                ++progress_seen;
+                break;
+            }
+            if (*termination_ptr == static_cast<uint32_t>(tt::tt_fabric::TerminationSignal::IMMEDIATELY_TERMINATE)) {
+                noc_async_write_barrier();
+                return false;
+            }
+        }
+        const uint32_t end = begin + kPutStreamProgressChunks;
+        kvm_push_chunk_range(
+            noc,
+            value_off / kMaxChunkValueBytes,
+            total_len,
+            begin,
+            end,
+            stage_pcie_xy_enc,
+            host_dst,
+            value_gen,
+            scratch,
+            batch_index);
+    }
+    noc_async_write_barrier();
+    return true;
+}
+
+// The final group is copied only after the landed fence and directory publication. Keeping this tail
+// out of the prefix preserves the true landed completion boundary without a redundant progress event.
+FORCE_INLINE void kvm_push_streamed_tail(
+    uint32_t noc,
+    uint32_t value_off,
+    uint32_t total_len,
+    uint32_t tail_begin,
+    uint32_t stage_pcie_xy_enc,
+    uint64_t host_dst,
+    const InterleavedAddrGen<true>& value_gen) {
+    const auto& scratch_cb = get_local_cb_interface(kGetValueCbId);
+    const uint32_t scratch = scratch_cb.fifo_limit - scratch_cb.fifo_size;
+    noc_write_init_state<write_cmd_buf>(noc, NOC_UNICAST_WRITE_VC);
+    uint32_t batch_index = 0;
+    kvm_push_chunk_range(
+        noc,
+        value_off / kMaxChunkValueBytes,
+        total_len,
+        tail_begin,
+        chunk_count_for(total_len),
+        stage_pcie_xy_enc,
+        host_dst,
+        value_gen,
+        scratch,
+        batch_index);
+    noc_async_write_barrier();
+}
+
+// Publish one word into an isolated mapped-host completion cacheline. The remaining words are zeroed
+// so each use is a complete cacheline replacement; the barrier orders it after the caller's durable edge.
+__attribute__((noinline, optimize("Oz"))) void kvm_publish_host_completion(
+    uint32_t noc, uint32_t stage_pcie_xy_enc, uint64_t host_dst, uint32_t sequence, uint32_t scratch) {
+    volatile tt_l1_ptr uint32_t* words = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(scratch);
+    for (uint32_t w = 0; w < kPromoteHostCompletionBytes / sizeof(uint32_t); ++w) {
+        words[w] = 0;
+    }
+    words[0] = sequence;
+    noc_write_init_state<write_cmd_buf>(noc, NOC_UNICAST_WRITE_VC);
+    noc_wwrite_with_state<noc_mode, write_cmd_buf, CQ_NOC_SNDL, CQ_NOC_SEND, CQ_NOC_WAIT, true, false>(
+        noc, scratch, stage_pcie_xy_enc, host_dst, kPromoteHostCompletionBytes, 1);
+    noc_async_write_barrier();
+}
+
+// Pull an authoritative host value into the device cache at `new_off` during a wire MOVE_TO_DEVICE
+// commit. The source is either a pool-resident value read in place or the NoC-mapped staging window;
+// this reads it chunk by chunk and writes each heap unit via value_gen. Two CB halves overlap batch
+// N's host read with
+// batch N-1's heap writes; the write barrier after the read drains the previous half before it is
+// reused on the next turn. Read length is 32-rounded to keep the DRAM writes phase-aligned. Borrows the
+// GET value CB's L1 as scratch: the serve loop is single-threaded and this never cb_push_back's.
+FORCE_INLINE void kvm_pull_promoted_value(
+    uint32_t noc,
+    uint32_t new_off,
+    uint32_t total_len,
+    uint32_t stage_pcie_xy_enc,
+    uint64_t stage_noc_base,
+    const InterleavedAddrGen<true>& value_gen) {
+    const uint32_t base_unit = new_off / kMaxChunkValueBytes;
+    const uint32_t num_chunks = chunk_count_for(total_len);
+    // D >= 2*kMovePullBatch by layout.hpp, so both batch halves are available together.
+    cb_reserve_back(kGetValueCbId, 2 * kMovePullBatch);
+    const auto& scratch_cb = get_local_cb_interface(kGetValueCbId);
+    const uint32_t pull_scratch = scratch_cb.fifo_limit - scratch_cb.fifo_size;
+    uint32_t batch_index = 0;
+    for (uint32_t base = 0; base < num_chunks; base += kMovePullBatch, ++batch_index) {
+        const uint32_t this_batch = (num_chunks - base < kMovePullBatch) ? (num_chunks - base) : kMovePullBatch;
+        const uint32_t half = (batch_index & 1u) * kMovePullBatch * kMaxChunkValueBytes;
+        const uint32_t batch_span = this_batch * kMaxChunkValueBytes;
+        const uint32_t batch_left = total_len - base * kMaxChunkValueBytes;
+        const uint32_t batch_bytes = (batch_span < batch_left) ? batch_span : batch_left;
+        kvm_wide_read_sysmem(
+            noc,
+            stage_pcie_xy_enc,
+            stage_noc_base + static_cast<uint64_t>(base) * kMaxChunkValueBytes,
+            pull_scratch + half,
+            (batch_bytes + 31u) & ~31u);
+        noc_async_read_barrier();
+        if (batch_index != 0) {
+            noc_async_write_barrier();
+        }
+        for (uint32_t k = 0; k < this_batch; ++k) {
+            const uint32_t stream_pos = (base + k) * kMaxChunkValueBytes;
+            const uint32_t remaining = total_len - stream_pos;
+            const uint32_t chunk_value_len = (remaining < kMaxChunkValueBytes) ? remaining : kMaxChunkValueBytes;
+            const uint32_t rb = (chunk_value_len + 31u) & ~31u;
+            noc_async_write(
+                pull_scratch + half + k * kMaxChunkValueBytes, value_gen.get_noc_addr(base_unit + base + k, 0), rb);
+        }
+    }
+    noc_async_write_barrier();
+}
+
+// Request mailbox word offsets (see layout.hpp kDirReqMailbox*).
+constexpr uint32_t kReqOpWord = 0;
+constexpr uint32_t kReqKeyLenWord = 1;
+constexpr uint32_t kReqOutputCapacityWord = 2;
+constexpr uint32_t kReqAux0Word = 3;
+constexpr uint32_t kReqAux1Word = 4;
+constexpr uint32_t kReqAux2Word = 5;
+constexpr uint32_t kReqAux3Word = 6;
+constexpr uint32_t kReqKeyByteOffset = kDirReqMailboxHeaderBytes;  // 32
+
+// Bound request-priority starvation. An already-pending request wins below the watermark; when no
+// request is pending the FIFO drains immediately instead of speculating about a future arrival.
+constexpr uint32_t kPutHostQueueHighWatermark = 8;
+
+// Directory entry header word offsets (see layout.hpp directory entry layout).
+constexpr uint32_t kEntryValidWord = 0;
+constexpr uint32_t kEntryKeyLenWord = 1;
+constexpr uint32_t kEntryTotalLenWord = 2;
+constexpr uint32_t kEntryLastAccessWord = 3;
+constexpr uint32_t kEntryValueByteOffWord = 4;
+constexpr uint32_t kEntryHostGenerationWord = 5;
+constexpr uint32_t kEntryLocationWord = 6;
+constexpr uint32_t kEntryBlockOrderWord = 7;
+constexpr uint32_t kEntryKeyByteOffset = kDirEntryHeaderBytes;
+
+// Byte-compare key bytes [0,len) of two L1 regions. Returns true on full match.
+FORCE_INLINE bool key_equals(volatile tt_l1_ptr uint8_t* a, volatile tt_l1_ptr uint8_t* b, uint32_t len) {
+    for (uint32_t i = 0; i < len; ++i) {
+        if (a[i] != b[i]) {
+            return false;
+        }
+    }
+    return true;
+}
+
+// The open-addressed hash index accelerates lookup but never establishes authority: every candidate
+// is revalidated against the directory entry. See
+// ttnn/cpp/ttnn/operations/kvcache_manager/docs/design.md §4.
+
+// FNV-1a 32-bit over the key bytes.
+FORCE_INLINE uint32_t fnv1a_hash(volatile tt_l1_ptr uint8_t* key, uint32_t len) {
+    uint32_t h = 2166136261u;
+    for (uint32_t i = 0; i < len; ++i) {
+        h ^= static_cast<uint32_t>(key[i]);
+        h *= 16777619u;
+    }
+    return h;
+}
+
+// Look up key -> directory slot. Returns the slot on hit (and leaves directory[slot] in dir_staging
+// for the caller to reuse), or kBucketDirSlotEmpty on miss. num_buckets is a power of two.
+FORCE_INLINE uint32_t hashmap_lookup(
+    uint32_t key_hash,
+    volatile tt_l1_ptr uint8_t* key,
+    uint32_t key_len,
+    uint32_t num_buckets,
+    const InterleavedAddrGen<true>& hash_gen,
+    const InterleavedAddrGen<true>& dir_gen,
+    uint32_t dir_entry_stride,
+    uint32_t probe_staging,
+    uint32_t dir_staging) {
+    const uint32_t mask = num_buckets - 1;
+    uint32_t idx = key_hash & mask;
+    volatile tt_l1_ptr uint32_t* bkt = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(probe_staging);
+    for (uint32_t probe = 0; probe < num_buckets; ++probe) {
+        noc_async_read(hash_gen.get_noc_addr(idx, 0), probe_staging, kHashBucketBytes);
+        noc_async_read_barrier();
+        const uint32_t slot = bkt[kBucketDirSlotWord];
+        if (slot == kBucketDirSlotEmpty) {
+            return kBucketDirSlotEmpty;  // probe hit an empty bucket -> key absent
+        }
+        if (slot != kBucketDirSlotTombstone && bkt[kBucketKeyHashWord] == key_hash) {
+            // Candidate; confirm against the directory (the authority). Leave it in dir_staging.
+            noc_async_read(dir_gen.get_noc_addr(slot, 0), dir_staging, dir_entry_stride);
+            noc_async_read_barrier();
+            volatile tt_l1_ptr uint32_t* e = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(dir_staging);
+            if (e[kEntryValidWord] == 1 && e[kEntryKeyLenWord] == key_len) {
+                volatile tt_l1_ptr uint8_t* ek =
+                    reinterpret_cast<volatile tt_l1_ptr uint8_t*>(dir_staging + kEntryKeyByteOffset);
+                if (key_equals(ek, key, key_len)) {
+                    return slot;
+                }
+            }
+            // stale bucket or hash collision: keep probing
+        }
+        idx = (idx + 1) & mask;
+    }
+    return kBucketDirSlotEmpty;
+}
+
+// Insert key_hash -> slot into the first empty/tombstone bucket. The caller guarantees the key is not
+// already present (its old bucket was deleted on the eviction path), so this never needs to update an
+// existing live bucket for this key. Load factor <= 0.5 makes the full-table failure unreachable.
+FORCE_INLINE void hashmap_insert(
+    uint32_t key_hash,
+    uint32_t slot,
+    uint32_t num_buckets,
+    const InterleavedAddrGen<true>& hash_gen,
+    uint32_t probe_staging) {
+    const uint32_t mask = num_buckets - 1;
+    uint32_t idx = key_hash & mask;
+    volatile tt_l1_ptr uint32_t* bkt = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(probe_staging);
+    for (uint32_t probe = 0; probe < num_buckets; ++probe) {
+        noc_async_read(hash_gen.get_noc_addr(idx, 0), probe_staging, kHashBucketBytes);
+        noc_async_read_barrier();
+        const uint32_t cur = bkt[kBucketDirSlotWord];
+        if (cur == kBucketDirSlotEmpty || cur == kBucketDirSlotTombstone) {
+            bkt[kBucketKeyHashWord] = key_hash;
+            bkt[kBucketDirSlotWord] = slot;
+            const uint64_t noc = hash_gen.get_noc_addr(idx, 0);
+            noc_async_write(probe_staging, noc, kHashBucketBytes);
+            noc_async_write_barrier();
+            noc_async_read(noc, probe_staging, kHashBucketBytes);  // same-requestor write->read fence
+            noc_async_read_barrier();
+            return;
+        }
+        idx = (idx + 1) & mask;
+    }
+    ASSERT(false);  // table full: load factor invariant (<= 0.5) violated
+}
+
+// Delete the bucket that maps to target_slot (identified by key_hash + dir_slot, so a hash collision
+// on another slot is never touched). No-op if absent. Uses backward-shift (Knuth TAOCP Alg. R)
+// instead of leaving a deletion marker: later cluster entries whose home is not cyclically in
+// (hole, j] are pulled up into the hole and the final hole is emptied, so the bucket returns to empty
+// and absent-key lookups stay bounded by the true cluster length (no marker buildup that would
+// degrade a miss to O(num_buckets)). Load factor <= 0.5 guarantees an empty bucket exists, so the
+// shift always terminates at one.
+FORCE_INLINE void hashmap_delete(
+    uint32_t key_hash,
+    uint32_t target_slot,
+    uint32_t num_buckets,
+    const InterleavedAddrGen<true>& hash_gen,
+    uint32_t probe_staging) {
+    const uint32_t mask = num_buckets - 1;
+    volatile tt_l1_ptr uint32_t* bkt = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(probe_staging);
+
+    // Locate the bucket to delete (home-probe until match or empty).
+    uint32_t hole = key_hash & mask;
+    bool found = false;
+    for (uint32_t probe = 0; probe < num_buckets; ++probe) {
+        noc_async_read(hash_gen.get_noc_addr(hole, 0), probe_staging, kHashBucketBytes);
+        noc_async_read_barrier();
+        const uint32_t cur = bkt[kBucketDirSlotWord];
+        if (cur == kBucketDirSlotEmpty) {
+            return;  // absent
+        }
+        if (cur == target_slot && bkt[kBucketKeyHashWord] == key_hash) {
+            found = true;
+            break;
+        }
+        hole = (hole + 1) & mask;
+    }
+    if (!found) {
+        return;
+    }
+
+    // Backward-shift the cluster into the hole. Entry j keeps its probe reachability iff its home is
+    // cyclically in (hole, j]; otherwise it can (and must) move up to fill the hole. The `scanned`
+    // bound is defensive -- an empty bucket (load factor <= 0.5) ends the loop first.
+    uint32_t j = hole;
+    for (uint32_t scanned = 0; scanned < num_buckets; ++scanned) {
+        j = (j + 1) & mask;
+        noc_async_read(hash_gen.get_noc_addr(j, 0), probe_staging, kHashBucketBytes);
+        noc_async_read_barrier();
+        if (bkt[kBucketDirSlotWord] == kBucketDirSlotEmpty) {
+            break;  // cluster end
+        }
+        const uint32_t home = bkt[kBucketKeyHashWord] & mask;
+        const bool can_move = (hole <= j) ? (home <= hole || home > j) : (home <= hole && home > j);
+        if (can_move) {
+            noc_async_write(probe_staging, hash_gen.get_noc_addr(hole, 0), kHashBucketBytes);
+            noc_async_write_barrier();
+            hole = j;
+        }
+    }
+
+    // Empty the final hole (+ same-requestor write->read fence). probe_staging holds the trailing
+    // empty bucket; force its dir_slot word so the written bucket reads as empty regardless.
+    bkt[kBucketDirSlotWord] = kBucketDirSlotEmpty;
+    const uint64_t hole_noc = hash_gen.get_noc_addr(hole, 0);
+    noc_async_write(probe_staging, hole_noc, kHashBucketBytes);
+    noc_async_write_barrier();
+    noc_async_read(hole_noc, probe_staging, kHashBucketBytes);
+    noc_async_read_barrier();
+}
+
+FORCE_INLINE uint32_t floor_log2_u32(uint32_t value) {
+    uint32_t order = 0;
+    while (value > 1) {
+        value >>= 1;
+        ++order;
+    }
+    return order;
+}
+
+FORCE_INLINE uint32_t buddy_order_for_units(uint32_t units) {
+    uint32_t order = 0;
+    uint32_t block_units = 1;
+    while (block_units < units) {
+        block_units <<= 1;
+        ++order;
+    }
+    return order;
+}
+
+FORCE_INLINE void read_heap_block(uint32_t unit, const InterleavedAddrGen<true>& heap_meta_gen, uint32_t staging) {
+    noc_async_read(heap_meta_gen.get_noc_addr(unit, 0), staging, kHeapMetadataEntryBytes);
+    noc_async_read_barrier();
+}
+
+FORCE_INLINE void write_heap_block(
+    uint32_t unit,
+    uint32_t state,
+    uint32_t order,
+    uint32_t next,
+    uint32_t prev,
+    const InterleavedAddrGen<true>& heap_meta_gen,
+    uint32_t staging) {
+    volatile tt_l1_ptr uint32_t* block = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(staging);
+    for (uint32_t word = 0; word < kHeapMetadataEntryBytes / sizeof(uint32_t); ++word) {
+        block[word] = 0;
+    }
+    block[kHeapBlockStateWord] = state;
+    block[kHeapBlockOrderWord] = order;
+    block[kHeapBlockNextWord] = next;
+    block[kHeapBlockPrevWord] = prev;
+    noc_async_write(staging, heap_meta_gen.get_noc_addr(unit, 0), kHeapMetadataEntryBytes);
+    noc_async_write_barrier();
+}
+
+FORCE_INLINE void buddy_remove_free(
+    uint32_t unit,
+    uint32_t order,
+    volatile tt_l1_ptr uint32_t* allocator,
+    const InterleavedAddrGen<true>& heap_meta_gen,
+    uint32_t staging) {
+    read_heap_block(unit, heap_meta_gen, staging);
+    volatile tt_l1_ptr uint32_t* block = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(staging);
+    ASSERT(block[kHeapBlockStateWord] == kHeapBlockFree);
+    ASSERT(block[kHeapBlockOrderWord] == order);
+    const uint32_t next = block[kHeapBlockNextWord];
+    const uint32_t prev = block[kHeapBlockPrevWord];
+    const uint32_t neighbor_staging = staging + kHeapMetadataEntryBytes;
+
+    if (prev == kHeapFreeListNone) {
+        allocator[kHeapFreeHeadBaseWord + order] = next;
+    } else {
+        read_heap_block(prev, heap_meta_gen, neighbor_staging);
+        volatile tt_l1_ptr uint32_t* prev_block = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(neighbor_staging);
+        prev_block[kHeapBlockNextWord] = next;
+        noc_async_write(neighbor_staging, heap_meta_gen.get_noc_addr(prev, 0), kHeapMetadataEntryBytes);
+        noc_async_write_barrier();
+    }
+    if (next != kHeapFreeListNone) {
+        read_heap_block(next, heap_meta_gen, neighbor_staging);
+        volatile tt_l1_ptr uint32_t* next_block = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(neighbor_staging);
+        next_block[kHeapBlockPrevWord] = prev;
+        noc_async_write(neighbor_staging, heap_meta_gen.get_noc_addr(next, 0), kHeapMetadataEntryBytes);
+        noc_async_write_barrier();
+    }
+    write_heap_block(unit, kHeapBlockContinuation, order, kHeapFreeListNone, kHeapFreeListNone, heap_meta_gen, staging);
+}
+
+FORCE_INLINE void buddy_push_free(
+    uint32_t unit,
+    uint32_t order,
+    volatile tt_l1_ptr uint32_t* allocator,
+    const InterleavedAddrGen<true>& heap_meta_gen,
+    uint32_t staging) {
+    const uint32_t old_head = allocator[kHeapFreeHeadBaseWord + order];
+    write_heap_block(unit, kHeapBlockFree, order, old_head, kHeapFreeListNone, heap_meta_gen, staging);
+    if (old_head != kHeapFreeListNone) {
+        const uint32_t neighbor_staging = staging + kHeapMetadataEntryBytes;
+        read_heap_block(old_head, heap_meta_gen, neighbor_staging);
+        volatile tt_l1_ptr uint32_t* old = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(neighbor_staging);
+        old[kHeapBlockPrevWord] = unit;
+        noc_async_write(neighbor_staging, heap_meta_gen.get_noc_addr(old_head, 0), kHeapMetadataEntryBytes);
+        noc_async_write_barrier();
+    }
+    allocator[kHeapFreeHeadBaseWord + order] = unit;
+}
+
+FORCE_INLINE bool buddy_allocate(
+    uint32_t units,
+    uint32_t owner_slot,
+    volatile tt_l1_ptr uint32_t* allocator,
+    const InterleavedAddrGen<true>& heap_meta_gen,
+    uint32_t staging,
+    uint32_t* out_unit,
+    uint32_t* out_order) {
+    const uint32_t need_order = buddy_order_for_units(units);
+    const uint32_t max_order = allocator[kHeapAllocatorMaxOrderWord];
+    uint32_t order = need_order;
+    while (order <= max_order && allocator[kHeapFreeHeadBaseWord + order] == kHeapFreeListNone) {
+        ++order;
+    }
+    if (order > max_order) {
+        return false;
+    }
+
+    const uint32_t unit = allocator[kHeapFreeHeadBaseWord + order];
+    buddy_remove_free(unit, order, allocator, heap_meta_gen, staging);
+    while (order > need_order) {
+        --order;
+        const uint32_t split_buddy = unit + (1u << order);
+        buddy_push_free(split_buddy, order, allocator, heap_meta_gen, staging);
+    }
+    write_heap_block(unit, owner_slot, need_order, kHeapFreeListNone, kHeapFreeListNone, heap_meta_gen, staging);
+    *out_unit = unit;
+    *out_order = need_order;
+    return true;
+}
+
+FORCE_INLINE void buddy_free(
+    uint32_t unit,
+    uint32_t order,
+    uint32_t num_units,
+    volatile tt_l1_ptr uint32_t* allocator,
+    const InterleavedAddrGen<true>& heap_meta_gen,
+    uint32_t staging) {
+    const uint32_t max_order = allocator[kHeapAllocatorMaxOrderWord];
+    while (order < max_order) {
+        const uint32_t buddy = unit ^ (1u << order);
+        if (buddy >= num_units) {
+            break;
+        }
+        read_heap_block(buddy, heap_meta_gen, staging);
+        volatile tt_l1_ptr uint32_t* buddy_block = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(staging);
+        if (buddy_block[kHeapBlockStateWord] != kHeapBlockFree || buddy_block[kHeapBlockOrderWord] != order) {
+            break;
+        }
+        buddy_remove_free(buddy, order, allocator, heap_meta_gen, staging);
+        unit = (buddy < unit) ? buddy : unit;
+        ++order;
+    }
+    buddy_push_free(unit, order, allocator, heap_meta_gen, staging);
+}
+
+FORCE_INLINE void allocator_profile_add_u64(
+    volatile tt_l1_ptr uint32_t* profile, uint32_t low_word, uint32_t high_word, uint64_t value) {
+#ifdef KVM_SERVER_ALLOCATOR_PROFILE
+    const uint32_t old_low = profile[low_word];
+    const uint32_t add_low = static_cast<uint32_t>(value);
+    const uint32_t new_low = old_low + add_low;
+    profile[low_word] = new_low;
+    profile[high_word] += static_cast<uint32_t>(value >> 32) + static_cast<uint32_t>(new_low < old_low);
+#else
+    (void)profile;
+    (void)low_word;
+    (void)high_word;
+    (void)value;
+#endif
+}
+
+FORCE_INLINE uint64_t allocator_profile_begin(volatile tt_l1_ptr uint32_t* profile, bool speculative_lease) {
+#ifdef KVM_SERVER_ALLOCATOR_PROFILE
+    ++profile[kAllocatorProfileAllocationCallsWord];
+    if (speculative_lease) {
+        ++profile[kAllocatorProfileLeaseCallsWord];
+    }
+    return get_timestamp();
+#else
+    (void)profile;
+    (void)speculative_lease;
+    return 0;
+#endif
+}
+
+FORCE_INLINE uint64_t allocator_profile_scan_begin() {
+#ifdef KVM_SERVER_ALLOCATOR_PROFILE
+    return get_timestamp();
+#else
+    return 0;
+#endif
+}
+
+FORCE_INLINE void allocator_profile_scan_end(
+    volatile tt_l1_ptr uint32_t* profile, bool speculative_lease, uint64_t started_at) {
+#ifdef KVM_SERVER_ALLOCATOR_PROFILE
+    const uint64_t cycles = get_timestamp() - started_at;
+    ++profile[kAllocatorProfileVictimScansWord];
+    allocator_profile_add_u64(profile, kAllocatorProfileScanCyclesLowWord, kAllocatorProfileScanCyclesHighWord, cycles);
+    if (speculative_lease) {
+        ++profile[kAllocatorProfileLeaseVictimScansWord];
+        allocator_profile_add_u64(
+            profile, kAllocatorProfileLeaseScanCyclesLowWord, kAllocatorProfileLeaseScanCyclesHighWord, cycles);
+    }
+#else
+    (void)profile;
+    (void)speculative_lease;
+    (void)started_at;
+#endif
+}
+
+FORCE_INLINE void allocator_profile_evicted(volatile tt_l1_ptr uint32_t* profile, bool speculative_lease) {
+#ifdef KVM_SERVER_ALLOCATOR_PROFILE
+    ++profile[kAllocatorProfileVictimsEvictedWord];
+    if (speculative_lease) {
+        ++profile[kAllocatorProfileLeaseVictimsEvictedWord];
+    }
+#else
+    (void)profile;
+    (void)speculative_lease;
+#endif
+}
+
+FORCE_INLINE bool allocator_profile_finish(
+    volatile tt_l1_ptr uint32_t* profile, bool speculative_lease, uint64_t started_at, bool success) {
+#ifdef KVM_SERVER_ALLOCATOR_PROFILE
+    if (success) {
+        ++profile[kAllocatorProfileAllocationSuccessesWord];
+        if (speculative_lease) {
+            ++profile[kAllocatorProfileLeaseSuccessesWord];
+        }
+    } else {
+        ++profile[kAllocatorProfileAllocationFailuresWord];
+        if (speculative_lease) {
+            ++profile[kAllocatorProfileLeaseFailuresWord];
+        }
+    }
+    allocator_profile_add_u64(
+        profile,
+        kAllocatorProfileAllocationCyclesLowWord,
+        kAllocatorProfileAllocationCyclesHighWord,
+        get_timestamp() - started_at);
+#else
+    (void)profile;
+    (void)speculative_lease;
+    (void)started_at;
+#endif
+    return success;
+}
+
+FORCE_INLINE volatile tt_l1_ptr uint32_t* residency_lru_node(
+    volatile tt_l1_ptr uint32_t* residency_lru, uint32_t slot) {
+    return residency_lru + slot * kResidencyLruLinkWords;
+}
+
+FORCE_INLINE bool residency_lru_is_linked(
+    uint32_t slot, volatile tt_l1_ptr uint32_t* residency_lru, volatile tt_l1_ptr uint32_t* allocator) {
+    volatile tt_l1_ptr uint32_t* node = residency_lru_node(residency_lru, slot);
+    return allocator[kResidencyLruHeadWord] == slot || node[kResidencyLruPrevWord] != kResidencyLruNone ||
+           node[kResidencyLruNextWord] != kResidencyLruNone;
+}
+
+FORCE_INLINE void residency_lru_remove(
+    uint32_t slot, volatile tt_l1_ptr uint32_t* residency_lru, volatile tt_l1_ptr uint32_t* allocator) {
+    ASSERT(allocator[kResidencyLruCountWord] != 0);
+    ASSERT(residency_lru_is_linked(slot, residency_lru, allocator));
+    volatile tt_l1_ptr uint32_t* node = residency_lru_node(residency_lru, slot);
+    const uint32_t prev = node[kResidencyLruPrevWord];
+    const uint32_t next = node[kResidencyLruNextWord];
+    if (prev == kResidencyLruNone) {
+        ASSERT(allocator[kResidencyLruHeadWord] == slot);
+        allocator[kResidencyLruHeadWord] = next;
+    } else {
+        residency_lru_node(residency_lru, prev)[kResidencyLruNextWord] = next;
+    }
+    if (next == kResidencyLruNone) {
+        ASSERT(allocator[kResidencyLruTailWord] == slot);
+        allocator[kResidencyLruTailWord] = prev;
+    } else {
+        residency_lru_node(residency_lru, next)[kResidencyLruPrevWord] = prev;
+    }
+    node[kResidencyLruPrevWord] = kResidencyLruNone;
+    node[kResidencyLruNextWord] = kResidencyLruNone;
+    --allocator[kResidencyLruCountWord];
+    if (allocator[kResidencyLruCountWord] == 0) {
+        ASSERT(allocator[kResidencyLruHeadWord] == kResidencyLruNone);
+        ASSERT(allocator[kResidencyLruTailWord] == kResidencyLruNone);
+    }
+}
+
+FORCE_INLINE void residency_lru_insert_mru(
+    uint32_t slot, volatile tt_l1_ptr uint32_t* residency_lru, volatile tt_l1_ptr uint32_t* allocator) {
+    ASSERT(!residency_lru_is_linked(slot, residency_lru, allocator));
+    volatile tt_l1_ptr uint32_t* node = residency_lru_node(residency_lru, slot);
+    const uint32_t old_head = allocator[kResidencyLruHeadWord];
+    node[kResidencyLruPrevWord] = kResidencyLruNone;
+    node[kResidencyLruNextWord] = old_head;
+    if (old_head == kResidencyLruNone) {
+        ASSERT(allocator[kResidencyLruCountWord] == 0);
+        allocator[kResidencyLruTailWord] = slot;
+    } else {
+        residency_lru_node(residency_lru, old_head)[kResidencyLruPrevWord] = slot;
+    }
+    allocator[kResidencyLruHeadWord] = slot;
+    ++allocator[kResidencyLruCountWord];
+}
+
+FORCE_INLINE void residency_lru_touch(
+    uint32_t slot, volatile tt_l1_ptr uint32_t* residency_lru, volatile tt_l1_ptr uint32_t* allocator) {
+    ASSERT(residency_lru_is_linked(slot, residency_lru, allocator));
+    if (allocator[kResidencyLruHeadWord] == slot) {
+        return;
+    }
+    residency_lru_remove(slot, residency_lru, allocator);
+    residency_lru_insert_mru(slot, residency_lru, allocator);
+}
+
+FORCE_INLINE uint32_t catalog_claim_free_slot(
+    uint32_t max_keys, volatile tt_l1_ptr uint32_t* directory_state, volatile tt_l1_ptr uint32_t* residency_lru) {
+    const uint32_t free_head = directory_state[kDirFreeSlotHeadWord];
+    if (free_head != kResidencyLruNone) {
+        ASSERT(free_head < max_keys);
+        volatile tt_l1_ptr uint32_t* node = residency_lru_node(residency_lru, free_head);
+        ASSERT(node[kResidencyLruPrevWord] == kCatalogFreeQueued);
+        const uint32_t next_free = node[kResidencyLruNextWord];
+        ASSERT(next_free == kResidencyLruNone || next_free < max_keys);
+        directory_state[kDirFreeSlotHeadWord] = next_free;
+        node[kResidencyLruPrevWord] = kResidencyLruNone;
+        node[kResidencyLruNextWord] = kResidencyLruNone;
+        return free_head;
+    }
+
+    const uint32_t next_unused = directory_state[kDirNextUnusedSlotWord];
+    ASSERT(next_unused <= max_keys);
+    if (next_unused == max_keys) {
+        return kBucketDirSlotEmpty;
+    }
+    directory_state[kDirNextUnusedSlotWord] = next_unused + 1;
+    return next_unused;
+}
+
+FORCE_INLINE void catalog_release_free_slot(
+    uint32_t slot,
+    uint32_t max_keys,
+    volatile tt_l1_ptr uint32_t* directory_state,
+    volatile tt_l1_ptr uint32_t* residency_lru,
+    volatile tt_l1_ptr uint32_t* allocator) {
+    ASSERT(slot < max_keys);
+    ASSERT(!residency_lru_is_linked(slot, residency_lru, allocator));
+    volatile tt_l1_ptr uint32_t* node = residency_lru_node(residency_lru, slot);
+    ASSERT(node[kResidencyLruPrevWord] == kResidencyLruNone);
+    ASSERT(node[kResidencyLruNextWord] == kResidencyLruNone);
+    const uint32_t old_head = directory_state[kDirFreeSlotHeadWord];
+    ASSERT(old_head == kResidencyLruNone || old_head < max_keys);
+    node[kResidencyLruPrevWord] = kCatalogFreeQueued;
+    node[kResidencyLruNextWord] = old_head;
+    directory_state[kDirFreeSlotHeadWord] = slot;
+}
+
+// Exact O(1) residency-LRU selection. Pending-host entries remain linked at their publication
+// epoch to preserve ordering but are pinned, so walk toward MRU until the oldest evictable device
+// entry is found. The bounded pending queue keeps this walk short.
+FORCE_INLINE bool find_oldest_device_victim(
+    uint32_t max_keys,
+    const InterleavedAddrGen<true>& dir_gen,
+    uint32_t scan_staging_addr,
+    volatile tt_l1_ptr uint32_t* residency_lru,
+    volatile tt_l1_ptr uint32_t* allocator,
+    uint32_t* out_slot) {
+    uint32_t slot = allocator[kResidencyLruTailWord];
+    const uint32_t count = allocator[kResidencyLruCountWord];
+    for (uint32_t visited = 0; slot != kResidencyLruNone && visited < count; ++visited) {
+        ASSERT(slot < max_keys);
+        const uint32_t prev = residency_lru_node(residency_lru, slot)[kResidencyLruPrevWord];
+        noc_async_read(dir_gen.get_noc_addr(slot, 0), scan_staging_addr, kDirEntryHeaderBytes);
+        noc_async_read_barrier();
+        volatile tt_l1_ptr uint32_t* entry = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(scan_staging_addr);
+        ASSERT(entry[kEntryValidWord] == 1);
+        ASSERT(entry[kEntryLocationWord] != kLocationHost);
+        if (entry[kEntryValidWord] == 1 && entry[kEntryLocationWord] == kLocationDevice) {
+            *out_slot = slot;
+            return true;
+        }
+        slot = prev;
+    }
+    return false;
+}
+
+FORCE_INLINE bool evict_cached_block(
+    uint32_t slot,
+    uint32_t num_heap_units,
+    uint32_t dir_entry_stride,
+    const InterleavedAddrGen<true>& dir_gen,
+    uint32_t entry_staging,
+    volatile tt_l1_ptr uint32_t* allocator,
+    volatile tt_l1_ptr uint32_t* residency_lru,
+    const InterleavedAddrGen<true>& heap_meta_gen,
+    uint32_t heap_meta_staging,
+    uint32_t& live_device_bytes) {
+    const uint64_t entry_noc = dir_gen.get_noc_addr(slot, 0);
+    noc_async_read(entry_noc, entry_staging, dir_entry_stride);
+    noc_async_read_barrier();
+    volatile tt_l1_ptr uint32_t* entry = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(entry_staging);
+    if (entry[kEntryValidWord] != 1 || entry[kEntryLocationWord] != kLocationDevice) {
+        return false;
+    }
+
+    const uint32_t value_off = entry[kEntryValueByteOffWord];
+    const uint32_t order = entry[kEntryBlockOrderWord];
+    const uint32_t block_bytes = kMaxChunkValueBytes << order;
+    entry[kEntryLocationWord] = kLocationHost;
+    noc_async_write(entry_staging, entry_noc, 32);
+    noc_async_write_barrier();
+    noc_async_read(entry_noc, entry_staging, 32);
+    noc_async_read_barrier();
+
+    residency_lru_remove(slot, residency_lru, allocator);
+    buddy_free(value_off / kMaxChunkValueBytes, order, num_heap_units, allocator, heap_meta_gen, heap_meta_staging);
+    live_device_bytes = (live_device_bytes >= block_bytes) ? (live_device_bytes - block_bytes) : 0;
+    return true;
+}
+
+FORCE_INLINE bool allocate_cache_block(
+    uint32_t units,
+    uint32_t owner_slot,
+    uint32_t value_heap_bytes,
+    uint32_t num_heap_units,
+    uint32_t max_keys,
+    uint32_t dir_entry_stride,
+    const InterleavedAddrGen<true>& dir_gen,
+    uint32_t scan_staging_addr,
+    volatile tt_l1_ptr uint32_t* allocator,
+    volatile tt_l1_ptr uint32_t* residency_lru,
+    const InterleavedAddrGen<true>& heap_meta_gen,
+    uint32_t heap_meta_staging,
+    uint32_t& live_device_bytes,
+    volatile tt_l1_ptr uint32_t* allocator_profile,
+    bool speculative_lease,
+    bool allow_eviction,
+    uint32_t* out_unit,
+    uint32_t* out_order) {
+    const uint64_t profile_started_at = allocator_profile_begin(allocator_profile, speculative_lease);
+    if (units == 0 || units > num_heap_units) {
+        return allocator_profile_finish(allocator_profile, speculative_lease, profile_started_at, false);
+    }
+
+    const uint32_t block_bytes = kMaxChunkValueBytes << buddy_order_for_units(units);
+    if (block_bytes > value_heap_bytes) {
+        return allocator_profile_finish(allocator_profile, speculative_lease, profile_started_at, false);
+    }
+
+    // Capacity is an independent invariant, not an inference from the free lists. This also makes
+    // pressure behavior deterministic if allocator metadata is stale: invalidate LRU residency
+    // before asking the buddy allocator to reuse a block.
+    for (uint32_t attempts = 0; attempts <= max_keys; ++attempts) {
+        if (live_device_bytes <= value_heap_bytes - block_bytes &&
+            buddy_allocate(units, owner_slot, allocator, heap_meta_gen, heap_meta_staging, out_unit, out_order)) {
+            return allocator_profile_finish(allocator_profile, speculative_lease, profile_started_at, true);
+        }
+        if (!allow_eviction || attempts == max_keys) {
+            break;
+        }
+
+        uint32_t victim_slot = 0;
+        const uint64_t scan_started_at = allocator_profile_scan_begin();
+        const bool found_victim =
+            find_oldest_device_victim(max_keys, dir_gen, scan_staging_addr, residency_lru, allocator, &victim_slot);
+        allocator_profile_scan_end(allocator_profile, speculative_lease, scan_started_at);
+        if (!found_victim) {
+            return allocator_profile_finish(allocator_profile, speculative_lease, profile_started_at, false);
+        }
+        if (!evict_cached_block(
+                victim_slot,
+                num_heap_units,
+                dir_entry_stride,
+                dir_gen,
+                scan_staging_addr,
+                allocator,
+                residency_lru,
+                heap_meta_gen,
+                heap_meta_staging,
+                live_device_bytes)) {
+            return allocator_profile_finish(allocator_profile, speculative_lease, profile_started_at, false);
+        }
+        allocator_profile_evicted(allocator_profile, speculative_lease);
+    }
+    return allocator_profile_finish(allocator_profile, speculative_lease, profile_started_at, false);
+}
+
+FORCE_INLINE bool reserve_get_value_batch(volatile tt_l1_ptr uint32_t* termination_ptr) {
+    while (!cb_pages_reservable_at_back(kGetValueCbId, kGetValueCbReadBatch)) {
+        invalidate_l1_cache();
+        if (*termination_ptr == static_cast<uint32_t>(tt::tt_fabric::TerminationSignal::IMMEDIATELY_TERMINATE)) {
+            return false;
+        }
+    }
+    cb_reserve_back(kGetValueCbId, kGetValueCbReadBatch);
+    return true;
+}
+
+// Persist a GET's catalog epoch before this BRISC resumes serial directory scheduling, so the next
+// request cannot observe the old stamp.
+__attribute__((noinline, optimize("Oz"))) void persist_get_access_stamp(
+    uint32_t slot, uint32_t access_epoch, uint32_t entry_staging, const InterleavedAddrGen<true>& dir_gen) {
+    volatile tt_l1_ptr uint32_t* entry = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(entry_staging);
+    entry[kEntryLastAccessWord] = access_epoch;
+    const uint64_t entry_noc = dir_gen.get_noc_addr(slot, 0);
+    noc_async_write(entry_staging, entry_noc, 32);
+    noc_async_write_barrier();
+    noc_async_read(entry_noc, entry_staging, 32);
+    noc_async_read_barrier();
+}
+
+__attribute__((noinline, optimize("Oz"))) void persist_host_get_access_stamp_if_current(
+    uint32_t slot,
+    uint32_t total_len,
+    uint32_t access_epoch,
+    uint32_t entry_staging,
+    const InterleavedAddrGen<true>& dir_gen) {
+    const uint64_t entry_noc = dir_gen.get_noc_addr(slot, 0);
+    noc_async_read(entry_noc, entry_staging, 32);
+    noc_async_read_barrier();
+    volatile tt_l1_ptr uint32_t* entry = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(entry_staging);
+    if (entry[kEntryValidWord] == 1 && entry[kEntryLocationWord] == kLocationHost &&
+        entry[kEntryTotalLenWord] == total_len) {
+        persist_get_access_stamp(slot, access_epoch, entry_staging, dir_gen);
+    }
+}
+
+// Publish a host-backed GET's filled buddy block as device-resident. The host generation is retained:
+// device DRAM is only a cache, while the host copy remains authoritative. The caller must fence every
+// value write before entering. The caller may overlap this metadata fence with the current GET's
+// Fabric tail, but must not service another directory request until the consumer has finished.
+__attribute__((noinline, optimize("Oz"))) bool commit_host_get_admission(
+    uint32_t slot,
+    uint32_t value_byte_off,
+    uint32_t total_len,
+    uint32_t block_order,
+    uint32_t access_epoch,
+    uint32_t value_heap_bytes,
+    uint32_t dir_entry_stride,
+    const InterleavedAddrGen<true>& dir_gen,
+    uint32_t entry_staging,
+    volatile tt_l1_ptr uint32_t* residency_lru,
+    volatile tt_l1_ptr uint32_t* allocator,
+    uint32_t& live_device_bytes) {
+    const uint64_t entry_noc = dir_gen.get_noc_addr(slot, 0);
+    noc_async_read(entry_noc, entry_staging, 32);
+    noc_async_read_barrier();
+    volatile tt_l1_ptr uint32_t* entry = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(entry_staging);
+    if (entry[kEntryValidWord] != 1 || entry[kEntryLocationWord] != kLocationHost ||
+        entry[kEntryTotalLenWord] != total_len) {
+        return false;
+    }
+
+    entry[kEntryValueByteOffWord] = value_byte_off;
+    entry[kEntryLocationWord] = kLocationDevice;
+    entry[kEntryBlockOrderWord] = block_order;
+    entry[kEntryLastAccessWord] = access_epoch;
+    noc_async_write(entry_staging, entry_noc, 32);
+    noc_async_write_barrier();
+    noc_async_read(entry_noc, entry_staging, 32);
+    noc_async_read_barrier();
+
+    residency_lru_insert_mru(slot, residency_lru, allocator);
+    live_device_bytes += kMaxChunkValueBytes << block_order;
+    ASSERT(live_device_bytes <= value_heap_bytes);
+    return true;
+}
+
+// Post mandatory WRITE_THROUGH and, when enabled, obtain a mapped-host destination. The fallback
+// worker performs the copy itself and therefore returns no device destination.
+FORCE_INLINE bool request_write_through_destination(
+    uint32_t v_slot,
+    uint32_t v_off,
+    uint32_t v_len,
+    uint64_t move_req_noc,
+    uint64_t move_req_sem_noc,
+    uint32_t stage_enabled,
+    uint64_t stage_noc_base,
+    volatile tt_l1_ptr uint32_t* evict_ack_sem,
+    volatile tt_l1_ptr uint32_t* evict_ack,
+    uint32_t& evict_ack_seen,
+    volatile tt_l1_ptr uint32_t* termination_ptr,
+    uint32_t* host_generation,
+    uint64_t* host_dst) {
+    *host_generation = 0;
+    *host_dst = 0;
+    noc_inline_dw_write(move_req_noc + 0, kMoveOpWriteThrough);
+    noc_inline_dw_write(move_req_noc + 4, v_slot);
+    noc_inline_dw_write(move_req_noc + 8, v_off);
+    noc_inline_dw_write(move_req_noc + 12, v_len);
+    noc_inline_dw_write(move_req_noc + 16, 0u);
+    noc_async_write_barrier();
+    noc_semaphore_inc(move_req_sem_noc, 1);
+    noc_async_atomic_barrier();
+    if (!stage_enabled) {
+        return true;
+    }
+
+    while (true) {
+        invalidate_l1_cache();
+        if (*evict_ack_sem != evict_ack_seen) {
+            break;
+        }
+        if (*termination_ptr == static_cast<uint32_t>(tt::tt_fabric::TerminationSignal::IMMEDIATELY_TERMINATE)) {
+            return false;
+        }
+    }
+    evict_ack_seen = *evict_ack_sem;
+    invalidate_l1_cache();
+    const uint32_t dst_off = evict_ack[kEvictAckReadOffWord];
+    *host_generation = evict_ack[kEvictAckGenerationWord];
+    *host_dst = stage_noc_base + static_cast<uint64_t>(dst_off);
+    return true;
+}
+
+// Post-publish fallback: request a destination and then push the complete landed value.
+FORCE_INLINE bool write_through_to_host(
+    uint32_t noc,
+    uint32_t v_slot,
+    uint32_t v_off,
+    uint32_t v_len,
+    uint64_t move_req_noc,
+    uint64_t move_req_sem_noc,
+    uint32_t stage_enabled,
+    uint32_t stage_pcie_xy_enc,
+    uint64_t stage_noc_base,
+    const InterleavedAddrGen<true>& value_gen,
+    volatile tt_l1_ptr uint32_t* evict_ack_sem,
+    volatile tt_l1_ptr uint32_t* evict_ack,
+    uint32_t& evict_ack_seen,
+    volatile tt_l1_ptr uint32_t* termination_ptr,
+    uint32_t* host_generation) {
+    uint64_t host_dst = 0;
+    if (!request_write_through_destination(
+            v_slot,
+            v_off,
+            v_len,
+            move_req_noc,
+            move_req_sem_noc,
+            stage_enabled,
+            stage_noc_base,
+            evict_ack_sem,
+            evict_ack,
+            evict_ack_seen,
+            termination_ptr,
+            host_generation,
+            &host_dst)) {
+        return false;
+    }
+    if (stage_enabled) {
+        kvm_push_evicted_value(noc, v_off, v_len, stage_pcie_xy_enc, host_dst, value_gen);
+    }
+    return true;
+}
+
+FORCE_INLINE bool wait_for_move_channel_drain(
+    volatile tt_l1_ptr uint32_t* move_processed,
+    volatile tt_l1_ptr uint32_t* move_req_sem,
+    volatile tt_l1_ptr uint32_t* termination_ptr) {
+    while (true) {
+        invalidate_l1_cache();
+        if (*termination_ptr == static_cast<uint32_t>(tt::tt_fabric::TerminationSignal::IMMEDIATELY_TERMINATE)) {
+            return false;
+        }
+        if (*move_processed == *move_req_sem) {
+            return true;
+        }
+    }
+}
+
+FORCE_INLINE bool wait_for_cumulative_target(
+    volatile tt_l1_ptr uint32_t* value, uint32_t target, volatile tt_l1_ptr uint32_t* termination_ptr) {
+    while (true) {
+        invalidate_l1_cache();
+        const uint32_t observed = *value;
+        if (observed == target || cumulative_counter_is_ahead(observed, target)) {
+            return true;
+        }
+        if (*termination_ptr == static_cast<uint32_t>(tt::tt_fabric::TerminationSignal::IMMEDIATELY_TERMINATE)) {
+            return false;
+        }
+    }
+}
+
+// Publish the device-resident value before landed. A streamed mapped-host PUT defers its final host
+// group and therefore needs no FIFO entry; fallback PUTs enqueue the pending slot/token pair.
+__attribute__((noinline, optimize("Os"))) bool publish_pending_put(
+    uint32_t dir_slot,
+    uint32_t value_byte_off,
+    uint32_t block_order,
+    uint32_t pending_token,
+    uint32_t total_value_len,
+    uint32_t key_len,
+    volatile tt_l1_ptr uint8_t* key_src,
+    bool stream_tail_pending,
+    uint32_t max_keys,
+    uint32_t dir_entry_stride,
+    const InterleavedAddrGen<true>& dir_gen,
+    uint32_t commit_entry_staging_addr,
+    uint32_t num_buckets,
+    const InterleavedAddrGen<true>& hash_gen,
+    uint32_t hash_probe_staging,
+    const InterleavedAddrGen<true>& queue_gen,
+    uint32_t& queue_tail,
+    uint32_t& queue_count,
+    volatile tt_l1_ptr uint32_t* epoch,
+    volatile tt_l1_ptr uint32_t* residency_lru,
+    volatile tt_l1_ptr uint32_t* allocator,
+    uint32_t& live_device_bytes,
+    uint32_t& pending_device_bytes) {
+    if (!stream_tail_pending && queue_count == max_keys) {
+        return false;
+    }
+    ASSERT(dir_slot < max_keys);
+    ASSERT((value_byte_off % kMaxChunkValueBytes) == 0);
+
+    const uint64_t entry_noc = dir_gen.get_noc_addr(dir_slot, 0);
+    noc_async_read(entry_noc, commit_entry_staging_addr, dir_entry_stride);
+    noc_async_read_barrier();
+    volatile tt_l1_ptr uint32_t* entry = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(commit_entry_staging_addr);
+    ASSERT(entry[kEntryValidWord] != 1);
+    for (uint32_t word = 0; word < dir_entry_stride / sizeof(uint32_t); ++word) {
+        entry[word] = 0;
+    }
+    entry[kEntryValidWord] = 1;
+    entry[kEntryKeyLenWord] = key_len;
+    entry[kEntryTotalLenWord] = total_value_len;
+    entry[kEntryLastAccessWord] = ++(*epoch);
+    entry[kEntryValueByteOffWord] = value_byte_off;
+    entry[kEntryHostGenerationWord] = pending_token;
+    entry[kEntryLocationWord] = kLocationDevicePendingHost;
+    entry[kEntryBlockOrderWord] = block_order;
+    volatile tt_l1_ptr uint8_t* key_dst =
+        reinterpret_cast<volatile tt_l1_ptr uint8_t*>(commit_entry_staging_addr + kEntryKeyByteOffset);
+    for (uint32_t i = 0; i < key_len; ++i) {
+        key_dst[i] = key_src[i];
+    }
+
+    noc_async_write(commit_entry_staging_addr, entry_noc, dir_entry_stride);
+    noc_async_write_barrier();
+    noc_async_read(entry_noc, commit_entry_staging_addr, dir_entry_stride);
+    noc_async_read_barrier();
+    hashmap_insert(fnv1a_hash(key_src, key_len), dir_slot, num_buckets, hash_gen, hash_probe_staging);
+    residency_lru_insert_mru(dir_slot, residency_lru, allocator);
+    const uint32_t block_bytes = kMaxChunkValueBytes << block_order;
+    live_device_bytes += block_bytes;
+    pending_device_bytes += block_bytes;
+    if (stream_tail_pending) {
+        return true;
+    }
+
+    for (uint32_t word = 0; word < kPutHostQueueEntryBytes / sizeof(uint32_t); ++word) {
+        entry[word] = 0;
+    }
+    entry[kPutHostQueueDirSlotWord] = dir_slot;
+    entry[kPutHostQueueTokenWord] = pending_token;
+    noc_async_write(commit_entry_staging_addr, queue_gen.get_noc_addr(queue_tail, 0), kPutHostQueueEntryBytes);
+    noc_async_write_barrier();
+    queue_tail = (queue_tail + 1 == max_keys) ? 0 : queue_tail + 1;
+    ++queue_count;
+    return true;
+}
+
+// Consume one pending-host FIFO entry. A stale token means REMOVE/reuse invalidated the work; it is
+// still a completed issued PUT for commit_done ordering, but must not create or patch host backing.
+__attribute__((noinline)) bool commit_pending_put(
+    uint32_t queue_head,
+    uint32_t max_keys,
+    uint32_t dir_entry_stride,
+    const InterleavedAddrGen<true>& dir_gen,
+    const InterleavedAddrGen<true>& queue_gen,
+    uint32_t commit_entry_staging_addr,
+    uint64_t move_req_noc,
+    uint64_t move_req_sem_noc,
+    volatile tt_l1_ptr uint32_t* move_req_sem,
+    volatile tt_l1_ptr uint32_t* move_processed,
+    uint32_t noc,
+    uint32_t stage_enabled,
+    uint32_t stage_pcie_xy_enc,
+    uint64_t stage_noc_base,
+    const InterleavedAddrGen<true>& value_gen,
+    volatile tt_l1_ptr uint32_t* evict_ack_sem,
+    volatile tt_l1_ptr uint32_t* evict_ack,
+    uint32_t& evict_ack_seen,
+    uint64_t evict_done_noc,
+    volatile tt_l1_ptr uint32_t* termination_ptr,
+    uint32_t& pending_device_bytes) {
+    noc_async_read(queue_gen.get_noc_addr(queue_head, 0), commit_entry_staging_addr, kPutHostQueueEntryBytes);
+    noc_async_read_barrier();
+    volatile tt_l1_ptr uint32_t* entry = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(commit_entry_staging_addr);
+    const uint32_t dir_slot = entry[kPutHostQueueDirSlotWord];
+    const uint32_t pending_token = entry[kPutHostQueueTokenWord];
+    ASSERT(dir_slot < max_keys);
+
+    const uint64_t entry_noc = dir_gen.get_noc_addr(dir_slot, 0);
+    noc_async_read(entry_noc, commit_entry_staging_addr, dir_entry_stride);
+    noc_async_read_barrier();
+    if (entry[kEntryValidWord] != 1 || entry[kEntryLocationWord] != kLocationDevicePendingHost ||
+        entry[kEntryHostGenerationWord] != pending_token) {
+        return true;
+    }
+    const uint32_t value_byte_off = entry[kEntryValueByteOffWord];
+    const uint32_t total_value_len = entry[kEntryTotalLenWord];
+    const uint32_t block_bytes = kMaxChunkValueBytes << entry[kEntryBlockOrderWord];
+
+    uint32_t host_generation = 0;
+    if (!write_through_to_host(
+            noc,
+            dir_slot,
+            value_byte_off,
+            total_value_len,
+            move_req_noc,
+            move_req_sem_noc,
+            stage_enabled,
+            stage_pcie_xy_enc,
+            stage_noc_base,
+            value_gen,
+            evict_ack_sem,
+            evict_ack,
+            evict_ack_seen,
+            termination_ptr,
+            &host_generation)) {
+        return false;
+    }
+    if (stage_enabled) {
+        noc_semaphore_inc(evict_done_noc, 1);
+        noc_async_atomic_barrier();
+    }
+    if (!wait_for_move_channel_drain(move_processed, move_req_sem, termination_ptr)) {
+        return false;
+    }
+
+    entry[kEntryHostGenerationWord] = host_generation;
+    entry[kEntryLocationWord] = kLocationDevice;
+    noc_async_write(commit_entry_staging_addr, entry_noc, kDirEntryHeaderBytes);
+    noc_async_write_barrier();
+    noc_async_read(entry_noc, commit_entry_staging_addr, kDirEntryHeaderBytes);
+    noc_async_read_barrier();
+    ASSERT(pending_device_bytes >= block_bytes);
+    pending_device_bytes -= block_bytes;
+    return true;
+}
+
+// Finish a streamed PUT after landed. No external request can run between publish and this function,
+// so the pending token must still identify the same directory entry.
+__attribute__((noinline)) bool commit_streamed_put(
+    uint32_t dir_slot,
+    uint32_t pending_token,
+    uint32_t value_byte_off,
+    uint32_t total_value_len,
+    uint32_t tail_begin,
+    uint32_t host_generation,
+    uint64_t host_dst,
+    uint32_t max_keys,
+    uint32_t dir_entry_stride,
+    const InterleavedAddrGen<true>& dir_gen,
+    uint32_t commit_entry_staging_addr,
+    uint32_t noc,
+    uint32_t stage_pcie_xy_enc,
+    const InterleavedAddrGen<true>& value_gen,
+    uint64_t evict_done_noc,
+    volatile tt_l1_ptr uint32_t* move_processed,
+    volatile tt_l1_ptr uint32_t* move_req_sem,
+    volatile tt_l1_ptr uint32_t* termination_ptr,
+    uint32_t& pending_device_bytes,
+    uint64_t commit_done_noc) {
+    ASSERT(dir_slot < max_keys);
+    kvm_push_streamed_tail(noc, value_byte_off, total_value_len, tail_begin, stage_pcie_xy_enc, host_dst, value_gen);
+    noc_semaphore_inc(evict_done_noc, 1);
+    noc_async_atomic_barrier();
+    if (!wait_for_move_channel_drain(move_processed, move_req_sem, termination_ptr)) {
+        return false;
+    }
+
+    const uint64_t entry_noc = dir_gen.get_noc_addr(dir_slot, 0);
+    noc_async_read(entry_noc, commit_entry_staging_addr, dir_entry_stride);
+    noc_async_read_barrier();
+    volatile tt_l1_ptr uint32_t* entry = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(commit_entry_staging_addr);
+    ASSERT(entry[kEntryValidWord] == 1);
+    ASSERT(entry[kEntryLocationWord] == kLocationDevicePendingHost);
+    ASSERT(entry[kEntryHostGenerationWord] == pending_token);
+    ASSERT(entry[kEntryValueByteOffWord] == value_byte_off);
+    ASSERT(entry[kEntryTotalLenWord] == total_value_len);
+    const uint32_t block_bytes = kMaxChunkValueBytes << entry[kEntryBlockOrderWord];
+    entry[kEntryHostGenerationWord] = host_generation;
+    entry[kEntryLocationWord] = kLocationDevice;
+    noc_async_write(commit_entry_staging_addr, entry_noc, kDirEntryHeaderBytes);
+    noc_async_write_barrier();
+    noc_async_read(entry_noc, commit_entry_staging_addr, kDirEntryHeaderBytes);
+    noc_async_read_barrier();
+    ASSERT(pending_device_bytes >= block_bytes);
+    pending_device_bytes -= block_bytes;
+    noc_semaphore_inc(commit_done_noc, 1);
+    noc_async_atomic_barrier();
+    return true;
+}
