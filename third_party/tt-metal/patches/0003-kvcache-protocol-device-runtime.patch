+TEST(KvCacheManagerBootstrap, PinsEstablishAbiAndSessionTokenLayout) {
+    EXPECT_EQ(protocol::kBootstrapProtocolVersion, 4);
+    EXPECT_EQ(sizeof(protocol::EstablishRequest), 80);
+    EXPECT_EQ(offsetof(protocol::EstablishRequest, return_route), 60);
+    EXPECT_EQ(sizeof(protocol::EstablishResponse), 96);
+    EXPECT_EQ(offsetof(protocol::EstablishResponse, descriptor), 32);
+    EXPECT_EQ(protocol::kBootstrapPeerSlots, protocol::kMaxClients);
+    EXPECT_EQ(protocol::kRingBaseOffset % 32, 16);
+
+    constexpr uint32_t token = protocol::make_client_token(/*client_id=*/31, /*generation=*/12345);
+    EXPECT_EQ(protocol::client_id_from_token(token), 31);
+    EXPECT_EQ(protocol::client_generation_from_token(token), 12345);
+    EXPECT_EQ(protocol::next_client_generation(protocol::kClientGenerationMask), 1);
+    EXPECT_EQ(
+        protocol::establish_registry_action(protocol::ClientRegistryState::Empty, false),
+        protocol::EstablishRegistryAction::Create);
+    EXPECT_EQ(
+        protocol::establish_registry_action(protocol::ClientRegistryState::Established, true),
+        protocol::EstablishRegistryAction::Replay);
+    EXPECT_EQ(
+        protocol::establish_registry_action(protocol::ClientRegistryState::Established, false),
+        protocol::EstablishRegistryAction::Drop);
+    EXPECT_EQ(
+        protocol::establish_registry_action(protocol::ClientRegistryState::Retired, true),
+        protocol::EstablishRegistryAction::Drop);
