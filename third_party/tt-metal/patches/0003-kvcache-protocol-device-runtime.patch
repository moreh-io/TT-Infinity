+            put_stream_slot = kBucketDirSlotEmpty;
+            put_stream_value_off = 0;
+            put_stream_total_len = 0;
+            put_stream_tail_begin = 0;
+            put_stream_host_generation = 0;
+            put_stream_host_dst = 0;
+            put_stream_pending_token = 0;
