+void ClientOperations::launch_put_batch_client(uint32_t batch_count, RequestTransaction& request) {
+    TT_ASSERT(batch_count > 0);
+    TT_ASSERT(batch_count <= protocol::kClientPutBatchMaxItems);
+    TT_ASSERT(put_batch_desc_buf_ != nullptr);
+
+    if (put_batch_prog_.workload == nullptr) {
+        IDevice* client_device = client_submesh_->get_device(client_coord_);
+        TT_FATAL(
+            static_cast<uint32_t>(client_device->num_dram_channels()) == server_num_dram_channels_ &&
+                client_device->dram_grid_size() == CoreCoord(server_dram_grid_x_, server_dram_grid_y_),
+            "fabric-direct batch PUT requires identical client/server DRAM bank layout "
+            "(client num_dram_channels={}, server={})",
+            client_device->num_dram_channels(),
+            server_num_dram_channels_);
+
+        ClientRtArgs args{
+            .op_kind = kOpKindPut,
+            .client_l1_base = client_l1_base_,
+            .server_l1_base = server_l1_base_,
+            .server_noc_x = server_noc_x_,
+            .server_noc_y = server_noc_y_,
+            .base_ring_slot_idx = request.base_ring_slot(),
+            .payload_size = 0,
+            .route_word_to_server = route_word_to_server_,
+            .num_chunks = 0,
+            .total_value_len = 0,
+            .client_dram_addr = 0,
+            .logical_page_size = 0,
+            .tensor_slot_id = recv_buf_base_,
+        };
+
+        Program program = CreateProgram();
+        CoreRange core_range(kClientCore, kClientCore);
+        KernelHandle writer_id = CreateKernel(
+            program,
+            kPutBatchWriterKernelPath,
+            core_range,
+            DataMovementConfig{
+                .processor = DataMovementProcessor::RISCV_1,
+                .noc = NOC::RISCV_1_default,
+                .defines = client_kernel_defines(KvcacheKernelTarget::ClientUnprofiled)});
+        std::vector<uint32_t> writer_args = to_vec(args, client_token_);
+        writer_args.push_back(request.seq());
+        writer_args.push_back(put_batch_desc_base_);
+        writer_args.push_back(batch_count);
+        append_server_connection_rt_args(program, writer_args);
+        SetRuntimeArgs(program, writer_id, kClientCore, writer_args);
+
+        auto reader_defines = client_kernel_defines(KvcacheKernelTarget::ClientUnprofiled);
+        KernelHandle reader_id = CreateKernel(
+            program,
+            kPutBatchReaderKernelPath,
+            core_range,
+            DataMovementConfig{
+                .processor = DataMovementProcessor::RISCV_0, .noc = NOC::RISCV_0_default, .defines = reader_defines});
+        std::vector<uint32_t> reader_args = {client_l1_base_, put_batch_desc_base_, batch_count};
+        SetRuntimeArgs(program, reader_id, kClientCore, reader_args);
+
+        put_batch_prog_.workload = std::make_unique<MeshWorkload>();
+        put_batch_prog_.workload->add_program(chip_range_, std::move(program));
+        put_batch_prog_.kernel_id = writer_id;
+        put_batch_prog_.secondary_id = reader_id;
+    } else {
+        Program& program = put_batch_prog_.workload->get_programs().at(chip_range_);
+        RuntimeArgsData& writer_args = GetRuntimeArgs(program, put_batch_prog_.kernel_id, kClientCore);
+        writer_args[kRtaBaseRingSlot] = request.base_ring_slot();
+        writer_args[kRtaPutBatchBaseSeq] = request.seq();
+        writer_args[kRtaPutBatchDescriptorBase] = put_batch_desc_base_;
+        writer_args[kRtaPutBatchCount] = batch_count;
+        RuntimeArgsData& reader_args = GetRuntimeArgs(program, put_batch_prog_.secondary_id, kClientCore);
+        reader_args[kRtaPutBatchReaderCount] = batch_count;
+    }
+    if (!put_batch_prog_.compiled) {
+        Program& program = put_batch_prog_.workload->get_programs().at(chip_range_);
+        tt::tt_metal::detail::CompileProgram(client_submesh_, program);
+        put_batch_prog_.compiled = true;
+    }
+
+    enqueue_request(*put_batch_prog_.workload, /*blocking=*/false, request);
+}
