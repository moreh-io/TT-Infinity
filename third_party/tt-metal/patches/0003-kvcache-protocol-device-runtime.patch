+// SPDX-FileCopyrightText: (c) 2026 Moreh
+//
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+#include "ttnn/operations/kvcache_manager/common/protocol/layout.hpp"
+
+namespace ttnn::operations::kvcache_manager::client_program_args {
+
+// Build the RT arg base [0..13] shared by every op kernel (mirrors ClientBaseArgs /
+// parse_base_args in client_kernel_common.hpp). Caller fills in op-specific values, then
+// appends the op extras and the fabric connection args.
+struct ClientRtArgs {
+    uint32_t op_kind;
+    uint32_t client_l1_base;
+    uint32_t server_l1_base;
+    uint32_t server_noc_x;
+    uint32_t server_noc_y;
+    uint32_t base_ring_slot_idx;
+    uint32_t payload_size;
+    uint32_t route_word_to_server;
+    uint32_t num_chunks;
+    uint32_t total_value_len;
+    uint32_t client_dram_addr;
+    uint32_t logical_page_size;   // PUT: input page_size; GET: output page_size; 0 otherwise
+    uint32_t tensor_slot_id = 0;  // Op-specific slot/address argument; interpreted by the device kernel.
+    uint32_t value_byte_off = 0;  // Op-specific byte offset; zero unless the device kernel uses it.
+};
+
+// The token is a separate parameter rather than a ClientRtArgs field on purpose: it belongs to the
+// Client session, not to the op, and passing it explicitly means a new launch_* cannot omit the
+// generation fence and ship a request as a stale session.
+inline std::vector<uint32_t> to_vec(const ClientRtArgs& a, uint32_t client_token) {
+    return {
+        a.op_kind,
+        a.client_l1_base,
+        a.server_l1_base,
+        a.server_noc_x,
+        a.server_noc_y,
+        a.base_ring_slot_idx,
+        a.payload_size,
+        a.route_word_to_server,
+        a.num_chunks,
+        a.total_value_len,
+        a.client_dram_addr,
+        a.logical_page_size,
+        a.tensor_slot_id,
+        a.value_byte_off,
+        client_token,
+    };
+}
+
+// RT-arg override indices for a resident program's in-place RTA rewrite (program caching): only the
+// op-specific slots below are rewritten per op; the fixed slots (op_kind, L1 bases, server noc
+// coords, route word, the trailing status-word address, and the fabric-connection words) are written
+// once at build. Indices are into the 15-word to_vec() base layout: ClientRtArgs fields occupy
+// 0..13 and the client token occupies 14; each op's chunk-0 extras follow.
+inline constexpr std::size_t kRtaBaseRingSlot = 5;
+inline constexpr std::size_t kRtaPayloadSize = 6;
+inline constexpr std::size_t kRtaNumChunks = 8;
+inline constexpr std::size_t kRtaTotalValueLen = 9;
+inline constexpr std::size_t kRtaClientDramAddr = 10;
+inline constexpr std::size_t kRtaLogicalPageSize = 11;
+inline constexpr std::size_t kRtaBaseCount = 15;  // to_vec() length
+inline constexpr std::size_t kRtaGetStreamSeq = kRtaBaseCount + 0;
+inline constexpr std::size_t kRtaGetKeyLen = kRtaBaseCount + 1;
+inline constexpr std::size_t kRtaGetKeyWords = kRtaBaseCount + 2;
+inline constexpr std::size_t kRtaGetStatusAddr = kRtaGetKeyWords + 32;
+inline constexpr std::size_t kRtaGetMappedCompletionEnabled = kRtaGetStatusAddr + 1;
+
+// PUT chunk-0 extras (writer kernel), appended after the base.
+inline constexpr std::size_t kRtaPutStreamSeq = kRtaBaseCount + 0;
+inline constexpr std::size_t kRtaPutNumPages = kRtaBaseCount + 1;
+inline constexpr std::size_t kRtaPutDtype = kRtaBaseCount + 2;
+inline constexpr std::size_t kRtaPutLayout = kRtaBaseCount + 3;
+inline constexpr std::size_t kRtaPutRank = kRtaBaseCount + 4;
+inline constexpr std::size_t kRtaPutShape = kRtaBaseCount + 5;
+inline constexpr std::size_t kRtaPutKeyLen = kRtaPutShape + protocol::kTensorShapeMaxRank;
+inline constexpr std::size_t kRtaPutKeyWords = kRtaPutKeyLen + 1;
+
+// Bounded PUT batch writer extras. Item metadata is uploaded to a dedicated L1 page, keeping the
+// RTA fixed and small for batches up to kClientPutBatchMaxItems.
+inline constexpr std::size_t kRtaPutBatchBaseSeq = kRtaBaseCount + 0;
+inline constexpr std::size_t kRtaPutBatchDescriptorBase = kRtaBaseCount + 1;
+inline constexpr std::size_t kRtaPutBatchCount = kRtaBaseCount + 2;
+
+// PUT reader kernel args (index 0 = client_l1_base, fixed; the rest are per-op).
+inline constexpr std::size_t kRtaPutReaderNumChunks = 1;
+inline constexpr std::size_t kRtaPutReaderTotalValueLen = 2;
+inline constexpr std::size_t kRtaPutReaderClientDramAddr = 3;
+inline constexpr std::size_t kRtaPutReaderLogicalPageSize = 4;
+inline constexpr std::size_t kRtaPutBatchReaderCount = 2;
+
+// PING extras use a fixed maximum-size payload-word span so one resident program can serve every
+// legal payload size without changing its RT-arg layout.
+inline constexpr std::size_t kRtaPingSeq = kRtaBaseCount + 0;
+inline constexpr std::size_t kRtaPingPayloadWords = kRtaBaseCount + 1;
+
+// STATUS extras (exists/remove/move), appended after the base. op_kind (index 0) is overridden per
+// op — one resident program serves all four status op-kinds by value.
+inline constexpr std::size_t kRtaOpKind = 0;
+inline constexpr std::size_t kRtaStatusSeq = kRtaBaseCount + 0;
+inline constexpr std::size_t kRtaStatusKeyWords = kRtaBaseCount + 1;
+
+}  // namespace ttnn::operations::kvcache_manager::client_program_args
diff --git a/ttnn/cpp/ttnn/operations/kvcache_manager/client/device/kernels/dataflow/client_kernel_common.hpp b/ttnn/cpp/ttnn/operations/kvcache_manager/client/device/kernels/dataflow/client_kernel_common.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..7457907e84c5d472909fa818a7622d2ef0d6fc9f
--- /dev/null
+++ b/ttnn/cpp/ttnn/operations/kvcache_manager/client/device/kernels/dataflow/client_kernel_common.hpp
@@ -0,0 +1,141 @@
+// SPDX-FileCopyrightText: (c) 2026 Moreh
+//
+// SPDX-License-Identifier: Apache-2.0
+//
+// Shared runtime-argument ABI and Fabric primitives for the role-specific Client kernels.
+//
+// RT-arg ABI: the 15 base words (parse_base_args, in ClientBaseArgs field order) come first,
+// then each op's extras, then the fabric connection args (append_fabric_connection_rt_args).
+// word[7] (route_word) is dual-encoded: 1D hop count / 2D (mesh_id<<16)|chip_id — see
+// fabric_helpers.hpp kvcache_unicast_route_word and kvm_fabric_route.hpp set_unicast_route.
+//
+// Address rule: own L1 access uses `client_l1_base + offset`; writes to the server chip use
+// `server_l1_base + offset`. Never mix the two.
+// See ttnn/cpp/ttnn/operations/kvcache_manager/docs/design.md §3 and §6.
+
+#pragma once
+
+#include <cstdint>
+
+#include "api/dataflow/dataflow_api.h"
+#include "tt_metal/fabric/hw/inc/edm_fabric/edm_fabric_worker_adapters.hpp"
+#include "tt_metal/fabric/hw/inc/packet_header_pool.h"
+#include "tt_metal/fabric/fabric_edm_packet_header.hpp"
+
+#include "ttnn/cpp/ttnn/operations/kvcache_manager/common/protocol/packet.hpp"
+#include "ttnn/cpp/ttnn/operations/kvcache_manager/common/protocol/layout.hpp"
+#include "ttnn/cpp/ttnn/operations/kvcache_manager/common/kvm_device_zone.hpp"
+#include "ttnn/cpp/ttnn/operations/kvcache_manager/common/kvm_fabric_route.hpp"
+
+namespace ttnn::operations::kvcache_manager::client {
+
+using namespace ttnn::operations::kvcache_manager::protocol;
+
+// op_kind dispatch values (RT arg [0]). Mirror of the host-side constants in
+// client.cpp; `inline constexpr` so an op kernel that includes this header but does
+// not compare op_kind (every kernel except status) does not trip -Wunused-const-variable.
+inline constexpr uint32_t kOpKindPing = 1;
+inline constexpr uint32_t kOpKindExists = 2;
+inline constexpr uint32_t kOpKindRemove = 3;
+inline constexpr uint32_t kOpKindPut = 4;
+inline constexpr uint32_t kOpKindGet = 5;
+inline constexpr uint32_t kOpKindMoveToHost = 6;
+inline constexpr uint32_t kOpKindMoveToDevice = 7;
+inline constexpr uint32_t kOpKindDetach = 8;
+inline constexpr uint32_t kOpKindCommitBarrier = 9;
+
+// Base RT args, packed identically by the host operation launcher for every op.
+struct ClientBaseArgs {
+    uint32_t op_kind;
+    uint32_t client_l1_base;
+    uint32_t server_l1_base;
+    uint32_t server_noc_x;
+    uint32_t server_noc_y;
+    uint32_t base_ring_slot_idx;
+    uint32_t payload_size;
+    uint32_t route_word;
+    uint32_t num_chunks;
+    uint32_t total_value_len;
+    uint32_t client_dram_addr;
+    uint32_t logical_page_size;
+    uint32_t tensor_slot_id;
+    uint32_t value_byte_off;
+    uint32_t client_token;  // Server-issued registry ID + generation; goes in every packet header
+};
+
+// Consume the 15 base words in ABI order, advancing rt_arg_idx to the first op-specific
+// extra. Each op uses only the fields it needs; the rest are consumed to keep the fabric
+// args at the right offset.
+FORCE_INLINE ClientBaseArgs parse_base_args(size_t& rt_arg_idx) {
+    ClientBaseArgs a;
+    a.op_kind = get_arg_val<uint32_t>(rt_arg_idx++);
+    a.client_l1_base = get_arg_val<uint32_t>(rt_arg_idx++);
+    a.server_l1_base = get_arg_val<uint32_t>(rt_arg_idx++);
+    a.server_noc_x = get_arg_val<uint32_t>(rt_arg_idx++);
+    a.server_noc_y = get_arg_val<uint32_t>(rt_arg_idx++);
+    a.base_ring_slot_idx = get_arg_val<uint32_t>(rt_arg_idx++);
+    a.payload_size = get_arg_val<uint32_t>(rt_arg_idx++);
+    a.route_word = get_arg_val<uint32_t>(rt_arg_idx++);
+    a.num_chunks = get_arg_val<uint32_t>(rt_arg_idx++);
+    a.total_value_len = get_arg_val<uint32_t>(rt_arg_idx++);
+    a.client_dram_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    a.logical_page_size = get_arg_val<uint32_t>(rt_arg_idx++);
+    a.tensor_slot_id = get_arg_val<uint32_t>(rt_arg_idx++);
+    a.value_byte_off = get_arg_val<uint32_t>(rt_arg_idx++);
+    a.client_token = get_arg_val<uint32_t>(rt_arg_idx++);
+    return a;
+}
+
+// Ring-slot send: one fused fabric packet writes `total_aligned` bytes from
+// `src_l1_addr` into the server's ring slot at `target_slot` and atomically
+// inc's that slot's ring sem. `total_aligned` must be 16-byte aligned (caller pads).
+// Used by get (chunk 0), put_writer (chunk 0), and send_single_and_wait.
+FORCE_INLINE void send_slot_packet(
+    tt::tt_fabric::WorkerToFabricEdmSender& connection,
+    volatile tt_l1_ptr PACKET_HEADER_TYPE* hdr,
+    uint32_t route_word,
+    uint32_t server_noc_x,
+    uint32_t server_noc_y,
+    uint32_t server_l1_base,
+    uint32_t target_slot,
+    uint32_t src_l1_addr,
+    uint32_t total_aligned) {
+    uint64_t ring_noc =
+        get_noc_addr(server_noc_x, server_noc_y, server_l1_base + kRingBaseOffset + target_slot * kRingSlotStride);
+    uint64_t ring_sem_noc =
+        get_noc_addr(server_noc_x, server_noc_y, server_l1_base + kRingSemBaseOffset + target_slot * kRingSemSize);
+    set_unicast_route(hdr, route_word);
+    // Fused payload write + ring-sem atomic inc in one fabric packet; the receiver
+    // applies the write before the inc, preserving write-before-signal ordering.
+    hdr->to_noc_fused_unicast_write_atomic_inc(
+        tt::tt_fabric::NocUnicastAtomicIncFusedCommandHeader{ring_noc, ring_sem_noc, 1}, total_aligned);
+    connection.wait_for_empty_write_slot();
+    connection.send_payload_without_header_non_blocking_from_address(src_l1_addr, total_aligned);
+    connection.send_payload_blocking_from_address(reinterpret_cast<uint32_t>(hdr), sizeof(PACKET_HEADER_TYPE));
+}
+
+// Single-packet send (+ optional wait), wrapped by status {exists/remove/move} and ping: build
+// the request in tx_staging, fabric-write once, then optionally wait on a client sem. `inline` keeps
+// the shared header from tripping -Wunused-function in kernels that do not use it.
+inline void send_single_and_wait(
+    tt::tt_fabric::WorkerToFabricEdmSender& connection,
+    volatile tt_l1_ptr PACKET_HEADER_TYPE* hdr,
+    uint32_t route_word,
+    uint32_t server_noc_x,
+    uint32_t server_noc_y,
+    uint32_t server_l1_base,
+    uint32_t target_slot,
+    uint32_t tx_staging_addr,
+    uint32_t total,
+    uint32_t wait_sem_addr) {
+    send_slot_packet(
+        connection, hdr, route_word, server_noc_x, server_noc_y, server_l1_base, target_slot, tx_staging_addr, total);
+    connection.close();
+    if (wait_sem_addr != 0) {
+        volatile tt_l1_ptr uint32_t* p = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(wait_sem_addr);
+        noc_semaphore_wait(p, 1);
+        *p = 0;
+    }
+}
+
+}  // namespace ttnn::operations::kvcache_manager::client
diff --git a/ttnn/cpp/ttnn/operations/kvcache_manager/client/device/kernels/dataflow/establish_kernel.cpp b/ttnn/cpp/ttnn/operations/kvcache_manager/client/device/kernels/dataflow/establish_kernel.cpp
