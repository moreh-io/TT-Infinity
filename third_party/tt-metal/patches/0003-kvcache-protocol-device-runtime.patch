+FORCE_INLINE bool wait_for_get_value_batch(volatile tt_l1_ptr uint32_t* termination_ptr) {
+    while (!cb_pages_available_at_front(kGetValueCbId, kGetValueCbReadBatch)) {
+        invalidate_l1_cache();
+        if (*termination_ptr == static_cast<uint32_t>(tt::tt_fabric::TerminationSignal::IMMEDIATELY_TERMINATE)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+FORCE_INLINE bool wait_for_cumulative_target(
+    uint32_t address, uint32_t target, volatile tt_l1_ptr uint32_t* termination_ptr) {
+    auto* value = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(address);
+    while (true) {
+        invalidate_l1_cache();
+        const uint32_t observed = *value;
+        if (observed == target || cumulative_counter_is_ahead(observed, target)) {
+            return true;
+        }
+        if (*termination_ptr == static_cast<uint32_t>(tt::tt_fabric::TerminationSignal::IMMEDIATELY_TERMINATE)) {
+            return false;
+        }
+    }
+}
+
+// GET stream handler (fabric-direct-to-DRAM). The client sends exactly one chunk-0 GET_CHUNK_REQ
+// carrying the output tensor's DRAM base, page size, and packed capacity; this handler resolves the
+// key via the BRISC directory (status / total_value_len / num_chunks / value_byte_off). The BRISC
+// rejects an undersized output before producing data. On a hit it produces each value chunk into the
+// GET value CB; this NCRISC consumes the CB and fabric-writes each chunk
+// STRAIGHT into the client output-tensor DRAM page (interleaved) — no client recv-ring, no
+// writeback kernel, no credit loop. It finishes with one flush=true atomic-inc on a client completion
+// word (status_flags + 1), preserving zero as pending and ordering the signal after every successful
+// DRAM write is durable. Fabric-issued requests use the established recv semaphore; mapped ingress
+// uses its cumulative completion word. See ttnn/cpp/ttnn/operations/kvcache_manager/docs/design.md §6 (GET).
+FORCE_INLINE void handle_get_stream(
+    volatile tt_l1_ptr protocol::PacketHeader* hdr,
+    uint32_t slot_addr,
+    RegistryView reg,
+    uint32_t lookup_base,
+    KvmFabricSender* connections,
+    volatile tt_l1_ptr PACKET_HEADER_TYPE* const* get_headers,
+    uint32_t dram_value_base,
+    uint32_t get_admission_progress_addr,
+    bool get_admission_worker_enabled,
+    uint32_t& get_admission_source_expected,
+    uint32_t any_get_done_monitor_addr,
+    DirMailbox* mb,
+    volatile tt_l1_ptr uint32_t* termination_ptr) {
+    // This transport kernel intentionally has no detailed scopes. Focused profiles select the
+    // client and BRISC directory pipelines that own the actionable request breakdown.
+    ASSERT(reg.established_flag() == 1);
+    // The value read moved to the BRISC (GET value CB producer); this NCRISC is the CB consumer.
+
+    volatile tt_l1_ptr GetChunkReqHeader* req =
+        reinterpret_cast<volatile tt_l1_ptr GetChunkReqHeader*>(slot_addr + sizeof(protocol::PacketHeader));
+    // Client output-tensor DRAM base + page size. Capacity is forwarded through the lookup mailbox,
+    // where BRISC rejects an undersized target before producing any value chunks.
+    const uint32_t client_dram_base = req->client_dram_base;
+    const uint32_t logical_page_size = req->logical_page_size;
+    const uint32_t completion_mode = req->completion_mode;
+    ASSERT(completion_mode == 0 || completion_mode == kGetCompletionCumulativeV2);
+    if (completion_mode != 0) {
+        ASSERT(req->completion_l1_addr != 0);
+        ASSERT((req->completion_l1_addr % sizeof(uint32_t)) == 0);
+    }
+    const uint32_t completion_l1_addr =
+        completion_mode != 0 ? req->completion_l1_addr : reg.client_l1_base() + reg.recv_sem_offset();
+    (void)hdr;  // request seq no longer echoed (no per-chunk response header)
+
+    // Chunk-0 directory lookup: delegate key -> value resolution to the BRISC DRAM worker kernel
+    // (client only ever sends chunk 0). On a hit it stamps last_access; value_byte_off is the
+    // value's U-aligned heap byte offset (the stream reads chunk i from unit value_byte_off/U + i).
+    DirResult dr{0, 0, 1, 0};
+    {
+        const uint32_t key_src = slot_addr + sizeof(protocol::PacketHeader) + sizeof(GetChunkReqHeader);
+        const uint32_t key_len = req->key_len;
+        // Guard the key length (as in EXISTS): out-of-range is malformed, so treat it as not-found.
+        // Match the BRISC miss shape so a malformed key produces the same single-chunk miss stream.
+        if (key_len >= 1 && key_len <= kMaxKeyBytesDefault) {
+            dr = dir_lookup(
+                *mb, static_cast<uint32_t>(OpCode::GET_CHUNK_REQ), key_src, key_len, req->output_capacity_bytes);
+        }
+    }
+
+    const uint32_t mailbox_status_flags = dr.found;
+    const bool device_fill_pending = (mailbox_status_flags & kDirGetStatusDeviceFillPending) != 0;
+    const uint32_t status_flags = mailbox_status_flags & ~kDirGetStatusDeviceFillPending;
+    const uint32_t found = status_flags & kGetStatusFound;
+    const uint32_t total_value_len = dr.total_value_len;
+    const uint32_t num_chunks = dr.num_chunks;
+    const bool has_value = (found != 0) && ((status_flags & kGetStatusOutputTooSmall) == 0) && (total_value_len > 0);
+
+    LookupEntry entry = peer_lookup(lookup_base, reg.client_chip_id());
+    ASSERT(entry.conn_idx != kPeerLookupEmptySentinel);
+    auto& fab = connections[entry.conn_idx];
+
+    // The server inc's this request's completion word ONCE at the end by status_flags + 1.
+    // flush=true orders the completion after every value chunk written to client DRAM.
+    const uint64_t completion_noc = get_noc_addr(reg.client_noc_x(), reg.client_noc_y(), completion_l1_addr);
+
+    // No recv-ring / credit backpressure: one request's stream advances through distinct output
+    // pages. Different requests may alias an output tensor; the single server cursor serializes
+    // complete GET streams and preserves their input-order overwrite semantics.
+    // The BRISC owns the reverse-ACK monitor; this transport handler does not touch it.
+    (void)any_get_done_monitor_addr;
+
+    if (has_value) {
+        // Client output-tensor interleaved DRAM addr-gen (see client_dram_page_noc_addr: the server
+        // uses its own bank map, valid because same-arch chips share it; client_dram_base is explicit).
+        InterleavedAddrGen<true> client_out{
+            .bank_base_address = client_dram_base,
+            .page_size = logical_page_size,
+        };
+        (void)dram_value_base;
+
+        // For one-chunk pages, precompute bank bases and advance a row/bank cursor. Other page
+        // sizes use the general interleaved-address path below.
+        const bool fast_addr = (logical_page_size == kMaxChunkValueBytes);
+        uint64_t bank_noc[NUM_DRAM_BANKS];
+        uint64_t addr_row_stride = 0;
+        uint32_t addr_bank_cursor = 0;
+        uint64_t addr_row_offset = 0;
+        if (fast_addr) {
+            for (uint32_t b = 0; b < NUM_DRAM_BANKS; ++b) {
+                bank_noc[b] = client_dram_page_noc_addr(client_out, b, 0);
+            }
+            // page NUM_DRAM_BANKS and page 0 are both bank 0 (row 1 vs row 0); the difference is exactly
+            // one row's local-address stride (identical coord bits cancel, no borrow since row1 > row0).
+            addr_row_stride = client_dram_page_noc_addr(client_out, NUM_DRAM_BANKS, 0) - bank_noc[0];
+        }
+
+        auto chunk_len = [&](uint32_t i) -> uint32_t {
+            const uint32_t stream_pos = i * kMaxChunkValueBytes;
+            const uint32_t remaining = total_value_len - stream_pos;
+            return (remaining < kMaxChunkValueBytes) ? remaining : kMaxChunkValueBytes;
+        };
+
+        // Fabric-write a CB-staged value chunk straight into the client output tensor DRAM, split at
+        // page boundaries (each interleaved page is on its own bank). PLAIN unicast write, NOT
+        // fused-with-atomic: the fused form is L1-only and can hang Blackhole DRAM (the completion
+        // atomic is a separate flush=true op after the loop). Non-blocking send, CB depth guards slot
+        // reuse; a chunk <= kMaxChunkValueBytes < MTU, so each sub-write fits one packet. Stateful
+        // send: setup_stateful_send_cmd_bufs pre-programs the EDM coordinate/VC once, and only local
+        // ops run between chunks, so that state survives the stream.
+        // The stream's destination is fixed for the whole request: pre-set the route on every
+        // ring header once instead of per chunk (route decode costs tens of cycles per call on 2D).
+        for (uint32_t h = 0; h < kGetServerHeaderRingDepth; ++h) {
+            set_unicast_route(get_headers[h], entry.route_word);
+        }
+        uint32_t header_send_count = 0;
+        auto next_get_header = [&]() {
+            if (header_send_count == kGetServerHeaderRingDepth) {
+                noc_async_write_barrier(noc_index);
+                header_send_count = 0;
+            }
+            return get_headers[header_send_count++];
+        };
+        auto send_chunk_to_dram = [&](uint32_t src_l1, uint32_t i, uint32_t chunk_value_len) {
+            if (fast_addr) {
+                const uint32_t send_bytes = (chunk_value_len + 15u) & ~15u;
+                const uint64_t dram_noc = bank_noc[addr_bank_cursor] + addr_row_offset;
+                if (++addr_bank_cursor == NUM_DRAM_BANKS) {
+                    addr_bank_cursor = 0;
+                    addr_row_offset += addr_row_stride;
+                }
+                volatile tt_l1_ptr PACKET_HEADER_TYPE* fhdr = next_get_header();
+                fhdr->to_noc_unicast_write(tt::tt_fabric::NocUnicastCommandHeader{dram_noc}, send_bytes);
+                fab.wait_for_empty_write_slot();
+                fab.send_current_slot_stateful_non_blocking(src_l1, send_bytes, reinterpret_cast<uint32_t>(fhdr));
+                return;
+            }
+            // General path (any other page size): split at page boundaries, per-sub-write interleaved addr.
+            const uint32_t stream_pos = i * kMaxChunkValueBytes;
+            uint32_t copied = 0;
+            while (copied < chunk_value_len) {
+                const uint32_t abs_pos = stream_pos + copied;
+                const uint32_t page_idx = abs_pos / logical_page_size;
+                const uint32_t in_page_off = abs_pos % logical_page_size;
+                const uint32_t page_remaining = logical_page_size - in_page_off;
+                const uint32_t want = chunk_value_len - copied;
+                const uint32_t this_write = (page_remaining < want) ? page_remaining : want;
+                // Alignment stays within the 32-byte-aligned page; padding bytes are unspecified.
+                const uint32_t send_bytes = (this_write + 15u) & ~15u;
+                const uint64_t dram_noc = client_dram_page_noc_addr(client_out, page_idx, in_page_off);
+                volatile tt_l1_ptr PACKET_HEADER_TYPE* fhdr = next_get_header();
+                fhdr->to_noc_unicast_write(tt::tt_fabric::NocUnicastCommandHeader{dram_noc}, send_bytes);
+                fab.wait_for_empty_write_slot();
+                fab.send_current_slot_stateful_non_blocking(
+                    src_l1 + copied, send_bytes, reinterpret_cast<uint32_t>(fhdr));
+                copied += this_write;
+            }
+        };
+
+        // Pop a CB batch only after Fabric and admission consumers are source-safe. Stateful send
+        // setup must remain intact until the completion atomic reprograms it. See
+        // ttnn/cpp/ttnn/operations/kvcache_manager/docs/design.md §6.
+        fab.setup_stateful_send_cmd_bufs();
+        {
+            // The producer pads its last batch to B entries. Drain real chunks and padding in one
+            // loop so teardown has one termination-aware CB wait and both CB pointers stay aligned.
+            const uint32_t padded =
+                ((num_chunks + kGetValueCbReadBatch - 1) / kGetValueCbReadBatch) * kGetValueCbReadBatch;
+            for (uint32_t base = 0; base < padded; base += kGetValueCbReadBatch) {
+                if (!wait_for_get_value_batch(termination_ptr)) {
+                    noc_async_write_barrier();
+                    return;
+                }
+                const uint32_t rd = get_read_ptr(kGetValueCbId);
+                for (uint32_t k = 0; k < kGetValueCbReadBatch; ++k) {
+                    const uint32_t i = base + k;
+                    if (i < num_chunks) {
+                        send_chunk_to_dram(rd + k * kMaxChunkValueBytes, i, chunk_len(i));
+                    }
+                }
+                noc_async_write_barrier(noc_index);
+                header_send_count = 0;
+                if (device_fill_pending && get_admission_worker_enabled) {
+                    ++get_admission_source_expected;
+                    if (!wait_for_cumulative_target(
+                            get_admission_progress_addr + kGetAdmissionSourceDoneWord * sizeof(uint32_t),
+                            get_admission_source_expected,
+                            termination_ptr)) {
+                        return;
+                    }
+                }
+                cb_pop_front(kGetValueCbId, kGetValueCbReadBatch);
+            }
+        }
+
+        if (device_fill_pending) {
+            auto* consumer_done = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(
+                mb->resp_mailbox_addr + kDirRespGetConsumerDoneWord * sizeof(uint32_t));
+            auto* admission_result = consumer_done + (kDirRespGetResultWord - kDirRespGetConsumerDoneWord);
+            noc_semaphore_set(consumer_done, 1u);
+            // An abort can reach this wait only after this RISC fenced the complete client stream;
+            // it merely releases teardown, so no separate hot-path branch is required.
+            noc_semaphore_wait_min(admission_result, 1u);
+        }
+    }
+
+    // Completion (always): one flush=true fabric atomic-inc on the request's client-L1 word. The
+    // receiving EDM drains its whole NoC-write pipeline before the inc, so a nonzero word implies the
+    // output tensor is fully durable. Adding one reserves zero for not-yet-complete while preserving
+    // all status bits. get_headers[0] is free (the loop's last send drained above).
+    {
+        volatile tt_l1_ptr PACKET_HEADER_TYPE* chdr = get_headers[0];
+        set_unicast_route(chdr, entry.route_word);
+        chdr->to_noc_unicast_atomic_inc(
+            tt::tt_fabric::NocUnicastAtomicIncCommandHeader{completion_noc, status_flags + 1u, /*flush=*/true});
+        fab.wait_for_empty_write_slot();
+        fab.send_payload_flush_blocking_from_address(reinterpret_cast<uint32_t>(chdr), sizeof(PACKET_HEADER_TYPE));
+    }
+}
+
+}  // namespace
+
+void kernel_main() {
+    // RT args (the host sends values only and relies on the meanings here).
+    size_t rt_arg_idx = 0;
+    uint32_t termination_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t num_connections = get_arg_val<uint32_t>(rt_arg_idx++);  // 0 = idle, 1..kMaxConnections = data mode
+    uint32_t server_l1_base = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t dram_value_base = get_arg_val<uint32_t>(rt_arg_idx++);  // value heap base (pages of U)
+    uint32_t max_keys = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t direct_put_done_addr = get_arg_val<uint32_t>(rt_arg_idx++);  // cumulative direct-DRAM completions
+    uint32_t rb_scratch_addr = get_arg_val<uint32_t>(rt_arg_idx++);       // PUT commit-fence DRAM read-back scratch
+    uint32_t any_get_done_monitor_addr = get_arg_val<uint32_t>(rt_arg_idx++);  // reverse-ACK address, BRISC-owned
+    uint32_t get_admission_progress_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    bool get_admission_worker_enabled = get_arg_val<uint32_t>(rt_arg_idx++) != 0;
+
+    // NCRISC <-> BRISC directory mailbox (GET/EXISTS/REMOVE/MOVE key lookup handoff).
+    uint32_t dir_req_mailbox_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t dir_req_sem_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t dir_done_sem_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t dir_resp_mailbox_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+
+    // Cold-start handshake: the BRISC sets this to 1 once its cold-start finishes. This RISC waits on
+    // it before serving so a client's first op can't race the cold-start.
+    uint32_t cold_start_done_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t commit_issued_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t commit_done_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t initial_counter = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t session_generation_seed = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t static_intermesh_remote_mesh_id = get_arg_val<uint32_t>(rt_arg_idx++);
+    ASSERT(rt_arg_idx == protocol::kServerTransportFixedRtArgs);
+
+    volatile tt_l1_ptr uint32_t* termination_ptr = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(termination_addr);
+
+    // Lifecycle / idle path: no fabric, no ring. Entered when no other chip is reachable (e.g. 1x1 mesh).
+    //
+    // KVM_SERVER_IDLE_ONLY is set by the host when it found no reachable peer, which makes everything
+    // below dead code. It has to be a compile-time define rather than the num_connections branch
+    // alone: num_connections is a runtime RT arg, so the compiler emits every handler anyway, and a
+    // no-peer build carrying them overruns the 0x4000 NCRISC IRAM limit -- the Server then fails to
+    // construct at all, in exactly the configuration that needs nothing but this loop.
+#if defined(KVM_SERVER_IDLE_ONLY)
+    ASSERT(num_connections == 0);
+    while (*termination_ptr != static_cast<uint32_t>(tt::tt_fabric::TerminationSignal::IMMEDIATELY_TERMINATE)) {
+    }
+    return;
+#else
+    // Reaching here means the host found at least one peer -- it emits the define above otherwise,
+    // and launch_server_kernel is the only place this kernel is built. Each branch asserts the
+    // other's premise instead of re-testing it at runtime.
+    ASSERT(num_connections > 0);
+
+    // Open one fabric connection per unique forwarding direction (host-ordered in the RT arg
+    // stream to match peer_lookup_table[chip_id].conn_idx).
+    ASSERT(num_connections <= kMaxConnections);
+#if defined(KVM_SERVER_USE_MUX_V2)
+    ASSERT(num_connections == 1);
+    KvmFabricSender connections[1];
+    connections[0] = KvmFabricSender::build_from_args(rt_arg_idx);
+    connections[0].open();
+#else
+    KvmFabricSender connections[kMaxConnections];
+    for (uint32_t i = 0; i < num_connections; ++i) {
+        connections[i] = KvmFabricSender::build_from_args<ProgrammableCoreType::TENSIX>(rt_arg_idx);
+        connections[i].open<true>();
+    }
+#endif
+
+    volatile tt_l1_ptr PACKET_HEADER_TYPE* packet_header_addr = PacketHeaderPool::allocate_header();
+    // The general control header is idle during a GET stream, so reuse it as the first GET header
+    // and allocate the remaining seven. All eight are drained before another handler can use it.
+    volatile tt_l1_ptr PACKET_HEADER_TYPE* get_headers[kGetServerHeaderRingDepth];
+    get_headers[0] = packet_header_addr;
+    for (uint32_t h = 1; h < kGetServerHeaderRingDepth; ++h) {
+        get_headers[h] = PacketHeaderPool::allocate_header();
+    }
+    uint32_t lookup_base = server_l1_base + kPeerLookupTableOffset;
+
+    // Initialize NCRISC-owned state before the first Client can establish.
+    for (uint32_t i = 0; i < kRingNumSlots; ++i) {
+        *reinterpret_cast<volatile tt_l1_ptr uint32_t*>(server_l1_base + kRingSemBaseOffset + i * kRingSemSize) = 0;
+    }
+    for (uint32_t c = 0; c < kMaxClients; ++c) {
+        *reinterpret_cast<volatile tt_l1_ptr uint32_t*>(put_direct_done_offset(direct_put_done_addr, c)) =
+            initial_counter;
+    }
+    *reinterpret_cast<volatile tt_l1_ptr uint32_t*>(put_stream_progress_offset(direct_put_done_addr)) = initial_counter;
+    for (uint32_t c = 0; c < kMaxClients; ++c) {
+        RegistryView reg = registry_entry(server_l1_base, c);
+        reg.base[8] = 0;
+        reg.base[9] = 0;
+        reg.base[kRegistryClientTokenWord] = make_client_token(c, session_generation_seed);
+        reg.base[kRegistryStateWord] = static_cast<uint32_t>(ClientRegistryState::Empty);
+    }
+    // No get_credit zero-init here: the host initializes the former GET-credit cacheline as the
+    // admission worker's cumulative source-safe and durable counters.
+
+    // Directory mailbox (see DirMailbox): `issued` starts at the shared cumulative-counter baseline.
+    DirMailbox dir_mailbox{
+        dir_req_mailbox_addr, dir_req_sem_addr, dir_done_sem_addr, dir_resp_mailbox_addr, initial_counter};
+
+    // One cursor per Client, each walking that Client's own ring partition. Scanning
+    // them round-robin is what keeps an idle Client from stalling the others: a partition with
+    // nothing ready is skipped instead of spun on.
+    uint32_t cursor[kMaxClients];
+    for (uint32_t c = 0; c < kMaxClients; ++c) {
+        cursor[c] = 0;
+    }
+    // Set by DETACH so this client's cursor restarts with the next Client's own slot cursor.
+    bool rewind_cursor = false;
+    // Where the round-robin resumes, so a busy partition cannot starve the ones after it.
+    uint32_t scan_client = 0;
+    uint32_t scan_bootstrap_peer = 0;
+    // PUT state is per-client: the buddy-block lease and the landed-fence baseline both describe
+    // one Client's stream. Sharing them would let one Client bind another's lease and read another's
+    // completion increments as its own. GET streaming stays serialized -- one at a time through this
+    // dispatch loop, so requests from different Clients are interleaved but not executed concurrently.
+    PutLeaseState put_lease[kMaxClients];
+    uint32_t direct_done_expected[kMaxClients];
+    for (uint32_t c = 0; c < kMaxClients; ++c) {
+        put_lease[c] = PutLeaseState{0, 0, 0, false};
+        direct_done_expected[c] = initial_counter;
+    }
+    // GET admission is serialized through this dispatch loop, so its cumulative source-safe
+    // baseline stays a single shared counter.
+    uint32_t get_admission_source_expected = initial_counter;
+    auto* commit_issued = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(commit_issued_addr);
+    auto* commit_done = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(commit_done_addr);
+    uint32_t put_issued_total = initial_counter;
+    *commit_issued = put_issued_total;
+    // Do not serve until BRISC has initialized the directory, hash index, and allocator. The host
+    // reset prevents a prior lifetime's completion from opening this gate.
+    volatile tt_l1_ptr uint32_t* cold_start_done = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(cold_start_done_addr);
+    while (*cold_start_done != 1 &&
+           *termination_ptr != static_cast<uint32_t>(tt::tt_fabric::TerminationSignal::IMMEDIATELY_TERMINATE)) {
+        invalidate_l1_cache();
+    }
+
+    // The host admits no new requests and quiesces the only Client before setting termination.
+    while (*termination_ptr != static_cast<uint32_t>(tt::tt_fabric::TerminationSignal::IMMEDIATELY_TERMINATE)) {
+        invalidate_l1_cache();
+
+        const uint32_t bootstrap_peer = scan_bootstrap_peer;
+        scan_bootstrap_peer = (scan_bootstrap_peer + 1 == kBootstrapPeerSlots) ? 0 : scan_bootstrap_peer + 1;
+        volatile tt_l1_ptr uint32_t* bootstrap_sem = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(
+            server_l1_base + bootstrap_request_sem_offset(bootstrap_peer));
+        if (*bootstrap_sem != 0) {
+            RegistryView bootstrap_reg = registry_entry(server_l1_base, bootstrap_peer);
+            const bool reset_partition = handle_establish_request(
+                server_l1_base,
+                bootstrap_peer,
+                bootstrap_reg,
+                lookup_base,
+                dram_value_base,
+                put_direct_done_offset(direct_put_done_addr, bootstrap_peer),
+                put_stream_progress_offset(direct_put_done_addr),
+                static_intermesh_remote_mesh_id,
+                connections,
+                packet_header_addr);
+            *bootstrap_sem = 0;
+            if (reset_partition) {
+                cursor[bootstrap_peer] = 0;
+                // Preserve a speculative lease across a clean replacement session. The replacement does not
+                // know its descriptor, so its first fallback PUT returns or reuses it through BRISC.
+            }
+        }
+
+        // Advance the round-robin first, so the partition served last goes to the back of the queue.
+        const uint32_t owner = scan_client;
+        scan_client = (scan_client + 1 == kMaxClients) ? 0 : scan_client + 1;
+
+        uint32_t idx = ring_base_slot(owner) + cursor[owner] % kRingSlotsPerClient;
+        uint32_t slot_addr = server_l1_base + kRingBaseOffset + idx * kRingSlotStride;
+        uint32_t ring_sem_addr = server_l1_base + kRingSemBaseOffset + idx * kRingSemSize;
+
+        volatile tt_l1_ptr uint32_t* ring_sem_ptr = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(ring_sem_addr);
+
+        // Nothing at this Client's next slot -- move on to the next Client rather than waiting here.
+        if (*ring_sem_ptr == 0) {
+            continue;
+        }
+
+        volatile tt_l1_ptr protocol::PacketHeader* hdr =
+            reinterpret_cast<volatile tt_l1_ptr protocol::PacketHeader*>(slot_addr);
+        uint32_t op = hdr->opcode;
+        uint32_t psize = hdr->payload_size;
+        RegistryView reg = registry_entry(server_l1_base, owner);
+        const bool token_matches =
+            client_id_from_token(hdr->client_token) == owner && reg.client_token() == hdr->client_token;
+        const bool state_allows_request = reg.state() == ClientRegistryState::Established;
+        if (!token_matches || !state_allows_request) {
+            // A late packet from a taken-over generation must not execute against the replacement
+            // Client's registry. Its old sender owns no live response destination, so discard it.
+            *ring_sem_ptr = 0;
+            cursor[owner]++;
+            continue;
+        }
+
+        switch (op) {
+            case static_cast<uint32_t>(OpCode::PING):
+                handle_ping(hdr, slot_addr, psize, reg, lookup_base, connections, packet_header_addr);
+                break;
+            case static_cast<uint32_t>(OpCode::PUT_CHUNK):
+                handle_put(
+                    slot_addr,
+                    reg,
+                    lookup_base,
+                    connections,
+                    packet_header_addr,
+                    dram_value_base,
+                    max_keys,
+                    put_direct_done_offset(direct_put_done_addr, owner),
+                    &dir_mailbox,
+                    rb_scratch_addr,
+                    put_lease[owner],
+                    direct_done_expected[owner],
+                    commit_issued,
+                    put_issued_total);
+                break;
+            case static_cast<uint32_t>(OpCode::COMMIT_BARRIER):
+                handle_commit_barrier(
+                    reg, lookup_base, put_issued_total, commit_done, termination_ptr, connections, packet_header_addr);
+                break;
+            case static_cast<uint32_t>(OpCode::GET_CHUNK_REQ):
+                handle_get_stream(
+                    hdr,
+                    slot_addr,
+                    reg,
+                    lookup_base,
+                    connections,
+                    get_headers,
+                    dram_value_base,
+                    get_admission_progress_addr,
+                    get_admission_worker_enabled,
+                    get_admission_source_expected,
+                    any_get_done_monitor_addr,
+                    &dir_mailbox,
+                    termination_ptr);
+                break;
+            case static_cast<uint32_t>(OpCode::EXISTS):
+                handle_exists(
+                    hdr,
+                    slot_addr,
+                    reg,
+                    lookup_base,
+                    put_issued_total,
+                    commit_done,
+                    termination_ptr,
+                    connections,
+                    packet_header_addr,
+                    &dir_mailbox);
+                break;
+            case static_cast<uint32_t>(OpCode::REMOVE):
+                handle_remove(hdr, slot_addr, reg, lookup_base, connections, packet_header_addr, &dir_mailbox);
+                break;
+            // DETACH: release the session so a later Client can establish (see handle_detach).
+            // The next Client picks ring slots from a cursor of its own that starts at zero, so
+            // this cursor has to rewind with it -- otherwise the Server keeps watching the slot
+            // after the last request and never sees the new Client's ESTABLISH.
+            case static_cast<uint32_t>(OpCode::DETACH):
+                handle_detach(hdr, slot_addr, reg, lookup_base, connections, packet_header_addr);
+                rewind_cursor = true;
+                break;
+
+            // MOVE_TO_HOST / MOVE_TO_DEVICE: acknowledge BRISC acceptance (see handle_move).
+            case static_cast<uint32_t>(OpCode::MOVE_TO_HOST):
+            case static_cast<uint32_t>(OpCode::MOVE_TO_DEVICE):
+                handle_move(hdr, slot_addr, op, reg, lookup_base, connections, packet_header_addr, &dir_mailbox);
+                break;
+            default: break;
+        }
+
+        *ring_sem_ptr = 0;
+        if (rewind_cursor) {
+            rewind_cursor = false;
+            cursor[owner] = 0;
+        } else {
+            cursor[owner]++;
+        }
+    }
+
+#if defined(KVM_SERVER_USE_MUX_V2)
+    connections[0].close();
+#else
+    for (uint32_t i = 0; i < num_connections; ++i) {
+        connections[i].close();
+    }
+#endif
+#endif  // KVM_SERVER_IDLE_ONLY
+}
