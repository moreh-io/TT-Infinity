+void ClientOperations::commit_barrier() {
+    const std::array<uint32_t, 32> empty_payload{};
+    RequestTransaction request{*this, /*ring_slots_consumed=*/1, /*put_count=*/0};
+    launch_status_client(
+        kOpKindCommitBarrier,
+        request.base_ring_slot(),
+        /*key_len=*/0,
+        request.seq(),
+        empty_payload,
+        /*blocking=*/true,
+        request);
+    request.complete();
+}
+
+void ClientOperations::put(
+    const std::string& key, const Tensor& value_tensor, uint32_t value_len_bytes, bool sync_commit) {
+    auto operation_lock = acquire_operation();
+    const auto t_entry = std::chrono::steady_clock::now();
+    check_operational();
+    validate_key(key, "put");
+
+    validate_tensor_layout(value_tensor, client_submesh_, "put");
+
+    TT_FATAL(value_len_bytes > 0, "put: value_len_bytes must be > 0");
+    TT_FATAL(
+        value_len_bytes <= max_value_bytes_,
+        "put: value_len_bytes {} exceeds max_value_bytes {}",
+        value_len_bytes,
+        max_value_bytes_);
+
+    const uint32_t total_value_len = value_len_bytes;
+    const uint32_t key_len = static_cast<uint32_t>(key.size());
+    const uint32_t num_value_chunks = protocol::chunk_count_for(total_value_len);
+
+    const auto& value_spec = value_tensor.tensor_spec();
+    const uint64_t buf_bytes = static_cast<uint64_t>(value_spec.compute_packed_buffer_size_bytes());
+    TT_FATAL(
+        static_cast<uint64_t>(total_value_len) <= buf_bytes,
+        "put: value_len {} exceeds tensor packed bytes {}",
+        total_value_len,
+        buf_bytes);
+
+    const uint32_t logical_page_size = static_cast<uint32_t>(value_spec.compute_page_size_bytes());
+    TT_FATAL(logical_page_size > 0, "put: tensor logical page size must be > 0");
+
+    const uint32_t num_chunks = 1u + num_value_chunks;
+    TT_FATAL(num_chunks >= 2, "put: computed num_chunks {} < 2 (internal error)", num_chunks);
+
+    // The Server owns allocation; the transaction retains input storage through direct transfer.
+    const auto t_alloc0 = std::chrono::steady_clock::now();
+    auto tensor_buffer = tensor_buffer_keep_alive(value_tensor);
+    const uint32_t client_dram_addr = static_cast<uint32_t>(value_tensor.mesh_buffer().address());
+    const auto t_alloc1 = std::chrono::steady_clock::now();
+
+    const auto t_build0 = std::chrono::steady_clock::now();
+    const auto& logical_shape = value_tensor.logical_shape();
+    const uint32_t rank = static_cast<uint32_t>(logical_shape.rank());
+
+    PutChunk0Args chunk0{};
+    chunk0.num_pages = logical_page_size > 0 ? (static_cast<uint32_t>(buf_bytes) / logical_page_size) : 0;
+    chunk0.dtype = static_cast<uint32_t>(value_tensor.dtype());
+    chunk0.layout = static_cast<uint32_t>(value_tensor.layout());
+    chunk0.rank = rank;
+    for (uint32_t d = 0; d < protocol::kTensorShapeMaxRank; ++d) {
+        chunk0.shape[d] = (d < rank) ? static_cast<uint32_t>(logical_shape[static_cast<int32_t>(d)]) : 0u;
+    }
+    chunk0.key_len = key_len;
+    for (uint32_t j = 0; j < key_len; ++j) {
+        chunk0.key_words[j >> 2] |= static_cast<uint32_t>(static_cast<uint8_t>(key[j])) << ((j & 3) * 8);
+    }
+    const auto t_build1 = std::chrono::steady_clock::now();
+    RequestTransaction request{*this, /*ring_slots_consumed=*/1, /*put_count=*/1, std::move(tensor_buffer)};
+    chunk0.stream_id_seq = request.seq();
+
+    // recv_sem / produced_sem / consumed_sem are self-zeroed by the writer/reader
+    // kernels at launch (per-op cumulative baseline); the host does not write them.
+
+    // The device writer waits through the server's device-DRAM read-back fence. A failure after
+    // enqueue remains indeterminate and quarantines Client resources plus the input tensor backing.
+    const auto t_launch0 = std::chrono::steady_clock::now();
+    const PutLaunchTiming launch_timing = launch_put_client(
+        request.base_ring_slot(),
+        num_chunks,
+        key_len,
+        total_value_len,
+        client_dram_addr,
+        logical_page_size,
+        chunk0,
+        request);
+    const auto t_launch1 = std::chrono::steady_clock::now();
+
+    request.complete();
+    if (sync_commit) {
+        commit_barrier();
+    }
+    const auto t_commit1 = std::chrono::steady_clock::now();
+
+    if (put_phase_profile_enabled_) {
+        ++put_profile_counters_.count;
+        put_profile_counters_.prepare_ns +=
+            static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(t_launch0 - t_entry).count());
+        put_profile_counters_.program_ns += launch_timing.program_ns;
+        put_profile_counters_.enqueue_ns += launch_timing.enqueue_ns;
+        put_profile_counters_.landed_wait_ns += launch_timing.landed_wait_ns;
+        put_profile_counters_.commit_wait_ns +=
+            static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(t_commit1 - t_launch1).count());
+        put_profile_counters_.total_ns +=
+            static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(t_commit1 - t_entry).count());
+    }
+
+    if (kvcache_profile_) {
+        const uint64_t preamble_ns = std::chrono::duration_cast<std::chrono::nanoseconds>(t_alloc0 - t_entry).count();
+        const uint64_t alloc_ns = std::chrono::duration_cast<std::chrono::nanoseconds>(t_alloc1 - t_alloc0).count();
+        const uint64_t build_ns = std::chrono::duration_cast<std::chrono::nanoseconds>(t_build1 - t_build0).count();
+        const uint64_t launch_call_ns =
+            std::chrono::duration_cast<std::chrono::nanoseconds>(t_launch1 - t_launch0).count();
+        const uint64_t commit_wait_ns =
+            std::chrono::duration_cast<std::chrono::nanoseconds>(t_commit1 - t_launch1).count();
+        const uint64_t body_total_ns =
+            std::chrono::duration_cast<std::chrono::nanoseconds>(t_commit1 - t_entry).count();
+        log_info(
+            tt::LogOp,
+            "KVCACHE_HOST[put_body] value_len={} preamble_ns={} alloc_ns={} build_ns={} launch_call_ns={} "
+            "commit_wait_ns={} body_total_ns={}",
+            total_value_len,
+            preamble_ns,
+            alloc_ns,
+            build_ns,
+            launch_call_ns,
+            commit_wait_ns,
+            body_total_ns);
+    }
+}
+
+ClientOperations::PreparedPut ClientOperations::prepare_put(
+    const std::string& key, const Tensor& value_tensor, uint32_t value_len_bytes, const char* op) const {
+    validate_key(key, op);
+    validate_tensor_layout(value_tensor, client_submesh_, op);
+    TT_FATAL(value_len_bytes > 0, "{}: value_len_bytes must be > 0", op);
+    TT_FATAL(
+        value_len_bytes <= max_value_bytes_,
+        "{}: value_len_bytes {} exceeds max_value_bytes {}",
+        op,
+        value_len_bytes,
+        max_value_bytes_);
+
+    const auto& value_spec = value_tensor.tensor_spec();
+    const uint64_t packed_bytes = static_cast<uint64_t>(value_spec.compute_packed_buffer_size_bytes());
+    TT_FATAL(
+        static_cast<uint64_t>(value_len_bytes) <= packed_bytes,
+        "{}: value_len {} exceeds tensor packed bytes {}",
+        op,
+        value_len_bytes,
+        packed_bytes);
+
+    PreparedPut prepared{};
+    prepared.total_value_len = value_len_bytes;
+    prepared.logical_page_size = static_cast<uint32_t>(value_spec.compute_page_size_bytes());
+    TT_FATAL(prepared.logical_page_size > 0, "{}: tensor logical page size must be > 0", op);
+    prepared.num_chunks = 1u + protocol::chunk_count_for(value_len_bytes);
+    TT_FATAL(prepared.num_chunks >= 2, "{}: computed num_chunks {} < 2", op, prepared.num_chunks);
+    prepared.client_dram_addr = static_cast<uint32_t>(value_tensor.mesh_buffer().address());
+    prepared.tensor_buffer = tensor_buffer_keep_alive(value_tensor);
+
+    const auto& logical_shape = value_tensor.logical_shape();
+    prepared.chunk0.num_pages = static_cast<uint32_t>(packed_bytes) / prepared.logical_page_size;
+    prepared.chunk0.dtype = static_cast<uint32_t>(value_tensor.dtype());
+    prepared.chunk0.layout = static_cast<uint32_t>(value_tensor.layout());
+    prepared.chunk0.rank = static_cast<uint32_t>(logical_shape.rank());
+    for (uint32_t d = 0; d < protocol::kTensorShapeMaxRank; ++d) {
+        prepared.chunk0.shape[d] =
+            d < prepared.chunk0.rank ? static_cast<uint32_t>(logical_shape[static_cast<int32_t>(d)]) : 0u;
+    }
+    prepared.chunk0.key_len = static_cast<uint32_t>(key.size());
+    for (uint32_t j = 0; j < prepared.chunk0.key_len; ++j) {
+        prepared.chunk0.key_words[j >> 2] |= static_cast<uint32_t>(static_cast<uint8_t>(key[j])) << ((j & 3) * 8);
+    }
+    return prepared;
+}
+
+void ClientOperations::put_batch(
+    const std::vector<std::string>& keys,
+    const std::vector<Tensor>& value_tensors,
+    const std::vector<uint32_t>& value_len_bytes,
+    bool sync_commit) {
+    auto operation_lock = acquire_operation();
+    check_operational();
+    TT_FATAL(
+        keys.size() == value_tensors.size() && keys.size() == value_len_bytes.size(),
+        "put_batch: keys, value_tensors, and value_len_bytes must have equal length; got {}, {}, and {}",
+        keys.size(),
+        value_tensors.size(),
+        value_len_bytes.size());
+    TT_FATAL(
+        keys.size() <= protocol::kClientPutBatchMaxItems,
+        "put_batch: batch size {} exceeds maximum {}",
+        keys.size(),
+        protocol::kClientPutBatchMaxItems);
+    if (keys.empty()) {
+        return;
+    }
+    std::vector<PreparedPut> prepared;
+    prepared.reserve(keys.size());
+    for (size_t item = 0; item < keys.size(); ++item) {
+        prepared.push_back(prepare_put(keys[item], value_tensors[item], value_len_bytes[item], "put_batch"));
+    }
+
+    reserve_put_batch_l1();
+    auto descriptor_bytes =
+        std::make_shared<std::vector<uint8_t>>(protocol::kClientPutBatchBufferSize, static_cast<uint8_t>(0));
+    for (size_t item = 0; item < prepared.size(); ++item) {
+        const auto& src = prepared[item];
+        protocol::PutBatchItemDescriptor descriptor{};
+        descriptor.num_chunks = src.num_chunks;
+        descriptor.total_value_len = src.total_value_len;
+        descriptor.client_dram_addr = src.client_dram_addr;
+        descriptor.logical_page_size = src.logical_page_size;
+        descriptor.num_pages = src.chunk0.num_pages;
+        descriptor.dtype = src.chunk0.dtype;
+        descriptor.layout = src.chunk0.layout;
+        descriptor.rank = src.chunk0.rank;
+        std::copy(std::begin(src.chunk0.shape), std::end(src.chunk0.shape), std::begin(descriptor.shape));
+        descriptor.key_len = src.chunk0.key_len;
+        std::copy(std::begin(src.chunk0.key_words), std::end(src.chunk0.key_words), std::begin(descriptor.key_words));
+        std::memcpy(
+            descriptor_bytes->data() + protocol::kClientPutBatchItemsOffset +
+                item * sizeof(protocol::PutBatchItemDescriptor),
+            &descriptor,
+            sizeof(descriptor));
+    }
+
+    const uint32_t batch_count = static_cast<uint32_t>(prepared.size());
+    RequestTransaction request{*this, batch_count, /*put_count=*/batch_count};
+    for (auto& item : prepared) {
+        request.retain_tensor(std::move(item.tensor_buffer));
+    }
+    request.retain_host_write(descriptor_bytes);
+
+    // This injection remains definitely-unsent: consume it before the descriptor CQ upload.
+    if (consume_test_fault(ClientOperationsTestFault::FailRequestBeforeEnqueue)) {
+        TT_THROW("injected Client request failure before enqueue");
+    }
+
+    auto& cq = client_submesh_->mesh_command_queue();
+    request.mark_submission_attempted();
+    tt::tt_metal::distributed::WriteShard(
+        cq, put_batch_desc_buf_, *descriptor_bytes, client_coord_, /*blocking=*/false);
+    if (consume_test_fault(ClientOperationsTestFault::FailPutBatchAfterDescriptorWrite)) {
+        TT_THROW("injected Client put_batch failure after descriptor write");
+    }
+
+    launch_put_batch_client(batch_count, request);
+    Finish(cq);
+    request.complete();
+    if (sync_commit) {
+        commit_barrier();
+    }
+}
+
+ClientPutProfile ClientOperations::put_profile() const { return put_profile_counters_; }
+
+void ClientOperations::flush() {
+    auto operation_lock = acquire_operation();
+    check_operational();
+    commit_barrier();
+}
+
+bool ClientOperations::get(const std::string& key, const Tensor& out_tensor) {
+    auto operation_lock = acquire_operation();
+    const auto t_entry = std::chrono::steady_clock::now();
+    check_operational();
+    validate_key(key, "get");
+
+    // The Server addresses this output using the same interleaved-page contract as PUT input.
+    validate_tensor_layout(out_tensor, client_submesh_, "get");
+
+    const auto& output_spec = out_tensor.tensor_spec();
+    const uint64_t output_capacity64 = static_cast<uint64_t>(output_spec.compute_packed_buffer_size_bytes());
+    TT_FATAL(output_capacity64 > 0, "get: out_tensor packed byte size must be > 0");
+    TT_FATAL(
+        output_capacity64 <= protocol::kMaxChunkAlignedValueBytes,
+        "get: out_tensor packed byte size {} exceeds the largest supported capacity {}",
+        output_capacity64,
+        protocol::kMaxChunkAlignedValueBytes);
+
+    const uint32_t output_capacity = static_cast<uint32_t>(output_capacity64);
+    const uint32_t logical_page_size = static_cast<uint32_t>(output_spec.compute_page_size_bytes());
+    TT_FATAL(logical_page_size > 0, "get: out_tensor logical page size must be > 0");
+
+    const uint32_t key_len = static_cast<uint32_t>(key.size());
+    const uint32_t num_chunks = protocol::chunk_count_for(output_capacity);
+    TT_FATAL(
+        num_chunks <= max_get_chunks_,
+        "get: out_tensor requires {} chunks, exceeds max_get_chunks {}",
+        num_chunks,
+        max_get_chunks_);
+
+    const uint32_t client_dram_addr = static_cast<uint32_t>(out_tensor.mesh_buffer().address());
+    auto tensor_buffer = tensor_buffer_keep_alive(out_tensor);
+
+    GetChunk0Args chunk0{};
+    chunk0.key_len = key_len;
+    for (uint32_t j = 0; j < key_len; ++j) {
+        chunk0.key_words[j >> 2] |= static_cast<uint32_t>(static_cast<uint8_t>(key[j])) << ((j & 3) * 8);
+    }
+
+    // Preserve host-commit ordering before reading the key.
+    commit_barrier();
+    RequestTransaction request{*this, /*ring_slots_consumed=*/1, /*put_count=*/0, std::move(tensor_buffer)};
+    chunk0.stream_id_seq = request.seq();
+
+    const auto t_launch0 = std::chrono::steady_clock::now();
+    launch_get_client(
+        request.base_ring_slot(),
+        num_chunks,
+        key_len,
+        output_capacity,
+        client_dram_addr,
+        logical_page_size,
+        chunk0,
+        request);
+    const auto t_launch1 = std::chrono::steady_clock::now();
+
+    // [profile-only] Drain first so the completion observation below is isolated from kernel time.
+    // Production uses the blocking status read as its one CQ synchronization point.
+    auto t_finish = t_launch1;
+    if (kvcache_profile_) {
+        // Client-chip-scoped drain: Finish would also wait on sibling chips' (model) work when the
+        // client shares the model's mesh.
+        wait_for_client_chip();
+        t_finish = std::chrono::steady_clock::now();
+    }
+
+    uint32_t status = 0;
+    std::vector<uint8_t> status_buf;
+    tt::tt_metal::distributed::ReadShard(
+        client_submesh_->mesh_command_queue(), status_buf, status_buf_, client_coord_, /*blocking=*/true);
+    TT_FATAL(
+        status_buf.size() >= sizeof(uint32_t),
+        "get status response is truncated: expected at least {} bytes, got {}",
+        sizeof(uint32_t),
+        status_buf.size());
+    std::memcpy(&status, status_buf.data(), sizeof(status));
+    const auto t_status1 = std::chrono::steady_clock::now();
+    request.complete();
+
+    TT_FATAL(
+        (status & protocol::kGetStatusOutputTooSmall) == 0,
+        "get: out_tensor packed capacity {} is smaller than the stored value",
+        output_capacity);
+
+    if (kvcache_profile_) {
+        const uint64_t preamble_ns = std::chrono::duration_cast<std::chrono::nanoseconds>(t_launch0 - t_entry).count();
+        const uint64_t launch_call_ns =
+            std::chrono::duration_cast<std::chrono::nanoseconds>(t_launch1 - t_launch0).count();
+        const uint64_t finish_ns = std::chrono::duration_cast<std::chrono::nanoseconds>(t_finish - t_launch1).count();
+        const uint64_t status_read_ns =
+            std::chrono::duration_cast<std::chrono::nanoseconds>(t_status1 - t_finish).count();
+        const uint64_t body_total_ns =
+            std::chrono::duration_cast<std::chrono::nanoseconds>(t_status1 - t_entry).count();
+        log_info(
+            tt::LogOp,
+            "KVCACHE_HOST[get_body] value_len={} preamble_ns={} launch_call_ns={} finish_ns={} status_read_ns={} "
+            "body_total_ns={}",
+            output_capacity,
+            preamble_ns,
+            launch_call_ns,
+            finish_ns,
+            status_read_ns,
+            body_total_ns);
+    }
+    return (status & protocol::kGetStatusFound) != 0;
+}
+
+std::vector<bool> ClientOperations::get_parallel(
+    const std::vector<ClientOperations*>& operations, const std::vector<std::string>& keys, const Tensor& out_tensor) {
+    const auto t_entry = std::chrono::steady_clock::now();
+    TT_FATAL(!operations.empty(), "get_parallel: clients must not be empty");
+    TT_FATAL(
+        operations.size() == keys.size(),
+        "get_parallel: clients and keys must have equal length ({} != {})",
+        operations.size(),
+        keys.size());
+
+    struct PendingGet {
+        ClientOperations* operations;
+        std::unique_lock<std::mutex> operation_lock;
+        std::unique_ptr<RequestTransaction> request;
+        uint32_t output_capacity;
+    };
+
+    std::vector<PendingGet> pending;
+    pending.reserve(operations.size());
+    TT_FATAL(operations.front() != nullptr, "get_parallel: client 0 is null");
+    MeshDevice* shared_mesh = operations.front()->client_submesh_;
+    auto& resident = operations.front()->parallel_get_prog_;
+    auto reset_incomplete_resident = [](ResidentParallelGetProgram* program) {
+        program->workload.reset();
+        program->operations.clear();
+        program->kernel_ids.clear();
+        program->compiled = false;
+    };
+    if (resident.workload != nullptr && resident.operations != operations) {
+        reset_incomplete_resident(&resident);
+    }
+    const bool build_workload = resident.workload == nullptr;
+    if (build_workload) {
+        resident.workload = std::make_unique<MeshWorkload>();
+        resident.operations = operations;
+        resident.kernel_ids.reserve(operations.size());
+    } else {
+        TT_ASSERT(resident.kernel_ids.size() == operations.size());
+    }
+    std::unique_ptr<ResidentParallelGetProgram, decltype(reset_incomplete_resident)> build_guard(
+        build_workload ? &resident : nullptr, reset_incomplete_resident);
+
+    // Keep each per-client lock and transaction through completion. A single
+    // aggregate workload is the mesh concurrency boundary for all chip-local
+    // programs.
+    for (std::size_t i = 0; i < operations.size(); ++i) {
+        ClientOperations* client = operations[i];
+        TT_FATAL(client != nullptr, "get_parallel: client {} is null", i);
+        auto operation_lock = client->acquire_operation();
+        client->check_operational();
+        TT_FATAL(
+            client->client_submesh_ == shared_mesh,
+            "get_parallel: all Clients must share one client mesh (client {} differs)",
+            i);
+        client->validate_key(keys[i], "get_parallel");
+        validate_tensor_layout(out_tensor, client->client_submesh_, "get_parallel");
+
+        const auto& output_spec = out_tensor.tensor_spec();
+        const uint64_t output_capacity64 = static_cast<uint64_t>(output_spec.compute_packed_buffer_size_bytes());
+        TT_FATAL(output_capacity64 > 0, "get_parallel: out_tensor packed byte size must be > 0");
+        TT_FATAL(
+            output_capacity64 <= protocol::kMaxChunkAlignedValueBytes,
+            "get_parallel: out_tensor packed byte size {} exceeds the largest supported capacity {}",
+            output_capacity64,
+            protocol::kMaxChunkAlignedValueBytes);
+        const uint32_t output_capacity = static_cast<uint32_t>(output_capacity64);
+        const uint32_t logical_page_size = static_cast<uint32_t>(output_spec.compute_page_size_bytes());
+        TT_FATAL(logical_page_size > 0, "get_parallel: out_tensor logical page size must be > 0");
+
+        const uint32_t key_len = static_cast<uint32_t>(keys[i].size());
+        const uint32_t num_chunks = protocol::chunk_count_for(output_capacity);
+        TT_FATAL(
+            num_chunks <= client->max_get_chunks_,
+            "get_parallel: out_tensor requires {} chunks, exceeds max_get_chunks {}",
+            num_chunks,
+            client->max_get_chunks_);
+
+        GetChunk0Args chunk0{};
+        chunk0.key_len = key_len;
+        for (uint32_t j = 0; j < key_len; ++j) {
+            chunk0.key_words[j >> 2] |= static_cast<uint32_t>(static_cast<uint8_t>(keys[i][j])) << ((j & 3) * 8);
+        }
+
+        auto request = std::make_unique<RequestTransaction>(
+            *client,
+            /*ring_slots_consumed=*/1,
+            /*put_count=*/0,
+            tensor_buffer_keep_alive(out_tensor));
+        chunk0.stream_id_seq = request->seq();
+
+        IDevice* client_device = client->client_submesh_->get_device(client->client_coord_);
+        TT_FATAL(
+            static_cast<uint32_t>(client_device->num_dram_channels()) == client->server_num_dram_channels_ &&
+                client_device->dram_grid_size() == CoreCoord(client->server_dram_grid_x_, client->server_dram_grid_y_),
+            "get_parallel requires identical client/server DRAM bank layouts for client {}",
+            i);
+
+        ClientRtArgs args{
+            .op_kind = kOpKindGet,
+            .client_l1_base = client->client_l1_base_,
+            .server_l1_base = client->server_l1_base_,
+            .server_noc_x = client->server_noc_x_,
+            .server_noc_y = client->server_noc_y_,
+            .base_ring_slot_idx = request->base_ring_slot(),
+            .payload_size = static_cast<uint32_t>(sizeof(protocol::GetChunkReqHeader) + key_len),
+            .route_word_to_server = client->route_word_to_server_,
+            .num_chunks = num_chunks,
+            .total_value_len = output_capacity,
+            .client_dram_addr = static_cast<uint32_t>(out_tensor.mesh_buffer().address()),
+            .logical_page_size = logical_page_size,
+        };
+
+        if (build_workload) {
+            Program program = CreateProgram();
+            const CoreRange core_range(kClientCore, kClientCore);
+            const KernelHandle receiver_id = CreateKernel(
+                program,
+                kGetReceiverKernelPath,
+                core_range,
+                DataMovementConfig{
+                    .processor = DataMovementProcessor::RISCV_1,
+                    .noc = NOC::RISCV_1_default,
+                    .defines = client->client_kernel_defines(KvcacheKernelTarget::ClientGet)});
+            std::vector<uint32_t> rt_args = to_vec(args, client->client_token_);
+            rt_args.push_back(chunk0.stream_id_seq);
+            rt_args.push_back(chunk0.key_len);
+            for (uint32_t word : chunk0.key_words) {
+                rt_args.push_back(word);
+            }
+            rt_args.push_back(client->status_buf_base_);
+            TT_ASSERT(rt_args.size() == kRtaGetMappedCompletionEnabled);
+            rt_args.push_back(0u);
+            client->append_server_connection_rt_args(program, rt_args);
+            SetRuntimeArgs(program, receiver_id, kClientCore, rt_args);
+            resident.kernel_ids.push_back(receiver_id);
+            resident.workload->add_program(client->chip_range_, std::move(program));
+        } else {
+            Program& program = resident.workload->get_programs().at(client->chip_range_);
+            RuntimeArgsData& rta = GetRuntimeArgs(program, resident.kernel_ids[i], kClientCore);
+            rta[kRtaBaseRingSlot] = args.base_ring_slot_idx;
+            rta[kRtaPayloadSize] = args.payload_size;
+            rta[kRtaNumChunks] = args.num_chunks;
+            rta[kRtaTotalValueLen] = args.total_value_len;
+            rta[kRtaClientDramAddr] = args.client_dram_addr;
+            rta[kRtaLogicalPageSize] = args.logical_page_size;
+            rta[kRtaGetStreamSeq] = chunk0.stream_id_seq;
+            rta[kRtaGetKeyLen] = chunk0.key_len;
+            for (uint32_t word = 0; word < 32; ++word) {
+                rta[kRtaGetKeyWords + word] = chunk0.key_words[word];
+            }
+        }
+        pending.push_back(PendingGet{client, std::move(operation_lock), std::move(request), output_capacity});
+    }
+
+    const auto t_prepare_end = std::chrono::steady_clock::now();
+    if (!resident.compiled) {
+        for (ClientOperations* client : operations) {
+            Program& program = resident.workload->get_programs().at(client->chip_range_);
+            tt::tt_metal::detail::CompileProgram(shared_mesh, program);
+        }
+        resident.compiled = true;
+    }
+    build_guard.release();
+    const auto t_compile_end = std::chrono::steady_clock::now();
+
+    for (auto& item : pending) {
+        item.operations->check_injected_request_before_enqueue();
+    }
+    for (auto& item : pending) {
+        item.request->mark_submission_attempted();
+    }
+    EnqueueMeshWorkload(shared_mesh->mesh_command_queue(), *resident.workload, /*blocking=*/false);
+    for (auto& item : pending) {
+        if (item.operations->consume_test_fault(ClientOperationsTestFault::FailRequestAfterEnqueue)) {
+            TT_THROW("injected Client request failure after parallel enqueue");
+        }
+    }
+    const auto t_enqueue_end = std::chrono::steady_clock::now();
+
+    // Queue every status read before waiting; the final blocking read covers
+    // all preceding reads on the shared command queue.
+    std::vector<std::vector<uint8_t>> status_bufs(pending.size());
+    for (std::size_t i = 0; i < pending.size(); ++i) {
+        auto& item = pending[i];
+        tt::tt_metal::distributed::ReadShard(
+            item.operations->client_submesh_->mesh_command_queue(),
+            status_bufs[i],
+            item.operations->status_buf_,
+            item.operations->client_coord_,
+            /*blocking=*/i + 1 == pending.size());
+    }
+    const auto t_status_batch_end = std::chrono::steady_clock::now();
+
+    std::vector<bool> hits;
+    hits.reserve(pending.size());
+    for (std::size_t i = 0; i < pending.size(); ++i) {
+        auto& item = pending[i];
+        const auto& status_buf = status_bufs[i];
+        TT_FATAL(
+            status_buf.size() >= sizeof(uint32_t),
+            "get_parallel status response is truncated: expected at least {} bytes, got {}",
+            sizeof(uint32_t),
+            status_buf.size());
+        uint32_t status = 0;
+        std::memcpy(&status, status_buf.data(), sizeof(status));
+        item.request->complete();
+        TT_FATAL(
+            (status & protocol::kGetStatusOutputTooSmall) == 0,
+            "get_parallel: out_tensor packed capacity {} is smaller than the stored value",
+            item.output_capacity);
+        hits.push_back((status & protocol::kGetStatusFound) != 0);
+    }
+    const auto t_end = std::chrono::steady_clock::now();
+    if (config::read_bool_env("KVM_CLIENT_PARALLEL_PHASE_LOG").value_or(false)) {
+        const auto ns = [](auto end, auto begin) {
+            return std::chrono::duration_cast<std::chrono::nanoseconds>(end - begin).count();
+        };
+        log_info(
+            tt::LogOp,
+            "KVCACHE_HOST[get_parallel] clients={} bytes_total={} resident_hit={} prepare_ns={} compile_ns={} "
+            "enqueue_ns={} status_batch_ns={} parse_ns={} total_ns={}",
+            operations.size(),
+            static_cast<uint64_t>(pending.front().output_capacity) * operations.size(),
+            !build_workload,
+            ns(t_prepare_end, t_entry),
+            ns(t_compile_end, t_prepare_end),
+            ns(t_enqueue_end, t_compile_end),
+            ns(t_status_batch_end, t_enqueue_end),
+            ns(t_end, t_status_batch_end),
+            ns(t_end, t_entry));
+    }
+    return hits;
+}
