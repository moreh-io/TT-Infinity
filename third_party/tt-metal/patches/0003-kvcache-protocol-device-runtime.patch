+
+TEST(KvCacheManagerBuddy, DefaultValueHeapUsesT3K90PercentBudget) {
+    constexpr uint32_t banks = 12;
+    constexpr uint32_t alignment = 32;
+    constexpr uint32_t server_shards = 8;
+    constexpr uint64_t device_dram_bytes = 12'849'278'208ull;
+    constexpr uint64_t budget = static_cast<uint64_t>(static_cast<double>(device_dram_bytes) * 0.9);
+
+    const auto endpoint_reservation = [=](uint32_t value_heap_bytes) {
+        const uint64_t num_units = value_heap_bytes / protocol::kMaxChunkValueBytes;
+        const std::array<std::pair<uint64_t, uint32_t>, 5> buffers{{
+            {value_heap_bytes, protocol::kMaxChunkValueBytes},
+            {static_cast<uint64_t>(protocol::kMaxKeysDefault) * protocol::kPutHostQueueEntryBytes,
+             protocol::kPutHostQueueEntryBytes},
+            {static_cast<uint64_t>(protocol::kMaxKeysDefault) *
+                 protocol::dir_entry_bytes(protocol::kMaxKeyBytesDefault),
+             protocol::dir_entry_bytes(protocol::kMaxKeyBytesDefault)},
+            {static_cast<uint64_t>(protocol::hash_num_buckets(protocol::kMaxKeysDefault)) * protocol::kHashBucketBytes,
+             protocol::kHashBucketBytes},
+            {num_units * protocol::kHeapMetadataEntryBytes, protocol::kHeapMetadataEntryBytes},
+        }};
+
+        uint64_t size_per_bank = 0;
+        for (const auto& [logical_bytes, page_bytes] : buffers) {
+            size_per_bank +=
+                tt::tt_metal::detail::calculate_bank_size_spread(logical_bytes, page_bytes, banks, alignment);
+        }
+        return size_per_bank * banks * server_shards;
+    };
+
+    EXPECT_EQ(protocol::kValueHeapBytesDefault, 1'434'541'824u);
+    EXPECT_EQ(endpoint_reservation(protocol::kValueHeapBytesDefault), 11'564'089'344ull);
+    EXPECT_LE(endpoint_reservation(protocol::kValueHeapBytesDefault), budget);
+    EXPECT_EQ(
+        endpoint_reservation(protocol::kValueHeapBytesDefault + protocol::kMaxChunkValueBytes), 11'564'504'064ull);
+    EXPECT_GT(endpoint_reservation(protocol::kValueHeapBytesDefault + protocol::kMaxChunkValueBytes), budget);
+}
+
+TEST(KvCacheManagerCounter, DetectsOnlyForwardModuloProgress) {
