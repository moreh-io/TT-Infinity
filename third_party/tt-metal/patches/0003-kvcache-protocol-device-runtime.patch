diff --git a/ttnn/cpp/ttnn/operations/kvcache_manager/common/fabric_helpers.hpp b/ttnn/cpp/ttnn/operations/kvcache_manager/common/fabric_helpers.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..d5779e7548a4c4ddfb4bc55a921d03d27b34216b
--- /dev/null
+++ b/ttnn/cpp/ttnn/operations/kvcache_manager/common/fabric_helpers.hpp
@@ -0,0 +1,279 @@
+// SPDX-FileCopyrightText: (c) 2026 Moreh
+//
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include <algorithm>
+#include <cstdlib>
+#include <cstdint>
+#include <limits>
+#include <map>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include <fmt/ranges.h>
+#include <tt_stl/assert.hpp>
+
+#include <tt-metalium/experimental/fabric/fabric.hpp>
+#include <tt-metalium/experimental/fabric/fabric_types.hpp>
+
+#include "config.hpp"
+#include "protocol/packet.hpp"
+// The ttnn cpp module boundary forbids reaching into tt_metal/impl/* headers, so all
+// routing decisions go through fabric.hpp's free functions (eth_chan_directions comes
+// transitively from fabric.hpp via <hostdevcommon/fabric_common.h>).
+
+namespace ttnn::operations::kvcache_manager {
+
+inline constexpr uint32_t kDirectNeighborHopCount = 1;
+
+inline void validate_kvcache_fabric_config(const char* role) {
+    const auto fabric_config = tt::tt_fabric::GetFabricConfig();
+    TT_FATAL(
+        tt::tt_fabric::is_1d_fabric_config(fabric_config) || tt::tt_fabric::is_2d_fabric_config(fabric_config),
+        "{} requires a 1D or 2D fabric configuration",
+        role);
+    // Every L1 ring/stride in protocol/layout.hpp is sized off kFabricMaxPayloadBytes. Both
+    // fabric modes currently provision 4352 B payloads (erisc_datamover_builder.hpp
+    // static_asserts pin the defaults), but the size is user-overridable per fabric context;
+    // refuse to run if the active fabric ever provisions less. Callers hold an open mesh
+    // device, so the fabric context this reads is already initialized.
+    TT_FATAL(
+        tt::tt_fabric::get_tt_fabric_max_payload_size_bytes() >= protocol::kFabricMaxPayloadBytes,
+        "{}: fabric max payload {} B is smaller than the kvcache wire MTU {} B",
+        role,
+        tt::tt_fabric::get_tt_fabric_max_payload_size_bytes(),
+        protocol::kFabricMaxPayloadBytes);
+}
+
+inline bool is_kvcache_2d_fabric() { return tt::tt_fabric::is_2d_fabric_config(tt::tt_fabric::GetFabricConfig()); }
+
+// Wire route word (client rt-arg word[7] / server peer_lookup_table word[1]).
+// 1D: hop count (always 1 — a 1D wire only ever spans mutual direct neighbors). 2D:
+// (mesh_id << 16) | chip_id, decoded on the device by common/kvm_fabric_route.hpp
+// set_unicast_route into the packet header's unicast route. Because the 2D form is an absolute
+// destination rather than a distance, a 2D wire may span any number of hops.
+inline uint32_t kvcache_unicast_route_word(const tt::tt_fabric::FabricNodeId& dst) {
+    if (!is_kvcache_2d_fabric()) {
+        return kDirectNeighborHopCount;
+    }
+    TT_FATAL(
+        *dst.mesh_id <= 0xFFFFu && dst.chip_id <= 0xFFFFu,
+        "FabricNodeId (mesh {}, chip {}) does not fit the 16-bit wire route encoding",
+        *dst.mesh_id,
+        dst.chip_id);
+    return (static_cast<uint32_t>(*dst.mesh_id) << 16) | static_cast<uint32_t>(dst.chip_id);
+}
+
+inline bool is_direct_fabric_neighbor(const tt::tt_fabric::FabricNodeId& src, const tt::tt_fabric::FabricNodeId& dst) {
+    // The public helper compares bare chip IDs within src's mesh, while this protocol's peer table has no mesh ID.
+    if (src.mesh_id != dst.mesh_id) {
+        return false;
+    }
+    return !tt::tt_fabric::get_neighbor_eth_directions(src, dst).empty();
+}
+
+inline bool are_mutual_direct_fabric_neighbors(
+    const tt::tt_fabric::FabricNodeId& first, const tt::tt_fabric::FabricNodeId& second) {
+    return is_direct_fabric_neighbor(first, second) && is_direct_fabric_neighbor(second, first);
+}
+
+// First-hop eth direction a sender must inject into to reach dst — the direction whose EDM
+// connection the sender opens. 1D: the direct-neighbor scan, because the 1D route word is a hop
+// count pinned to one. 2D: the routing-table answer, which is defined for any reachable dst,
+// however many hops away. The device-side route decoded by kvm_fabric_route.hpp omits this first
+// hop (it is implied by the connection the packet was injected into), so the injection direction
+// and the header route must come from the same routing tables — they do, both here and in
+// fabric_set_unicast_route.
+inline std::optional<tt::tt_fabric::eth_chan_directions> kvcache_first_hop_direction(
+    const tt::tt_fabric::FabricNodeId& src, const tt::tt_fabric::FabricNodeId& dst) {
+    if (src.mesh_id != dst.mesh_id) {
+        // The peer lookup table is keyed by bare chip_id, so cross-mesh peers would alias.
+        return std::nullopt;
+    }
+    if (!is_kvcache_2d_fabric()) {
+        const auto directions = tt::tt_fabric::get_neighbor_eth_directions(src, dst);
+        if (directions.empty()) {
+            return std::nullopt;
+        }
+        return directions.front();
+    }
+    return tt::tt_fabric::get_eth_forwarding_direction(src, dst);
+}
+
+// Can the wire carry requests and responses between these two chips?
+// 1D: direct neighbors only. 2D: any pair the routing tables connect, in both directions — the
+// two are checked independently because dimension-order routing sends the request and the response
+// through different intermediate chips, so one direction being live does not imply the other.
+inline bool is_kvcache_wire_reachable(
+    const tt::tt_fabric::FabricNodeId& first, const tt::tt_fabric::FabricNodeId& second) {
+    if (!is_kvcache_2d_fabric()) {
+        return are_mutual_direct_fabric_neighbors(first, second);
+    }
+    if (first.mesh_id != second.mesh_id) {
+        return false;
+    }
+    return !tt::tt_fabric::get_forwarding_link_indices(first, second).empty() &&
+           !tt::tt_fabric::get_forwarding_link_indices(second, first).empty();
+}
+
+inline std::optional<uint32_t> kvcache_requested_wire_link_index() {
+    const auto requested = config::read_u64_env("KVM_WIRE_LINK_INDEX");
+    if (!requested.has_value()) {
+        return std::nullopt;
+    }
+    TT_FATAL(
+        *requested <= std::numeric_limits<uint32_t>::max(),
+        "KVM_WIRE_LINK_INDEX={} exceeds the uint32 link-index range",
+        *requested);
+    return static_cast<uint32_t>(*requested);
+}
+
+// Candidate link (routing plane) indices for a connection.
+//
+// The wire deliberately uses ONE plane per chip pair even where the mesh provisions several
+// (the Galaxy descriptors declare four channels): spreading a transfer across planes is a separate
+// piece of work, and the extra links are currently reserved for other traffic. KVM_WIRE_LINK_INDEX
+// picks WHICH plane -- it does not add any -- for the case where a particular plane must be avoided.
+//
+// Callers must have established reachability first. Shared-direction connections intersect these
+// candidates across their destinations; point-to-point callers take the first candidate.
+inline std::vector<uint32_t> kvcache_wire_link_indices(
+    const tt::tt_fabric::FabricNodeId& src, const tt::tt_fabric::FabricNodeId& dst) {
+    if (!is_kvcache_2d_fabric()) {
+        // 1D keeps its historical plane-0 connection. append_fabric_connection_rt_args resolves 1D
+        // directions through get_chip_neighbors precisely because the routing tables can miss links
+        // there (ring wraparound, tt-metal #22524), so asking the tables for an index could fail
+        // where the direct-neighbor connection the 1D wire has always opened works.
+        return {0};
+    }
+    const auto links = tt::tt_fabric::get_forwarding_link_indices(src, dst);
+    TT_FATAL(
+        !links.empty(),
+        "no fabric forwarding link from (mesh {}, chip {}) to (mesh {}, chip {})",
+        *src.mesh_id,
+        src.chip_id,
+        *dst.mesh_id,
+        dst.chip_id);
+    if (const auto requested = kvcache_requested_wire_link_index()) {
+        const uint32_t wanted = *requested;
+        const std::string usable_links = fmt::format("{}", fmt::join(links, ", "));
+        TT_FATAL(
+            std::find(links.begin(), links.end(), wanted) != links.end(),
+            "KVM_WIRE_LINK_INDEX={} cannot forward from (mesh {}, chip {}) to (mesh {}, chip {}); "
+            "usable links are {}",
+            wanted,
+            *src.mesh_id,
+            src.chip_id,
+            *dst.mesh_id,
+            dst.chip_id,
+            usable_links);
+        return {wanted};
+    }
+    return links;
+}
+
+inline uint32_t kvcache_wire_link_index(
+    const tt::tt_fabric::FabricNodeId& src, const tt::tt_fabric::FabricNodeId& dst) {
+    return kvcache_wire_link_indices(src, dst).front();
+}
+
+/// Selects the diagnostics consumed by a specific kernel; wire-layout defines are always shared.
+enum class KvcacheKernelTarget {
+    ClientUnprofiled,
+    ClientPut,
+    ClientGet,
+    ClientMove,
+    ServerTransport,
+    ServerDirectory,
+};
+
+enum class KvcacheRouteMode {
+    Standard,
+    StaticIntermeshGalaxyToT3k,
+    StaticIntermeshT3kToGalaxy,
+};
+
+/// Builds the DataMovementConfig.defines map for the kvcache kernels.
+///
+/// ring_slots / value_ring_depth are the host-resolved ring depths (env
+/// KVM_SERVER_L1_RING_SLOTS / KVM_CLIENT_L1_RING_SLOTS), injected as the
+/// KVM_RING_NUM_SLOTS / KVM_CLIENT_RING_SLOTS compile-time #defines so the kernels'
+/// layout.hpp constexprs pick up the env-tuned values at JIT time. BOTH defines are emitted
+/// on BOTH sides: the Server publishes session state at an offset following the Client value ring,
+/// and the Client needs the ring slot count for its cursor wrap
+/// (ttnn/cpp/ttnn/operations/kvcache_manager/docs/design.md §4).
+/// profile_detail is the Server-resolved snapshot shared with its Client so lazy kernel builds cannot
+/// observe a later environment change. ServerDirectory additionally requires its construction-time
+/// policy snapshot; other targets reject one.
+inline std::map<std::string, std::string> kvcache_kernel_defines(
+    uint32_t ring_slots,
+    uint32_t value_ring_depth,
+    KvcacheKernelTarget target,
+    config::ProfileDetail profile_detail,
+    std::optional<config::ServerDirectoryPolicy> directory_policy = std::nullopt,
+    KvcacheRouteMode route_mode = KvcacheRouteMode::Standard) {
+    const bool is_server_directory = target == KvcacheKernelTarget::ServerDirectory;
+    TT_FATAL(
+        is_server_directory == directory_policy.has_value(),
+        "ServerDirectory requires a policy snapshot, and other KV cache kernels must not receive one");
+    const bool is_client_target = target == KvcacheKernelTarget::ClientUnprofiled ||
+                                  target == KvcacheKernelTarget::ClientPut ||
+                                  target == KvcacheKernelTarget::ClientGet || target == KvcacheKernelTarget::ClientMove;
+    TT_FATAL(
+        route_mode != KvcacheRouteMode::StaticIntermeshGalaxyToT3k || is_client_target,
+        "the Galaxy-to-T3K static inter-mesh route is valid only for Client kernels");
+    TT_FATAL(
+        route_mode != KvcacheRouteMode::StaticIntermeshT3kToGalaxy || target == KvcacheKernelTarget::ServerTransport,
+        "the T3K-to-Galaxy static inter-mesh route is valid only for the Server transport kernel");
+
+    std::map<std::string, std::string> defines;
+    defines.emplace("KVM_RING_NUM_SLOTS", std::to_string(ring_slots));
+    defines.emplace("KVM_CLIENT_RING_SLOTS", std::to_string(value_ring_depth));
+    if (route_mode == KvcacheRouteMode::StaticIntermeshGalaxyToT3k) {
+        defines.emplace("KVM_STATIC_INTERMESH_GALAXY_TO_T3K", "1");
+    } else if (route_mode == KvcacheRouteMode::StaticIntermeshT3kToGalaxy) {
+        defines.emplace("KVM_STATIC_INTERMESH_T3K_TO_GALAXY", "1");
+    }
+    // Fused atomic_inc flush toggle. Emitted for ABI stability but not consumed by any send site
+    // today (they all use flush=true) — see layout.hpp kFusedFlush before wiring anything to it.
+    const bool fused_flush = config::read_bool_env("KVM_COMMON_FUSED_FLUSH").value_or(false);
+    defines.emplace("KVM_COMMON_FUSED_FLUSH", fused_flush ? "1" : "0");
+    if (directory_policy.has_value()) {
+        if (directory_policy->allocator_profile_enabled) {
+            defines.emplace("KVM_SERVER_ALLOCATOR_PROFILE", "1");
+        }
+        defines.emplace("KVM_SERVER_PUT_LEASE_EVICT", directory_policy->put_lease_evict ? "1" : "0");
+        defines.emplace(
+            "KVM_SERVER_PUT_LEASE_EVICT_ON_REPEAT_ONLY", directory_policy->put_lease_evict_on_repeat_only ? "1" : "0");
+    }
+    // Compile only the detail pipeline requested by a focused profile. Keeping client and directory
+    // selectors separate prevents an unrelated persistent kernel from consuming IRAM or marker budget.
+    if (profile_detail != config::ProfileDetail::None) {
+        if (profile_detail == config::ProfileDetail::Put) {
+            if (target == KvcacheKernelTarget::ClientPut) {
+                defines.emplace("KVM_PROFILE_CLIENT_PUT", "1");
+            } else if (target == KvcacheKernelTarget::ServerDirectory) {
+                defines.emplace("KVM_PROFILE_DIRECTORY_PUT", "1");
+            }
+        } else if (profile_detail == config::ProfileDetail::Get || profile_detail == config::ProfileDetail::GetHost) {
+            if (target == KvcacheKernelTarget::ClientGet) {
+                defines.emplace("KVM_PROFILE_CLIENT_GET", "1");
+            } else if (target == KvcacheKernelTarget::ServerDirectory) {
+                defines.emplace("KVM_PROFILE_DIRECTORY_GET", "1");
+            }
+        } else if (profile_detail == config::ProfileDetail::Move) {
+            if (target == KvcacheKernelTarget::ClientMove) {
+                defines.emplace("KVM_PROFILE_CLIENT_MOVE", "1");
+            } else if (target == KvcacheKernelTarget::ServerDirectory) {
+                defines.emplace("KVM_PROFILE_DIRECTORY_MOVE", "1");
+            }
+        }
+    }
+    return defines;
+}
+
+}  // namespace ttnn::operations::kvcache_manager
diff --git a/ttnn/cpp/ttnn/operations/kvcache_manager/common/kvm_device_zone.hpp b/ttnn/cpp/ttnn/operations/kvcache_manager/common/kvm_device_zone.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..6c47454cf8814f152935b58d674d4b1aac57d926
--- /dev/null
+++ b/ttnn/cpp/ttnn/operations/kvcache_manager/common/kvm_device_zone.hpp
@@ -0,0 +1,95 @@
+// SPDX-FileCopyrightText: (c) 2026 Moreh
+//
+// SPDX-License-Identifier: Apache-2.0
+//
+// KVM device-profiler detail gates (kernel-only header).
+//
+// Op-wall zones stay raw DeviceZoneScopedN under PROFILE_KERNEL. Focused profiles compile only one
+// client/directory pipeline through the selectors below, keeping unrelated persistent kernels out of
+// the 16 KiB IRAM and ~250-marker-per-RISC budgets. ConditionalScope is needed for the persistent
+// directory loop: the opcode is known only at runtime, while Tracy zone hashes are compile-time values.
+#pragma once
+
+#if defined(PROFILE_KERNEL)
+namespace kvm_profiler_detail {
+
+template <uint32_t TimerId>
+struct ConditionalScope {
+    bool start_marked = false;
+
+    inline __attribute__((always_inline)) explicit ConditionalScope(bool enabled) {
+        if (enabled && kernel_profiler::bufferHasRoom()) {
+            kernel_profiler::stackSize += kernel_profiler::PROFILER_L1_MARKER_UINT32_SIZE;
+            start_marked = true;
+            kernel_profiler::mark_time_at_index_inlined(kernel_profiler::wIndex, TimerId);
+            kernel_profiler::wIndex += kernel_profiler::PROFILER_L1_MARKER_UINT32_SIZE;
+        }
+    }
+
+    inline __attribute__((always_inline)) ~ConditionalScope() {
+        if (start_marked) {
+            kernel_profiler::mark_time_at_index_inlined(
+                kernel_profiler::wIndex, kernel_profiler::get_const_id(TimerId, kernel_profiler::ZONE_END));
+            kernel_profiler::wIndex += kernel_profiler::PROFILER_L1_MARKER_UINT32_SIZE;
+            kernel_profiler::stackSize -= kernel_profiler::PROFILER_L1_MARKER_UINT32_SIZE;
+        }
+    }
+};
+
+}  // namespace kvm_profiler_detail
+
+// Capture the invocation line once. A forwarded multi-line macro can otherwise report one line in
+// its pragma while hashing another, leaving a valid marker with no source-map name in the CSV.
+#define KVM_DETAIL_STRINGIZE_IMPL(value) #value
+#define KVM_DETAIL_STRINGIZE(value) KVM_DETAIL_STRINGIZE_IMPL(value)
+#define KVM_DETAIL_PROFILER_MSG(name, line) name "," __FILE__ "," KVM_DETAIL_STRINGIZE(line) ",KERNEL_PROFILER"
+#define KVM_ZONE_SCOPED_IF_IMPL(id, name, condition, line)                                      \
+    DO_PRAGMA(message(KVM_DETAIL_PROFILER_MSG(name, line)));                                    \
+    auto constexpr id##_hash = kernel_profiler::Hash16_CT(KVM_DETAIL_PROFILER_MSG(name, line)); \
+    kvm_profiler_detail::ConditionalScope<id##_hash> id##_zone(condition)
+#define KVM_ZONE_SCOPED_IF(id, name, condition) KVM_ZONE_SCOPED_IF_IMPL(id, name, condition, __LINE__)
+#else
+#define KVM_ZONE_SCOPED_IF(id, name, condition)
+#endif
+
+#if defined(KVM_PROFILE_CLIENT_PUT)
+#define KVM_ZONE_CLIENT_PUT(name) DeviceZoneScopedN(name)
+#else
+#define KVM_ZONE_CLIENT_PUT(name)
+#endif
+
+#if defined(KVM_PROFILE_CLIENT_GET)
+#define KVM_ZONE_CLIENT_GET(name) DeviceZoneScopedN(name)
+#else
+#define KVM_ZONE_CLIENT_GET(name)
+#endif
+
+#if defined(KVM_PROFILE_CLIENT_MOVE)
+#define KVM_ZONE_CLIENT_MOVE(name) DeviceZoneScopedN(name)
+#else
+#define KVM_ZONE_CLIENT_MOVE(name)
+#endif
+
+#if defined(KVM_PROFILE_DIRECTORY_PUT)
+#define KVM_ZONE_DIRECTORY_PUT(name) DeviceZoneScopedN(name)
+#define KVM_ZONE_DIRECTORY_PUT_IF(id, name, condition) KVM_ZONE_SCOPED_IF(id, name, condition)
+#else
+#define KVM_ZONE_DIRECTORY_PUT(name)
+#define KVM_ZONE_DIRECTORY_PUT_IF(id, name, condition)
+#endif
+
+#if defined(KVM_PROFILE_DIRECTORY_GET)
+#define KVM_ZONE_DIRECTORY_GET(name) DeviceZoneScopedN(name)
+#define KVM_ZONE_DIRECTORY_GET_IF(id, name, condition) KVM_ZONE_SCOPED_IF(id, name, condition)
+#else
+#define KVM_ZONE_DIRECTORY_GET(name)
+#define KVM_ZONE_DIRECTORY_GET_IF(id, name, condition)
+#endif
+
+#if defined(KVM_PROFILE_DIRECTORY_MOVE)
+#define KVM_ZONE_DIRECTORY_MOVE(name) DeviceZoneScopedN(name)
+#define KVM_ZONE_DIRECTORY_MOVE_IF(id, name, condition) KVM_ZONE_SCOPED_IF(id, name, condition)
+#else
+#define KVM_ZONE_DIRECTORY_MOVE(name)
+#define KVM_ZONE_DIRECTORY_MOVE_IF(id, name, condition)
+#endif
diff --git a/ttnn/cpp/ttnn/operations/kvcache_manager/common/kvm_fabric_route.hpp b/ttnn/cpp/ttnn/operations/kvcache_manager/common/kvm_fabric_route.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..f10314c73bd26a06d930f37dfd898c6c58c5f614
--- /dev/null
+++ b/ttnn/cpp/ttnn/operations/kvcache_manager/common/kvm_fabric_route.hpp
@@ -0,0 +1,61 @@
+// SPDX-FileCopyrightText: (c) 2026 Moreh
+//
+// SPDX-License-Identifier: Apache-2.0
+
+// kvcache_manager — fabric unicast route setup, single source for the 1D and 2D wires.
+//
+// route_word encoding (host side: fabric_helpers.hpp kvcache_unicast_route_word):
+//   1D: hop count to the peer (always kDirectNeighborHopCount — the wire is one hop).
+//   2D: (dst_mesh_id << 16) | dst_chip_id — the same packing as the HybridMeshPacketHeader
+//       dst_start_node_id field that fabric_set_unicast_route writes.
+// ROUTING_MODE is JIT-injected into every DataMovement kernel, so under FABRIC_1D this
+// expands to exactly the pre-port to_chip_unicast() call and includes no 2D code.
+//
+// Device-only: include after dataflow_api.h (FORCE_INLINE / tt_l1_ptr).
+#pragma once
+
+#include <cstdint>
+
+#include "tt_metal/fabric/fabric_edm_packet_header.hpp"  // PACKET_HEADER_TYPE + ROUTING_MODE_* masks
+#if defined(ROUTING_MODE) && ((ROUTING_MODE & ROUTING_MODE_2D) != 0)
+#include <type_traits>
+
+#include "tt_metal/fabric/hw/inc/tt_fabric_api.h"  // fabric_set_unicast_route (2D mesh overload)
+#endif
+
+#if defined(KVM_STATIC_INTERMESH_GALAXY_TO_T3K) && defined(KVM_STATIC_INTERMESH_T3K_TO_GALAXY)
+#error "KVM static inter-mesh route modes are mutually exclusive"
+#endif
+
+#if (defined(KVM_STATIC_INTERMESH_GALAXY_TO_T3K) || defined(KVM_STATIC_INTERMESH_T3K_TO_GALAXY)) && \
+    (!defined(ROUTING_MODE) || ((ROUTING_MODE & ROUTING_MODE_2D) == 0))
+#error "KVM static inter-mesh routing requires FABRIC_2D"
+#endif
+
+namespace ttnn::operations::kvcache_manager::protocol {
+
+#if defined(ROUTING_MODE) && ((ROUTING_MODE & ROUTING_MODE_2D) != 0)
+// The wire's fused-write/flush sequences assume the low-latency mesh header; UDM control
+// fields would ride uninitialized. Fail the JIT loudly instead of corrupting the wire.
+static_assert(
+    std::is_same_v<PACKET_HEADER_TYPE, tt::tt_fabric::HybridMeshPacketHeader>,
+    "kvcache wire under 2D requires low-latency mesh routing (HybridMeshPacketHeader); UDM is unsupported");
+#endif
+
+FORCE_INLINE void set_unicast_route(volatile tt_l1_ptr PACKET_HEADER_TYPE* hdr, uint32_t route_word) {
+#if defined(KVM_STATIC_INTERMESH_GALAXY_TO_T3K)
+    tt::tt_fabric::fabric_set_static_intermesh_tunnel_route(
+        hdr, static_cast<uint16_t>(route_word & 0xFFFFu), static_cast<uint16_t>(route_word >> 16));
+#elif defined(KVM_STATIC_INTERMESH_T3K_TO_GALAXY)
+    // The Client supplies a host-packed route in ESTABLISH. Before acceptance, the Server provides
+    // a provisional packed route so a rejection can still attempt a response.
+    tt::tt_fabric::fabric_set_static_intermesh_response_route_2d_galaxy(hdr, route_word);
+#elif defined(ROUTING_MODE) && ((ROUTING_MODE & ROUTING_MODE_2D) != 0)
+    tt::tt_fabric::fabric_set_unicast_route(
+        hdr, static_cast<uint16_t>(route_word & 0xFFFFu), static_cast<uint16_t>(route_word >> 16));
+#else
+    hdr->to_chip_unicast(static_cast<uint8_t>(route_word));
+#endif
+}
+
+}  // namespace ttnn::operations::kvcache_manager::protocol
diff --git a/ttnn/cpp/ttnn/operations/kvcache_manager/common/protocol/bootstrap.hpp b/ttnn/cpp/ttnn/operations/kvcache_manager/common/protocol/bootstrap.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..c40c5616b53a50c244714d8a3bc209b4c81b31b0
--- /dev/null
+++ b/ttnn/cpp/ttnn/operations/kvcache_manager/common/protocol/bootstrap.hpp
@@ -0,0 +1,175 @@
+// SPDX-FileCopyrightText: (c) 2026 Moreh
+//
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+#include "../server_descriptor.hpp"
+
+namespace ttnn::operations::kvcache_manager::protocol {
+
+inline constexpr uint32_t kBootstrapMagic = 0x4B564D41;  // "KVMA"
+inline constexpr uint32_t kBootstrapProtocolVersion = 4;
+inline constexpr uint32_t kBootstrapPeerSlots = 32;
+inline constexpr uint32_t kBootstrapWorkerNocX = 18;
+inline constexpr uint32_t kBootstrapWorkerNocY = 18;
+
+constexpr uint32_t bootstrap_worker_noc_x(uint32_t logical_x) { return kBootstrapWorkerNocX + logical_x; }
+
+constexpr uint32_t bootstrap_worker_noc_y(uint32_t logical_y) { return kBootstrapWorkerNocY + logical_y; }
+
+constexpr bool is_bootstrap_worker_noc(uint32_t logical_x, uint32_t logical_y, uint32_t noc_x, uint32_t noc_y) {
+    return noc_x == bootstrap_worker_noc_x(logical_x) && noc_y == bootstrap_worker_noc_y(logical_y);
+}
+
+constexpr bool is_bootstrap_worker_noc(uint32_t noc_x, uint32_t noc_y) {
+    return is_bootstrap_worker_noc(0, 0, noc_x, noc_y);
+}
+
+inline constexpr uint32_t kCapabilityFabricOperations = 1u << 0;
+inline constexpr uint32_t kCapabilityFabricGetCompletion = 1u << 1;
+inline constexpr uint32_t kCapabilityCommitBarrier = 1u << 2;
+inline constexpr uint32_t kCapabilityRemoveBackingReclaim = 1u << 3;
+inline constexpr uint32_t kCapabilitySessionGeneration = 1u << 4;
+inline constexpr uint32_t kCapabilityFusedExistsCommitPrefix = 1u << 5;
+inline constexpr uint32_t kRequiredCapabilities = kCapabilityFabricOperations | kCapabilityFabricGetCompletion |
+                                                  kCapabilityCommitBarrier | kCapabilityRemoveBackingReclaim |
+                                                  kCapabilitySessionGeneration | kCapabilityFusedExistsCommitPrefix;
+
+constexpr bool establish_capabilities_are_compatible(
+    uint32_t requested_capabilities, uint32_t offered_capabilities, uint32_t required_capabilities) {
+    return (requested_capabilities & offered_capabilities) == requested_capabilities &&
+           (requested_capabilities & required_capabilities) == required_capabilities;
+}
+
+enum class EstablishResponseStatus : uint32_t {
+    Accepted = 0,
+    BootstrapVersionMismatch = 1,
+    WireVersionMismatch = 2,
+    CapabilityMismatch = 3,
+    InvalidRequest = 4,
+    InvalidPeer = 5,
+    DramGeometryMismatch = 6,
+    PeerBusy = 7,
+};
+
+enum class EstablishClientStatus : uint32_t {
+    Pending = 0,
+    Responded = 1,
+    TimedOut = 2,
+};
+
+enum class ClientRegistryState : uint32_t {
+    Empty = 0,
+    Established = 1,
+    Retired = 2,
+};
+
+enum class EstablishRegistryAction : uint32_t {
+    Create = 0,
+    Replay = 1,
+    Drop = 2,
+};
+
+constexpr EstablishRegistryAction establish_registry_action(ClientRegistryState state, bool nonce_matches) {
+    if (state == ClientRegistryState::Empty) {
+        return EstablishRegistryAction::Create;
+    }
+    if (state == ClientRegistryState::Established) {
+        return nonce_matches ? EstablishRegistryAction::Replay : EstablishRegistryAction::Drop;
+    }
+    return nonce_matches ? EstablishRegistryAction::Drop : EstablishRegistryAction::Create;
+}
+
+struct alignas(16) EstablishRequest {
+    uint32_t magic;
+    uint32_t bootstrap_version;
+    uint32_t wire_layout_version;
+    uint32_t required_capabilities;
+    uint32_t client_mesh_id;
+    uint32_t client_chip_id;
+    uint32_t client_noc_x;
+    uint32_t client_noc_y;
+    uint32_t response_addr;
+    uint32_t response_sem_addr;
+    uint32_t nonce_low;
+    uint32_t nonce_high;
+    uint32_t client_l1_base;
+    uint32_t recv_buffer_addr;
+    uint32_t client_value_ring_depth;
+    // Static inter-mesh only: host-computed route from the Galaxy gateway back to this Client.
+    // Standard mode requires zero; static mode requires the versioned product route format below.
+    uint32_t return_route;
+    uint32_t num_dram_channels;
+    uint32_t dram_grid_x;
+    uint32_t dram_grid_y;
+    uint32_t reserved_tail;
+};
+static_assert(sizeof(EstablishRequest) == 80);
+
+// Static Galaxy return-route word shared by the product Client host runtime and the T3K device
+// kernel. The endpoint router consumes control-plane chip numbering.
+//   [4:0] dst chip  [20:5] dst mesh  [24:21] NS hops  [28:25] EW hops
+//   [29] NS direction (0=north, 1=south)  [30] EW direction (0=west, 1=east)
+//   [31] product route format
+inline constexpr uint32_t kReturnRouteValidBit = 1u << 31;
+
+constexpr uint32_t pack_return_route(
+    uint32_t dst_chip,
+    uint32_t dst_mesh,
+    uint32_t ns_hops,
+    uint32_t ew_hops,
+    uint32_t ns_direction,
+    uint32_t ew_direction) {
+    return (dst_chip & 0x1Fu) | ((dst_mesh & 0xFFFFu) << 5) | ((ns_hops & 0xFu) << 21) | ((ew_hops & 0xFu) << 25) |
+           ((ns_direction & 1u) << 29) | ((ew_direction & 1u) << 30) | kReturnRouteValidBit;
+}
+
+constexpr bool return_route_valid(uint32_t route) { return (route & kReturnRouteValidBit) != 0; }
+constexpr uint32_t return_route_dst_chip(uint32_t route) { return route & 0x1Fu; }
+constexpr uint32_t return_route_dst_mesh(uint32_t route) { return (route >> 5) & 0xFFFFu; }
+constexpr uint32_t return_route_ns_hops(uint32_t route) { return (route >> 21) & 0xFu; }
+constexpr uint32_t return_route_ew_hops(uint32_t route) { return (route >> 25) & 0xFu; }
+constexpr uint32_t return_route_ns_direction(uint32_t route) { return (route >> 29) & 1u; }
+constexpr uint32_t return_route_ew_direction(uint32_t route) { return (route >> 30) & 1u; }
+
+struct alignas(16) EstablishResponse {
+    uint32_t magic;
+    uint32_t bootstrap_version;
+    uint32_t status;
+    uint32_t capabilities;
+    uint32_t nonce_low;
+    uint32_t nonce_high;
+    uint32_t client_token;
+    uint32_t reserved;
+    ServerDescriptor descriptor;
+    uint32_t reserved_tail;
+};
+static_assert(offsetof(EstablishResponse, descriptor) == 32);
+static_assert(sizeof(EstablishResponse) == 96);
+
+// Its total size is a multiple of 32, preserving the operation ring's historical address phase
+// after the 16-byte termination cacheline.
+inline constexpr uint32_t kBootstrapRequestSlotStride = 128;
+inline constexpr uint32_t kBootstrapRequestBaseOffset = 16;
+inline constexpr uint32_t kBootstrapRequestTableSize = kBootstrapPeerSlots * kBootstrapRequestSlotStride;
+inline constexpr uint32_t kBootstrapRequestSemSize = 16;
+inline constexpr uint32_t kBootstrapRequestSemBaseOffset = kBootstrapRequestBaseOffset + kBootstrapRequestTableSize;
+inline constexpr uint32_t kBootstrapRequestSemTableSize = kBootstrapPeerSlots * kBootstrapRequestSemSize;
+inline constexpr uint32_t kBootstrapResponseTemplateOffset =
+    kBootstrapRequestSemBaseOffset + kBootstrapRequestSemTableSize;
+inline constexpr uint32_t kBootstrapResponseTemplateReserve = 128;
+inline constexpr uint32_t kBootstrapRegionEnd = kBootstrapResponseTemplateOffset + kBootstrapResponseTemplateReserve;
+
+constexpr uint32_t bootstrap_request_slot_offset(uint32_t client_chip_id) {
+    return kBootstrapRequestBaseOffset + client_chip_id * kBootstrapRequestSlotStride;
+}
+
+constexpr uint32_t bootstrap_request_sem_offset(uint32_t client_chip_id) {
+    return kBootstrapRequestSemBaseOffset + client_chip_id * kBootstrapRequestSemSize;
+}
+
+}  // namespace ttnn::operations::kvcache_manager::protocol
diff --git a/ttnn/cpp/ttnn/operations/kvcache_manager/common/protocol/layout.hpp b/ttnn/cpp/ttnn/operations/kvcache_manager/common/protocol/layout.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..6c397a3b27129f090a3ac94615e6af4f4c71bb84
--- /dev/null
+++ b/ttnn/cpp/ttnn/operations/kvcache_manager/common/protocol/layout.hpp
@@ -0,0 +1,756 @@
+// SPDX-FileCopyrightText: (c) 2026 Moreh
+//
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include <cstdint>
+
+#include "bootstrap.hpp"
+#include "packet.hpp"
+
+namespace ttnn::operations::kvcache_manager::protocol {
+
+// Wire ABI version. Bump on ANY change to the L1 layouts, opcodes, or packet framing below --
+// a remote ESTABLISH compares the two binaries' values and refuses a mismatch, because a
+// layout disagreement does not fail loudly on the wire; it reads garbage.
+// v2: the Wire 8A merge (t3k-nic-kvcache-server) reworked the packet framing and server L1
+// layout (mapped-GET machinery, admission/ingress workers), so binaries across that boundary
+// must not establish a session with each other.
+inline constexpr uint32_t kWireLayoutVersion = 4;
+
+// All offsets are relative to the per-side L1 carve-out reserved by Server / Client at
+// construction. Each kernel receives BOTH bases via RT args (own_l1_base + peer_l1_base): use
+// own_base for its own L1 access, peer_base for cross-chip writes — never mix the two.
+// See ttnn/cpp/ttnn/operations/kvcache_manager/docs/design.md §2 (topology), §4 (layout).
+
+// Cumulative uint32 channels are ordered only within a half-range window. All kvcache channels
+// have at most a handful of outstanding events, so this handles wrap while rejecting stale values.
+constexpr bool cumulative_counter_is_ahead(uint32_t candidate, uint32_t baseline) {
+    const uint32_t delta = candidate - baseline;
+    return delta != 0 && delta < (1u << 31);
+}
+
+// ---- Common to both chips ----
+constexpr uint32_t kTerminationOffset = 0;
+constexpr uint32_t kTerminationSize = 16;
+
+// ---- Server side (server submesh L1 reserve) ----
+
+// How many Clients one Server can hold established at once. Each owns a registry entry, a slice of the
+// request ring, and a PUT completion counter. Raising it costs pipeline depth per client, not L1 —
+// the ring is split, not multiplied (README §2, §4).
+//
+// 16 leaves headroom above the widest model mesh in use (qwen3 2x4 = 8 chips), where per-chip PUT
+// gives every model chip its own session. The headroom is not slack: a failed establishment is
+// QUARANTINED rather than freed -- its outcome is unknown and its device resources are held until a
+// reset -- so at exactly 8 entries a single quarantine would make per-chip PUT unusable for the rest
+// of the process. Entries are cheap (one registry slot and a ring partition each); a mode that stops
+// working after one transient failure is not.
+//
+// 32 covers the intended inter-node topology: one Server serving every stage-local client of a
+// 32-chip 8PP x 4TP model. kRingNumSlots must divide by this, and with the default ring of 64
+// each client's partition is exactly the 2-slot minimum -- fine, because a Client is sequential
+// by contract, so its partition holds a pipeline, not a backlog. A deployment that wants deeper
+// per-client pipelines raises KVM_SERVER_L1_RING_SLOTS instead (README §11).
+//
+// The cost is that the smallest legal ring scales with it: every partition needs two slots, so
+// KVM_SERVER_L1_RING_SLOTS must be at least 2 * kMaxClients = 64 (exactly the default); a
+// deployment that had tuned the ring below that is refused at construction.
+constexpr uint32_t kMaxClients = 32;
+static_assert(kMaxClients >= 1, "a Server must be able to hold at least one Client");
+static_assert(kMaxClients == kBootstrapPeerSlots, "bootstrap slots and registry entries must have one chip mapping");
+
+constexpr uint32_t kClientIdBits = 5;
+constexpr uint32_t kClientIdMask = (1u << kClientIdBits) - 1;
+constexpr uint32_t kClientGenerationMask = (1u << (32 - kClientIdBits)) - 1;
+static_assert(kMaxClients == kClientIdMask + 1, "the token's client-id field must cover every registry entry");
+
+constexpr uint32_t make_client_token(uint32_t client_id, uint32_t generation) {
+    return ((generation & kClientGenerationMask) << kClientIdBits) | (client_id & kClientIdMask);
+}
+
+constexpr uint32_t client_id_from_token(uint32_t token) { return token & kClientIdMask; }
+
+constexpr uint32_t client_generation_from_token(uint32_t token) { return token >> kClientIdBits; }
+
+constexpr uint32_t next_client_generation(uint32_t generation) {
+    const uint32_t next = (generation + 1) & kClientGenerationMask;
+    return next == 0 ? 1 : next;
+}
+
+// In-flight packet pipeline depth. Generic `% kRingNumSlots` everywhere, so it need not be a
+// power of two. Env-tunable (KVM_SERVER_L1_RING_SLOTS): the host injects the resolved value as
+// the KVM_RING_NUM_SLOTS kernel #define, which this constexpr picks up at JIT. Hosts MUST use
+// the runtime member ring_slots_ instead — this constexpr reflects only the default in a host
+// TU. See "Configuration" in ttnn/cpp/ttnn/operations/kvcache_manager/docs/development.md.
+constexpr uint32_t kRingNumSlotsDefault = 64;
+#ifndef KVM_RING_NUM_SLOTS
+#define KVM_RING_NUM_SLOTS 64  // keep literally in sync with kRingNumSlotsDefault
+#endif
+constexpr uint32_t kRingNumSlots = KVM_RING_NUM_SLOTS;
+static_assert(kRingNumSlots >= 2, "kRingNumSlots must be >= 2 (GET double-buffer staging)");
+static_assert((kRingNumSlots % 2) == 0, "kRingNumSlots must be even to keep kPutPipelineBaseOffset 32-phase");
+
+// Fused write+atomic_inc flush toggle. NOT CONSUMED TODAY: every fused send in the wire passes
+// flush=true, either explicitly or through NocUnicastAtomicIncFusedCommandHeader's default, so
+// setting KVM_COMMON_FUSED_FLUSH changes nothing. It is kept as the seam for reintroducing
+// flush=false on the sends whose payload and semaphore land on the same core via one same-VC
+// packet (fabric PR #19877) — that relaxation is what needs re-proving per multi-hop / multi-link /
+// cross-core / >MTU config, not the safe flush=true default. See README §11.
+#ifndef KVM_COMMON_FUSED_FLUSH
+#define KVM_COMMON_FUSED_FLUSH 0
+#endif
+constexpr bool kFusedFlush = (KVM_COMMON_FUSED_FLUSH != 0);
+
+// Request-ring partition. Client c produces only into [c * kRingSlotsPerClient, ...+ that many),
+// and the server keeps one cursor per client. A single shared cursor cannot serve several
+// producers: two Clients would pick the same slot and overwrite each other, and a server spinning
+// on one slot would never reach a request another Client had already left elsewhere in the ring —
+// one quiet Client would stall every other one.
+static_assert(kRingNumSlots % kMaxClients == 0, "the request ring must divide evenly among clients");
+constexpr uint32_t kRingSlotsPerClient = kRingNumSlots / kMaxClients;
+static_assert(kRingSlotsPerClient >= 2, "each client needs at least two ring slots to pipeline");
+constexpr uint32_t ring_base_slot(uint32_t client_id) { return client_id * kRingSlotsPerClient; }
+
+constexpr uint32_t kRingSlotStride = kFabricMaxPayloadBytes;  // 4352
+constexpr uint32_t kRingBaseOffset = kBootstrapRegionEnd;
+static_assert(kRingBaseOffset % 32 == 16, "bootstrap prefix must preserve the operation-ring address phase");
+// slot[i] = base + kRingBaseOffset + i * kRingSlotStride
+constexpr uint32_t kRingSemSize = 16;
+constexpr uint32_t kRingSemBaseOffset = kRingBaseOffset + kRingNumSlots * kRingSlotStride;
+
+// GET value handoff CB (BRISC directory reader -> NCRISC server sender): tt-metal CB flow control
+// (cb_reserve_back/push on BRISC, cb_wait_front/pop on NCRISC), on-core, no per-chunk cross-core
+// NoC atomics. One page = one value chunk (U = kMaxChunkValueBytes). Allocated by
+// CreateCircularBuffer in launch_server_kernel (separate L1 from the manual carve-out).
+// See ttnn/cpp/ttnn/operations/kvcache_manager/docs/design.md §4, §6 GET.
+constexpr uint32_t kGetValueCbId = 0;
+constexpr uint32_t kGetValueCbDepth =
+    16;  // D: two 8-chunk batches; sized to coexist with static-fabric L1 reservations
+// B: value-chunk DRAM reads the BRISC issues per CB batch. The B reads overlap (distinct
+// interleaved banks, one barrier), hiding read latency without a per-chunk barrier or trids.
+constexpr uint32_t kGetValueCbReadBatch = 8;  // B
+constexpr uint32_t kMovePullBatch = 8;        // host-read batches use the CB as two halves
+constexpr uint32_t kMovePushBatch = 8;        // write-through gathers use the same double-buffer layout
+// Each flushed progress event lets the server copy one complete nonterminal group while the client
+// sends the next. The landed event fences the final group.
+constexpr uint32_t kPutStreamProgressChunks = 256;
+// Small values use only the landed fence because progress events do not amortize their cost.
+constexpr uint32_t kPutStreamMinBytes = 2u << 20;
+static_assert(kGetValueCbReadBatch >= 1, "B >= 1");
+static_assert(kGetValueCbReadBatch == 8, "GET admission handoff uses one 8-chunk batch");
+static_assert(2u * kGetValueCbReadBatch <= kGetValueCbDepth, "D >= 2*B (double-buffer batches for overlap)");
+static_assert(2u * kMovePullBatch <= kGetValueCbDepth, "D >= 2*move-pull batch");
+static_assert(2u * kMovePushBatch <= kGetValueCbDepth, "D >= 2*move-push batch");
+static_assert(kPutStreamProgressChunks % kMovePushBatch == 0, "PUT progress must align to push batches");
+// D must be a whole number of batches (the reader pushes exactly B per batch, padded) so a batch
+// push never straddles the ring wrap ("producer cannot wrap").
+static_assert(kGetValueCbDepth % kGetValueCbReadBatch == 0, "D % B == 0 (wrap lands on a batch boundary)");
+
+// Client registry (server submesh L1 reserve). One 64 B entry per physical peer chip. Words 0..9
+// hold the established Client route, return route, and nonce; word 10 is the full client token, word 11 is
+// ClientRegistryState, and words 12..14 preserve the bootstrap response destinations and proposed
+// value-ring depth for exact same-nonce retry matching. A request selects its entry through the low token bits; the
+// full token must match before the request may use the response destination in this entry.
+constexpr uint32_t kRegistryEntrySize = 64;
+constexpr uint32_t kRegistryReturnRouteWord = 7;
+constexpr uint32_t kRegistryClientTokenWord = 10;
+constexpr uint32_t kRegistryStateWord = 11;
+constexpr uint32_t kRegistryResponseAddrWord = 12;
+constexpr uint32_t kRegistryResponseSemAddrWord = 13;
+constexpr uint32_t kRegistryClientValueRingDepthWord = 14;
+
+// Fixed host-to-kernel transport arguments before any Fabric connection
+// arguments. Keep this shared so adding a session field cannot silently shift
+// the Fabric adapter's runtime-argument stream.
+constexpr uint32_t kServerTransportFixedRtArgs = 20;
+constexpr uint32_t kRegistryTableSize = kRegistryEntrySize * kMaxClients;
+constexpr uint32_t kRegistryOffset = kRingSemBaseOffset + kRingNumSlots * kRingSemSize;
+constexpr uint32_t registry_entry_offset(uint32_t client_id) {
+    return kRegistryOffset + client_id * kRegistryEntrySize;
+}
+
+// Peer lookup table (server submesh L1 reserve). Maps peer chip_id (FabricNodeId.chip_id, sparse
+// index) → (conn_idx, route_word). Capacity 32 covers T3K (8) and Galaxy (32).
+//   word[0] = conn_idx (kPeerLookupEmptySentinel when empty), word[1] = route_word — dual-encoded:
+//   1D hop count / 2D (mesh_id<<16)|chip_id (fabric_helpers.hpp kvcache_unicast_route_word).
+// Fabric connections the server kernel holds open: one per unique first-hop eth direction, so four
+// directions plus the idle-mode slot bound it regardless of how many peers sit behind each one.
+constexpr uint32_t kMaxServerConnections = 5;
+constexpr uint32_t kPeerLookupTableMaxEntries = 32;
+static_assert(kPeerLookupTableMaxEntries == kBootstrapPeerSlots);
+constexpr uint32_t kPeerLookupEntrySize = 8;                                                  // 2 × uint32
+constexpr uint32_t kPeerLookupTableSize = kPeerLookupTableMaxEntries * kPeerLookupEntrySize;  // 256
+constexpr uint32_t kPeerLookupTableOffset = kRegistryOffset + kRegistryTableSize;
+constexpr uint32_t kPeerLookupEmptySentinel = 0xFFFFFFFFu;
+
+// Scalar GET reverse-ACK accumulator (status_flags + 1 per completed request).
+constexpr uint32_t kHostAnyGetDoneMonitorSize = 16;
+constexpr uint32_t kHostAnyGetDoneMonitorOffset = kPeerLookupTableOffset + kPeerLookupTableSize;
+static_assert(kHostAnyGetDoneMonitorSize >= sizeof(uint32_t), "GET completion monitor must hold a uint32");
+
+// ---- PUT completion region (server submesh L1 reserve) ----
+// The direct cacheline holds two cumulative counters: word 0 is one landed fence per PUT and word 1
+// is large-PUT streaming progress. BRISC publishes directory state before NCRISC acknowledges
+// landing, then advances commit_done after host write-through.
+constexpr uint32_t kPutDirectDoneSemSize = 16;
+static_assert(kPutDirectDoneSemSize >= 2 * sizeof(uint32_t), "direct completion needs landed and progress words");
+// One landed-fence cacheline per established Client -- a PUT's landed fence must count only that
+// Client's completions -- followed by ONE shared large-PUT stream progress cacheline. Progress is
+// consumed by the BRISC from a single address and PUTs are serialized through the NCRISC dispatch
+// loop, so one cumulative sequence is unambiguous; see PutSessionConfig::progress_l1_addr.
+constexpr uint32_t kPutDirectDoneRegionRaw = kPutDirectDoneSemSize * (kMaxClients + 1);
+// The read-back scratch that follows must sit at a 32-byte absolute address -- a DRAM NoC read
+// rounds its destination DOWN to 32 B, so a misaligned scratch silently reads the wrong bytes.
+// kPutPipelineBaseOffset is pinned at phase 16, so this region has to end on a 32-byte boundary,
+// i.e. itself be == 16 (mod 32). One counter already is; an even count needs 16 B of padding.
+constexpr uint32_t kPutDirectDoneRegionBytes =
+    ((kPutDirectDoneRegionRaw % 32) == 16) ? kPutDirectDoneRegionRaw : kPutDirectDoneRegionRaw + 16;
+constexpr uint32_t put_direct_done_offset(uint32_t region_base, uint32_t client_id) {
+    return region_base + client_id * kPutDirectDoneSemSize;
+}
+constexpr uint32_t put_stream_progress_offset(uint32_t region_base) {
+    return region_base + kMaxClients * kPutDirectDoneSemSize;
+}
+
+// Directory entry count (max_keys) is the catalog membership limit. The server prefers a free
+// slot and otherwise replaces the global catalog-LRU entry. DRAM-resident storage scales
+// independently of L1 and device-cache bytes. Tunable via KVM_SERVER_DRAM_MAX_KEYS; see
+// ttnn/cpp/ttnn/operations/kvcache_manager/docs/design.md §4 and
+// "Configuration" in ttnn/cpp/ttnn/operations/kvcache_manager/docs/development.md.
+constexpr uint32_t kMaxKeysDefault = 1024;
+constexpr uint32_t kMaxKeysHardCap = 65536;  // sanity bound; the runtime DRAM budget is the real limit
+
+// Value heap total bytes (sub-page packing): num_units pages of U = kMaxChunkValueBytes; a value
+// occupies ceil(len/U) contiguous units at a U-aligned offset. Tunable via
+// KVM_SERVER_DRAM_VALUE_HEAP_BYTES. See ttnn/cpp/ttnn/operations/kvcache_manager/docs/design.md §5.
+constexpr uint32_t kValueHeapBytesDefault = 1'434'541'824u;  // 1.336 GiB
+
+// Pending host-write queue. The directory entry is the commit descriptor; FIFO entries only name
+// that entry and the pending token stored temporarily in directory.host_generation. Capacity is
+// max_keys because pending directory entries are pinned against replacement.
+constexpr uint32_t kPutHostQueueEntryBytes = 32;
+constexpr uint32_t kPutHostQueueDirSlotWord = 0;
+constexpr uint32_t kPutHostQueueTokenWord = 1;
+
+// Device read-back scratch (server kernel only): PUT finalization reads 32 B from the value DRAM
+// page here before directory publication, fencing this RISC's direct-write pipeline
+// (same-requestor Write->Read). Its absolute L1 address must be 32-aligned to phase-match the
+// phase-0 DRAM source. The direct-done counter immediately before it supplies the required 16-byte
+// phase correction; commit_done follows the scratch.
+constexpr uint32_t kPutReadbackScratchSize = 32;
+
+// GET admission progress cache line. Word 0 advances per source-safe CB batch; word 1 advances once
+// per request after every cache write reaches server DRAM. Both are cumulative.
+constexpr uint32_t kGetCreditSemSize = 16;
+constexpr uint32_t kGetCreditSemOffset = kHostAnyGetDoneMonitorOffset + kHostAnyGetDoneMonitorSize;
+constexpr uint32_t kGetAdmissionSourceDoneWord = 0;
+constexpr uint32_t kGetAdmissionWriteDoneWord = 1;
+
+constexpr uint32_t kPutPipelineBaseOffset = kGetCreditSemOffset + kGetCreditSemSize;
+
+// Pin the PUT region base phase so a prefix-size change that breaks the read-back scratch's
+// 32-alignment derivation fails loudly at compile time instead of hanging under
+// DebugSanitizeNocAlignment. See ttnn/cpp/ttnn/operations/kvcache_manager/docs/design.md §4.
+static_assert(
+    (kPutPipelineBaseOffset % 32) == 16,
+    "kPutPipelineBaseOffset must be == 16 (mod 32); the direct-done region then lifts the "
+    "read-back scratch offset to phase 0, so with l1_unreserved_base % 32 == 0 the scratch absolute "
+    "address is 32-aligned (DRAM-NoC read dst phase-match); see docs/design.md §4");
+static_assert(
+    ((kPutPipelineBaseOffset + kPutDirectDoneRegionBytes) % 32) == 0,
+    "the read-back scratch must land 32-aligned; kPutDirectDoneRegionBytes pads the per-client "
+    "counters to keep that phase whatever kMaxClients is");
+
+// ---- Device DRAM key directory (server DRAM, GET/EXISTS lookup authority) ----
+// DRAM INTERLEAVED buffer of max_keys entries. The directory is the catalog authority; device
+// residency is a write-through cache of the host backing store.
+// Entry layout:
+//   +0   valid                 (uint32)  0 = empty, 1 = live
+//   +4   key_len               (uint32)  1..max_key_len
+//   +8   total_value_len       (uint32)  1..max_value_bytes
+//   +12  last_access           (uint32)  BRISC monotonic access epoch
+//   +16  device_value_byte_off (uint32)  valid while location == kLocationDevice
+//   +20  host_generation       (uint32)  mapped-pool generation, or pending token while host-pending
+//   +24  location              (uint32)  device / host-only / device-pending-host
+//   +28  buddy_order           (uint32)  device allocation order
+//   +32  key[max_key_len]
+//   ...  pad to a 32-byte aligned entry size
+// The first 32-byte header is updated independently from the key region.
+constexpr uint32_t kDirEntryHeaderBytes = 32;
+
+constexpr uint32_t kLocationDevice = 0;
+constexpr uint32_t kLocationHost = 1;
+constexpr uint32_t kLocationDevicePendingHost = 2;
+constexpr uint32_t kEntryDeviceValueByteOffset = 16;
+constexpr uint32_t kEntryLocationByteOffset = 24;
+
+// Default / cap for max_key_len; matches the wire key field (kMaxPutKeyBytes), which bounds how many
+// key bytes the PUT/GET chunk-0 wire can carry.
+constexpr uint32_t kMaxKeyBytesDefault = kMaxPutKeyBytes;
+
+// Directory entry byte size for a given max_key_len, 32-rounded so each entry's DRAM page stays
+// NoC-aligned.
+constexpr uint32_t dir_entry_bytes(uint32_t max_key_len) { return ((kDirEntryHeaderBytes + max_key_len) + 31u) & ~31u; }
+
+// Number of directory entries the BRISC scan reads per batch into L1 staging.
+constexpr uint32_t kDirScanBatch = 16;
+
+// L1 directory batch staging for catalog-LRU selection, device-cache LRU selection, and cold start.
+// Entries are cap-sized so the carve-out is independent of the runtime max_key_len.
+constexpr uint32_t kDirScanStagingSize = kDirScanBatch * dir_entry_bytes(kMaxKeyBytesDefault);
+
+// ---- Auxiliary DRAM hash index (key_hash -> dir_slot; O(1) lookup accelerator) ----
+// All key-to-slot lookups revalidate the indexed directory entry; free/LRU selection remains
+// directory-owned. See ttnn/cpp/ttnn/operations/kvcache_manager/docs/design.md §4.
+constexpr uint32_t kBucketDirSlotEmpty = 0xFFFFFFFFu;      // lookup stops here (miss)
+constexpr uint32_t kBucketDirSlotTombstone = 0xFFFFFFFEu;  // deleted; probe continues past it
+constexpr uint32_t kBucketKeyHashWord = 0;                 // uint32 FNV-1a of the key
+constexpr uint32_t kBucketDirSlotWord = 1;                 // uint32 directory slot, or a sentinel above
+// One bucket per INTERLEAVED DRAM page, 32-rounded so each page stays NoC-aligned (8 B used of 32).
+constexpr uint32_t kHashBucketBytes = 32;
+
+constexpr uint32_t next_pow2(uint32_t x) {
+    uint32_t p = 1;
+    while (p < x) {
+        p <<= 1;
+    }
+    return p;
+}
+// Bucket count for a given max_keys: load factor <= 0.5 keeps linear-probe chains short.
+constexpr uint32_t hash_num_buckets(uint32_t max_keys) { return next_pow2(max_keys ? max_keys * 2u : 2u); }
+
+// L1 staging for one probed bucket (BRISC NoC-read destination); probes read a bucket at a time.
+constexpr uint32_t kHashProbeStagingSize = kHashBucketBytes;
+
+// ---- Buddy heap metadata (one entry per value-heap unit) ----
+// Allocated block starts store their directory slot in state. Free block starts form intrusive
+// doubly-linked lists by order. Continuation units need no authoritative metadata.
+constexpr uint32_t kHeapFreeListNone = 0xFFFFFFFFu;
+constexpr uint32_t kHeapBlockFree = 0xFFFFFFFEu;
+constexpr uint32_t kHeapBlockContinuation = 0xFFFFFFFDu;
+constexpr uint32_t kHeapBlockPutLease = 0xFFFFFFFCu;
+constexpr uint32_t kHeapBlockStateWord = 0;
+constexpr uint32_t kHeapBlockOrderWord = 1;
+constexpr uint32_t kHeapBlockNextWord = 2;
+constexpr uint32_t kHeapBlockPrevWord = 3;
+constexpr uint32_t kHeapMetadataEntryBytes = kHashBucketBytes;
+constexpr uint32_t kHeapMetadataStagingSize = 2 * kHeapMetadataEntryBytes;
+
+// Cold-start handshake word (reserve end): the BRISC sets it to 1 once its cold-start directory /
+// hashmap / heap metadata zero has drained, and the NCRISC waits on it before serving so no client op
+// races the still-running cold-start (a first PUT arriving mid-cold-start loses its commit). Host
+// zero-init'd at launch — close() does not zero L1, so a prior Server's 1 would otherwise let the
+// NCRISC skip the wait. 16 B for NoC-unit alignment (only the first uint32 is used). See
+// ttnn/cpp/ttnn/operations/kvcache_manager/docs/design.md §6.
+constexpr uint32_t kColdStartDoneSize = 16;
+
+// Optional BRISC allocator-pressure counters. The block is always reserved and host-zeroed so the
+// public snapshot API has a stable layout; KVM_SERVER_ALLOCATOR_PROFILE controls whether the device
+// kernel emits counter/timestamp updates. All counters are cumulative for one Server lifetime.
+constexpr uint32_t kAllocatorProfileAllocationCallsWord = 0;
+constexpr uint32_t kAllocatorProfileAllocationSuccessesWord = 1;
+constexpr uint32_t kAllocatorProfileAllocationFailuresWord = 2;
+constexpr uint32_t kAllocatorProfileVictimScansWord = 3;
+constexpr uint32_t kAllocatorProfileVictimsEvictedWord = 4;
+constexpr uint32_t kAllocatorProfileLeaseCallsWord = 5;
+constexpr uint32_t kAllocatorProfileLeaseSuccessesWord = 6;
+constexpr uint32_t kAllocatorProfileLeaseFailuresWord = 7;
+constexpr uint32_t kAllocatorProfileLeaseVictimScansWord = 8;
+constexpr uint32_t kAllocatorProfileLeaseVictimsEvictedWord = 9;
+constexpr uint32_t kAllocatorProfileScanCyclesLowWord = 10;
+constexpr uint32_t kAllocatorProfileScanCyclesHighWord = 11;
+constexpr uint32_t kAllocatorProfileLeaseScanCyclesLowWord = 12;
+constexpr uint32_t kAllocatorProfileLeaseScanCyclesHighWord = 13;
+constexpr uint32_t kAllocatorProfileAllocationCyclesLowWord = 14;
+constexpr uint32_t kAllocatorProfileAllocationCyclesHighWord = 15;
+constexpr uint32_t kAllocatorProfileWords = 16;
+constexpr uint32_t kAllocatorProfileSize = kAllocatorProfileWords * sizeof(uint32_t);
+static_assert(kAllocatorProfileSize == 64, "allocator profile block must occupy one cache line");
+
+// NCRISC -> BRISC request mailbox: the operation, key, and direct-PUT auxiliary fields.
+//   +0   op, +4 key_len, +8 output_capacity_bytes
+//   +12  aux0 (PUT lease value offset)
+//   +16  aux1 (PUT lease buddy order)
+//   +20  aux2 (PUT lease valid)
+//   +24  aux3 (PUT pending token), +28 reserved
+//   +32  key[kMaxKeyBytesDefault]
+constexpr uint32_t kDirReqMailboxHeaderBytes = 32;
+constexpr uint32_t kDirReqMailboxSize = ((kDirReqMailboxHeaderBytes + kMaxKeyBytesDefault) + 31u) & ~31u;
+
+// Internal mailbox-only op; never emitted on Fabric.
+constexpr uint32_t kDirOpPutBindLease = 0x80000001u;
+constexpr uint32_t kDirOpPutPublish = 0x80000002u;
+
+// BRISC -> NCRISC response mailbox. Words 0..3 carry status, value length, chunk count, and value
+// offset. PUT prepare uses words 4..6 for the next lease; GET uses words 5..6 for its fill handshake.
+constexpr uint32_t kDirRespMailboxSize = 32;
+// Internal GET lookup flag and owner-separated cross-RISC synchronization words. The NCRISC masks
+// the flag before publishing client-visible wire status. Only NCRISC writes consumer_done; only
+// BRISC writes result, avoiding a lost update when stream completion races termination.
+constexpr uint32_t kDirGetStatusDeviceFillPending = 1u << 2;
+constexpr uint32_t kDirRespGetConsumerDoneWord = 5;
+constexpr uint32_t kDirRespGetResultWord = 6;
+constexpr uint32_t kDirRespGetResultPending = 0;
+constexpr uint32_t kDirRespGetResultCommitted = 1;
+constexpr uint32_t kDirRespGetResultAborted = 2;
+
+// Cross-RISC handoff sems (cumulative, never reset post-launch; each side keeps a local expected
+// count). dir_req_sem: NCRISC inc, BRISC waits. dir_done_sem: BRISC inc, NCRISC waits. Both 16 B
+// (NoC unit). The BRISC-private directory state holds the monotonic access epoch plus O(1) catalog
+// free-slot allocation state.
+constexpr uint32_t kDirReqSemSize = 16;
+constexpr uint32_t kDirDoneSemSize = 16;
+constexpr uint32_t kDirEpochCounterSize = 16;
+constexpr uint32_t kDirEpochCounterWord = 0;
+constexpr uint32_t kDirNextUnusedSlotWord = 1;
+constexpr uint32_t kDirFreeSlotHeadWord = 2;
+constexpr uint32_t kDirReservedSlotWord = 3;
+
+// BRISC staging for directory publish, pending-host FIFO reads, and the final host-generation
+// header patch. It is distinct from the shared LRU scan staging.
+constexpr uint32_t kDirCommitEntryStagingSize = dir_entry_bytes(kMaxKeyBytesDefault);  // 160
+static_assert((kDirCommitEntryStagingSize % 32) == 0, "directory commit-entry staging must be 32-aligned");
+
+// Device-owned PUT frontier. The NCRISC advances issued after directory publication and before
+// reporting landed; the BRISC advances committed after host write-through. Both counters start at
+// the same baseline and use half-range cumulative ordering across uint32 wrap.
+constexpr uint32_t kPutCommitIssuedSemSize = 16;
+constexpr uint32_t kPutCommitDoneSemSize = 16;
+constexpr uint32_t kPutCommitCounterRegionSize = kPutCommitIssuedSemSize + kPutCommitDoneSemSize;
+
+// BRISC-owned buddy allocator state. Word 0 is max_order, words 1..3 hold the residency-LRU
+// head/tail/count, and words [4,36) are free-list heads indexed by order. Block metadata lives in
+// the per-heap-unit DRAM map.
+constexpr uint32_t kHeapAllocatorMaxOrders = 32;
+constexpr uint32_t kHeapAllocatorHeaderWords = 4;
+constexpr uint32_t kHeapAllocatorStateSize = (kHeapAllocatorHeaderWords + kHeapAllocatorMaxOrders) * sizeof(uint32_t);
+constexpr uint32_t kHeapAllocatorMaxOrderWord = 0;
+constexpr uint32_t kResidencyLruHeadWord = 1;
+constexpr uint32_t kResidencyLruTailWord = 2;
+constexpr uint32_t kResidencyLruCountWord = 3;
+constexpr uint32_t kHeapFreeHeadBaseWord = kHeapAllocatorHeaderWords;
+
+// Exact BRISC-private LRU links for device-resident and device-pending-host directory slots.
+// Head is MRU and tail is LRU. In each node prev points toward MRU and next toward LRU. An invalid,
+// recycled catalog slot aliases the node as {kCatalogFreeQueued, next_free} until it is claimed.
+constexpr uint32_t kResidencyLruPrevWord = 0;
+constexpr uint32_t kResidencyLruNextWord = 1;
+constexpr uint32_t kResidencyLruLinkWords = 2;
+constexpr uint32_t kResidencyLruLinkBytes = kResidencyLruLinkWords * sizeof(uint32_t);
+constexpr uint32_t kResidencyLruNone = 0xFFFFFFFFu;
+constexpr uint32_t kCatalogFreeQueued = 0xFFFFFFFEu;
+constexpr uint64_t residency_lru_l1_bytes(uint64_t max_keys) {
+    return ((max_keys * kResidencyLruLinkBytes) + 31u) & ~uint64_t{31};
+}
+static_assert(kMaxKeysHardCap < kResidencyLruNone, "residency LRU sentinel must exceed every directory slot");
+static_assert(kMaxKeysHardCap < kCatalogFreeQueued, "catalog free marker must exceed every directory slot");
+
+// Host-side write-through, explicit cache-admission, and host-serve channels. They live at
+// the end of the server L1 reserve, after allocator state.
+//   move_req (BRISC -> worker):
+//     op=1 WRITE_THROUGH publishes the final device value location. With mapped-host transfer,
+//     the worker returns a destination for a device push; the fallback reads the device value.
+//     op=2 DEVICE_PROMOTE requests explicit move_to_device cache admission.
+//     op=3 REMOVE_BACKING reclaims the host copy for a removed directory slot.
+//     op=4 HOST_SERVE streams a host-only GET and admits it into device DRAM.
+//   commit_req (worker -> BRISC): carries the source and staging state for DEVICE_PROMOTE or
+//     HOST_SERVE. Without a usable mapping, the worker uses targeted host copies.
+constexpr uint32_t kMoveReqSemSize = 16;
+constexpr uint32_t kMoveReqHeaderBytes = 20;  // op, slot, value_byte_off, total_len, key_len
+constexpr uint32_t kMoveReqSlotBytes = (kMoveReqHeaderBytes + kMaxKeyBytesDefault + 31u) & ~31u;
+constexpr uint32_t kCommitReqSemSize = 16;
+constexpr uint32_t kCommitReqHeaderBytes = 16;  // slot, value_byte_off, total_len, key_len
+// Byte offset of this host-source operation stage read offset. Zero selects the staging window;
+// non-zero selects an in-place offset in the NoC-mapped host region.
+constexpr uint32_t kCommitReqStageReadOffByteOffset = kCommitReqHeaderBytes + kMaxKeyBytesDefault;
+constexpr uint32_t kCommitReqStageReadOffWord = kCommitReqStageReadOffByteOffset / 4;
+constexpr uint32_t kCommitReqSlotBytes = (kCommitReqStageReadOffByteOffset + 4u + 31u) & ~31u;
+static_assert(kCommitReqStageReadOffByteOffset % 4 == 0, "commit_req stage read offset must be word-aligned");
+static_assert(
+    kCommitReqStageReadOffByteOffset + 4u <= kCommitReqSlotBytes, "commit_req slot must hold the stage read offset");
+// move_processed (worker -> BRISC): cumulative count of completed move_req operations. The
+// single-slot channel is reusable only when move_req_sem == move_processed.
+constexpr uint32_t kMoveProcessedSemSize = 16;
+// During mapped HOST_SERVE staging, stage_progress publishes how many chunks are ready.
+// Pool-resident values publish the full count immediately. Explicit cache admission stages the
+// complete source before posting commit_req.
+constexpr uint32_t kStageProgressSize = 16;
+// Source-consumed completion for explicit cache admission and HOST_SERVE.
+constexpr uint32_t kPromoteDoneSemSize = 16;
+// Mapped host-source completion is also published in a dedicated cache line.
+constexpr uint32_t kPromoteHostCompletionBytes = 64;
+// Scalar GET uses a separate cache line so completion polling cannot alias host-source promotion.
+constexpr uint32_t kGetHostCompletionBytes = kPromoteHostCompletionBytes;
+// Two host descriptors alternate so a generation can be published without reusing the preceding
+// slot. The API is synchronous, so the worker has consumed slot N before the host reuses it at N+2.
+constexpr uint32_t kGetIngressDescriptorSlots = 2;
+constexpr uint32_t kGetIngressHostBytes = kGetIngressDescriptorSlots * sizeof(GetIngressDescriptor);
+// Private L1 on the Fabric-free ingress core: termination, cumulative doorbell, descriptor scratch.
+constexpr uint32_t kGetIngressTerminationOffset = 0;
+constexpr uint32_t kGetIngressTerminationSize = 16;
+constexpr uint32_t kGetIngressDoorbellOffset = kGetIngressTerminationOffset + kGetIngressTerminationSize;
+constexpr uint32_t kGetIngressDoorbellSize = 16;
+constexpr uint32_t kGetIngressScratchOffset = kGetIngressDoorbellOffset + kGetIngressDoorbellSize;
+constexpr uint32_t kGetIngressL1Bytes = kGetIngressScratchOffset + sizeof(GetIngressDescriptor);
+static_assert(kGetIngressHostBytes == 448);
+static_assert(kGetIngressL1Bytes == 256);
+
+// Private L1 for the Fabric-free GET admission worker on its dedicated Tensix. The scratch mirrors
+// the complete D-page CB ring, allowing read and write command streams to overlap; the worker fences
+// writes only before the mirrored ring wraps or the request completes.
+constexpr uint32_t kGetAdmissionTerminationOffset = 0;
+constexpr uint32_t kGetAdmissionTerminationSize = 16;
+constexpr uint32_t kGetAdmissionReadyOffset = kGetAdmissionTerminationOffset + kGetAdmissionTerminationSize;
+constexpr uint32_t kGetAdmissionReadySize = 16;
+constexpr uint32_t kGetAdmissionDescriptorOffset = kGetAdmissionReadyOffset + kGetAdmissionReadySize;
+constexpr uint32_t kGetAdmissionScratchOffset = kGetAdmissionDescriptorOffset + sizeof(GetAdmissionDescriptor);
+constexpr uint32_t kGetAdmissionScratchBytes = kGetValueCbDepth * kMaxChunkValueBytes;
+constexpr uint32_t kGetAdmissionL1Bytes = kGetAdmissionScratchOffset + kGetAdmissionScratchBytes;
+static_assert(kGetAdmissionDescriptorOffset % 32 == 0);
+static_assert(kGetAdmissionScratchOffset % 32 == 0);
+static_assert(kGetAdmissionL1Bytes == 68672);
+// Device-visible metadata for mapped host-pool values, one half-cacheline per directory slot.
+constexpr uint32_t kHostPoolMetaBytes = 32;
+constexpr uint32_t kHostPoolMetaGenerationBeginWord = 0;
+constexpr uint32_t kHostPoolMetaReadOffWord = 1;
+constexpr uint32_t kHostPoolMetaTotalLenWord = 2;
+constexpr uint32_t kHostPoolMetaGenerationEndWord = 3;
+// Mapped WRITE_THROUGH device-push handshake. Names retain evict for wire-layout compatibility.
+constexpr uint32_t kEvictAckSemSize = 16;
+constexpr uint32_t kEvictAckSize = 16;
+constexpr uint32_t kEvictAckReadOffWord = 0;
+constexpr uint32_t kEvictAckGenerationWord = 1;
+constexpr uint32_t kEvictDoneSemSize = 16;
+constexpr uint32_t kMoveChannelsAlignPad = 0;
+constexpr uint32_t kMoveChannelsL1Size = kMoveReqSemSize + kMoveReqSlotBytes + kCommitReqSemSize + kCommitReqSlotBytes +
+                                         kMoveProcessedSemSize + kStageProgressSize + kPromoteDoneSemSize +
+                                         kEvictAckSemSize + kEvictAckSize + kEvictDoneSemSize + kMoveChannelsAlignPad;
+
+// Move-req op codes.
+constexpr uint32_t kMoveOpWriteThrough = 1;
+constexpr uint32_t kMoveOpDevicePromote = 2;  // explicit move_to_device cache admission
+constexpr uint32_t kMoveOpRemoveBacking = 3;  // reclaim removed directory slot's Server-host backing
+constexpr uint32_t kMoveOpHostServe = 4;      // host-only GET staging for read-through admission
+
+// Total L1 directory region (appended after the PUT region at runtime). The leading 32 B is
+// alignment headroom: the preceding region end is only 4-aligned, so the host rounds the
+// scan-staging start up to a 32-byte ABSOLUTE boundary (the BRISC batch reads / write-back need a
+// 32-aligned L1 address sharing the DRAM page phase); the <= 28 B padding is covered here. See
+// ttnn/cpp/ttnn/operations/kvcache_manager/docs/design.md §4.
+constexpr uint32_t kDirRegionAlignPad = 32;
+constexpr uint32_t kDirRegionL1Size = kDirRegionAlignPad + kDirScanStagingSize + kDirReqMailboxSize +
+                                      kDirRespMailboxSize + kDirReqSemSize + kDirDoneSemSize + kDirEpochCounterSize +
+                                      kDirCommitEntryStagingSize;
+static_assert((kDirScanStagingSize % 32) == 0, "directory scan staging must be 32-aligned");
+static_assert((kDirReqMailboxSize % 32) == 0, "directory request mailbox must be 32-aligned");
+
+// ---- Client side (client submesh L1 reserve) ----
+constexpr uint32_t kClientRecvBufferOffset = 128;
+constexpr uint32_t kClientRecvBufferSize = kFabricMaxPayloadBytes;
+constexpr uint32_t kClientRecvSemOffset = kClientRecvBufferOffset + kClientRecvBufferSize;
+constexpr uint32_t kClientRecvSemSize = 16;
+
+constexpr uint32_t kClientTxStagingOffset = kClientRecvSemOffset + kClientRecvSemSize;
+constexpr uint32_t kClientTxStagingSize = kFabricMaxPayloadBytes;
+
+// value_dst_l1 (PUT staging value region start) must be 32-aligned so per-chunk DRAM NoC reads
+// phase-match the 32-aligned DRAM src. Fails at compile time on a header-size change. See
+// ttnn/cpp/ttnn/operations/kvcache_manager/docs/design.md §4.
+static_assert(
+    (kClientTxStagingOffset + sizeof(PacketHeader) + sizeof(ChunkedPayloadHeader)) % 32 == 0,
+    "value_dst_l1 offset must be 32-aligned for DRAM NOC reads");
+
+// Preserve the existing client L1 phase after removing the former operation-ring handshake ACK.
+constexpr uint32_t kClientSessionReservedOffset = kClientTxStagingOffset + kClientTxStagingSize;
+constexpr uint32_t kClientSessionReservedSize = 16;
+
+// Scalar ingress completion accumulator. The Server adds status_flags + 1 after the output stream;
+// this is distinct from the host-CQ status buffer used by the fallback path.
+constexpr uint32_t kClientGetStatusWordOffset = kClientSessionReservedOffset + kClientSessionReservedSize;
+constexpr uint32_t kClientGetStatusWordSize = 16;
+constexpr uint32_t kClientScalarGetCompletionOffset = kClientGetStatusWordOffset;
+
+// ---- Client PUT value ring (reader->writer, client submesh L1 reserve) ----
+// reader (RISCV_0) DRAM-reads value bytes into an entry's value sub-region; writer (RISCV_1) fills
+// the header sub-region then fabric-sends the whole entry, decoupling DRAM read from fabric send
+// across two RISCs/NoCs. Entry layout mirrors tx_staging: [PacketHeader | ChunkedPayloadHeader |
+// value]; the stride is a 32-multiple so every entry's value sub-region (entry_base + 48) keeps the
+// 32-byte phase the per-chunk DRAM NoC reads need. See
+// ttnn/cpp/ttnn/operations/kvcache_manager/docs/design.md §4 and §6. D is env-tunable
+// (KVM_CLIENT_L1_RING_SLOTS), same injection model as kRingNumSlots; hosts MUST use
+// client_l1_reserve_bytes(value_ring_depth_) instead of this constexpr for L1 sizing.
+constexpr uint32_t kClientPutValueRingDepthDefault = 8;
+#ifndef KVM_CLIENT_RING_SLOTS
+#define KVM_CLIENT_RING_SLOTS 8  // keep literally in sync with kClientPutValueRingDepthDefault
+#endif
+constexpr uint32_t kClientPutValueRingDepth = KVM_CLIENT_RING_SLOTS;  // D
+
+// Reader prefetch depth P: value-chunk DRAM reads the PUT reader keeps in flight
+// (put_reader_kernel). Exposed so the writer's consumed-ack batch can bound itself
+// (kPutConsumedAckBatch <= D - P). Must stay < D.
+constexpr uint32_t kPutReaderPrefetchDepth = 4;  // P
+constexpr uint32_t kPutConsumedAckBatch = 4;
+constexpr uint32_t kClientPutValueRingDepthMin = kPutReaderPrefetchDepth + kPutConsumedAckBatch;
+static_assert(
+    kClientPutValueRingDepth >= kClientPutValueRingDepthMin,
+    "client value ring must cover reader prefetch plus the writer consumed-ACK batch");
+static_assert(kPutReaderPrefetchDepth < kClientPutValueRingDepth, "reader prefetch must be < ring depth");
+constexpr uint32_t kClientPutValueRingEntryStride = kFabricMaxPayloadBytes;  // 4352
+constexpr uint32_t kClientPutValueRingBaseOffset = kClientGetStatusWordOffset + kClientGetStatusWordSize;
+constexpr uint32_t kClientPutValueRingSize = kClientPutValueRingDepth * kClientPutValueRingEntryStride;
+
+// Pin the entry_base 32-byte phase at compile time so a header-size change fails loudly instead of
+// silently breaking DRAM NoC alignment (ttnn/cpp/ttnn/operations/kvcache_manager/docs/design.md §4).
+static_assert(
+    (kClientPutValueRingBaseOffset % 32) == 16,
+    "PUT value ring entry_base must be == 16 (mod 32) so value sub-region start is 32-aligned");
+static_assert(
+    (kClientPutValueRingBaseOffset + sizeof(PacketHeader) + sizeof(ChunkedPayloadHeader)) % 32 == 0,
+    "PUT value ring value sub-region start must be 32-aligned for DRAM NoC reads");
+static_assert((kClientPutValueRingEntryStride % 32) == 0, "PUT value ring stride must be 32-aligned");
+
+// Reader/writer counters are initialized once per request and cumulative within its chunk loop.
+constexpr uint32_t kClientPutRingProducedSemSize = 16;
+constexpr uint32_t kClientPutRingProducedSemOffset = kClientPutValueRingBaseOffset + kClientPutValueRingSize;
+constexpr uint32_t kClientPutRingConsumedSemSize = 16;
+constexpr uint32_t kClientPutRingConsumedSemOffset = kClientPutRingProducedSemOffset + kClientPutRingProducedSemSize;
+
+// Bootstrap ESTABLISH publishes the direct-PUT session state. The config is immutable for the session; the
+// descriptor is replaced with the next adaptive lease before every landed completion.
+constexpr uint32_t kClientPutSessionConfigSize = sizeof(PutSessionConfig);
+constexpr uint32_t kClientPutSessionConfigOffset = kClientPutRingConsumedSemOffset + kClientPutRingConsumedSemSize;
+constexpr uint32_t kClientPutLeaseDescriptorSize = sizeof(PutLeaseDescriptor);
+constexpr uint32_t kClientPutLeaseDescriptorOffset = kClientPutSessionConfigOffset + kClientPutSessionConfigSize;
+
+// Bounded PUT batch descriptors live in a dedicated client-core L1 MeshBuffer. The two cachelines
+// are cumulative reader/writer semaphores for the entire batch; item boundaries never reset them.
+constexpr uint32_t kClientPutBatchMaxItems = 128;
+constexpr uint32_t kClientPutBatchProducedSemOffset = 0;
+constexpr uint32_t kClientPutBatchConsumedSemOffset = 16;
+constexpr uint32_t kClientPutBatchItemsOffset = 32;
+constexpr uint32_t kClientPutBatchBufferSize =
+    kClientPutBatchItemsOffset + kClientPutBatchMaxItems * sizeof(PutBatchItemDescriptor);
+static_assert((kClientPutBatchBufferSize % 32) == 0, "PUT batch descriptor buffer must be 32-byte aligned");
+
+// ---- Client GET: fabric-direct-to-DRAM (no recv-ring, no writeback) ----
+// The server fabric-writes each value chunk STRAIGHT into the client output-tensor DRAM (interleaved
+// page), so the client has NO recv-ring and NO L1->DRAM writeback kernel. Fabric-issued GET reuses
+// recv_sem (kClientRecvSemOffset) as its one-shot completion signal; mapped ingress supplies a
+// cumulative completion word. The server atomic-inc's the selected word with flush=true, so the
+// observed completion implies any successful output writes are durable in DRAM. See
+// ttnn/cpp/ttnn/operations/kvcache_manager/docs/design.md §6 GET.
+
+// ---- Per-side L1 reserve sizes ----
+// Server and Client size their carve-outs INDEPENDENTLY: the server footprint grows with the runtime
+// packet-ring slot count, and the client footprint grows with its runtime value-ring depth. See
+// ttnn/cpp/ttnn/operations/kvcache_manager/docs/design.md §4 for the sizing derivation.
+
+// Runtime reserve sizing must remain below this ceiling.
+constexpr uint32_t kServerL1ReserveMaxBytes = 524288;  // 512 KiB
+
+// Client reserve default: default footprint end rounded up to a 4 KiB page (L1-page aligned
+// regardless of platform). The runtime reserve uses client_l1_reserve_bytes(value_ring_depth_)
+// below; this constant reflects the default depth only (documentation + static_assert checks). GET
+// is fabric-direct-to-DRAM (no recv-ring), so the client L1 footprint is just the PUT value ring.
+constexpr uint32_t kClientL1FootprintEnd = kClientPutLeaseDescriptorOffset + kClientPutLeaseDescriptorSize;
+constexpr uint32_t kClientL1ReservePage = 4096;
+constexpr uint32_t kClientL1ReserveBytes =
+    ((kClientL1FootprintEnd + kClientL1ReservePage - 1) / kClientL1ReservePage) * kClientL1ReservePage;
+
+// ---- Runtime sizing helpers (single source of truth for host carve-out sizes) ----
+// The Server resolves ring_slots and value_ring_depth from its environment. The Client resolves its
+// proposed value_ring_depth locally, and ESTABLISH rejects a mismatch. Host code must NOT use the
+// kRingNumSlots / kClientPutValueRingDepth /
+// kPutPipelineBaseOffset / kClientL1ReserveBytes constexprs (kernel-default only in a host TU).
+// These helpers recompute the same layout from a runtime parameter.
+
+// Client L1 footprint end for a given value-ring depth. Mirrors kClientL1FootprintEnd with depth as
+// a parameter (kClientPutValueRingBaseOffset is depth-independent; the two ring sems follow the
+// depth*stride ring).
+constexpr uint64_t client_l1_footprint_end(uint64_t depth) {
+    return static_cast<uint64_t>(kClientPutValueRingBaseOffset) + depth * kClientPutValueRingEntryStride +
+           kClientPutRingProducedSemSize + kClientPutRingConsumedSemSize + kClientPutSessionConfigSize +
+           kClientPutLeaseDescriptorSize;
+}
+// Client L1 reserve for a given depth: footprint end rounded up to a 4 KiB page.
+constexpr uint64_t client_l1_reserve_bytes(uint64_t depth) {
+    const uint64_t end = client_l1_footprint_end(depth);
+    return ((end + kClientL1ReservePage - 1) / kClientL1ReservePage) * kClientL1ReservePage;
+}
+
+// Server fixed-prefix end (== kPutPipelineBaseOffset) for a given ring slot count. The two
+// ring_slots-dependent terms are the packet ring (ring_slots * kRingSlotStride) and the ring sems
+// (ring_slots * kRingSemSize); the rest is a fixed sum.
+constexpr uint64_t server_fixed_prefix_end(uint64_t ring_slots) {
+    return static_cast<uint64_t>(kRingBaseOffset) + ring_slots * kRingSlotStride + ring_slots * kRingSemSize +
+           kRegistryTableSize + kPeerLookupTableSize + kHostAnyGetDoneMonitorSize + kGetCreditSemSize;
+}
+// Server L1 pipeline end (carve-out footprint), mirroring launch_server_kernel's runtime derivation:
+// fixed prefix, direct-done counters, the 32 B read-back scratch, and issued/committed counters.
+constexpr uint64_t server_pipeline_end(uint64_t ring_slots) {
+    const uint64_t prefix = server_fixed_prefix_end(ring_slots);  // == kPutPipelineBaseOffset
+    const uint64_t put_end = prefix + kPutDirectDoneRegionBytes + kPutReadbackScratchSize + kPutCommitCounterRegionSize;
+    // Then the directory region, the shared NCRISC/BRISC allocator state, and the host-tiering worker
+    // channels (move_req / commit_req) at the very end of the carve-out.
+
+    return put_end + kDirRegionL1Size + kHeapAllocatorStateSize + kMoveChannelsL1Size + kHashProbeStagingSize +
+           kHeapMetadataStagingSize + kColdStartDoneSize + kAllocatorProfileSize;
+}
+
+// Runtime versions of the ring_slots-dependent fixed-prefix offsets. Everything from
+// kRingSemBaseOffset onward shifts with the runtime ring slot count, so the host MUST use these
+// (parameterized by ring_slots_) instead of the kXxxOffset constexprs (kernel-default only). Each
+// mirrors its constexpr counterpart with ring_slots as a parameter; the constexprs stay for the
+// kernels (compile-time).
+constexpr uint64_t server_ring_sem_base_offset(uint64_t ring_slots) {
+    return static_cast<uint64_t>(kRingBaseOffset) + ring_slots * kRingSlotStride;
+}
+constexpr uint64_t server_registry_offset(uint64_t ring_slots) {
+    return server_ring_sem_base_offset(ring_slots) + ring_slots * kRingSemSize;
+}
+constexpr uint64_t server_peer_lookup_table_offset(uint64_t ring_slots) {
+    return server_registry_offset(ring_slots) + kRegistryTableSize;
+}
+constexpr uint64_t server_host_any_get_done_monitor_offset(uint64_t ring_slots) {
+    return server_peer_lookup_table_offset(ring_slots) + kPeerLookupTableSize;
+}
+constexpr uint64_t server_get_credit_sem_offset(uint64_t ring_slots) {
+    return server_host_any_get_done_monitor_offset(ring_slots) + kHostAnyGetDoneMonitorSize;
+}
+
+// Consistency: the runtime offset helpers must reproduce the constexpr offsets at the current
+// compile-time kRingNumSlots (the kXxxOffset constexprs are themselves derived from the compile
+// value, so this holds for whatever value the kernel JIT was built with).
+static_assert(server_ring_sem_base_offset(kRingNumSlots) == kRingSemBaseOffset, "ring sem base desync");
+static_assert(server_registry_offset(kRingNumSlots) == kRegistryOffset, "registry offset desync");
+static_assert(server_peer_lookup_table_offset(kRingNumSlots) == kPeerLookupTableOffset, "peer lookup offset desync");
+static_assert(
+    server_host_any_get_done_monitor_offset(kRingNumSlots) == kHostAnyGetDoneMonitorOffset, "any-get-done desync");
+static_assert(server_get_credit_sem_offset(kRingNumSlots) == kGetCreditSemOffset, "get credit sem desync");
+
+// Same consistency check for the aggregate ends (kPutPipelineBaseOffset / kClientL1ReserveBytes are
+// themselves derived from the compile-time kRingNumSlots / kClientPutValueRingDepth), so a layout
+// edit that desyncs the helper from the hand-derived offsets fails loudly at compile time.
+static_assert(
+    server_fixed_prefix_end(kRingNumSlots) == kPutPipelineBaseOffset,
+    "server_fixed_prefix_end must reproduce kPutPipelineBaseOffset");
+static_assert(
+    client_l1_reserve_bytes(kClientPutValueRingDepth) == kClientL1ReserveBytes,
+    "client_l1_reserve_bytes must reproduce kClientL1ReserveBytes");
+
+// (1) Client side: the client PUT value ring + sems must fit the client carve-out.
+static_assert(
+    kClientPutLeaseDescriptorOffset + kClientPutLeaseDescriptorSize <= kClientL1ReserveBytes,
+    "client PUT value ring overflows the client L1 reserve (kClientL1ReserveBytes)");
+
+// (2) Server side: the fixed prefix must fit under the reserve ceiling at compile time. The runtime
+//     pipeline end depends on slot counts, so it cannot be a static_assert — reserve_l1 /
+//     launch_server_kernel TT_FATAL it. This pins the fixed prefix so a future host-region growth
+//     that alone overflows the ceiling fails loudly here.
+static_assert(
+    kPutPipelineBaseOffset <= kServerL1ReserveMaxBytes,
+    "server fixed L1 region (through kPutPipelineBaseOffset) overflows the server L1 reserve ceiling");
+
+}  // namespace ttnn::operations::kvcache_manager::protocol
diff --git a/ttnn/cpp/ttnn/operations/kvcache_manager/common/protocol/packet.hpp b/ttnn/cpp/ttnn/operations/kvcache_manager/common/protocol/packet.hpp
