index 0000000000000000000000000000000000000000..cf1d3729685809c2728edf4d1d539a9834829352
--- /dev/null
+++ b/ttnn/cpp/ttnn/operations/kvcache_manager/server/device/kernels/dataflow/dram_worker_kernel.cpp
@@ -0,0 +1,2826 @@
+// SPDX-FileCopyrightText: (c) 2026 Moreh
+//
+// SPDX-License-Identifier: Apache-2.0
+//
+// kvcache_manager DRAM worker kernel (BRISC / RISCV_0 / NOC0). Owns the directory, hash index,
+// buddy allocator, PUT publication, and GET value reads. It opens no Fabric connection; the NCRISC
+// owns Fabric I/O and submits directory requests through an L1 mailbox.
+//
+// A SINGLE RISC services the channels one at a time, so directory and buddy state are serialized by
+// construction. A published streamed-PUT tail owns the move channel until durable; otherwise request
+// lookup/allocation, pending-host FIFO work, and explicit move completion share the loop. Landed PUT
+// publication may precede host durability, but commit completion follows host backing and its directory fence.
+//
+// last_access is a BRISC-private epoch, incremented on GET hits, direct PUT commits, and explicit
+// cache admission. A host-tier GET attempts read-through admission. EXISTS does not change recency.
+//
+// RT-arg meanings are on the parse block in kernel_main (the host passes a bare list). Directory /
+// value-heap / stash layout and the 32-byte DRAM-NoC alignment rule are in
+// ttnn/cpp/ttnn/operations/kvcache_manager/docs/design.md §4. Operation flows are in §6-§7;
+// consistency is in §9.
+
+#include <cstdint>
+
+#include "api/dataflow/dataflow_api.h"
+
+#include "ttnn/cpp/ttnn/operations/kvcache_manager/common/protocol/packet.hpp"
+#include "ttnn/cpp/ttnn/operations/kvcache_manager/common/protocol/layout.hpp"
+#include "ttnn/cpp/ttnn/operations/kvcache_manager/common/kvm_device_zone.hpp"
+
