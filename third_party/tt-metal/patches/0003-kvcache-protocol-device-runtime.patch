index 0000000000000000000000000000000000000000..f22fee2d963f1c0e31034c89c54e856b1e82076d
--- /dev/null
+++ b/ttnn/cpp/ttnn/operations/kvcache_manager/gather/device/kernels/dataflow/gather_wait_kernel.cpp
@@ -0,0 +1,50 @@
+// SPDX-FileCopyrightText: (c) 2026 Moreh
+//
+// SPDX-License-Identifier: Apache-2.0
+//
+// TP-shard gather, master half (RISCV_0). Waits until every sender's completion event has landed,
+// then clears the counter for the next gather. Because this runs inside the same MeshWorkload as
+// the senders, ordinary workload completion already means the gathered bytes are in master DRAM --
+// the host needs no device polling of its own.
+//
+// RT args:
+//   [0] done_counter_addr   absolute L1 address of the completion counter on this chip
+//   [1] expected_senders    including this chip
+//   [2] max_spins           abort after this many polls with the count still short (0 = no limit)
+
+#include <cstdint>
+
+#include "api/dataflow/dataflow_api.h"
+
+void kernel_main() {
+    const uint32_t done_counter_addr = get_arg_val<uint32_t>(0);
+    const uint32_t expected_senders = get_arg_val<uint32_t>(1);
+    const uint32_t max_spins = get_arg_val<uint32_t>(2);
+
+    volatile tt_l1_ptr uint32_t* counter = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(done_counter_addr);
+
+    // Bounded wait. An unbounded one is not merely slow to diagnose: the host side of this workload
+    // is a blocking enqueue holding the mesh-wide API mutex, so a counter that never arrives takes
+    // every thread on the device down with it -- silently, process still in S state, no error
+    // anywhere. Giving up instead lets the workload finish and the host report a short count.
+    //
+    // Counted in polls rather than cycles: the wall-clock helpers live in arch-specific internal
+    // headers, and this only needs to be unmistakably longer than any legitimate wait, not precise.
+    // Word 1 is the abort flag, kept separate from the count. Reporting "gave up" by leaving the
+    // count behind does not work: a wait that timed out having received NOTHING leaves zero, which
+    // is byte-identical to the zero a satisfied waiter writes. The host could then only detect a
+    // partial arrival, never a total one -- and for the single-sender waits (per-chip, and every
+    // scatter receiver) that means it could detect nothing at all.
+    volatile tt_l1_ptr uint32_t* aborted = counter + 1;
+    *aborted = 0;
+
+    uint32_t spins = 0;
+    while (*counter < expected_senders) {
+        invalidate_l1_cache();
+        if (max_spins != 0 && ++spins > max_spins) {
+            *aborted = 1;  // count is left as-is so the host can say how many did land
+            return;
+        }
+    }
+    *counter = 0;
+}
diff --git a/ttnn/cpp/ttnn/operations/kvcache_manager/gather/device/kernels/dataflow/scatter_push_kernel.cpp b/ttnn/cpp/ttnn/operations/kvcache_manager/gather/device/kernels/dataflow/scatter_push_kernel.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..fe232f2ade37be98af23066b67117d55098195ba
--- /dev/null
+++ b/ttnn/cpp/ttnn/operations/kvcache_manager/gather/device/kernels/dataflow/scatter_push_kernel.cpp
@@ -0,0 +1,214 @@
+// SPDX-FileCopyrightText: (c) 2026 Moreh
+//
+// SPDX-License-Identifier: Apache-2.0
+//
+// Chunk scatter, master half (RISCV_1 / NOC1). The inverse of gather_push_kernel: the master chip
+// holds a blob a wire GET has just streamed into its DRAM, and hands each rank back the slice that
+// belongs to it, over fabric, so a retrieve needs no host round trip either.
+//
+// Only the master can drive this: fabric reads are UDM-gated, so a rank cannot pull its own slice.
+// The master therefore writes into every rank's cache and closes with one fused
+// write+atomic_inc per rank; each rank runs a waiter kernel on that counter, so workload
+// completion means every rank's bytes have landed.
+//
+// Source layout is the gather's output: for member m, chunk block cb and rank r, the slice sits at
+// region_base[m] + cb*block_bytes + r*shard_block_bytes, and belongs at block_ids[cb] *
+// shard_block_bytes of rank r's own cache shard.
+//
+// RT args:
+//   [0]  num_members
+//   [1]  num_blocks
+//   [2]  num_ranks
+//   [3]  src_dram_base          the gathered blob on this chip
+//   [4]  src_page_size
+//   [5]  shard_block_bytes
+//   [6]  block_bytes            shard_block_bytes * num_ranks
+//   [7]  master_rank            this chip's own rank (written locally, not over fabric)
+//   [8]  peer_noc_x             worker core coordinates, identical on every chip
+//   [9]  peer_noc_y
+//   [10] done_counter_addr      absolute L1 address of the per-chip completion counter
+//   [11] l1_scratch_addr
+//   [12] l1_scratch_stride
+//   [..] block_ids[num_blocks]
+//   [..] per member: dst_dram_base, dst_page_size, region_base
+//   [..] per rank: route_word, connection_index
+//   [..] fabric connection args, one connection per unique first-hop direction
+
+#include <cstdint>
+
+#include "api/dataflow/dataflow_api.h"
+#include "tt_metal/fabric/hw/inc/edm_fabric/edm_fabric_worker_adapters.hpp"
+#include "tt_metal/fabric/hw/inc/packet_header_pool.h"
+#include "tt_metal/fabric/fabric_edm_packet_header.hpp"
+#include "ttnn/cpp/ttnn/operations/kvcache_manager/common/kvm_fabric_route.hpp"
+
+namespace {
+
+constexpr uint32_t kMaxPayload = 4096;
+constexpr uint32_t kHeaderRingDepth = 4;
+// One connection per eth direction; the mesh has four plus slack, same bound the wire server uses.
+constexpr uint32_t kMaxConnections = 5;
+
+FORCE_INLINE uint64_t remote_dram_noc_addr(const InterleavedAddrGen<true>& d, uint32_t page_id, uint32_t offset) {
+    uint64_t noc_address = d.get_noc_addr(page_id, offset, tt::tt_fabric::edm_to_local_chip_noc);
+#if defined(ARCH_WORMHOLE)
+    auto components = get_noc_address_components(noc_address);
+    noc_address = safe_get_noc_addr(
+        components.first.x, components.first.y, components.second, tt::tt_fabric::edm_to_local_chip_noc);
+#endif
+    return noc_address;
+}
+
+}  // namespace
+
+void kernel_main() {
+    size_t arg = 0;
+    const uint32_t num_members = get_arg_val<uint32_t>(arg++);
+    const uint32_t num_blocks = get_arg_val<uint32_t>(arg++);
+    const uint32_t num_ranks = get_arg_val<uint32_t>(arg++);
+    const uint32_t src_dram_base = get_arg_val<uint32_t>(arg++);
+    const uint32_t src_page_size = get_arg_val<uint32_t>(arg++);
+    const uint32_t shard_block_bytes = get_arg_val<uint32_t>(arg++);
+    const uint32_t block_bytes = get_arg_val<uint32_t>(arg++);
+    const uint32_t master_rank = get_arg_val<uint32_t>(arg++);
+    const uint32_t peer_noc_x = get_arg_val<uint32_t>(arg++);
+    const uint32_t peer_noc_y = get_arg_val<uint32_t>(arg++);
+    const uint32_t done_counter_addr = get_arg_val<uint32_t>(arg++);
+    const uint32_t l1_scratch_addr = get_arg_val<uint32_t>(arg++);
+    const uint32_t l1_scratch_stride = get_arg_val<uint32_t>(arg++);
+    const size_t block_ids_arg = arg;
+    arg += num_blocks;
+    const size_t members_arg = arg;
+    arg += 3 * num_members;
+    const size_t ranks_arg = arg;
+    arg += 2 * num_ranks;
+    const uint32_t num_connections = get_arg_val<uint32_t>(arg++);
+
+    const InterleavedAddrGen<true> src{.bank_base_address = src_dram_base, .page_size = src_page_size};
+
+    tt::tt_fabric::WorkerToFabricEdmSender connections[kMaxConnections];
+    for (uint32_t c = 0; c < num_connections; ++c) {
+        connections[c] = tt::tt_fabric::WorkerToFabricEdmSender::build_from_args<ProgrammableCoreType::TENSIX>(arg);
+    }
+    volatile tt_l1_ptr PACKET_HEADER_TYPE* headers[kHeaderRingDepth];
+    for (uint32_t i = 0; i < kHeaderRingDepth; ++i) {
+        headers[i] = PacketHeaderPool::allocate_header();
+    }
+    for (uint32_t c = 0; c < num_connections; ++c) {
+        connections[c].open();
+    }
+
+    uint32_t header_count = 0;
+    uint32_t scratch_slot = 0;
+    // Local-path write pipelining mirrors gather_push_kernel.cpp: the barrier moves from
+    // per-piece to slot reuse, so the local write drains while the next piece's read runs.
+    bool write_inflight[2] = {false, false};
+    for (uint32_t m = 0; m < num_members; ++m) {
+        const uint32_t dst_dram_base = get_arg_val<uint32_t>(members_arg + 3 * m);
+        const uint32_t dst_page_size = get_arg_val<uint32_t>(members_arg + 3 * m + 1);
+        const uint32_t region_base = get_arg_val<uint32_t>(members_arg + 3 * m + 2);
+        const InterleavedAddrGen<true> dst{.bank_base_address = dst_dram_base, .page_size = dst_page_size};
+
+        for (uint32_t cb = 0; cb < num_blocks; ++cb) {
+            const uint32_t local_block = get_arg_val<uint32_t>(block_ids_arg + cb);
+
+            for (uint32_t r = 0; r < num_ranks; ++r) {
+                const uint32_t route_word = get_arg_val<uint32_t>(ranks_arg + 2 * r);
+                const uint32_t conn_idx = get_arg_val<uint32_t>(ranks_arg + 2 * r + 1);
+                const bool local = r == master_rank;
+
+                uint32_t src_off = region_base + cb * block_bytes + r * shard_block_bytes;
+                uint32_t dst_off = local_block * shard_block_bytes;
+                uint32_t left = shard_block_bytes;
+
+                while (left > 0) {
+                    const uint32_t src_page = src_off / src_page_size;
+                    const uint32_t src_in_page = src_off - src_page * src_page_size;
+                    uint32_t n = left;
+                    const uint32_t src_room = src_page_size - src_in_page;
+                    if (n > src_room) {
+                        n = src_room;
+                    }
+                    if (n > l1_scratch_stride) {
+                        n = l1_scratch_stride;
+                    }
+
+                    const uint32_t slot = scratch_slot % 2;
+                    const uint32_t staging = l1_scratch_addr + slot * l1_scratch_stride;
+                    ++scratch_slot;
+                    if (write_inflight[slot]) {
+                        noc_async_write_barrier();
+                        write_inflight[0] = false;
+                        write_inflight[1] = false;
+                    }
+                    noc_async_read(src.get_noc_addr(src_page, src_in_page), staging, n);
+                    noc_async_read_barrier();
+
+                    // One source read may feed several destination-page/MTU-sized sends.
+                    uint32_t staged = 0;
+                    while (staged < n) {
+                        const uint32_t destination_offset = dst_off + staged;
+                        const uint32_t dst_page = destination_offset / dst_page_size;
+                        const uint32_t dst_in_page = destination_offset - dst_page * dst_page_size;
+                        uint32_t piece = n - staged;
+                        const uint32_t dst_room = dst_page_size - dst_in_page;
+                        if (piece > dst_room) {
+                            piece = dst_room;
+                        }
+                        if (!local && piece > kMaxPayload) {
+                            piece = kMaxPayload;
+                        }
+
+                        if (local) {
+                            noc_async_write(staging + staged, dst.get_noc_addr(dst_page, dst_in_page), piece);
+                            write_inflight[slot] = true;
+                        } else {
+                            const uint32_t send_bytes = (piece + 15u) & ~15u;
+                            volatile tt_l1_ptr PACKET_HEADER_TYPE* hdr = headers[header_count++ % kHeaderRingDepth];
+                            ttnn::operations::kvcache_manager::protocol::set_unicast_route(hdr, route_word);
+                            hdr->to_noc_unicast_write(
+                                tt::tt_fabric::NocUnicastCommandHeader{
+                                    remote_dram_noc_addr(dst, dst_page, dst_in_page)},
+                                send_bytes);
+                            connections[conn_idx].wait_for_empty_write_slot();
+                            connections[conn_idx].send_payload_without_header_non_blocking_from_address(
+                                staging + staged, send_bytes);
+                            connections[conn_idx].send_payload_blocking_from_address(
+                                reinterpret_cast<uint32_t>(hdr), sizeof(PACKET_HEADER_TYPE));
+                        }
+                        staged += piece;
+                    }
+
+                    src_off += n;
+                    dst_off += n;
+                    left -= n;
+                }
+            }
+        }
+    }
+
+    // The master's own pipelined writes must have landed before completion is signalled anywhere
+    // (kernel exit is the local rank's completion signal).
+    if (write_inflight[0] || write_inflight[1]) {
+        noc_async_write_barrier();
+    }
+
+    // Tell every rank its slice is complete; each one waits on this counter.
+    const uint64_t done_noc = get_noc_addr(peer_noc_x, peer_noc_y, done_counter_addr);
+    for (uint32_t r = 0; r < num_ranks; ++r) {
+        if (r == master_rank) {
+            continue;
+        }
+        const uint32_t route_word = get_arg_val<uint32_t>(ranks_arg + 2 * r);
+        const uint32_t conn_idx = get_arg_val<uint32_t>(ranks_arg + 2 * r + 1);
+        volatile tt_l1_ptr PACKET_HEADER_TYPE* hdr = headers[header_count++ % kHeaderRingDepth];
+        ttnn::operations::kvcache_manager::protocol::set_unicast_route(hdr, route_word);
+        hdr->to_noc_unicast_atomic_inc(tt::tt_fabric::NocUnicastAtomicIncCommandHeader{done_noc, 1, /*flush=*/true});
+        connections[conn_idx].wait_for_empty_write_slot();
+        connections[conn_idx].send_payload_flush_blocking_from_address(
+            reinterpret_cast<uint32_t>(hdr), sizeof(PACKET_HEADER_TYPE));
+    }
+    for (uint32_t c = 0; c < num_connections; ++c) {
+        connections[c].close();
+    }
+}
