diff --git a/ttnn/cpp/ttnn/operations/kvcache_manager/server/device/kernels/dataflow/dram_worker_kernel.cpp b/ttnn/cpp/ttnn/operations/kvcache_manager/server/device/kernels/dataflow/dram_worker_kernel.cpp
