index 0000000000000000000000000000000000000000..a92a3ca73d4db89646b5f307e9b807495f463013
--- /dev/null
+++ b/ttnn/cpp/ttnn/operations/kvcache_manager/common/protocol/packet.hpp
@@ -0,0 +1,321 @@
+// SPDX-FileCopyrightText: (c) 2026 Moreh
+//
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+namespace ttnn::operations::kvcache_manager::protocol {
+
+enum class OpCode : uint32_t {
+    NONE = 0,                       // unset / sentinel; reserved for slot-reset and no-op semantics
+    RESERVED_SESSION = 1,           // retained so existing operation opcode values do not change
+    PING = 2,                       // client → server: echo me back
+    ECHO = 3,                       // server → client: echo response
+    RESERVED_SESSION_RESPONSE = 4,  // retained so existing operation opcode values do not change
+    PUT = 5,                        // reserved legacy single-packet PUT
+    PUT_ACK = 6,                    // server → client: direct-PUT allocation grant
+    GET = 7,                        // reserved legacy single-packet GET
+    GET_RESP = 8,                   // reserved legacy single-packet GET response
+    PUT_CHUNK = 9,                  // client → server: direct-PUT control packet; value bytes bypass the ring
+    GET_CHUNK_REQ = 10,             // client → server: chunk-0 stream request (server pushes the rest)
+    GET_CHUNK_RESP = 11,            // reserved legacy multi-packet GET response
+    EXISTS = 12,                    // client → server: key lookup (single packet request)
+    EXISTS_RESP = 13,               // server → client: status_flags bit0 = found
+    REMOVE = 14,                    // client → server: key erase (single packet request)
+    REMOVE_RESP = 15,               // server → client: bit 0 = removed, bits 1..31 = removed directory slot
+    MOVE_TO_HOST = 16,              // client → server: invalidate device copy; authoritative host copy remains
+    MOVE_TO_DEVICE = 17,            // client → server: admit authoritative host copy into the device cache
+    DETACH = 18,                    // client → server: release the session so the slot can be reused
+    DETACH_RESP = 19,               // server → client: session released (bit 0 = was established)
+    COMMIT_BARRIER = 20,            // client → server: wait until every previously issued PUT is host-committed
+};
+
+// 4 x uint32 = 16 bytes, matching the NoC alignment unit (ttnn/cpp/ttnn/operations/kvcache_manager/docs/design.md §3).
+struct alignas(16) PacketHeader {
+    uint32_t opcode;        // OpCode value (serialized as uint32)
+    uint32_t seq;           // Packet sequence id. Echo reflects it verbatim.
+    uint32_t payload_size;  // Trailing payload byte count (excluding header).
+    uint32_t client_token;  // Registry ID in low bits plus the Server-issued session generation.
+};
+static_assert(sizeof(PacketHeader) == 16, "PacketHeader must be 16 bytes (NoC alignment)");
+
+// Per-packet fabric budget. 4352 mirrors tt::tt_fabric::udm::max_fabric_payload_size; that udm header
+// cannot be #included here (this header is host+kernel-shared), so the value is duplicated by hand.
+// Both 1D and 2D fabrics provision this same default (erisc_datamover_builder.hpp
+// static_asserts pin it), and validate_kvcache_fabric_config() re-checks the live fabric's
+// provisioning at runtime, so a drifted or user-overridden smaller MTU fails loudly at ctor time.
+// See ttnn/cpp/ttnn/operations/kvcache_manager/docs/design.md §3.
+constexpr uint32_t kFabricMaxPayloadBytes = 4352;
+constexpr uint32_t kMaxAppPayloadBytes = kFabricMaxPayloadBytes - sizeof(PacketHeader);  // 4336
+
+// PING travels through RT args, whose word limit makes its cap smaller than the wire payload limit.
+constexpr uint32_t kMaxPingPayloadBytes = 1024;
+static_assert(kMaxPingPayloadBytes <= kMaxAppPayloadBytes, "ping cap must not exceed the wire MTU");
+
+// Maximum key byte length (WIRE cap). Covers hex-encoded SHA-256 / blake3-256 (64 chars) with margin;
+// longer keys are rejected client-side. Carried by the PUT/GET chunk-0 payloads (PUT chunk0
+// key_words[32] = 128 B), so the device directory's runtime max_key_len (KVM_SERVER_MAX_KEY_BYTES)
+// must stay <= this (the Server ctor TT_FATALs otherwise) until the wire key field is widened.
+constexpr uint32_t kMaxPutKeyBytes = 128;
+
+constexpr uint32_t kGetStatusFound = 1u << 0;
+constexpr uint32_t kGetStatusOutputTooSmall = 1u << 1;
+constexpr uint32_t kGetCompletionCumulativeV2 = 2;
+
+// EXISTS_RESP / REMOVE_RESP status payload: first uint32 = status_flags (bit 0 = found / removed),
+// REMOVE_RESP additionally packs the removed directory slot into bits 1..31.
+// Remaining bytes are zero pad; the full wire response is 32 B. See
+// ttnn/cpp/ttnn/operations/kvcache_manager/docs/design.md §3.
+constexpr uint32_t kExistsRemoveStatusPayloadBytes = 16;
+constexpr uint32_t kStatusFlagFound = 1u << 0;    // EXISTS_RESP — key present
+constexpr uint32_t kStatusFlagRemoved = 1u << 0;  // REMOVE_RESP — erase returned > 0
+constexpr uint32_t kRemoveStatusSlotShift = 1;
+
+// ---- Direct PUT control ----
+
+// The only PUT_CHUNK ring packet has chunk_idx == 0 and is followed by TensorMetadata and the key.
+// num_chunks counts this control packet plus direct-DRAM value chunks; chunk_payload_len is key_len.
+// A lease hit carries its generation and U-aligned value offset in the last two words; fallback
+// carries zero and receives a PutGrantPayload. See
+// ttnn/cpp/ttnn/operations/kvcache_manager/docs/design.md §3.
+struct alignas(16) ChunkedPayloadHeader {
+    uint32_t stream_id_seq;
+    uint32_t chunk_idx;
+    uint32_t num_chunks;
+    uint32_t total_value_len;
+    uint32_t chunk_payload_len;
+    uint32_t status_flags;
+    // Lease generation, or zero on fallback.
+    uint32_t tensor_slot_id;
+    // U-aligned leased value offset, or zero on fallback.
+    uint32_t value_byte_off;
+};
+static_assert(sizeof(ChunkedPayloadHeader) == 32, "ChunkedPayloadHeader must be 32 bytes");
+
+// Direct-PUT allocation fallback response. A matching adaptive lease skips this grant. On a miss,
+// the client first sends only PUT chunk 0 to the server L1 ring; the server reserves the final
+// device-cache block and replies with this grant. Value chunks then bypass the server L1 ring and
+// Fabric-write directly to the granted interleaved DRAM pages. A final flush=true atomic to
+// completion_l1_addr orders every DRAM write before the server's landed ACK and later commit.
+struct alignas(16) PutGrantPayload {
+    uint32_t status;              // kPutGrantGranted, or 0 on rejection
+    uint32_t dram_value_base;     // server interleaved value-heap base
+    uint32_t value_byte_off;      // U-aligned offset of the reserved buddy block
+    uint32_t completion_l1_addr;  // absolute server-worker L1 completion semaphore address
+};
+static_assert(sizeof(PutGrantPayload) == 16, "PutGrantPayload must be 16 bytes");
+
+constexpr uint32_t kPutGrantGranted = 1;
+
+// Session establishment publishes the invariant half of the direct-PUT destination in the client carve-out.
+// A ready PutLeaseDescriptor supplies the per-request offset; a miss falls back to PutGrantPayload.
+struct alignas(16) PutSessionConfig {
+    uint32_t version;
+    uint32_t dram_value_base;
+    uint32_t completion_l1_addr;  // this client's landed fence (one cacheline per client)
+    // Large-PUT stream progress, SHARED by every client. Progress is consumed by the server's BRISC,
+    // which watches one address; PUTs are serialized through the NCRISC dispatch loop, so at most
+    // one client is streaming and a single cumulative sequence is unambiguous. Splitting PUT
+    // handling across clients would have to make this per-client too.
+    uint32_t progress_l1_addr;
+};
+static_assert(sizeof(PutSessionConfig) == 16, "PutSessionConfig must be 16 bytes");
+
+// Single adaptive next-PUT lease. The server keeps at most one uncommitted buddy block reserved,
+// avoiding both the chunk-0 grant RTT for a repeated size class and unbounded per-class reservations.
+struct alignas(16) PutLeaseDescriptor {
+    uint32_t generation;
+    uint32_t value_byte_off;
+    uint32_t buddy_order;
+    uint32_t status;
+};
+static_assert(sizeof(PutLeaseDescriptor) == 16, "PutLeaseDescriptor must be 16 bytes");
+
+constexpr uint32_t kPutSessionVersion = 1;
+constexpr uint32_t kPutLeaseReady = 1;
+constexpr uint32_t kPutStatusUsesLease = 1u << 31;
+
+// GET request chunk header. Followed by `key_len` key bytes on chunk_idx == 0. The client sends
+// exactly one chunk-0 request carrying the OUTPUT tensor's DRAM base, page size, and packed capacity,
+// so the server can validate the target before fabric-writing each value chunk straight into the
+// client's output-tensor DRAM (no client recv-ring / writeback). Completion is signalled as
+// status_flags + 1, reserving zero for pending. Completion mode 0 uses the established recv semaphore;
+// scalar mapped ingress uses a cumulative-v2 word.
+// See ttnn/cpp/ttnn/operations/kvcache_manager/docs/design.md §6 GET.
+struct alignas(16) GetChunkReqHeader {
+    uint32_t stream_id_seq;
+    uint32_t req_chunk_idx;
+    uint32_t key_len;                // meaningful only when req_chunk_idx == 0
+    uint32_t client_dram_base;       // client output-tensor DRAM base addr (fabric-direct-to-DRAM target)
+    uint32_t logical_page_size;      // client output-tensor interleaved page size (DRAM write cursor)
+    uint32_t output_capacity_bytes;  // client output tensor packed capacity; server rejects larger values
+    uint32_t completion_l1_addr;     // absolute client L1 completion word in cumulative-v2 mode
+    uint32_t completion_mode;        // 0 = established recv_sem; otherwise selects the address above
+};
+static_assert(sizeof(GetChunkReqHeader) == 32, "GetChunkReqHeader must be 32 bytes");
+static_assert(offsetof(GetChunkReqHeader, completion_l1_addr) == 24);
+static_assert(offsetof(GetChunkReqHeader, completion_mode) == 28);
+
+constexpr PacketHeader make_get_ingress_packet_header(uint32_t seq, uint32_t key_len, uint32_t client_token) {
+    return {
+        .opcode = static_cast<uint32_t>(OpCode::GET_CHUNK_REQ),
+        .seq = seq,
+        .payload_size = static_cast<uint32_t>(sizeof(GetChunkReqHeader)) + key_len,
+        .client_token = client_token,
+    };
+}
+
+// Host-to-server scalar GET ingress descriptor. It is read by a Fabric-free server worker, which
+// copies `packet_bytes` into the existing core-0 request ring. The host release fence plus the
+// separately published L1 doorbell prevents a partial descriptor from becoming live; duplicate
+// generation tags make that ordering observable in debug builds.
+constexpr uint32_t kGetIngressPacketCapacity = sizeof(PacketHeader) + sizeof(GetChunkReqHeader) + kMaxPutKeyBytes;
+struct alignas(32) GetIngressDescriptor {
+    uint32_t generation_begin;
+    uint32_t ring_slot;
+    uint32_t packet_bytes;
+    uint32_t _reserved0;
+    uint8_t packet[kGetIngressPacketCapacity];
+    uint32_t generation_end;
+    uint32_t _reserved1[7];
+};
+static_assert(sizeof(GetIngressDescriptor) == 224, "GET ingress descriptor must be 224 bytes");
+static_assert(alignof(GetIngressDescriptor) == 32, "GET ingress descriptor must be NoC aligned");
+static_assert(offsetof(GetIngressDescriptor, packet) == 16);
+static_assert(offsetof(GetIngressDescriptor, generation_end) == 192);
+
+// One immutable descriptor covers a complete mapped-host cache admission. The producer publishes
+// each B-page CB batch by advancing the worker-local ready counter; the worker walks the CB ring
+// from first_cb_l1_addr and owns every server-DRAM cache-fill write for this request.
+struct alignas(32) GetAdmissionDescriptor {
+    uint32_t first_ready_ticket;
+    uint32_t first_cb_l1_addr;
+    uint32_t heap_base_unit;
+    uint32_t total_value_len;
+    uint32_t num_chunks;
+    uint32_t num_batches;
+    uint32_t first_ready_ticket_end;
+    uint32_t durable_ticket;
+};
+static_assert(sizeof(GetAdmissionDescriptor) == 32, "GET admission descriptor must be 32 bytes");
+static_assert(alignof(GetAdmissionDescriptor) == 32, "GET admission descriptor must be NoC aligned");
+
+// Maximum logical-shape rank carried by TensorMetadata. KV cache tensors are (B, H, S, D) — rank 4;
+// one extra slot leaves margin.
+constexpr uint32_t kTensorShapeMaxRank = 5;
+
+// Tensor metadata carried in the PUT control packet. The current Server does not retain it or
+// return it from GET; callers own the output tensor specification. dtype/layout use the raw uint32
+// enum values within one build. See ttnn/cpp/ttnn/operations/kvcache_manager/docs/design.md §3.
+struct alignas(16) TensorMetadata {
+    uint32_t logical_page_size;           // tensor_spec.compute_page_size_bytes() (gap-free wire unit)
+    uint32_t num_pages;                   // total_value_len / logical_page_size
+    uint32_t dtype;                       // static_cast<uint32_t>(DataType)
+    uint32_t layout;                      // static_cast<uint32_t>(Layout)  (ROW_MAJOR=0, TILE=1)
+    uint32_t rank;                        // logical_shape.rank()  (<= kTensorShapeMaxRank)
+    uint32_t shape[kTensorShapeMaxRank];  // logical_shape dims (first `rank` valid)
+};
+static_assert(sizeof(TensorMetadata) == 48, "TensorMetadata must be 48 bytes");
+static_assert(offsetof(TensorMetadata, logical_page_size) == 0);
+static_assert(offsetof(TensorMetadata, num_pages) == 4);
+static_assert(offsetof(TensorMetadata, dtype) == 8);
+static_assert(offsetof(TensorMetadata, layout) == 12);
+static_assert(offsetof(TensorMetadata, rank) == 16);
+static_assert(offsetof(TensorMetadata, shape) == 20);
+
+// Host-uploaded descriptor for one item in a bounded PUT batch. This is a client-local ABI: it
+// does not traverse Fabric, and the batch writer reconstructs the existing scalar PUT wire packet
+// from it. Sequence numbers are consecutive from the batch base sequence and are not stored here.
+struct alignas(16) PutBatchItemDescriptor {
+    uint32_t num_chunks;
+    uint32_t total_value_len;
+    uint32_t client_dram_addr;
+    uint32_t logical_page_size;
+    uint32_t num_pages;
+    uint32_t dtype;
+    uint32_t layout;
+    uint32_t rank;
+    uint32_t shape[kTensorShapeMaxRank];
+    uint32_t key_len;
+    uint32_t key_words[32];
+    uint32_t _reserved[2];
+};
+static_assert(sizeof(PutBatchItemDescriptor) == 192, "PUT batch item descriptor must be 192 bytes");
+static_assert(alignof(PutBatchItemDescriptor) == 16, "PUT batch item descriptor must be NoC aligned");
+static_assert(offsetof(PutBatchItemDescriptor, shape) == 32);
+static_assert(offsetof(PutBatchItemDescriptor, key_len) == 52);
+static_assert(offsetof(PutBatchItemDescriptor, key_words) == 56);
+
+// Per-chunk value capacity. Raw capacity (4304) is floored to a multiple of 32 so every per-chunk
+// DRAM NoC read is 32-byte aligned (ttnn/cpp/ttnn/operations/kvcache_manager/docs/design.md §3, §4).
+constexpr uint32_t kMaxChunkValueBytesRaw =
+    kFabricMaxPayloadBytes - sizeof(PacketHeader) - sizeof(ChunkedPayloadHeader);  // 4304
+constexpr uint32_t kMaxChunkValueBytes = (kMaxChunkValueBytesRaw / 32) * 32;       // 4288 = 134 * 32
+static_assert(kMaxChunkValueBytes % 32 == 0, "chunk size must be 32-aligned for DRAM NOC reads");
+// Guard: below 4 KiB means a fabric-MTU or header-size change that requires a re-spec.
+static_assert(
+    kMaxChunkValueBytes >= 4096, "Chunk capacity dropped below 4 KiB — fabric MTU or header growth requires a re-spec");
+
+// Default per-value cap. Runtime resolution controls PUT validation, GET chunk bounds, staging size,
+// and the minimum value-heap requirement; it is not a wire-width limit. See
+// "Configuration" in ttnn/cpp/ttnn/operations/kvcache_manager/docs/development.md.
+constexpr uint32_t kMaxMultiChunkValueBytesDefault = 64u << 20;  // 64 MiB
+
+// Largest value whose U-aligned storage size is representable in uint32_t. Keeping the cap aligned
+// also lets host and device code compute chunk counts without the overflow-prone ceil-div addition.
+constexpr uint32_t kMaxChunkAlignedValueBytes = (UINT32_MAX / kMaxChunkValueBytes) * kMaxChunkValueBytes;
+
+constexpr uint32_t chunk_count_for(uint32_t bytes) { return bytes == 0 ? 0u : 1u + (bytes - 1u) / kMaxChunkValueBytes; }
+
+constexpr uint32_t chunk_aligned_value_bytes(uint32_t bytes) { return chunk_count_for(bytes) * kMaxChunkValueBytes; }
+
+constexpr uint32_t floor_power_of_two(uint32_t value) {
+    uint32_t power = 1;
+    while (power <= value / 2u) {
+        power <<= 1;
+    }
+    return power;
+}
+
+constexpr uint32_t ceil_power_of_two(uint32_t value) {
+    uint32_t power = 1;
+    while (power < value) {
+        power <<= 1;
+    }
+    return power;
+}
+
+constexpr uint32_t buddy_order_for_value_bytes(uint32_t bytes) {
+    uint32_t units = ceil_power_of_two(chunk_count_for(bytes));
+    uint32_t order = 0;
+    while (units > 1) {
+        units >>= 1;
+        ++order;
+    }
+    return order;
+}
+
+constexpr uint32_t kMaxBuddyBlockUnits = floor_power_of_two(UINT32_MAX / kMaxChunkValueBytes);
+constexpr uint32_t kMaxBuddyValueBytes = kMaxBuddyBlockUnits * kMaxChunkValueBytes;
+
+constexpr uint32_t buddy_block_units_for(uint32_t bytes) { return ceil_power_of_two(chunk_count_for(bytes)); }
+
+constexpr uint32_t normalize_value_heap_bytes(uint32_t requested_bytes, uint32_t max_value_bytes) {
+    const uint32_t rounded_request = (requested_bytes / kMaxChunkValueBytes) * kMaxChunkValueBytes;
+    const uint32_t minimum = buddy_block_units_for(max_value_bytes) * kMaxChunkValueBytes;
+    return rounded_request < minimum ? minimum : rounded_request;
+}
+
+static_assert(chunk_count_for(kMaxChunkValueBytes + 1u) == 2u);
+static_assert(chunk_aligned_value_bytes(kMaxChunkAlignedValueBytes) == kMaxChunkAlignedValueBytes);
+static_assert(
+    normalize_value_heap_bytes(kMaxChunkValueBytes + 1u, kMaxChunkValueBytes + 1u) == 2u * kMaxChunkValueBytes);
+
+// GET response chunk count for a resolved cap. A helper (not a constant) since the cap is a runtime
+// value (KVM_COMMON_MAX_VALUE_BYTES); Server/Client compute it once from their resolved cap.
+constexpr uint32_t max_get_chunks_for(uint32_t cap) { return chunk_count_for(cap); }
+
+}  // namespace ttnn::operations::kvcache_manager::protocol
diff --git a/ttnn/cpp/ttnn/operations/kvcache_manager/common/server_descriptor.cpp b/ttnn/cpp/ttnn/operations/kvcache_manager/common/server_descriptor.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..a44e110febbc1265366a508ebef0adf1a7b67e8b
