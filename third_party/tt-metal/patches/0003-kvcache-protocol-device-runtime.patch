+            const bool is_put_publish = (op == kDirOpPutPublish);
+            const bool is_get = (op == static_cast<uint32_t>(OpCode::GET_CHUNK_REQ));
+            const bool is_remove = (op == static_cast<uint32_t>(OpCode::REMOVE));
+            const bool is_move_host = (op == static_cast<uint32_t>(OpCode::MOVE_TO_HOST));
+            const bool is_move_device = (op == static_cast<uint32_t>(OpCode::MOVE_TO_DEVICE));
+
+            KVM_ZONE_DIRECTORY_PUT_IF(
+                kvm_dir_put_allocate_service, "KVM-DIR-SERVICE-PUT-ALLOCATE", is_put_prepare && !is_put_bind);
+            KVM_ZONE_DIRECTORY_PUT_IF(kvm_dir_put_lease_bind_service, "KVM-DIR-SERVICE-PUT-LEASE-BIND", is_put_bind);
+            KVM_ZONE_DIRECTORY_PUT_IF(kvm_dir_put_publish_service, "KVM-DIR-SERVICE-PUT-PUBLISH", is_put_publish);
+            KVM_ZONE_DIRECTORY_GET_IF(kvm_dir_get_service, "KVM-DIR-SERVICE-GET", is_get);
+            KVM_ZONE_DIRECTORY_MOVE_IF(kvm_dir_move_host_service, "KVM-DIR-SERVICE-MOVE-TO-HOST", is_move_host);
