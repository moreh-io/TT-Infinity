+++ b/ttnn/cpp/ttnn/operations/kvcache_manager/common/server_descriptor.cpp
@@ -0,0 +1,85 @@
+// SPDX-FileCopyrightText: (c) 2026 Moreh
+//
+// SPDX-License-Identifier: Apache-2.0
+
+#include "ttnn/operations/kvcache_manager/common/server_descriptor.hpp"
+
+#include <cstdint>
+#include <limits>
+
+#include <tt_stl/assert.hpp>
+
+#include "ttnn/operations/kvcache_manager/common/protocol/layout.hpp"
+
+namespace ttnn::operations::kvcache_manager {
+
+void validate_server_descriptor(const ServerDescriptor& descriptor) {
+    constexpr uint64_t kRingRoundTo =
+        (protocol::kMaxClients % 2 == 0) ? protocol::kMaxClients : 2 * protocol::kMaxClients;
+    constexpr uint64_t kServerRingMin = 2 * protocol::kMaxClients;
+    constexpr uint32_t kMaxNocCoordinate = (1U << 6) - 1;
+
+    TT_FATAL(
+        descriptor.wire_layout_version == protocol::kWireLayoutVersion,
+        "server wire ABI version {} != client {}",
+        descriptor.wire_layout_version,
+        protocol::kWireLayoutVersion);
+    TT_FATAL(
+        descriptor.max_clients == protocol::kMaxClients,
+        "server kMaxClients {} != client {} -- ring partitions would interleave",
+        descriptor.max_clients,
+        protocol::kMaxClients);
+    TT_FATAL(
+        descriptor.ring_slots >= kServerRingMin && descriptor.ring_slots % kRingRoundTo == 0,
+        "ServerDescriptor ring_slots {} must be at least {} and a multiple of {}",
+        descriptor.ring_slots,
+        kServerRingMin,
+        kRingRoundTo);
+    TT_FATAL(
+        protocol::server_pipeline_end(descriptor.ring_slots) <= protocol::kServerL1ReserveMaxBytes,
+        "ServerDescriptor ring_slots {} exceeds the server L1 reserve ceiling",
+        descriptor.ring_slots);
+    TT_FATAL(descriptor.l1_base != 0, "ServerDescriptor l1_base must be nonzero");
+    TT_FATAL(descriptor.l1_base % 32 == 0, "ServerDescriptor l1_base {} must be 32-byte aligned", descriptor.l1_base);
+    TT_FATAL(
+        static_cast<uint64_t>(descriptor.l1_base) + protocol::server_pipeline_end(descriptor.ring_slots) <=
+            std::numeric_limits<uint32_t>::max(),
+        "ServerDescriptor L1 range [base={}, size={}] exceeds the 32-bit device address space",
+        descriptor.l1_base,
+        protocol::server_pipeline_end(descriptor.ring_slots));
+    TT_FATAL(
+        descriptor.noc_x <= kMaxNocCoordinate && descriptor.noc_y <= kMaxNocCoordinate,
+        "ServerDescriptor NoC coordinate ({}, {}) exceeds the 6-bit Wormhole encoding",
+        descriptor.noc_x,
+        descriptor.noc_y);
+    TT_FATAL(
+        descriptor.value_ring_depth >= protocol::kClientPutValueRingDepthMin,
+        "ServerDescriptor value_ring_depth {} is below the PUT pipeline minimum {}",
+        descriptor.value_ring_depth,
+        protocol::kClientPutValueRingDepthMin);
+    TT_FATAL(
+        protocol::client_l1_reserve_bytes(descriptor.value_ring_depth) <= std::numeric_limits<uint32_t>::max(),
+        "ServerDescriptor value_ring_depth {} exceeds the 32-bit client L1 offset limit",
+        descriptor.value_ring_depth);
+    TT_FATAL(
+        descriptor.max_value_bytes >= protocol::kMaxChunkValueBytes &&
+            descriptor.max_value_bytes <= protocol::kMaxBuddyValueBytes,
+        "ServerDescriptor max_value_bytes {} is outside the supported range [{}, {}]",
+        descriptor.max_value_bytes,
+        protocol::kMaxChunkValueBytes,
+        protocol::kMaxBuddyValueBytes);
+    TT_FATAL(
+        descriptor.max_key_bytes > 0 && descriptor.max_key_bytes <= protocol::kMaxPutKeyBytes,
+        "ServerDescriptor max_key_bytes {} is outside the supported range [1, {}]",
+        descriptor.max_key_bytes,
+        protocol::kMaxPutKeyBytes);
+    TT_FATAL(descriptor.reserved == 0, "ServerDescriptor reserved field must be zero, got {}", descriptor.reserved);
+    TT_FATAL(
+        descriptor.num_dram_channels > 0 && descriptor.dram_grid_x > 0 && descriptor.dram_grid_y > 0,
+        "ServerDescriptor DRAM geometry is empty (channels={}, grid={}x{})",
+        descriptor.num_dram_channels,
+        descriptor.dram_grid_x,
+        descriptor.dram_grid_y);
+}
+
+}  // namespace ttnn::operations::kvcache_manager
