diff --git a/tests/ttnn/unit_tests/gtests/test_kvcache_manager_return_route.cpp b/tests/ttnn/unit_tests/gtests/test_kvcache_manager_return_route.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..50d4ad000d414a0010e0a29edbee87407e82f89e
--- /dev/null
+++ b/tests/ttnn/unit_tests/gtests/test_kvcache_manager_return_route.cpp
@@ -0,0 +1,101 @@
+// SPDX-FileCopyrightText: (c) 2026 Moreh
+//
+// SPDX-License-Identifier: Apache-2.0
+//
+// Pins the 32-bit static inter-mesh return-route word layout. The Galaxy client PACKS the word with
+// protocol::pack_return_route (bootstrap.hpp) and the T3K Server kernel UNPACKS it in
+// fabric_set_static_intermesh_response_route_2d_galaxy (tt_fabric_api.h). tt_fabric_api.h lives in
+// tt_metal and cannot include this ttnn header, so it re-derives the bit positions by hand; these
+// tests fail if either side's layout drifts.
+
+#include <gtest/gtest.h>
+#include <cstdint>
+#include <initializer_list>
+
+#include "ttnn/operations/kvcache_manager/common/protocol/bootstrap.hpp"
+
+namespace ttnn::operations::kvcache_manager::protocol {
+namespace {
+
+// The exact shifts/masks the DEVICE side (tt_fabric_api.h
+// fabric_set_static_intermesh_response_route_2d_galaxy) hard-codes. Kept here as literals on purpose:
+// if pack_return_route's field positions change, the round-trip below breaks against these, which is
+// the drift we want to catch.
+constexpr uint32_t kValidBit = 1u << 31;
+uint32_t dev_valid(uint32_t w) { return w & kValidBit; }
+uint32_t dev_dst_chip(uint32_t w) { return w & 0x1Fu; }
+uint32_t dev_dst_mesh(uint32_t w) { return (w >> 5) & 0xFFFFu; }
+uint32_t dev_ns_hops(uint32_t w) { return (w >> 21) & 0xFu; }
+uint32_t dev_ew_hops(uint32_t w) { return (w >> 25) & 0xFu; }
+uint32_t dev_ns_dir(uint32_t w) { return (w >> 29) & 1u; }
+uint32_t dev_ew_dir(uint32_t w) { return (w >> 30) & 1u; }
+
+TEST(KvCacheManagerReturnRoute, ValidBitMatchesDevice) {
+    EXPECT_EQ(kReturnRouteValidBit, kValidBit);
+    // A packed word always carries the valid bit; a raw legacy word (mesh<<16 | chip) must not.
+    EXPECT_NE(pack_return_route(3, 0, 2, 1, 0, 1) & kReturnRouteValidBit, 0u);
+    const uint32_t legacy = (5u << 16) | 7u;  // fabric_helpers.hpp kvcache_unicast_route_word (2D)
+    EXPECT_EQ(legacy & kReturnRouteValidBit, 0u);
+    EXPECT_FALSE(return_route_valid(legacy));
+}
+
+TEST(KvCacheManagerReturnRoute, HostAccessorsRoundTrip) {
+    for (uint32_t chip : {0u, 1u, 5u, 24u, 31u}) {
+        for (uint32_t mesh : {0u, 1u, 15u, 65535u}) {
+            for (uint32_t ns : {0u, 1u, 7u, 15u}) {
+                for (uint32_t ew : {0u, 1u, 7u, 15u}) {
+                    for (uint32_t nd : {0u, 1u}) {
+                        for (uint32_t ed : {0u, 1u}) {
+                            const uint32_t w = pack_return_route(chip, mesh, ns, ew, nd, ed);
+                            EXPECT_TRUE(return_route_valid(w));
+                            EXPECT_EQ(return_route_dst_chip(w), chip);
+                            EXPECT_EQ(return_route_dst_mesh(w), mesh);
+                            EXPECT_EQ(return_route_ns_hops(w), ns);
+                            EXPECT_EQ(return_route_ew_hops(w), ew);
+                            EXPECT_EQ(return_route_ns_direction(w), nd);
+                            EXPECT_EQ(return_route_ew_direction(w), ed);
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
+
+TEST(KvCacheManagerReturnRoute, HostPackMatchesDeviceUnpack) {
+    // Every field the T3K kernel decodes must equal what the Galaxy host packed. A WEST route
+    // (ew_dir=0) is included because the device branch logic depends on ew_dir.
+    struct Case {
+        uint32_t chip, mesh, ns, ew, nd, ed;
+    };
+    for (const Case c : {
+             Case{24, 0, 0, 0, 0, 0},       // gateway == client (0-hop, current 1x8 config)
+             Case{0, 0, 0, 3, 0, 0},        // EW WEST only (far placement: gateway east of client)
+             Case{3, 0, 2, 4, 1, 1},        // NS south + EW east
+             Case{7, 1, 5, 2, 0, 0},        // NS north + EW west
+             Case{31, 65535, 15, 15, 1, 1}  // all fields max
+         }) {
+        const uint32_t w = pack_return_route(c.chip, c.mesh, c.ns, c.ew, c.nd, c.ed);
+        EXPECT_NE(dev_valid(w), 0u);
+        EXPECT_EQ(dev_dst_chip(w), c.chip);
+        EXPECT_EQ(dev_dst_mesh(w), c.mesh);
+        EXPECT_EQ(dev_ns_hops(w), c.ns);
+        EXPECT_EQ(dev_ew_hops(w), c.ew);
+        EXPECT_EQ(dev_ns_dir(w), c.nd);
+        EXPECT_EQ(dev_ew_dir(w), c.ed);
+    }
+}
+
+TEST(KvCacheManagerReturnRoute, FieldsDoNotOverlap) {
+    // Flipping one field must leave the others (and the valid bit) untouched.
+    const uint32_t base = pack_return_route(0, 0, 0, 0, 0, 0);
+    EXPECT_EQ(return_route_dst_chip(pack_return_route(31, 0, 0, 0, 0, 0)), 31u);
+    EXPECT_EQ(return_route_dst_mesh(pack_return_route(31, 0, 0, 0, 0, 0)), 0u);
+    EXPECT_EQ(return_route_ns_hops(pack_return_route(0, 65535, 0, 0, 0, 0)), 0u);
+    EXPECT_EQ(return_route_ew_direction(pack_return_route(31, 65535, 15, 15, 1, 0)), 0u);
+    EXPECT_EQ(return_route_ns_direction(pack_return_route(31, 65535, 15, 15, 0, 1)), 0u);
+    EXPECT_NE(base & kReturnRouteValidBit, 0u);
+}
+
+}  // namespace
+}  // namespace ttnn::operations::kvcache_manager::protocol
