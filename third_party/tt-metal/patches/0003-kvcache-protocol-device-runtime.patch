+++ b/ttnn/cpp/ttnn/operations/kvcache_manager/client/device/kernels/dataflow/establish_kernel.cpp
@@ -0,0 +1,95 @@
+// SPDX-FileCopyrightText: (c) 2026 Moreh
+//
+// SPDX-License-Identifier: Apache-2.0
+//
+// Establish one KV cache session through the fixed Fabric bootstrap mailbox.
+
+#include <cstdint>
+
+#include "api/dataflow/dataflow_api.h"
+#include "tt_metal/fabric/fabric_edm_packet_header.hpp"
+#include "tt_metal/fabric/hw/inc/edm_fabric/edm_fabric_worker_adapters.hpp"
+#include "tt_metal/fabric/hw/inc/packet_header_pool.h"
+
+#include "ttnn/cpp/ttnn/operations/kvcache_manager/common/kvm_fabric_route.hpp"
+#include "ttnn/cpp/ttnn/operations/kvcache_manager/common/protocol/bootstrap.hpp"
+#include "ttnn/cpp/ttnn/operations/kvcache_manager/common/protocol/layout.hpp"
+#include "ttnn/cpp/ttnn/operations/kvcache_manager/common/protocol/packet.hpp"
+
+using namespace ttnn::operations::kvcache_manager::protocol;
+
+void kernel_main() {
+    size_t rt_arg_idx = 0;
+    const uint32_t tx_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t response_sem_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t server_bootstrap_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t server_noc_x = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t server_noc_y = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t route_word = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t client_chip_id = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t timeout_cycles_low = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t timeout_cycles_high = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint64_t timeout_cycles =
+        static_cast<uint64_t>(timeout_cycles_low) | (static_cast<uint64_t>(timeout_cycles_high) << 32);
+    const bool initialize_session_state = get_arg_val<uint32_t>(rt_arg_idx++) != 0;
+
+    volatile tt_l1_ptr EstablishRequest* request = reinterpret_cast<volatile tt_l1_ptr EstablishRequest*>(tx_addr);
+    volatile tt_l1_ptr uint32_t* request_words = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(request);
+    for (uint32_t word = 0; word < sizeof(EstablishRequest) / sizeof(uint32_t); ++word) {
+        request_words[word] = get_arg_val<uint32_t>(rt_arg_idx++);
+    }
+
+    auto connection = tt::tt_fabric::WorkerToFabricEdmSender::build_from_args<ProgrammableCoreType::TENSIX>(rt_arg_idx);
+    volatile tt_l1_ptr uint32_t* response_sem = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(response_sem_addr);
+    response_sem[0] = 0;
+    response_sem[1] = static_cast<uint32_t>(EstablishClientStatus::Pending);
+
+    if (initialize_session_state) {
+        // A retry must preserve state published by a Server that accepted the first request.
+        volatile tt_l1_ptr uint32_t* put_session =
+            reinterpret_cast<volatile tt_l1_ptr uint32_t*>(request->client_l1_base + kClientPutSessionConfigOffset);
+        for (uint32_t w = 0; w < (sizeof(PutSessionConfig) + sizeof(PutLeaseDescriptor)) / sizeof(uint32_t); ++w) {
+            put_session[w] = 0;
+        }
+        noc_inline_dw_write(
+            get_noc_addr(my_x[noc_index], my_y[noc_index], request->client_l1_base + kClientScalarGetCompletionOffset),
+            0);
+        noc_async_write_barrier();
+    }
+
+    volatile tt_l1_ptr PACKET_HEADER_TYPE* packet_header = PacketHeaderPool::allocate_header();
+    connection.open<true>();
+
+    const uint64_t request_noc =
+        get_noc_addr(server_noc_x, server_noc_y, server_bootstrap_addr + client_chip_id * kBootstrapRequestSlotStride);
+    const uint64_t request_sem_noc = get_noc_addr(
+        server_noc_x,
+        server_noc_y,
+        server_bootstrap_addr + (kBootstrapRequestSemBaseOffset - kBootstrapRequestBaseOffset) +
+            client_chip_id * kBootstrapRequestSemSize);
+    set_unicast_route(packet_header, route_word);
+    packet_header->to_noc_fused_unicast_write_atomic_inc(
+        tt::tt_fabric::NocUnicastAtomicIncFusedCommandHeader{request_noc, request_sem_noc, 1, /*flush=*/true},
+        sizeof(EstablishRequest));
+    connection.wait_for_empty_write_slot();
+    connection.send_payload_without_header_non_blocking_from_address(tx_addr, sizeof(EstablishRequest));
+    connection.send_payload_blocking_from_address(
+        reinterpret_cast<uint32_t>(packet_header), sizeof(PACKET_HEADER_TYPE));
+    connection.close();
+
+    const uint64_t start_cycles = get_timestamp();
+    bool acked = false;
+    while (true) {
+        invalidate_l1_cache();
+        if (response_sem[0] >= 1) {
+            acked = true;
+            break;
+        }
+        if (get_timestamp() - start_cycles >= timeout_cycles) {
+            break;
+        }
+    }
+
+    response_sem[0] = 0;
+    response_sem[1] = static_cast<uint32_t>(acked ? EstablishClientStatus::Responded : EstablishClientStatus::TimedOut);
+}
diff --git a/ttnn/cpp/ttnn/operations/kvcache_manager/client/device/kernels/dataflow/get_ingress_ack_kernel.cpp b/ttnn/cpp/ttnn/operations/kvcache_manager/client/device/kernels/dataflow/get_ingress_ack_kernel.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..6870b3f4538515cc0a756015e847494532129ab7
--- /dev/null
+++ b/ttnn/cpp/ttnn/operations/kvcache_manager/client/device/kernels/dataflow/get_ingress_ack_kernel.cpp
@@ -0,0 +1,55 @@
+// SPDX-FileCopyrightText: (c) 2026 Moreh
+//
+// SPDX-License-Identifier: Apache-2.0
+//
+// Scalar GET ingress ACK kernel (RISCV_1 / NOC1). The host has already posted the request to a
+// Fabric-free server ingress worker. This kernel opens the reverse Fabric channel in parallel,
+// waits for the server's cumulative client-L1 completion, then returns its encoded status to the
+// server BRISC. The BRISC publishes the mapped-host completion observed by the GET operation.
+
+#include <cstdint>
+
+#include "ttnn/cpp/ttnn/operations/kvcache_manager/client/device/kernels/dataflow/client_kernel_common.hpp"
+
+using namespace ttnn::operations::kvcache_manager::protocol;
+
+void kernel_main() {
+    size_t rt_arg_idx = 0;
+    const uint32_t client_l1_base = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t server_l1_base = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t server_noc_x = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t server_noc_y = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t route_word = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t completion_baseline = get_arg_val<uint32_t>(rt_arg_idx++);
+
+    auto connection = tt::tt_fabric::WorkerToFabricEdmSender::build_from_args<ProgrammableCoreType::TENSIX>(rt_arg_idx);
+    volatile tt_l1_ptr PACKET_HEADER_TYPE* packet_header_addr = PacketHeaderPool::allocate_header();
+
+    DeviceZoneScopedN("KVM-GET");
+    {
+        KVM_ZONE_CLIENT_GET("KVM-GET-REQUEST-SEND");
+        connection.open<true>();
+    }
+
+    volatile tt_l1_ptr uint32_t* completion_ptr =
+        reinterpret_cast<volatile tt_l1_ptr uint32_t*>(client_l1_base + kClientScalarGetCompletionOffset);
+    uint32_t raw_status = 0;
+    {
+        KVM_ZONE_CLIENT_GET("KVM-GET-WAIT");
+        do {
+            invalidate_l1_cache();
+            raw_status = *completion_ptr - completion_baseline;
+        } while (raw_status == 0);
+        ASSERT(raw_status == 1u || raw_status == 2u || raw_status == 4u);
+    }
+
+    set_unicast_route(packet_header_addr, route_word);
+    packet_header_addr->to_noc_unicast_atomic_inc(tt::tt_fabric::NocUnicastAtomicIncCommandHeader{
+        get_noc_addr(server_noc_x, server_noc_y, server_l1_base + kHostAnyGetDoneMonitorOffset),
+        raw_status,
+        /*flush=*/true});
+    connection.wait_for_empty_write_slot();
+    connection.send_payload_flush_blocking_from_address(
+        reinterpret_cast<uint32_t>(packet_header_addr), sizeof(PACKET_HEADER_TYPE));
+    connection.close();
+}
diff --git a/ttnn/cpp/ttnn/operations/kvcache_manager/client/device/kernels/dataflow/get_receiver_kernel.cpp b/ttnn/cpp/ttnn/operations/kvcache_manager/client/device/kernels/dataflow/get_receiver_kernel.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..5df2fe362077b7f6ab4969901b61d81dbf70899f
--- /dev/null
+++ b/ttnn/cpp/ttnn/operations/kvcache_manager/client/device/kernels/dataflow/get_receiver_kernel.cpp
@@ -0,0 +1,140 @@
+// SPDX-FileCopyrightText: (c) 2026 Moreh
+//
+// SPDX-License-Identifier: Apache-2.0
+//
+// kvcache_manager Client GET kernel (RISCV_1 / NOC1) — fabric-direct-to-DRAM GET.
+//
+// The server fabric-writes each value chunk straight into the client's output-tensor DRAM,
+// so there is no client recv-ring, writeback kernel, or credit loop. This kernel only:
+//   1. builds + sends the single chunk-0 GET_CHUNK_REQ (carrying the output tensor's DRAM
+//      base, page size, packed capacity, and the key);
+//   2. waits on recv_sem for the server's completion inc (status_flags + 1);
+//   3. records the status flags into the host-CQ-read status word.
+// Extras after the base args: stream_id_seq, key_len, key_words[32] (128 B fixed), and
+// status_buf_addr (the dedicated L1 word the host CQ-reads), then mapped_completion_enabled.
+// See ttnn/cpp/ttnn/operations/kvcache_manager/docs/design.md §6 and
+// client_kernel_common.hpp.
+
+#include "ttnn/cpp/ttnn/operations/kvcache_manager/client/device/kernels/dataflow/client_kernel_common.hpp"
+
+using namespace ttnn::operations::kvcache_manager::protocol;
+using namespace ttnn::operations::kvcache_manager::client;
+// Under FABRIC_2D, kvm_fabric_route.hpp pulls in tt_fabric_api.h whose global
+// `using namespace tt::tt_fabric` makes the bare name PacketHeader ambiguous with
+// tt::tt_fabric::PacketHeader; the wire's 16 B app header is spelled through this
+// alias so both fabric modes compile from one source.
+namespace protocol = ttnn::operations::kvcache_manager::protocol;
+
+void kernel_main() {
+    size_t rt_arg_idx = 0;
+    ClientBaseArgs base = parse_base_args(rt_arg_idx);
+    const uint32_t client_l1_base = base.client_l1_base;
+    const uint32_t server_l1_base = base.server_l1_base;
+    const uint32_t server_noc_x = base.server_noc_x;
+    const uint32_t server_noc_y = base.server_noc_y;
+    const uint32_t base_ring_slot_idx = base.base_ring_slot_idx;
+    const uint32_t payload_size = base.payload_size;  // sizeof(GetChunkReqHeader) + key_len
+    const uint32_t route_word = base.route_word;
+    // Output tensor DRAM layout and packed capacity. The server validates capacity before it
+    // fabric-writes value chunks directly into the tensor.
+    const uint32_t client_dram_addr = base.client_dram_addr;
+    const uint32_t logical_page_size = base.logical_page_size;
+    const uint32_t output_capacity_bytes = base.total_value_len;
+
+    // GET chunk-0 request extras; consume before build_from_args (ABI order).
+    const uint32_t get_stream_id_seq = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t get_key_len = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t get_key_words[32] = {0};
+    for (uint32_t w = 0; w < 32; ++w) {
+        get_key_words[w] = get_arg_val<uint32_t>(rt_arg_idx++);
+    }
+    const uint32_t get_status_buf_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t mapped_completion_enabled = get_arg_val<uint32_t>(rt_arg_idx++);
+
+    auto connection = tt::tt_fabric::WorkerToFabricEdmSender::build_from_args<ProgrammableCoreType::TENSIX>(rt_arg_idx);
+    volatile tt_l1_ptr PACKET_HEADER_TYPE* packet_header_addr = PacketHeaderPool::allocate_header();
+    connection.open<true>();
+
+    const uint32_t tx_staging_addr = client_l1_base + kClientTxStagingOffset;
+
+    DeviceZoneScopedN("KVM-GET");  // op-named op-wall zone; the standalone bench reads it by name
+
+    // The Server publishes status_flags + 1 only after output writes are durable. Initialize through
+    // NoC so the completion atomic observes a cross-RISC-visible zero baseline.
+    const uint64_t recv_sem_noc = get_noc_addr(my_x[noc_index], my_y[noc_index], client_l1_base + kClientRecvSemOffset);
+    noc_inline_dw_write(recv_sem_noc, 0);
+    noc_async_write_barrier();
+
+    volatile tt_l1_ptr uint32_t* recv_sem_ptr =
+        reinterpret_cast<volatile tt_l1_ptr uint32_t*>(client_l1_base + kClientRecvSemOffset);
+
+    {
+        volatile tt_l1_ptr protocol::PacketHeader* ph =
+            reinterpret_cast<volatile tt_l1_ptr protocol::PacketHeader*>(tx_staging_addr);
+        ph->opcode = static_cast<uint32_t>(OpCode::GET_CHUNK_REQ);
+        ph->seq = get_stream_id_seq;
+        ph->payload_size = payload_size;  // sizeof(GetChunkReqHeader) + key_len
+        ph->client_token = base.client_token;
+
+        volatile tt_l1_ptr GetChunkReqHeader* req =
+            reinterpret_cast<volatile tt_l1_ptr GetChunkReqHeader*>(tx_staging_addr + sizeof(protocol::PacketHeader));
+        req->stream_id_seq = get_stream_id_seq;
+        req->req_chunk_idx = 0;
+        req->key_len = get_key_len;
+        // Server builds an InterleavedAddrGen from these to fabric-write each chunk into the
+        // client output tensor DRAM.
+        req->client_dram_base = client_dram_addr;
+        req->logical_page_size = logical_page_size;
+        req->output_capacity_bytes = output_capacity_bytes;
+        req->completion_l1_addr = 0;
+        req->completion_mode = 0;
+
+        // The RT-arg span is fixed; the wire transmits only key_len bytes.
+        volatile tt_l1_ptr uint32_t* key_dst = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(
+            tx_staging_addr + sizeof(protocol::PacketHeader) + sizeof(GetChunkReqHeader));
+        for (uint32_t w = 0; w < 32; ++w) {
+            key_dst[w] = get_key_words[w];
+        }
+    }
+
+    {
+        KVM_ZONE_CLIENT_GET("KVM-GET-REQUEST-SEND");
+        const uint32_t total = (sizeof(protocol::PacketHeader) + payload_size + 15) & ~15u;
+        const uint32_t slot = (base_ring_slot_idx + 0) % kRingNumSlots;
+        send_slot_packet(
+            connection,
+            packet_header_addr,
+            route_word,
+            server_noc_x,
+            server_noc_y,
+            server_l1_base,
+            slot,
+            tx_staging_addr,
+            total);
+    }
+
+    uint32_t completion = 0;
+    {
+        KVM_ZONE_CLIENT_GET("KVM-GET-WAIT");
+        noc_semaphore_wait_min(recv_sem_ptr, 1);
+        invalidate_l1_cache();
+        completion = *recv_sem_ptr;
+        volatile tt_l1_ptr uint32_t* status_word = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(get_status_buf_addr);
+        *status_word = completion - 1u;
+    }
+
+    if (mapped_completion_enabled != 0) {
+        // Route already stamped by send_slot_packet above; re-set for clarity (the to_noc_*
+        // command setters never touch the route fields).
+        set_unicast_route(packet_header_addr, route_word);
+        packet_header_addr->to_noc_unicast_atomic_inc(tt::tt_fabric::NocUnicastAtomicIncCommandHeader{
+            get_noc_addr(server_noc_x, server_noc_y, server_l1_base + kHostAnyGetDoneMonitorOffset),
+            completion,
+            /*flush=*/true});
+        connection.wait_for_empty_write_slot();
+        connection.send_payload_flush_blocking_from_address(
+            reinterpret_cast<uint32_t>(packet_header_addr), sizeof(PACKET_HEADER_TYPE));
+    }
+
+    connection.close();
+}
diff --git a/ttnn/cpp/ttnn/operations/kvcache_manager/client/device/kernels/dataflow/ping_kernel.cpp b/ttnn/cpp/ttnn/operations/kvcache_manager/client/device/kernels/dataflow/ping_kernel.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e2bc133b0890b85e7bfb3fbabdfdb2a9c46f220c
--- /dev/null
+++ b/ttnn/cpp/ttnn/operations/kvcache_manager/client/device/kernels/dataflow/ping_kernel.cpp
@@ -0,0 +1,75 @@
+// SPDX-FileCopyrightText: (c) 2026 Moreh
+//
+// SPDX-License-Identifier: Apache-2.0
+//
+// kvcache_manager Client PING kernel — single-packet echo. Sends one PING packet (variable
+// payload <= kMaxPingPayloadBytes) to the server's ring slot and waits on the client recv
+// sem. Built in-kernel from RT args. Extras after the base args: req_seq, then a fixed
+// kMaxPingPayloadBytes/4-word span so the host can reuse one workload across payload sizes.
+// See ttnn/cpp/ttnn/operations/kvcache_manager/docs/design.md §6 and client_kernel_common.hpp.
+
+#include "ttnn/cpp/ttnn/operations/kvcache_manager/client/device/kernels/dataflow/client_kernel_common.hpp"
+
+using namespace ttnn::operations::kvcache_manager::protocol;
+using namespace ttnn::operations::kvcache_manager::client;
+// Under FABRIC_2D, kvm_fabric_route.hpp pulls in tt_fabric_api.h whose global
+// `using namespace tt::tt_fabric` makes the bare name PacketHeader ambiguous with
+// tt::tt_fabric::PacketHeader; the wire's 16 B app header is spelled through this
+// alias so both fabric modes compile from one source.
+namespace protocol = ttnn::operations::kvcache_manager::protocol;
+
+void kernel_main() {
+    size_t rt_arg_idx = 0;
+    ClientBaseArgs base = parse_base_args(rt_arg_idx);
+
+    // Stage the live payload straight into tx_staging, then skip the zero-padded remainder of the
+    // fixed RT-arg span before parsing the fabric args.
+    const uint32_t req_seq = get_arg_val<uint32_t>(rt_arg_idx++);
+    {
+        constexpr uint32_t payload_rt_arg_words = kMaxPingPayloadBytes / sizeof(uint32_t);
+        const uint32_t n_words = (base.payload_size + 3) / 4;
+        volatile tt_l1_ptr uint32_t* ping_payload_dst = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(
+            base.client_l1_base + kClientTxStagingOffset + sizeof(protocol::PacketHeader));
+        for (uint32_t w = 0; w < n_words; ++w) {
+            ping_payload_dst[w] = get_arg_val<uint32_t>(rt_arg_idx++);
+        }
+        rt_arg_idx += payload_rt_arg_words - n_words;
+    }
+
+    auto connection = tt::tt_fabric::WorkerToFabricEdmSender::build_from_args<ProgrammableCoreType::TENSIX>(rt_arg_idx);
+    volatile tt_l1_ptr PACKET_HEADER_TYPE* packet_header_addr = PacketHeaderPool::allocate_header();
+    connection.open<true>();
+
+    // The op-wall contract starts after connection open and includes request construction,
+    // send/close, and completion observation.
+    DeviceZoneScopedN("KVM-PING");
+
+    const uint32_t tx_staging_addr = base.client_l1_base + kClientTxStagingOffset;
+
+    // Zero the recv-sem baseline: the server's echo inc only lands after this send, so a
+    // same-RISC plain store here is ordered first.
+    volatile tt_l1_ptr uint32_t* recv_sem_ptr =
+        reinterpret_cast<volatile tt_l1_ptr uint32_t*>(base.client_l1_base + kClientRecvSemOffset);
+    *recv_sem_ptr = 0;
+
+    volatile tt_l1_ptr protocol::PacketHeader* ph =
+        reinterpret_cast<volatile tt_l1_ptr protocol::PacketHeader*>(tx_staging_addr);
+    ph->opcode = static_cast<uint32_t>(OpCode::PING);
+    ph->seq = req_seq;
+    ph->payload_size = base.payload_size;
+    ph->client_token = base.client_token;
+    // Payload was staged into tx_staging during RT-arg parsing, outside the op-wall contract.
+
+    const uint32_t total = (sizeof(protocol::PacketHeader) + base.payload_size + 15) & ~15u;
+    send_single_and_wait(
+        connection,
+        packet_header_addr,
+        base.route_word,
+        base.server_noc_x,
+        base.server_noc_y,
+        base.server_l1_base,
+        base.base_ring_slot_idx,
+        tx_staging_addr,
+        total,
+        base.client_l1_base + kClientRecvSemOffset);
+}
diff --git a/ttnn/cpp/ttnn/operations/kvcache_manager/client/device/kernels/dataflow/put_batch_reader_kernel.cpp b/ttnn/cpp/ttnn/operations/kvcache_manager/client/device/kernels/dataflow/put_batch_reader_kernel.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..54789d55192770777c821fb27acc167ed93da252
--- /dev/null
+++ b/ttnn/cpp/ttnn/operations/kvcache_manager/client/device/kernels/dataflow/put_batch_reader_kernel.cpp
@@ -0,0 +1,101 @@
+// SPDX-FileCopyrightText: (c) 2026 Moreh
+//
+// SPDX-License-Identifier: Apache-2.0
+
+// Bounded PUT-batch reader (RISCV_0 / NOC0). All item descriptors are uploaded before launch;
+// produced/consumed are cumulative across item boundaries so the two RISCs never race on a reset.
+
+#include <cstdint>
+
+#include "api/dataflow/dataflow_api.h"
+
+#include "ttnn/cpp/ttnn/operations/kvcache_manager/common/protocol/layout.hpp"
+#include "ttnn/cpp/ttnn/operations/kvcache_manager/common/protocol/packet.hpp"
+
+using namespace ttnn::operations::kvcache_manager::protocol;
+
+constexpr uint32_t kReaderPrefetchDepth = kPutReaderPrefetchDepth;
+
+void kernel_main() {
+    size_t rt_arg_idx = 0;
+    const uint32_t client_l1_base = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t descriptor_base = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t batch_count = get_arg_val<uint32_t>(rt_arg_idx++);
+
+    ASSERT(batch_count > 0);
+    ASSERT(batch_count <= kClientPutBatchMaxItems);
+
+    const uint32_t ring_base = client_l1_base + kClientPutValueRingBaseOffset;
+    const uint32_t value_sub_offset = sizeof(PacketHeader) + sizeof(ChunkedPayloadHeader);
+    volatile tt_l1_ptr uint32_t* consumed_sem =
+        reinterpret_cast<volatile tt_l1_ptr uint32_t*>(descriptor_base + kClientPutBatchConsumedSemOffset);
+    const uint64_t produced_sem_noc =
+        get_noc_addr(my_x[noc_index], my_y[noc_index], descriptor_base + kClientPutBatchProducedSemOffset);
+
+    invalidate_l1_cache();
+    reset_noc_trid_barrier_counter(NOC_CLEAR_OUTSTANDING_REQ_MASK, noc_index);
+
+    constexpr uint32_t P = kReaderPrefetchDepth;
+    uint32_t produced_count = 0;
+    for (uint32_t item = 0; item < batch_count; ++item) {
+        volatile tt_l1_ptr PutBatchItemDescriptor* descriptor =
+            reinterpret_cast<volatile tt_l1_ptr PutBatchItemDescriptor*>(
+                descriptor_base + kClientPutBatchItemsOffset + item * sizeof(PutBatchItemDescriptor));
+        const uint32_t num_chunks = descriptor->num_chunks;
+        const uint32_t total_value_len = descriptor->total_value_len;
+        const uint32_t client_dram_addr = descriptor->client_dram_addr;
+        const uint32_t logical_page_size = descriptor->logical_page_size;
+        ASSERT(num_chunks >= 2);
+        ASSERT(total_value_len > 0);
+        ASSERT(logical_page_size > 0);
+
+        const InterleavedAddrGen<true> dram_src{
+            .bank_base_address = client_dram_addr,
+            .page_size = logical_page_size,
+        };
+        const uint32_t value_chunks = num_chunks - 1;
+        const uint32_t item_ordinal_base = produced_count;
+
+        auto issue_read = [&](uint32_t value_chunk) {
+            const uint32_t ordinal = item_ordinal_base + value_chunk;
+            if (ordinal > kClientPutValueRingDepth) {
+                noc_semaphore_wait_min(consumed_sem, ordinal - kClientPutValueRingDepth);
+            }
+
+            const uint32_t entry = (ordinal - 1) % kClientPutValueRingDepth;
+            const uint32_t value_dst_l1 = ring_base + entry * kClientPutValueRingEntryStride + value_sub_offset;
+            const uint32_t stream_pos = (value_chunk - 1) * kMaxChunkValueBytes;
+            const uint32_t remaining = total_value_len - stream_pos;
+            const uint32_t chunk_data_len = remaining < kMaxChunkValueBytes ? remaining : kMaxChunkValueBytes;
+            noc_async_read_set_trid(ordinal % P);
+            uint32_t copied = 0;
+            while (copied < chunk_data_len) {
+                const uint32_t absolute_pos = stream_pos + copied;
+                const uint32_t page_idx = absolute_pos / logical_page_size;
+                const uint32_t in_page_offset = absolute_pos % logical_page_size;
+                const uint32_t page_remaining = logical_page_size - in_page_offset;
+                const uint32_t wanted = chunk_data_len - copied;
+                const uint32_t read_bytes = page_remaining < wanted ? page_remaining : wanted;
+                const uint64_t page_noc = get_noc_addr(page_idx, dram_src, in_page_offset);
+                noc_async_read(page_noc, value_dst_l1 + copied, read_bytes);
+                copied += read_bytes;
+            }
+        };
+
+        for (uint32_t value_chunk = 1; value_chunk <= value_chunks && value_chunk <= P; ++value_chunk) {
+            issue_read(value_chunk);
+        }
+        for (uint32_t value_chunk = 1; value_chunk <= value_chunks; ++value_chunk) {
+            const uint32_t ordinal = item_ordinal_base + value_chunk;
+            noc_async_read_barrier_with_trid(ordinal % P);
+            noc_semaphore_inc(produced_sem_noc, 1);
+            const uint32_t next = value_chunk + P;
+            if (next <= value_chunks) {
+                issue_read(next);
+            }
+        }
+        produced_count += value_chunks;
+    }
+
+    noc_async_atomic_barrier();
+}
diff --git a/ttnn/cpp/ttnn/operations/kvcache_manager/client/device/kernels/dataflow/put_batch_writer_kernel.cpp b/ttnn/cpp/ttnn/operations/kvcache_manager/client/device/kernels/dataflow/put_batch_writer_kernel.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..a6bedcc1988a6daa800eec314b58fd8625dd5958
--- /dev/null
+++ b/ttnn/cpp/ttnn/operations/kvcache_manager/client/device/kernels/dataflow/put_batch_writer_kernel.cpp
@@ -0,0 +1,262 @@
+// SPDX-FileCopyrightText: (c) 2026 Moreh
+//
+// SPDX-License-Identifier: Apache-2.0
+
+// Bounded PUT-batch writer (RISCV_1 / NOC1). The scalar server wire protocol is unchanged: one
+// Fabric session carries ordered PUTs, and each item reaches landed before the next chunk-0 request.
+
+#include "ttnn/cpp/ttnn/operations/kvcache_manager/client/device/kernels/dataflow/client_kernel_common.hpp"
+
+using namespace ttnn::operations::kvcache_manager::protocol;
+using namespace ttnn::operations::kvcache_manager::client;
+// Under FABRIC_2D, kvm_fabric_route.hpp pulls in tt_fabric_api.h whose global
+// `using namespace tt::tt_fabric` makes the bare name PacketHeader ambiguous with
+// tt::tt_fabric::PacketHeader; the wire's 16 B app header is spelled through this
+// alias so both fabric modes compile from one source.
+namespace protocol = ttnn::operations::kvcache_manager::protocol;
+
+namespace {
+
+constexpr uint32_t kWriterHeaderRingDepth = 4;
+
+FORCE_INLINE uint64_t server_dram_page_noc_addr(const InterleavedAddrGen<true>& d, uint32_t page_id, uint32_t offset) {
+    uint64_t noc_address = d.get_noc_addr(page_id, offset, tt::tt_fabric::edm_to_local_chip_noc);
+#if defined(ARCH_WORMHOLE)
+    auto components = get_noc_address_components(noc_address);
+    noc_address = safe_get_noc_addr(
+        components.first.x, components.first.y, components.second, tt::tt_fabric::edm_to_local_chip_noc);
+#endif
+    return noc_address;
+}
+
+}  // namespace
+
+void kernel_main() {
+    size_t rt_arg_idx = 0;
+    const ClientBaseArgs base = parse_base_args(rt_arg_idx);
+    const uint32_t base_seq = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t descriptor_base = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t batch_count = get_arg_val<uint32_t>(rt_arg_idx++);
+
+    ASSERT(batch_count > 0);
+    ASSERT(batch_count <= kClientPutBatchMaxItems);
+
+    auto connection = tt::tt_fabric::WorkerToFabricEdmSender::build_from_args<ProgrammableCoreType::TENSIX>(rt_arg_idx);
+    volatile tt_l1_ptr PACKET_HEADER_TYPE* packet_header_addr = PacketHeaderPool::allocate_header();
+    volatile tt_l1_ptr PACKET_HEADER_TYPE* direct_headers[kWriterHeaderRingDepth];
+    for (uint32_t header = 0; header < kWriterHeaderRingDepth; ++header) {
+        direct_headers[header] = PacketHeaderPool::allocate_header();
+    }
+    connection.open<true>();
+
+    // The destination is fixed for the whole batch: pre-set the route once on the direct-header
+    // ring and the shared header instead of per chunk (route decode costs tens of cycles on 2D;
+    // the to_noc_* command setters below never touch the route fields). send_slot_packet stamps
+    // packet_header_addr's route itself per call.
+    for (uint32_t header = 0; header < kWriterHeaderRingDepth; ++header) {
+        set_unicast_route(direct_headers[header], base.route_word);
+    }
+    set_unicast_route(packet_header_addr, base.route_word);
+
+    DeviceZoneScopedN("KVM-PUT-BATCH");
+
+    const uint32_t tx_staging_addr = base.client_l1_base + kClientTxStagingOffset;
+    const uint32_t direct_ring_base = base.client_l1_base + kClientPutValueRingBaseOffset;
+    const uint64_t consumed_sem_noc =
+        get_noc_addr(my_x[noc_index], my_y[noc_index], descriptor_base + kClientPutBatchConsumedSemOffset);
+    volatile tt_l1_ptr uint32_t* produced_sem =
+        reinterpret_cast<volatile tt_l1_ptr uint32_t*>(descriptor_base + kClientPutBatchProducedSemOffset);
+    volatile tt_l1_ptr uint32_t* recv_sem =
+        reinterpret_cast<volatile tt_l1_ptr uint32_t*>(base.client_l1_base + kClientRecvSemOffset);
+    const uint64_t recv_sem_noc =
+        get_noc_addr(my_x[noc_index], my_y[noc_index], base.client_l1_base + kClientRecvSemOffset);
+    noc_inline_dw_write(recv_sem_noc, 0);
+    noc_async_write_barrier();
+
+    volatile tt_l1_ptr PutSessionConfig* session =
+        reinterpret_cast<volatile tt_l1_ptr PutSessionConfig*>(base.client_l1_base + kClientPutSessionConfigOffset);
+    volatile tt_l1_ptr PutLeaseDescriptor* lease =
+        reinterpret_cast<volatile tt_l1_ptr PutLeaseDescriptor*>(base.client_l1_base + kClientPutLeaseDescriptorOffset);
+
+    static_assert(kPutConsumedAckBatch <= kClientPutValueRingDepth - kPutReaderPrefetchDepth);
+    static_assert(kPutConsumedAckBatch == kWriterHeaderRingDepth);
+
+    uint32_t recv_expected = 0;
+    uint32_t value_ordinal = 0;
+    for (uint32_t item = 0; item < batch_count; ++item) {
+        invalidate_l1_cache();
+        ASSERT(session->version == kPutSessionVersion);
+
+        volatile tt_l1_ptr PutBatchItemDescriptor* descriptor =
+            reinterpret_cast<volatile tt_l1_ptr PutBatchItemDescriptor*>(
+                descriptor_base + kClientPutBatchItemsOffset + item * sizeof(PutBatchItemDescriptor));
+        const uint32_t num_chunks = descriptor->num_chunks;
+        const uint32_t total_value_len = descriptor->total_value_len;
+        const uint32_t logical_page_size = descriptor->logical_page_size;
+        const uint32_t key_len = descriptor->key_len;
+        const uint32_t request_seq = base_seq + item;
+        ASSERT(num_chunks >= 2);
+        ASSERT(total_value_len > 0);
+        ASSERT(logical_page_size > 0);
+        ASSERT(key_len > 0);
+        ASSERT(key_len <= kMaxPutKeyBytes);
+        ASSERT(descriptor->rank <= kTensorShapeMaxRank);
+
+        const uint32_t required_order = buddy_order_for_value_bytes(total_value_len);
+        bool uses_lease = false;
+        uint32_t lease_generation = 0;
+        uint32_t direct_value_byte_off = 0;
+        if (lease->status == kPutLeaseReady && lease->buddy_order == required_order) {
+            lease_generation = lease->generation;
+            direct_value_byte_off = lease->value_byte_off;
+            ASSERT(lease_generation != 0);
+            ASSERT((direct_value_byte_off % kMaxChunkValueBytes) == 0);
+            uses_lease = true;
+        }
+
+        const uint32_t chunk0_payload = sizeof(ChunkedPayloadHeader) + sizeof(TensorMetadata) + key_len;
+        volatile tt_l1_ptr protocol::PacketHeader* packet =
+            reinterpret_cast<volatile tt_l1_ptr protocol::PacketHeader*>(tx_staging_addr);
+        packet->opcode = static_cast<uint32_t>(OpCode::PUT_CHUNK);
+        packet->seq = request_seq;
+        packet->payload_size = chunk0_payload;
+        packet->client_token = base.client_token;
+
+        volatile tt_l1_ptr ChunkedPayloadHeader* chunk = reinterpret_cast<volatile tt_l1_ptr ChunkedPayloadHeader*>(
+            tx_staging_addr + sizeof(protocol::PacketHeader));
+        chunk->stream_id_seq = request_seq;
+        chunk->chunk_idx = 0;
+        chunk->num_chunks = num_chunks;
+        chunk->total_value_len = total_value_len;
+        chunk->chunk_payload_len = key_len;
+        chunk->status_flags = uses_lease ? kPutStatusUsesLease : 0u;
+        chunk->tensor_slot_id = uses_lease ? lease_generation : 0u;
+        chunk->value_byte_off = uses_lease ? direct_value_byte_off : 0u;
+
+        volatile tt_l1_ptr TensorMetadata* metadata = reinterpret_cast<volatile tt_l1_ptr TensorMetadata*>(
+            tx_staging_addr + sizeof(protocol::PacketHeader) + sizeof(ChunkedPayloadHeader));
+        metadata->logical_page_size = logical_page_size;
+        metadata->num_pages = descriptor->num_pages;
+        metadata->dtype = descriptor->dtype;
+        metadata->layout = descriptor->layout;
+        metadata->rank = descriptor->rank;
+        for (uint32_t dim = 0; dim < kTensorShapeMaxRank; ++dim) {
+            metadata->shape[dim] = descriptor->shape[dim];
+        }
+
+        volatile tt_l1_ptr uint32_t* key_dst = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(
+            tx_staging_addr + sizeof(protocol::PacketHeader) + sizeof(ChunkedPayloadHeader) + sizeof(TensorMetadata));
+        for (uint32_t word = 0; word < 32; ++word) {
+            key_dst[word] = descriptor->key_words[word];
+        }
+
+        // base_ring_slot_idx is absolute (partition base + cursor); successive items wrap within
+        // this client's ring partition, never into a sibling client's slots (layout.hpp
+        // kRingSlotsPerClient; mirrors the host's RequestTransaction::base_ring_slot_at).
+        const uint32_t partition_base = (base.base_ring_slot_idx / kRingSlotsPerClient) * kRingSlotsPerClient;
+        const uint32_t partition_off = base.base_ring_slot_idx % kRingSlotsPerClient;
+        const uint32_t target_slot = partition_base + (partition_off + item) % kRingSlotsPerClient;
+        const uint32_t chunk0_total = (sizeof(protocol::PacketHeader) + chunk0_payload + 15) & ~15u;
+        send_slot_packet(
+            connection,
+            packet_header_addr,
+            base.route_word,
+            base.server_noc_x,
+            base.server_noc_y,
+            base.server_l1_base,
+            target_slot,
+            tx_staging_addr,
+            chunk0_total);
+
+        const uint32_t grant_expected = recv_expected + (uses_lease ? 0u : 1u);
+        if (!uses_lease) {
+            noc_semaphore_wait_min(recv_sem, grant_expected);
+            invalidate_l1_cache();
+            volatile tt_l1_ptr protocol::PacketHeader* grant_header =
+                reinterpret_cast<volatile tt_l1_ptr protocol::PacketHeader*>(base.tensor_slot_id);
+            volatile tt_l1_ptr PutGrantPayload* grant = reinterpret_cast<volatile tt_l1_ptr PutGrantPayload*>(
+                base.tensor_slot_id + sizeof(protocol::PacketHeader));
+            ASSERT(grant_header->opcode == static_cast<uint32_t>(OpCode::PUT_ACK));
+            ASSERT(grant_header->seq == request_seq);
+            ASSERT(grant->status == kPutGrantGranted);
+            ASSERT(grant->dram_value_base == session->dram_value_base);
+            ASSERT(grant->completion_l1_addr == session->completion_l1_addr);
+            ASSERT((grant->value_byte_off % kMaxChunkValueBytes) == 0);
+            direct_value_byte_off = grant->value_byte_off;
+        }
+
+        const InterleavedAddrGen<true> server_value{
+            .bank_base_address = session->dram_value_base,
+            .page_size = kMaxChunkValueBytes,
+        };
+        const uint32_t base_unit = direct_value_byte_off / kMaxChunkValueBytes;
+        uint32_t pending_consumed = 0;
+        uint32_t header_count = 0;
+        uint32_t progress_chunks = 0;
+        const bool stream_progress_enabled = total_value_len >= kPutStreamMinBytes;
+        connection.setup_stateful_send_cmd_bufs();
+        for (uint32_t value_chunk = 1; value_chunk < num_chunks; ++value_chunk) {
+            ++value_ordinal;
+            noc_semaphore_wait_min(produced_sem, value_ordinal);
+
+            const uint32_t stream_pos = (value_chunk - 1) * kMaxChunkValueBytes;
+            const uint32_t remaining = total_value_len - stream_pos;
+            const uint32_t chunk_data_len = remaining < kMaxChunkValueBytes ? remaining : kMaxChunkValueBytes;
+            const uint32_t entry = (value_ordinal - 1) % kClientPutValueRingDepth;
+            const uint32_t source_l1 = direct_ring_base + entry * kClientPutValueRingEntryStride +
+                                       sizeof(protocol::PacketHeader) + sizeof(ChunkedPayloadHeader);
+            volatile tt_l1_ptr PACKET_HEADER_TYPE* direct_header =
+                direct_headers[header_count++ % kWriterHeaderRingDepth];
+            const uint64_t dram_noc = server_dram_page_noc_addr(server_value, base_unit + value_chunk - 1, 0);
+            const uint32_t send_bytes = (chunk_data_len + 15u) & ~15u;
+            direct_header->to_noc_unicast_write(tt::tt_fabric::NocUnicastCommandHeader{dram_noc}, send_bytes);
+            connection.wait_for_empty_write_slot();
+            connection.send_current_slot_stateful_non_blocking(
+                source_l1, send_bytes, reinterpret_cast<uint32_t>(direct_header));
+
+            const bool more_chunks = value_chunk + 1 < num_chunks;
+            if (++pending_consumed == kPutConsumedAckBatch) {
+                noc_async_write_barrier(noc_index);
+                noc_semaphore_inc(consumed_sem_noc, pending_consumed);
+                pending_consumed = 0;
+                if (more_chunks) {
+                    connection.setup_stateful_send_cmd_bufs();
+                }
+            }
+
+            ++progress_chunks;
+            if (stream_progress_enabled && progress_chunks == kPutStreamProgressChunks && more_chunks) {
+                progress_chunks = 0;
+                packet_header_addr->to_noc_unicast_atomic_inc(tt::tt_fabric::NocUnicastAtomicIncCommandHeader{
+                    get_noc_addr(base.server_noc_x, base.server_noc_y, session->progress_l1_addr),
+                    1,
+                    /*flush=*/true});
+                connection.wait_for_empty_write_slot();
+                connection.send_payload_flush_blocking_from_address(
+                    reinterpret_cast<uint32_t>(packet_header_addr), sizeof(PACKET_HEADER_TYPE));
+                if (more_chunks) {
+                    connection.setup_stateful_send_cmd_bufs();
+                }
+            }
+        }
+        if (pending_consumed != 0) {
+            noc_async_write_barrier(noc_index);
+            noc_semaphore_inc(consumed_sem_noc, pending_consumed);
+        }
+        noc_async_write_barrier(noc_index);
+
+        packet_header_addr->to_noc_unicast_atomic_inc(tt::tt_fabric::NocUnicastAtomicIncCommandHeader{
+            get_noc_addr(base.server_noc_x, base.server_noc_y, session->completion_l1_addr),
+            1,
+            /*flush=*/true});
+        connection.wait_for_empty_write_slot();
+        connection.send_payload_flush_blocking_from_address(
+            reinterpret_cast<uint32_t>(packet_header_addr), sizeof(PACKET_HEADER_TYPE));
+
+        recv_expected = grant_expected + 1;
+        noc_semaphore_wait_min(recv_sem, recv_expected);
+    }
+
+    noc_async_atomic_barrier();
+    connection.close();
+}
diff --git a/ttnn/cpp/ttnn/operations/kvcache_manager/client/device/kernels/dataflow/put_reader_kernel.cpp b/ttnn/cpp/ttnn/operations/kvcache_manager/client/device/kernels/dataflow/put_reader_kernel.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..1b9a541b7fca0a343f7712db831a2caf9fcc4294
--- /dev/null
+++ b/ttnn/cpp/ttnn/operations/kvcache_manager/client/device/kernels/dataflow/put_reader_kernel.cpp
@@ -0,0 +1,147 @@
+// SPDX-FileCopyrightText: (c) 2026 Moreh
+//
+// SPDX-License-Identifier: Apache-2.0
+//
+// kvcache_manager Client PUT reader kernel (RISCV_0 / NOC0) — producer half of the
+// PUT reader/writer split. Streams each value chunk (i = 1..num_chunks-1) from the
+// client chip's DRAM into the value sub-region of an L1 PUT value-ring entry, then
+// publishes it to the writer via the cumulative produced_sem. Opens no fabric
+// connection; addresses its own L1 in this kernel's NoC frame (my_x/my_y[noc_index]).
+// See ttnn/cpp/ttnn/operations/kvcache_manager/docs/design.md §6.
+//
+// Ring sems are cumulative and never reset within a PUT: produced_sem (reader +=1 per
+// filled chunk), consumed_sem (writer +=1 per sent chunk). Both are bumped via
+// noc_semaphore_inc to own L1 (NoC atomic in SRAM) so the peer RISC observes them; a
+// plain store could linger in this RISC's write buffer.
+
+#include <cstdint>
+
+#include "api/dataflow/dataflow_api.h"
+
+#include "ttnn/cpp/ttnn/operations/kvcache_manager/common/protocol/packet.hpp"
+#include "ttnn/cpp/ttnn/operations/kvcache_manager/common/protocol/layout.hpp"
+#include "ttnn/cpp/ttnn/operations/kvcache_manager/common/kvm_device_zone.hpp"
+
+using namespace ttnn::operations::kvcache_manager::protocol;
+// Same spelling convention as the fabric kernels: the app header is protocol::PacketHeader
+// (defensive — this TU is fabric-free today, but a future fabric include would arm the
+// tt::tt_fabric::PacketHeader ambiguity silently).
+namespace protocol = ttnn::operations::kvcache_manager::protocol;
+
+// Read prefetch depth: keep this many value-chunk DRAM reads in flight (each tagged
+// with a distinct trid) so consecutive interleaved-bank reads overlap instead of
+// exposing one read's latency per chunk. Must be < value-ring depth D and <= 16 (NOC
+// trid range).
+constexpr uint32_t kReaderPrefetchDepth = kPutReaderPrefetchDepth;  // P, defined in layout.hpp
+
+void kernel_main() {
+    KVM_ZONE_CLIENT_PUT("KVM-READER-TOTAL");
+    size_t rt_arg_idx = 0;
+    uint32_t client_l1_base = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t num_chunks = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t total_value_len = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t client_dram_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t logical_page_size = get_arg_val<uint32_t>(rt_arg_idx++);
+
+    // Interleaved DRAM addr-gen at the tensor's natural page size. Wire chunk
+    // (kMaxChunkValueBytes) and DRAM page (logical_page_size) are decoupled, so each
+    // chunk read splits at page boundaries (interleaved pages live on different banks).
+    const InterleavedAddrGen<true> dram_src{
+        .bank_base_address = client_dram_addr,
+        .page_size = logical_page_size,
+    };
+
+    const uint32_t ring_base = client_l1_base + kClientPutValueRingBaseOffset;
+    const uint32_t value_sub_offset = sizeof(protocol::PacketHeader) + sizeof(ChunkedPayloadHeader);
+
+    volatile tt_l1_ptr uint32_t* consumed_sem =
+        reinterpret_cast<volatile tt_l1_ptr uint32_t*>(client_l1_base + kClientPutRingConsumedSemOffset);
+    const uint64_t produced_sem_noc =
+        get_noc_addr(my_x[noc_index], my_y[noc_index], client_l1_base + kClientPutRingProducedSemOffset);
+
+    // The reader owns this baseline and publishes it through NoC for cross-RISC visibility.
+    noc_inline_dw_write(produced_sem_noc, 0);
+    noc_async_write_barrier();
+
+    // Issue one tagged chunk read after its ring entry becomes reusable; the caller drains that
+    // transaction ID after keeping up to P reads in flight.
+    constexpr uint32_t P = kReaderPrefetchDepth;
+    auto issue_read = [&](uint32_t i) {
+        // Ring-reuse backpressure: entry (i-1)%D aliases chunk (i-D)'s; wait for the
+        // writer to send chunk i-D (consumed_sem >= i-D) before refill. i <= D: skip.
+        if (i > kClientPutValueRingDepth) {
+            if (i == kClientPutValueRingDepth + 1) {
+                KVM_ZONE_CLIENT_PUT("KVM-READER-RING-STALL-FIRST");
+                noc_semaphore_wait_min(consumed_sem, i - kClientPutValueRingDepth);
+            } else {
+                noc_semaphore_wait_min(consumed_sem, i - kClientPutValueRingDepth);
+            }
+        }
+        const uint32_t e = (i - 1) % kClientPutValueRingDepth;
+        const uint32_t value_dst_l1 = ring_base + e * kClientPutValueRingEntryStride + value_sub_offset;
+        const uint32_t stream_pos = (i - 1) * kMaxChunkValueBytes;
+        const uint32_t remaining = total_value_len - stream_pos;
+        const uint32_t chunk_data_len = (remaining < kMaxChunkValueBytes) ? remaining : kMaxChunkValueBytes;
+        // One trid for the whole chunk: the page-split bursts below all inherit the trid
+        // set here, so one barrier_with_trid drains the chunk.
+        noc_async_read_set_trid(i % P);
+        uint32_t copied = 0;
+        while (copied < chunk_data_len) {
+            const uint32_t abs_pos = stream_pos + copied;
+            const uint32_t page_idx = abs_pos / logical_page_size;
+            const uint32_t in_page_off = abs_pos % logical_page_size;
+            const uint32_t page_remaining = logical_page_size - in_page_off;
+            const uint32_t want = chunk_data_len - copied;
+            const uint32_t this_read = (page_remaining < want) ? page_remaining : want;
+            uint64_t page_noc = get_noc_addr(page_idx, dram_src, in_page_off);
+            noc_async_read(page_noc, value_dst_l1 + copied, this_read);
+            copied += this_read;
+        }
+    };
+
+#ifdef KVM_INJECT_PUT_READER_TRID_POLLUTION
+    // Test-only fault injection for the reset ordering below. See "PUT reader coexistence
+    // diagnostic" in ttnn/cpp/ttnn/operations/kvcache_manager/docs/development.md.
+    {
+        noc_async_write_set_trid(1);
+        const uint64_t self_only_mcast =
+            get_noc_multicast_addr(my_x[noc_index], my_y[noc_index], my_x[noc_index], my_y[noc_index], client_l1_base);
+        noc_async_write_multicast(client_l1_base, self_only_mcast, 16, /*num_dests=*/1);
+        // intentionally NO barrier — leave trid 1 outstanding into the loop below.
+    }
+#endif
+
+    // Clear per-trid NIU state retained by a preceding program before issuing this PUT's reads.
+    // See ttnn/cpp/ttnn/operations/kvcache_manager/docs/design.md §6 PUT.
+    reset_noc_trid_barrier_counter(NOC_CLEAR_OUTSTANDING_REQ_MASK, noc_index);
+
+    {
+        KVM_ZONE_CLIENT_PUT("KVM-READER-LOOP");
+        // Prologue: prime up to P chunks of reads (P-deep pipeline).
+        for (uint32_t i = 1; i < num_chunks && i <= P; ++i) {
+            issue_read(i);
+        }
+        // Steady state: drain chunk i (its trid only — later prefetches stay in flight),
+        // publish it in order, then issue chunk i+P to keep P reads outstanding. Inner
+        // per-chunk zones are recorded only on the first iteration. See "Profiling and benchmarks"
+        // in ttnn/cpp/ttnn/operations/kvcache_manager/docs/development.md for the marker budget.
+        for (uint32_t i = 1; i < num_chunks; ++i) {
+            if (i == 1) {
+                KVM_ZONE_CLIENT_PUT("KVM-READER-DRAM-READ-FIRST");
+                noc_async_read_barrier_with_trid(i % P);
+            } else {
+                noc_async_read_barrier_with_trid(i % P);
+            }
+            // Publish the filled entry to the writer (cross-RISC visible via NoC
+            // atomic_inc to own L1; see header).
+            noc_semaphore_inc(produced_sem_noc, 1);
+            const uint32_t next = i + P;
+            if (next < num_chunks) {
+                issue_read(next);
+            }
+        }
+    }
+
+    // Drain the outstanding sem inc so it is not lost on teardown.
+    noc_async_atomic_barrier();
+}
diff --git a/ttnn/cpp/ttnn/operations/kvcache_manager/client/device/kernels/dataflow/put_writer_kernel.cpp b/ttnn/cpp/ttnn/operations/kvcache_manager/client/device/kernels/dataflow/put_writer_kernel.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..90633880649ad4e68efa29295fa72150083d48c1
--- /dev/null
+++ b/ttnn/cpp/ttnn/operations/kvcache_manager/client/device/kernels/dataflow/put_writer_kernel.cpp
@@ -0,0 +1,307 @@
+// SPDX-FileCopyrightText: (c) 2026 Moreh
+//
+// SPDX-License-Identifier: Apache-2.0
+//
+// kvcache_manager Client PUT writer kernel (RISCV_1 / NOC1) — writer half of the
+// PUT reader/writer split: one launch + autonomous chunk loop, no host PCIe ops in
+// the loop. The control packet is built in Client L1 from host-provided RT args; value chunks are
+// filled by the reader kernel (put_reader_kernel.cpp, RISCV_0) into value-ring entries,
+// then Fabric-written directly into the server device-DRAM block. See
+// ttnn/cpp/ttnn/operations/kvcache_manager/docs/design.md §6 and client_kernel_common.hpp for the
+// base RT-arg ABI [0..13].
+//
+// PUT extras (after base [0..13], before the fabric connection args):
+//   [14]     stream_id_seq
+//   [15]     num_pages
+//   [16]     dtype
+//   [17]     layout
+//   [18]     rank
+//   [19..]   shape[kTensorShapeMaxRank]
+//   [..]     key_len
+//   [..]     key_words[32] (128 B fixed so the fabric-args offset is key_len-independent)
+
+#include "ttnn/cpp/ttnn/operations/kvcache_manager/client/device/kernels/dataflow/client_kernel_common.hpp"
+
+using namespace ttnn::operations::kvcache_manager::protocol;
+using namespace ttnn::operations::kvcache_manager::client;
+// Under FABRIC_2D, kvm_fabric_route.hpp pulls in tt_fabric_api.h whose global
+// `using namespace tt::tt_fabric` makes the bare name PacketHeader ambiguous with
+// tt::tt_fabric::PacketHeader; the wire's 16 B app header is spelled through this
+// alias so both fabric modes compile from one source.
+namespace protocol = ttnn::operations::kvcache_manager::protocol;
+
+namespace {
+
+// One consumed-ACK batch protects both source-entry and nonblocking Fabric-header reuse.
+constexpr uint32_t kWriterHeaderRingDepth = 4;
+
+FORCE_INLINE uint64_t server_dram_page_noc_addr(const InterleavedAddrGen<true>& d, uint32_t page_id, uint32_t offset) {
+    uint64_t noc_address = d.get_noc_addr(page_id, offset, tt::tt_fabric::edm_to_local_chip_noc);
+#if defined(ARCH_WORMHOLE)
+    auto components = get_noc_address_components(noc_address);
+    noc_address = safe_get_noc_addr(
+        components.first.x, components.first.y, components.second, tt::tt_fabric::edm_to_local_chip_noc);
+#endif
+    return noc_address;
+}
+
+}  // namespace
+
+void kernel_main() {
+    size_t rt_arg_idx = 0;
+    ClientBaseArgs base = parse_base_args(rt_arg_idx);
+    const uint32_t client_l1_base = base.client_l1_base;
+    const uint32_t server_l1_base = base.server_l1_base;
+    const uint32_t server_noc_x = base.server_noc_x;
+    const uint32_t server_noc_y = base.server_noc_y;
+    const uint32_t base_ring_slot_idx = base.base_ring_slot_idx;
+    const uint32_t payload_size = base.payload_size;
+    const uint32_t route_word = base.route_word;
+    const uint32_t num_chunks = base.num_chunks;
+    const uint32_t total_value_len = base.total_value_len;
+    const uint32_t logical_page_size = base.logical_page_size;
+    const uint32_t recv_buffer_addr = base.tensor_slot_id;
+
+    // PUT chunk-0 construct extras. Appended after the base RT args and BEFORE the fabric
+    // connection args, so they MUST be consumed here before build_from_args (ABI order).
+    const uint32_t put_stream_id_seq = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t put_num_pages = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t put_dtype = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t put_layout = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t put_rank = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t put_shape[kTensorShapeMaxRank] = {0};
+    for (uint32_t d = 0; d < kTensorShapeMaxRank; ++d) {
+        put_shape[d] = get_arg_val<uint32_t>(rt_arg_idx++);
+    }
+    const uint32_t put_key_len = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t put_key_words[32] = {0};
+    for (uint32_t w = 0; w < 32; ++w) {
+        put_key_words[w] = get_arg_val<uint32_t>(rt_arg_idx++);
+    }
+
+    auto connection = tt::tt_fabric::WorkerToFabricEdmSender::build_from_args<ProgrammableCoreType::TENSIX>(rt_arg_idx);
+    volatile tt_l1_ptr PACKET_HEADER_TYPE* packet_header_addr = PacketHeaderPool::allocate_header();
+    connection.open<true>();
+
+    const uint32_t tx_staging_addr = client_l1_base + kClientTxStagingOffset;
+
+    DeviceZoneScopedN("KVM-PUT");  // op-named op-wall (raw; the standalone bench reads it by name)
+
+    // recv_sem has one landed event on a lease hit, or grant followed by landed on a fallback.
+    volatile tt_l1_ptr uint32_t* recv_sem_ptr =
+        reinterpret_cast<volatile tt_l1_ptr uint32_t*>(client_l1_base + kClientRecvSemOffset);
+    invalidate_l1_cache();
+    volatile tt_l1_ptr PutSessionConfig* session =
+        reinterpret_cast<volatile tt_l1_ptr PutSessionConfig*>(client_l1_base + kClientPutSessionConfigOffset);
+    volatile tt_l1_ptr PutLeaseDescriptor* lease =
+        reinterpret_cast<volatile tt_l1_ptr PutLeaseDescriptor*>(client_l1_base + kClientPutLeaseDescriptorOffset);
+    ASSERT(session->version == kPutSessionVersion);
+
+    const uint32_t required_order = buddy_order_for_value_bytes(total_value_len);
+    bool uses_lease = false;
+    uint32_t lease_generation = 0;
+    uint32_t direct_dram_base = session->dram_value_base;
+    uint32_t direct_value_byte_off = 0;
+    uint32_t direct_completion_addr = session->completion_l1_addr;
+    // Separate address, not completion_l1_addr + 4: the landed fence is per-client while stream
+    // progress is shared, so the two no longer sit in one cacheline (see PutSessionConfig).
+    const uint32_t direct_progress_addr = session->progress_l1_addr;
+    if (lease->status == kPutLeaseReady && lease->buddy_order == required_order) {
+        lease_generation = lease->generation;
+        direct_value_byte_off = lease->value_byte_off;
+        ASSERT(lease_generation != 0);
+        ASSERT((direct_value_byte_off % kMaxChunkValueBytes) == 0);
+        uses_lease = true;
+    }
+    const uint32_t landed_event = uses_lease ? 1u : 2u;
+
+    const uint64_t consumed_sem_noc =
+        get_noc_addr(my_x[noc_index], my_y[noc_index], client_l1_base + kClientPutRingConsumedSemOffset);
+
+    // Initialize each counter once per PUT. NoC publication makes consumed_sem visible to the reader.
+    *recv_sem_ptr = 0;
+    noc_inline_dw_write(consumed_sem_noc, 0);
+    noc_async_write_barrier();
+
+    {
+        const uint32_t chunk0_payload = sizeof(ChunkedPayloadHeader) + sizeof(TensorMetadata) + put_key_len;
+
+        volatile tt_l1_ptr protocol::PacketHeader* ph =
+            reinterpret_cast<volatile tt_l1_ptr protocol::PacketHeader*>(tx_staging_addr);
+        ph->opcode = static_cast<uint32_t>(OpCode::PUT_CHUNK);
+        ph->seq = put_stream_id_seq;
+        ph->payload_size = chunk0_payload;
+        ph->client_token = base.client_token;
+
+        volatile tt_l1_ptr ChunkedPayloadHeader* ch = reinterpret_cast<volatile tt_l1_ptr ChunkedPayloadHeader*>(
+            tx_staging_addr + sizeof(protocol::PacketHeader));
+        ch->stream_id_seq = put_stream_id_seq;
+        ch->chunk_idx = 0;
+        ch->num_chunks = num_chunks;
+        ch->total_value_len = total_value_len;
+        ch->chunk_payload_len = put_key_len;
+        ch->status_flags = uses_lease ? kPutStatusUsesLease : 0u;
+        ch->tensor_slot_id = uses_lease ? lease_generation : 0u;
+        ch->value_byte_off = uses_lease ? direct_value_byte_off : 0u;
+
+        volatile tt_l1_ptr TensorMetadata* meta = reinterpret_cast<volatile tt_l1_ptr TensorMetadata*>(
+            tx_staging_addr + sizeof(protocol::PacketHeader) + sizeof(ChunkedPayloadHeader));
+        meta->logical_page_size = logical_page_size;
+        meta->num_pages = put_num_pages;
+        meta->dtype = put_dtype;
+        meta->layout = put_layout;
+        meta->rank = put_rank;
+        for (uint32_t d = 0; d < kTensorShapeMaxRank; ++d) {
+            meta->shape[d] = put_shape[d];
+        }
+
+        // All 32 zero-padded RT-arg words are copied; the packet transmits only put_key_len bytes.
+        volatile tt_l1_ptr uint32_t* key_dst = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(
+            tx_staging_addr + sizeof(protocol::PacketHeader) + sizeof(ChunkedPayloadHeader) + sizeof(TensorMetadata));
+        for (uint32_t w = 0; w < 32; ++w) {
+            key_dst[w] = put_key_words[w];
+        }
+    }
+
+    // Chunk 0 is the only request that enters the server L1 packet ring.
+    {
+        KVM_ZONE_CLIENT_PUT("KVM-PUT-CONTROL-SEND");
+        const uint32_t total = (sizeof(protocol::PacketHeader) + payload_size + 15) & ~15u;
+        const uint32_t slot = (base_ring_slot_idx + 0) % kRingNumSlots;
+        send_slot_packet(
+            connection,
+            packet_header_addr,
+            route_word,
+            server_noc_x,
+            server_noc_y,
+            server_l1_base,
+            slot,
+            tx_staging_addr,
+            total);
+    }
+
+    // A lease hit starts the value stream immediately. Only the fallback waits for a grant.
+    if (!uses_lease) {
+        KVM_ZONE_CLIENT_PUT("KVM-PUT-GRANT-WAIT");
+        noc_semaphore_wait_min(recv_sem_ptr, 1);
+    }
+
+    if (!uses_lease) {
+        invalidate_l1_cache();
+        volatile tt_l1_ptr protocol::PacketHeader* grant_header =
+            reinterpret_cast<volatile tt_l1_ptr protocol::PacketHeader*>(recv_buffer_addr);
+        volatile tt_l1_ptr PutGrantPayload* grant =
+            reinterpret_cast<volatile tt_l1_ptr PutGrantPayload*>(recv_buffer_addr + sizeof(protocol::PacketHeader));
+        ASSERT(grant_header->opcode == static_cast<uint32_t>(OpCode::PUT_ACK));
+        ASSERT(grant_header->seq == put_stream_id_seq);
+        ASSERT(grant->status == kPutGrantGranted);
+        ASSERT(grant->dram_value_base == direct_dram_base);
+        ASSERT(grant->completion_l1_addr == direct_completion_addr);
+        ASSERT((grant->value_byte_off % kMaxChunkValueBytes) == 0);
+        direct_value_byte_off = grant->value_byte_off;
+    }
+
+    const InterleavedAddrGen<true> server_value{
+        .bank_base_address = direct_dram_base,
+        .page_size = kMaxChunkValueBytes,
+    };
+    const uint32_t base_unit = direct_value_byte_off / kMaxChunkValueBytes;
+    const uint32_t direct_ring_base = client_l1_base + kClientPutValueRingBaseOffset;
+    volatile tt_l1_ptr uint32_t* direct_produced_sem =
+        reinterpret_cast<volatile tt_l1_ptr uint32_t*>(client_l1_base + kClientPutRingProducedSemOffset);
+
+    volatile tt_l1_ptr PACKET_HEADER_TYPE* direct_headers[kWriterHeaderRingDepth];
+    for (uint32_t h = 0; h < kWriterHeaderRingDepth; ++h) {
+        direct_headers[h] = PacketHeaderPool::allocate_header();
+    }
+    connection.setup_stateful_send_cmd_bufs();
+
+    // The destination is fixed for the whole PUT: pre-set the route once on the direct-header
+    // ring and the shared header instead of per chunk (route decode costs tens of cycles on 2D;
+    // the to_noc_* command setters below never touch the route fields).
+    for (uint32_t h = 0; h < kWriterHeaderRingDepth; ++h) {
+        set_unicast_route(direct_headers[h], route_word);
+    }
+    set_unicast_route(packet_header_addr, route_word);
+
+    static_assert(
+        kPutConsumedAckBatch <= kClientPutValueRingDepth - kPutReaderPrefetchDepth,
+        "consumed-ack batch must not exceed reader ring-reuse slack (D - P)");
+    static_assert(
+        kPutConsumedAckBatch == kWriterHeaderRingDepth,
+        "one batch barrier must protect both value-ring reuse and Fabric header-ring reuse");
+    uint32_t pending_direct_consumed = 0;
+    uint32_t direct_header_count = 0;
+    uint32_t direct_progress_chunks = 0;
+    const bool stream_progress_enabled = total_value_len >= kPutStreamMinBytes;
+    {
+        KVM_ZONE_CLIENT_PUT("KVM-PUT-LOOP");
+        for (uint32_t i = 1; i < num_chunks; ++i) {
+            const uint32_t stream_pos = (i - 1) * kMaxChunkValueBytes;
+            const uint32_t remaining = total_value_len - stream_pos;
+            const uint32_t chunk_data_len = (remaining < kMaxChunkValueBytes) ? remaining : kMaxChunkValueBytes;
+            noc_semaphore_wait_min(direct_produced_sem, i);
+
+            const uint32_t entry = (i - 1) % kClientPutValueRingDepth;
+            const uint32_t src_l1 = direct_ring_base + entry * kClientPutValueRingEntryStride +
+                                    sizeof(protocol::PacketHeader) + sizeof(ChunkedPayloadHeader);
+            volatile tt_l1_ptr PACKET_HEADER_TYPE* direct_header =
+                direct_headers[direct_header_count++ % kWriterHeaderRingDepth];
+            const uint64_t dram_noc = server_dram_page_noc_addr(server_value, base_unit + i - 1, 0);
+            const uint32_t send_bytes = (chunk_data_len + 15u) & ~15u;
+            direct_header->to_noc_unicast_write(tt::tt_fabric::NocUnicastCommandHeader{dram_noc}, send_bytes);
+            connection.wait_for_empty_write_slot();
+            connection.send_current_slot_stateful_non_blocking(
+                src_l1, send_bytes, reinterpret_cast<uint32_t>(direct_header));
+
+            const bool more_chunks = i + 1 < num_chunks;
+            if (++pending_direct_consumed == kPutConsumedAckBatch) {
+                // The barrier protects both source rings before the reader can refill them. The
+                // semaphore atomic then replaces write_at_cmd_buf state used by Fabric credits, so
+                // restore that state before issuing another stateful send.
+                noc_async_write_barrier(noc_index);
+                noc_semaphore_inc(consumed_sem_noc, pending_direct_consumed);
+                pending_direct_consumed = 0;
+                if (more_chunks) {
+                    connection.setup_stateful_send_cmd_bufs();
+                }
+            }
+
+            ++direct_progress_chunks;
+            if (stream_progress_enabled && direct_progress_chunks == kPutStreamProgressChunks && more_chunks) {
+                direct_progress_chunks = 0;
+                // Only complete nonterminal groups need a separate visibility fence. The landed
+                // atomic below fences the final group before directory publication. The route is
+                // pre-set once above (set_unicast_route), so no per-event re-stamp is needed.
+                packet_header_addr->to_noc_unicast_atomic_inc(tt::tt_fabric::NocUnicastAtomicIncCommandHeader{
+                    get_noc_addr(server_noc_x, server_noc_y, direct_progress_addr), 1, /*flush=*/true});
+                connection.wait_for_empty_write_slot();
+                connection.send_payload_flush_blocking_from_address(
+                    reinterpret_cast<uint32_t>(packet_header_addr), sizeof(PACKET_HEADER_TYPE));
+                if (more_chunks) {
+                    connection.setup_stateful_send_cmd_bufs();
+                }
+            }
+        }
+    }
+    if (pending_direct_consumed != 0) {
+        noc_async_write_barrier(noc_index);
+        noc_semaphore_inc(consumed_sem_noc, pending_direct_consumed);
+    }
+    noc_async_write_barrier(noc_index);
+
+    // Keep the original one-increment completion counter: the progress inc above is an independent
+    // large-PUT stream and this remains the compact per-client NCRISC landed fence.
+    packet_header_addr->to_noc_unicast_atomic_inc(tt::tt_fabric::NocUnicastAtomicIncCommandHeader{
+        get_noc_addr(server_noc_x, server_noc_y, direct_completion_addr),
+        1,
+        /*flush=*/true});
+    connection.wait_for_empty_write_slot();
+    connection.send_payload_flush_blocking_from_address(
+        reinterpret_cast<uint32_t>(packet_header_addr), sizeof(PACKET_HEADER_TYPE));
+
+    noc_semaphore_wait_min(recv_sem_ptr, landed_event);
+    noc_async_atomic_barrier();
+    connection.close();
+    return;
+}
diff --git a/ttnn/cpp/ttnn/operations/kvcache_manager/client/device/kernels/dataflow/status_kernel.cpp b/ttnn/cpp/ttnn/operations/kvcache_manager/client/device/kernels/dataflow/status_kernel.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..8abc3ae683a13dbe665ad498d8082c1a12f7b65d
--- /dev/null
+++ b/ttnn/cpp/ttnn/operations/kvcache_manager/client/device/kernels/dataflow/status_kernel.cpp
@@ -0,0 +1,124 @@
+// SPDX-FileCopyrightText: (c) 2026 Moreh
+//
+// SPDX-License-Identifier: Apache-2.0
+//
+// kvcache_manager Client STATUS kernel — single-packet directory ops:
+// EXISTS / REMOVE / MOVE_TO_HOST / MOVE_TO_DEVICE / DETACH / COMMIT_BARRIER. One resident program;
+// op_kind (base [0]) selects the opcode and op-wall zone; every op awaits a server signal.
+// Built in-kernel from RT args. Extras after the base args: req_seq, then key_words[32]
+// (128 B fixed, key_len-independent offset). See
+// ttnn/cpp/ttnn/operations/kvcache_manager/docs/design.md §6 and client_kernel_common.hpp.
+
+#include "ttnn/cpp/ttnn/operations/kvcache_manager/client/device/kernels/dataflow/client_kernel_common.hpp"
+
+using namespace ttnn::operations::kvcache_manager::protocol;
+using namespace ttnn::operations::kvcache_manager::client;
+// Under FABRIC_2D, kvm_fabric_route.hpp pulls in tt_fabric_api.h whose global
+// `using namespace tt::tt_fabric` makes the bare name PacketHeader ambiguous with
+// tt::tt_fabric::PacketHeader; the wire's 16 B app header is spelled through this
+// alias so both fabric modes compile from one source.
+namespace protocol = ttnn::operations::kvcache_manager::protocol;
+
+namespace {
+
+__attribute__((noinline)) void prepare_send_and_wait(
+    const ClientBaseArgs& base,
+    tt::tt_fabric::WorkerToFabricEdmSender& connection,
+    volatile tt_l1_ptr PACKET_HEADER_TYPE* packet_header_addr,
+    uint32_t opcode,
+    uint32_t req_seq,
+    const uint32_t* key_words) {
+    const uint32_t tx_staging_addr = base.client_l1_base + kClientTxStagingOffset;
+
+    // Zero the recv-sem baseline before sending. The server increments it only after producing a
+    // result or accepting a MOVE through the BRISC directory path.
+    volatile tt_l1_ptr uint32_t* recv_sem_ptr =
+        reinterpret_cast<volatile tt_l1_ptr uint32_t*>(base.client_l1_base + kClientRecvSemOffset);
+    *recv_sem_ptr = 0;
+
+    volatile tt_l1_ptr protocol::PacketHeader* ph =
+        reinterpret_cast<volatile tt_l1_ptr protocol::PacketHeader*>(tx_staging_addr);
+    ph->opcode = opcode;
+    ph->seq = req_seq;
+    ph->payload_size = base.payload_size;
+    ph->client_token = base.client_token;
+    volatile tt_l1_ptr uint32_t* key_dst =
+        reinterpret_cast<volatile tt_l1_ptr uint32_t*>(tx_staging_addr + sizeof(protocol::PacketHeader));
+    for (uint32_t w = 0; w < 32; ++w) {
+        key_dst[w] = key_words[w];
+    }
+
+    const uint32_t total = (sizeof(protocol::PacketHeader) + base.payload_size + 15) & ~15u;
+    send_single_and_wait(
+        connection,
+        packet_header_addr,
+        base.route_word,
+        base.server_noc_x,
+        base.server_noc_y,
+        base.server_l1_base,
+        base.base_ring_slot_idx,
+        tx_staging_addr,
+        total,
+        base.client_l1_base + kClientRecvSemOffset);
+}
+
+}  // namespace
+
+void kernel_main() {
+    size_t rt_arg_idx = 0;
+    ClientBaseArgs base = parse_base_args(rt_arg_idx);
+
+    // Every status op uses the same fixed RT-arg shape; keyless operations pass zero words.
+    const uint32_t req_seq = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t status_key_words[32] = {0};
+    for (uint32_t w = 0; w < 32; ++w) {
+        status_key_words[w] = get_arg_val<uint32_t>(rt_arg_idx++);
+    }
+
+    auto connection = tt::tt_fabric::WorkerToFabricEdmSender::build_from_args<ProgrammableCoreType::TENSIX>(rt_arg_idx);
+    volatile tt_l1_ptr PACKET_HEADER_TYPE* packet_header_addr = PacketHeaderPool::allocate_header();
+    connection.open<true>();
+
+    // Every scope starts after connection open and includes request construction, send/close, and
+    // completion observation. MOVE scopes compile only for a focused move profile.
+    if (base.op_kind == kOpKindExists) {
+        DeviceZoneScopedN("KVM-EXISTS");
+        prepare_send_and_wait(
+            base, connection, packet_header_addr, static_cast<uint32_t>(OpCode::EXISTS), req_seq, status_key_words);
+    } else if (base.op_kind == kOpKindRemove) {
+        DeviceZoneScopedN("KVM-REMOVE");
+        prepare_send_and_wait(
+            base, connection, packet_header_addr, static_cast<uint32_t>(OpCode::REMOVE), req_seq, status_key_words);
+    } else if (base.op_kind == kOpKindDetach) {
+        DeviceZoneScopedN("KVM-DETACH");
+        prepare_send_and_wait(
+            base, connection, packet_header_addr, static_cast<uint32_t>(OpCode::DETACH), req_seq, status_key_words);
+    } else if (base.op_kind == kOpKindCommitBarrier) {
+        DeviceZoneScopedN("KVM-COMMIT-BARRIER");
+        prepare_send_and_wait(
+            base,
+            connection,
+            packet_header_addr,
+            static_cast<uint32_t>(OpCode::COMMIT_BARRIER),
+            req_seq,
+            status_key_words);
+    } else if (base.op_kind == kOpKindMoveToHost) {
+        KVM_ZONE_CLIENT_MOVE("KVM-MOVE-TO-HOST");
+        prepare_send_and_wait(
+            base,
+            connection,
+            packet_header_addr,
+            static_cast<uint32_t>(OpCode::MOVE_TO_HOST),
+            req_seq,
+            status_key_words);
+    } else {
+        KVM_ZONE_CLIENT_MOVE("KVM-MOVE-TO-DEVICE");
+        prepare_send_and_wait(
+            base,
+            connection,
+            packet_header_addr,
+            static_cast<uint32_t>(OpCode::MOVE_TO_DEVICE),
+            req_seq,
+            status_key_words);
+    }
+}
diff --git a/ttnn/cpp/ttnn/operations/kvcache_manager/common/config.cpp b/ttnn/cpp/ttnn/operations/kvcache_manager/common/config.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..b9fc2cca797d5f1505739842f22fe5214e472652
--- /dev/null
+++ b/ttnn/cpp/ttnn/operations/kvcache_manager/common/config.cpp
@@ -0,0 +1,220 @@
+// SPDX-FileCopyrightText: (c) 2026 Moreh
+//
+// SPDX-License-Identifier: Apache-2.0
+
+#include "config.hpp"
+
+#include <charconv>
+#include <cstdlib>
+#include <limits>
+#include <string>
+#include <system_error>
+
+#include <tt-logger/tt-logger.hpp>
+#include <tt_stl/assert.hpp>
+
+#include "protocol/layout.hpp"
+#include "protocol/packet.hpp"
+
+namespace ttnn::operations::kvcache_manager::config {
+
+uint64_t parse_u64_exact(std::string_view value, std::string_view name) {
+    uint64_t parsed = 0;
+    const auto [end, error] = std::from_chars(value.data(), value.data() + value.size(), parsed, 10);
+    if (value.empty() || error == std::errc::invalid_argument || end != value.data() + value.size()) {
+        TT_THROW(
+            "{}=\"{}\" must be an unsigned decimal integer with no whitespace or trailing characters", name, value);
+    }
+    if (error == std::errc::result_out_of_range) {
+        TT_THROW("{}=\"{}\" exceeds uint64 range", name, value);
+    }
+    return parsed;
+}
+
+bool parse_bool_exact(std::string_view value, std::string_view name) {
+    if (value == "1" || value == "true") {
+        return true;
+    }
+    if (value == "0" || value == "false") {
+        return false;
+    }
+    TT_THROW("{}=\"{}\" must be one of: 0, 1, false, true", name, value);
+}
+
+std::optional<uint64_t> read_u64_env(const char* name) {
+    const char* value = std::getenv(name);
+    if (value == nullptr) {
+        return std::nullopt;
+    }
+    return parse_u64_exact(value, name);
+}
+
+std::optional<bool> read_bool_env(const char* name) {
+    const char* value = std::getenv(name);
+    if (value == nullptr) {
+        return std::nullopt;
+    }
+    return parse_bool_exact(value, name);
+}
+
+ProfileDetail parse_profile_detail(std::string_view value) {
+    if (value == "put") {
+        return ProfileDetail::Put;
+    }
+    if (value == "get") {
+        return ProfileDetail::Get;
+    }
+    if (value == "get_host") {
+        return ProfileDetail::GetHost;
+    }
+    if (value == "move") {
+        return ProfileDetail::Move;
+    }
+    TT_THROW("KVM_PROFILE_DETAIL must be one of put, get, get_host, or move; got '{}'", value);
+}
+
+ProfileDetail resolve_profile_detail() {
+    const char* value = std::getenv("KVM_PROFILE_DETAIL");
+    return value == nullptr ? ProfileDetail::None : parse_profile_detail(value);
+}
+
+void validate_server_profile_config(
+    bool device_profiler_enabled, bool allocator_profiler_enabled, ProfileDetail profile_detail) {
+    TT_FATAL(
+        !(device_profiler_enabled && allocator_profiler_enabled),
+        "TT_METAL_DEVICE_PROFILER and KVM_SERVER_ALLOCATOR_PROFILE cannot be enabled together; "
+        "the combined instrumentation exceeds the TENSIX kernel budget");
+    TT_FATAL(
+        profile_detail == ProfileDetail::None || device_profiler_enabled,
+        "KVM_PROFILE_DETAIL requires the TT-Metal device profiler; use the canonical profile_device runner");
+}
+
+ServerDirectoryPolicy resolve_server_directory_policy() {
+    return {
+        .allocator_profile_enabled = read_bool_env("KVM_SERVER_ALLOCATOR_PROFILE").value_or(false),
+        .put_lease_evict = read_bool_env("KVM_SERVER_PUT_LEASE_EVICT").value_or(true),
+        .put_lease_evict_on_repeat_only = read_bool_env("KVM_SERVER_PUT_LEASE_EVICT_ON_REPEAT_ONLY").value_or(true),
+    };
+}
+
+uint32_t resolve_establish_timeout_ms() {
+    const uint64_t timeout_ms = read_u64_env("KVM_CLIENT_ESTABLISH_TIMEOUT_MS").value_or(kEstablishTimeoutMsDefault);
+    TT_FATAL(timeout_ms > 0, "KVM_CLIENT_ESTABLISH_TIMEOUT_MS must be positive");
+    TT_FATAL(
+        timeout_ms <= kEstablishTimeoutMsMax,
+        "KVM_CLIENT_ESTABLISH_TIMEOUT_MS={} exceeds the maximum {} ms",
+        timeout_ms,
+        kEstablishTimeoutMsMax);
+    return static_cast<uint32_t>(timeout_ms);
+}
+
+uint32_t resolve_client_value_ring_depth() {
+    constexpr uint64_t kClientRingMin = protocol::kClientPutValueRingDepthMin;
+    const uint64_t client_value_ring_depth =
+        read_u64_env("KVM_CLIENT_L1_RING_SLOTS").value_or(protocol::kClientPutValueRingDepthDefault);
+    TT_FATAL(
+        client_value_ring_depth >= kClientRingMin,
+        "KVM_CLIENT_L1_RING_SLOTS={} is below the PUT pipeline minimum {}",
+        client_value_ring_depth,
+        kClientRingMin);
+    TT_FATAL(
+        client_value_ring_depth <= std::numeric_limits<uint32_t>::max(),
+        "KVM_CLIENT_L1_RING_SLOTS={} exceeds uint32 range",
+        client_value_ring_depth);
+    const uint64_t client_reserve = protocol::client_l1_reserve_bytes(client_value_ring_depth);
+    TT_FATAL(
+        client_reserve <= std::numeric_limits<uint32_t>::max(),
+        "KVM_CLIENT_L1_RING_SLOTS={} requires {} B, above the 32-bit kernel offset limit",
+        client_value_ring_depth,
+        client_reserve);
+    return static_cast<uint32_t>(client_value_ring_depth);
+}
+
+WireConfig resolve_wire_config() {
+    // The ring is split into kMaxClients partitions of >= 2 slots each (layout.hpp
+    // kRingSlotsPerClient), so the depth has to divide evenly among clients AND stay even for the
+    // 32-byte L1 alignment phase. Rounding to a multiple of both satisfies the two at once.
+    constexpr uint64_t kRingRoundTo =
+        (protocol::kMaxClients % 2 == 0) ? protocol::kMaxClients : 2 * protocol::kMaxClients;
+    constexpr uint64_t kServerRingMin = 2 * protocol::kMaxClients;
+    uint64_t server_ring_slots = read_u64_env("KVM_SERVER_L1_RING_SLOTS").value_or(protocol::kRingNumSlotsDefault);
+    TT_FATAL(
+        server_ring_slots >= kServerRingMin,
+        "KVM_SERVER_L1_RING_SLOTS={} is below the minimum {} (2 slots for each of {} client partitions)",
+        server_ring_slots,
+        kServerRingMin,
+        protocol::kMaxClients);
+    TT_FATAL(
+        server_ring_slots <= std::numeric_limits<uint32_t>::max(),
+        "KVM_SERVER_L1_RING_SLOTS={} exceeds uint32 range",
+        server_ring_slots);
+    if ((server_ring_slots % kRingRoundTo) != 0) {
+        const uint64_t rounded = ((server_ring_slots / kRingRoundTo) + 1) * kRingRoundTo;
+        TT_FATAL(
+            rounded <= std::numeric_limits<uint32_t>::max(),
+            "KVM_SERVER_L1_RING_SLOTS={} cannot be rounded up to a multiple of {} within uint32 range",
+            server_ring_slots,
+            kRingRoundTo);
+        log_warning(
+            tt::LogOp,
+            "KVM_SERVER_L1_RING_SLOTS={} is not a multiple of {}; rounding up to {} so the ring splits "
+            "evenly across {} client partitions and keeps the 32-byte L1 alignment phase.",
+            server_ring_slots,
+            kRingRoundTo,
+            rounded,
+            protocol::kMaxClients);
+        server_ring_slots = rounded;
+    }
+
+    constexpr uint64_t kReservePage = 4096;
+    const uint64_t server_end = protocol::server_pipeline_end(server_ring_slots);
+    const uint64_t server_reserve = ((server_end + kReservePage - 1) / kReservePage) * kReservePage;
+    TT_FATAL(
+        server_reserve <= protocol::kServerL1ReserveMaxBytes,
+        "KVM_SERVER_L1_RING_SLOTS={} requires {} B, above the server L1 reserve ceiling {} B",
+        server_ring_slots,
+        server_reserve,
+        protocol::kServerL1ReserveMaxBytes);
+
+    const uint32_t client_value_ring_depth = resolve_client_value_ring_depth();
+
+    constexpr uint64_t kMaxValueDefault = protocol::kMaxMultiChunkValueBytesDefault;
+    constexpr uint64_t kMaxValueMin = protocol::kMaxChunkValueBytes;
+    constexpr uint64_t kMaxValueCap = protocol::kMaxBuddyValueBytes;
+    uint64_t max_value_bytes = read_u64_env("KVM_COMMON_MAX_VALUE_BYTES").value_or(kMaxValueDefault);
+    TT_FATAL(max_value_bytes > 0, "KVM_COMMON_MAX_VALUE_BYTES must be positive");
+    if (max_value_bytes > kMaxValueCap) {
+        log_warning(
+            tt::LogOp,
+            "KVM_COMMON_MAX_VALUE_BYTES={} exceeds the largest buddy-allocatable value {}; clamping.",
+            max_value_bytes,
+            kMaxValueCap);
+        max_value_bytes = kMaxValueCap;
+    }
+    if (max_value_bytes < kMaxValueMin) {
+        log_warning(
+            tt::LogOp,
+            "KVM_COMMON_MAX_VALUE_BYTES={} is below one chunk {}; raising to {}.",
+            max_value_bytes,
+            kMaxValueMin,
+            kMaxValueMin);
+        max_value_bytes = kMaxValueMin;
+    }
+
+    const uint64_t max_key_bytes = read_u64_env("KVM_SERVER_MAX_KEY_BYTES").value_or(protocol::kMaxKeyBytesDefault);
+    TT_FATAL(max_key_bytes > 0, "KVM_SERVER_MAX_KEY_BYTES must be positive");
+    TT_FATAL(
+        max_key_bytes <= protocol::kMaxPutKeyBytes,
+        "KVM_SERVER_MAX_KEY_BYTES={} exceeds the wire key cap {}",
+        max_key_bytes,
+        protocol::kMaxPutKeyBytes);
+
+    return {
+        .server_ring_slots = static_cast<uint32_t>(server_ring_slots),
+        .client_value_ring_depth = client_value_ring_depth,
+        .max_value_bytes = static_cast<uint32_t>(max_value_bytes),
+        .max_key_bytes = static_cast<uint32_t>(max_key_bytes),
+    };
+}
+
+}  // namespace ttnn::operations::kvcache_manager::config
