+TEST(KvCacheManagerConfig, DetailedProfilerZonesSelectOnlyConsumingKernels) {
+    const auto defines = [](KvcacheKernelTarget target, config::ProfileDetail detail = config::ProfileDetail::None) {
+        if (target == KvcacheKernelTarget::ServerDirectory) {
+            return kvcache_kernel_defines(
+                protocol::kRingNumSlotsDefault,
+                protocol::kClientPutValueRingDepthDefault,
+                target,
+                detail,
+                config::ServerDirectoryPolicy{});
+        }
+        return kvcache_kernel_defines(
+            protocol::kRingNumSlotsDefault, protocol::kClientPutValueRingDepthDefault, target, detail);
+    };
+
+    EXPECT_EQ(defines(KvcacheKernelTarget::ClientPut).count("KVM_PROFILE_CLIENT_PUT"), 0);
+    EXPECT_EQ(defines(KvcacheKernelTarget::ServerDirectory).count("KVM_PROFILE_DIRECTORY_PUT"), 0);
+
+    EXPECT_EQ(defines(KvcacheKernelTarget::ClientPut, config::ProfileDetail::Put).at("KVM_PROFILE_CLIENT_PUT"), "1");
+    EXPECT_EQ(
+        defines(KvcacheKernelTarget::ServerDirectory, config::ProfileDetail::Put).at("KVM_PROFILE_DIRECTORY_PUT"), "1");
+    EXPECT_EQ(
+        defines(KvcacheKernelTarget::ClientUnprofiled, config::ProfileDetail::Put).count("KVM_PROFILE_CLIENT_PUT"), 0);
+    EXPECT_EQ(defines(KvcacheKernelTarget::ClientGet, config::ProfileDetail::Put).count("KVM_PROFILE_CLIENT_PUT"), 0);
+    EXPECT_EQ(
+        defines(KvcacheKernelTarget::ServerTransport, config::ProfileDetail::Put).count("KVM_PROFILE_DIRECTORY_PUT"),
+        0);
+
+    EXPECT_EQ(
+        defines(KvcacheKernelTarget::ClientGet, config::ProfileDetail::GetHost).at("KVM_PROFILE_CLIENT_GET"), "1");
+    EXPECT_EQ(
+        defines(KvcacheKernelTarget::ServerDirectory, config::ProfileDetail::GetHost).at("KVM_PROFILE_DIRECTORY_GET"),
+        "1");
+    EXPECT_EQ(
+        defines(KvcacheKernelTarget::ClientPut, config::ProfileDetail::GetHost).count("KVM_PROFILE_CLIENT_GET"), 0);
+
+    EXPECT_EQ(defines(KvcacheKernelTarget::ClientMove, config::ProfileDetail::Move).at("KVM_PROFILE_CLIENT_MOVE"), "1");
+    EXPECT_EQ(
+        defines(KvcacheKernelTarget::ServerDirectory, config::ProfileDetail::Move).at("KVM_PROFILE_DIRECTORY_MOVE"),
+        "1");
+    EXPECT_EQ(defines(KvcacheKernelTarget::ClientGet, config::ProfileDetail::Move).count("KVM_PROFILE_CLIENT_MOVE"), 0);
+}
