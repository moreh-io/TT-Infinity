+TEST(KvCacheManagerConfig, ResolvesServerDirectoryPolicyStrictly) {
+    ScopedEnvironment allocator_profile{"KVM_SERVER_ALLOCATOR_PROFILE"};
+    ScopedEnvironment put_lease_evict{"KVM_SERVER_PUT_LEASE_EVICT"};
+    ScopedEnvironment put_lease_repeat_only{"KVM_SERVER_PUT_LEASE_EVICT_ON_REPEAT_ONLY"};
+
+    auto policy = config::resolve_server_directory_policy();
+    EXPECT_FALSE(policy.allocator_profile_enabled);
+    EXPECT_TRUE(policy.put_lease_evict);
+    EXPECT_TRUE(policy.put_lease_evict_on_repeat_only);
+
+    allocator_profile.set("true");
+    put_lease_evict.set("false");
+    put_lease_repeat_only.set("false");
+    policy = config::resolve_server_directory_policy();
+    EXPECT_TRUE(policy.allocator_profile_enabled);
+    EXPECT_FALSE(policy.put_lease_evict);
+    EXPECT_FALSE(policy.put_lease_evict_on_repeat_only);
+
+    allocator_profile.set("yes");
+    EXPECT_THROW(config::resolve_server_directory_policy(), std::exception);
+    allocator_profile.set("false");
+    put_lease_evict.set("yes");
+    EXPECT_THROW(config::resolve_server_directory_policy(), std::exception);
+    put_lease_evict.set("true");
+    put_lease_repeat_only.set("yes");
+    EXPECT_THROW(config::resolve_server_directory_policy(), std::exception);
