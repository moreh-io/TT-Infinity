+
+void ClientOperations::launch_ping_client(
+    uint32_t base_ring_slot_idx,
+    uint32_t payload_size,
+    uint32_t seq,
+    const PingPayloadWords& payload_words,
+    RequestTransaction& request) {
+    if (ping_prog_.workload == nullptr) {
+        ClientRtArgs args{
+            .op_kind = kOpKindPing,
+            .client_l1_base = client_l1_base_,
+            .server_l1_base = server_l1_base_,
+            .server_noc_x = server_noc_x_,
+            .server_noc_y = server_noc_y_,
+            .base_ring_slot_idx = base_ring_slot_idx,
+            .payload_size = payload_size,
+            .route_word_to_server = route_word_to_server_,
+            .num_chunks = 0,
+            .total_value_len = 0,
+            .client_dram_addr = 0,
+        };
+
+        Program program = CreateProgram();
+        CoreRange core_range(kClientCore, kClientCore);
+        KernelHandle kernel_id = CreateKernel(
+            program,
+            kPingKernelPath,
+            core_range,
+            DataMovementConfig{
+                .processor = DataMovementProcessor::RISCV_1,
+                .noc = NOC::RISCV_1_default,
+                .defines = client_kernel_defines(KvcacheKernelTarget::ClientUnprofiled)});
+
+        std::vector<uint32_t> rt_args = to_vec(args, client_token_);
+        // PING builds the request packet in-kernel from these extras (seq + payload words), consumed
+        // before the fabric args (ABI order). This avoids a host-direct WriteToDeviceL1 preamble
+        // on non-MMIO clients.
+        rt_args.push_back(seq);
+        rt_args.insert(rt_args.end(), payload_words.begin(), payload_words.end());
+        append_server_connection_rt_args(program, rt_args);
+        SetRuntimeArgs(program, kernel_id, kClientCore, rt_args);
+
+        ping_prog_.workload = std::make_unique<MeshWorkload>();
+        ping_prog_.workload->add_program(chip_range_, std::move(program));
+        ping_prog_.kernel_id = kernel_id;
+    } else {
+        Program& program = ping_prog_.workload->get_programs().at(chip_range_);
+        RuntimeArgsData& rta = GetRuntimeArgs(program, ping_prog_.kernel_id, kClientCore);
+        rta[kRtaBaseRingSlot] = base_ring_slot_idx;
+        rta[kRtaPayloadSize] = payload_size;
+        rta[kRtaPingSeq] = seq;
+        for (size_t w = 0; w < payload_words.size(); ++w) {
+            rta[kRtaPingPayloadWords + w] = payload_words[w];
+        }
+    }
+    if (!ping_prog_.compiled) {
+        Program& program = ping_prog_.workload->get_programs().at(chip_range_);
+        tt::tt_metal::detail::CompileProgram(client_submesh_, program);
+        ping_prog_.compiled = true;
+    }
+
+    // The blocking response ReadShard in ping() is the single CQ synchronization point.
+    enqueue_request(*ping_prog_.workload, /*blocking=*/false, request);
+}
+
+ClientOperations::PutLaunchTiming ClientOperations::launch_put_client(
+    uint32_t base_ring_slot_idx,
+    uint32_t num_chunks,
+    uint32_t key_len,
+    uint32_t total_value_len,
+    uint32_t client_dram_addr,
+    uint32_t logical_page_size,
+    const PutChunk0Args& chunk0,
+    RequestTransaction& request) {
+    const uint32_t chunk0_payload = sizeof(protocol::ChunkedPayloadHeader) + sizeof(protocol::TensorMetadata) + key_len;
+
+    const auto t_build0 = std::chrono::steady_clock::now();
+    if (put_prog_.workload == nullptr) {
+        // First PUT: build the resident 2-kernel program once (writer on RISCV_1, reader on
+        // RISCV_0). tt-metal caches compile / dispatch-command assembly / kernel-binary write, so
+        // later PUTs pay only the RTA override + CQ write. Fabric resolved once.
+        IDevice* client_device = client_submesh_->get_device(client_coord_);
+        TT_FATAL(
+            static_cast<uint32_t>(client_device->num_dram_channels()) == server_num_dram_channels_ &&
+                client_device->dram_grid_size() == CoreCoord(server_dram_grid_x_, server_dram_grid_y_),
+            "fabric-direct PUT requires identical client/server DRAM bank layout "
+            "(client num_dram_channels={}, server={})",
+            client_device->num_dram_channels(),
+            server_num_dram_channels_);
+
+        ClientRtArgs args{
+            .op_kind = kOpKindPut,
+            .client_l1_base = client_l1_base_,
+            .server_l1_base = server_l1_base_,
+            .server_noc_x = server_noc_x_,
+            .server_noc_y = server_noc_y_,
+            .base_ring_slot_idx = base_ring_slot_idx,
+            .payload_size = chunk0_payload,
+            .route_word_to_server = route_word_to_server_,
+            .num_chunks = num_chunks,
+            .total_value_len = total_value_len,
+            .client_dram_addr = client_dram_addr,
+            .logical_page_size = logical_page_size,
+            .tensor_slot_id = recv_buf_base_,
+        };
+
+        Program program = CreateProgram();
+        CoreRange core_range(kClientCore, kClientCore);
+
+        // RISCV_1 sends the control packet and reader-filled value-ring entries.
+        KernelHandle writer_id = CreateKernel(
+            program,
+            kPutWriterKernelPath,
+            core_range,
+            DataMovementConfig{
+                .processor = DataMovementProcessor::RISCV_1,
+                .noc = NOC::RISCV_1_default,
+                .defines = client_kernel_defines(KvcacheKernelTarget::ClientPut)});
+
+        std::vector<uint32_t> writer_args = to_vec(args, client_token_);
+        // PUT chunk-0 construct extras, appended after the base RT args and before the fabric
+        // connection args (fabric args must stay last).
+        writer_args.push_back(chunk0.stream_id_seq);
+        writer_args.push_back(chunk0.num_pages);
+        writer_args.push_back(chunk0.dtype);
+        writer_args.push_back(chunk0.layout);
+        writer_args.push_back(chunk0.rank);
+        for (uint32_t d = 0; d < protocol::kTensorShapeMaxRank; ++d) {
+            writer_args.push_back(chunk0.shape[d]);
+        }
+        writer_args.push_back(chunk0.key_len);
+        for (uint32_t w = 0; w < 32; ++w) {
+            writer_args.push_back(chunk0.key_words[w]);
+        }
+        append_server_connection_rt_args(program, writer_args);
+        SetRuntimeArgs(program, writer_id, kClientCore, writer_args);
+
+        // RISCV_0 fills value-ring entries from Client DRAM and opens no Fabric connection.
+        auto reader_defines = client_kernel_defines(KvcacheKernelTarget::ClientPut);
+        if (test_fault_ == ClientOperationsTestFault::PutReaderTridPollution) {
+            reader_defines.emplace("KVM_INJECT_PUT_READER_TRID_POLLUTION", "1");
+        }
+        KernelHandle reader_id = CreateKernel(
+            program,
+            kPutReaderKernelPath,
+            core_range,
+            DataMovementConfig{
+                .processor = DataMovementProcessor::RISCV_0, .noc = NOC::RISCV_0_default, .defines = reader_defines});
+        std::vector<uint32_t> reader_args = {
+            client_l1_base_, num_chunks, total_value_len, client_dram_addr, logical_page_size};
+        SetRuntimeArgs(program, reader_id, kClientCore, reader_args);
+
+        put_prog_.workload = std::make_unique<MeshWorkload>();
+        put_prog_.workload->add_program(chip_range_, std::move(program));
+        put_prog_.kernel_id = writer_id;
+        put_prog_.secondary_id = reader_id;
+    } else {
+        Program& program = put_prog_.workload->get_programs().at(chip_range_);
+        RuntimeArgsData& w = GetRuntimeArgs(program, put_prog_.kernel_id, kClientCore);
+        w[kRtaBaseRingSlot] = base_ring_slot_idx;
+        w[kRtaPayloadSize] = chunk0_payload;
+        w[kRtaNumChunks] = num_chunks;
+        w[kRtaTotalValueLen] = total_value_len;
+        w[kRtaClientDramAddr] = client_dram_addr;
+        w[kRtaLogicalPageSize] = logical_page_size;
+        w[kRtaPutStreamSeq] = chunk0.stream_id_seq;
+        w[kRtaPutNumPages] = chunk0.num_pages;
+        w[kRtaPutDtype] = chunk0.dtype;
+        w[kRtaPutLayout] = chunk0.layout;
+        w[kRtaPutRank] = chunk0.rank;
+        for (uint32_t d = 0; d < protocol::kTensorShapeMaxRank; ++d) {
+            w[kRtaPutShape + d] = chunk0.shape[d];
+        }
+        w[kRtaPutKeyLen] = chunk0.key_len;
+        for (uint32_t wi = 0; wi < 32; ++wi) {
+            w[kRtaPutKeyWords + wi] = chunk0.key_words[wi];
+        }
+        RuntimeArgsData& r = GetRuntimeArgs(program, put_prog_.secondary_id, kClientCore);
+        r[kRtaPutReaderNumChunks] = num_chunks;
+        r[kRtaPutReaderTotalValueLen] = total_value_len;
+        r[kRtaPutReaderClientDramAddr] = client_dram_addr;
+        r[kRtaPutReaderLogicalPageSize] = logical_page_size;
+    }
+    if (!put_prog_.compiled) {
+        Program& program = put_prog_.workload->get_programs().at(chip_range_);
+        tt::tt_metal::detail::CompileProgram(client_submesh_, program);
+        put_prog_.compiled = true;
+    }
+    const auto t_build1 = std::chrono::steady_clock::now();
+
+    const auto t_enq0 = std::chrono::steady_clock::now();
+    enqueue_request(*put_prog_.workload, /*blocking=*/false, request);
+    const auto t_enq1 = std::chrono::steady_clock::now();
+
+    wait_for_client_chip();
+    const auto t_fin1 = std::chrono::steady_clock::now();
+
+    if (kvcache_profile_) {
+        const uint64_t build_ns = std::chrono::duration_cast<std::chrono::nanoseconds>(t_build1 - t_build0).count();
+        const uint64_t enqueue_ns = std::chrono::duration_cast<std::chrono::nanoseconds>(t_enq1 - t_enq0).count();
+        const uint64_t finish_ns = std::chrono::duration_cast<std::chrono::nanoseconds>(t_fin1 - t_enq1).count();
+        log_info(
+            tt::LogOp,
+            "KVCACHE_HOST[put_launch] num_chunks={} total_value_len={} build_ns={} enqueue_ns={} finish_ns={}",
+            num_chunks,
+            total_value_len,
+            build_ns,
+            enqueue_ns,
+            finish_ns);
+    }
+    return PutLaunchTiming{
+        .program_ns =
+            static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(t_build1 - t_build0).count()),
+        .enqueue_ns =
+            static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(t_enq1 - t_enq0).count()),
+        .landed_wait_ns =
+            static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(t_fin1 - t_enq1).count()),
+    };
+}
