@@ -0,0 +1,96 @@
+// SPDX-FileCopyrightText: (c) 2026 Moreh
+//
+// SPDX-License-Identifier: Apache-2.0
+
+#include "kvcache_manager_nanobind.hpp"
+
+#include <cstdint>
+#include <vector>
+
+#include <nanobind/nanobind.h>
+#include <nanobind/stl/vector.h>
+
+#include "common/protocol/layout.hpp"
+#include "gather/gather.hpp"
+
+namespace ttnn::operations::kvcache_manager {
+namespace {
+
+void bind_kvcache_gather(nb::module_& module) {
+    module.def(
+        "gather_tp_shards_to_chip",
+        &gather_tp_shards_to_chip,
+        nb::arg("members"),
+        nb::arg("dst"),
+        nb::arg("master_coord"),
+        nb::arg("rank_coords"),
+        nb::arg("block_ids"),
+        nb::arg("shard_block_bytes"),
+        nb::arg("region_bases"),
+        nb::arg("header_words") = std::vector<uint32_t>{},
+        R"doc(
+            Gather TP shards onto the master chip over Fabric without a host round trip.
+            The result is block-major then rank-major and the call is blocking.
+        )doc");
+    module.def(
+        "scatter_chunk_from_chip",
+        &scatter_chunk_from_chip,
+        nb::arg("src"),
+        nb::arg("members"),
+        nb::arg("master_coord"),
+        nb::arg("rank_coords"),
+        nb::arg("block_ids"),
+        nb::arg("shard_block_bytes"),
+        nb::arg("region_bases"),
+        R"doc(
+            Scatter a master-chip chunk back into each rank's cache blocks. The call is blocking.
+        )doc");
+    module.def(
+        "pack_local_shards",
+        &pack_local_shards,
+        nb::arg("members"),
+        nb::arg("dst"),
+        nb::arg("coords"),
+        nb::arg("block_ids"),
+        nb::arg("shard_block_bytes"),
+        nb::arg("region_bases"),
+        nb::arg("header_words") = std::vector<uint32_t>{},
+        R"doc(
+            Pack each chip's local shard into its local destination replica in one workload.
+        )doc");
+    module.def(
+        "unpack_local_shards",
+        &unpack_local_shards,
+        nb::arg("src"),
+        nb::arg("members"),
+        nb::arg("coords"),
+        nb::arg("block_ids"),
+        nb::arg("shard_block_bytes"),
+        nb::arg("region_bases"),
+        R"doc(
+            Unpack each chip's local source replica into its cache blocks in one workload.
+        )doc");
+    module.def(
+        "reserve_gather_resources",
+        &reserve_gather_resources,
+        nb::arg("mesh_device"),
+        R"doc(
+            Reserve the per-chip L1 resources required by gather and scatter operations.
+        )doc");
+    module.def(
+        "release_gather_resources",
+        &release_gather_resources,
+        nb::arg("mesh_device"),
+        R"doc(
+            End the gather/scatter resource lifetime for a mesh and release its L1 reservation.
+        )doc");
+}
+
+}  // namespace
+
+void bind_kvcache_manager(nb::module_& mod) {
+    mod.attr("MAX_CLIENTS") = protocol::kMaxClients;
+    bind_kvcache_gather(mod);
+}
+
+}  // namespace ttnn::operations::kvcache_manager
