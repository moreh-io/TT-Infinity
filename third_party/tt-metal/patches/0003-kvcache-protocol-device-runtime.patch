+            if (is_put_publish) {
+                uint32_t published = 0;
+                const bool stream_matches = put_stream_prefix_ready && put_stream_slot == req_aux0;
+                const bool fallback_progress_matches =
+                    put_fallback_progress_pending && put_fallback_progress_slot == req_aux0;
+                const bool reservation_matches = directory_state[kDirReservedSlotWord] == req_aux0;
+                ASSERT(!(stream_matches && fallback_progress_matches));
+                ASSERT(!put_stream_prefix_ready || stream_matches);
+                ASSERT(!put_fallback_progress_pending || fallback_progress_matches);
+                ASSERT(reservation_matches);
+                if (req_key_len > 0 && req_key_len <= max_key_len && req_output_capacity_bytes > 0 &&
+                    req_aux0 < max_keys && reservation_matches) {
+                    published = publish_pending_put(
+                                    req_aux0,
+                                    req_aux1,
+                                    req_aux2,
+                                    req_aux3,
+                                    req_output_capacity_bytes,
+                                    req_key_len,
+                                    req_key,
+                                    stream_matches,
+                                    max_keys,
+                                    dir_entry_stride,
+                                    dir_gen,
+                                    commit_entry_staging_addr,
+                                    num_buckets,
+                                    hash_gen,
+                                    hash_probe_staging,
+                                    put_host_queue_gen,
+                                    put_host_queue_tail,
+                                    put_host_queue_count,
+                                    epoch,
+                                    residency_lru,
+                                    allocator,
+                                    live_device_bytes,
+                                    pending_device_bytes)
+                                    ? kPutGrantGranted
+                                    : 0;
+                }
+                ASSERT(live_device_bytes <= value_heap_bytes);
+                ASSERT(pending_device_bytes <= live_device_bytes);
+                if (published == kPutGrantGranted) {
+                    directory_state[kDirReservedSlotWord] = kResidencyLruNone;
+                    force_put_host_commit = false;
+                    if (stream_matches) {
+                        // The directory is now landed-visible while the final host group remains private.
+                        put_stream_prefix_ready = false;
+                        put_stream_tail_pending = true;
+                        put_stream_pending_token = req_aux3;
+                    } else if (fallback_progress_matches) {
+                        // Word 0 fenced every word-1 event before publish, so the skipped stream can
+                        // advance its cumulative baseline without polling each event.
+                        direct_progress_seen += put_fallback_progress_events;
+                        put_fallback_progress_pending = false;
+                        put_fallback_progress_slot = kBucketDirSlotEmpty;
+                        put_fallback_progress_events = 0;
+                    }
+                } else if (put_host_queue_count != 0) {
+                    force_put_host_commit = true;
+                }
+
+                const uint64_t resp_noc = get_noc_addr(my_x[noc_index], my_y[noc_index], resp_mailbox_addr);
+                for (uint32_t word = 0; word < kDirRespMailboxSize / sizeof(uint32_t); ++word) {
+                    noc_inline_dw_write(resp_noc + word * sizeof(uint32_t), word == 0 ? published : 0);
+                }
+                noc_async_write_barrier();
+                noc_semaphore_inc(done_sem_noc, 1);
+                noc_async_atomic_barrier();
+                continue;
+            }
+
+            uint32_t found = 0;
+            uint32_t total_value_len = 0;
+            uint32_t num_chunks = 1;                  // not-found / empty value advertises a single chunk
+            uint32_t home_slot = 0;                   // entry index (for last_access / REMOVE write-back / MOVE)
+            uint32_t value_byte_off = 0;              // value heap byte offset (returned to NCRISC / MOVE)
+            uint32_t hit_staging_addr = 0;            // L1 staging address of the matched entry
+            uint32_t hit_location = kLocationDevice;  // tier of the matched entry (for MOVE)
+            uint32_t get_access_epoch = 0;            // reserved before response, persisted before next request
+            bool get_access_stamp_pending = false;
+            // A host-tier GET fills one cache block while streaming the same bytes to the client.
+            bool serve_from_host = false;
+            bool direct_pool_serve = false;
+            bool host_cache_block = false;
+            bool host_cache_committed = false;
+            bool get_stream_aborted = false;
+            uint32_t host_cache_order = 0;
+            uint32_t host_cache_value_off = 0;
