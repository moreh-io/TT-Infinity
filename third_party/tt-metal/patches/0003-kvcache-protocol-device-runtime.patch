+#include <tt-metalium/mesh_workload.hpp>
+#include <tt-metalium/tt_metal.hpp>
+
+#include "../common/fabric_helpers.hpp"
+#include "../common/protocol/layout.hpp"
+
+namespace ttnn::operations::kvcache_manager {
+
+using namespace tt::tt_metal;
+using namespace tt::tt_metal::distributed;
+
+namespace {
+
+constexpr CoreCoord kGatherCore{0, 0};
+constexpr uint32_t kDoneCounterBytes = 16;  // one NoC-granular word
+// One 20 KiB slot holds the common 17,408 B shard block in a single DRAM read. Fabric sends may
+// still split that read at destination-page and MTU boundaries.
+constexpr uint32_t kScratchSliceBytes = 20 * 1024;
+constexpr uint64_t kUint32AddressSpaceBytes = uint64_t{1} << 32;
+
+// Watchdog budget for the completion wait, in polls. Sized to be unmistakably longer than any real
+// gather (which lands in microseconds) while still ending in finite time. A wait that exhausts this
+// is a bug, not a slow run -- see gather_wait_kernel for why an unbounded spin is so costly.
+constexpr uint32_t kWaitMaxSpins = 2000000000u;
+
+const std::string kPushKernelPath =
+    "ttnn/cpp/ttnn/operations/kvcache_manager/gather/device/kernels/dataflow/gather_push_kernel.cpp";
+const std::string kScatterKernelPath =
+    "ttnn/cpp/ttnn/operations/kvcache_manager/gather/device/kernels/dataflow/scatter_push_kernel.cpp";
+const std::string kWaitKernelPath =
+    "ttnn/cpp/ttnn/operations/kvcache_manager/gather/device/kernels/dataflow/gather_wait_kernel.cpp";
+
+// A tensor these ops can address: allocated, DRAM, interleaved (the kernels' InterleavedAddrGen
+// page cursor assumes it).
+void validate_tensor(const Tensor& t, const char* role) {
+    TT_FATAL(t.storage_type() == StorageType::DEVICE, "{}: tensor must be on device", role);
+    TT_FATAL(t.is_allocated(), "{}: tensor must be allocated", role);
+    TT_FATAL(t.memory_config().buffer_type() == BufferType::DRAM, "{}: tensor must live in DRAM", role);
+    TT_FATAL(
+        t.memory_config().memory_layout() == TensorMemoryLayout::INTERLEAVED, "{}: tensor must be INTERLEAVED", role);
+}
+
+struct ChunkGeometry {
+    MeshDevice* mesh = nullptr;
+    uint32_t num_ranks = 0;
+    uint32_t block_bytes = 0;
+    uint32_t blob_addr = 0;  // the master-chip side: gather destination / scatter source
+    uint32_t blob_page = 0;
+    uint64_t blob_bytes = 0;
+};
+
+uint32_t checked_u32(uint64_t value, const char* op, const char* field) {
+    TT_FATAL(
+        value <= std::numeric_limits<uint32_t>::max(),
+        "{}: {} {} cannot be represented by a uint32_t kernel argument",
+        op,
+        field,
+        value);
+    return static_cast<uint32_t>(value);
+}
+
+uint32_t checked_header_bytes(size_t word_count, const char* op) {
+    TT_FATAL(
+        word_count <= std::numeric_limits<uint32_t>::max() / sizeof(uint32_t),
+        "{}: {} header words exceed the uint32_t kernel ABI",
+        op,
+        word_count);
+    return static_cast<uint32_t>(word_count * sizeof(uint32_t));
+}
+
+// Shared validation for both directions. `blob` is the master-chip tensor and `members` the
+// per-rank cache tensors; the two ops differ only in which of them is read.
+ChunkGeometry validate_chunk(
+    const Tensor& blob,
+    const std::vector<Tensor>& members,
+    const MeshCoordinate& master_coord,
+    const std::vector<uint32_t>& block_ids,
+    uint32_t shard_block_bytes,
+    const std::vector<uint32_t>& region_bases,
+    const std::vector<MeshCoordinate>& rank_coords,
+    uint32_t header_bytes,
+    const char* op) {
+    TT_FATAL(!rank_coords.empty(), "{}: rank_coords must not be empty", op);
+    TT_FATAL(!members.empty(), "{}: members must not be empty", op);
+    TT_FATAL(
+        members.size() == region_bases.size(),
+        "{}: {} members but {} region bases",
+        op,
+        members.size(),
+        region_bases.size());
+    TT_FATAL(!block_ids.empty(), "{}: block_ids must not be empty", op);
+    TT_FATAL(
+        members.size() <= std::numeric_limits<uint32_t>::max(),
+        "{}: {} members exceed the uint32_t kernel ABI",
+        op,
+        members.size());
+    TT_FATAL(
+        rank_coords.size() <= std::numeric_limits<uint32_t>::max(),
+        "{}: {} ranks exceed the uint32_t kernel ABI",
+        op,
+        rank_coords.size());
+    TT_FATAL(
+        block_ids.size() <= std::numeric_limits<uint32_t>::max(),
+        "{}: {} block IDs exceed the uint32_t kernel ABI",
+        op,
+        block_ids.size());
+    // Every run is both written by a fabric write (16-byte granular) and read by a DRAM NoC read,
+    // and the read rounds its source address DOWN to a 32-byte boundary. A 16-byte-aligned region
+    // therefore reads the wrong window instead of failing, so require 32 throughout (README §4).
+    TT_FATAL(
+        shard_block_bytes != 0 && shard_block_bytes % 32 == 0,
+        "{}: shard_block_bytes {} must be nonzero and 32-byte aligned",
+        op,
+        shard_block_bytes);
+    TT_FATAL(header_bytes % 32 == 0, "{}: header must be 32-byte aligned, got {} B", op, header_bytes);
+
+    validate_tensor(blob, op);
+    ChunkGeometry g;
+    g.mesh = blob.device();
+    TT_FATAL(g.mesh != nullptr, "{}: tensor has no mesh device", op);
+    validate_kvcache_fabric_config(op);
+
+    const auto& shape = g.mesh->shape();
+    TT_FATAL(
+        shape.dims() == master_coord.dims() && MeshCoordinateRange(shape).contains(master_coord),
+        "{}: master_coord {} is outside mesh shape {}",
+        op,
+        master_coord,
+        shape);
+
+    const MeshCoordinateRange mesh_range(shape);
+    for (const auto& coord : rank_coords) {
+        TT_FATAL(
+            shape.dims() == coord.dims() && mesh_range.contains(coord),
+            "{}: rank coordinate {} is outside mesh shape {}",
+            op,
+            coord,
+            shape);
+    }
+    g.num_ranks = static_cast<uint32_t>(rank_coords.size());
+    g.block_bytes = checked_u32(static_cast<uint64_t>(shard_block_bytes) * g.num_ranks, op, "combined block size");
+    g.blob_addr = checked_u32(blob.mesh_buffer().address(), op, "blob address");
+    g.blob_page = checked_u32(blob.mesh_buffer().page_size(), op, "blob page size");
+    TT_FATAL(g.blob_page != 0, "{}: blob page size must not be zero", op);
+    TT_FATAL(g.blob_page % 32 == 0, "{}: blob page size {} must be 32-byte aligned", op, g.blob_page);
+    TT_FATAL(
+        header_bytes <= g.blob_page,
+        "{}: {} B header exceeds the {} B blob page and cannot be written as one interleaved page",
+        op,
+        header_bytes,
+        g.blob_page);
+    g.blob_bytes = blob.mesh_buffer().device_local_size();
+
+    const uint32_t max_block = *std::max_element(block_ids.begin(), block_ids.end());
+    const uint64_t source_end = (static_cast<uint64_t>(max_block) + 1) * shard_block_bytes;
+    TT_FATAL(
+        source_end <= kUint32AddressSpaceBytes,
+        "{}: source block {} ends at {} B, beyond the uint32_t kernel address space",
+        op,
+        max_block,
+        source_end);
+    for (size_t m = 0; m < members.size(); ++m) {
+        validate_tensor(members[m], op);
+        TT_FATAL(members[m].device() == g.mesh, "{}: every member must live on the same mesh", op);
+        const uint32_t member_page = checked_u32(members[m].mesh_buffer().page_size(), op, "member page size");
+        TT_FATAL(member_page != 0, "{}: member {} page size must not be zero", op, m);
+        TT_FATAL(member_page % 32 == 0, "{}: member {} page size {} must be 32-byte aligned", op, m, member_page);
+        TT_FATAL(region_bases[m] % 32 == 0, "{}: region base {} must be 32-byte aligned", op, region_bases[m]);
+        TT_FATAL(
+            region_bases[m] >= header_bytes,
+            "{}: member {}'s region at {} B overlaps the {} B header",
+            op,
+            m,
+            region_bases[m],
+            header_bytes);
+        const uint64_t member_bytes = members[m].mesh_buffer().device_local_size();
+        TT_FATAL(
+            source_end <= member_bytes,
+            "{}: block {} reaches past member {}'s {} B shard",
+            op,
+            max_block,
+            m,
+            member_bytes);
+        const uint64_t end =
+            static_cast<uint64_t>(region_bases[m]) + static_cast<uint64_t>(block_ids.size()) * g.block_bytes;
+        TT_FATAL(
+            end <= g.blob_bytes, "{}: member {}'s region ends at {} B, past the {} B blob", op, m, end, g.blob_bytes);
+        TT_FATAL(
+            end <= kUint32AddressSpaceBytes,
+            "{}: member {}'s region ends at {} B, beyond the uint32_t kernel address space",
+            op,
+            m,
+            end);
+    }
+    return g;
+}
+
+// Completion counter and payload staging, allocated lockstep so every chip agrees on their
+// addresses (a sender writes its peer's counter by address).
+//
+// These are allocated ONCE per mesh and kept for its lifetime -- see reserve_gather_resources.
+// Allocating them per call is not merely wasteful, it is the documented-unsafe pattern that
+// tt_metal warns about (allocator.cpp: "Allocating device buffers whose contents must persist
+// across trace replay ... after a trace has been captured is unsafe"). The completion counter IS
+// such a buffer: a trace replaying on the same chip can land on the L1 the allocator handed us,
+// clobber the counter, and leave gather_wait_kernel spinning forever -- which strands a blocking
+// EnqueueMeshWorkload holding the mesh-wide API mutex and freezes every thread on the device.
+std::shared_ptr<MeshBuffer> make_l1_buffer(MeshDevice* mesh, uint32_t bytes, CoreCoord core = kGatherCore) {
+    auto shard = ShardSpecBuffer(CoreRangeSet(CoreRange(core)), {1, 1}, ShardOrientation::ROW_MAJOR, {1, 1}, {1, 1});
+    DeviceLocalBufferConfig local{
+        .page_size = bytes,
+        .buffer_type = BufferType::L1,
+        .sharding_args = BufferShardingArgs(shard, TensorMemoryLayout::HEIGHT_SHARDED),
+        .bottom_up = false,
+        .sub_device_id = std::nullopt,
+    };
+    ReplicatedBufferConfig global{.size = bytes};
+    return MeshBuffer::create(global, local, mesh);
+}
+
+// Enqueue a completion-counter reset before the workload that will increment it.
+//
+// The waiter resets the counter when it is satisfied, so a clean run leaves it at zero and this is
+// redundant. It is done every time anyway because a run that DIED between the increment and the
+// reset (a failed op, a killed process) leaves it dirty, and a dirty counter makes the next gather
+// wait for an increment that already happened -- a hang indistinguishable from the one this file
+// exists to avoid. 16 bytes per call is a cheap way to make that unreachable.
+//
+// Keep this write on the same command queue as the workload. A direct host L1 write is posted on
+// MMIO chips and can otherwise land after a kernel's atomic increment, erasing its completion.
+void enqueue_counter_reset(
+    MeshCommandQueue& mesh_cq, const std::shared_ptr<MeshBuffer>& done_buf, const MeshCoordinate& coord) {
+    std::vector<uint32_t> zero(kDoneCounterBytes / sizeof(uint32_t), 0);
+    WriteShard(mesh_cq, done_buf, zero, coord, /*blocking=*/false);
+}
+
+// Confirm the wait kernel finished rather than giving up on its watchdog.
+//
+// The kernel reports this in word 1, not by leaving the count behind: a wait that timed out having
+// received nothing leaves the count at zero, exactly what a satisfied waiter writes. Word 1 makes
+// abort distinguishable no matter how many senders were expected -- which matters most for the
+// single-sender waits (per-chip gather, and every scatter receiver), where the count alone can
+// never distinguish anything at all.
+//
+// Without this the workload completes either way and the caller uses a partly gathered chunk as if
+// it were whole -- the one outcome worse than the hang the watchdog replaced.
+void verify_wait_completed(
+    MeshDevice* mesh, const MeshCoordinate& coord, uint32_t addr, uint32_t expected, const char* op) {
+    // Test-only seam (README §11 lists the KVM_*_TEST_* variables as fault-injection / measurement
+    // hooks, never for production). Each check is a host L1 read per waiting chip, so this exists to
+    // measure what that costs -- turning it off gives up the only signal that separates a complete
+    // gather from one the watchdog abandoned.
+    static const bool skip = config::read_bool_env("KVM_GATHER_TEST_SKIP_WAIT_VERIFY").value_or(false);
+    if (skip) {
+        return;
+    }
+    // Scope the pre-read barrier to the one core we read. The default barriers every Tensix and eth
+    // core on the chip, while only kGatherCore owns this counter and the blocking enqueue has
+    // already completed.
+    std::array<uint32_t, kDoneCounterBytes / sizeof(uint32_t)> words{};
+    tt::tt_metal::detail::ReadFromDeviceL1(
+        mesh->get_device(coord),
+        kGatherCore,
+        addr,
+        std::span<uint8_t>(reinterpret_cast<uint8_t*>(words.data()), kDoneCounterBytes),
+        tt::CoreType::WORKER,
+        /*barrier_scoped_to_core=*/true);
+    TT_FATAL(
+        words[1] == 0,
+        "{}: completion wait at {} gave up with {} of {} senders landed. The chunk is incomplete and must not be "
+        "used -- an expected fabric write or local copy never arrived.",
+        op,
+        coord,
+        words[0],
+        expected);
+    TT_FATAL(
+        words[0] == 0,
+        "{}: completion counter at {} is {} after a successful wait; expected it cleared. Another writer is using "
+        "this L1.",
+        op,
+        coord,
+        words[0]);
+}
+
+// Worker cores split the all-local pack/unpack copies so independent NoC engines can progress in
+// parallel. Fabric-facing single-coordinate paths stay on core (0,0), where the completion-counter
+// protocol lives.
+constexpr uint32_t kNumPackCores = 4;
+
+uint32_t scatter_core_count() {
+    static const uint32_t value = [] {
+        uint32_t count = kNumPackCores;
+        if (const char* setting = std::getenv("KVM_SCATTER_CORES")) {
+            const long parsed = std::strtol(setting, nullptr, 10);
+            if (parsed >= 1 && parsed <= static_cast<long>(kNumPackCores)) {
+                count = static_cast<uint32_t>(parsed);
+            }
+        }
+        return count;
+    }();
+    return value;
+}
+
+// One reservation per mesh, kept alive for the mesh's lifetime. The scratch is ONE buffer
+// height-sharded across the kNumPackCores cores of row 0: every core sees its own 2-slot slice
+// at the SAME address. One buffer, not one per core, because the L1 allocator carves the chip's
+// shared address space; separate buffers would each reserve a chip-wide address range and consume
+// substantially more model-visible L1.
+struct GatherResources {
+    GatherResources(std::shared_ptr<MeshBuffer> done, std::shared_ptr<MeshBuffer> scratch) :
+        done_buf(std::move(done)), scratch_buf(std::move(scratch)) {}
+
+    std::shared_ptr<MeshBuffer> done_buf;
+    std::shared_ptr<MeshBuffer> scratch_buf;
+    std::mutex operation_mutex;
+    size_t active_operations = 0;  // guarded by gather_resource_mutex()
+    bool releasing = false;        // guarded by gather_resource_mutex()
+};
+
+std::shared_ptr<MeshBuffer> make_scratch_buffer(MeshDevice* mesh) {
+    const uint32_t per_core = 2 * kScratchSliceBytes;
+    auto shard = ShardSpecBuffer(
+        CoreRangeSet(CoreRange(kGatherCore, CoreCoord{kNumPackCores - 1, 0})),
+        {1, 1},
+        ShardOrientation::ROW_MAJOR,
+        {1, 1},
+        {kNumPackCores, 1});
+    DeviceLocalBufferConfig local{
+        .page_size = per_core,
+        .buffer_type = BufferType::L1,
+        .sharding_args = BufferShardingArgs(shard, TensorMemoryLayout::HEIGHT_SHARDED),
+        .bottom_up = false,
+        .sub_device_id = std::nullopt,
+    };
+    ReplicatedBufferConfig global{.size = kNumPackCores * per_core};
+    return MeshBuffer::create(global, local, mesh);
+}
+
+std::shared_ptr<GatherResources> make_gather_resources(MeshDevice* mesh) {
+    return std::make_shared<GatherResources>(make_l1_buffer(mesh, kDoneCounterBytes), make_scratch_buffer(mesh));
+}
+
+std::mutex& gather_resource_mutex() {
+    static std::mutex m;
+    return m;
+}
+
+std::condition_variable& gather_resource_condition() {
+    static std::condition_variable cv;
+    return cv;
+}
+
+std::map<MeshDevice*, std::shared_ptr<GatherResources>>& gather_resource_registry() {
+    static std::map<MeshDevice*, std::shared_ptr<GatherResources>> registry;
+    return registry;
+}
+
+std::set<MeshDevice*>& released_gather_meshes() {
+    static std::set<MeshDevice*> meshes;
+    return meshes;
+}
+
+// Holds both resource ownership and exclusive use through enqueue and completion verification.
+// release_gather_resources waits for every acquired operation before returning, so a caller may
+// close the mesh immediately afterward. A new operation racing release fails and requires an
+// explicit reserve to begin another lifetime.
+class GatherOperation {
+public:
+    explicit GatherOperation(MeshDevice* mesh) : mesh_(mesh) {
+        std::unique_lock<std::mutex> registry_lock(gather_resource_mutex());
+        auto& registry = gather_resource_registry();
+        TT_FATAL(
+            released_gather_meshes().count(mesh_) == 0,
+            "kvcache gather: resources for this mesh were released; call reserve_gather_resources() before "
+            "starting another operation");
+        auto it = registry.find(mesh_);
+        if (it == registry.end()) {
+            log_warning(
+                tt::LogOp,
+                "kvcache gather: staging buffers were not reserved before first use; allocating now. If a "
+                "trace has already been captured on this mesh, this allocation is unsafe -- call "
+                "reserve_gather_resources() during setup instead.");
+            it = registry.emplace(mesh_, make_gather_resources(mesh_)).first;
+        }
+        TT_FATAL(
+            !it->second->releasing,
+            "kvcache gather: release_gather_resources() is already closing this mesh's operation lifetime");
+        resources_ = it->second;
+        ++resources_->active_operations;
+        registry_lock.unlock();
+
+        try {
+            resources_->operation_mutex.lock();
+            operation_locked_ = true;
+        } catch (...) {
+            finish();
+            throw;
+        }
+    }
+
+    GatherOperation(const GatherOperation&) = delete;
+    GatherOperation& operator=(const GatherOperation&) = delete;
+
+    ~GatherOperation() {
+        if (operation_locked_) {
+            resources_->operation_mutex.unlock();
+        }
+        finish();
+    }
+
+    const GatherResources& resources() const { return *resources_; }
+
+private:
+    void finish() {
+        if (!resources_) {
+            return;
+        }
+        std::lock_guard<std::mutex> registry_lock(gather_resource_mutex());
+        TT_ASSERT(resources_->active_operations > 0);
+        --resources_->active_operations;
+        resources_.reset();
+        gather_resource_condition().notify_all();
+    }
+
+    MeshDevice* mesh_ = nullptr;
+    std::shared_ptr<GatherResources> resources_;
+    bool operation_locked_ = false;
+};
+
+void append_member_args(
+    std::vector<uint32_t>& args,
+    const std::vector<Tensor>& members,
+    const std::vector<uint32_t>& region_bases,
+    const char* op) {
+    for (size_t m = 0; m < members.size(); ++m) {
+        args.push_back(checked_u32(members[m].mesh_buffer().address(), op, "member address"));
+        const uint32_t page_size = checked_u32(members[m].mesh_buffer().page_size(), op, "member page size");
+        TT_FATAL(page_size != 0, "{}: member {} page size must not be zero", op, m);
+        args.push_back(page_size);
+        args.push_back(region_bases[m]);
+    }
+}
+
+}  // namespace
+
+void gather_tp_shards_to_chip(
+    const std::vector<Tensor>& members,
+    const Tensor& dst,
+    const MeshCoordinate& master_coord,
+    const std::vector<MeshCoordinate>& rank_coords,
+    const std::vector<uint32_t>& block_ids,
+    uint32_t shard_block_bytes,
+    const std::vector<uint32_t>& region_bases,
+    const std::vector<uint32_t>& header_words) {
+    const uint32_t header_bytes = checked_header_bytes(header_words.size(), "kvcache gather");
+    const ChunkGeometry g = validate_chunk(
+        dst,
+        members,
+        master_coord,
+        block_ids,
+        shard_block_bytes,
+        region_bases,
+        rank_coords,
+        header_bytes,
+        "kvcache gather");
+    TT_FATAL(
+        header_bytes <= kScratchSliceBytes,
+        "kvcache gather: {} B header exceeds the {} B staging slice",
+        header_bytes,
+        kScratchSliceBytes);
+
+    GatherOperation operation(g.mesh);
+    const auto& res = operation.resources();
+    const uint32_t done_addr = static_cast<uint32_t>(res.done_buf->address());
+    const uint32_t scratch_addr = static_cast<uint32_t>(res.scratch_buf->address());
+    auto& mesh_cq = g.mesh->mesh_command_queue();
+    enqueue_counter_reset(mesh_cq, res.done_buf, master_coord);
+
+    IDevice* master_device = g.mesh->get_device(master_coord);
+    TT_FATAL(master_device != nullptr, "kvcache gather: mesh has no chip at master_coord");
+    const CoreCoord master_noc = master_device->worker_core_from_logical_core(kGatherCore);
+    const auto master_node = g.mesh->get_fabric_node_id(master_coord);
+    const uint32_t route_word = kvcache_unicast_route_word(master_node);
+
+    // Chips that take part: every rank, plus the master when it is not itself a rank (it still
+    // needs the header write and the waiter). Everything else gets no program.
+    std::vector<std::pair<MeshCoordinate, uint32_t>> participants;  // (coord, tp_rank)
+    bool master_is_rank = false;
+    for (uint32_t r = 0; r < rank_coords.size(); ++r) {
+        participants.emplace_back(rank_coords[r], r);
+        master_is_rank = master_is_rank || rank_coords[r] == master_coord;
+    }
+    if (!master_is_rank) {
+        participants.emplace_back(master_coord, 0u);
+    }
+
+    MeshWorkload workload;
+    for (const auto& [coord, rank] : participants) {
+        const bool is_master = coord == master_coord;
+        const bool is_source = is_master ? master_is_rank : true;
+        const auto sender_node = g.mesh->get_fabric_node_id(coord);
+        if (!is_master) {
+            TT_FATAL(
+                is_kvcache_wire_reachable(sender_node, master_node),
+                "kvcache gather: chip at {} cannot reach the master at {} over fabric in both directions",
+                coord,
+                master_coord);
+        }
+
+        Program program = CreateProgram();
+        const CoreRange core_range(kGatherCore, kGatherCore);
+        KernelHandle push_id = CreateKernel(
+            program,
+            kPushKernelPath,
+            core_range,
+            DataMovementConfig{.processor = DataMovementProcessor::RISCV_1, .noc = NOC::RISCV_1_default});
+
+        std::vector<uint32_t> args{
+            is_source ? static_cast<uint32_t>(members.size()) : 0u,
+            static_cast<uint32_t>(block_ids.size()),
+            g.blob_addr,
+            g.blob_page,
+            shard_block_bytes,
+            g.block_bytes,
+            rank,
+            route_word,
+            static_cast<uint32_t>(master_noc.x),
+            static_cast<uint32_t>(master_noc.y),
+            done_addr,
+            scratch_addr,
+            kScratchSliceBytes,
+            is_master ? 1u : 0u,
+            is_master ? header_bytes : 0u,
+        };
+        if (is_master) {
+            args.insert(args.end(), header_words.begin(), header_words.end());
+        }
+        args.insert(args.end(), block_ids.begin(), block_ids.end());
+        if (is_source) {
+            append_member_args(args, members, region_bases, "kvcache gather");
+        }
+        if (!is_master) {
+            tt::tt_fabric::append_fabric_connection_rt_args(
+                sender_node,
+                master_node,
+                kvcache_wire_link_index(sender_node, master_node),
+                program,
+                kGatherCore,
+                args);
+        }
+        SetRuntimeArgs(program, push_id, kGatherCore, args);
+
+        if (is_master) {
+            // The waiter runs beside the master's own push kernel, so the workload does not report
+            // complete until every sender's bytes have landed.
+            KernelHandle wait_id = CreateKernel(
+                program,
+                kWaitKernelPath,
+                core_range,
+                DataMovementConfig{.processor = DataMovementProcessor::RISCV_0, .noc = NOC::RISCV_0_default});
+            SetRuntimeArgs(program, wait_id, kGatherCore, {done_addr, g.num_ranks, kWaitMaxSpins});
+        }
+
+        workload.add_program(MeshCoordinateRange(coord), std::move(program));
+    }
+
+    EnqueueMeshWorkload(mesh_cq, workload, /*blocking=*/true);
+
+    // The master is the only waiter in a gather.
+    verify_wait_completed(g.mesh, master_coord, done_addr, g.num_ranks, "kvcache gather");
+}
+
+void scatter_chunk_from_chip(
+    const Tensor& src,
+    const std::vector<Tensor>& members,
+    const MeshCoordinate& master_coord,
+    const std::vector<MeshCoordinate>& rank_coords,
+    const std::vector<uint32_t>& block_ids,
+    uint32_t shard_block_bytes,
+    const std::vector<uint32_t>& region_bases) {
+    const ChunkGeometry g = validate_chunk(
+        src,
+        members,
+        master_coord,
+        block_ids,
+        shard_block_bytes,
+        region_bases,
+        rank_coords,
+        /*header_bytes=*/0,
+        "kvcache scatter");
+
+    {
+        static std::once_flag once;
+        std::call_once(once, [&] {
+            const uint32_t destination_page =
+                members.empty() ? 0u : static_cast<uint32_t>(members[0].mesh_buffer().page_size());
+            const uint32_t nominal_destination_page_spans =
+                destination_page == 0 ? 0u : (shard_block_bytes + destination_page - 1) / destination_page;
+            log_info(
+                tt::LogOp,
+                "kvcache scatter geometry: members={} blocks={} ranks={} shard_block={} B src_page={} B "
+                "dst_page={} B -> nominal destination-page spans={} per shard; remote sends also split at "
+                "the 4096 B Fabric MTU",
+                members.size(),
+                block_ids.size(),
+                rank_coords.size(),
+                shard_block_bytes,
+                g.blob_page,
+                destination_page,
+                nominal_destination_page_spans);
+        });
+    }
+
+    GatherOperation operation(g.mesh);
+    const auto& res = operation.resources();
+    const uint32_t done_addr = static_cast<uint32_t>(res.done_buf->address());
+    const uint32_t scratch_addr = static_cast<uint32_t>(res.scratch_buf->address());
+    auto& mesh_cq = g.mesh->mesh_command_queue();
+
+    IDevice* master_device = g.mesh->get_device(master_coord);
+    TT_FATAL(master_device != nullptr, "kvcache scatter: mesh has no chip at master_coord");
+    const CoreCoord peer_noc = master_device->worker_core_from_logical_core(kGatherCore);
+    const auto master_node = g.mesh->get_fabric_node_id(master_coord);
+
+    // One connection per unique first-hop direction, shared by every rank behind it: each packet
+    // carries its own absolute route, so the connection only picks the first-hop router.
+    std::map<tt::tt_fabric::eth_chan_directions, uint32_t> direction_to_conn;
+    std::vector<std::vector<uint32_t>> connection_links;
+    std::vector<std::pair<uint32_t, uint32_t>> rank_route_conn;  // (route_word, conn_idx)
+    // The master is a destination like any other only when it is itself one of the ranks; a mesh
+    // with several DP groups scatters from a chip that owns none of the chunk's shards.
+    uint32_t master_rank = static_cast<uint32_t>(rank_coords.size());  // == none of them
+    for (uint32_t rank = 0; rank < rank_coords.size(); ++rank) {
+        const MeshCoordinate& coord = rank_coords[rank];
+        const auto node = g.mesh->get_fabric_node_id(coord);
+        if (coord == master_coord) {
+            master_rank = rank;
+            rank_route_conn.emplace_back(kvcache_unicast_route_word(node), 0u);
+            continue;
+        }
+        TT_FATAL(
+            is_kvcache_wire_reachable(master_node, node),
+            "kvcache scatter: master at {} cannot reach the chip at {} over fabric in both directions",
+            master_coord,
+            coord);
+        const auto dir = kvcache_first_hop_direction(master_node, node);
+        TT_FATAL(dir.has_value(), "kvcache scatter: no forwarding direction from the master to {}", coord);
+        auto peer_links = kvcache_wire_link_indices(master_node, node);
+        auto it = direction_to_conn.find(*dir);
+        uint32_t conn_idx;
+        if (it == direction_to_conn.end()) {
+            conn_idx = static_cast<uint32_t>(direction_to_conn.size());
+            direction_to_conn[*dir] = conn_idx;
+            connection_links.push_back(std::move(peer_links));
+        } else {
+            conn_idx = it->second;
+            auto& common_links = connection_links[conn_idx];
+            common_links.erase(
+                std::remove_if(
+                    common_links.begin(),
+                    common_links.end(),
+                    [&peer_links](uint32_t link) {
+                        return std::find(peer_links.begin(), peer_links.end(), link) == peer_links.end();
+                    }),
+                common_links.end());
+            TT_FATAL(
+                !common_links.empty(),
+                "kvcache scatter: destinations sharing one first-hop direction from the master at {} have no "
+                "common forwarding link plane (latest destination {})",
+                master_coord,
+                coord);
+        }
+        rank_route_conn.emplace_back(kvcache_unicast_route_word(node), conn_idx);
+    }
+    TT_FATAL(
+        direction_to_conn.size() <= protocol::kMaxServerConnections,
+        "kvcache scatter: {} fabric connections needed but the kernel holds at most {}",
+        direction_to_conn.size(),
+        protocol::kMaxServerConnections);
+
+    // The first rank behind each direction is the peer its connection is opened toward; every other
+    // rank on that direction rides the same connection.
+    std::vector<MeshCoordinate> conn_peer(direction_to_conn.size(), master_coord);
+    for (uint32_t r = 0; r < rank_coords.size(); ++r) {
+        if (r == master_rank) {
+            continue;
+        }
+        const uint32_t conn = rank_route_conn[r].second;
+        if (conn_peer[conn] == master_coord) {
+            conn_peer[conn] = rank_coords[r];
+        }
+    }
+
+    std::vector<MeshCoordinate> participants(rank_coords.begin(), rank_coords.end());
+    if (master_rank == rank_coords.size()) {
+        participants.push_back(master_coord);
+    }
+
+    const uint32_t requested_push_cores =
+        std::min<uint32_t>(scatter_core_count(), static_cast<uint32_t>(members.size()));
+    uint32_t push_cores = requested_push_cores;
+    for (const auto& links : connection_links) {
+        push_cores = std::min<uint32_t>(push_cores, static_cast<uint32_t>(links.size()));
+    }
+    TT_FATAL(push_cores > 0, "kvcache scatter: no forwarding link is available to a remote rank");
+    if (push_cores < requested_push_cores) {
+        static std::once_flag once;
+        std::call_once(once, [requested_push_cores, push_cores] {
+            log_info(
+                tt::LogOp,
+                "kvcache scatter: limiting {} requested sender cores to {} because concurrent fabric senders require "
+                "distinct forwarding links",
+                requested_push_cores,
+                push_cores);
+        });
+    }
+
+    MeshWorkload workload;
+    for (const MeshCoordinate& coord : participants) {
+        Program program = CreateProgram();
+        const CoreRange core_range(kGatherCore, kGatherCore);
+
+        if (coord == master_coord) {
+            const CoreRange push_range(kGatherCore, CoreCoord{push_cores - 1, 0});
+            KernelHandle push_id = CreateKernel(
+                program,
+                kScatterKernelPath,
+                push_range,
+                DataMovementConfig{.processor = DataMovementProcessor::RISCV_1, .noc = NOC::RISCV_1_default});
+            for (uint32_t core_index = 0; core_index < push_cores; ++core_index) {
+                const CoreCoord push_core{core_index, 0};
+                const size_t member_begin = members.size() * core_index / push_cores;
+                const size_t member_end = members.size() * (core_index + 1) / push_cores;
+                const std::vector<Tensor> core_members(members.begin() + member_begin, members.begin() + member_end);
+                const std::vector<uint32_t> core_regions(
+                    region_bases.begin() + member_begin, region_bases.begin() + member_end);
+                std::vector<uint32_t> args{
+                    static_cast<uint32_t>(core_members.size()),
+                    static_cast<uint32_t>(block_ids.size()),
+                    g.num_ranks,
+                    g.blob_addr,
+                    g.blob_page,
+                    shard_block_bytes,
+                    g.block_bytes,
+                    master_rank,
+                    static_cast<uint32_t>(peer_noc.x),
+                    static_cast<uint32_t>(peer_noc.y),
+                    done_addr,
+                    scratch_addr,
+                    kScratchSliceBytes,
+                };
+                args.insert(args.end(), block_ids.begin(), block_ids.end());
+                append_member_args(args, core_members, core_regions, "kvcache scatter");
+                for (const auto& [route, conn] : rank_route_conn) {
+                    args.push_back(route);
+                    args.push_back(conn);
+                }
+                args.push_back(static_cast<uint32_t>(direction_to_conn.size()));
+                for (uint32_t conn_idx = 0; conn_idx < conn_peer.size(); ++conn_idx) {
+                    const auto peer_node = g.mesh->get_fabric_node_id(conn_peer[conn_idx]);
+                    const auto& links = connection_links[conn_idx];
+                    tt::tt_fabric::append_fabric_connection_rt_args(
+                        master_node, peer_node, links[core_index], program, push_core, args);
+                }
+                SetRuntimeArgs(program, push_id, push_core, args);
+            }
+        } else {
+            // Every receiver waits for the master's completion event, so workload completion means
+            // the whole scatter landed.
+            enqueue_counter_reset(mesh_cq, res.done_buf, coord);
+            KernelHandle wait_id = CreateKernel(
+                program,
+                kWaitKernelPath,
+                core_range,
+                DataMovementConfig{.processor = DataMovementProcessor::RISCV_0, .noc = NOC::RISCV_0_default});
+            SetRuntimeArgs(program, wait_id, kGatherCore, {done_addr, push_cores, kWaitMaxSpins});
+        }
+
+        workload.add_program(MeshCoordinateRange(coord), std::move(program));
+    }
+
+    EnqueueMeshWorkload(mesh_cq, workload, /*blocking=*/true);
+
+    // Every non-master rank waited for the master's event, so check each of theirs.
+    for (const auto& coord : rank_coords) {
+        if (coord == master_coord) {
+            continue;
+        }
+        verify_wait_completed(g.mesh, coord, done_addr, push_cores, "kvcache scatter");
+    }
+}
+
+void pack_local_shards(
+    const std::vector<Tensor>& members,
+    const Tensor& dst,
+    const std::vector<MeshCoordinate>& coords,
+    const std::vector<uint32_t>& block_ids,
+    uint32_t shard_block_bytes,
+    const std::vector<uint32_t>& region_bases,
+    const std::vector<uint32_t>& header_words) {
+    TT_FATAL(!coords.empty(), "kvcache pack: coords must not be empty");
+    const uint32_t header_bytes = checked_header_bytes(header_words.size(), "kvcache pack");
+    // Every chip packs the same geometry (the blob is replicated and the per-shard plans differ
+    // only in which chip they name), so the byte arithmetic is validated once with one coordinate
+    // standing in as both master and only rank; the rest need only be real, distinct mesh
+    // coordinates.
+    const std::vector<MeshCoordinate> one{coords.front()};
+    const ChunkGeometry g = validate_chunk(
+        dst, members, coords.front(), block_ids, shard_block_bytes, region_bases, one, header_bytes, "kvcache pack");
+    TT_FATAL(
+        header_bytes <= kScratchSliceBytes,
+        "kvcache pack: {} B header exceeds the {} B staging slice",
+        header_bytes,
+        kScratchSliceBytes);
+    const MeshCoordinateRange mesh_range(g.mesh->shape());
+    for (size_t i = 0; i < coords.size(); ++i) {
+        TT_FATAL(mesh_range.contains(coords[i]), "kvcache pack: coordinate {} is outside the mesh", coords[i]);
+        for (size_t j = i + 1; j < coords.size(); ++j) {
+            TT_FATAL(!(coords[i] == coords[j]), "kvcache pack: coordinate {} appears twice", coords[i]);
+        }
+    }
+
+    GatherOperation operation(g.mesh);
+    const auto& res = operation.resources();
+    const uint32_t done_addr = static_cast<uint32_t>(res.done_buf->address());
+    const uint32_t scratch_addr = static_cast<uint32_t>(res.scratch_buf->address());
+    auto& mesh_cq = g.mesh->mesh_command_queue();
+
+    // Split the member list contiguously across worker cores so each chip can use multiple
+    // independent NoC engines. Every core increments the same (0,0) completion counter over the
+    // NoC -- the push kernel already addresses it by RT args -- and the waiter expects one arrival
+    // per active core.
+    const uint32_t active_cores = std::min<uint32_t>(kNumPackCores, static_cast<uint32_t>(members.size()));
+
+    // ONE workload with one program per chip lets every chip pack its own shard at the same time.
+    // Per-coordinate calls would serialize the copies behind blocking enqueues.
+    MeshWorkload workload;
+    for (const auto& coord : coords) {
+        enqueue_counter_reset(mesh_cq, res.done_buf, coord);
+        IDevice* device = g.mesh->get_device(coord);
+        TT_FATAL(device != nullptr, "kvcache pack: mesh has no chip at {}", coord);
+        const CoreCoord counter_noc = device->worker_core_from_logical_core(kGatherCore);
+        const auto node = g.mesh->get_fabric_node_id(coord);
+
+        Program program = CreateProgram();
+        const CoreRange core_range(kGatherCore, CoreCoord{active_cores - 1, 0});
+        KernelHandle push_id = CreateKernel(
+            program,
+            kPushKernelPath,
+            core_range,
+            DataMovementConfig{.processor = DataMovementProcessor::RISCV_1, .noc = NOC::RISCV_1_default});
+        for (uint32_t k = 0; k < active_cores; ++k) {
+            // Balanced partition: boundaries at k*n/active, so no active core ever receives zero
+            // members -- a zero-member push exits without signalling (by design) and the waiter
+            // would then expect one arrival more than can ever come.
+            const uint32_t total = static_cast<uint32_t>(members.size());
+            const uint32_t first = k * total / active_cores;
+            const uint32_t count = (k + 1) * total / active_cores - first;
+            const std::vector<Tensor> member_slice(members.begin() + first, members.begin() + first + count);
+            const std::vector<uint32_t> region_slice(
+                region_bases.begin() + first, region_bases.begin() + first + count);
+            // The same program the single-coordinate path builds when a chip is its own master and
+            // only rank: the push kernel keys fabric use on is_master, so this is a local NoC copy,
+            // and the route word is carried for ABI shape only. Only core 0 writes the value
+            // header; every core signals the shared counter on kGatherCore.
+            const uint32_t core_header_bytes = (k == 0) ? header_bytes : 0u;
+            std::vector<uint32_t> args{
+                count,
+                static_cast<uint32_t>(block_ids.size()),
+                g.blob_addr,
+                g.blob_page,
+                shard_block_bytes,
+                g.block_bytes,  // == shard_block_bytes: one rank per blob
+                /*rank=*/0u,
+                kvcache_unicast_route_word(node),
+                static_cast<uint32_t>(counter_noc.x),
+                static_cast<uint32_t>(counter_noc.y),
+                done_addr,
+                scratch_addr,
+                kScratchSliceBytes,
+                /*is_master=*/1u,
+                core_header_bytes,
+            };
+            if (core_header_bytes != 0) {
+                args.insert(args.end(), header_words.begin(), header_words.end());
+            }
+            args.insert(args.end(), block_ids.begin(), block_ids.end());
+            append_member_args(args, member_slice, region_slice, "kvcache pack");
+            SetRuntimeArgs(program, push_id, CoreCoord{k, 0}, args);
+        }
+
+        KernelHandle wait_id = CreateKernel(
+            program,
+            kWaitKernelPath,
+            CoreRange(kGatherCore, kGatherCore),
+            DataMovementConfig{.processor = DataMovementProcessor::RISCV_0, .noc = NOC::RISCV_0_default});
+        SetRuntimeArgs(program, wait_id, kGatherCore, {done_addr, active_cores, kWaitMaxSpins});
+
+        workload.add_program(MeshCoordinateRange(coord), std::move(program));
+    }
+
+    EnqueueMeshWorkload(mesh_cq, workload, /*blocking=*/true);
+
+    for (const auto& coord : coords) {
+        verify_wait_completed(g.mesh, coord, done_addr, active_cores, "kvcache pack");
+    }
+}
+
+void unpack_local_shards(
+    const Tensor& src,
+    const std::vector<Tensor>& members,
+    const std::vector<MeshCoordinate>& coords,
+    const std::vector<uint32_t>& block_ids,
+    uint32_t shard_block_bytes,
+    const std::vector<uint32_t>& region_bases) {
+    TT_FATAL(!coords.empty(), "kvcache unpack: coords must not be empty");
+    const std::vector<MeshCoordinate> one{coords.front()};
+    const ChunkGeometry g = validate_chunk(
+        src,
+        members,
+        coords.front(),
+        block_ids,
+        shard_block_bytes,
+        region_bases,
+        one,
+        /*header_bytes=*/0,
+        "kvcache unpack");
+    const MeshCoordinateRange mesh_range(g.mesh->shape());
+    for (size_t i = 0; i < coords.size(); ++i) {
+        TT_FATAL(mesh_range.contains(coords[i]), "kvcache unpack: coordinate {} is outside the mesh", coords[i]);
+        for (size_t j = i + 1; j < coords.size(); ++j) {
+            TT_FATAL(!(coords[i] == coords[j]), "kvcache unpack: coordinate {} appears twice", coords[i]);
+        }
+    }
+
+    GatherOperation operation(g.mesh);
+    const auto& res = operation.resources();
+    const uint32_t done_addr = static_cast<uint32_t>(res.done_buf->address());
+    const uint32_t scratch_addr = static_cast<uint32_t>(res.scratch_buf->address());
+
+    // Split members across cores exactly as in pack_local_shards.
+    const uint32_t active_cores = std::min<uint32_t>(kNumPackCores, static_cast<uint32_t>(members.size()));
+
+    // Mirror of pack_local_shards: each chip runs the scatter kernel purely locally (one rank, and
+    // it is the master), so there are no receivers, no waiters, and no fabric connections. Workload
+    // completion is the copies having landed (each core barriers its writes before exiting),
+    // exactly as in the single-coordinate per-chip path.
+    MeshWorkload workload;
+    for (const auto& coord : coords) {
+        IDevice* device = g.mesh->get_device(coord);
+        TT_FATAL(device != nullptr, "kvcache unpack: mesh has no chip at {}", coord);
+        const CoreCoord counter_noc = device->worker_core_from_logical_core(kGatherCore);
+        const auto node = g.mesh->get_fabric_node_id(coord);
+
+        Program program = CreateProgram();
+        const CoreRange core_range(kGatherCore, CoreCoord{active_cores - 1, 0});
+        KernelHandle push_id = CreateKernel(
+            program,
+            kScatterKernelPath,
+            core_range,
+            DataMovementConfig{.processor = DataMovementProcessor::RISCV_1, .noc = NOC::RISCV_1_default});
+        for (uint32_t k = 0; k < active_cores; ++k) {
+            // Balanced partition: boundaries at k*n/active, so no active core ever receives zero
+            // members -- a zero-member push exits without signalling (by design) and the waiter
+            // would then expect one arrival more than can ever come.
+            const uint32_t total = static_cast<uint32_t>(members.size());
+            const uint32_t first = k * total / active_cores;
+            const uint32_t count = (k + 1) * total / active_cores - first;
+            const std::vector<Tensor> member_slice(members.begin() + first, members.begin() + first + count);
+            const std::vector<uint32_t> region_slice(
+                region_bases.begin() + first, region_bases.begin() + first + count);
+            std::vector<uint32_t> args{
+                count,
+                static_cast<uint32_t>(block_ids.size()),
+                /*num_ranks=*/1u,
+                g.blob_addr,
+                g.blob_page,
+                shard_block_bytes,
+                g.block_bytes,
+                /*master_rank=*/0u,
+                static_cast<uint32_t>(counter_noc.x),
+                static_cast<uint32_t>(counter_noc.y),
+                done_addr,
+                scratch_addr,
+                kScratchSliceBytes,
+            };
+            args.insert(args.end(), block_ids.begin(), block_ids.end());
+            append_member_args(args, member_slice, region_slice, "kvcache unpack");
+            args.push_back(kvcache_unicast_route_word(node));  // rank 0's (route, conn) pair
+            args.push_back(0u);
+            args.push_back(0u);  // no fabric connections
+            SetRuntimeArgs(program, push_id, CoreCoord{k, 0}, args);
+        }
+
+        workload.add_program(MeshCoordinateRange(coord), std::move(program));
+    }
+
+    EnqueueMeshWorkload(g.mesh->mesh_command_queue(), workload, /*blocking=*/true);
+}
+
+void reserve_gather_resources(MeshDevice* mesh) {
+    TT_FATAL(mesh != nullptr, "reserve_gather_resources: mesh is null");
+    std::unique_lock<std::mutex> guard(gather_resource_mutex());
+    auto& registry = gather_resource_registry();
+    auto it = registry.find(mesh);
+    if (it != registry.end()) {
+        TT_FATAL(
+            !it->second->releasing,
+            "reserve_gather_resources() cannot race release_gather_resources() on the same mesh");
+        return;  // idempotent: several clients on one mesh share the reservation
+    }
+    released_gather_meshes().erase(mesh);
+    registry.emplace(mesh, make_gather_resources(mesh));
+    log_debug(
+        tt::LogOp,
+        "kvcache gather: reserved {} B of L1 per chip across {} cores of row 0",
+        kDoneCounterBytes + kNumPackCores * 2 * kScratchSliceBytes,
+        kNumPackCores);
+}
+
+void release_gather_resources(MeshDevice* mesh) {
+    std::unique_lock<std::mutex> guard(gather_resource_mutex());
+    auto& registry = gather_resource_registry();
+    auto it = registry.find(mesh);
+    if (it == registry.end()) {
+        released_gather_meshes().insert(mesh);
+        return;
+    }
+
+    const auto resources = it->second;
+    if (resources->releasing) {
+        gather_resource_condition().wait(guard, [&] {
+            const auto current = registry.find(mesh);
+            return current == registry.end() || current->second != resources;
+        });
+        return;
+    }
+
+    resources->releasing = true;
+    gather_resource_condition().wait(guard, [&] { return resources->active_operations == 0; });
+    it = registry.find(mesh);
+    if (it != registry.end() && it->second == resources) {
+        registry.erase(it);
+        released_gather_meshes().insert(mesh);
+    }
+    guard.unlock();
+    gather_resource_condition().notify_all();
+}
+
+}  // namespace ttnn::operations::kvcache_manager
diff --git a/ttnn/cpp/ttnn/operations/kvcache_manager/gather/gather.hpp b/ttnn/cpp/ttnn/operations/kvcache_manager/gather/gather.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..6eb01ee7a6b20b80c40d20dabf0189c4c16cf51b
--- /dev/null
+++ b/ttnn/cpp/ttnn/operations/kvcache_manager/gather/gather.hpp
@@ -0,0 +1,118 @@
+// SPDX-FileCopyrightText: (c) 2026 Moreh
+//
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include <cstdint>
+#include <vector>
+
+#include <tt-metalium/mesh_coord.hpp>
+
+#include "ttnn/tensor/tensor.hpp"
+
+namespace ttnn::operations::kvcache_manager {
+
+/// Reserves the per-chip L1 the gather/scatter ops need (a completion counter plus four
+/// double-buffered payload staging slices, 163,856 bytes per chip, independent of mesh size or
+/// model).
+///
+/// Call this during setup, BEFORE anything captures a trace on this mesh. tt_metal only permits
+/// buffers allocated after a trace exists if their lifetime ends before that trace runs, and a
+/// completion counter is precisely the kind of buffer that must outlive it. Allocating one
+/// mid-serving lets a replaying trace clobber the counter, which leaves the waiting kernel spinning
+/// forever and strands a blocking enqueue holding the mesh-wide API mutex -- the whole device then
+/// goes quiet with no error. The ops fall back to allocating on first use and say so, but by then
+/// it may already be too late.
+///
+/// Idempotent; several clients on one mesh share one reservation. The reservation lives until
+/// release_gather_resources or process exit.
+void reserve_gather_resources(tt::tt_metal::distributed::MeshDevice* mesh);
+
+/// Drops the reservation for `mesh`. Safe to call when nothing was reserved; waits for any
+/// in-flight gather/scatter operation before returning. A concurrent new operation fails, and a
+/// later operation must first start a new lifetime with reserve_gather_resources().
+void release_gather_resources(tt::tt_metal::distributed::MeshDevice* mesh);
+
+/// Gathers one chunk of a TP-sharded paged cache onto a single chip, over fabric, without a host
+/// round trip.
+///
+/// `rank_coords` names the chips that own the chunk, in TP-rank order -- one DP group's TP shards,
+/// not necessarily the whole mesh. `master_coord` need not be one of them: a mesh with several DP
+/// groups gathers each group onto whichever chip runs the wire.
+///
+/// Each rank owns one shard of each member (a member is one KV cache tensor,
+/// e.g. one layer). For member `m`, entry `cb` of `block_ids` and rank `r`, the `shard_block_bytes`
+/// bytes at `block_ids[cb] * shard_block_bytes` of that chip's shard are written into `dst` at
+/// `region_bases[m] + cb * block_bytes + r * shard_block_bytes`, where
+/// `block_bytes = shard_block_bytes * rank_coords.size()`. That is byte-for-byte the layout the host-side
+/// planner produces, so the gathered region can be handed straight to a wire PUT from
+/// `master_coord`.
+///
+/// `header_words` are written verbatim at the start of `dst` by the master chip, for the value
+/// header a wire PUT expects to find in front of the payload.
+///
+/// Only `dst`'s shard at `master_coord` is written; the other (lockstep-allocated) shards are
+/// untouched. Blocking: on return the master has
+/// observed every sender's completion event, so the bytes are readable.
+///
+/// Requirements (TT_FATAL): allocated INTERLEAVED DRAM tensors on one mesh with 32-byte-aligned
+/// page sizes; `shard_block_bytes`, `region_bases` and the header size 32-byte aligned (a DRAM NoC
+/// read rounds its source address down to 32 bytes, so a 16-byte-aligned region reads the wrong
+/// window rather than failing); the header fits one destination page; every source and destination
+/// range in bounds; and, under 1D fabric, every chip a direct neighbour of the master.
+void gather_tp_shards_to_chip(
+    const std::vector<tt::tt_metal::Tensor>& members,
+    const tt::tt_metal::Tensor& dst,
+    const tt::tt_metal::distributed::MeshCoordinate& master_coord,
+    const std::vector<tt::tt_metal::distributed::MeshCoordinate>& rank_coords,
+    const std::vector<uint32_t>& block_ids,
+    uint32_t shard_block_bytes,
+    const std::vector<uint32_t>& region_bases,
+    const std::vector<uint32_t>& header_words = {});
+
+/// Inverse of gather_tp_shards_to_chip: hands each rank back its slice of a blob that already sits
+/// in the master chip's DRAM (typically streamed there by a wire GET), writing it into that rank's
+/// own cache blocks. Same layout contract and same requirements; blocking, and on return every
+/// rank's bytes have landed.
+void scatter_chunk_from_chip(
+    const tt::tt_metal::Tensor& src,
+    const std::vector<tt::tt_metal::Tensor>& members,
+    const tt::tt_metal::distributed::MeshCoordinate& master_coord,
+    const std::vector<tt::tt_metal::distributed::MeshCoordinate>& rank_coords,
+    const std::vector<uint32_t>& block_ids,
+    uint32_t shard_block_bytes,
+    const std::vector<uint32_t>& region_bases);
+
+/// Packs every listed chip's OWN shard into its own replica of `dst`, all at once.
+///
+/// The per-chip PUT mode needs each chip's slice of the paged cache as one contiguous buffer
+/// because a PUT operation takes one stream while the bytes live one block deep in each cache tensor.
+/// Each chip's pack is independent -- its own members, its own blob shard, no fabric -- so this
+/// builds ONE MeshWorkload with a program per coordinate and enqueues once: every chip packs
+/// simultaneously. Issuing the same packs as per-coordinate gather calls would serialize them
+/// behind blocking enqueues and discard that chip-level parallelism.
+///
+/// Geometry (block_ids / shard_block_bytes / region_bases / header_words) is shared by every chip:
+/// a per-shard plan differs only in which chip it names. Same 32-byte alignment contract as
+/// gather_tp_shards_to_chip. Blocking: on return every chip's blob shard is readable.
+void pack_local_shards(
+    const std::vector<tt::tt_metal::Tensor>& members,
+    const tt::tt_metal::Tensor& dst,
+    const std::vector<tt::tt_metal::distributed::MeshCoordinate>& coords,
+    const std::vector<uint32_t>& block_ids,
+    uint32_t shard_block_bytes,
+    const std::vector<uint32_t>& region_bases,
+    const std::vector<uint32_t>& header_words = {});
+
+/// Inverse of pack_local_shards: every listed chip writes its own replica of `src` back into its
+/// own cache blocks, all in one workload. Blocking: on return every chip's blocks are written.
+void unpack_local_shards(
+    const tt::tt_metal::Tensor& src,
+    const std::vector<tt::tt_metal::Tensor>& members,
+    const std::vector<tt::tt_metal::distributed::MeshCoordinate>& coords,
+    const std::vector<uint32_t>& block_ids,
+    uint32_t shard_block_bytes,
+    const std::vector<uint32_t>& region_bases);
+
+}  // namespace ttnn::operations::kvcache_manager
