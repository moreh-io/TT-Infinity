+std::atomic<ClientOperations*> ClientOperations::quarantine_head_{nullptr};
+
+ClientOperations::ClientOperations(const ClientOperationsConfig& operation_config) :
+    client_submesh_(operation_config.client_mesh),
+    client_coord_(operation_config.client_coord),
+    chip_range_(operation_config.client_coord),
+    deployment_server_node_(operation_config.deployment_server_node),
+    static_intermesh_galaxy_to_t3k_(operation_config.static_intermesh_galaxy_to_t3k),
+    fabric_link_idx_(operation_config.fabric_link_idx),
+    static_intermesh_lane_(operation_config.static_intermesh_lane),
+    test_fault_(operation_config.test_fault),
+    route_word_to_server_(operation_config.route_word_to_server),
+    value_ring_depth_(operation_config.client_value_ring_depth),
+    kvcache_profile_(operation_config.profile_enabled),
+    put_phase_profile_enabled_(operation_config.put_phase_profile_enabled),
+    profile_detail_(static_cast<config::ProfileDetail>(operation_config.profile_detail)) {
+    TT_FATAL(client_submesh_ != nullptr, "ClientOperations requires a non-null client mesh");
+    TT_FATAL(
+        operation_config.profile_detail <= static_cast<uint8_t>(config::ProfileDetail::Move),
+        "ClientOperations profile detail {} is invalid",
+        operation_config.profile_detail);
+    TT_FATAL(
+        operation_config.test_fault <= ClientOperationsTestFault::PutReaderTridPollution,
+        "ClientOperations test fault {} is invalid",
+        static_cast<uint32_t>(operation_config.test_fault));
+
+    const auto& client_shape = client_submesh_->shape();
+    TT_FATAL(
+        client_shape.dims() == client_coord_.dims() && MeshCoordinateRange(client_shape).contains(client_coord_),
+        "ClientOperations coordinate {} is outside client mesh shape {}",
+        client_coord_,
+        client_shape);
+    validate_kvcache_fabric_config("kvcache_manager ClientOperations");
+    TT_FATAL(
+        value_ring_depth_ >= protocol::kClientPutValueRingDepthMin,
+        "ClientOperations value-ring depth {} is below the minimum {}",
+        value_ring_depth_,
+        protocol::kClientPutValueRingDepthMin);
+    TT_FATAL(
+        protocol::client_l1_reserve_bytes(value_ring_depth_) <= std::numeric_limits<uint32_t>::max(),
+        "ClientOperations value-ring depth {} exceeds the 32-bit L1 layout limit",
+        value_ring_depth_);
+
+    IDevice* client_device = client_submesh_->get_device(client_coord_);
+    TT_FATAL(client_device != nullptr, "ClientOperations has no device at coordinate {}", client_coord_);
+    const auto client_node = client_submesh_->get_fabric_node_id(client_coord_);
+    if (static_intermesh_galaxy_to_t3k_) {
+        TT_FATAL(
+            !deployment_server_node_.has_value(),
+            "ClientOperations static inter-mesh routing must not receive a deployment server node");
+        TT_FATAL(is_kvcache_2d_fabric(), "ClientOperations static inter-mesh routing requires FABRIC_2D");
+        const auto gateway_node = tt::tt_fabric::get_static_intermesh_endpoint_fabric_node_id();
+        const auto static_link_count = tt::tt_fabric::get_static_intermesh_endpoint_link_count();
+        TT_FATAL(
+            static_intermesh_lane_ < static_link_count,
+            "ClientOperations static inter-mesh lane {} is outside configured link count {}",
+            static_intermesh_lane_,
+            static_link_count);
+        TT_FATAL(
+            client_node.mesh_id == gateway_node.mesh_id,
+            "ClientOperations client mesh {} differs from static gateway mesh {}",
+            *client_node.mesh_id,
+            *gateway_node.mesh_id);
+        TT_FATAL(
+            route_word_to_server_ == kvcache_unicast_route_word(gateway_node),
+            "ClientOperations static route word {} does not name gateway mesh {} chip {}",
+            route_word_to_server_,
+            *gateway_node.mesh_id,
+            gateway_node.chip_id);
+        if (client_node != gateway_node) {
+            TT_FATAL(
+                is_kvcache_wire_reachable(client_node, gateway_node),
+                "ClientOperations client mesh {} chip {} cannot reach static gateway chip {}",
+                *client_node.mesh_id,
+                client_node.chip_id,
+                gateway_node.chip_id);
+            const auto gateway_links = kvcache_wire_link_indices(client_node, gateway_node);
+            TT_FATAL(
+                !gateway_links.empty(),
+                "ClientOperations client mesh {} chip {} has no forwarding link plane toward static gateway chip {}",
+                *client_node.mesh_id,
+                client_node.chip_id,
+                gateway_node.chip_id);
+            TT_FATAL(
+                fabric_link_idx_ == gateway_links[static_intermesh_lane_ % gateway_links.size()],
+                "ClientOperations static gateway link index {} does not match lane {}",
+                fabric_link_idx_,
+                static_intermesh_lane_);
+        } else {
+            TT_FATAL(
+                fabric_link_idx_ == 0,
+                "ClientOperations direct static gateway connection requires link index 0, got {}",
+                fabric_link_idx_);
+        }
+    } else {
+        TT_FATAL(
+            deployment_server_node_.has_value(), "ClientOperations standard routing requires a deployment server node");
+        const auto& server_node = *deployment_server_node_;
+        TT_FATAL(
+            client_node.mesh_id == server_node.mesh_id,
+            "ClientOperations client mesh {} differs from server mesh {}",
+            *client_node.mesh_id,
+            *server_node.mesh_id);
+        TT_FATAL(
+            client_node != server_node,
+            "ClientOperations client and server resolve to the same mesh {} chip {}",
+            *client_node.mesh_id,
+            client_node.chip_id);
+        TT_FATAL(
+            is_kvcache_wire_reachable(client_node, server_node),
+            "ClientOperations client mesh {} chip {} cannot reach server chip {}",
+            *client_node.mesh_id,
+            client_node.chip_id,
+            server_node.chip_id);
+        TT_FATAL(
+            route_word_to_server_ == kvcache_unicast_route_word(server_node),
+            "ClientOperations route word {} does not name server mesh {} chip {}",
+            route_word_to_server_,
+            *server_node.mesh_id,
+            server_node.chip_id);
+        TT_FATAL(
+            fabric_link_idx_ == kvcache_wire_link_index(client_node, server_node),
+            "ClientOperations server link index {} is invalid",
+            fabric_link_idx_);
+    }
+
+    client_submesh_owner_ = client_submesh_->shared_from_this();
+    reserve_client_l1();
+}
+
+void ClientOperations::configure_session(const ClientSessionConfig& session_config) {
+    TT_FATAL(state_ == ClientOperationsState::Constructing, "ClientOperations session is already configured");
+    const auto& descriptor = session_config.server_descriptor;
+    validate_server_descriptor(descriptor);
+    TT_FATAL(
+        descriptor.value_ring_depth == value_ring_depth_,
+        "Server value-ring depth {} differs from prepared Client depth {}",
+        descriptor.value_ring_depth,
+        value_ring_depth_);
+    TT_FATAL(
+        protocol::client_generation_from_token(session_config.client_token) != 0,
+        "ClientOperations requires a generation-fenced client token, got {:#x}",
+        session_config.client_token);
+
+    const auto descriptor_server_node = server_node_from(descriptor);
+    if (deployment_server_node_.has_value()) {
+        TT_FATAL(
+            descriptor_server_node == *deployment_server_node_,
+            "Server descriptor node (mesh {}, chip {}) differs from deployment node (mesh {}, chip {})",
+            *descriptor_server_node.mesh_id,
+            descriptor_server_node.chip_id,
+            *deployment_server_node_->mesh_id,
+            deployment_server_node_->chip_id);
+    }
+
+    IDevice* client_device = client_submesh_->get_device(client_coord_);
+    TT_FATAL(client_device != nullptr, "ClientOperations has no device at coordinate {}", client_coord_);
+    const auto client_node = client_submesh_->get_fabric_node_id(client_coord_);
+    const uint32_t client_id = protocol::client_id_from_token(session_config.client_token);
+    TT_FATAL(
+        client_id == client_node.chip_id,
+        "ClientOperations token ID {} does not match client chip {}",
+        client_id,
+        client_node.chip_id);
+
+    const CoreCoord client_dram_grid = client_device->dram_grid_size();
+    TT_FATAL(
+        descriptor.num_dram_channels == static_cast<uint32_t>(client_device->num_dram_channels()) &&
+            descriptor.dram_grid_x == static_cast<uint32_t>(client_dram_grid.x) &&
+            descriptor.dram_grid_y == static_cast<uint32_t>(client_dram_grid.y),
+        "ClientOperations server/client DRAM geometry differs (server channels={} grid={}x{}, client channels={} "
+        "grid={}x{})",
+        descriptor.num_dram_channels,
+        descriptor.dram_grid_x,
+        descriptor.dram_grid_y,
+        client_device->num_dram_channels(),
+        client_dram_grid.x,
+        client_dram_grid.y);
+
+    server_node_ = descriptor_server_node;
+    client_token_ = session_config.client_token;
+    server_l1_base_ = descriptor.l1_base;
+    server_noc_x_ = descriptor.noc_x;
+    server_noc_y_ = descriptor.noc_y;
+    server_num_dram_channels_ = descriptor.num_dram_channels;
+    server_dram_grid_x_ = descriptor.dram_grid_x;
+    server_dram_grid_y_ = descriptor.dram_grid_y;
+    ring_slots_ = descriptor.ring_slots;
+    ring_slots_per_client_ = ring_slots_ / protocol::kMaxClients;
+    ring_base_slot_ = client_id * ring_slots_per_client_;
+    next_ring_slot_idx_ = 0;
+    max_value_bytes_ = descriptor.max_value_bytes;
+    max_get_chunks_ = protocol::max_get_chunks_for(max_value_bytes_);
+    max_key_bytes_ = descriptor.max_key_bytes;
+}
