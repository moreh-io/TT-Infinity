+class ScopedEnvironment {
+public:
+    explicit ScopedEnvironment(const char* name) : name_(name) {
+        if (const char* value = std::getenv(name_.c_str())) {
+            original_ = value;
+        }
+        clear();
+    }
+
+    ~ScopedEnvironment() {
+        if (original_.has_value()) {
+            static_cast<void>(::setenv(name_.c_str(), original_->c_str(), 1));
+        } else {
+            static_cast<void>(::unsetenv(name_.c_str()));
+        }
+    }
+
+    ScopedEnvironment(const ScopedEnvironment&) = delete;
+    ScopedEnvironment& operator=(const ScopedEnvironment&) = delete;
+
+    void set(std::string_view value) {
+        const std::string owned(value);
+        if (::setenv(name_.c_str(), owned.c_str(), 1) != 0) {
+            throw std::runtime_error("setenv failed");
+        }
+    }
+
+    void clear() {
+        if (::unsetenv(name_.c_str()) != 0) {
+            throw std::runtime_error("unsetenv failed");
+        }
+    }
+
+private:
+    std::string name_;
+    std::optional<std::string> original_;
+};
