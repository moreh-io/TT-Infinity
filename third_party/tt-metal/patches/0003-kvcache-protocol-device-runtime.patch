+// EXISTS handler (single-packet). Delegates the presence check to the BRISC DRAM worker kernel,
+// builds EXISTS_RESP in-slot, and ships it to the client recv buffer. EXISTS is not an access, so
+// the BRISC leaves last_access untouched. See ttnn/cpp/ttnn/operations/kvcache_manager/docs/design.md §6.
+//   Request:  protocol::PacketHeader (op = EXISTS, payload_size = key_len) | key bytes
+//   Response: protocol::PacketHeader (op = EXISTS_RESP, payload_size = 16) | status payload
+// DETACH: the Client is closing cleanly and releasing its session, so a later Client can establish
+// with this Server instead of needing a fresh one. Only the session is released -- the directory
+// and every stored value survive.
+//
+// The reply target lives in the registry, so it is captured before the release; the release itself
+// is committed before anything that can block, so a stalled send cannot leave the slot claimed.
+KVM_COLD_HANDLER void handle_detach(
+    volatile tt_l1_ptr protocol::PacketHeader* hdr,
+    uint32_t slot_addr,
+    RegistryView reg,
+    uint32_t lookup_base,
+    KvmFabricSender* connections,
+    volatile tt_l1_ptr PACKET_HEADER_TYPE* packet_header_addr) {
+    const uint32_t was_established = reg.established_flag();
+    const uint32_t client_chip_id = reg.client_chip_id();
+    const uint32_t req_seq = hdr->seq;
+
+    reg.retire_session();
+
+    LookupEntry entry = peer_lookup(lookup_base, client_chip_id);
+    ASSERT(entry.conn_idx != kPeerLookupEmptySentinel);
+
+    const uint32_t resp_payload_size = kExistsRemoveStatusPayloadBytes;  // 16
+    volatile tt_l1_ptr protocol::PacketHeader* resp_hdr =
+        reinterpret_cast<volatile tt_l1_ptr protocol::PacketHeader*>(slot_addr);
+    resp_hdr->opcode = static_cast<uint32_t>(OpCode::DETACH_RESP);
+    resp_hdr->seq = req_seq;
+    resp_hdr->payload_size = resp_payload_size;
+    // client_token is left as the request wrote it: the response is built in the request's own slot,
+    // so the field already names the Client this reply is going back to.
+    volatile tt_l1_ptr uint32_t* status =
+        reinterpret_cast<volatile tt_l1_ptr uint32_t*>(slot_addr + sizeof(protocol::PacketHeader));
+    status[0] = (was_established != 0) ? 1u : 0u;
+    status[1] = 0;
+    status[2] = 0;
+    status[3] = 0;
+
+    const uint32_t total = (sizeof(protocol::PacketHeader) + resp_payload_size + 15) & ~15u;
+    send_payload_and_signal(slot_addr, total, reg, entry, connections, packet_header_addr, true);
+}
+
+KVM_COLD_HANDLER void handle_exists(
+    volatile tt_l1_ptr protocol::PacketHeader* hdr,
+    uint32_t slot_addr,
+    RegistryView reg,
+    uint32_t lookup_base,
+    uint32_t commit_target,
+    volatile tt_l1_ptr uint32_t* commit_done,
+    volatile tt_l1_ptr uint32_t* termination_ptr,
+    KvmFabricSender* connections,
+    volatile tt_l1_ptr PACKET_HEADER_TYPE* packet_header_addr,
+    DirMailbox* mb) {
+    ASSERT(reg.established_flag() == 1);
+
+    // The EXISTS packet follows earlier requests in this Client's ring. Waiting for the
+    // Server's issued prefix here preserves the public committed-prefix contract without
+    // a separate COMMIT_BARRIER round trip.
+    if (!wait_for_commit_prefix(commit_target, commit_done, termination_ptr)) {
+        return;
+    }
+
+    LookupEntry entry = peer_lookup(lookup_base, reg.client_chip_id());
+    ASSERT(entry.conn_idx != kPeerLookupEmptySentinel);
+
+    const uint32_t req_seq = hdr->seq;
+    const uint32_t key_len = hdr->payload_size;  // EXISTS request: payload_size == key_len
+    const uint32_t key_src = slot_addr + sizeof(protocol::PacketHeader);
+
+    // Guard the key length: dir_lookup copies key_len bytes into the mailbox key region (sized
+    // kMaxKeyBytesDefault). Out-of-range is malformed — answer not-found instead.
+    DirResult dr{};
+    if (key_len >= 1 && key_len <= kMaxKeyBytesDefault) {
+        dr = dir_lookup(*mb, static_cast<uint32_t>(OpCode::EXISTS), key_src, key_len, 0);
+    }
+
+    // Build EXISTS_RESP in-slot (same wire layout the host used to write).
+    const uint32_t resp_payload_size = kExistsRemoveStatusPayloadBytes;  // 16
+    volatile tt_l1_ptr protocol::PacketHeader* resp_hdr =
+        reinterpret_cast<volatile tt_l1_ptr protocol::PacketHeader*>(slot_addr);
+    resp_hdr->opcode = static_cast<uint32_t>(OpCode::EXISTS_RESP);
+    resp_hdr->seq = req_seq;
+    resp_hdr->payload_size = resp_payload_size;
+    // client_token is left as the request wrote it: the response is built in the request's own slot,
+    // so the field already names the Client this reply is going back to.
+    volatile tt_l1_ptr uint32_t* status =
+        reinterpret_cast<volatile tt_l1_ptr uint32_t*>(slot_addr + sizeof(protocol::PacketHeader));
+    status[0] = (dr.found != 0) ? kStatusFlagFound : 0u;
+    status[1] = 0;
+    status[2] = 0;
+    status[3] = 0;
+
+    const uint32_t total = (sizeof(protocol::PacketHeader) + resp_payload_size + 15) & ~15u;
+    send_payload_and_signal(slot_addr, total, reg, entry, connections, packet_header_addr, false);
+}
