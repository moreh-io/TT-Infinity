+
+    // Own-L1 NoC address for the done sem: inc via NoC atomic so the value lands in
+    // SRAM and the NCRISC's exact noc_semaphore_wait observes it (a plain store could
+    // sit in this RISC's write buffer, invisible across RISCs).
+    const uint64_t done_sem_noc = get_noc_addr(my_x[noc_index], my_y[noc_index], done_sem_addr);
+    const uint64_t get_admission_ready_noc =
+        get_noc_addr(get_admission_noc_x, get_admission_noc_y, get_admission_ready_addr);
+    const uint64_t get_admission_descriptor_noc =
+        get_noc_addr(get_admission_noc_x, get_admission_noc_y, get_admission_descriptor_addr);
+
+    const InterleavedAddrGen<true> dir_gen{
+        .bank_base_address = dram_directory_base,
+        .page_size = dir_entry_stride,
+    };
+    const InterleavedAddrGen<true> put_host_queue_gen{
+        .bank_base_address = dram_put_host_queue_base,
+        .page_size = kPutHostQueueEntryBytes,
+    };
+    // Each value chunk occupies one interleaved heap unit.
+    const InterleavedAddrGen<true> value_gen{
+        .bank_base_address = dram_value_base,
+        .page_size = kMaxChunkValueBytes,
+    };
+    const InterleavedAddrGen<true> hash_gen{
+        .bank_base_address = dram_hashmap_base,
+        .page_size = kHashBucketBytes,
+    };
+    const InterleavedAddrGen<true> heap_metadata_gen{
+        .bank_base_address = dram_heap_metadata_base,
+        .page_size = kHeapMetadataEntryBytes,
+    };
+
+    *epoch = 0;
+    directory_state[kDirNextUnusedSlotWord] = 0;
+    directory_state[kDirFreeSlotHeadWord] = kResidencyLruNone;
+    directory_state[kDirReservedSlotWord] = kResidencyLruNone;
+    for (uint32_t word = 0; word < kHeapAllocatorHeaderWords + kHeapAllocatorMaxOrders; ++word) {
+        allocator[word] = 0;
+    }
+    const uint32_t max_buddy_order = floor_log2_u32(num_heap_units);
+    allocator[kHeapAllocatorMaxOrderWord] = max_buddy_order;
+    allocator[kResidencyLruHeadWord] = kResidencyLruNone;
+    allocator[kResidencyLruTailWord] = kResidencyLruNone;
+    allocator[kResidencyLruCountWord] = 0;
+    for (uint32_t order = 0; order < kHeapAllocatorMaxOrders; ++order) {
+        allocator[kHeapFreeHeadBaseWord + order] = kHeapFreeListNone;
+    }
+    for (uint32_t slot = 0; slot < max_keys; ++slot) {
+        volatile tt_l1_ptr uint32_t* node = residency_lru_node(residency_lru, slot);
+        node[kResidencyLruPrevWord] = kResidencyLruNone;
+        node[kResidencyLruNextWord] = kResidencyLruNone;
+    }
+
+    // Zero the load-bearing entry headers before serving; borrow otherwise-idle commit staging as
+    // the NoC write source.
+    {
+        volatile tt_l1_ptr uint32_t* zinit = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(commit_entry_staging_addr);
+        for (uint32_t w = 0; w < 8; ++w) {
+            zinit[w] = 0;
+        }
+        zinit[4] = initial_counter;
+        const uint32_t counter_init_addr = commit_entry_staging_addr + 16;
+
+        // Zero cross-RISC and host-read controls before directory, hashmap, and buddy free-list
+        // initialization. Launch is non-blocking, so doing this later could clobber the first request.
+        // Each zero is a NoC self-write (own-core get_noc_addr) so the word lands in SRAM; reuses the
+        // already-zeroed commit_entry_staging[0..16) as the source.
+        noc_async_write(counter_init_addr, get_noc_addr(my_x[noc_index], my_y[noc_index], commit_done_addr), 16);
+        noc_async_write(counter_init_addr, get_noc_addr(my_x[noc_index], my_y[noc_index], move_req_sem_addr), 16);
+        noc_async_write(counter_init_addr, get_noc_addr(my_x[noc_index], my_y[noc_index], commit_req_sem_addr), 16);
+        noc_async_write(counter_init_addr, get_noc_addr(my_x[noc_index], my_y[noc_index], move_processed_addr), 16);
+        noc_async_write(counter_init_addr, get_noc_addr(my_x[noc_index], my_y[noc_index], promote_done_addr), 16);
+        noc_async_write(counter_init_addr, get_noc_addr(my_x[noc_index], my_y[noc_index], evict_ack_sem_addr), 16);
+        noc_async_write(commit_entry_staging_addr, get_noc_addr(my_x[noc_index], my_y[noc_index], evict_ack_addr), 16);
+        noc_async_write(counter_init_addr, get_noc_addr(my_x[noc_index], my_y[noc_index], evict_done_addr), 16);
+        noc_async_write(counter_init_addr, get_noc_addr(my_x[noc_index], my_y[noc_index], req_sem_addr), 16);
+        noc_async_write(counter_init_addr, get_noc_addr(my_x[noc_index], my_y[noc_index], done_sem_addr), 16);
+        noc_async_write_barrier();
+        // Restore the borrowed 32-byte staging block before using it as the directory-zero source.
+        zinit[4] = 0;
+
+        for (uint32_t base = 0; base < max_keys; base += kDirScanBatch) {
+            const uint32_t this_batch = (max_keys - base < kDirScanBatch) ? (max_keys - base) : kDirScanBatch;
+            for (uint32_t k = 0; k < this_batch; ++k) {
+                noc_async_write(commit_entry_staging_addr, dir_gen.get_noc_addr(base + k, 0), 32);
+            }
+            noc_async_write_barrier();
+        }
+
+        // Cold-start the auxiliary hash index: set every bucket's dir_slot word to kBucketDirSlotEmpty
+        // (0xFFFFFFFF, NOT 0 — so the all-zero directory source cannot be reused) so a garbage bucket
+        // never reads as a live mapping. key_hash is don't-care when empty. Runs before the serve loop.
+        {
+            volatile tt_l1_ptr uint32_t* binit = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(hash_probe_staging);
+            for (uint32_t w = 0; w < 8; ++w) {
+                binit[w] = 0;
+            }
+            binit[kBucketDirSlotWord] = kBucketDirSlotEmpty;
+            for (uint32_t b = 0; b < num_buckets; ++b) {
+                noc_async_write(hash_probe_staging, hash_gen.get_noc_addr(b, 0), kHashBucketBytes);
+                if ((b & 0xFu) == 0xFu) {
+                    noc_async_write_barrier();  // bound outstanding writes
+                }
+            }
+            noc_async_write_barrier();
+        }
+
+        // Seed aligned power-of-two free blocks. Only block starts carry buddy metadata, so the
+        // previous O(num_heap_units) reverse-owner zero pass is unnecessary.
+        {
+            uint32_t first_unit = 0;
+            uint32_t remaining_units = num_heap_units;
+            while (remaining_units != 0) {
+                uint32_t order = floor_log2_u32(remaining_units);
+                while (order != 0 && (first_unit & ((1u << order) - 1u)) != 0) {
+                    --order;
+                }
+                buddy_push_free(first_unit, order, allocator, heap_metadata_gen, heap_metadata_staging);
+                const uint32_t block_units = 1u << order;
+                first_unit += block_units;
+                remaining_units -= block_units;
+            }
+        }
+    }
+
+    // A prior Server may leave the reverse-ACK accumulator stale. Restore the shared test/production
+    // baseline before ESTABLISH so unsigned deltas remain valid across uint32 wrap.
+    if (get_host_completion_enabled != 0) {
+        noc_inline_dw_write(get_noc_addr(my_x[noc_index], my_y[noc_index], get_completion_ack_addr), initial_counter);
+        noc_async_write_barrier();
+    }
+
+    // Cold-start fully drained (directory, hash map, and buddy free lists): signal the NCRISC that
+    // it can start serving. The NCRISC blocks on this before its serve loop, so a client's first op
+    // cannot race the cold-start (which would lose the first PUT's commit). NoC self-write (own-core
+    // get_noc_addr, as the move_req posts) so the word lands in SRAM for the NCRISC's cross-RISC poll;
+    // the barrier makes it durable before this RISC proceeds.
+    noc_inline_dw_write(get_noc_addr(my_x[noc_index], my_y[noc_index], cold_start_done_addr), 1);
+    noc_async_write_barrier();
+
+    // Local cumulative expected request count (matches the NCRISC's inc count).
+    uint32_t expected_req = initial_counter;
+    uint32_t put_host_queue_head = 0;
+    uint32_t put_host_queue_tail = 0;
+    uint32_t put_host_queue_count = 0;
+    const uint32_t put_host_queue_high_watermark =
+        (max_keys < kPutHostQueueHighWatermark) ? max_keys : kPutHostQueueHighWatermark;
+    bool force_put_host_commit = false;
+    // Host-tiering move channels: move_req (BRISC -> worker; NoC inline writes so the words land in
+    // SRAM for the worker's PCIe read) and commit_req (worker -> BRISC; read after the loop-top L1
+    // invalidate). Both sems are cumulative.
+    const uint64_t move_req_sem_noc = get_noc_addr(my_x[noc_index], my_y[noc_index], move_req_sem_addr);
+    const uint64_t move_req_noc = get_noc_addr(my_x[noc_index], my_y[noc_index], move_req_addr);
+    const uint64_t promote_done_noc = get_noc_addr(my_x[noc_index], my_y[noc_index], promote_done_addr);
+    const uint64_t evict_done_noc = get_noc_addr(my_x[noc_index], my_y[noc_index], evict_done_addr);
+    const uint64_t commit_done_noc = get_noc_addr(my_x[noc_index], my_y[noc_index], commit_done_addr);
+    volatile tt_l1_ptr uint32_t* commit_req_sem = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(commit_req_sem_addr);
+    volatile tt_l1_ptr uint32_t* commit_req = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(commit_req_addr);
+    uint32_t commit_req_seen = initial_counter;  // cumulative count of commit_req_sem observed
+    uint32_t pending_promote_slot = kBucketDirSlotEmpty;
+    uint32_t pending_promote_order = 0;
+    volatile tt_l1_ptr uint32_t* evict_ack_sem = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(evict_ack_sem_addr);
+    volatile tt_l1_ptr uint32_t* evict_ack = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(evict_ack_addr);
+    uint32_t evict_ack_seen = initial_counter;
+    // Mapped host-serve streaming: the worker publishes the cumulative number of staged chunks here
+    // (reset to zero before each commit request). The fused loop polls it to gate each batch read.
+    // A value that needs no copy gets the full count in one write, so the gate never waits.
+    volatile tt_l1_ptr uint32_t* stage_progress = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(stage_progress_addr);
+
+    volatile tt_l1_ptr uint32_t* move_req_sem_val = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(move_req_sem_addr);
+    volatile tt_l1_ptr uint32_t* move_processed = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(move_processed_addr);
+    uint32_t live_device_bytes = 0;
+    uint32_t pending_device_bytes = 0;
+    uint64_t test_first_put_commit_not_before = 0;
+    uint32_t direct_progress_seen = initial_counter;
+    bool put_stream_prefix_ready = false;
+    bool put_stream_tail_pending = false;
+    uint32_t put_stream_slot = kBucketDirSlotEmpty;
+    uint32_t put_stream_value_off = 0;
+    uint32_t put_stream_total_len = 0;
+    uint32_t put_stream_tail_begin = 0;
+    uint32_t put_stream_host_generation = 0;
+    uint64_t put_stream_host_dst = 0;
+    uint32_t put_stream_pending_token = 0;
+    bool put_fallback_progress_pending = false;
+    uint32_t put_fallback_progress_slot = kBucketDirSlotEmpty;
+    uint32_t put_fallback_progress_events = 0;
+    bool previous_put_order_valid = false;
+    uint32_t previous_put_order = 0;
