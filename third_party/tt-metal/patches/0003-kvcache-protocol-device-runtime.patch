+                    }
+                }
+                // Admission uses the same allocator and true-LRU victim selection as PUT and
+                // MOVE_TO_DEVICE. The mapped path can still serve after an exceptional allocation
+                // failure; the fallback needs this block as its PCIe staging destination.
+                uint32_t cache_unit = 0;
+                if (total_value_len != 0 && allocate_cache_block(
+                                                chunk_count_for(total_value_len),
+                                                home_slot,
+                                                value_heap_bytes,
+                                                num_heap_units,
+                                                max_keys,
+                                                dir_entry_stride,
+                                                dir_gen,
+                                                scan_staging_addr,
+                                                allocator,
+                                                residency_lru,
+                                                heap_metadata_gen,
+                                                heap_metadata_staging,
+                                                live_device_bytes,
+                                                allocator_profile,
+                                                /*speculative_lease=*/false,
+                                                /*allow_eviction=*/true,
+                                                &cache_unit,
+                                                &host_cache_order)) {
+                    host_cache_block = true;
+                    host_cache_value_off = cache_unit * kMaxChunkValueBytes;
+                    value_byte_off = host_cache_value_off;
+                }
+
+                if (!direct_pool_serve) {
+                    const uint32_t serve_off = host_cache_block ? host_cache_value_off : 0;
+                    if (!stage_enabled && !host_cache_block) {
+                        persist_host_get_access_stamp_if_current(
+                            home_slot, total_value_len, get_access_epoch, commit_entry_staging_addr, dir_gen);
+                        get_access_stamp_pending = false;
+                        found = 0;
+                        total_value_len = 0;
+                        num_chunks = 1;
+                        goto publish_lookup_response;
+                    }
+
+                    noc_inline_dw_write(move_req_noc + 0, kMoveOpHostServe);
+                    noc_inline_dw_write(move_req_noc + 4, home_slot);
+                    noc_inline_dw_write(move_req_noc + 8, serve_off);
+                    noc_inline_dw_write(move_req_noc + 12, total_value_len);
+                    noc_inline_dw_write(move_req_noc + 16, 0u);
+                    noc_async_write_barrier();
+                    noc_semaphore_inc(move_req_sem_noc, 1);
+                    noc_async_atomic_barrier();
+                    while (true) {
+                        invalidate_l1_cache();
+                        if (*commit_req_sem != commit_req_seen) {
+                            break;
+                        }
+                        if (*termination_ptr ==
+                            static_cast<uint32_t>(tt::tt_fabric::TerminationSignal::IMMEDIATELY_TERMINATE)) {
+                            found = 0;
+                            total_value_len = 0;
+                            num_chunks = 1;
+                            value_byte_off = 0;
+                            goto publish_lookup_response;
+                        }
+                    }
+                    commit_req_seen = *commit_req_sem;
+                    invalidate_l1_cache();
+                    ASSERT(commit_req[0] == home_slot);
+                    ASSERT(commit_req[1] == serve_off);
+                    host_stage_read_off = commit_req[kCommitReqStageReadOffWord];
+                    serve_from_host = true;
+                }
+            }
+            // Allocation can fail while the mapped path still serves the authoritative host value. Refresh the
+            // header because victim selection may have reused the original scan staging buffer.
+            if (is_get && found == 1 && hit_location == kLocationHost && !host_cache_block) {
+                persist_host_get_access_stamp_if_current(
+                    home_slot, total_value_len, get_access_epoch, commit_entry_staging_addr, dir_gen);
+                get_access_stamp_pending = false;
+            }
+            // The fallback worker has already pushed the complete host value into this block before
+            // posting commit_req. Commit it before releasing the lookup response; the mapped path
+            // fills and commits inline with the host stream below.
+            if (host_cache_block && serve_from_host && !stage_enabled) {
+                host_cache_committed = commit_host_get_admission(
+                    home_slot,
+                    host_cache_value_off,
+                    total_value_len,
+                    host_cache_order,
+                    get_access_epoch,
+                    value_heap_bytes,
+                    dir_entry_stride,
+                    dir_gen,
+                    commit_entry_staging_addr,
+                    residency_lru,
+                    allocator,
+                    live_device_bytes);
+                get_access_stamp_pending = false;
+            }
+
+            // Empty device values have no CB batch with which to overlap the stamp.
+            if (is_get && found == 1 && hit_location != kLocationHost && total_value_len == 0) {
+                persist_get_access_stamp(home_slot, get_access_epoch, hit_staging_addr, dir_gen);
+                residency_lru_touch(home_slot, residency_lru, allocator);
+                get_access_stamp_pending = false;
+            }
+
+            // Publish the lookup response via NoC inline writes to own L1 so the words land in SRAM
+            // (a plain store could stay in this RISC's write buffer, invisible to the NCRISC), barrier,
+            // then inc the done sem; the NCRISC invalidates L1 after its wait, so the payload is visible.
+        publish_lookup_response:
+            const uint64_t resp_noc = get_noc_addr(my_x[noc_index], my_y[noc_index], resp_mailbox_addr);
+            const bool ncrisc_device_fill = is_get && host_cache_block && serve_from_host && stage_enabled;
+            const uint32_t response_status =
+                (is_get ? (get_output_too_small ? (kGetStatusFound | kGetStatusOutputTooSmall)
+                                                : ((found != 0) ? kGetStatusFound : 0u))
+                        : found) |
+                (ncrisc_device_fill ? kDirGetStatusDeviceFillPending : 0u);
+            noc_inline_dw_write(resp_noc + 0, response_status);
+            noc_inline_dw_write(resp_noc + 4, total_value_len);
+            noc_inline_dw_write(resp_noc + 8, num_chunks);
+            noc_inline_dw_write(resp_noc + 12, value_byte_off);  // value heap byte offset (sub-page packing)
+            if (ncrisc_device_fill) {
+                noc_inline_dw_write(resp_noc + kDirRespGetConsumerDoneWord * sizeof(uint32_t), 0u);
+                noc_inline_dw_write(resp_noc + kDirRespGetResultWord * sizeof(uint32_t), kDirRespGetResultPending);
+            }
+            noc_async_write_barrier();
+            noc_semaphore_inc(done_sem_noc, 1);
+            noc_async_atomic_barrier();
+
+            // After releasing NCRISC, batch-read the value into the shared CB while it sends the
+            // previous batch. NCRISC may queue one next directory request because this request no
+            // longer reads the mailbox. See
+            // ttnn/cpp/ttnn/operations/kvcache_manager/docs/design.md §6.
+            if (is_get && found == 1 && total_value_len > 0) {
+                const uint32_t base_unit = value_byte_off / kMaxChunkValueBytes;
+                // The batch-0 profiler zone excludes CB backpressure and isolates DRAM reads.
+                auto read_batch = [&](uint32_t wr, uint32_t base, uint32_t this_batch) {
+                    for (uint32_t k = 0; k < this_batch; ++k) {
+                        const uint32_t stream_pos = (base + k) * kMaxChunkValueBytes;
+                        const uint32_t remaining = total_value_len - stream_pos;
+                        const uint32_t chunk_value_len =
+                            (remaining < kMaxChunkValueBytes) ? remaining : kMaxChunkValueBytes;
+                        const uint32_t read_bytes = (chunk_value_len + 31u) & ~31u;  // 32-round (phase-match DRAM)
+                        const uint64_t src_noc = value_gen.get_noc_addr(base_unit + base + k, 0);
+                        noc_async_read(src_noc, wr + k * kMaxChunkValueBytes, read_bytes);  // B reads in flight
+                    }
+                    noc_async_read_barrier();  // drain the whole batch (reads overlapped across banks)
+                };
+                // Always push B slots, padding the last batch. Variable pushes would drift the shared
+                // ring off B-alignment and eventually request a wrapping CB reservation.
+                if (stage_enabled && serve_from_host) {
+                    // Read each host batch once into the GET CB. The optional Fabric-free admission
+                    // worker owns the complete cache fill; the fallback keeps that whole stage here.
+                    KVM_ZONE_DIRECTORY_GET("KVM-DIR-GET-HOST-STREAM");
+                    const uint64_t stage_src_base = stage_noc_base + static_cast<uint64_t>(host_stage_read_off);
+                    for (uint32_t base = 0; base < num_chunks; base += kGetValueCbReadBatch) {
+                        const uint32_t this_batch =
+                            (num_chunks - base < kGetValueCbReadBatch) ? (num_chunks - base) : kGetValueCbReadBatch;
+                        if (!reserve_get_value_batch(termination_ptr)) {
+                            get_stream_aborted = true;
+                            break;
+                        }
+                        const uint32_t wr = get_write_ptr(kGetValueCbId);
+                        // A pool hit is already complete. The staging fallback publishes batch progress.
+                        if (!direct_pool_serve) {
+                            while (*stage_progress < base + this_batch) {
+                                invalidate_l1_cache();
+                                if (*termination_ptr ==
+                                    static_cast<uint32_t>(tt::tt_fabric::TerminationSignal::IMMEDIATELY_TERMINATE)) {
+                                    get_stream_aborted = true;
+                                    break;
+                                }
+                            }
+                        }
+                        if (get_stream_aborted) {
+                            break;
+                        }
+                        // A CB slot is reused only after one full ring. Fence this RISC's writes before
+                        // the following host read overwrites that L1 source region.
+                        if (host_cache_block && !get_admission_worker_enabled && base != 0 &&
+                            (base % kGetValueCbDepth) == 0) {
+                            noc_async_write_barrier();
+                        }
+
+                        const uint32_t batch_span = this_batch * kMaxChunkValueBytes;
+                        const uint32_t batch_left = total_value_len - base * kMaxChunkValueBytes;
+                        const uint32_t batch_bytes = (batch_span < batch_left) ? batch_span : batch_left;
+                        kvm_wide_read_sysmem(
+                            noc_index,
+                            stage_pcie_xy_enc,
+                            stage_src_base + static_cast<uint64_t>(base) * kMaxChunkValueBytes,
+                            wr,
+                            (batch_bytes + 31u) & ~31u);
+                        noc_async_read_barrier();
+                        if (host_cache_block && get_admission_worker_enabled) {
+                            if (base == 0) {
+                                const uint32_t first_ready_ticket = get_admission_ready_published + 1u;
+                                const uint32_t durable_ticket = ++get_admission_requests_published;
+                                const uint32_t num_batches =
+                                    (num_chunks + kGetValueCbReadBatch - 1u) / kGetValueCbReadBatch;
+                                noc_inline_dw_write(
+                                    get_admission_descriptor_noc + offsetof(GetAdmissionDescriptor, first_ready_ticket),
+                                    first_ready_ticket);
+                                noc_inline_dw_write(
+                                    get_admission_descriptor_noc + offsetof(GetAdmissionDescriptor, first_cb_l1_addr),
+                                    wr);
+                                noc_inline_dw_write(
+                                    get_admission_descriptor_noc + offsetof(GetAdmissionDescriptor, heap_base_unit),
+                                    base_unit);
+                                noc_inline_dw_write(
+                                    get_admission_descriptor_noc + offsetof(GetAdmissionDescriptor, total_value_len),
+                                    total_value_len);
+                                noc_inline_dw_write(
+                                    get_admission_descriptor_noc + offsetof(GetAdmissionDescriptor, num_chunks),
+                                    num_chunks);
+                                noc_inline_dw_write(
+                                    get_admission_descriptor_noc + offsetof(GetAdmissionDescriptor, num_batches),
+                                    num_batches);
+                                noc_inline_dw_write(
+                                    get_admission_descriptor_noc +
+                                        offsetof(GetAdmissionDescriptor, first_ready_ticket_end),
+                                    first_ready_ticket);
+                                noc_inline_dw_write(
+                                    get_admission_descriptor_noc + offsetof(GetAdmissionDescriptor, durable_ticket),
+                                    durable_ticket);
+                                noc_async_write_barrier();
+                            }
+                            ++get_admission_ready_published;
+                            noc_semaphore_inc(get_admission_ready_noc, 1);
+                            noc_async_atomic_barrier();
+                        } else if (host_cache_block) {
+                            for (uint32_t k = 0; k < this_batch; ++k) {
+                                const uint32_t chunk = base + k;
+                                const uint32_t stream_pos = chunk * kMaxChunkValueBytes;
+                                const uint32_t remaining = total_value_len - stream_pos;
+                                const uint32_t chunk_value_len =
+                                    (remaining < kMaxChunkValueBytes) ? remaining : kMaxChunkValueBytes;
+                                noc_async_write(
+                                    wr + k * kMaxChunkValueBytes,
+                                    value_gen.get_noc_addr(base_unit + chunk, 0),
+                                    (chunk_value_len + 31u) & ~31u);
+                            }
+                        }
+                        cb_push_back(kGetValueCbId, kGetValueCbReadBatch);
+                    }
+                    if (host_cache_block) {
+                        if (get_admission_worker_enabled) {
+                            if (!wait_for_cumulative_target(
+                                    get_admission_write_done, get_admission_requests_published, termination_ptr)) {
+                                get_stream_aborted = true;
+                            }
+                        } else {
+                            noc_async_write_barrier();
+                        }
+                        auto* consumer_done = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(
+                            resp_mailbox_addr + kDirRespGetConsumerDoneWord * sizeof(uint32_t));
+                        auto* admission_result = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(
+                            resp_mailbox_addr + kDirRespGetResultWord * sizeof(uint32_t));
+                        if (!get_stream_aborted) {
+                            // The cache bytes are durable before this point. Publish the directory
+                            // while NCRISC drains the final Fabric batch, then retain mailbox and
+                            // scheduler ownership until that consumer finishes.
+                            host_cache_committed = commit_host_get_admission(
+                                home_slot,
+                                host_cache_value_off,
+                                total_value_len,
+                                host_cache_order,
+                                get_access_epoch,
+                                value_heap_bytes,
+                                dir_entry_stride,
+                                dir_gen,
+                                commit_entry_staging_addr,
+                                residency_lru,
+                                allocator,
+                                live_device_bytes);
+                            get_access_stamp_pending = false;
+                            noc_semaphore_set(
+                                admission_result,
+                                host_cache_committed ? kDirRespGetResultCommitted : kDirRespGetResultAborted);
+                            while (true) {
+                                invalidate_l1_cache();
+                                if (*consumer_done == 1u) {
+                                    break;
+                                }
+                                if (*termination_ptr ==
+                                    static_cast<uint32_t>(tt::tt_fabric::TerminationSignal::IMMEDIATELY_TERMINATE)) {
+                                    get_stream_aborted = true;
+                                    break;
+                                }
+                            }
+                        } else {
+                            noc_semaphore_set(admission_result, kDirRespGetResultAborted);
+                        }
+                    }
+                } else {
+                    // Fallback: heap -> CB -> Fabric. This covers a resident value or a host serve
+                    // whose worker staged the value into DRAM over PCIe.
+                    KVM_ZONE_DIRECTORY_GET("KVM-DIR-GET-LOOP");
+                    for (uint32_t base = 0; base < num_chunks; base += kGetValueCbReadBatch) {
+                        const uint32_t this_batch =
+                            (num_chunks - base < kGetValueCbReadBatch) ? (num_chunks - base) : kGetValueCbReadBatch;
+                        if (!reserve_get_value_batch(termination_ptr)) {
+                            get_stream_aborted = true;
+                            break;
+                        }
+                        const uint32_t wr = get_write_ptr(kGetValueCbId);
+                        if (base == 0) {
+                            KVM_ZONE_DIRECTORY_GET("KVM-DIR-GET-READ-BATCH0");
+                            read_batch(wr, base, this_batch);
+                        } else {
+                            read_batch(wr, base, this_batch);
+                        }
+                        cb_push_back(kGetValueCbId, kGetValueCbReadBatch);  // publish B (padded) to the NCRISC sender
+                        if (base == 0 && hit_location != kLocationHost) {
+                            ASSERT(get_access_stamp_pending);
+                            persist_get_access_stamp(home_slot, get_access_epoch, hit_staging_addr, dir_gen);
+                            residency_lru_touch(home_slot, residency_lru, allocator);
+                            get_access_stamp_pending = false;
+                        }
+                    }
+                }
+            }
+            // A failed/stale admission never becomes directory-visible; return only that reserved block.
+            if (host_cache_block && !host_cache_committed) {
+                buddy_free(
+                    host_cache_value_off / kMaxChunkValueBytes,
+                    host_cache_order,
+                    num_heap_units,
+                    allocator,
+                    heap_metadata_gen,
+                    heap_metadata_staging);
+            }
+            ASSERT(
+                !get_access_stamp_pending || get_stream_aborted || found == 0 ||
+                (hit_location == kLocationHost && host_cache_block && !host_cache_committed));
+            if (serve_from_host && !direct_pool_serve) {
+                if (stage_enabled) {
+                    kvm_publish_host_completion(
+                        noc_index,
+                        stage_pcie_xy_enc,
+                        stage_noc_base + static_cast<uint64_t>(stage_completion_offset),
+                        commit_req_seen,
+                        heap_metadata_staging);
+                }
+                noc_semaphore_inc(promote_done_noc, 1);
+                noc_async_atomic_barrier();
+            }
+            continue;  // serviced a lookup; re-evaluate channel priority at the loop top
+        }
+
+        // (B) pending-host FIFO. Channel (A) already consumed any pending request below the high
+        // watermark, so reaching here means there is no request to protect or FIFO progress was
+        // forced. Commit_done remains issue-ordered because the FIFO is consumed strictly at head.
+        if (put_host_queue_count != 0) {
+            if (test_first_put_commit_delay_cycles != 0) {
+                const uint64_t now = get_timestamp();
+                if (test_first_put_commit_not_before == 0) {
+                    test_first_put_commit_not_before = now + static_cast<uint64_t>(test_first_put_commit_delay_cycles);
+                }
+                if (now < test_first_put_commit_not_before) {
+                    continue;
+                }
+                test_first_put_commit_delay_cycles = 0;
+            }
+            bool committed = false;
+            {
+                // One detail scope per queued PUT commit.
+                KVM_ZONE_DIRECTORY_PUT("KVM-DIR-PUT-WRITE-THROUGH-COMMIT");
+                committed = commit_pending_put(
+                    put_host_queue_head,
+                    max_keys,
+                    dir_entry_stride,
+                    dir_gen,
+                    put_host_queue_gen,
+                    commit_entry_staging_addr,
+                    move_req_noc,
+                    move_req_sem_noc,
+                    move_req_sem_val,
+                    move_processed,
+                    noc_index,
+                    stage_enabled,
+                    stage_pcie_xy_enc,
+                    stage_noc_base,
+                    value_gen,
+                    evict_ack_sem,
+                    evict_ack,
+                    evict_ack_seen,
+                    evict_done_noc,
+                    termination_ptr,
+                    pending_device_bytes);
+            }
+            if (!committed) {
+                continue;
+            }
+            put_host_queue_head = (put_host_queue_head + 1 == max_keys) ? 0 : put_host_queue_head + 1;
+            --put_host_queue_count;
+            force_put_host_commit = false;
+            noc_semaphore_inc(commit_done_noc, 1);
+            noc_async_atomic_barrier();
+        }
+
+        // (C) explicit MOVE_TO_DEVICE completion. GET host misses consume their commit_req inline and
+        // never reach this channel.
+        if (*commit_req_sem != commit_req_seen) {
+            KVM_ZONE_DIRECTORY_MOVE("KVM-DIR-MOVE-COMMIT");
+            commit_req_seen = *commit_req_sem;
+            invalidate_l1_cache();  // the worker wrote the commit_req slot before the sem; read fresh
+            const uint32_t mc_slot = commit_req[0];
+            const uint32_t mc_value_byte_off = commit_req[1];
+            const uint32_t mc_total_len = commit_req[2];
+            // The worker staged this value in host memory — pull it into the value heap at
+            // mc_value_byte_off before committing, so the committed entry points at a filled heap unit.
+            // When mapped transfer is disabled, the host already pushed the value into DRAM.
+            if (stage_enabled) {
+                KVM_ZONE_DIRECTORY_MOVE("KVM-DIR-MOVE-PULL");
+                // This channel's promotes always come pre-copied into the staging window (offset 0);
+                // the offset word is honoured anyway so the two paths stay one mechanism.
+                kvm_pull_promoted_value(
+                    noc_index,
+                    mc_value_byte_off,
+                    mc_total_len,
+                    stage_pcie_xy_enc,
+                    stage_noc_base + static_cast<uint64_t>(commit_req[kCommitReqStageReadOffWord]),
+                    value_gen);
+            }
+            ASSERT(pending_promote_slot == mc_slot);
+            const uint64_t entry_noc = dir_gen.get_noc_addr(mc_slot, 0);
+            noc_async_read(entry_noc, commit_entry_staging_addr, dir_entry_stride);
+            noc_async_read_barrier();
+            volatile tt_l1_ptr uint32_t* entry =
+                reinterpret_cast<volatile tt_l1_ptr uint32_t*>(commit_entry_staging_addr);
+            if (entry[kEntryValidWord] == 1 && entry[kEntryLocationWord] == kLocationHost &&
+                entry[kEntryTotalLenWord] == mc_total_len) {
+                entry[kEntryValueByteOffWord] = mc_value_byte_off;
+                entry[kEntryLocationWord] = kLocationDevice;
+                entry[kEntryBlockOrderWord] = pending_promote_order;
+                entry[kEntryLastAccessWord] = ++(*epoch);
+                noc_async_write(commit_entry_staging_addr, entry_noc, 32);
+                noc_async_write_barrier();
+                noc_async_read(entry_noc, commit_entry_staging_addr, 32);
+                noc_async_read_barrier();
+                residency_lru_insert_mru(mc_slot, residency_lru, allocator);
+                live_device_bytes += kMaxChunkValueBytes << pending_promote_order;
+                ASSERT(live_device_bytes <= value_heap_bytes);
+            } else {
+                buddy_free(
+                    mc_value_byte_off / kMaxChunkValueBytes,
+                    pending_promote_order,
+                    num_heap_units,
+                    allocator,
+                    heap_metadata_gen,
+                    heap_metadata_staging);
+            }
+            if (stage_enabled) {
+                kvm_publish_host_completion(
+                    noc_index,
+                    stage_pcie_xy_enc,
+                    stage_noc_base + static_cast<uint64_t>(stage_completion_offset),
+                    commit_req_seen,
+                    heap_metadata_staging);
+            }
+            noc_semaphore_inc(promote_done_noc, 1);
+            noc_async_atomic_barrier();
+            pending_promote_slot = kBucketDirSlotEmpty;
+            pending_promote_order = 0;
+        }
+    }
+}
diff --git a/ttnn/cpp/ttnn/operations/kvcache_manager/server/device/kernels/dataflow/get_admission_kernel.cpp b/ttnn/cpp/ttnn/operations/kvcache_manager/server/device/kernels/dataflow/get_admission_kernel.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e6a3218004bd53db95e69691855293e4b5a2eb2b
--- /dev/null
+++ b/ttnn/cpp/ttnn/operations/kvcache_manager/server/device/kernels/dataflow/get_admission_kernel.cpp
@@ -0,0 +1,147 @@
+// SPDX-FileCopyrightText: (c) 2026 Moreh
+//
+// SPDX-License-Identifier: Apache-2.0
+
+// Fabric-free mapped-host GET cache admission worker (RISCV_0 / NOC0) on a dedicated Tensix.
+// BRISC produces each host batch once in core 0's GET CB; this worker copies it into private L1 and
+// owns the complete server-DRAM fill while the server NCRISC independently streams the same CB pages.
+
+#include <cstddef>
+#include <cstdint>
+
+#include "api/dataflow/dataflow_api.h"
+#include "tt_metal/fabric/fabric_edm_packet_header.hpp"
+
+#include "ttnn/cpp/ttnn/operations/kvcache_manager/common/protocol/layout.hpp"
+#include "ttnn/cpp/ttnn/operations/kvcache_manager/common/protocol/packet.hpp"
+
+using namespace ttnn::operations::kvcache_manager::protocol;
+
+void kernel_main() {
+    size_t rt_arg_idx = 0;
+    const uint32_t termination_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t ready_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t descriptor_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t scratch_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t server_noc0_x = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t server_noc0_y = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t get_cb_base = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t admission_progress_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t dram_value_base = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t seen_ready = get_arg_val<uint32_t>(rt_arg_idx++);
+
+    auto* termination = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(termination_addr);
+    auto* ready = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(ready_addr);
+    auto* descriptor = reinterpret_cast<volatile tt_l1_ptr GetAdmissionDescriptor*>(descriptor_addr);
+
+    const uint32_t server_x = DYNAMIC_NOC_X(noc_index, server_noc0_x);
+    const uint32_t server_y = DYNAMIC_NOC_Y(noc_index, server_noc0_y);
+    const uint32_t get_cb_end = get_cb_base + kGetValueCbDepth * kMaxChunkValueBytes;
+    const uint64_t source_done_noc =
+        get_noc_addr(server_x, server_y, admission_progress_addr + kGetAdmissionSourceDoneWord * sizeof(uint32_t));
+    const uint64_t write_done_noc =
+        get_noc_addr(server_x, server_y, admission_progress_addr + kGetAdmissionWriteDoneWord * sizeof(uint32_t));
+    const InterleavedAddrGen<true> value_gen{
+        .bank_base_address = dram_value_base,
+        .page_size = kMaxChunkValueBytes,
+    };
+
+    bool active = false;
+    uint32_t first_ready_ticket = 0;
+    uint32_t source_l1_addr = 0;
+    uint32_t heap_base_unit = 0;
+    uint32_t total_value_len = 0;
+    uint32_t num_chunks = 0;
+    uint32_t num_batches = 0;
+    uint32_t batch_index = 0;
+    uint32_t durable_ticket = seen_ready;
+    uint32_t durable_completed = seen_ready;
+    uint32_t scratch_batches_in_flight = 0;
+
+    while (true) {
+        invalidate_l1_cache();
+        if (*termination == static_cast<uint32_t>(tt::tt_fabric::TerminationSignal::IMMEDIATELY_TERMINATE)) {
+            if (active) {
+                noc_async_write_barrier();
+            }
+            return;
+        }
+
+        const uint32_t published_ready = *ready;
+        if (!cumulative_counter_is_ahead(published_ready, seen_ready)) {
+            continue;
+        }
+        const uint32_t next_ready = seen_ready + 1u;
+
+        if (!active) {
+            invalidate_l1_cache();
+            ASSERT(descriptor->first_ready_ticket == next_ready);
+            ASSERT(descriptor->first_ready_ticket_end == next_ready);
+            first_ready_ticket = descriptor->first_ready_ticket;
+            source_l1_addr = descriptor->first_cb_l1_addr;
+            heap_base_unit = descriptor->heap_base_unit;
+            total_value_len = descriptor->total_value_len;
+            num_chunks = descriptor->num_chunks;
+            num_batches = descriptor->num_batches;
+            durable_ticket = descriptor->durable_ticket;
+            batch_index = 0;
+            ASSERT(num_chunks > 0);
+            ASSERT(num_batches == (num_chunks + kGetValueCbReadBatch - 1u) / kGetValueCbReadBatch);
+            ASSERT(source_l1_addr >= get_cb_base);
+            ASSERT(source_l1_addr + kGetValueCbReadBatch * kMaxChunkValueBytes <= get_cb_end);
+            ASSERT(durable_ticket == durable_completed + 1u);
+            scratch_batches_in_flight = 0;
+            active = true;
+        }
+
+        ASSERT(next_ready == first_ready_ticket + batch_index);
+        ASSERT(batch_index < num_batches);
+        const uint32_t chunk_base = batch_index * kGetValueCbReadBatch;
+        const uint32_t this_batch =
+            (num_chunks - chunk_base < kGetValueCbReadBatch) ? (num_chunks - chunk_base) : kGetValueCbReadBatch;
+        const uint32_t batch_span = this_batch * kMaxChunkValueBytes;
+        const uint32_t batch_left = total_value_len - chunk_base * kMaxChunkValueBytes;
+        const uint32_t batch_bytes = (batch_span < batch_left) ? batch_span : batch_left;
+
+        if (scratch_batches_in_flight == kGetValueCbDepth / kGetValueCbReadBatch) {
+            // The mirrored scratch may be reused once every write has left L1; request-final
+            // durability is established by the full barrier before durable_done is published.
+            noc_async_writes_flushed();
+            scratch_batches_in_flight = 0;
+        }
+        const uint32_t scratch_batch_addr = scratch_addr + source_l1_addr - get_cb_base;
+        const uint64_t source_noc = get_noc_addr(server_x, server_y, source_l1_addr);
+        noc_async_read(source_noc, scratch_batch_addr, (batch_bytes + 31u) & ~31u);
+        noc_async_read_barrier();
+        noc_semaphore_inc(source_done_noc, 1);
+        noc_async_atomic_barrier();
+
+        for (uint32_t k = 0; k < this_batch; ++k) {
+            const uint32_t chunk = chunk_base + k;
+            const uint32_t stream_pos = chunk * kMaxChunkValueBytes;
+            const uint32_t remaining = total_value_len - stream_pos;
+            const uint32_t chunk_value_len = (remaining < kMaxChunkValueBytes) ? remaining : kMaxChunkValueBytes;
+            noc_async_write(
+                scratch_batch_addr + k * kMaxChunkValueBytes,
+                value_gen.get_noc_addr(heap_base_unit + chunk, 0),
+                (chunk_value_len + 31u) & ~31u);
+        }
+        ++scratch_batches_in_flight;
+
+        seen_ready = next_ready;
+        ++batch_index;
+        source_l1_addr += kGetValueCbReadBatch * kMaxChunkValueBytes;
+        if (source_l1_addr == get_cb_end) {
+            source_l1_addr = get_cb_base;
+        }
+        ASSERT(source_l1_addr < get_cb_end);
+        if (batch_index == num_batches) {
+            noc_async_write_barrier();
+            scratch_batches_in_flight = 0;
+            noc_semaphore_inc(write_done_noc, 1);
+            noc_async_atomic_barrier();
+            durable_completed = durable_ticket;
+            active = false;
+        }
+    }
+}
diff --git a/ttnn/cpp/ttnn/operations/kvcache_manager/server/device/kernels/dataflow/get_ingress_kernel.cpp b/ttnn/cpp/ttnn/operations/kvcache_manager/server/device/kernels/dataflow/get_ingress_kernel.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e2965da43b4f935aaf386390f0749b51825fc8cd
--- /dev/null
+++ b/ttnn/cpp/ttnn/operations/kvcache_manager/server/device/kernels/dataflow/get_ingress_kernel.cpp
@@ -0,0 +1,81 @@
+// SPDX-FileCopyrightText: (c) 2026 Moreh
+//
+// SPDX-License-Identifier: Apache-2.0
+//
+// Fabric-free scalar GET ingress worker (RISCV_0 / NOC0) on a separate server Tensix. It reads one
+// host-published descriptor and copies the existing GET_CHUNK_REQ packet into core 0's request ring.
+// The server NCRISC remains the sole payload Fabric owner.
+
+#include <cstddef>
+#include <cstdint>
+
+#include "api/dataflow/dataflow_api.h"
+#include "tt_metal/fabric/fabric_edm_packet_header.hpp"
+
+#include "ttnn/cpp/ttnn/operations/kvcache_manager/common/protocol/layout.hpp"
+#include "ttnn/cpp/ttnn/operations/kvcache_manager/common/protocol/packet.hpp"
+
+using namespace ttnn::operations::kvcache_manager::protocol;
+
+void kernel_main() {
+    size_t rt_arg_idx = 0;
+    const uint32_t termination_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t doorbell_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t scratch_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t stage_pcie_xy_enc = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t stage_addr_lo = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t stage_addr_hi = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t ingress_host_offset = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t server_noc_x = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t server_noc_y = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t server_ring_base_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t server_ring_sem_base_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t ring_slots = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t seen_generation = get_arg_val<uint32_t>(rt_arg_idx++);
+
+    auto* termination = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(termination_addr);
+    auto* doorbell = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(doorbell_addr);
+    auto* descriptor = reinterpret_cast<volatile tt_l1_ptr GetIngressDescriptor*>(scratch_addr);
+    const uint64_t stage_noc_base = (static_cast<uint64_t>(stage_addr_hi) << 32) | static_cast<uint64_t>(stage_addr_lo);
+
+    while (true) {
+        invalidate_l1_cache();
+        if (*termination == static_cast<uint32_t>(tt::tt_fabric::TerminationSignal::IMMEDIATELY_TERMINATE)) {
+            return;
+        }
+
+        const uint32_t generation = *doorbell;
+        if (!cumulative_counter_is_ahead(generation, seen_generation)) {
+            continue;
+        }
+
+        const uint32_t descriptor_slot = generation % kGetIngressDescriptorSlots;
+        const uint64_t descriptor_src = stage_noc_base + static_cast<uint64_t>(ingress_host_offset) +
+                                        static_cast<uint64_t>(descriptor_slot) * sizeof(GetIngressDescriptor);
+        noc_read_with_state<noc_mode, read_cmd_buf, CQ_NOC_SNDL, CQ_NOC_SEND, CQ_NOC_WAIT>(
+            noc_index, stage_pcie_xy_enc, descriptor_src, scratch_addr, sizeof(GetIngressDescriptor));
+        noc_async_read_barrier();
+
+        ASSERT(descriptor->generation_begin == generation);
+        ASSERT(descriptor->generation_end == generation);
+        ASSERT(descriptor->ring_slot < ring_slots);
+        ASSERT(descriptor->packet_bytes >= sizeof(PacketHeader) + sizeof(GetChunkReqHeader));
+        ASSERT(descriptor->packet_bytes <= kGetIngressPacketCapacity);
+        ASSERT((descriptor->packet_bytes & 15u) == 0);
+        auto* packet =
+            reinterpret_cast<volatile tt_l1_ptr PacketHeader*>(scratch_addr + offsetof(GetIngressDescriptor, packet));
+        ASSERT(packet->opcode == static_cast<uint32_t>(OpCode::GET_CHUNK_REQ));
+
+        const uint32_t ring_slot = descriptor->ring_slot;
+        const uint64_t ring_dst =
+            get_noc_addr(server_noc_x, server_noc_y, server_ring_base_addr + ring_slot * kRingSlotStride);
+        noc_async_write(scratch_addr + offsetof(GetIngressDescriptor, packet), ring_dst, descriptor->packet_bytes);
+        noc_async_write_barrier();
+
+        const uint64_t ring_sem =
+            get_noc_addr(server_noc_x, server_noc_y, server_ring_sem_base_addr + ring_slot * kRingSemSize);
+        noc_semaphore_inc(ring_sem, 1);
+        noc_async_atomic_barrier();
+        seen_generation = generation;
+    }
+}
diff --git a/ttnn/cpp/ttnn/operations/kvcache_manager/server/device/kernels/dataflow/server_kernel.cpp b/ttnn/cpp/ttnn/operations/kvcache_manager/server/device/kernels/dataflow/server_kernel.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..551feffeb81f9f22da99b4a4555d556d45dfc074
--- /dev/null
+++ b/ttnn/cpp/ttnn/operations/kvcache_manager/server/device/kernels/dataflow/server_kernel.cpp
@@ -0,0 +1,1416 @@
+// SPDX-FileCopyrightText: (c) 2026 Moreh
+//
+// SPDX-License-Identifier: Apache-2.0
+//
+// kvcache_manager server kernel (NCRISC): a persistent op-dispatch loop that polls the fabric
+// packet ring and services one request per slot. See
+// ttnn/cpp/ttnn/operations/kvcache_manager/docs/design.md §6. RT args are parsed and
+// documented in kernel_main (the host sends values only and relies on the meanings there).
+//
+// num_connections (RT arg [1]) selects the mode: 0 = lifecycle/idle (termination-only polling,
+// no fabric), 1..kMaxConnections = data ops (one fabric connection per unique forwarding
+// direction). GET/EXISTS/REMOVE/MOVE key lookups are delegated to the BRISC DRAM worker kernel
+// (dram_worker_kernel.cpp) over the dir mailbox; the NCRISC stays the sole fabric owner and only
+// builds the wire response from the BRISC result.
+//
+// Address rule: own L1 access uses `server_l1_base + offset`; writes destined for the client
+// chip use registry-supplied `client_l1_base + offset`. Never mix the two.
+
+#include <cstdint>
+
+#include "api/dataflow/dataflow_api.h"
+#include "tt_metal/fabric/hw/inc/edm_fabric/edm_fabric_worker_adapters.hpp"
+#include "tt_metal/fabric/hw/inc/tt_fabric_mux_v2_sender.hpp"
+#include "tt_metal/fabric/hw/inc/packet_header_pool.h"
+#include "tt_metal/fabric/fabric_edm_packet_header.hpp"
+// noc_addr.h: safe_get_noc_addr / get_noc_address_components (Wormhole DRAM coord-flip to noc0)
+// + edm_to_local_chip_noc, for the client output-tensor DRAM page addr on the fabric-direct GET.
+// Replaces linear/addrgen_api.h, whose tensor_accessor/sharding pull-ins bloat the kernel past
+// the IRAM budget under device profiling.
+#include "tt_metal/fabric/hw/inc/noc_addr.h"
+#include "tt_metal/fabric/hw/inc/edm_fabric/edm_fabric_utils.hpp"
+
+#include "ttnn/cpp/ttnn/operations/kvcache_manager/common/protocol/packet.hpp"
+#include "ttnn/cpp/ttnn/operations/kvcache_manager/common/protocol/layout.hpp"
+#include "ttnn/cpp/ttnn/operations/kvcache_manager/common/kvm_fabric_route.hpp"
+
+using namespace ttnn::operations::kvcache_manager::protocol;
+// Under FABRIC_2D, kvm_fabric_route.hpp pulls in tt_fabric_api.h whose global
+// `using namespace tt::tt_fabric` makes the bare name PacketHeader ambiguous with
+// tt::tt_fabric::PacketHeader; the wire's 16 B app header is spelled through this
+// alias so both fabric modes compile from one source.
+namespace protocol = ttnn::operations::kvcache_manager::protocol;
+
+namespace {
+
+#if defined(KVM_SERVER_USE_MUX_V2)
+using KvmFabricSender = tt::tt_fabric::FabricMuxV2Sender<>;
+#else
+using KvmFabricSender = tt::tt_fabric::WorkerToFabricEdmSender;
+#endif
+
+constexpr uint32_t kMaxConnections = protocol::kMaxServerConnections;
+
+// GET owns the full per-RISC header pool while its stream is active. Matching the header ring to the
+// CB read batch lets one barrier protect both header and CB-source reuse on the fast path.
+constexpr uint32_t kGetServerHeaderRingDepth = kGetValueCbReadBatch;
+static_assert(kGetServerHeaderRingDepth == 8, "GET uses the NCRISC's eight-header pool");
+static_assert(
+    noc_mode == DM_DEDICATED_NOC,
+    "GET dual-sink requires distinct generic-write and Fabric stateful-write command buffers");
+
+// Compute the client DRAM page NoC address for a fabric-direct-to-DRAM write. Mirrors
+// linear::addrgen_detail::get_noc_address without that header's tensor_accessor/sharding pull-ins:
+// resolve the page in the edm_to_local_chip_noc (noc1) frame, then on Wormhole flip the coords to
+// noc0 (the fabric header expects noc0). Uses the SERVER's own DRAM bank NoC map, valid because
+// same-arch un-harvested-DRAM chips share it. See ttnn/cpp/ttnn/operations/kvcache_manager/docs/design.md §6 (GET).
+FORCE_INLINE uint64_t client_dram_page_noc_addr(const InterleavedAddrGen<true>& d, uint32_t page_id, uint32_t offset) {
+    uint64_t noc_address = d.get_noc_addr(page_id, offset, tt::tt_fabric::edm_to_local_chip_noc);
+#if defined(ARCH_WORMHOLE)
+    auto components = get_noc_address_components(noc_address);
+    noc_address = safe_get_noc_addr(
+        components.first.x, components.first.y, components.second, tt::tt_fabric::edm_to_local_chip_noc);
+#endif
+    return noc_address;
+}
+
+// Typed view over ONE client's registry entry. Indexed by uint32 word offset; the
+// layout matches the byte offsets documented in protocol/layout.hpp.
+struct RegistryView {
+    volatile tt_l1_ptr uint32_t* base;
+
+    FORCE_INLINE uint32_t client_mesh_id() const { return base[0]; }
+    FORCE_INLINE uint32_t client_chip_id() const { return base[1]; }
+    FORCE_INLINE uint32_t client_noc_x() const { return base[2]; }
+    FORCE_INLINE uint32_t client_noc_y() const { return base[3]; }
+    FORCE_INLINE uint32_t client_l1_base() const { return base[4]; }
+    FORCE_INLINE uint32_t recv_buffer_addr() const { return base[5]; }
+    FORCE_INLINE uint32_t recv_sem_offset() const { return base[6]; }
+    FORCE_INLINE uint32_t return_route() const { return base[kRegistryReturnRouteWord]; }
+    FORCE_INLINE uint32_t nonce_low() const { return base[8]; }
+    FORCE_INLINE uint32_t nonce_high() const { return base[9]; }
+    FORCE_INLINE uint32_t client_token() const { return base[kRegistryClientTokenWord]; }
+    FORCE_INLINE ClientRegistryState state() const {
+        return static_cast<ClientRegistryState>(base[kRegistryStateWord]);
+    }
+    FORCE_INLINE uint32_t established_flag() const { return state() == ClientRegistryState::Established; }
+    FORCE_INLINE void retire_session() {
+        base[kRegistryStateWord] = static_cast<uint32_t>(ClientRegistryState::Retired);
+    }
+    FORCE_INLINE bool nonce_matches(uint32_t low, uint32_t high) const {
+        return nonce_low() == low && nonce_high() == high;
+    }
+    FORCE_INLINE bool session_matches(volatile tt_l1_ptr EstablishRequest* request) const {
+        return client_mesh_id() == request->client_mesh_id && client_chip_id() == request->client_chip_id &&
+               client_noc_x() == request->client_noc_x && client_noc_y() == request->client_noc_y &&
+               client_l1_base() == request->client_l1_base && recv_buffer_addr() == request->recv_buffer_addr &&
+               return_route() == request->return_route && base[kRegistryResponseAddrWord] == request->response_addr &&
+               base[kRegistryResponseSemAddrWord] == request->response_sem_addr &&
+               base[kRegistryClientValueRingDepthWord] == request->client_value_ring_depth;
+    }
+    FORCE_INLINE void establish(volatile tt_l1_ptr EstablishRequest* request, uint32_t token) {
+        base[0] = request->client_mesh_id;
+        base[1] = request->client_chip_id;
+        base[2] = request->client_noc_x;
+        base[3] = request->client_noc_y;
+        base[4] = request->client_l1_base;
+        base[5] = request->recv_buffer_addr;
+        base[6] = kClientRecvSemOffset;
+        base[kRegistryReturnRouteWord] = request->return_route;
+        base[8] = request->nonce_low;
+        base[9] = request->nonce_high;
+        base[kRegistryClientTokenWord] = token;
+        base[kRegistryStateWord] = static_cast<uint32_t>(ClientRegistryState::Established);
+        base[kRegistryResponseAddrWord] = request->response_addr;
+        base[kRegistryResponseSemAddrWord] = request->response_sem_addr;
+        base[kRegistryClientValueRingDepthWord] = request->client_value_ring_depth;
+    }
+};
+
+// The entry a request names through the low bits of PacketHeader.client_token. Every response destination is read
+// from here rather than from a single "the client" record, which is what lets replies follow the
+// requester when several Clients are established at once.
+FORCE_INLINE RegistryView registry_entry(uint32_t server_l1_base, uint32_t client_id) {
+    return RegistryView{
+        reinterpret_cast<volatile tt_l1_ptr uint32_t*>(server_l1_base + registry_entry_offset(client_id))};
+}
+
+// Resolve a client_chip_id into (conn_idx, route_word) by indexing the host-prepared
+// peer_lookup_table that lives at server_l1_base + kPeerLookupTableOffset.
+// Layout per entry (8B): word[0] = conn_idx (sentinel = 0xFFFFFFFF when
+// empty), word[1] = route_word — dual-encoded: 1D hop count / 2D
+// (mesh_id<<16)|chip_id (see fabric_helpers.hpp kvcache_unicast_route_word).
+struct LookupEntry {
+    uint32_t conn_idx;
+    uint32_t route_word;
+};
+
+FORCE_INLINE LookupEntry peer_lookup(uint32_t lookup_base, uint32_t chip_id) {
+    volatile tt_l1_ptr uint32_t* lookup = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(lookup_base);
+    LookupEntry e{};
+    e.conn_idx = lookup[2 * chip_id];
+    e.route_word = lookup[2 * chip_id + 1];
+    return e;
+}
+
+// Handlers the dispatch loop reaches rarely -- roughly once per session, or on a control op whose
+// cost is dominated by a fabric round trip either way. Inlining them into the switch buys nothing,
+// and NCRISC instruction RAM is the binding constraint here: the image has to fit 0x4000 bytes and
+// sits close to it. PUT and the GET stream stay inlined -- those are the hot paths.
+#define KVM_COLD_HANDLER __attribute__((noinline, optimize("Oz")))
+
+KVM_COLD_HANDLER void send_payload_and_signal(
+    uint32_t slot_addr,
+    uint32_t total,
+    RegistryView reg,
+    LookupEntry entry,
+    KvmFabricSender* connections,
+    volatile tt_l1_ptr PACKET_HEADER_TYPE* packet_header_addr,
+    bool block_signal) {
+    auto& fab = connections[entry.conn_idx];
+    const uint64_t dst_noc = get_noc_addr(reg.client_noc_x(), reg.client_noc_y(), reg.recv_buffer_addr());
+    set_unicast_route(packet_header_addr, entry.route_word);
+    packet_header_addr->to_noc_unicast_write(tt::tt_fabric::NocUnicastCommandHeader{dst_noc}, total);
+    fab.wait_for_empty_write_slot();
+    fab.send_payload_without_header_non_blocking_from_address(slot_addr, total);
+    fab.send_payload_blocking_from_address(reinterpret_cast<uint32_t>(packet_header_addr), sizeof(PACKET_HEADER_TYPE));
+
+    const uint64_t recv_sem_noc =
+        get_noc_addr(reg.client_noc_x(), reg.client_noc_y(), reg.client_l1_base() + reg.recv_sem_offset());
+    packet_header_addr->to_noc_unicast_atomic_inc(tt::tt_fabric::NocUnicastAtomicIncCommandHeader(recv_sem_noc, 1));
+    fab.wait_for_empty_write_slot();
+    if (block_signal) {
+        fab.send_payload_flush_blocking_from_address(
+            reinterpret_cast<uint32_t>(packet_header_addr), sizeof(PACKET_HEADER_TYPE));
+    } else {
+        fab.send_payload_flush_non_blocking_from_address(
+            reinterpret_cast<uint32_t>(packet_header_addr), sizeof(PACKET_HEADER_TYPE));
+    }
+}
+
+KVM_COLD_HANDLER bool handle_establish_request(
+    uint32_t server_l1_base,
+    uint32_t client_chip_id,
+    RegistryView reg,
+    uint32_t lookup_base,
+    uint32_t dram_value_base,
+    uint32_t direct_put_done_addr,
+    uint32_t stream_progress_addr,
+    uint32_t static_intermesh_remote_mesh_id,
+    KvmFabricSender* connections,
+    volatile tt_l1_ptr PACKET_HEADER_TYPE* packet_header_addr) {
+    const uint32_t slot_addr = server_l1_base + bootstrap_request_slot_offset(client_chip_id);
+    volatile tt_l1_ptr EstablishRequest* request = reinterpret_cast<volatile tt_l1_ptr EstablishRequest*>(slot_addr);
+
+    const uint32_t request_magic = request->magic;
+    const uint32_t request_bootstrap_version = request->bootstrap_version;
+    const uint32_t request_wire_version = request->wire_layout_version;
+    const uint32_t request_capabilities = request->required_capabilities;
+    const uint32_t request_mesh_id = request->client_mesh_id;
+    const uint32_t request_chip_id = request->client_chip_id;
+    const uint32_t request_noc_x = request->client_noc_x;
+    const uint32_t request_noc_y = request->client_noc_y;
+    const uint32_t response_addr = request->response_addr;
+    const uint32_t response_sem_addr = request->response_sem_addr;
+    const uint32_t nonce_low = request->nonce_low;
+    const uint32_t nonce_high = request->nonce_high;
+    const uint32_t client_l1_base = request->client_l1_base;
+    const uint32_t recv_buffer_addr = request->recv_buffer_addr;
+    const uint32_t client_value_ring_depth = request->client_value_ring_depth;
+    const uint32_t request_return_route = request->return_route;
+    const uint32_t client_num_dram_channels = request->num_dram_channels;
+    const uint32_t client_dram_grid_x = request->dram_grid_x;
+    const uint32_t client_dram_grid_y = request->dram_grid_y;
+    const uint32_t request_reserved_tail = request->reserved_tail;
+    LookupEntry entry = peer_lookup(lookup_base, client_chip_id);
+#if defined(KVM_STATIC_INTERMESH_T3K_TO_GALAXY)
+    const bool request_return_route_usable =
+        return_route_valid(request_return_route) && return_route_dst_mesh(request_return_route) == request_mesh_id &&
+        return_route_dst_mesh(request_return_route) == static_intermesh_remote_mesh_id &&
+        return_route_dst_chip(request_return_route) == request_chip_id && request_chip_id == client_chip_id;
+#endif
+
+    const EstablishRegistryAction registry_action =
+        establish_registry_action(reg.state(), reg.nonce_matches(nonce_low, nonce_high));
+    if (registry_action == EstablishRegistryAction::Drop) {
+        return false;
+    }
+
+    volatile tt_l1_ptr EstablishResponse* response_template =
+        reinterpret_cast<volatile tt_l1_ptr EstablishResponse*>(server_l1_base + kBootstrapResponseTemplateOffset);
+    EstablishResponseStatus status = EstablishResponseStatus::Accepted;
+    if (request_magic != kBootstrapMagic || request_bootstrap_version != kBootstrapProtocolVersion) {
+        status = EstablishResponseStatus::BootstrapVersionMismatch;
+    } else if (request_wire_version != response_template->descriptor.wire_layout_version) {
+        status = EstablishResponseStatus::WireVersionMismatch;
+    } else if (!establish_capabilities_are_compatible(
+                   request_capabilities, response_template->capabilities, kRequiredCapabilities)) {
+        status = EstablishResponseStatus::CapabilityMismatch;
+    } else if (
+#if defined(KVM_STATIC_INTERMESH_T3K_TO_GALAXY)
+        !request_return_route_usable ||
+#else
+        request_return_route != 0 ||
+#endif
+        request_reserved_tail != 0 || response_template->descriptor.reserved != 0 ||
+        client_value_ring_depth != response_template->descriptor.value_ring_depth) {
+        status = EstablishResponseStatus::InvalidRequest;
+    } else if (
+        request_chip_id != client_chip_id || request_chip_id >= kBootstrapPeerSlots || request_noc_x > 63 ||
+        request_noc_y > 63 || response_addr == 0 || response_sem_addr == 0 || client_l1_base == 0 ||
+        client_l1_base % 32 != 0 || recv_buffer_addr == 0 || recv_buffer_addr % 16 != 0) {
+        status = EstablishResponseStatus::InvalidPeer;
+    } else if (
+        client_num_dram_channels != response_template->descriptor.num_dram_channels ||
+        client_dram_grid_x != response_template->descriptor.dram_grid_x ||
+        client_dram_grid_y != response_template->descriptor.dram_grid_y) {
+        status = EstablishResponseStatus::DramGeometryMismatch;
+    }
+
+    uint32_t client_token = 0;
+    bool reset_partition = false;
+    bool publish_session_config = false;
+    if (status == EstablishResponseStatus::Accepted) {
+        if (registry_action == EstablishRegistryAction::Replay) {
+            if (reg.session_matches(request)) {
+                client_token = reg.client_token();
+            } else {
+                return false;
+            }
+        } else {
+            const uint32_t generation = next_client_generation(client_generation_from_token(reg.client_token()));
+            client_token = make_client_token(client_chip_id, generation);
+            reg.establish(request, client_token);
+            publish_session_config = true;
+            // Retire every packet from the previous generation before returning the new token.
+            for (uint32_t slot = 0; slot < kRingSlotsPerClient; ++slot) {
+                const uint32_t ring_slot = ring_base_slot(client_chip_id) + slot;
+                *reinterpret_cast<volatile tt_l1_ptr uint32_t*>(
+                    server_l1_base + kRingSemBaseOffset + ring_slot * kRingSemSize) = 0;
+            }
+            reset_partition = true;
+        }
+    }
+
+    // Keep response staging outside the request table: a timed-out Client may rewrite its request
+    // slot while this serialized handler is still sending the prior response.
+    volatile tt_l1_ptr EstablishResponse* response = response_template;
+    response->status = static_cast<uint32_t>(status);
+    response->nonce_low = nonce_low;
+    response->nonce_high = nonce_high;
+    response->client_token = client_token;
+
+    if (entry.conn_idx == kPeerLookupEmptySentinel || response_addr == 0 || response_sem_addr == 0 ||
+        request_noc_x > 63 || request_noc_y > 63) {
+        return reset_partition;
+    }
+#if defined(KVM_STATIC_INTERMESH_T3K_TO_GALAXY)
+    if (request_return_route_usable) {
+        entry.route_word = request_return_route;
+        if (status == EstablishResponseStatus::Accepted) {
+            volatile tt_l1_ptr uint32_t* lookup = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(lookup_base);
+            lookup[2 * client_chip_id + 1] = request_return_route;
+        }
+    }
+#endif
+    auto& fab = connections[entry.conn_idx];
+    set_unicast_route(packet_header_addr, entry.route_word);
+
+    if (status == EstablishResponseStatus::Accepted && publish_session_config) {
+        constexpr uint32_t session_bytes = sizeof(PutSessionConfig) + sizeof(PutLeaseDescriptor);
+        static_assert(sizeof(EstablishResponse) + session_bytes <= kBootstrapRequestSlotStride);
+        const uint32_t session_addr = slot_addr + sizeof(EstablishResponse);
+        volatile tt_l1_ptr uint32_t* session = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(session_addr);
+        session[0] = kPutSessionVersion;
+        session[1] = dram_value_base;
+        session[2] = direct_put_done_addr;
+        session[3] = stream_progress_addr;
+        session[4] = 0;
+        session[5] = 0;
+        session[6] = 0;
+        session[7] = 0;
+
+        const uint64_t session_noc =
+            get_noc_addr(request_noc_x, request_noc_y, client_l1_base + kClientPutSessionConfigOffset);
+        packet_header_addr->to_noc_unicast_write(tt::tt_fabric::NocUnicastCommandHeader{session_noc}, session_bytes);
+        fab.wait_for_empty_write_slot();
+        fab.send_payload_without_header_non_blocking_from_address(session_addr, session_bytes);
+        fab.send_payload_blocking_from_address(
+            reinterpret_cast<uint32_t>(packet_header_addr), sizeof(PACKET_HEADER_TYPE));
+
+#if defined(KVM_INJECT_DROP_FIRST_ESTABLISH_RESPONSE)
+        return reset_partition;
+#endif
+
+#if defined(KVM_INJECT_DELAY_ESTABLISH_RESPONSE)
+        constexpr uint64_t kTestResponseDelayCycles = 500000000ULL;
+        const uint64_t delay_start = get_timestamp();
+        while (get_timestamp() - delay_start < kTestResponseDelayCycles) {
+        }
+#endif
+    }
+
+    const uint64_t response_noc = get_noc_addr(request_noc_x, request_noc_y, response_addr);
+    const uint64_t response_sem_noc = get_noc_addr(request_noc_x, request_noc_y, response_sem_addr);
+    packet_header_addr->to_noc_fused_unicast_write_atomic_inc(
+        tt::tt_fabric::NocUnicastAtomicIncFusedCommandHeader{response_noc, response_sem_noc, 1, /*flush=*/true},
+        sizeof(EstablishResponse));
+    fab.wait_for_empty_write_slot();
+    fab.send_payload_without_header_non_blocking_from_address(
+        server_l1_base + kBootstrapResponseTemplateOffset, sizeof(EstablishResponse));
+    fab.send_payload_blocking_from_address(reinterpret_cast<uint32_t>(packet_header_addr), sizeof(PACKET_HEADER_TYPE));
+    return reset_partition;
+}
+
+// Response to a BRISC directory request. GET uses the fields as named, EXISTS uses only
+// found, REMOVE packs its removed flag and slot into found, and direct PUT reinterprets the
+// fields as grant/allocation state. MOVE ignores the response. See
+// ttnn/cpp/ttnn/operations/kvcache_manager/docs/design.md §6.
+struct DirResult {
+    uint32_t found;
+    uint32_t total_value_len;
+    uint32_t num_chunks;
+    uint32_t value_byte_off;  // U-aligned byte offset of the value in the heap (sub-page packing)
+};
+
+struct PutLeaseState {
+    uint32_t generation;
+    uint32_t value_byte_off;
+    uint32_t buddy_order;
+    bool valid;
+};
+
+// NCRISC <-> BRISC directory mailbox state. The req/done sems are cumulative and never reset.
+// Server's debug/test remove may also issue through this mailbox while the client is sequentially
+// idle, so every NCRISC request resynchronizes from the shared request count before publishing.
+// Set up once in kernel_main and threaded through the handlers.
+struct DirMailbox {
+    uint32_t req_mailbox_addr;
+    uint32_t req_sem_addr;
+    uint32_t done_sem_addr;
+    uint32_t resp_mailbox_addr;
+    uint32_t issued;
+};
+
+// Delegate a key lookup to the BRISC DRAM worker kernel and block on the result.
+//   op:      OpCode (GET_CHUNK_REQ for GET, EXISTS for EXISTS)
+//   key_src: L1 address of the request key bytes (in the ring slot)
+//   key_len: key byte count (1..max_key_len)
+//   output_capacity_bytes: GET output capacity; zero for other ops
+// Writes the request mailbox via NoC (so the bytes land in SRAM for the other
+// RISC), inc's the request sem, waits for the matching done count, then reads the
+// response mailbox back. See dram_worker_kernel.cpp for the peer protocol.
+// Keep this shared path out of line: four handlers use it and NCRISC instruction RAM is limited.
+__attribute__((noinline, flatten, optimize("Oz"))) DirResult
+dir_lookup(DirMailbox& mb, uint32_t op, uint32_t key_src, uint32_t key_len, uint32_t output_capacity_bytes) {
+    constexpr uint32_t kReqKeyByteOffset = kDirReqMailboxHeaderBytes;
+    const uint64_t own_noc_req = get_noc_addr(my_x[noc_index], my_y[noc_index], mb.req_mailbox_addr);
+    const uint64_t own_noc_req_sem = get_noc_addr(my_x[noc_index], my_y[noc_index], mb.req_sem_addr);
+    const uint64_t own_noc_key_src = get_noc_addr(my_x[noc_index], my_y[noc_index], key_src);
+
+    noc_inline_dw_write(own_noc_req + 0, op);
+    noc_inline_dw_write(own_noc_req + 4, key_len);
+    noc_inline_dw_write(own_noc_req + 8, output_capacity_bytes);
+    const uint32_t key_copy = (key_len + 15u) & ~15u;
+    noc_async_read(own_noc_key_src, mb.req_mailbox_addr + kReqKeyByteOffset, key_copy);
+    noc_async_read_barrier();
+    noc_async_write_barrier();
+
+    invalidate_l1_cache();
+    volatile tt_l1_ptr uint32_t* req_sem = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(mb.req_sem_addr);
+    const uint32_t shared_issued = *req_sem;
+    if (cumulative_counter_is_ahead(shared_issued, mb.issued)) {
+        mb.issued = shared_issued;
+    }
+    ++mb.issued;
+    noc_semaphore_inc(own_noc_req_sem, 1);
+    noc_async_atomic_barrier();
+
+    volatile tt_l1_ptr uint32_t* done_sem = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(mb.done_sem_addr);
+    noc_semaphore_wait(done_sem, mb.issued);
+    invalidate_l1_cache();
+
+    volatile tt_l1_ptr uint32_t* resp = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(mb.resp_mailbox_addr);
+    DirResult result{};
+    result.found = resp[0];
+    result.total_value_len = resp[1];
+    result.num_chunks = resp[2];
+    result.value_byte_off = resp[3];
+    return result;
+}
+
+KVM_COLD_HANDLER void handle_ping(
+    volatile tt_l1_ptr protocol::PacketHeader* hdr,
+    uint32_t slot_addr,
+    uint32_t psize,
+    RegistryView reg,
+    uint32_t lookup_base,
+    KvmFabricSender* connections,
+    volatile tt_l1_ptr PACKET_HEADER_TYPE* packet_header_addr) {
+    ASSERT(reg.established_flag() == 1);
+
+    LookupEntry entry = peer_lookup(lookup_base, reg.client_chip_id());
+    ASSERT(entry.conn_idx != kPeerLookupEmptySentinel);
+
+    // In-place mutate the slot's opcode to ECHO. seq / payload_size / client_token
+    // reflect verbatim.
+    hdr->opcode = static_cast<uint32_t>(OpCode::ECHO);
+
+    // fabric_write granularity is 16 bytes — pad up so trailing payload bytes
+    // are not stomped by DMA padding. Client reads only the exact byte range.
+    uint32_t total = (sizeof(protocol::PacketHeader) + psize + 15) & ~15u;
+
+    send_payload_and_signal(slot_addr, total, reg, entry, connections, packet_header_addr, false);
+}
+
+// Direct PUT controller. Chunk 0 alone enters the server L1 ring and binds a pre-issued lease, or
+// obtains a BRISC-selected catalog slot and buddy block on fallback. The client writes value chunks
+// directly into that device-DRAM block and flush-increments the session completion counter. After a
+// read-back fence, BRISC publishes a device-pending-host directory entry and queues write-through;
+// landed is returned as soon as that publication is durable.
+__attribute__((noinline, optimize("Oz"))) void handle_put(
+    uint32_t slot_addr,
+    RegistryView reg,
+    uint32_t lookup_base,
+    KvmFabricSender* connections,
+    volatile tt_l1_ptr PACKET_HEADER_TYPE* packet_header_addr,
+    uint32_t dram_value_base,
+    uint32_t max_keys,
+    uint32_t direct_put_done_addr,
+    DirMailbox* dir_mailbox,
+    uint32_t rb_scratch_addr,
+    PutLeaseState& put_lease,
+    uint32_t& direct_done_expected,
+    volatile tt_l1_ptr uint32_t* commit_issued,
+    uint32_t& put_issued_total) {
+    ASSERT(reg.established_flag() == 1);
+
+    volatile tt_l1_ptr ChunkedPayloadHeader* ch =
+        reinterpret_cast<volatile tt_l1_ptr ChunkedPayloadHeader*>(slot_addr + sizeof(protocol::PacketHeader));
+    const uint32_t chunk_idx = ch->chunk_idx;
+    const uint32_t num_chunks = ch->num_chunks;
+    const uint32_t chunk_len = ch->chunk_payload_len;
+    const uint32_t total_value_len = ch->total_value_len;
+    const uint32_t required_order = buddy_order_for_value_bytes(total_value_len);
+    const bool uses_lease = (ch->status_flags & kPutStatusUsesLease) != 0;
+    if (uses_lease) {
+        ASSERT(put_lease.valid);
+        ASSERT(ch->tensor_slot_id == put_lease.generation);
+        ASSERT(ch->value_byte_off == put_lease.value_byte_off);
+        ASSERT(required_order == put_lease.buddy_order);
+    }
+    uint32_t prior_lease_valid = put_lease.valid ? 1u : 0u;
+    uint32_t prior_lease_value_byte_off = put_lease.value_byte_off;
+    uint32_t prior_lease_order = put_lease.buddy_order;
+
+    // Only chunk 0 enters the server packet ring. BRISC binds its lease or reserves a fallback block
+    // through the directory mailbox while value chunks Fabric-write from client L1 straight into
+    // that block. A prepare retry leaves the current lease untouched; BRISC consumes one pending-host
+    // queue entry before asking this RISC to retry when a pending directory entry pins capacity.
+    ASSERT(chunk_idx == 0);
+    {
+        const uint32_t key_src =
+            slot_addr + sizeof(protocol::PacketHeader) + sizeof(ChunkedPayloadHeader) + sizeof(TensorMetadata);
+        const uint64_t req_noc = get_noc_addr(my_x[noc_index], my_y[noc_index], dir_mailbox->req_mailbox_addr);
+        volatile tt_l1_ptr uint32_t* lease_resp =
+            reinterpret_cast<volatile tt_l1_ptr uint32_t*>(dir_mailbox->resp_mailbox_addr + 4 * sizeof(uint32_t));
+        DirResult allocation{};
+        do {
+            noc_inline_dw_write(req_noc + 12, prior_lease_value_byte_off);
+            noc_inline_dw_write(req_noc + 16, prior_lease_order);
+            noc_inline_dw_write(req_noc + 20, prior_lease_valid);
+            allocation = dir_lookup(
+                *dir_mailbox,
+                uses_lease ? kDirOpPutBindLease : static_cast<uint32_t>(OpCode::PUT_CHUNK),
+                key_src,
+                chunk_len,
+                total_value_len);
+            if (allocation.found != kPutGrantGranted) {
+                prior_lease_valid = lease_resp[0];
+                prior_lease_order = lease_resp[1];
+                prior_lease_value_byte_off = lease_resp[2];
+            }
+        } while (allocation.found != kPutGrantGranted);
+        put_lease.valid = false;
+        if (lease_resp[0] == kPutGrantGranted) {
+            ++put_lease.generation;
+            if (put_lease.generation == 0) {
+                ++put_lease.generation;
+            }
+            put_lease.value_byte_off = lease_resp[2];
+            put_lease.buddy_order = lease_resp[1];
+            put_lease.valid = true;
+        }
+        const uint32_t dir_slot = allocation.total_value_len;
+        const uint32_t value_byte_off = allocation.value_byte_off;
+        const uint32_t block_order = allocation.num_chunks;
+        ASSERT(dir_slot < max_keys);
+        ASSERT((value_byte_off % kMaxChunkValueBytes) == 0);
+
+        volatile tt_l1_ptr uint32_t* direct_done = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(direct_put_done_addr);
+
+        LookupEntry peer = peer_lookup(lookup_base, reg.client_chip_id());
+        ASSERT(peer.conn_idx != kPeerLookupEmptySentinel);
+        auto& fab = connections[peer.conn_idx];
+        const uint64_t recv_sem_noc =
+            get_noc_addr(reg.client_noc_x(), reg.client_noc_y(), reg.client_l1_base() + reg.recv_sem_offset());
+        const uint32_t request_seq = reinterpret_cast<volatile tt_l1_ptr protocol::PacketHeader*>(slot_addr)->seq;
+        if (!uses_lease) {
+            // Reuse the consumed request slot as the small grant response. Both payload and semaphore
+            // target client L1, so fused write+atomic is safe here (unlike the following DRAM stream).
+            volatile tt_l1_ptr protocol::PacketHeader* grant_header =
+                reinterpret_cast<volatile tt_l1_ptr protocol::PacketHeader*>(slot_addr);
+            grant_header->opcode = static_cast<uint32_t>(OpCode::PUT_ACK);
+            grant_header->seq = request_seq;
+            grant_header->payload_size = sizeof(PutGrantPayload);
+            // client_token stays as the request wrote it (the grant reuses the request slot).
+            volatile tt_l1_ptr PutGrantPayload* grant =
+                reinterpret_cast<volatile tt_l1_ptr PutGrantPayload*>(slot_addr + sizeof(protocol::PacketHeader));
+            grant->status = kPutGrantGranted;
+            grant->dram_value_base = dram_value_base;
+            grant->value_byte_off = value_byte_off;
+            grant->completion_l1_addr = direct_put_done_addr;
+
+            const uint32_t grant_bytes = sizeof(protocol::PacketHeader) + sizeof(PutGrantPayload);
+            const uint64_t grant_dst = get_noc_addr(reg.client_noc_x(), reg.client_noc_y(), reg.recv_buffer_addr());
+            set_unicast_route(packet_header_addr, peer.route_word);
+            packet_header_addr->to_noc_fused_unicast_write_atomic_inc(
+                tt::tt_fabric::NocUnicastAtomicIncFusedCommandHeader{grant_dst, recv_sem_noc, 1, /*flush=*/true},
+                grant_bytes);
+            fab.wait_for_empty_write_slot();
+            fab.send_payload_without_header_non_blocking_from_address(slot_addr, grant_bytes);
+            fab.send_payload_blocking_from_address(
+                reinterpret_cast<uint32_t>(packet_header_addr), sizeof(PACKET_HEADER_TYPE));
+        }
+        ++direct_done_expected;
+        noc_semaphore_wait(direct_done, direct_done_expected);
+
+        // The completion atomic flushed the receiving Fabric channel. A same-requestor read-back
+        // closes the local device-DRAM visibility fence before publishing the directory entry.
+        const uint32_t value_chunks = num_chunks - 1;
+        ASSERT(value_chunks > 0);
+        InterleavedAddrGen<true> dram_value{
+            .bank_base_address = dram_value_base,
+            .page_size = kMaxChunkValueBytes,
+        };
+        const uint32_t last_unit = value_byte_off / kMaxChunkValueBytes + value_chunks - 1;
+        noc_async_read(dram_value.get_noc_addr(last_unit, 0), rb_scratch_addr, kPutReadbackScratchSize);
+        noc_async_read_barrier();
+
+        // The directory is the device-visible authority at landed time. Host generation is filled in
+        // later by the queue consumer; request_seq is the token that prevents a stale queue item from
+        // patching a reused slot.
+        DirResult published{};
+        do {
+            noc_inline_dw_write(req_noc + 12, dir_slot);
+            noc_inline_dw_write(req_noc + 16, value_byte_off);
+            noc_inline_dw_write(req_noc + 20, block_order);
+            noc_inline_dw_write(req_noc + 24, request_seq);
+            published = dir_lookup(*dir_mailbox, kDirOpPutPublish, key_src, chunk_len, total_value_len);
+        } while (published.found != kPutGrantGranted);
+
+        // Publish the device-owned commit frontier before landed can reach the Client. A later
+        // COMMIT_BARRIER snapshots this prefix; BRISC advances commit_done once per published PUT.
+        ++put_issued_total;
+        *commit_issued = put_issued_total;
+
+        // Publish the next adaptive lease in the same flush-fenced packet as landed completion.
+        // Landed is recv event one on a lease hit and event two on the grant fallback.
+        volatile tt_l1_ptr PutLeaseDescriptor* next_lease = reinterpret_cast<volatile tt_l1_ptr PutLeaseDescriptor*>(
+            dir_mailbox->resp_mailbox_addr + 4 * sizeof(uint32_t));
+        if (put_lease.valid) {
+            next_lease->generation = put_lease.generation;
+            next_lease->value_byte_off = put_lease.value_byte_off;
+            next_lease->buddy_order = put_lease.buddy_order;
+            next_lease->status = kPutLeaseReady;
+        } else {
+            next_lease->generation = put_lease.generation;
+            next_lease->value_byte_off = 0;
+            next_lease->buddy_order = 0;
+            next_lease->status = 0;
+        }
+        const uint64_t lease_noc = get_noc_addr(
+            reg.client_noc_x(), reg.client_noc_y(), reg.client_l1_base() + kClientPutLeaseDescriptorOffset);
+        set_unicast_route(packet_header_addr, peer.route_word);
+        packet_header_addr->to_noc_fused_unicast_write_atomic_inc(
+            tt::tt_fabric::NocUnicastAtomicIncFusedCommandHeader{lease_noc, recv_sem_noc, 1, /*flush=*/true},
+            sizeof(PutLeaseDescriptor));
+        fab.wait_for_empty_write_slot();
+        fab.send_payload_without_header_non_blocking_from_address(
+            dir_mailbox->resp_mailbox_addr + 4 * sizeof(uint32_t), sizeof(PutLeaseDescriptor));
+        fab.send_payload_blocking_from_address(
+            reinterpret_cast<uint32_t>(packet_header_addr), sizeof(PACKET_HEADER_TYPE));
+
+        return;
+    }
+}
+
+KVM_COLD_HANDLER bool wait_for_commit_prefix(
+    uint32_t target, volatile tt_l1_ptr uint32_t* commit_done, volatile tt_l1_ptr uint32_t* termination_ptr) {
+    while (true) {
+        invalidate_l1_cache();
+        const uint32_t observed = *commit_done;
+        if (observed == target || cumulative_counter_is_ahead(observed, target)) {
+            return true;
+        }
+        if (*termination_ptr == static_cast<uint32_t>(tt::tt_fabric::TerminationSignal::IMMEDIATELY_TERMINATE)) {
+            return false;
+        }
+    }
+}
+
+KVM_COLD_HANDLER void handle_commit_barrier(
+    RegistryView reg,
+    uint32_t lookup_base,
+    uint32_t target,
+    volatile tt_l1_ptr uint32_t* commit_done,
+    volatile tt_l1_ptr uint32_t* termination_ptr,
+    KvmFabricSender* connections,
+    volatile tt_l1_ptr PACKET_HEADER_TYPE* packet_header_addr) {
+    ASSERT(reg.established_flag() == 1);
+
+    if (!wait_for_commit_prefix(target, commit_done, termination_ptr)) {
+        return;
+    }
+
+    LookupEntry entry = peer_lookup(lookup_base, reg.client_chip_id());
+    ASSERT(entry.conn_idx != kPeerLookupEmptySentinel);
+    auto& fab = connections[entry.conn_idx];
+    const uint64_t recv_sem_noc =
+        get_noc_addr(reg.client_noc_x(), reg.client_noc_y(), reg.client_l1_base() + reg.recv_sem_offset());
+    set_unicast_route(packet_header_addr, entry.route_word);
+    packet_header_addr->to_noc_unicast_atomic_inc(
+        tt::tt_fabric::NocUnicastAtomicIncCommandHeader{recv_sem_noc, 1, /*flush=*/true});
+    fab.wait_for_empty_write_slot();
+    fab.send_payload_flush_blocking_from_address(
+        reinterpret_cast<uint32_t>(packet_header_addr), sizeof(PACKET_HEADER_TYPE));
+}
