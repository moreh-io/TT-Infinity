index 0000000000000000000000000000000000000000..38e1d9b77a7c3bfdd21fee1fd19ed3918b299c6c
--- /dev/null
+++ b/ttnn/cpp/ttnn/operations/kvcache_manager/gather/device/kernels/dataflow/gather_push_kernel.cpp
@@ -0,0 +1,221 @@
+// SPDX-FileCopyrightText: (c) 2026 Moreh
+//
+// SPDX-License-Identifier: Apache-2.0
+//
+// TP-shard gather, sender half (RISCV_1 / NOC1). Runs on every chip that owns a shard of a paged
+// KV cache and pushes the blocks of one chunk into the master chip's DRAM over fabric, so a wire
+// PUT can read the whole chunk from a single chip without a host round trip.
+//
+// Fabric reads are UDM-gated and the wire pins the low-latency mesh header, so the master cannot
+// pull: every owner writes, then signals with one fused write+atomic_inc into a master-chip
+// counter. The host waits for that counter to reach the number of senders.
+//
+// The destination layout matches the host planner's blob byte-for-byte
+// (moreh_raw_byte_copy_nanobind.cpp build_tp_interleaved_region_raw_mesh_runs): for member m,
+// chunk block index cb and rank r, the run lands at region_base[m] + cb*block_bytes +
+// r*shard_block_bytes. The master also writes the value's leading header words itself -- the host
+// knows them, but poking them over PCIe would cost more than the whole gather on a non-MMIO chip.
+//
+// RT args:
+//   [0]  num_members            source tensors (one per KV cache layer/member)
+//   [1]  num_blocks             blocks in this chunk
+//   [2]  dst_dram_base          destination tensor address (identical on every chip: lockstep alloc)
+//   [3]  dst_page_size
+//   [4]  shard_block_bytes      bytes one rank contributes per block
+//   [5]  block_bytes            shard_block_bytes * num_ranks
+//   [6]  tp_rank                this chip's rank within the TP group
+//   [7]  route_word             fabric route to the master (1D hop count / 2D (mesh<<16)|chip)
+//   [8]  master_noc_x           master worker core for the completion counter
+//   [9]  master_noc_y
+//   [10] done_counter_addr      absolute L1 address of the completion counter on the master
+//   [11] l1_scratch_addr        double-buffered staging in this chip's L1
+//   [12] l1_scratch_stride
+//   [13] is_master              1 when this chip is also the master (copy locally, write header)
+//   [14] header_bytes           leading destination bytes the master fills from RT args
+//   [15..] header words         header_bytes/4 words (master only; none otherwise)
+//   [..]   block_ids[num_blocks]
+//   [..]   per member: src_dram_base, src_page_size, region_base
+//   [..]   fabric connection args (non-master only)
+
+#include <cstdint>
+
+#include "api/dataflow/dataflow_api.h"
+#include "tt_metal/fabric/hw/inc/edm_fabric/edm_fabric_worker_adapters.hpp"
+#include "tt_metal/fabric/hw/inc/packet_header_pool.h"
+#include "tt_metal/fabric/fabric_edm_packet_header.hpp"
+#include "ttnn/cpp/ttnn/operations/kvcache_manager/common/kvm_fabric_route.hpp"
+
+namespace {
+
+// Fabric payload ceiling; runs longer than this are split across packets.
+constexpr uint32_t kMaxPayload = 4096;
+// Header ring depth: a header must survive its worker->EDM copy before it is reused.
+constexpr uint32_t kHeaderRingDepth = 4;
+
+FORCE_INLINE uint64_t remote_dram_noc_addr(const InterleavedAddrGen<true>& d, uint32_t page_id, uint32_t offset) {
+    uint64_t noc_address = d.get_noc_addr(page_id, offset, tt::tt_fabric::edm_to_local_chip_noc);
+#if defined(ARCH_WORMHOLE)
+    auto components = get_noc_address_components(noc_address);
+    noc_address = safe_get_noc_addr(
+        components.first.x, components.first.y, components.second, tt::tt_fabric::edm_to_local_chip_noc);
+#endif
+    return noc_address;
+}
+
+}  // namespace
+
+void kernel_main() {
+    size_t arg = 0;
+    const uint32_t num_members = get_arg_val<uint32_t>(arg++);
+    const uint32_t num_blocks = get_arg_val<uint32_t>(arg++);
+    const uint32_t dst_dram_base = get_arg_val<uint32_t>(arg++);
+    const uint32_t dst_page_size = get_arg_val<uint32_t>(arg++);
+    const uint32_t shard_block_bytes = get_arg_val<uint32_t>(arg++);
+    const uint32_t block_bytes = get_arg_val<uint32_t>(arg++);
+    const uint32_t tp_rank = get_arg_val<uint32_t>(arg++);
+    const uint32_t route_word = get_arg_val<uint32_t>(arg++);
+    const uint32_t master_noc_x = get_arg_val<uint32_t>(arg++);
+    const uint32_t master_noc_y = get_arg_val<uint32_t>(arg++);
+    const uint32_t done_counter_addr = get_arg_val<uint32_t>(arg++);
+    const uint32_t l1_scratch_addr = get_arg_val<uint32_t>(arg++);
+    const uint32_t l1_scratch_stride = get_arg_val<uint32_t>(arg++);
+    const uint32_t is_master = get_arg_val<uint32_t>(arg++);
+    const uint32_t header_bytes = get_arg_val<uint32_t>(arg++);
+    const size_t header_arg = arg;
+    arg += header_bytes / sizeof(uint32_t);
+    const size_t block_ids_arg = arg;
+    arg += num_blocks;
+    const size_t members_arg = arg;
+    arg += 3 * num_members;
+
+    const InterleavedAddrGen<true> dst{.bank_base_address = dst_dram_base, .page_size = dst_page_size};
+
+    tt::tt_fabric::WorkerToFabricEdmSender connection;
+    volatile tt_l1_ptr PACKET_HEADER_TYPE* headers[kHeaderRingDepth];
+    uint32_t header_count = 0;
+    const bool use_fabric = is_master == 0;
+    if (use_fabric) {
+        connection = tt::tt_fabric::WorkerToFabricEdmSender::build_from_args<ProgrammableCoreType::TENSIX>(arg);
+        for (uint32_t i = 0; i < kHeaderRingDepth; ++i) {
+            headers[i] = PacketHeaderPool::allocate_header();
+        }
+        connection.open();
+    }
+
+    // The master lays down the value header first: the wire PUT reads the blob out of its DRAM, so
+    // the header must already be there, and poking it from the host would cost more than the whole
+    // gather on a non-MMIO chip.
+    if (is_master != 0 && header_bytes != 0) {
+        volatile tt_l1_ptr uint32_t* words = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(l1_scratch_addr);
+        for (uint32_t w = 0; w < header_bytes / sizeof(uint32_t); ++w) {
+            words[w] = get_arg_val<uint32_t>(header_arg + w);
+        }
+        noc_async_write(l1_scratch_addr, dst.get_noc_addr(0, 0), header_bytes);
+        noc_async_write_barrier();
+    }
+
+    uint32_t scratch_slot = 0;
+    // A local-path write is left in flight while the next piece's read
+    // proceeds in the other staging slot, halving the serialized DRAM round trips. The only
+    // hazard is reusing a slot an in-flight write still sources from, so the barrier moves to
+    // slot reuse (and is usually free by then: the write had a whole piece of latency to land).
+    // Fabric sends manage staging lifetime through their own flow control, unchanged.
+    bool write_inflight[2] = {false, false};
+    for (uint32_t m = 0; m < num_members; ++m) {
+        const uint32_t src_dram_base = get_arg_val<uint32_t>(members_arg + 3 * m);
+        const uint32_t src_page_size = get_arg_val<uint32_t>(members_arg + 3 * m + 1);
+        const uint32_t region_base = get_arg_val<uint32_t>(members_arg + 3 * m + 2);
+        const InterleavedAddrGen<true> src{.bank_base_address = src_dram_base, .page_size = src_page_size};
+
+        for (uint32_t cb = 0; cb < num_blocks; ++cb) {
+            const uint32_t local_block = get_arg_val<uint32_t>(block_ids_arg + cb);
+            uint32_t src_off = local_block * shard_block_bytes;
+            uint32_t dst_off = region_base + cb * block_bytes + tp_rank * shard_block_bytes;
+            uint32_t left = shard_block_bytes;
+
+            while (left > 0) {
+                // Split at whichever comes first: the fabric MTU, the source page boundary, or the
+                // destination page boundary. Interleaved DRAM addressing is per page, so a run that
+                // straddles pages must be issued as separate transfers on both sides.
+                const uint32_t src_page = src_off / src_page_size;
+                const uint32_t src_in_page = src_off - src_page * src_page_size;
+                const uint32_t dst_page = dst_off / dst_page_size;
+                const uint32_t dst_in_page = dst_off - dst_page * dst_page_size;
+                uint32_t n = left;
+                const uint32_t src_room = src_page_size - src_in_page;
+                const uint32_t dst_room = dst_page_size - dst_in_page;
+                if (n > src_room) {
+                    n = src_room;
+                }
+                if (n > dst_room) {
+                    n = dst_room;
+                }
+                // Fabric pieces obey the MTU; local pieces only need to fit the staging slot.
+                // Local pieces run as large as the staging slot allows to reduce per-piece overhead.
+                const uint32_t max_piece = use_fabric ? kMaxPayload : l1_scratch_stride;
+                if (n > max_piece) {
+                    n = max_piece;
+                }
+
+                const uint32_t slot = scratch_slot % 2;
+                const uint32_t staging = l1_scratch_addr + slot * l1_scratch_stride;
+                ++scratch_slot;
+                if (write_inflight[slot]) {
+                    noc_async_write_barrier();
+                    write_inflight[0] = false;
+                    write_inflight[1] = false;
+                }
+                noc_async_read(src.get_noc_addr(src_page, src_in_page), staging, n);
+                noc_async_read_barrier();
+
+                const uint32_t send_bytes = (n + 15u) & ~15u;
+                if (use_fabric) {
+                    volatile tt_l1_ptr PACKET_HEADER_TYPE* hdr = headers[header_count++ % kHeaderRingDepth];
+                    ttnn::operations::kvcache_manager::protocol::set_unicast_route(hdr, route_word);
+                    hdr->to_noc_unicast_write(
+                        tt::tt_fabric::NocUnicastCommandHeader{remote_dram_noc_addr(dst, dst_page, dst_in_page)},
+                        send_bytes);
+                    connection.wait_for_empty_write_slot();
+                    connection.send_payload_without_header_non_blocking_from_address(staging, send_bytes);
+                    connection.send_payload_blocking_from_address(
+                        reinterpret_cast<uint32_t>(hdr), sizeof(PACKET_HEADER_TYPE));
+                } else {
+                    // The master's own shard never leaves the chip. No barrier here: the write
+                    // drains while the next piece's read runs in the other slot.
+                    noc_async_write(staging, dst.get_noc_addr(dst_page, dst_in_page), n);
+                    write_inflight[slot] = true;
+                }
+
+                src_off += n;
+                dst_off += n;
+                left -= n;
+            }
+        }
+    }
+
+    // The pipelined local writes must all have landed before this kernel signals completion (or
+    // exits -- the host takes workload completion as data-visible).
+    if (write_inflight[0] || write_inflight[1]) {
+        noc_async_write_barrier();
+    }
+
+    // One completion event per sender, ordered behind that sender's payload. A program with no
+    // members owns no shard -- that is the master when it sits outside the rank group, here only to
+    // write the header and host the waiter -- so it must not inflate the count.
+    if (num_members == 0) {
+        return;
+    }
+    const uint64_t done_noc = get_noc_addr(master_noc_x, master_noc_y, done_counter_addr);
+    if (use_fabric) {
+        volatile tt_l1_ptr PACKET_HEADER_TYPE* hdr = headers[header_count++ % kHeaderRingDepth];
+        ttnn::operations::kvcache_manager::protocol::set_unicast_route(hdr, route_word);
+        hdr->to_noc_unicast_atomic_inc(tt::tt_fabric::NocUnicastAtomicIncCommandHeader{done_noc, 1, /*flush=*/true});
+        connection.wait_for_empty_write_slot();
+        connection.send_payload_flush_blocking_from_address(
+            reinterpret_cast<uint32_t>(hdr), sizeof(PACKET_HEADER_TYPE));
+        connection.close();
+    } else {
+        noc_semaphore_inc(done_noc, 1);
+        noc_async_atomic_barrier();
+    }
+}
diff --git a/ttnn/cpp/ttnn/operations/kvcache_manager/gather/device/kernels/dataflow/gather_wait_kernel.cpp b/ttnn/cpp/ttnn/operations/kvcache_manager/gather/device/kernels/dataflow/gather_wait_kernel.cpp
