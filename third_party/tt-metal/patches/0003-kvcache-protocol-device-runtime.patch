+bool ClientOperations::exists(const std::string& key) {
+    auto operation_lock = acquire_operation();
+    check_operational();
+    validate_key(key, "exists");
+
+    const uint32_t key_len = static_cast<uint32_t>(key.size());
+
+    std::array<uint32_t, 32> key_words{};
+    for (uint32_t j = 0; j < key_len; ++j) {
+        key_words[j >> 2] |= static_cast<uint32_t>(static_cast<uint8_t>(key[j])) << ((j & 3) * 8);
+    }
+
+    RequestTransaction request{*this, /*ring_slots_consumed=*/1, /*put_count=*/0};
+    const uint32_t seq = request.seq();
+    launch_status_client(kOpKindExists, request.base_ring_slot(), key_len, seq, key_words, /*blocking=*/false, request);
+
+    std::vector<uint8_t> rx_buf;
+    tt::tt_metal::distributed::ReadShard(
+        client_submesh_->mesh_command_queue(), rx_buf, recv_buf_, client_coord_, /*blocking=*/true);
+    TT_FATAL(
+        rx_buf.size() >= sizeof(protocol::PacketHeader) + protocol::kExistsRemoveStatusPayloadBytes,
+        "exists response is truncated: expected at least {} bytes, got {}",
+        sizeof(protocol::PacketHeader) + protocol::kExistsRemoveStatusPayloadBytes,
+        rx_buf.size());
+
+    const auto* rx_hdr = reinterpret_cast<const protocol::PacketHeader*>(rx_buf.data());
+    TT_FATAL(
+        rx_hdr->opcode == static_cast<uint32_t>(protocol::OpCode::EXISTS_RESP),
+        "exists: response opcode mismatch: expected EXISTS_RESP ({}), got {}",
+        static_cast<uint32_t>(protocol::OpCode::EXISTS_RESP),
+        rx_hdr->opcode);
+    TT_FATAL(rx_hdr->seq == seq, "exists: seq mismatch: expected {}, got {}", seq, rx_hdr->seq);
+    TT_FATAL(
+        rx_hdr->payload_size == protocol::kExistsRemoveStatusPayloadBytes,
+        "exists: payload_size mismatch: expected {}, got {}",
+        protocol::kExistsRemoveStatusPayloadBytes,
+        rx_hdr->payload_size);
+
+    uint32_t status_flags = 0;
+    std::memcpy(&status_flags, rx_buf.data() + sizeof(protocol::PacketHeader), sizeof(status_flags));
+    request.complete();
+    return (status_flags & protocol::kStatusFlagFound) != 0;
+}
+
+void ClientOperations::move_to_host(const std::string& key) { move_op(key, kOpKindMoveToHost); }
+
+void ClientOperations::move_to_device(const std::string& key) { move_op(key, kOpKindMoveToDevice); }
+
+// Waits for BRISC lookup and acceptance. Any required host move is complete; device admission is
+// best-effort and remains asynchronous. Missing/already-target keys are acknowledged no-ops. See
+// ttnn/cpp/ttnn/operations/kvcache_manager/docs/design.md §6 MOVE.
+void ClientOperations::move_op(const std::string& key, uint32_t op_kind) {
+    auto operation_lock = acquire_operation();
+    check_operational();
+    validate_key(key, "move");
+
+    const uint32_t key_len = static_cast<uint32_t>(key.size());
+
+    std::array<uint32_t, 32> key_words{};
+    for (uint32_t j = 0; j < key_len; ++j) {
+        key_words[j >> 2] |= static_cast<uint32_t>(static_cast<uint8_t>(key[j])) << ((j & 3) * 8);
+    }
+
+    // A pending entry would acknowledge MOVE as a no-op, so wait for the wire commit frontier first.
+    commit_barrier();
+
+    // The blocking launch covers the server acceptance signal. Explicit device admission remains
+    // asynchronous after that boundary.
+    RequestTransaction request{*this, /*ring_slots_consumed=*/1, /*put_count=*/0};
+    const uint32_t seq = request.seq();
+    launch_status_client(op_kind, request.base_ring_slot(), key_len, seq, key_words, /*blocking=*/true, request);
+    request.complete();
+}
+
+bool ClientOperations::remove(const std::string& key) {
+    auto operation_lock = acquire_operation();
+    check_operational();
+    validate_key(key, "remove");
+
+    commit_barrier();
+
+    const uint32_t key_len = static_cast<uint32_t>(key.size());
+
+    std::array<uint32_t, 32> key_words{};
+    for (uint32_t j = 0; j < key_len; ++j) {
+        key_words[j >> 2] |= static_cast<uint32_t>(static_cast<uint8_t>(key[j])) << ((j & 3) * 8);
+    }
+
+    RequestTransaction request{*this, /*ring_slots_consumed=*/1, /*put_count=*/0};
+    const uint32_t seq = request.seq();
+    launch_status_client(kOpKindRemove, request.base_ring_slot(), key_len, seq, key_words, /*blocking=*/false, request);
+
+    std::vector<uint8_t> rx_buf;
+    tt::tt_metal::distributed::ReadShard(
+        client_submesh_->mesh_command_queue(), rx_buf, recv_buf_, client_coord_, /*blocking=*/true);
+    TT_FATAL(
+        rx_buf.size() >= sizeof(protocol::PacketHeader) + protocol::kExistsRemoveStatusPayloadBytes,
+        "remove response is truncated: expected at least {} bytes, got {}",
+        sizeof(protocol::PacketHeader) + protocol::kExistsRemoveStatusPayloadBytes,
+        rx_buf.size());
+
+    const auto* rx_hdr = reinterpret_cast<const protocol::PacketHeader*>(rx_buf.data());
+    TT_FATAL(
+        rx_hdr->opcode == static_cast<uint32_t>(protocol::OpCode::REMOVE_RESP),
+        "remove: response opcode mismatch: expected REMOVE_RESP ({}), got {}",
+        static_cast<uint32_t>(protocol::OpCode::REMOVE_RESP),
+        rx_hdr->opcode);
+    TT_FATAL(rx_hdr->seq == seq, "remove: seq mismatch: expected {}, got {}", seq, rx_hdr->seq);
+    TT_FATAL(
+        rx_hdr->payload_size == protocol::kExistsRemoveStatusPayloadBytes,
+        "remove: payload_size mismatch: expected {}, got {}",
+        protocol::kExistsRemoveStatusPayloadBytes,
+        rx_hdr->payload_size);
+
+    uint32_t remove_status = 0;
+    std::memcpy(&remove_status, rx_buf.data() + sizeof(protocol::PacketHeader), sizeof(remove_status));
+    const bool removed = (remove_status & protocol::kStatusFlagRemoved) != 0;
+    request.complete();
+    return removed;
+}
+
+uint32_t ClientOperations::test_put_completion_events() const {
+    check_operational();
+
+    IDevice* device = client_submesh_->get_device(client_coord_);
+    TT_FATAL(device != nullptr, "test_put_completion_events: client mesh has no chip at the client coordinate");
+    std::array<uint8_t, protocol::kClientRecvSemSize> sem_buf{};
+    tt::tt_metal::detail::ReadFromDeviceL1(
+        device,
+        kClientCore,
+        client_l1_base_ + protocol::kClientRecvSemOffset,
+        std::span<uint8_t>(sem_buf.data(), sem_buf.size()),
+        tt::CoreType::WORKER,
+        /*barrier_scoped_to_core=*/true);
+
+    uint32_t events = 0;
+    std::memcpy(&events, sem_buf.data(), sizeof(events));
+    return events;
+}
+
+void ClientOperations::close() {
+    auto operation_lock = acquire_operation();
+    if (state_ == ClientOperationsState::Quarantined || state_ == ClientOperationsState::Closed) {
+        return;
+    }
+
+    check_operational();
+    commit_barrier();
+    send_detach();
+    if (state_ == ClientOperationsState::Established) {
+        state_ = ClientOperationsState::Closed;
+    }
+}
+
+// Release the session on the Server so a later Client can take the slot. Without this the Server
+// stays claimed for the rest of its life and a new session needs a whole new Server. A fresh Server
+// is the recovery path when a Client dies; this is the clean path.
+//
+// Best effort by design: close() must not fail because the wire is unhealthy. An uncertain outcome
+// is quarantined until reset so a late DETACH cannot release a replacement session.
+void ClientOperations::send_detach() noexcept {
+    try {
+        if (state_ != ClientOperationsState::Established) {
+            return;
+        }
+        RequestTransaction request{*this, /*ring_slots_consumed=*/1, /*put_count=*/0};
+        const uint32_t seq = request.seq();
+        const std::array<uint32_t, 32> key_words{};
+        launch_status_client(
+            kOpKindDetach, request.base_ring_slot(), /*key_len=*/0, seq, key_words, /*blocking=*/false, request);
+
+        std::vector<uint8_t> rx_buf;
+        tt::tt_metal::distributed::ReadShard(
+            client_submesh_->mesh_command_queue(), rx_buf, recv_buf_, client_coord_, /*blocking=*/true);
+        TT_FATAL(
+            rx_buf.size() >= sizeof(protocol::PacketHeader),
+            "DETACH response too small: expected at least {}, got {}",
+            sizeof(protocol::PacketHeader),
+            rx_buf.size());
+        const auto* rx_hdr = reinterpret_cast<const protocol::PacketHeader*>(rx_buf.data());
+        TT_FATAL(
+            rx_hdr->opcode == static_cast<uint32_t>(protocol::OpCode::DETACH_RESP) && rx_hdr->seq == seq,
+            "DETACH response mismatch: expected opcode {} seq {}, got opcode {} seq {}",
+            static_cast<uint32_t>(protocol::OpCode::DETACH_RESP),
+            seq,
+            rx_hdr->opcode,
+            rx_hdr->seq);
+        request.complete();
+    } catch (const std::exception& e) {
+        quarantine_failed_request();
+        log_warning(tt::LogOp, "kvcache_manager Client: DETACH failed ({}); session quarantined", e.what());
+    }
+}
+
+void ClientOperationsDeleter::operator()(ClientOperations* operations) const noexcept {
+    if (operations == nullptr || operations->state() == ClientOperationsState::Quarantined) {
+        return;
+    }
+    delete operations;
+}
