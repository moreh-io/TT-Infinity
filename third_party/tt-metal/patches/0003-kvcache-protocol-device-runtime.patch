+
+void ClientOperations::quarantine() noexcept {
+    if (state_ == ClientOperationsState::Quarantined || state_ == ClientOperationsState::Closed) {
+        return;
+    }
+    state_ = ClientOperationsState::Quarantined;
+    publish_quarantine();
+}
+
+void ClientOperations::publish_quarantine() noexcept {
+    if (quarantine_published_) {
+        return;
+    }
+    quarantine_published_ = true;
+    auto* head = quarantine_head_.load(std::memory_order_relaxed);
+    do {
+        quarantine_next_ = head;
+    } while (!quarantine_head_.compare_exchange_weak(head, this, std::memory_order_release, std::memory_order_relaxed));
+
+    try {
+        log_warning(tt::LogOp, "kvcache_manager ClientOperations: retained an indeterminate device request tail");
+    } catch (...) {
+        // The object is already published; diagnostics are best effort.
+    }
+}
+
+bool ClientOperations::test_quarantine_holds_mesh(MeshDevice* client_mesh) {
+    for (auto* operations = quarantine_head_.load(std::memory_order_acquire); operations != nullptr;
+         operations = operations->quarantine_next_) {
+        if (operations->client_submesh_owner_.get() == client_mesh && operations->client_l1_buf_ != nullptr &&
+            operations->status_buf_ != nullptr && operations->recv_buf_ != nullptr) {
+            return true;
+        }
+    }
+    return false;
+}
+
+void ClientOperations::reserve_client_l1() {
+    const uint64_t reserve_bytes_wide = protocol::client_l1_reserve_bytes(value_ring_depth_);
+    const uint64_t l1_budget = client_submesh_->allocator()->get_bank_size(BufferType::L1);
+    TT_FATAL(
+        reserve_bytes_wide <= std::numeric_limits<uint32_t>::max(),
+        "kvcache_manager: client L1 reserve {} B exceeds the 32-bit kernel offset limit "
+        "(value_ring_depth={})",
+        reserve_bytes_wide,
+        value_ring_depth_);
+    TT_FATAL(
+        reserve_bytes_wide <= l1_budget,
+        "kvcache_manager: client L1 reserve {} B exceeds available worker L1 {} B "
+        "(value_ring_depth={}). Lower KVM_CLIENT_L1_RING_SLOTS.",
+        reserve_bytes_wide,
+        l1_budget,
+        value_ring_depth_);
+    const uint32_t reserve_bytes = static_cast<uint32_t>(reserve_bytes_wide);
+
+    auto make_shard = [] {
+        return ShardSpecBuffer(
+            CoreRangeSet(CoreRange(kClientCore)),
+            /*shard_shape*/ {1, 1},
+            ShardOrientation::ROW_MAJOR,
+            /*page_shape*/ {1, 1},
+            /*tensor2d_shape_in_pages*/ {1, 1});
+    };
+    auto allocate = [this, &make_shard](uint32_t bytes) {
+        DeviceLocalBufferConfig local{
+            .page_size = bytes,
+            .buffer_type = BufferType::L1,
+            .sharding_args = BufferShardingArgs(make_shard(), TensorMemoryLayout::HEIGHT_SHARDED),
+            .bottom_up = false,
+            .sub_device_id = std::nullopt,
+        };
+        ReplicatedBufferConfig global{.size = bytes};
+        return MeshBuffer::create(global, local, client_submesh_);
+    };
+
+    client_l1_buf_ = allocate(reserve_bytes);
+    client_l1_base_ = static_cast<uint32_t>(client_l1_buf_->address());
+    status_buf_ = allocate(protocol::kClientGetStatusWordSize);
+    status_buf_base_ = static_cast<uint32_t>(status_buf_->address());
+    recv_buf_ = allocate(protocol::kClientRecvBufferSize);
+    recv_buf_base_ = static_cast<uint32_t>(recv_buf_->address());
+
+    TT_FATAL(
+        client_l1_base_ % 32 == 0, "client_l1_base {} must be 32-aligned for DRAM NOC read alignment", client_l1_base_);
+}
+
+std::map<std::string, std::string> ClientOperations::client_kernel_defines(KvcacheKernelTarget target) const {
+    const auto route_mode =
+        static_intermesh_galaxy_to_t3k_ ? KvcacheRouteMode::StaticIntermeshGalaxyToT3k : KvcacheRouteMode::Standard;
+    return kvcache_kernel_defines(ring_slots_, value_ring_depth_, target, profile_detail_, std::nullopt, route_mode);
+}
+
+void ClientOperations::append_server_connection_rt_args(Program& program, std::vector<uint32_t>& rt_args) const {
+    const auto client_node = client_submesh_->get_fabric_node_id(client_coord_);
+    if (static_intermesh_galaxy_to_t3k_) {
+        const auto gateway_node = tt::tt_fabric::get_static_intermesh_endpoint_fabric_node_id();
+        if (client_node == gateway_node) {
+            tt::tt_fabric::append_static_intermesh_lane_connection_rt_args(
+                static_intermesh_lane_, program, kClientCore, rt_args);
+        } else {
+            tt::tt_fabric::append_fabric_connection_rt_args(
+                client_node, gateway_node, fabric_link_idx_, program, kClientCore, rt_args);
+        }
+        return;
+    }
+
+    TT_FATAL(server_node_.has_value(), "ClientOperations session has no Server Fabric node");
+    tt::tt_fabric::append_fabric_connection_rt_args(
+        client_node, *server_node_, fabric_link_idx_, program, kClientCore, rt_args);
+}
+
+void ClientOperations::wait_for_client_chip() {
+    auto& cq = client_submesh_->mesh_command_queue();
+    if (client_submesh_->shape() == MeshShape(1, 1)) {
+        Finish(cq);
+    } else {
+        auto event = cq.enqueue_record_event_to_host({}, MeshCoordinateRange(client_coord_));
+        EventSynchronize(event);
+    }
+}
+
+class ClientOperations::RequestTransaction {
+public:
+    RequestTransaction(
+        ClientOperations& client,
+        uint32_t ring_slots_consumed,
+        uint32_t put_count,
+        std::shared_ptr<MeshBuffer> tensor_buffer = nullptr) :
+        client_(client),
+        previous_seq_(client.next_seq_),
+        previous_ring_slot_(client.next_ring_slot_idx_),
+        ring_slots_consumed_(ring_slots_consumed),
+        put_count_(put_count) {
+        TT_ASSERT(ring_slots_consumed > 0);
+        TT_ASSERT(client.ring_slots_ > 0);
+        TT_ASSERT(client.ring_slots_per_client_ > 0);
+        TT_ASSERT(client.active_tensor_bufs_.empty());
+        TT_ASSERT(client.active_host_write_bufs_.empty());
+        TT_ASSERT(put_count_ == 0 || put_count_ == ring_slots_consumed);
+
+        seq_ = client_.next_seq_;
+        base_ring_slot_ = client_.ring_base_slot_ + client_.next_ring_slot_idx_;
+        client_.next_seq_ += ring_slots_consumed;
+        client_.next_ring_slot_idx_ = static_cast<uint32_t>(
+            (static_cast<uint64_t>(client_.next_ring_slot_idx_) + ring_slots_consumed) %
+            client_.ring_slots_per_client_);
+        if (tensor_buffer != nullptr) {
+            client_.active_tensor_bufs_.push_back(std::move(tensor_buffer));
+        }
+        active_ = true;
+    }
+
+    ~RequestTransaction() { fail(); }
+
+    RequestTransaction(const RequestTransaction&) = delete;
+    RequestTransaction& operator=(const RequestTransaction&) = delete;
+
+    uint32_t seq() const { return seq_; }
+    uint32_t base_ring_slot() const { return base_ring_slot_; }
+    uint32_t seq_at(uint32_t index) const {
+        TT_ASSERT(index < ring_slots_consumed_);
+        return seq_ + index;
+    }
+    uint32_t base_ring_slot_at(uint32_t index) const {
+        TT_ASSERT(index < ring_slots_consumed_);
+        // base_ring_slot_ is absolute (ring_base_slot_ + partition index); batch items wrap within
+        // this client's ring partition, never into a sibling client's slots.
+        const uint32_t relative = base_ring_slot_ - client_.ring_base_slot_;
+        return client_.ring_base_slot_ +
+               static_cast<uint32_t>((static_cast<uint64_t>(relative) + index) % client_.ring_slots_per_client_);
+    }
+
+    void retain_tensor(std::shared_ptr<MeshBuffer> tensor_buffer) {
+        TT_ASSERT(active_);
+        TT_ASSERT(!submission_attempted_);
+        TT_ASSERT(tensor_buffer != nullptr);
+        client_.active_tensor_bufs_.push_back(std::move(tensor_buffer));
+    }
+
+    void retain_host_write(std::shared_ptr<std::vector<uint8_t>> host_buffer) {
+        TT_ASSERT(active_);
+        TT_ASSERT(!submission_attempted_);
+        TT_ASSERT(host_buffer != nullptr);
+        client_.active_host_write_bufs_.push_back(std::move(host_buffer));
+    }
+
+    void mark_submission_attempted() noexcept {
+        TT_ASSERT(active_);
+        submission_attempted_ = true;
+    }
+
+    void complete() noexcept {
+        TT_ASSERT(active_);
+        active_ = false;
+        client_.active_tensor_bufs_.clear();
+        client_.active_host_write_bufs_.clear();
+    }
+
+private:
+    void fail() noexcept {
+        if (!active_) {
+            return;
+        }
+        active_ = false;
+
+        if (submission_attempted_) {
+            client_.quarantine_failed_request();
+            return;
+        }
+
+        client_.next_seq_ = previous_seq_;
+        client_.next_ring_slot_idx_ = previous_ring_slot_;
+        client_.active_tensor_bufs_.clear();
+        client_.active_host_write_bufs_.clear();
+    }
+
+    ClientOperations& client_;
+    uint32_t previous_seq_ = 0;
+    uint32_t previous_ring_slot_ = 0;
+    uint32_t seq_ = 0;
+    uint32_t base_ring_slot_ = 0;
+    uint32_t ring_slots_consumed_ = 0;
+    uint32_t put_count_ = 0;
+    bool submission_attempted_ = false;
+    bool active_ = false;
+};
