+// Shared PUT/GET tensor contract. See
+// ttnn/cpp/ttnn/operations/kvcache_manager/docs/design.md §4 and §6.
+void validate_tensor_layout(const Tensor& tensor, MeshDevice* client_submesh, const char* op) {
+    TT_FATAL(tensor.storage_type() == StorageType::DEVICE, "{}: tensor must use DEVICE storage", op);
+    TT_FATAL(tensor.is_allocated(), "{}: tensor must be allocated on device", op);
+    TT_FATAL(
+        tensor.device() == client_submesh,
+        "{}: tensor must belong to client_submesh; got device {}, expected {}",
+        op,
+        static_cast<const void*>(tensor.device()),
+        static_cast<const void*>(client_submesh));
+
+    const auto memory_config = tensor.memory_config();
+    TT_FATAL(
+        memory_config.buffer_type() == BufferType::DRAM,
+        "{}: tensor must be in DRAM; got buffer_type {}",
+        op,
+        static_cast<int>(memory_config.buffer_type()));
+    TT_FATAL(
+        memory_config.memory_layout() == TensorMemoryLayout::INTERLEAVED,
+        "{}: tensor must be INTERLEAVED DRAM; got memory_layout {}",
+        op,
+        static_cast<int>(memory_config.memory_layout()));
+    TT_FATAL(
+        tensor.logical_shape().rank() <= protocol::kTensorShapeMaxRank,
+        "{}: tensor rank {} exceeds kTensorShapeMaxRank {}",
+        op,
+        tensor.logical_shape().rank(),
+        protocol::kTensorShapeMaxRank);
+    const auto page_size = tensor.tensor_spec().compute_page_size_bytes();
+    TT_FATAL(
+        page_size % 32 == 0,
+        "{}: tensor page_size {} must be a multiple of 32 (DRAM NOC read alignment). "
+        "TILE bf16/fp32/uint8/int32 tiles satisfy this; ROW_MAJOR with non-32-aligned "
+        "page bytes (e.g. odd width) does not — pad the inner dim.",
+        op,
+        page_size);
+}
+
+// Keep-alive MeshBuffer handle over the tensor's device allocation. Upstream removed
+// DeviceStorage::get_mesh_buffer_leak_ownership (#47291) and DeviceStorage now retains
+// sole ownership of its MeshBuffer, so a plain non-owning view (same address, no new
+// allocation) cannot keep the backing alive on its own. Alias the view to a holder that
+// co-owns a Tensor copy: the handle RequestTransaction stores in active_tensor_bufs_
+// keeps the allocation reachable until the transfer outcome is known.
+std::shared_ptr<MeshBuffer> tensor_buffer_keep_alive(const Tensor& tensor) {
+    const auto& backing = tensor.device_storage().get_mesh_buffer();
+    auto view =
+        MeshBuffer::create(backing.global_config(), backing.device_local_config(), backing.device(), backing.address());
+    auto holder = std::make_shared<std::pair<std::shared_ptr<MeshBuffer>, Tensor>>(std::move(view), tensor);
+    return std::shared_ptr<MeshBuffer>(holder, holder->first.get());
+}
