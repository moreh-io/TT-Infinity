+            const uint32_t req_key_len = req[kReqKeyLenWord];
+            const uint32_t req_output_capacity_bytes = req[kReqOutputCapacityWord];
+            const uint32_t req_aux0 = req[kReqAux0Word];
+            const uint32_t req_aux1 = req[kReqAux1Word];
+            const uint32_t req_aux2 = req[kReqAux2Word];
+            const uint32_t req_aux3 = req[kReqAux3Word];
