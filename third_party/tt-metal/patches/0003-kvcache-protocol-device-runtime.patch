+}  // namespace
+
+void kernel_main() {
+    // RT args (host passes a bare list; order must match SetRuntimeArgs in server.cpp).
+    size_t rt_arg_idx = 0;
+    uint32_t termination_addr = get_arg_val<uint32_t>(rt_arg_idx++);  // shared termination word (NCRISC writes)
+    uint32_t dram_directory_base = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t max_keys = get_arg_val<uint32_t>(rt_arg_idx++);  // directory entry count (key retention)
+    uint32_t dir_entry_stride = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t max_key_len = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t scan_staging_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t req_mailbox_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t req_sem_addr = get_arg_val<uint32_t>(rt_arg_idx++);   // lookup req sem: NCRISC inc, BRISC wait
+    uint32_t done_sem_addr = get_arg_val<uint32_t>(rt_arg_idx++);  // lookup done sem: BRISC inc, NCRISC wait
+    uint32_t resp_mailbox_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t epoch_counter_addr = get_arg_val<uint32_t>(rt_arg_idx++);  // BRISC-private last_access epoch
+    uint32_t dram_put_host_queue_base = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t commit_done_addr = get_arg_val<uint32_t>(rt_arg_idx++);  // BRISC inc, host reads
+    uint32_t commit_entry_staging_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    // Host-tiering worker channels. move_req: this RISC posts a host operation (WRITE_THROUGH / DEVICE_PROMOTE /
+    // HOST_SERVE)
+    // + inc's move_req_sem. commit_req: the worker posts a promote commit; this RISC polls
+    // commit_req_sem and commit_entry's it.
+    uint32_t move_req_sem_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t move_req_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t commit_req_sem_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t commit_req_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    // Buddy allocator state and the host worker cumulative completion counter.
+    uint32_t value_heap_bytes = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t heap_allocator_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t move_processed_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    // GET CB reader: value-heap DRAM base. After a GET lookup this BRISC reads the value chunks
+    // from the heap into the GET value CB (kGetValueCbId); the NCRISC consumes + fabric-writes.
+    // On-core CB flow control (cb_push_back/cb_wait_front) replaces the earlier split's manual
+    // NoC-atomic handshake.
+    uint32_t dram_value_base = get_arg_val<uint32_t>(rt_arg_idx++);
+    // NoC-mapped host window for write-through, cache admission, and host serve. When stage_enabled,
+    // this RISC can read host backing into the value heap over the NoC (kvm_pull_promoted_value).
+    // Otherwise the host worker pushes it before publication, so the pull is skipped.
+    // stage_noc_base is the full 64-bit host NoC address of the staging buffer.
+    uint32_t stage_pcie_xy_enc = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t stage_addr_lo = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t stage_addr_hi = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t stage_enabled = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t stage_completion_offset = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t get_host_completion_enabled = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t get_host_completion_offset = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t get_completion_ack_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t pool_meta_read_off = get_arg_val<uint32_t>(rt_arg_idx++);
+    // Mapped host-serve streaming: the worker publishes the cumulative count of staged chunks here;
+    // the fused loop polls it to overlap host copies with device reads.
+    uint32_t stage_progress_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    // Durable promote completion: this RISC increments it after the value write and directory commit
+    // fence. Fallback workers poll it; mapped workers use the host completion cacheline.
+    uint32_t promote_done_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    // Mapped WRITE_THROUGH device-push handshake: worker destination-ready sem + offset, then BRISC done.
+    uint32_t evict_ack_sem_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t evict_ack_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t evict_done_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    // Auxiliary hash index (key_hash -> dir_slot lookup accelerator): DRAM base + bucket count
+    // (power of two) + L1 probe staging (one bucket).
+    uint32_t dram_hashmap_base = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t num_buckets = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t hash_probe_staging = get_arg_val<uint32_t>(rt_arg_idx++);
+    // Buddy allocator metadata: DRAM base plus L1 staging for block/free-list entries.
+    uint32_t dram_heap_metadata_base = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t heap_metadata_staging = get_arg_val<uint32_t>(rt_arg_idx++);
+    // Cold-start handshake: this RISC sets it to 1 at the end of cold-start; the NCRISC waits on it
+    // before serving so no client op races the cold-start (host zero-init'd it before launch).
+    uint32_t cold_start_done_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    // Private regression-test hook: defer the first ready PUT commit without blocking lookup service.
+    // Production passes zero.
+    uint32_t test_first_put_commit_delay_cycles = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t initial_counter = get_arg_val<uint32_t>(rt_arg_idx++);
+    // Word 1 of the direct completion cacheline: large PUT group progress, independent of landed word 0.
+    uint32_t direct_put_progress_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t allocator_profile_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    uint32_t residency_lru_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    const bool get_admission_worker_enabled = get_arg_val<uint32_t>(rt_arg_idx++) != 0;
+    const uint32_t get_admission_noc_x = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t get_admission_noc_y = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t get_admission_ready_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t get_admission_descriptor_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t get_value_cb_base = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint32_t get_admission_progress_addr = get_arg_val<uint32_t>(rt_arg_idx++);
+    const uint64_t stage_noc_base = (static_cast<uint64_t>(stage_addr_hi) << 32) | static_cast<uint64_t>(stage_addr_lo);
+    ASSERT(get_host_completion_enabled == 0 || stage_enabled != 0);
+
+    volatile tt_l1_ptr uint32_t* termination_ptr = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(termination_addr);
+    volatile tt_l1_ptr uint32_t* req_sem = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(req_sem_addr);
+    volatile tt_l1_ptr uint32_t* req = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(req_mailbox_addr);
+    volatile tt_l1_ptr uint8_t* req_key =
+        reinterpret_cast<volatile tt_l1_ptr uint8_t*>(req_mailbox_addr + kReqKeyByteOffset);
+    volatile tt_l1_ptr uint32_t* directory_state = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(epoch_counter_addr);
+    volatile tt_l1_ptr uint32_t* epoch = directory_state + kDirEpochCounterWord;
+    volatile tt_l1_ptr uint32_t* allocator = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(heap_allocator_addr);
+    volatile tt_l1_ptr uint32_t* direct_put_progress =
+        reinterpret_cast<volatile tt_l1_ptr uint32_t*>(direct_put_progress_addr);
+    volatile tt_l1_ptr uint32_t* allocator_profile =
+        reinterpret_cast<volatile tt_l1_ptr uint32_t*>(allocator_profile_addr);
+    volatile tt_l1_ptr uint32_t* residency_lru = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(residency_lru_addr);
