index 0000000000000000000000000000000000000000..ff6ddd597df78de40d9a9df9b3684023b5d5bf9f
--- /dev/null
+++ b/ttnn/cpp/ttnn/operations/kvcache_manager/common/server_descriptor.hpp
@@ -0,0 +1,58 @@
+// SPDX-FileCopyrightText: (c) 2026 Moreh
+//
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include <cstdint>
+
+namespace ttnn::operations::kvcache_manager {
+
+// Server-owned wire configuration returned by the Fabric ESTABLISH handshake. It is never passed
+// out of band.
+struct ServerDescriptor {
+    // Identity / topology: the server chip as a fabric node. Every routing derivative (route
+    // word, link index, distinct-chip and peer-table checks) is computed client-side from these.
+    uint32_t fabric_mesh_id = 0;
+    uint32_t fabric_chip_id = 0;
+
+    // Server-chip addresses. The bootstrap ABI requires the canonical translated Wormhole worker
+    // coordinate for the selected logical worker; both roles validate that mapping before ESTABLISH.
+    uint32_t l1_base = 0;
+    uint32_t noc_x = 0;
+    uint32_t noc_y = 0;
+
+    // Wire configuration. The Server is the single authority (it resolved these once from env);
+    // the Client copies them so both kernels build against one wire configuration.
+    uint32_t ring_slots = 0;
+    uint32_t value_ring_depth = 0;
+    // uint32 on purpose: both endpoints store it as uint32 (config clamps to kMaxValueCap), and a
+    // wider wire field would let a foreign binary ship a value this side would silently truncate.
+    uint32_t max_value_bytes = 0;
+    uint32_t max_key_bytes = 0;
+    // protocol::kMaxClients of the SERVER binary. Locally always equal to ours; across processes
+    // the two binaries can differ, and a partition-count mismatch would silently interleave ring
+    // slices -- so the Client cross-checks it while establishing the session.
+    uint32_t max_clients = 0;
+    // Reserved for a future bootstrap-compatible descriptor extension. Must be zero.
+    uint32_t reserved = 0;
+
+    // DRAM bank layout proof: fabric-direct PUT/GET have the server address the client's DRAM
+    // (and vice versa) with its OWN bank map, so both sides must match. Locally this was checked
+    // by comparing the two IDevice handles; remotely the server ships its layout instead.
+    uint32_t num_dram_channels = 0;
+    uint32_t dram_grid_x = 0;
+    uint32_t dram_grid_y = 0;
+
+    // protocol::kWireLayoutVersion of the SERVER binary; the Client refuses a mismatch instead of
+    // exchanging packets whose L1 layouts disagree.
+    uint32_t wire_layout_version = 0;
+};
+
+static_assert(sizeof(ServerDescriptor) == 15 * sizeof(uint32_t));
+
+// Validates the host/kernel ABI fields and all sizes before either the connection layer or the
+// opaque operation backend derives ring partitions, L1 offsets, or fixed-size key storage.
+void validate_server_descriptor(const ServerDescriptor& descriptor);
+
+}  // namespace ttnn::operations::kvcache_manager
diff --git a/ttnn/cpp/ttnn/operations/kvcache_manager/docs/design.md b/ttnn/cpp/ttnn/operations/kvcache_manager/docs/design.md
