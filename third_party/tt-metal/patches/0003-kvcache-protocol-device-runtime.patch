+std::vector<uint8_t> ClientOperations::ping(std::span<const uint8_t> payload) {
+    auto operation_lock = acquire_operation();
+    check_operational();
+    TT_FATAL(
+        payload.size() <= protocol::kMaxPingPayloadBytes,
+        "ping payload size {} exceeds kMaxPingPayloadBytes {}",
+        payload.size(),
+        protocol::kMaxPingPayloadBytes);
+
+    const uint32_t payload_size = static_cast<uint32_t>(payload.size());
+
+    PingPayloadWords payload_words{};
+    for (uint32_t j = 0; j < payload_size; ++j) {
+        payload_words[j >> 2] |= static_cast<uint32_t>(payload[j]) << ((j & 3) * 8);
+    }
+
+    std::vector<uint8_t> echoed(payload_size);
+    RequestTransaction request{*this, /*ring_slots_consumed=*/1, /*put_count=*/0};
+    const uint32_t seq = request.seq();
+    launch_ping_client(request.base_ring_slot(), payload_size, seq, payload_words, request);
+
+    // The blocking command-queue read is this request's synchronization point.
+    std::vector<uint8_t> rx_buf;
+    tt::tt_metal::distributed::ReadShard(
+        client_submesh_->mesh_command_queue(), rx_buf, recv_buf_, client_coord_, /*blocking=*/true);
+    TT_FATAL(
+        rx_buf.size() >= sizeof(protocol::PacketHeader) + payload_size,
+        "ping response is truncated: expected at least {} bytes, got {}",
+        sizeof(protocol::PacketHeader) + payload_size,
+        rx_buf.size());
+    const auto* rx_hdr = reinterpret_cast<const protocol::PacketHeader*>(rx_buf.data());
+    TT_FATAL(
+        rx_hdr->opcode == static_cast<uint32_t>(protocol::OpCode::ECHO),
+        "echoed opcode mismatch: expected ECHO ({}), got {}",
+        static_cast<uint32_t>(protocol::OpCode::ECHO),
+        rx_hdr->opcode);
+    TT_FATAL(rx_hdr->seq == seq, "echoed seq mismatch: expected {}, got {}", seq, rx_hdr->seq);
+    TT_FATAL(
+        rx_hdr->payload_size == payload_size,
+        "echoed payload_size mismatch: expected {}, got {}",
+        payload_size,
+        rx_hdr->payload_size);
+
+    if (payload_size > 0) {
+        std::memcpy(echoed.data(), rx_buf.data() + sizeof(protocol::PacketHeader), payload_size);
+    }
+    request.complete();
+    return echoed;
+}
