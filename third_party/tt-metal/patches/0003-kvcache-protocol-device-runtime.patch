+void ClientOperations::launch_get_client(
+    uint32_t base_ring_slot_idx,
+    uint32_t num_chunks,
+    uint32_t key_len,
+    uint32_t output_capacity_bytes,
+    uint32_t client_dram_addr,
+    uint32_t logical_page_size,
+    const GetChunk0Args& chunk0,
+    RequestTransaction& request) {
+    // chunk 0 request payload_size = GetChunkReqHeader + key bytes.
+    const uint32_t chunk0_payload = sizeof(protocol::GetChunkReqHeader) + key_len;
+
+    const auto t_build0 = std::chrono::steady_clock::now();
+    if (get_prog_.workload == nullptr) {
+        // First GET: build the resident single-kernel program once — the fabric receiver on RISCV_1.
+        // Fabric-direct-to-DRAM: the server writes value chunks straight into the client output DRAM,
+        // so there is no client writeback kernel. tt-metal caches compile / dispatch-command assembly /
+        // kernel-binary write at the workload level, so later GETs pay only the RTA override + CQ write.
+        // The fabric connection is resolved once here and its RT-arg words are then immutable.
+        IDevice* client_device = client_submesh_->get_device(client_coord_);
+
+        // The Server computes Client DRAM addresses with its own bank map, so both maps must match.
+        TT_FATAL(
+            static_cast<uint32_t>(client_device->num_dram_channels()) == server_num_dram_channels_ &&
+                client_device->dram_grid_size() == CoreCoord(server_dram_grid_x_, server_dram_grid_y_),
+            "fabric-direct GET requires identical client/server DRAM bank layout (client num_dram_channels={}, "
+            "server={}); the server addresses the client DRAM with its own bank map.",
+            client_device->num_dram_channels(),
+            server_num_dram_channels_);
+
+        ClientRtArgs args{
+            .op_kind = kOpKindGet,
+            .client_l1_base = client_l1_base_,
+            .server_l1_base = server_l1_base_,
+            .server_noc_x = server_noc_x_,
+            .server_noc_y = server_noc_y_,
+            .base_ring_slot_idx = base_ring_slot_idx,
+            .payload_size = chunk0_payload,
+            .route_word_to_server = route_word_to_server_,
+            .num_chunks = num_chunks,
+            .total_value_len = output_capacity_bytes,
+            .client_dram_addr = client_dram_addr,
+            .logical_page_size = logical_page_size,
+        };
+
+        Program program = CreateProgram();
+        CoreRange core_range(kClientCore, kClientCore);
+
+        // RISCV_1 sends the request and records the Server's completion status.
+        KernelHandle receiver_id = CreateKernel(
+            program,
+            kGetReceiverKernelPath,
+            core_range,
+            DataMovementConfig{
+                .processor = DataMovementProcessor::RISCV_1,
+                .noc = NOC::RISCV_1_default,
+                .defines = client_kernel_defines(KvcacheKernelTarget::ClientGet)});
+
+        std::vector<uint32_t> rt_args = to_vec(args, client_token_);
+        // GET chunk-0 request construct extras, appended after the base RT args and before the
+        // fabric connection args (fabric args must stay last).
+        rt_args.push_back(chunk0.stream_id_seq);
+        rt_args.push_back(chunk0.key_len);
+        for (uint32_t w = 0; w < 32; ++w) {
+            rt_args.push_back(chunk0.key_words[w]);
+        }
+        // The status destination and mapped-host completion capability are fixed for the Client
+        // session, so neither needs a resident-program override.
+        rt_args.push_back(status_buf_base_);
+        TT_ASSERT(rt_args.size() == kRtaGetMappedCompletionEnabled);
+        rt_args.push_back(0u);
+        append_server_connection_rt_args(program, rt_args);
+        SetRuntimeArgs(program, receiver_id, kClientCore, rt_args);
+
+        get_prog_.workload = std::make_unique<MeshWorkload>();
+        get_prog_.workload->add_program(chip_range_, std::move(program));
+        get_prog_.kernel_id = receiver_id;
+    } else {
+        // Override only the per-request fields of the resident workload.
+        Program& program = get_prog_.workload->get_programs().at(chip_range_);
+        RuntimeArgsData& rta = GetRuntimeArgs(program, get_prog_.kernel_id, kClientCore);
+        rta[kRtaBaseRingSlot] = base_ring_slot_idx;
+        rta[kRtaPayloadSize] = chunk0_payload;
+        rta[kRtaNumChunks] = num_chunks;
+        rta[kRtaTotalValueLen] = output_capacity_bytes;
+        rta[kRtaClientDramAddr] = client_dram_addr;
+        rta[kRtaLogicalPageSize] = logical_page_size;
+        rta[kRtaGetStreamSeq] = chunk0.stream_id_seq;
+        rta[kRtaGetKeyLen] = chunk0.key_len;
+        for (uint32_t w = 0; w < 32; ++w) {
+            rta[kRtaGetKeyWords + w] = chunk0.key_words[w];
+        }
+    }
+    if (!get_prog_.compiled) {
+        Program& program = get_prog_.workload->get_programs().at(chip_range_);
+        tt::tt_metal::detail::CompileProgram(client_submesh_, program);
+        get_prog_.compiled = true;
+    }
+
+    const auto t_build1 = std::chrono::steady_clock::now();
+
+    const auto t_enq0 = std::chrono::steady_clock::now();
+    // Non-blocking enqueue with no generic CQ Finish. The mapped path publishes a host completion;
+    // the fallback enqueues a blocking status ReadShard behind this workload on the same CQ.
+    enqueue_request(*get_prog_.workload, /*blocking=*/false, request);
+    const auto t_enq1 = std::chrono::steady_clock::now();
+
+    if (kvcache_profile_) {
+        const uint64_t build_ns = std::chrono::duration_cast<std::chrono::nanoseconds>(t_build1 - t_build0).count();
+        const uint64_t enqueue_ns = std::chrono::duration_cast<std::chrono::nanoseconds>(t_enq1 - t_enq0).count();
+        log_info(
+            tt::LogOp,
+            "KVCACHE_HOST[get_launch] num_chunks={} build_ns={} enqueue_ns={} (completion observed by get())",
+            num_chunks,
+            build_ns,
+            enqueue_ns);
+    }
+}
+
+void ClientOperations::launch_status_client(
+    uint32_t op_kind,
+    uint32_t base_ring_slot_idx,
+    uint32_t key_len,
+    uint32_t seq,
+    const std::array<uint32_t, 32>& key_words,
+    bool blocking,
+    RequestTransaction& request) {
+    if (status_prog_.workload == nullptr) {
+        // One resident program serves every status opcode through the shared argument layout.
+        ClientRtArgs args{
+            .op_kind = op_kind,
+            .client_l1_base = client_l1_base_,
+            .server_l1_base = server_l1_base_,
+            .server_noc_x = server_noc_x_,
+            .server_noc_y = server_noc_y_,
+            .base_ring_slot_idx = base_ring_slot_idx,
+            .payload_size = key_len,  // PacketHeader + key_len; trailing bytes = key
+            .route_word_to_server = route_word_to_server_,
+            .num_chunks = 0,
+            .total_value_len = 0,
+            .client_dram_addr = 0,
+        };
+
+        Program program = CreateProgram();
+        CoreRange core_range(kClientCore, kClientCore);
+        KernelHandle kernel_id = CreateKernel(
+            program,
+            kStatusKernelPath,
+            core_range,
+            DataMovementConfig{
+                .processor = DataMovementProcessor::RISCV_1,
+                .noc = NOC::RISCV_1_default,
+                .defines = client_kernel_defines(KvcacheKernelTarget::ClientMove)});
+
+        std::vector<uint32_t> rt_args = to_vec(args, client_token_);
+        // Status operations build the request packet in-kernel from these extras (seq + key_words),
+        // consumed before the Fabric args. Keyless operations keep the same fixed RT-arg shape so
+        // the resident program can be updated in place.
+        rt_args.push_back(seq);
+        for (uint32_t w = 0; w < 32; ++w) {
+            rt_args.push_back(key_words[w]);
+        }
+        append_server_connection_rt_args(program, rt_args);
+        SetRuntimeArgs(program, kernel_id, kClientCore, rt_args);
+
+        status_prog_.workload = std::make_unique<MeshWorkload>();
+        status_prog_.workload->add_program(chip_range_, std::move(program));
+        status_prog_.kernel_id = kernel_id;
+    } else {
+        Program& program = status_prog_.workload->get_programs().at(chip_range_);
+        RuntimeArgsData& rta = GetRuntimeArgs(program, status_prog_.kernel_id, kClientCore);
+        rta[kRtaOpKind] = op_kind;
+        rta[kRtaBaseRingSlot] = base_ring_slot_idx;
+        rta[kRtaPayloadSize] = key_len;
+        rta[kRtaStatusSeq] = seq;
+        for (uint32_t w = 0; w < 32; ++w) {
+            rta[kRtaStatusKeyWords + w] = key_words[w];
+        }
+    }
+    if (!status_prog_.compiled) {
+        Program& program = status_prog_.workload->get_programs().at(chip_range_);
+        tt::tt_metal::detail::CompileProgram(client_submesh_, program);
+        status_prog_.compiled = true;
+    }
+
+    enqueue_request(*status_prog_.workload, blocking, request);
+}
