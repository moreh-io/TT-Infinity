@@ -0,0 +1,438 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Physical cache descriptors owned by one TT worker."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+from enum import Enum
+from math import prod
+from typing import TYPE_CHECKING, Callable, Mapping, Sequence
+
+from .validation import is_ttnn_enum, positive, require_enum, validate_ttnn_memory_config
+
+if TYPE_CHECKING:
+    import ttnn
+
+
+class CacheAddressSpace(Enum):
+    PAGED_BLOCK = "paged_block"
+
+
+class MeshParallelRole(Enum):
+    TENSOR_PARALLEL = "tp"
+
+
+class TensorDistributionKind(Enum):
+    REPLICATED = "replicated"
+    SHARDED = "sharded"
+
+
+@dataclass(frozen=True, slots=True)
+class TensorDistribution:
+    """Cross-chip placement of one physical cache member."""
+
+    kind: TensorDistributionKind
+    mesh_role: MeshParallelRole | None = None
+    tensor_axis: int | None = None
+
+    def __post_init__(self) -> None:
+        require_enum("kind", self.kind, TensorDistributionKind)
+        if self.kind is TensorDistributionKind.REPLICATED:
+            if self.mesh_role is not None or self.tensor_axis is not None:
+                raise ValueError("replicated tensor distribution cannot name partition axes")
+        else:
+            require_enum("mesh_role", self.mesh_role, MeshParallelRole)
+            if self.mesh_role is not MeshParallelRole.TENSOR_PARALLEL:
+                raise ValueError(f"unsupported cache-member mesh role {self.mesh_role!r}")
+            if self.tensor_axis is None or self.tensor_axis < 0:
+                raise ValueError("sharded tensor distribution requires a non-negative tensor axis")
+
+
+@dataclass(frozen=True, slots=True)
+class WorkerMeshTopology:
+    """Physical mesh roles used by one cache-owning worker.
+
+    Model cache specs declare logical ``TensorDistribution`` values. The
+    worker separately binds the logical tensor/data roles to concrete axes
+    from the runtime mesh topology; this is not inferred from TTNN
+    ``MemoryConfig``, which describes placement within each device.
+
+    Current context-parallel cache storage spans the full mesh and therefore
+    cannot be combined with an active DP or TP mesh role. DP, TP, and CP remain
+    separate fields so unsupported DP x CP combinations fail explicitly rather
+    than being silently collapsed into one axis.
+    """
+
+    mesh_shape: tuple[int, int]
+    tensor_parallel_mesh_axis: int | None
+    data_parallel_mesh_axis: int | None
+    context_parallel_size: int = 1
+
+    def __post_init__(self) -> None:
+        if len(self.mesh_shape) != 2 or any(size <= 0 for size in self.mesh_shape):
+            raise ValueError("mesh_shape must contain two positive dimensions")
+        positive("context_parallel_size", self.context_parallel_size)
+        if self.context_parallel_size > 1:
+            if self.tensor_parallel_mesh_axis is not None or self.data_parallel_mesh_axis is not None:
+                raise ValueError("full-mesh context parallelism cannot also declare DP or TP mesh axes")
+            if self.context_parallel_size != prod(self.mesh_shape):
+                raise ValueError("full-mesh context parallel size must equal the worker mesh size")
+        elif {self.tensor_parallel_mesh_axis, self.data_parallel_mesh_axis} != {0, 1}:
+            raise ValueError("tensor and data parallel mesh axes must be distinct axes 0 and 1")
+
+    @property
+    def tensor_parallel_size(self) -> int:
+        return 1 if self.tensor_parallel_mesh_axis is None else self.mesh_shape[self.tensor_parallel_mesh_axis]
+
+    @property
+    def data_parallel_size(self) -> int:
+        return 1 if self.data_parallel_mesh_axis is None else self.mesh_shape[self.data_parallel_mesh_axis]
+
+
+@dataclass(frozen=True, slots=True)
+class MemberSpec:
+    """One ordered physical cache member from the model-owned cache spec.
+
+    ``memory_config`` is the per-device TTNN layout/buffer configuration;
+    ``tensor_distribution`` independently describes cross-device placement.
+    """
+
+    member_id: str
+    cache_owner_key: str
+    handle_index: int
+    shape_per_block: tuple[int, ...]
+    dtype: ttnn.DataType
+    layout: ttnn.Layout
+    memory_config: ttnn.MemoryConfig
+    bytes_per_block: int
+    tensor_distribution: TensorDistribution
+
+    def __post_init__(self) -> None:
+        if not self.member_id or not self.cache_owner_key:
+            raise ValueError("member_id and cache_owner_key must be non-empty")
+        if self.handle_index < 0 or not self.shape_per_block or any(dim <= 0 for dim in self.shape_per_block):
+            raise ValueError(f"invalid member geometry for {self.member_id!r}")
+        if self.shape_per_block[0] != 1:
+            raise ValueError(f"one-block member shape must start with axis size 1 for {self.member_id!r}")
+        if not is_ttnn_enum(self.dtype, "DataType"):
+            raise TypeError(f"dtype must be ttnn.DataType, got {type(self.dtype).__name__}")
+        if not is_ttnn_enum(self.layout, "Layout"):
+            raise TypeError(f"layout must be ttnn.Layout, got {type(self.layout).__name__}")
+        validate_ttnn_memory_config(self.memory_config)
+        positive("bytes_per_block", self.bytes_per_block)
+        if not isinstance(self.tensor_distribution, TensorDistribution):
+            raise TypeError("tensor_distribution must be TensorDistribution")
+        tensor_axis = self.tensor_distribution.tensor_axis
+        # Axis 0 is the fixed size-1 block axis, so it can never carry a shard.
+        if tensor_axis is not None and not 0 < tensor_axis < len(self.shape_per_block):
+            raise ValueError(
+                f"{self.member_id!r}: tensor partition axis {tensor_axis} must index a non-block axis of "
+                f"one-block shape {self.shape_per_block}"
+            )
+
+
+@dataclass(frozen=True, slots=True)
+class CacheGroupSpec:
+    """One model-owned cache group represented by a single LMCache ``MemoryObj``.
+
+    Block size and address space are properties of the worker's paged address
+    space, not of a layer, so they live on ``CacheDescriptor``.
+    """
+
+    group_id: str
+    layer_id: int
+    members: tuple[MemberSpec, ...]
+
+    def __post_init__(self) -> None:
+        if not self.group_id or self.layer_id < 0 or not self.members:
+            raise ValueError(f"invalid cache group {self.group_id!r}")
+        member_ids = tuple(member.member_id for member in self.members)
+        if len(member_ids) != len(set(member_ids)):
+            raise ValueError(f"{self.group_id}: duplicate member IDs")
+
+    @property
+    def cache_owner_keys(self) -> tuple[str, ...]:
+        return tuple(dict.fromkeys(member.cache_owner_key for member in self.members))
+
+
+@dataclass(frozen=True, slots=True)
+class CacheDescriptor:
+    """Concrete physical cache layout owned by one worker.
+
+    ``worker_id`` is a stable role/stage identity, ``global_worker_rank`` is
+    the worker process rank, and ``pipeline_stage_rank`` is the logical stage
+    used by scheduler handshakes.
+
+    The last two differ by design. Galaxy layouts map stages onto hosts through
+    explicit submesh offsets, so MPI rank 0 is not necessarily stage 0.
+    ``global_worker_rank`` is diagnostic only; every correctness decision reads
+    ``pipeline_stage_rank``.
+    """
+
+    worker_id: str
+    engine_id: str
+    global_worker_rank: int
+    pipeline_stage_rank: int
+    devices: tuple[int, ...]
+    mesh_topology: WorkerMeshTopology
+    num_blocks: int
+    block_size: int
+    cache_groups: tuple[CacheGroupSpec, ...]
+    address_space: CacheAddressSpace = CacheAddressSpace.PAGED_BLOCK
+    context_block_interleave: int = 1
+
+    def __post_init__(self) -> None:
+        if not self.worker_id or not self.engine_id or self.global_worker_rank < 0 or self.pipeline_stage_rank < 0:
+            raise ValueError("invalid cache descriptor identity")
+        if (
+            not self.devices
+            or len(self.devices) != len(set(self.devices))
+            or any(device < 0 for device in self.devices)
+        ):
+            raise ValueError("devices must be unique non-negative indices")
+        if not isinstance(self.mesh_topology, WorkerMeshTopology):
+            raise TypeError("mesh_topology must be WorkerMeshTopology")
+        if prod(self.mesh_topology.mesh_shape) != len(self.devices):
+            raise ValueError("parallel mesh shape must cover exactly the worker devices")
+        positive("num_blocks", self.num_blocks)
+        positive("block_size", self.block_size)
+        positive("context_block_interleave", self.context_block_interleave)
+        require_enum("address_space", self.address_space, CacheAddressSpace)
+        if self.address_space is not CacheAddressSpace.PAGED_BLOCK:
+            raise ValueError(f"unsupported cache address space {self.address_space!r}")
+        ids = tuple(group.group_id for group in self.cache_groups)
+        if not ids or len(ids) != len(set(ids)):
+            raise ValueError("cache group IDs must be non-empty and unique")
+        if self.block_size % self.context_block_interleave:
+            raise ValueError("context_block_interleave must divide the cache block")
+        if self.context_parallel_size == 1 and self.context_block_interleave != 1:
+            raise ValueError("context_block_interleave must be 1 when context parallelism is disabled")
+
+    @property
+    def tensor_parallel_size(self) -> int:
+        return self.mesh_topology.tensor_parallel_size
+
+    @property
+    def data_parallel_size(self) -> int:
+        return self.mesh_topology.data_parallel_size
+
+    @property
+    def context_parallel_size(self) -> int:
+        return self.mesh_topology.context_parallel_size
+
+
+_LAYER_ID = re.compile(r"(?:^|\.)layers\.(\d+)(?:\.|$)")
+
+
+def _layer_id(spec: object, cache_owner_key: str) -> int:
+    """Resolve the global layer this cache owner belongs to.
+
+    A model that declares ``transfer_layer_id`` states it outright. Otherwise
+    the owner key is parsed, which relies on every model naming its attention
+    layers ``...layers.<N>...``. Every model in the tree does today, but nothing
+    enforces it: a different naming fails loudly at bind time, while an
+    unrelated ``layers.<N>`` earlier in the key would silently bucket members
+    under the wrong layer. Declaring the field removes both risks.
+    """
+
+    declared = getattr(spec, "transfer_layer_id", None)
+    if declared is not None:
+        layer_id = int(declared)
+        if layer_id < 0:
+            raise ValueError(f"{cache_owner_key}: declared transfer_layer_id must be non-negative, got {layer_id}")
+        return layer_id
+
+    match = _LAYER_ID.search(cache_owner_key)
+    if match is None:
+        raise ValueError(
+            f"cache owner has no global layer ID: {cache_owner_key!r}. "
+            "Declare transfer_layer_id on the cache spec if the owner key does not name its layer."
+        )
+    return int(match.group(1))
+
+
+@dataclass(frozen=True, slots=True)
+class _IndexedMember:
+    order: int
+    member: MemberSpec
+
+
+@dataclass(frozen=True, slots=True)
+class _OwnerContribution:
+    layer_id: int
+    cache_owner_key: str
+    block_size: int
+    indexed_members: tuple[_IndexedMember, ...]
+
+
+@dataclass(frozen=True, slots=True)
+class CacheLayout:
+    """Everything the model-owned specs determine about this worker's cache."""
+
+    block_size: int
+    groups: tuple[CacheGroupSpec, ...]
+
+
+def describe_cache_groups(specs_by_owner: Mapping[str, object]) -> CacheLayout:
+    """Materialize model-owned TT allocation specs as pure cache descriptors.
+
+    Returns the block size alongside the groups because it is one value for the
+    whole worker -- vLLM derives it from ``cache_config.block_size`` -- and the
+    descriptor needs it. Reading it back off a group would reintroduce the
+    fiction that layers can disagree.
+    """
+
+    grouped: dict[str, list[_OwnerContribution]] = {}
+    for cache_owner_key, spec in specs_by_owner.items():
+        if not cache_owner_key or not callable(getattr(spec, "get_cache_tensor_specs", None)):
+            raise ValueError(f"invalid model cache owner {cache_owner_key!r}")
+        block_size = int(getattr(spec, "block_size", 0))
+        tensor_specs = tuple(spec.get_cache_tensor_specs(1))  # type: ignore[attr-defined]
+        member_ids = tuple(getattr(spec, "transfer_member_ids", ()))
+        tensor_partition_axes = tuple(getattr(spec, "transfer_tensor_partition_axes", ()))
+        group_member_start_index = int(getattr(spec, "group_member_start_index", 0))
+        group_id = str(getattr(spec, "transfer_group_id", None) or cache_owner_key)
+        if not tensor_specs or len(member_ids) != len(tensor_specs):
+            raise ValueError(f"{cache_owner_key}: transfer members must match physical tensors")
+        if len(tensor_partition_axes) != len(tensor_specs):
+            raise ValueError(f"{cache_owner_key}: transfer tensor partition axes must match physical tensors")
+
+        indexed_members = []
+        for handle_index, (tensor, tensor_partition_axis) in enumerate(
+            zip(tensor_specs, tensor_partition_axes, strict=True)
+        ):
+            shape = tuple(int(dim) for dim in tensor.shape)
+            if not shape or shape[0] != 1:
+                raise ValueError(f"{cache_owner_key}: one-block tensor spec must start with axis size 1")
+            axis = None if tensor_partition_axis is None else int(tensor_partition_axis)
+            distribution = TensorDistribution(
+                kind=(TensorDistributionKind.REPLICATED if axis is None else TensorDistributionKind.SHARDED),
+                mesh_role=None if axis is None else MeshParallelRole.TENSOR_PARALLEL,
+                tensor_axis=axis,
+            )
+            indexed_members.append(
+                _IndexedMember(
+                    order=group_member_start_index + handle_index,
+                    member=MemberSpec(
+                        member_id=str(member_ids[handle_index]),
+                        cache_owner_key=cache_owner_key,
+                        handle_index=handle_index,
+                        shape_per_block=shape,
+                        dtype=tensor.dtype,
+                        layout=tensor.layout,
+                        memory_config=getattr(tensor, "memory_config", None),
+                        bytes_per_block=int(tensor.nbytes),
+                        tensor_distribution=distribution,
+                    ),
+                )
+            )
+        grouped.setdefault(group_id, []).append(
+            _OwnerContribution(
+                layer_id=_layer_id(spec, cache_owner_key),
+                cache_owner_key=cache_owner_key,
+                block_size=block_size,
+                indexed_members=tuple(indexed_members),
+            )
+        )
+
+    groups = []
+    worker_block_sizes: set[int] = set()
+    for group_id, contributions in grouped.items():
+        contributions.sort(key=lambda contribution: min(item.order for item in contribution.indexed_members))
+        layer_ids = {contribution.layer_id for contribution in contributions}
+        block_sizes = {contribution.block_size for contribution in contributions}
+        if len(layer_ids) != 1 or len(block_sizes) != 1:
+            raise ValueError(f"{group_id}: cache owners disagree on layer or block size")
+        ordered = sorted(
+            (item for contribution in contributions for item in contribution.indexed_members),
+            key=lambda item: item.order,
+        )
+        if tuple(item.order for item in ordered) != tuple(range(len(ordered))):
+            raise ValueError(f"{group_id}: group member indexes must be contiguous from zero")
+        worker_block_sizes.add(next(iter(block_sizes)))
+        groups.append(
+            CacheGroupSpec(
+                group_id=group_id,
+                layer_id=next(iter(layer_ids)),
+                members=tuple(item.member for item in ordered),
+            )
+        )
+    if len(worker_block_sizes) != 1:
+        raise ValueError(f"cache owners disagree on block size across groups: {sorted(worker_block_sizes)}")
+    return CacheLayout(
+        block_size=worker_block_sizes.pop(),
+        groups=tuple(sorted(groups, key=lambda group: (group.layer_id, group.group_id))),
+    )
+
+
+HandleInspector = Callable[[object], tuple[tuple[int, ...], object, object, object, tuple[int, ...]]]
+
+
+def validate_handles(
+    descriptor: CacheDescriptor,
+    handles_by_owner: Mapping[str, Sequence[object]],
+    inspect: HandleInspector,
+) -> tuple[object, ...]:
+    """Validate actual handles against the concrete cache descriptor."""
+
+    expected_counts: dict[str, int] = {}
+    claimed_by: dict[tuple[str, int], str] = {}
+    for group in descriptor.cache_groups:
+        for member in group.members:
+            # max() alone would collapse two groups that name the same handle
+            # into one requirement, and every group would then bind the same
+            # tensor. Each handle backs exactly one member.
+            handle = (member.cache_owner_key, member.handle_index)
+            owner = f"{group.group_id}.{member.member_id}"
+            if handle in claimed_by:
+                raise ValueError(
+                    f"cache handle {member.cache_owner_key}[{member.handle_index}] is claimed by both "
+                    f"{claimed_by[handle]} and {owner}"
+                )
+            claimed_by[handle] = owner
+            expected_counts[member.cache_owner_key] = max(
+                expected_counts.get(member.cache_owner_key, 0), member.handle_index + 1
+            )
+    if set(handles_by_owner) != set(expected_counts):
+        raise ValueError(
+            "cache handle owners differ from the cache descriptor: "
+            f"expected={sorted(expected_counts)}, actual={sorted(handles_by_owner)}"
+        )
+    for cache_owner_key, count in expected_counts.items():
+        if len(handles_by_owner[cache_owner_key]) != count:
+            raise ValueError(
+                f"{cache_owner_key}: cache descriptor requires exactly {count} cache handles, "
+                f"got {len(handles_by_owner[cache_owner_key])}"
+            )
+
+    validated = []
+    for group in descriptor.cache_groups:
+        for member in group.members:
+            handle = handles_by_owner[member.cache_owner_key][member.handle_index]
+            shape, dtype, layout, memory_config, devices = inspect(handle)
+            expected_shape = (descriptor.num_blocks, *member.shape_per_block[1:])
+            actual = (tuple(shape), dtype, layout, memory_config, tuple(devices))
+            expected = (expected_shape, member.dtype, member.layout, member.memory_config, descriptor.devices)
+            if actual != expected:
+                raise ValueError(
+                    f"{group.group_id}.{member.member_id}: cache handle mismatch "
+                    f"(expected={expected}, actual={actual})"
+                )
+            validated.append(handle)
+    return tuple(validated)
+
+
+__all__ = [
+    "CacheAddressSpace",
+    "CacheDescriptor",
+    "CacheGroupSpec",
+    "CacheLayout",
+    "WorkerMeshTopology",
+    "MemberSpec",
+    "MeshParallelRole",
+    "TensorDistribution",
+    "TensorDistributionKind",
+    "describe_cache_groups",
+    "validate_handles",
+]
diff --git a/lmcache-t3knic/lmcache_t3knic/specs/canonical_json.py b/lmcache-t3knic/lmcache_t3knic/specs/canonical_json.py
new file mode 100644
index 0000000000000000000000000000000000000000..2f69c958ad0039ef07f28fd1850bf9776fbfab23
--- /dev/null
+++ b/lmcache-t3knic/lmcache_t3knic/specs/canonical_json.py
@@ -0,0 +1,54 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Canonical JSON encoding and fingerprinting for descriptor values."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from dataclasses import fields, is_dataclass
+from enum import Enum
+from typing import Any, Mapping
+
+from .validation import is_type, is_ttnn_enum, validated_ttnn_memory_config_fields
+
+
+def _memory_config_to_json_value(value: object) -> dict[str, str]:
+    memory_layout, buffer_type = validated_ttnn_memory_config_fields(value)
+    return {
+        "memory_layout": memory_layout.name.lower(),
+        "buffer_type": buffer_type.name.lower(),
+    }
+
+
+def _to_canonical_json_value(value: Any) -> Any:
+    if is_ttnn_enum(value):
+        return value.name.lower()
+    if is_type(value, "ttnn._ttnn.tensor", "MemoryConfig"):
+        return _memory_config_to_json_value(value)
+    if is_type(value, "torch", "dtype"):
+        return str(value).removeprefix("torch.")
+    if isinstance(value, Enum):
+        return value.value
+    if is_dataclass(value):
+        return {field.name: _to_canonical_json_value(getattr(value, field.name)) for field in fields(value)}
+    if isinstance(value, Mapping):
+        return {str(key): _to_canonical_json_value(value[key]) for key in sorted(value, key=str)}
+    if isinstance(value, (tuple, list)):
+        return [_to_canonical_json_value(item) for item in value]
+    if isinstance(value, (str, int, float, bool)) or value is None:
+        return value
+    raise TypeError(f"unsupported descriptor value: {type(value).__name__}")
+
+
+def descriptor_to_json_value(value: Any) -> Any:
+    """Convert descriptor values to canonical JSON-compatible primitives."""
+
+    return _to_canonical_json_value(value)
+
+
+def fingerprint(value: Any) -> str:
+    payload = json.dumps(_to_canonical_json_value(value), sort_keys=True, separators=(",", ":"))
+    return hashlib.sha256(payload.encode()).hexdigest()
+
+
+__all__ = ["descriptor_to_json_value", "fingerprint"]
diff --git a/lmcache-t3knic/lmcache_t3knic/specs/lowering.py b/lmcache-t3knic/lmcache_t3knic/specs/lowering.py
new file mode 100644
index 0000000000000000000000000000000000000000..2ba48f97d441996b4ed84d3cd3238526de6802cb
--- /dev/null
+++ b/lmcache-t3knic/lmcache_t3knic/specs/lowering.py
@@ -0,0 +1,97 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Deterministic lowering from physical cache descriptors to transfer plans."""
+
+from __future__ import annotations
+
+from .cache import CacheDescriptor, CacheGroupSpec, TensorDistributionKind
+from .transfer import (
+    BlockDistribution,
+    SplitPrefixPolicy,
+    TransferDescriptor,
+    TransferBackendKind,
+    TransferGroupDescriptor,
+    TransferPlan,
+    TransferPolicy,
+    MemoryObjMemberSpec,
+)
+
+
+# The TT prefill kernel takes a past length aligned to one tile row. A profile
+# that cannot split a prefix needs no more than that; one that can must also
+# land on a whole paged block, because the restore writes blocks, not tokens.
+_PREFILL_TILE_ALIGNMENT = 32
+
+
+def _lower_plan(local: CacheDescriptor, group: CacheGroupSpec) -> TransferPlan:
+    return TransferPlan(
+        backend_kind=TransferBackendKind.REGION_RAW,
+        address_space=local.address_space,
+        block_distribution=BlockDistribution(
+            data_parallel_size=local.data_parallel_size,
+            context_parallel_size=local.context_parallel_size,
+            context_block_interleave=local.context_block_interleave,
+        ),
+        tensor_parallel_size=local.tensor_parallel_size,
+        member_tensor_distributions=tuple(member.tensor_distribution for member in group.members),
+    )
+
+
+def _lower_group(local: CacheDescriptor, group: CacheGroupSpec) -> TransferGroupDescriptor:
+    import torch
+
+    plan = _lower_plan(local, group)
+    memory_obj_members = []
+    for member in group.members:
+        tensor_sharded = member.tensor_distribution.kind is TensorDistributionKind.SHARDED
+        memory_obj_bytes_per_block = member.bytes_per_block * (local.tensor_parallel_size if tensor_sharded else 1)
+        # bytes_per_token is a uniform stride, not a claim that one token's
+        # bytes can be addressed on their own. They often cannot: a bfloat8_b
+        # tile spans 32 token rows, so a single token is a fraction of a tile.
+        # The kernel never relies on that -- every run it emits is one whole
+        # block, num_bytes = block_size * member_width at block-aligned offsets
+        # on both the device and the host -- so the property that has to hold
+        # is only that a block divides into block_size equal strides.
+        if memory_obj_bytes_per_block % local.block_size:
+            raise ValueError(
+                f"{group.group_id}.{member.member_id}: block bytes {memory_obj_bytes_per_block} do not divide "
+                f"into {local.block_size} equal per-token strides"
+            )
+        width = memory_obj_bytes_per_block // local.block_size
+        memory_obj_members.append(
+            MemoryObjMemberSpec(
+                member_id=member.member_id,
+                shape_tail=(1, width),
+                dtype=torch.uint8,
+                bytes_per_block=memory_obj_bytes_per_block,
+                bytes_per_token=width,
+            )
+        )
+    split_prefix = (
+        SplitPrefixPolicy.DISABLED
+        if any(member.tensor_distribution.kind is TensorDistributionKind.SHARDED for member in group.members)
+        else SplitPrefixPolicy.EXACT
+    )
+    return TransferGroupDescriptor(
+        group_id=group.group_id,
+        layer_id=group.layer_id,
+        block_size=local.block_size,
+        memory_obj_members=tuple(memory_obj_members),
+        plan=plan,
+        policy=TransferPolicy(
+            allocation_alignment=local.block_size,
+            prefix_alignment=(local.block_size if split_prefix is SplitPrefixPolicy.EXACT else _PREFILL_TILE_ALIGNMENT),
+            split_prefix=split_prefix,
+        ),
+    )
+
+
+def lower_transfer(local_cache: CacheDescriptor) -> TransferDescriptor:
+    """Lower one model-owned cache descriptor to its process-local transfer plan."""
+
+    return TransferDescriptor(
+        local_cache=local_cache,
+        transfer_groups=tuple(_lower_group(local_cache, group) for group in local_cache.cache_groups),
+    )
+
+
+__all__ = ["lower_transfer"]
diff --git a/lmcache-t3knic/lmcache_t3knic/specs/transfer.py b/lmcache-t3knic/lmcache_t3knic/specs/transfer.py
new file mode 100644
index 0000000000000000000000000000000000000000..5df8bd4d55aac0e2dbcb4436154e6912959ccf88
--- /dev/null
+++ b/lmcache-t3knic/lmcache_t3knic/specs/transfer.py
@@ -0,0 +1,283 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Process-local transfer descriptors."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, fields
+from enum import Enum
+from math import prod
+from typing import TYPE_CHECKING, Sequence
+
+from .cache import CacheAddressSpace, CacheDescriptor, TensorDistribution, TensorDistributionKind
+from .validation import is_type, positive, require_enum
+
+if TYPE_CHECKING:
+    import torch
+
+
+class TransferBackendKind(Enum):
+    REGION_RAW = "tt.region_raw"
+
+
+class SplitPrefixPolicy(Enum):
+    DISABLED = "disabled"
+    EXACT = "exact"
+
+
+@dataclass(frozen=True, slots=True)
+class BlockDistribution:
+    """Independent DP and CP ownership of paged cache blocks."""
+
+    data_parallel_size: int
+    context_parallel_size: int
+    context_block_interleave: int
+
+    def __post_init__(self) -> None:
+        positive("data_parallel_size", self.data_parallel_size)
+        positive("context_parallel_size", self.context_parallel_size)
+        positive("context_block_interleave", self.context_block_interleave)
+
+    @property
+    def owner_count(self) -> int:
+        return self.data_parallel_size * self.context_parallel_size
+
+
+@dataclass(frozen=True, slots=True)
+class TransferPlan:
+    """Orthogonal request-independent axes consumed during backend preparation."""
+
+    backend_kind: TransferBackendKind
+    address_space: CacheAddressSpace
+    block_distribution: BlockDistribution
+    tensor_parallel_size: int
+    member_tensor_distributions: tuple[TensorDistribution, ...]
+
+    def __post_init__(self) -> None:
+        require_enum("backend_kind", self.backend_kind, TransferBackendKind)
+        require_enum("address_space", self.address_space, CacheAddressSpace)
+        if not isinstance(self.block_distribution, BlockDistribution):
+            raise TypeError("block_distribution must be BlockDistribution")
+        positive("tensor_parallel_size", self.tensor_parallel_size)
+        if not self.member_tensor_distributions:
+            raise ValueError("transfer plan must describe at least one member tensor distribution")
+        if not all(isinstance(item, TensorDistribution) for item in self.member_tensor_distributions):
+            raise TypeError("member_tensor_distributions must contain TensorDistribution values")
+
+    @property
+    def block_owner_count(self) -> int:
+        return self.block_distribution.owner_count
+
+
+@dataclass(frozen=True, slots=True)
+class MemoryObjMemberSpec:
+    """One member view inside an LMCache ``MemoryObj`` block payload.
+
+    ``shape_tail`` is the host allocation stride and ``bytes_per_token`` is the
+    device transfer stride; the two are separate consumers of one geometry and
+    must agree, so they are checked against each other here rather than trusted.
+    """
+
+    member_id: str
+    shape_tail: tuple[int, ...]
+    dtype: torch.dtype
+    bytes_per_block: int
+    bytes_per_token: int
+
+    def __post_init__(self) -> None:
+        if not self.member_id or not self.shape_tail or any(dim <= 0 for dim in self.shape_tail):
+            raise ValueError(f"invalid MemoryObj member {self.member_id!r}")
+        if not is_type(self.dtype, "torch", "dtype"):
+            raise TypeError(f"MemoryObj dtype must be torch.dtype, got {type(self.dtype).__name__}")
+        if str(self.dtype) != "torch.uint8":
+            raise ValueError(f"raw block transfer requires uint8 host storage, got {self.dtype!r}")
+        positive("bytes_per_block", self.bytes_per_block)
+        positive("bytes_per_token", self.bytes_per_token)
+        # uint8 storage is enforced above, so element count is the byte count.
+        if prod(self.shape_tail) != self.bytes_per_token:
+            raise ValueError(
+                f"{self.member_id}: MemoryObj shape tail {self.shape_tail} spans "
+                f"{prod(self.shape_tail)} bytes per token, but bytes_per_token is {self.bytes_per_token}"
+            )
+
+
+@dataclass(frozen=True, slots=True)
+class TransferPolicy:
+    """Request-independent policy consumed by the vLLM adapter and scheduler."""
+
+    allocation_alignment: int
+    prefix_alignment: int
+    split_prefix: SplitPrefixPolicy
+
+    def __post_init__(self) -> None:
+        positive("allocation_alignment", self.allocation_alignment)
+        positive("prefix_alignment", self.prefix_alignment)
+        require_enum("split_prefix", self.split_prefix, SplitPrefixPolicy)
+
+
+def _align_up(value: int, alignment: int) -> int:
+    return (value + alignment - 1) // alignment * alignment
+
+
+@dataclass(frozen=True, slots=True)
+class TransferGroupDescriptor:
+    """Static transfer contract lowered from one cache group."""
+
+    group_id: str
+    layer_id: int
+    block_size: int
+    memory_obj_members: tuple[MemoryObjMemberSpec, ...]
+    plan: TransferPlan
+    policy: TransferPolicy
+
+    def __post_init__(self) -> None:
+        if not self.group_id or self.layer_id < 0 or not self.memory_obj_members:
+            raise ValueError(f"invalid transfer group {self.group_id!r}")
+        positive("block_size", self.block_size)
+        if not isinstance(self.plan, TransferPlan):
+            raise TypeError("plan must be TransferPlan")
+        if self.policy.allocation_alignment != self.block_size:
+            raise ValueError("paged-block allocation alignment must equal the cache block size")
+        # The scheduler rounds a prefix hit down to this. It must not exceed a
+        # block, and must divide one so an aligned prefix is still block-aligned
+        # wherever the transfer path needs that.
+        if self.policy.prefix_alignment > self.block_size or self.block_size % self.policy.prefix_alignment:
+            raise ValueError(
+                f"prefix alignment {self.policy.prefix_alignment} must divide the cache block size {self.block_size}"
+            )
+        ids = tuple(member.member_id for member in self.memory_obj_members)
+        if len(ids) != len(set(ids)):
+            raise ValueError(f"{self.group_id}: duplicate MemoryObj member IDs")
+        if len(self.memory_obj_members) != len(self.plan.member_tensor_distributions):
+            raise ValueError("MemoryObj members and member tensor distributions must have equal lengths")
+        for member in self.memory_obj_members:
+            # Every byte offset the backend computes assumes a block is exactly
+            # block_size uniformly strided tokens.
+            if member.bytes_per_block != self.block_size * member.bytes_per_token:
+                raise ValueError(
+                    f"{self.group_id}.{member.member_id}: MemoryObj block spans "
+                    f"{member.bytes_per_block} bytes, but block_size {self.block_size} x "
+                    f"bytes_per_token {member.bytes_per_token} is "
+                    f"{self.block_size * member.bytes_per_token}"
+                )
+        distribution = self.plan.block_distribution
+        interleave = distribution.context_block_interleave
+        if interleave > self.block_size or self.block_size % interleave:
+            raise ValueError("context_block_interleave must divide the cache block size")
+        if distribution.context_parallel_size == 1 and interleave != 1:
+            raise ValueError("context_block_interleave must be 1 when context parallelism is disabled")
+
+    @property
+    def dtypes(self) -> tuple[torch.dtype, ...]:
+        return tuple(member.dtype for member in self.memory_obj_members)
+
+    def shapes(self, num_tokens: int) -> tuple[tuple[int, ...], ...]:
+        if num_tokens < 0:
+            raise ValueError(f"num_tokens must be non-negative, got {num_tokens}")
+        aligned = _align_up(num_tokens, self.policy.allocation_alignment)
+        return tuple((aligned, *member.shape_tail) for member in self.memory_obj_members)
+
+
+def single_group_profile(
+    groups: Sequence[TransferGroupDescriptor],
+    *,
+    requirement: str,
+) -> TransferGroupDescriptor:
+    """Return the profile every transfer group shares, or reject the descriptor.
+
+    Several consumers read layer-independent geometry -- allocator shapes,
+    kernel block sizes, member widths -- out of the first group and apply it to
+    every layer. They must all establish the same premise, so they establish it
+    here rather than each re-deriving it or assuming it.
+    """
+
+    if not groups:
+        raise ValueError(f"{requirement}, but the descriptor has no transfer groups")
+    profile_fields = tuple(
+        field.name for field in fields(TransferGroupDescriptor) if field.name not in {"group_id", "layer_id"}
+    )
+    profile = groups[0]
+    for group in groups[1:]:
+        differing = tuple(name for name in profile_fields if getattr(group, name) != getattr(profile, name))
+        if differing:
+            raise ValueError(
+                f"{requirement}, but {group.group_id} differs from {profile.group_id} in {', '.join(differing)}"
+            )
+    return profile
+
+
+@dataclass(frozen=True, slots=True)
+class TransferDescriptor:
+    """Process-local transfer aggregate for one cache owner."""
+
+    local_cache: CacheDescriptor
+    transfer_groups: tuple[TransferGroupDescriptor, ...]
+
+    def __post_init__(self) -> None:
+        if not self.transfer_groups or len(self.transfer_groups) != len(self.local_cache.cache_groups):
+            raise ValueError("transfer descriptor must cover every local cache group")
+        local_identity = tuple((group.group_id, group.layer_id) for group in self.local_cache.cache_groups)
+        transfer_identity = tuple((group.group_id, group.layer_id) for group in self.transfer_groups)
+        if transfer_identity != local_identity:
+            raise ValueError("transfer groups must preserve local cache-group order and identity")
+        tensor_parallel_size = self.local_cache.tensor_parallel_size
+        for cache_group, transfer_group in zip(self.local_cache.cache_groups, self.transfer_groups, strict=True):
+            plan = transfer_group.plan
+            if transfer_group.block_size != self.local_cache.block_size:
+                raise ValueError(
+                    f"{cache_group.group_id}: transfer block size {transfer_group.block_size} differs from "
+                    f"cache block size {self.local_cache.block_size}"
+                )
+            if plan.address_space is not self.local_cache.address_space:
+                raise ValueError(f"{cache_group.group_id}: transfer plan contradicts the cache address space")
+            if plan.tensor_parallel_size != tensor_parallel_size:
+                raise ValueError(
+                    f"{cache_group.group_id}: transfer plan declares tensor_parallel_size "
+                    f"{plan.tensor_parallel_size}, but the worker mesh has {tensor_parallel_size}"
+                )
+            if len(transfer_group.memory_obj_members) != len(cache_group.members):
+                raise ValueError(
+                    f"{cache_group.group_id}: {len(transfer_group.memory_obj_members)} MemoryObj members do not "
+                    f"cover {len(cache_group.members)} physical cache members"
+                )
+            for cache_member, obj_member, distribution in zip(
+                cache_group.members,
+                transfer_group.memory_obj_members,
+                plan.member_tensor_distributions,
+                strict=True,
+            ):
+                if obj_member.member_id != cache_member.member_id:
+                    raise ValueError(
+                        f"{cache_group.group_id}: MemoryObj member {obj_member.member_id!r} does not match "
+                        f"physical cache member {cache_member.member_id!r}"
+                    )
+                if distribution != cache_member.tensor_distribution:
+                    raise ValueError(
+                        f"{cache_group.group_id}.{cache_member.member_id}: transfer plan contradicts the "
+                        "physical member tensor distribution"
+                    )
+                # A sharded member is gathered across the TP mesh into one host block.
+                sharded = distribution.kind is TensorDistributionKind.SHARDED
+                expected_block_bytes = cache_member.bytes_per_block * (tensor_parallel_size if sharded else 1)
+                if obj_member.bytes_per_block != expected_block_bytes:
+                    raise ValueError(
+                        f"{cache_group.group_id}.{cache_member.member_id}: MemoryObj block spans "
+                        f"{obj_member.bytes_per_block} bytes, but the physical member spans "
+                        f"{expected_block_bytes}"
+                    )
+
+    @property
+    def backend_kinds(self) -> tuple[TransferBackendKind, ...]:
+        return tuple(dict.fromkeys(group.plan.backend_kind for group in self.transfer_groups))
+
+
+__all__ = [
+    "BlockDistribution",
+    "TransferDescriptor",
+    "SplitPrefixPolicy",
+    "TransferBackendKind",
+    "TransferGroupDescriptor",
+    "TransferPlan",
+    "TransferPolicy",
+    "MemoryObjMemberSpec",
+    "single_group_profile",
+]
diff --git a/lmcache-t3knic/lmcache_t3knic/specs/validation.py b/lmcache-t3knic/lmcache_t3knic/specs/validation.py
new file mode 100644
index 0000000000000000000000000000000000000000..4bbc7470c9ff7f99dae9da5d2f768a378744982c
--- /dev/null
+++ b/lmcache-t3knic/lmcache_t3knic/specs/validation.py
@@ -0,0 +1,70 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Strict structural validation helpers for cache and transfer descriptors."""
+
+from __future__ import annotations
+
+from enum import Enum
+from typing import Any, Mapping
+
+
+def is_type(value: object, module: str, name: str) -> bool:
+    value_type = type(value)
+    return value_type.__module__ == module and value_type.__name__ == name
+
+
+def is_ttnn_enum(value: object, name: str | None = None) -> bool:
+    value_type = type(value)
+    return (
+        value_type.__module__ == "ttnn._ttnn.tensor"
+        and isinstance(value, Enum)
+        and (name is None or value_type.__name__ == name)
+    )
+
+
+def require_enum(name: str, value: object, enum_type: type[Enum]) -> None:
+    if not isinstance(value, enum_type):
+        raise TypeError(f"{name} must be {enum_type.__name__}, got {type(value).__name__}")
+
+
+def positive(name: str, value: int) -> None:
+    if isinstance(value, bool) or not isinstance(value, int) or value <= 0:
+        raise ValueError(f"{name} must be a positive integer, got {value!r}")
+
+
+def require_exact_keys(label: str, value: Mapping[str, Any], expected: set[str] | frozenset[str]) -> None:
+    actual = set(value)
+    missing = sorted(expected - actual)
+    unknown = sorted(actual - expected)
+    if missing or unknown:
+        raise ValueError(f"{label} fields differ: missing={missing}, unknown={unknown}")
+
+
+def validated_ttnn_memory_config_fields(value: object) -> tuple[Enum, Enum]:
+    """Return the serializable fields of one supported per-device memory config."""
+
+    if not is_type(value, "ttnn._ttnn.tensor", "MemoryConfig"):
+        raise TypeError(f"memory_config must be ttnn.MemoryConfig, got {type(value).__name__}")
+    if getattr(value, "shard_spec", None) is not None or getattr(value, "nd_shard_spec", None) is not None:
+        raise TypeError("sharded TTNN memory_config is not supported by the connector descriptor")
+    memory_layout = getattr(value, "memory_layout", None)
+    buffer_type = getattr(value, "buffer_type", None)
+    if not is_ttnn_enum(memory_layout, "TensorMemoryLayout") or not is_ttnn_enum(buffer_type, "BufferType"):
+        raise TypeError("TTNN MemoryConfig has invalid memory layout or buffer type")
+    return memory_layout, buffer_type
+
+
+def validate_ttnn_memory_config(value: object) -> None:
+    """Reject per-device memory configs whose complete structure cannot be encoded."""
+
+    validated_ttnn_memory_config_fields(value)
+
+
+__all__ = [
+    "is_ttnn_enum",
+    "is_type",
+    "positive",
+    "require_enum",
+    "require_exact_keys",
+    "validate_ttnn_memory_config",
+    "validated_ttnn_memory_config_fields",
+]
diff --git a/lmcache-t3knic/lmcache_t3knic/t3knic_lmcache/__init__.py b/lmcache-t3knic/lmcache_t3knic/t3knic_lmcache/__init__.py
new file mode 100644
index 0000000000000000000000000000000000000000..5f78bfcfcf63d32e5803cf76b77c7e54566b51b4
--- /dev/null
+++ b/lmcache-t3knic/lmcache_t3knic/t3knic_lmcache/__init__.py
@@ -0,0 +1,107 @@
+# SPDX-License-Identifier: Apache-2.0
+"""LMCache backend for Tenstorrent T3K-NIC.
+
+This package wires LMCache to the external ``kvcache_manager`` product
+``Client`` and ``Server`` over TT-Fabric. TTNN supplies the matching device
+operations. KV cache movement bypasses the usual GPU-to-host DRAM copy: a
+placeholder is returned to LMCache and the actual transfer is issued through
+the TT sender kernel.
+
+Exports:
+    TTGPUConnector: LMCache ``GPUConnectorInterface`` implementation
+        for TT devices.
+    TTKVCacheClient: Adapter around ``kvcache_manager.Client`` for paired or
+        cross-node product Servers.
+    TTRemoteConnector: LMCache ``RemoteConnector`` that routes chunks
+        through TT-Fabric.
+    TTConnectorAdapter: LMCache ``ConnectorAdapter`` for ``t3knic://``
+        URLs. Auto-discovered by LMCache's ConnectorManager.
+    register_kvcache_client / clear_kvcache_client: Process-wide
+        TTKVCacheClient registration used by the worker.
+    validate_t3knic_config: Raise on incompatible LMCacheEngineConfig.
+    T3knicConfigError: Exception type for config-guard violations.
+"""
+
+from lmcache_t3knic.t3knic_lmcache._broadcast_patch import (
+    install_t3knic_broadcast_patch,
+    t3knic_broadcast_patch_installed,
+)
+from lmcache_t3knic.t3knic_lmcache.config_guard import (
+    T3knicConfigError,
+    check_t3knic_config_for_perf,
+    validate_t3knic_config,
+    warn_t3knic_config_perf,
+)
+
+# T3knicKVConnector inherits from vllm's KVConnectorBase_V1 -- skip the
+# export in environments where vllm is not installed (e.g. unit-test
+# containers without the full runtime). Production lmcache-t3knic always
+# ships with vllm so this fallback path is never hit there.
+#
+# Catch broad Exception (not just ImportError) because importing vllm
+# transitively pulls in sklearn/pandas/numpy; a broken numpy ABI in the
+# environment surfaces as ValueError("numpy.dtype size changed ...") from
+# pandas's pyx init, not ImportError. We want our package to remain
+# importable in that case so the non-vllm code paths still work.
+try:
+    from lmcache_t3knic.t3knic_lmcache.t3knic_kv_connector import T3knicKVConnector
+except Exception:  # pragma: no cover - vllm unavailable / broken env
+    T3knicKVConnector = None  # type: ignore[assignment,misc]
+from lmcache_t3knic.t3knic_lmcache.tt_connector_adapter import (
+    TTConnectorAdapter,
+    clear_kvcache_client,
+    register_kvcache_client,
+)
+from lmcache_t3knic.t3knic_lmcache.tt_gpu_connector import TTGPUConnector
+from lmcache_t3knic.t3knic_lmcache.tt_kvcache_client import (
+    KVChunkRef,
+    TTKVCacheClient,
+)
+from lmcache_t3knic.t3knic_lmcache.tt_paged_slice import (
+    PagedChunkLayout,
+    build_block_index_within_runs,
+    decode_chunk_layout,
+)
+from lmcache_t3knic.t3knic_lmcache.tt_remote_connector import TTRemoteConnector
+from lmcache_t3knic.t3knic_lmcache.worker_hook import (
+    ParsedT3knicURL,
+    T3knicMode,
+    apply_t3knic_plugin_config,
+    install_t3knic_backend,
+    parse_t3knic_url,
+    setup_t3knic_kvcache_client,
+)
+
+# Install the t3knic broadcast patch on package import so MLA + TP>1
+# deployments that keep LMCache's default ``save_only_first_rank=True``
+# do not need the user override. The patched function falls through to
+# the original whenever ``self.gpu_connector`` is not a TTGPUConnector,
+# so this is safe for every non-t3knic LMCache flow.
+install_t3knic_broadcast_patch()
+
+
+__all__ = [
+    "KVChunkRef",
+    "PagedChunkLayout",
+    "ParsedT3knicURL",
+    "T3knicConfigError",
+    "T3knicKVConnector",
+    "T3knicMode",
+    "TTConnectorAdapter",
+    "TTGPUConnector",
+    "TTKVCacheClient",
+    "TTRemoteConnector",
+    "apply_t3knic_plugin_config",
+    "build_block_index_within_runs",
+    "check_t3knic_config_for_perf",
+    "clear_kvcache_client",
+    "decode_chunk_layout",
+    "install_t3knic_backend",
+    "install_t3knic_broadcast_patch",
+    "parse_t3knic_url",
+    "register_kvcache_client",
+    "setup_t3knic_kvcache_client",
+    "t3knic_broadcast_patch_installed",
+    "validate_t3knic_config",
+    "warn_t3knic_config_perf",
+]
