@@ -0,0 +1,85 @@
+# SPDX-License-Identifier: Apache-2.0
+"""LMCache GPU connector factory injection for the T3K NIC TT bridge."""
+
+from __future__ import annotations
+
+import contextvars
+from collections.abc import Callable
+from typing import Any
+
+import torch
+
+_tt_npu_connector_var: contextvars.ContextVar[object | None] = contextvars.ContextVar(
+    "tt_npu_connector",
+    default=None,
+)
+_original_create_gpu_connector: Callable[..., Any] | None = None
+
+
+class tt_npu_connector_ctx:
+    """Inject a pre-built TT NPU connector for LMCache connector creation."""
+
+    def __init__(self, connector: object) -> None:
+        self.connector = connector
+
+    def __enter__(self) -> "tt_npu_connector_ctx":
+        self._tok = _tt_npu_connector_var.set(self.connector)
+        return self
+
+    def __exit__(self, *_a) -> None:
+        _tt_npu_connector_var.reset(self._tok)
+
+
+def set_original_create_gpu_connector(create_gpu_connector: Callable[..., Any]) -> None:
+    """Remember LMCache's stock factory for non-injected fallback paths."""
+    global _original_create_gpu_connector
+    if create_gpu_connector is not CreateTTNPUConnector:
+        _original_create_gpu_connector = create_gpu_connector
+
+
+def CreateTTNPUConnector(config, metadata, engine, **kwargs):  # noqa: N802
+    """Return the injected TT connector without requiring CUDA.
+
+    The T3K NIC connector injects a pre-built bridge while constructing its
+    LMCache child. Other paths delegate to LMCache's original factory.
+    """
+    preinjected = _tt_npu_connector_var.get()
+    if preinjected is not None:
+        return preinjected
+
+    # Keep LMCache connector imports lazy so importing the factory does not
+    # pull LMCache's vLLM integration into TT bootstrap paths prematurely.
+    from lmcache import utils as lmcache_utils
+    from lmcache.integration.vllm import utils as vllm_utils
+    from lmcache.v1.gpu_connector.gpu_connectors import (
+        VLLMPagedMemGPUConnectorV2,
+        VLLMPagedMemLayerwiseGPUConnector,
+    )
+
+    if engine == lmcache_utils.EngineType.VLLM:
+        _torch_dev, dev_name = vllm_utils.get_vllm_torch_dev()
+        if dev_name == "cpu":
+            layout_hints = kwargs.get("layout_hints")
+            if getattr(config, "use_layerwise", False):
+                return VLLMPagedMemLayerwiseGPUConnector.from_metadata(
+                    metadata,
+                    use_gpu=False,
+                    device=torch.device("cpu"),
+                    layout_hints=layout_hints,
+                )
+            return VLLMPagedMemGPUConnectorV2.from_metadata(
+                metadata,
+                use_gpu=False,
+                device=torch.device("cpu"),
+            )
+
+    if _original_create_gpu_connector is None:
+        raise RuntimeError("CreateTTNPUConnector called before set_original_create_gpu_connector")
+    return _original_create_gpu_connector(config, metadata, engine, **kwargs)
+
+
+__all__ = [
+    "CreateTTNPUConnector",
+    "set_original_create_gpu_connector",
+    "tt_npu_connector_ctx",
+]
