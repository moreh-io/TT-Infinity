+from __future__ import annotations
+
+import pytest
+import torch
+import ttnn
+from lmcache.c_ops import TransferDirection
+
+from lmcache_t3knic.runtime import (
+    TRANSFER_DESCRIPTOR_KEY,
+    descriptor_payload,
+    memory_obj_profile,
+    lower_block_binding,
+    placeholder_shapes,
+    transfer_groups_from_payload,
+)
+from lmcache_t3knic.specs import (
+    CacheDescriptor,
+    CacheGroupSpec,
+    WorkerMeshTopology,
+    TransferDescriptor,
+    MemberSpec,
+    TensorDistribution,
+    TensorDistributionKind,
+    fingerprint,
+    lower_transfer,
+)
+
+
+def _member_specs(layer: int) -> tuple[MemberSpec, ...]:
+    """Per-layer members, matching what describe_cache_groups derives from a model."""
+
+    distribution = TensorDistribution(TensorDistributionKind.REPLICATED)
+    return (
+        MemberSpec(
+            "latent",
+            f"model.layers.{layer}.attn",
+            0,
+            (1, 1, 128, 640),
+            ttnn.uint8,
+            ttnn.ROW_MAJOR_LAYOUT,
+            ttnn.DRAM_MEMORY_CONFIG,
+            81920,
+            distribution,
+        ),
+        MemberSpec(
+            "indexer",
+            f"model.layers.{layer}.attn.indexer",
+            0,
+            (1, 1, 128, 128),
+            ttnn.bfloat8_b,
+            ttnn.TILE_LAYOUT,
+            ttnn.DRAM_MEMORY_CONFIG,
+            17408,
+            distribution,
+        ),
+    )
+
+
+def _transfer(*, cp_size: int = 1, groups: int = 1) -> TransferDescriptor:
+    cache_groups = tuple(
+        CacheGroupSpec(f"model.layers.{layer}.attn", layer, _member_specs(layer)) for layer in range(groups)
+    )
+    mesh_shape = (2, cp_size // 2) if cp_size > 1 else (2, 4)
+    local = CacheDescriptor(
+        worker_id="local",
+        engine_id="engine",
+        global_worker_rank=0,
+        pipeline_stage_rank=0,
+        devices=tuple(range(cp_size if cp_size > 1 else 8)),
+        mesh_topology=WorkerMeshTopology(
+            mesh_shape=mesh_shape,
+            tensor_parallel_mesh_axis=None if cp_size > 1 else 1,
+            data_parallel_mesh_axis=None if cp_size > 1 else 0,
+            context_parallel_size=cp_size,
+        ),
+        num_blocks=64,
+        block_size=128,
+        cache_groups=cache_groups,
+        context_block_interleave=128 if cp_size > 1 else 1,
+    )
+    return lower_transfer(local)
+
+
+def test_transfer_payload_round_trip_is_structural_and_fingerprinted(expect_error) -> None:
+    transfer = _transfer(groups=2)
+    payload = descriptor_payload(transfer)
+
+    assert "protocol" not in payload
+    assert payload["profile"]["plan"]["backend_kind"] == "tt.region_raw"
+    assert payload["profile"]["memory_obj_members"][0]["dtype"] == "uint8"
+    assert transfer_groups_from_payload(payload) == transfer.transfer_groups
+    assert memory_obj_profile(payload).memory_obj_members == transfer.transfer_groups[0].memory_obj_members
+
+    corrupted = dict(payload)
+    corrupted["fingerprint"] = "bad"
+    with expect_error(ValueError, "fingerprint"):
+        transfer_groups_from_payload(corrupted)
+
+    versioned = dict(payload)
+    versioned["protocol"] = 999
+    with expect_error(ValueError, "fields differ"):
+        transfer_groups_from_payload(versioned)
+
+
+def test_transfer_payload_carries_one_profile_however_many_layers() -> None:
+    """Layers differ only in identity, so the wire must not repeat the geometry."""
+
+    import json
+
+    one = descriptor_payload(_transfer(groups=1))
+    many = descriptor_payload(_transfer(groups=92))
+
+    assert one["profile"] == many["profile"]
+    assert [group["layer_id"] for group in many["groups"]] == list(range(92))
+    assert tuple(group.layer_id for group in transfer_groups_from_payload(many)) == tuple(range(92))
+
+    one_bytes = len(json.dumps(one, separators=(",", ":")))
+    many_bytes = len(json.dumps(many, separators=(",", ":")))
+    # Each extra layer costs an identity, not another copy of the geometry.
+    per_layer_bytes = (many_bytes - one_bytes) / 91
+    assert per_layer_bytes < 100, per_layer_bytes
+    assert many_bytes < one_bytes * 92 / 8
+
+
+def test_transfer_payload_rejects_removed_token_alignment_contract(expect_error) -> None:
+    payload = descriptor_payload(_transfer())
+    profile = payload["profile"]
+    profile["token_alignment"] = profile["policy"]["allocation_alignment"]
+    del profile["policy"]
+    payload["fingerprint"] = fingerprint({"profile": profile, "groups": payload["groups"]})
+
+    with expect_error(ValueError, "invalid moreh_lmcache_transfer_descriptor"):
+        transfer_groups_from_payload(payload)
+
+
+def test_memory_obj_profile_cannot_be_given_mixed_allocator_profiles() -> None:
+    """A per-layer profile is now unrepresentable rather than merely rejected."""
+
+    payload = descriptor_payload(_transfer(groups=2))
+
+    assert set(payload) == {"fingerprint", "profile", "groups"}
+    assert all(set(group) == {"group_id", "layer_id"} for group in payload["groups"])
+    profile = memory_obj_profile(payload)
+    assert all(
+        group.memory_obj_members == profile.memory_obj_members for group in transfer_groups_from_payload(payload)
+    )
+
+
+def test_transfer_payload_rejects_inconsistent_memory_obj_geometry(expect_error) -> None:
+    payload = descriptor_payload(_transfer())
+    member = payload["profile"]["memory_obj_members"][0]
+    member["bytes_per_token"] = member["bytes_per_token"] + 1
+    payload["fingerprint"] = fingerprint({"profile": payload["profile"], "groups": payload["groups"]})
+
+    with expect_error(ValueError, "does not span|bytes per token"):
+        transfer_groups_from_payload(payload)
+
+
+def test_transfer_payload_rejects_block_bytes_that_contradict_block_size(expect_error) -> None:
+    payload = descriptor_payload(_transfer())
+    member = payload["profile"]["memory_obj_members"][0]
+    member["bytes_per_block"] = member["bytes_per_block"] + member["bytes_per_token"]
+    payload["fingerprint"] = fingerprint({"profile": payload["profile"], "groups": payload["groups"]})
+
+    with expect_error(ValueError, "MemoryObj block spans"):
+        transfer_groups_from_payload(payload)
+
+
+def test_lower_block_binding_accepts_full_and_partial_last_blocks() -> None:
+    slots = torch.tensor([512 + index for index in range(128)] + [1024 + index for index in range(17)])
+
+    binding = lower_block_binding(
+        _transfer(),
+        direction=TransferDirection.D2H,
+        starts=(0,),
+        ends=(145,),
+        slot_mapping=slots,
+    )
+
+    assert binding.slot_mapping.dtype == torch.int64
+    assert binding.slot_mapping.device.type == "cpu"
+    assert binding.source_starts == (0,)
+
+
+def test_lower_block_binding_accepts_cp_block_id_reuse_across_owners() -> None:
+    one_owner_block = list(range(128))
+    slots = torch.tensor([4096 + offset for _owner in range(4) for offset in one_owner_block])
+
+    binding = lower_block_binding(
+        _transfer(cp_size=4),
+        direction=TransferDirection.H2D,
+        starts=(0,),
+        ends=(512,),
+        slot_mapping=slots,
+    )
+
+    assert torch.equal(binding.slot_mapping, slots)
+
+
+@pytest.mark.parametrize(
+    ("starts", "ends", "slots", "source_starts", "message"),
+    [
+        ((1,), (129,), torch.arange(256), (0,), "starts must be block-aligned"),
+        ((0,), (128,), torch.cat((torch.arange(64), torch.tensor([-1]), torch.arange(65, 128))), (0,), "padding"),
+        ((0,), (128,), torch.cat((torch.arange(64), torch.arange(65, 129))), (0,), "sequential"),
+        ((0,), (128,), torch.arange(128), (1,), "source offsets must be block-aligned"),
+    ],
+)
+def test_lower_block_binding_rejects_non_block_contracts(
+    starts, ends, slots, source_starts, message, expect_error
+) -> None:
+    with expect_error(ValueError, message):
+        lower_block_binding(
+            _transfer(),
+            direction=TransferDirection.D2H,
+            starts=starts,
+            ends=ends,
+            slot_mapping=slots,
+            source_starts=source_starts,
+        )
+
+
+def test_lower_block_binding_rejects_dp_page_ids_beyond_descriptor_capacity(expect_error) -> None:
+    transfer = _transfer()
+    first_invalid_slot = transfer.local_cache.num_blocks * transfer.transfer_groups[0].plan.block_owner_count * 128
+    with expect_error(ValueError, "capacity"):
+        lower_block_binding(
+            transfer,
+            direction=TransferDirection.D2H,
+            starts=(0,),
+            ends=(128,),
+            slot_mapping=torch.arange(first_invalid_slot, first_invalid_slot + 128),
+        )
+
+
+def test_lower_block_binding_rejects_cp_owner_local_page_ids_beyond_capacity(expect_error) -> None:
+    first_invalid_slot = _transfer(cp_size=4).local_cache.num_blocks * 128
+    slots = torch.tensor([first_invalid_slot + offset for _owner in range(4) for offset in range(128)])
+    with expect_error(ValueError, "owner-local capacity"):
+        lower_block_binding(
+            _transfer(cp_size=4),
+            direction=TransferDirection.H2D,
+            starts=(0,),
+            ends=(512,),
+            slot_mapping=slots,
+        )
+
+
+def test_placeholder_shapes_follow_descriptor_member_order() -> None:
+    group = _transfer().transfer_groups[0]
+
+    assert placeholder_shapes(group, 32) == ((32, 128, 1, 640), (32, 128, 1, 136))
+
+
+def test_transfer_payload_key_names_the_descriptor() -> None:
+    assert TRANSFER_DESCRIPTOR_KEY == "moreh_lmcache_transfer_descriptor"
