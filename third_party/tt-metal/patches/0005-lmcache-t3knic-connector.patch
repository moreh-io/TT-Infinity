+++ b/lmcache-t3knic/lmcache_t3knic/t3knic_lmcache/tt_raw_byte.py
@@ -0,0 +1,407 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Raw-byte store/restore codec for the t3knic dict backends (MAF-20670).
+
+Replaces the multi-device torch round-trip (ConcatMesh2dToTensor gather ->
+bfp8 dequant -> requant -> mesh-mapper H2D -> moreh_paged_fill_cache_varlen)
+with the fused raw-byte region operations used by the TT connector:
+``ttnn.experimental.moreh_raw_byte_tp_interleaved_gather_to_torch`` /
+``_scatter_from_torch``. These copy the bfp8 TILE pages verbatim as bytes,
+per chip, per cache block — no dequant/requant, no fill kernel, and the
+restore is bit-true *in the paged cache* by construction (the torch-fill
+path corrupted the qwen3 (1,4) TP-sharded restore; the round-trip looked
+bit-exact to kvdiff because kvdiff compares the GET result tensors, not the
+cache the fill wrote into).
+
+Scope: multi-device (tp_size > 1) bfp8 TILE paged caches, mesh axes
+(dp, tp) == (0, 1) — the C++ planner flattens shards as dp*tp_size+tp_rank
+(row-major (1, N) / (dp, tp) meshes). Single-device keeps the validated
+legacy tensors flow. Opt out with T3KNIC_RAW_BYTE=0.
+
+Host buffer layout per (chunk, layer): one contiguous uint8 tensor holding
+[K region | V region]; each region is ``n_blocks * block_bytes`` where
+``block_bytes = shard_block_bytes * tp_size`` and per-block bytes are
+TP-shard interleaved (rank-major) — the planner's native layout. The chunk
+must start on a cache-block boundary with sequential slots, which holds
+when the LMCache chunk_size equals the vLLM block_size (see
+t3knic_lmcache_qwen3.yaml).
+"""
+
+from __future__ import annotations
+
+import os
+from typing import Dict, Optional
+
+import torch
+
+from lmcache.logging import init_logger
+
+logger = init_logger(__name__)
+
+# bfp8_b TILE page: 32x32 payload bytes + 64 shared-exponent bytes.
+_BFP8_TILE_BYTES = 1088
+_TILE = 32
+
+
+def _env_on(name: str, default: str) -> bool:
+    return os.environ.get(name, default).strip().lower() in ("1", "true", "yes", "on")
+
+
+class RawByteCodec:
+    """Per-connector raw-byte gather/scatter helper.
+
+    Built lazily from the live kvcaches on first use (the per-shard block
+    byte size needs a K handle). ``None`` from :meth:`maybe_build` means the
+    geometry/dtype is unsupported and callers must keep the legacy path.
+    """
+
+    # Wire value magic. Bumped from 0x524B564D when the header gained its 32-byte padding, so a
+    # value stored by the older host path fails loudly instead of being parsed at the wrong offset.
+    _MAGIC = 0x524B564E
+
+    def __init__(
+        self,
+        *,
+        tp_size: int,
+        dp_size: int,
+        block_size: int,
+        blocks_per_dp: int,
+        shard_block_bytes: int,
+    ) -> None:
+        self.tp_size = int(tp_size)
+        self.dp_size = int(dp_size)
+        self.block_size = int(block_size)
+        self.blocks_per_dp = int(blocks_per_dp)
+        self.shard_block_bytes = int(shard_block_bytes)
+        self.block_bytes = self.shard_block_bytes * self.tp_size
+
+    # ------------------------------------------------------------------
+    # construction
+    # ------------------------------------------------------------------
+
+    @classmethod
+    def maybe_build(
+        cls,
+        *,
+        kvcaches: object,
+        tp_size: int,
+        dp_size: int,
+        tp_axis: int,
+        dp_axis: int,
+        block_size: Optional[int],
+        blocks_per_dp: Optional[int],
+    ) -> Optional["RawByteCodec"]:
+        """Return a codec when the raw-byte path applies, else ``None``.
+
+        Decline (never raise): single-device (legacy path is validated
+        there), axes other than (dp=0, tp=1) (planner hard-codes the shard
+        flattening), non-bfp8/TILE caches, missing fused ops, or an explicit
+        T3KNIC_RAW_BYTE=0.
+        """
+        if not _env_on("T3KNIC_RAW_BYTE", "1"):
+            logger.info("[t3knic] raw-byte codec disabled via T3KNIC_RAW_BYTE=0")
+            return None
+        if int(tp_size) <= 1:
+            return None
+        if (int(dp_axis), int(tp_axis)) != (0, 1):
+            logger.warning(
+                "[t3knic] raw-byte codec declined: planner requires (dp_axis, tp_axis)=(0, 1), got (%s, %s)",
+                dp_axis,
+                tp_axis,
+            )
+            return None
+        if not block_size or not blocks_per_dp:
+            logger.warning("[t3knic] raw-byte codec declined: block_size/blocks_per_dp not configured")
+            return None
+        import ttnn
+
+        # These are plain nanobind free functions on ttnn._ttnn.operations.experimental, not
+        # registered ttnn operations. Depending on the Python binding initialization path, they
+        # may not be copied onto ttnn.experimental. Fall back to the raw module so the fast path
+        # works whenever the bindings are present -- without this the
+        # codec declines on a plain build and every restore silently takes the host D2H path,
+        # which costs ~20x and is the slowest thing in the request.
+        _raw = getattr(getattr(ttnn, "_ttnn", None), "operations", None)
+        _raw = getattr(_raw, "experimental", None)
+        for op in (
+            "moreh_raw_byte_tp_interleaved_gather_to_torch",
+            "moreh_raw_byte_tp_interleaved_scatter_from_torch",
+        ):
+            if not hasattr(ttnn.experimental, op):
+                fn = getattr(_raw, op, None)
+                if fn is None:
+                    logger.warning("[t3knic] raw-byte codec declined: ttnn.experimental.%s missing", op)
+                    return None
+                setattr(ttnn.experimental, op, fn)
+                logger.info("[t3knic] raw-byte: aliased ttnn.experimental.%s from the raw bindings", op)
+        try:
+            k0 = kvcaches[0][0]  # type: ignore[index]
+        except (TypeError, IndexError, KeyError):
+            logger.warning("[t3knic] raw-byte codec declined: kvcaches not in list[[k, v]] layout")
+            return None
+        if k0.dtype != ttnn.bfloat8_b or k0.layout != ttnn.TILE_LAYOUT:
+            logger.warning(
+                "[t3knic] raw-byte codec declined: cache dtype/layout %s/%s (need bfloat8_b TILE)",
+                k0.dtype,
+                k0.layout,
+            )
+            return None
+        # Per-device K shape: (num_blocks, heads_per_dev, block_size, head_dim).
+        _, heads_per_dev, blk, head_dim = (int(d) for d in k0.shape)
+        if blk != int(block_size):
+            logger.warning(
+                "[t3knic] raw-byte codec declined: handle block dim %d != configured block_size %s",
+                blk,
+                block_size,
+            )
+            return None
+        if blk % _TILE or head_dim % _TILE:
+            logger.warning("[t3knic] raw-byte codec declined: block/head dims not tile-aligned")
+            return None
+        shard_block_bytes = heads_per_dev * (blk // _TILE) * (head_dim // _TILE) * _BFP8_TILE_BYTES
+        codec = cls(
+            tp_size=tp_size,
+            dp_size=dp_size,
+            block_size=block_size,
+            blocks_per_dp=blocks_per_dp,
+            shard_block_bytes=shard_block_bytes,
+        )
+        logger.info(
+            "[t3knic] raw-byte codec ACTIVE: tp=%d dp=%d block_size=%d blocks_per_dp=%d "
+            "shard_block_bytes=%d block_bytes=%d",
+            codec.tp_size,
+            codec.dp_size,
+            codec.block_size,
+            codec.blocks_per_dp,
+            codec.shard_block_bytes,
+            codec.block_bytes,
+        )
+        return codec
+
+    # ------------------------------------------------------------------
+    # chunk geometry
+    # ------------------------------------------------------------------
+
+    def _chunk_slots(self, slot_mapping_slice: object) -> torch.Tensor:
+        slots = torch.as_tensor(slot_mapping_slice, dtype=torch.int64).flatten().contiguous()
+        if slots.numel() == 0:
+            raise ValueError("raw-byte codec: empty slot_mapping slice")
+        first = int(slots[0])
+        if first % self.block_size != 0:
+            raise RuntimeError(
+                "raw-byte codec: chunk does not start on a cache-block boundary "
+                f"(first slot {first}, block_size {self.block_size}). The LMCache "
+                "chunk_size must equal the vLLM block_size for this model — see "
+                "t3knic_lmcache_qwen3.yaml (chunk_size: 128)."
+            )
+        expected = torch.arange(first, first + slots.numel(), dtype=torch.int64)
+        if not torch.equal(slots, expected):
+            raise RuntimeError("raw-byte codec: chunk slots must be sequential within one DP group")
+        return slots
+
+    def _n_blocks(self, num_slots: int) -> int:
+        return (num_slots + self.block_size - 1) // self.block_size
+
+    def chunk_buffer_bytes(self, num_slots: int) -> int:
+        return 2 * self._n_blocks(num_slots) * self.block_bytes
+
+    # ------------------------------------------------------------------
+    # gather (PUT) / scatter (GET)
+    # ------------------------------------------------------------------
+
+    def gather_chunk(self, kvcaches: object, num_layers: int, slot_mapping_slice: object) -> Dict[int, torch.Tensor]:
+        """Read the chunk's blocks from the live paged cache as raw bytes.
+
+        Returns ``{layer_idx: uint8 tensor of [K region | V region]}``.
+        """
+        import ttnn
+
+        slots = self._chunk_slots(slot_mapping_slice)
+        alloc = self._n_blocks(slots.numel()) * self.block_bytes
+        bufs: Dict[int, torch.Tensor] = {}
+        for layer_idx in range(int(num_layers)):
+            cache_k, cache_v = kvcaches[layer_idx]  # type: ignore[index]
+            buf = torch.empty(2 * alloc, dtype=torch.uint8)
+            ttnn.experimental.moreh_raw_byte_tp_interleaved_gather_to_torch(
+                cache_k,
+                cache_v,
+                buf,
+                slots,
+                [0],
+                [int(slots.numel())],
+                [0],
+                [alloc, alloc],
+                [0, alloc],
+                self.shard_block_bytes,
+                self.block_bytes,
+                self.block_size,
+                self.dp_size,
+                self.blocks_per_dp,
+                self.tp_size,
+                blocking=True,
+            )
+            bufs[layer_idx] = buf
+        return bufs
+
+    def scatter_chunk(
+        self,
+        kvcaches: object,
+        num_layers: int,
+        slot_mapping_slice: object,
+        bufs: Dict[int, torch.Tensor],
+    ) -> None:
+        """Write the chunk's stored raw bytes back into the live paged cache."""
+        import ttnn
+
+        slots = self._chunk_slots(slot_mapping_slice)
+        alloc = self._n_blocks(slots.numel()) * self.block_bytes
+        for layer_idx in range(int(num_layers)):
+            buf = bufs.get(layer_idx)
+            if buf is None:
+                continue
+            if int(buf.numel()) != 2 * alloc:
+                raise RuntimeError(
+                    f"raw-byte codec: stored buffer for layer {layer_idx} has "
+                    f"{int(buf.numel())} bytes, expected {2 * alloc} (chunk geometry changed?)"
+                )
+            cache_k, cache_v = kvcaches[layer_idx]  # type: ignore[index]
+            ttnn.experimental.moreh_raw_byte_tp_interleaved_scatter_from_torch(
+                buf,
+                cache_k,
+                cache_v,
+                slots,
+                [0],
+                [int(slots.numel())],
+                [0],
+                [alloc, alloc],
+                [0, alloc],
+                self.shard_block_bytes,
+                self.block_bytes,
+                self.block_size,
+                self.dp_size,
+                self.blocks_per_dp,
+                self.tp_size,
+                blocking=True,
+            )
+
+    # ------------------------------------------------------------------
+    # on-device plan (no host round trip)
+    # ------------------------------------------------------------------
+
+    # The wire blob's header is padded to this, because a DRAM NoC read rounds its source address
+    # down to 32 bytes: an unaligned header would make every rank read its neighbour's slice.
+    HEADER_ALIGN = 32
+
+    def device_chunk_plan(self, kvcaches: object, num_layers: int, slot_mapping_slice: object) -> Dict[str, object]:
+        """Describe this chunk for the on-device gather/scatter ops.
+
+        Members are the live cache tensors themselves (K then V per layer), so the ops read and
+        write the paged cache in place. The blob they build is the same byte stream the host
+        planner produced: per layer, the K region then the V region, each block-major then
+        rank-major.
+        """
+        slots = self._chunk_slots(slot_mapping_slice)
+        n_blocks = self._n_blocks(slots.numel())
+        first_block = int(slots[0]) // self.block_size
+        dp = first_block // self.blocks_per_dp
+        local_first = first_block - dp * self.blocks_per_dp
+        if local_first + n_blocks > self.blocks_per_dp:
+            raise RuntimeError(
+                f"raw-byte codec: chunk blocks {local_first}..{local_first + n_blocks} cross the "
+                f"{self.blocks_per_dp}-block DP group"
+            )
+        block_ids = list(range(local_first, local_first + n_blocks))
+        # The chunk belongs to ONE DP group, so only that group's TP chips own its shards. The mesh
+        # axes are (dp, tp) by construction (see the module docstring), and the C++ planner's shard
+        # index dp*tp_size+tp_rank is exactly this row.
+        rank_coords = [(dp, t) for t in range(self.tp_size)]
+
+        alloc = n_blocks * self.block_bytes  # bytes one member contributes
+        n_layers = int(num_layers)
+        sizes = [2 * alloc] * n_layers  # each layer stores K region + V region
+        words = [self._MAGIC, n_layers] + sizes
+        pad = (-len(words) * 4) % self.HEADER_ALIGN
+        words += [0] * (pad // 4)
+        header_bytes = 4 * len(words)
+
+        members: list = []
+        region_bases: list = []
+        for layer_idx in range(n_layers):
+            cache_k, cache_v = kvcaches[layer_idx]  # type: ignore[index]
+            base = header_bytes + layer_idx * 2 * alloc
+            members += [cache_k, cache_v]
+            region_bases += [base, base + alloc]
+
+        return {
+            "rank_coords": rank_coords,
+            "dp": dp,
+            "members": members,
+            "region_bases": region_bases,
+            "block_ids": block_ids,
+            "header_words": words,
+            "value_len": header_bytes + n_layers * 2 * alloc,
+            "shard_block_bytes": self.shard_block_bytes,
+            "n_layers": n_layers,
+            "member_bytes": alloc,
+        }
+
+    def device_shard_plan(
+        self, kvcaches: object, num_layers: int, slot_mapping_slice: object, tp_rank: int
+    ) -> Dict[str, object]:
+        """Describe ONE rank's shard of this chunk, as its own self-contained blob.
+
+        Per-chip PUT stores each rank's shard under its own key, so the blob a chip builds holds
+        only its own bytes: per layer, its K region then its V region, each ``n_blocks *
+        shard_block_bytes``. That is the same stream :meth:`device_chunk_plan` produces with the
+        other ranks' interleaving removed -- with one rank there is nothing to interleave -- so the
+        same gather op builds it, called with this chip as both the master and the only rank.
+
+        The header describes the blob it prefixes, so its per-layer sizes are the shard's, not the
+        gathered chunk's. ``shard_index`` identifies the physical DP/TP planner coordinate, while
+        the wire key uses only ``tp_rank`` so equivalent DP replicas reuse the same cached shards.
+        """
+        if not 0 <= int(tp_rank) < self.tp_size:
+            raise ValueError(f"raw-byte codec: tp_rank {tp_rank} outside 0..{self.tp_size - 1}")
+        slots = self._chunk_slots(slot_mapping_slice)
+        n_blocks = self._n_blocks(slots.numel())
+        first_block = int(slots[0]) // self.block_size
+        dp = first_block // self.blocks_per_dp
+        local_first = first_block - dp * self.blocks_per_dp
+        if local_first + n_blocks > self.blocks_per_dp:
+            raise RuntimeError(
+                f"raw-byte codec: chunk blocks {local_first}..{local_first + n_blocks} cross the "
+                f"{self.blocks_per_dp}-block DP group"
+            )
+        block_ids = list(range(local_first, local_first + n_blocks))
+
+        alloc = n_blocks * self.shard_block_bytes  # bytes THIS rank contributes
+        n_layers = int(num_layers)
+        sizes = [2 * alloc] * n_layers
+        words = [self._MAGIC, n_layers] + sizes
+        pad = (-len(words) * 4) % self.HEADER_ALIGN
+        words += [0] * (pad // 4)
+        header_bytes = 4 * len(words)
+
+        members: list = []
+        region_bases: list = []
+        for layer_idx in range(n_layers):
+            cache_k, cache_v = kvcaches[layer_idx]  # type: ignore[index]
+            base = header_bytes + layer_idx * 2 * alloc
+            members += [cache_k, cache_v]
+            region_bases += [base, base + alloc]
+
+        coord = (dp, int(tp_rank))
+        return {
+            "coord": coord,
+            "rank_coords": [coord],
+            "dp": dp,
+            "tp_rank": int(tp_rank),
+            "shard_index": dp * self.tp_size + int(tp_rank),
+            "members": members,
+            "region_bases": region_bases,
+            "block_ids": block_ids,
+            "header_words": words,
+            "value_len": header_bytes + n_layers * 2 * alloc,
+            "shard_block_bytes": self.shard_block_bytes,
+            "n_layers": n_layers,
+            "member_bytes": alloc,
+        }
