index 0000000000000000000000000000000000000000..f71edae6b84130ef2d00e40d9864168531d5e42c
--- /dev/null
+++ b/lmcache-t3knic/lmcache_t3knic/t3knic_lmcache/tt_connector_adapter.py
@@ -0,0 +1,110 @@
+# SPDX-License-Identifier: Apache-2.0
+"""LMCache ``ConnectorAdapter`` for ``t3knic://`` URLs.
+
+When an LMCache engine is created with ``remote_url`` like
+``t3knic://<host>:<port>[?key=value]``, LMCache's
+``ConnectorManager`` discovers this adapter (auto-loaded because the
+filename ends with ``_adapter`` and the class is registered in the
+package's ``__init__``) and calls ``create_connector``. Here we:
+
+  1. Validate the LMCacheEngineConfig against the t3knic safety
+     contract via :func:`validate_t3knic_config`.
+  2. Look up the process-shared :class:`TTKVCacheClient` instance (the
+     lmcache-t3knic worker creates it after the MeshDevice / SubDevice
+     split is in place and unregisters it before mesh teardown).
+  3. Hand both to :class:`TTRemoteConnector`.
+
+If the worker has not yet registered a client we fail loudly --
+this prevents a half-initialised engine from running without a
+real client and silently no-oping puts.
+"""
+
+from typing import Optional
+
+from lmcache.logging import init_logger
+from lmcache.v1.storage_backend.connector import (
+    ConnectorAdapter,
+    ConnectorContext,
+)
+from lmcache.v1.storage_backend.connector.base_connector import RemoteConnector
+
+from lmcache_t3knic.t3knic_lmcache.config_guard import validate_t3knic_config
+from lmcache_t3knic.t3knic_lmcache.tt_kvcache_client import TTKVCacheClient
+from lmcache_t3knic.t3knic_lmcache.tt_remote_connector import TTRemoteConnector
+
+logger = init_logger(__name__)
+
+
+_REGISTERED_CLIENT: Optional[TTKVCacheClient] = None
+
+
+def register_kvcache_client(client: TTKVCacheClient) -> None:
+    """Register the process-wide :class:`TTKVCacheClient` instance.
+
+    Called by the lmcache-t3knic worker after the kvcache_server
+    SubDevice is set up. The adapter pulls this instance when
+    LMCache constructs the remote connector.
+
+    Raises:
+        RuntimeError: If a different client is already registered.
+            Re-registering the same instance is a no-op so worker
+            restarts behave sanely.
+    """
+    global _REGISTERED_CLIENT
+    if _REGISTERED_CLIENT is not None and _REGISTERED_CLIENT is not client:
+        raise RuntimeError(
+            "TTKVCacheClient is already registered. The t3knic backend " "supports one client per process."
+        )
+    _REGISTERED_CLIENT = client
+
+
+def clear_kvcache_client(expected: Optional[TTKVCacheClient] = None) -> None:
+    """Drop the registered client if it is the expected instance.
+
+    Passing no instance remains an unconditional reset for test isolation.
+    """
+    global _REGISTERED_CLIENT
+    if expected is None or _REGISTERED_CLIENT is expected:
+        _REGISTERED_CLIENT = None
+
+
+class TTConnectorAdapter(ConnectorAdapter):
+    """Adapter for ``t3knic://`` remote URLs."""
+
+    def __init__(self) -> None:
+        super().__init__("t3knic://")
+
+    def can_parse(self, url: str) -> bool:
+        if super().can_parse(url):
+            return True
+        # LMCache constructs "plugin://t3knic" when remote_storage_plugins
+        # contains "t3knic". Match that form as well.
+        if url.startswith("plugin://"):
+            pname = url[len("plugin://") :]
+            return pname == "t3knic" or pname.startswith("t3knic.")
+        return False
+
+    def create_connector(self, context: ConnectorContext) -> RemoteConnector:
+        """Validate config and construct a :class:`TTRemoteConnector`."""
+        if context.config is None:
+            raise ValueError("t3knic adapter requires LMCacheEngineConfig in the context")
+        if context.metadata is None:
+            raise ValueError("t3knic adapter requires LMCacheMetadata in the context")
+        validate_t3knic_config(context.config, context.metadata)
+
+        if _REGISTERED_CLIENT is None:
+            raise RuntimeError(
+                "TTKVCacheClient has not been registered. The lmcache-t3knic "
+                "worker must call "
+                "lmcache_t3knic.t3knic_lmcache.register_kvcache_client(...) "
+                "before LMCache constructs the t3knic remote connector."
+            )
+
+        logger.info("Creating t3knic remote connector for URL: %s", context.url)
+        return TTRemoteConnector(
+            client=_REGISTERED_CLIENT,
+            loop=context.loop,
+            local_cpu_backend=context.local_cpu_backend,
+            config=context.config,
+            metadata=context.metadata,
+        )
diff --git a/lmcache-t3knic/lmcache_t3knic/t3knic_lmcache/tt_gpu_connector.py b/lmcache-t3knic/lmcache_t3knic/t3knic_lmcache/tt_gpu_connector.py
