@@ -0,0 +1,146 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Serialization helpers between vLLM KV tensors and the ``ttnn.kvcache_manager``
+byte-oriented put/get API.
+
+Two concerns live here:
+
+1. **Key derivation** (device-free): ``ttnn.kvcache_manager`` keys are capped at
+   ``kMaxPutKeyBytes`` (128 bytes). LMCache's ``CacheEngineKey`` string
+   (``{model}@{ws}@{wid}@{chunk_hash_hex}@{dtype}[@tags]``) is ~108-115 bytes for
+   llama3-8b and can exceed 128 for longer model names / tags. We therefore hash
+   ``(chunk_key, layer_idx, component)`` into a fixed 64-char blake2b digest
+   that always fits. ``component="k"`` and ``"v"`` are distinct wire keys, so K
+   and V can be put/gotten independently.
+
+   If the KV pool is ever shared with a GPU LMCache instance,
+   both ends must agree on the wire key. For the single-T3K intranode flow we
+   control both ends, so this local hashing is safe; cross-backend sharing is a
+   future concern.
+
+2. **Tensor packing** (MAF-19909): the KV cache slice is bfloat8_b + TILE. The
+   8-A ``Client.put``/``get`` accept arbitrary INTERLEAVED-DRAM ttnn tensors
+   (commit 50aebd23c6 / 9f129c593b), so the bfp8 TILE bytes ship verbatim and
+   come back verbatim into a caller-allocated out_tensor of the same spec --
+   no host (de)quantisation, no bf16 detour. K and V are stored as two
+   independent wire entries to keep the page layout simple (one tensor, one
+   spec); the layer-level put_layer just issues two puts.
+"""
+
+from __future__ import annotations
+
+import hashlib
+from typing import Any, Sequence, Tuple
+
+# Mirror of ttnn::operations::kvcache_manager::protocol::kMaxPutKeyBytes.
+KMAX_PUT_KEY_BYTES = 128
+
+# blake2b with digest_size=32 -> 64 hex chars, comfortably under 128.
+_KEY_DIGEST_SIZE = 32
+
+
+def hash_layer_key(chunk_key: str, layer_idx: int, component: str = "kv") -> str:
+    """Derive a fixed-length kvcache_manager key for one layer of a chunk.
+
+    Args:
+        chunk_key: LMCache ``CacheEngineKey.to_string()`` value for the chunk.
+        layer_idx: 0-based transformer layer.
+        component: Sub-key label. ``"k"`` and ``"v"`` are independent wire
+            keys for the bfp8 passthrough path (K and V shipped separately).
+
+    Returns:
+        A 64-character hex digest (<= ``KMAX_PUT_KEY_BYTES``), deterministic in
+        the inputs.
+    """
+    h = hashlib.blake2b(digest_size=_KEY_DIGEST_SIZE)
+    h.update(f"{chunk_key}:{layer_idx}:{component}".encode("utf-8"))
+    digest = h.hexdigest()
+    assert len(digest) <= KMAX_PUT_KEY_BYTES, "blake2b digest unexpectedly long"
+    return digest
+
+
+# ---------------------------------------------------------------------------
+# bfp8 TILE passthrough: per-tensor sizing + DRAM placement
+# ---------------------------------------------------------------------------
+
+
+def _bfp8_tile_n_bytes(t: Any) -> int:
+    """Packed byte length of a bfloat8_b TILE_LAYOUT ttnn tensor.
+
+    Mirrors ``make_typed_tensor`` in the kvcache_manager test helper: for TILE
+    the device packs each 32x32 tile into one ``ttnn.tile_size(dtype)`` page
+    (1088 B for bfloat8_b: 1024 B for the tile + 64 B of shared exponents).
+    The packed byte count is the wire payload length the Client streams.
+    """
+    import ttnn
+
+    padded = list(t.padded_shape)
+    if len(padded) < 2:
+        raise ValueError(f"bfp8 TILE tensor must have rank >= 2; padded_shape={padded}")
+    num_tiles = 1
+    for d in padded[:-2]:
+        num_tiles *= int(d)
+    num_tiles *= (int(padded[-2]) // 32) * (int(padded[-1]) // 32)
+    return num_tiles * ttnn.tile_size(t.dtype)
+
+
+def place_on_sender_dram(host_tensor: Any, sender_device: Any) -> Any:
+    """Move a host ttnn.Tensor to the sender chip's DRAM as INTERLEAVED.
+
+    The bfp8 TILE byte layout is preserved (no dtype/layout change). Used to
+    stage K / V chunks for ``Client.put`` -- the wire requires an allocated,
+    INTERLEAVED-DRAM ttnn tensor on the sender chip.
+    """
+    import ttnn
+
+    return ttnn.to_device(host_tensor, sender_device, memory_config=ttnn.DRAM_MEMORY_CONFIG)
+
+
+def make_empty_bfp8_tile_dram(shape: Sequence[int], sender_device: Any) -> Any:
+    """Allocate an UNINITIALIZED bfp8 TILE INTERLEAVED-DRAM tensor on sender.
+
+    Used as ``Client.get``'s out-param. The wire overwrites this tensor verbatim
+    on a HIT and leaves it untouched on a MISS (the caller treats a miss as "not
+    present" and never reads the bytes), so the buffer's initial contents are
+    irrelevant -- there is no need to zero-fill it. We therefore use
+    ``allocate_tensor_on_device`` (a pure on-device DRAM allocation) instead of
+    ``torch.zeros`` + ``from_torch``, avoiding a host allocation, H2D transfer,
+    and tilize on every GET out-buffer. This matches the open()-time pool path
+    (TTKVCacheClient._init_plan_and_pool, which already uses
+    allocate_tensor_on_device for the reused GET buffers, proving it is a valid
+    Client.get out-param). ``shape`` must match what was originally PUT
+    (block_size / head_size are tile-aligned for llama-style models).
+    """
+    import ttnn
+
+    shape_t = tuple(int(s) for s in shape)
+    return ttnn.allocate_tensor_on_device(
+        ttnn.Shape(list(shape_t)),
+        ttnn.bfloat8_b,
+        ttnn.TILE_LAYOUT,
+        sender_device,
+        ttnn.DRAM_MEMORY_CONFIG,
+    )
+
+
+def to_host_ttnn(device_tensor: Any) -> Any:
+    """Pull a device ttnn.Tensor back to host while preserving bfp8 TILE bytes.
+
+    Symmetric to :func:`place_on_sender_dram`. After GET writes the bytes into
+    the sender-DRAM out_tensor, the connector pulls them to host to feed
+    back into the existing ``unslice_kv_layer_for_chunk`` / ``_paged_fill_layer_coalesced``
+    pipeline (which calls ``to_device`` again to push the chunk to the model
+    chip's KV cache).
+    """
+    import ttnn
+
+    return ttnn.from_device(device_tensor)
+
+
+__all__ = [
+    "KMAX_PUT_KEY_BYTES",
+    "hash_layer_key",
+    "_bfp8_tile_n_bytes",
+    "place_on_sender_dram",
+    "make_empty_bfp8_tile_dram",
+    "to_host_ttnn",
+]
