index 0000000000000000000000000000000000000000..d1be3e129e8e7d9b05731bfee01a37369aada890
--- /dev/null
+++ b/lmcache-t3knic/lmcache_t3knic/t3knic_lmcache/config_guard.py
@@ -0,0 +1,359 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Config validation guard for the t3knic LMCache backend.
+
+The TT design relies on `MemoryObj` being a placeholder whose host bytes
+are *never* the source of truth. Several LMCache code paths read those
+bytes (disk write, checksum, inter-rank broadcast, ...). If any such
+path is reachable, the placeholder garbage corrupts data silently.
+
+Rather than patching LMCache, we keep its source untouched ("0줄 목표"
+in the team design doc) and forbid the configurations that activate
+the dangerous read paths. This module raises a clear, actionable
+ValueError listing every violation, so misconfiguration fails loudly
+at LMCache engine construction rather than at retrieval time.
+
+The premises enforced here are the seven conditions under which the
+t3knic placeholder-bypass flow is safe. Update this guard if the
+contract changes.
+"""
+
+from typing import List, Optional
+
+from lmcache.logging import init_logger
+from lmcache.v1.config import LMCacheEngineConfig
+from lmcache.v1.metadata import LMCacheMetadata
+
+logger = init_logger(__name__)
+
+
+class T3knicConfigError(ValueError):
+    """Raised when LMCacheEngineConfig is incompatible with the t3knic backend."""
+
+
+def validate_t3knic_config(
+    config: LMCacheEngineConfig,
+    metadata: Optional[LMCacheMetadata] = None,
+) -> None:
+    """Validate that ``config`` matches the t3knic backend safety contract.
+
+    Args:
+        config: The LMCache engine configuration that will be used to build
+            ``LMCacheEngine``.
+        metadata: Optional engine metadata. Required to validate the
+            MLA-specific rule (premise 7); if not provided that check is
+            skipped.
+
+    Raises:
+        T3knicConfigError: If one or more premises are violated. The
+            message lists every violation so the caller can fix them in
+            one round.
+    """
+    violations: List[str] = []
+
+    _check_remote_url_not_audit(config, violations)
+    _check_remote_serde_naive(config, violations)
+    _check_local_cpu_disabled(config, violations)
+    _check_local_disk_disabled(config, violations)
+    _check_other_backends_disabled(config, violations)
+    _check_nixl_storage_disabled(config, violations)
+    _check_layerwise_disabled(config, violations)
+    if metadata is not None:
+        _check_save_only_first_rank(config, metadata, violations)
+
+    if violations:
+        bullet = "\n  - "
+        raise T3knicConfigError(
+            "t3knic LMCache backend rejected the given LMCacheEngineConfig.\n"
+            "The following safe-config premises are violated:" + bullet + bullet.join(violations)
+        )
+
+
+def _check_remote_url_not_audit(config: LMCacheEngineConfig, violations: List[str]) -> None:
+    """Premise 5: do not wrap t3knic with AuditConnector (sha256 over placeholder)."""
+    remote_url = config.remote_url
+    if remote_url and remote_url.startswith("audit://"):
+        violations.append(
+            "remote_url uses audit:// scheme. AuditConnector would call "
+            "sha256 over MemoryObj.byte_array which on TT contains "
+            "placeholder bytes -- this corrupts the audit log silently. "
+            "Use t3knic:// directly without the audit wrapper."
+        )
+
+
+def _check_remote_serde_naive(config: LMCacheEngineConfig, violations: List[str]) -> None:
+    """Premise 1: only the naive serializer preserves MemoryObj identity.
+
+    KIVI / CacheGen wrap MemoryObj into a new instance, which breaks the
+    id(memory_obj) side-channel used by TTGPUConnector / TTRemoteConnector.
+    The naive serde returns the same instance.
+    """
+    serde = config.remote_serde
+    if serde is not None and serde != "naive":
+        violations.append(
+            f"remote_serde={serde!r}; must be 'naive' (or None, which "
+            "defaults to 'naive'). KIVI/CacheGen serializers wrap the "
+            "MemoryObj into a new instance and break the id(memory_obj) "
+            "side-channel used by TTGPUConnector / TTRemoteConnector."
+        )
+
+
+def _check_local_cpu_disabled(config: LMCacheEngineConfig, violations: List[str]) -> None:
+    """Premise 2: LocalCPUBackend.hot_cache would cache placeholder bytes.
+
+    On retrieve, ``storage_manager.get_blocking`` auto-populates the local
+    CPU cache with whatever the remote returns. For TT that's placeholder
+    garbage; the next retrieve would short-circuit through the local cache
+    and bypass TTRemoteConnector.get entirely (silent corruption).
+    """
+    if config.local_cpu:
+        violations.append(
+            "local_cpu=True. LocalCPUBackend.hot_cache would cache the "
+            "placeholder MemoryObj returned by TTRemoteConnector.get; the "
+            "next retrieve would short-circuit there and return garbage. "
+            "Set local_cpu=False."
+        )
+
+
+def _check_local_disk_disabled(config: LMCacheEngineConfig, violations: List[str]) -> None:
+    """Premise 6: LocalDiskBackend writes MemoryObj.tensor bytes to disk."""
+    if config.local_disk is not None:
+        violations.append(
+            f"local_disk={config.local_disk!r}. LocalDiskBackend writes "
+            "MemoryObj.tensor to disk directly -- on TT it would persist "
+            "placeholder garbage. Set local_disk=null."
+        )
+    if config.max_local_disk_size and config.max_local_disk_size > 0:
+        violations.append(
+            f"max_local_disk_size={config.max_local_disk_size}. Must be 0 "
+            "(or unset) so that LocalDiskBackend is not constructed."
+        )
+
+
+def _check_other_backends_disabled(config: LMCacheEngineConfig, violations: List[str]) -> None:
+    """Premise 3: only RemoteBackend may be active in the t3knic flow.
+
+    Other backends use different allocators, which makes
+    storage_manager.batched_put trigger allocate_and_copy_objects --
+    that path copies MemoryObj bytes and breaks the id() side-channel.
+    """
+    if getattr(config, "enable_p2p", False):
+        violations.append("enable_p2p=True. P2PBackend conflicts with the t3knic flow.")
+    if getattr(config, "enable_pd", False):
+        violations.append("enable_pd=True. PDBackend conflicts with the t3knic flow.")
+    if getattr(config, "nixl_backends", None):
+        violations.append(f"nixl_backends={config.nixl_backends!r}. NixlBackend conflicts " "with the t3knic flow.")
+    if getattr(config, "gds_path", None):
+        violations.append(f"gds_path={config.gds_path!r}. GdsBackend conflicts with the " "t3knic flow.")
+
+
+def _check_nixl_storage_disabled(config: LMCacheEngineConfig, violations: List[str]) -> None:
+    """Premise 3 (continued): extra_config['enable_nixl_storage']=True path."""
+    extra = config.extra_config
+    if extra and extra.get("enable_nixl_storage"):
+        violations.append("extra_config.enable_nixl_storage=True. Nixl storage conflicts " "with the t3knic flow.")
+
+
+def check_t3knic_config_for_perf(
+    config: LMCacheEngineConfig,
+    metadata: Optional[LMCacheMetadata],
+) -> List[str]:
+    """Return a list of perf-warning messages for ``config`` / ``metadata``.
+
+    These are non-blocking concerns -- the t3knic flow is still correct
+    when any of these fire, but the user is likely leaving performance
+    on the floor. Caller decides whether to log, raise, or ignore.
+    See :func:`warn_t3knic_config_perf` for the standard log adapter.
+
+    Args:
+        config: The LMCache engine configuration.
+        metadata: The LMCache engine metadata, or ``None`` when called
+            before metadata is available. Metadata-dependent checks
+            (currently the MLA worker_id_as_0 warning) are skipped in
+            that case.
+
+    Returns:
+        Empty list if no warnings apply; otherwise one string per
+        concern, each phrased so the user knows what to change.
+    """
+    warnings: List[str] = []
+    if metadata is not None:
+        _perf_check_mla_worker_id_as0(config, metadata, warnings)
+    _perf_check_layerwise(config, warnings)
+    _perf_check_blending(config, warnings)
+    _perf_check_save_decode_cache(config, warnings)
+    return warnings
+
+
+def warn_t3knic_config_perf(
+    config: LMCacheEngineConfig,
+    metadata: Optional[LMCacheMetadata],
+) -> List[str]:
+    """Run :func:`check_t3knic_config_for_perf` and emit each warning via
+    ``logger.warning``.
+
+    Returns the list of messages so callers can also surface them in
+    tests or higher-level UI.
+    """
+    warnings = check_t3knic_config_for_perf(config, metadata)
+    for msg in warnings:
+        logger.warning("t3knic config perf: %s", msg)
+    return warnings
+
+
+def _perf_check_mla_worker_id_as0(
+    config: LMCacheEngineConfig,
+    metadata: LMCacheMetadata,
+    warnings: List[str],
+) -> None:
+    """MLA + ``remote_enable_mla_worker_id_as0=False`` → N× storage waste.
+
+    LMCache's default for MLA models routes non-zero ranks' puts/gets
+    to the rank-0 key (``RemoteBackend._mla_worker_id_as0_mode``).
+    Explicitly disabling this loses the dedupe and burns the KV pool
+    with N copies of identical data. The flow still works, but it
+    shouldn't be the default operating point.
+    """
+    if not metadata.use_mla:
+        return
+    if metadata.world_size <= 1:
+        return
+    extra = config.extra_config or {}
+    raw = extra.get("remote_enable_mla_worker_id_as0")
+    # The LMCache default for this key is ``metadata.use_mla`` (True for
+    # MLA models). Only flag when the user *explicitly* set it to False.
+    if raw is False:
+        warnings.append(
+            "extra_config['remote_enable_mla_worker_id_as0']=False on an "
+            f"MLA model with world_size={metadata.world_size}. Each TP "
+            "rank will fabric_write its own copy of identical KV data "
+            "(N× pool storage, N× fabric_write bandwidth). Consider "
+            "removing the override or setting it back to True unless you "
+            "have a specific reason."
+        )
+
+
+def _check_layerwise_disabled(config: LMCacheEngineConfig, violations: List[str]) -> None:
+    """Reject use_layerwise=True because it is structurally incompatible with t3knic.
+
+    LMCache's layerwise store/retrieve (store_layer/retrieve_layer) asserts the
+    GPU connector is one of its layerwise connector types via
+    assert_layerwise_gpu_connector; TTGPUConnector is NOT one, so the layerwise
+    path raises AssertionError on the first store/retrieve (in eager mode too).
+    It also drives batched_from_gpu/to_gpu as generators, which TTGPUConnector's
+    plain functions do not satisfy. Additionally, in lazy store mode the
+    eager-off (wait_for_save skips child.wait_for_save, the only finalizer of the
+    per-layer save generators) would leak worker-side generators. use_layerwise
+    only belongs to the separate P/D-disagg configs, never the t3knic single-node
+    flow. Fail loud at config time instead of a buried AssertionError mid-forward.
+    """
+    if getattr(config, "use_layerwise", False):
+        violations.append(
+            "use_layerwise=True is not supported by the t3knic backend. "
+            "TTGPUConnector is not a layerwise GPU connector, so LMCache's "
+            "assert_layerwise_gpu_connector fails on the first store/retrieve "
+            "(all store modes); in lazy store mode it also leaks worker save "
+            "generators. Set use_layerwise=False (the t3knic default). "
+            "use_layerwise=true belongs only to the P/D-disagg configs."
+        )
+
+
+def _perf_check_layerwise(
+    config: LMCacheEngineConfig,
+    warnings: List[str],
+) -> None:
+    """Superseded by the hard :func:`_check_layerwise_disabled` premise (R5);
+    kept as a no-op-safe secondary note in case validate is bypassed."""
+    if getattr(config, "use_layerwise", False):
+        warnings.append(
+            "use_layerwise=True is unsupported by t3knic (see the hard config "
+            "premise); the layerwise LMCache path is incompatible with "
+            "TTGPUConnector. Set use_layerwise=False."
+        )
+
+
+def _perf_check_save_decode_cache(
+    config: LMCacheEngineConfig,
+    warnings: List[str],
+) -> None:
+    """Warn while decode-prefix re-store and lookup semantics remain unverified.
+
+    With ``save_unfull_chunk=True``, a same-prompt follow-up has previously
+    reported zero hit tokens despite the first request issuing stores. Keep the
+    conservative default until that chunk-hash or async-store interaction has
+    an end-to-end regression test.
+    """
+    if getattr(config, "save_decode_cache", False):
+        warnings.append(
+            "save_decode_cache=True on t3knic is not yet covered by a repeated-prompt "
+            "round-trip. In combination with save_unfull_chunk=True, a follow-up "
+            "lookup has previously returned LMCache hit=0 despite stores firing. "
+            "Recommend save_decode_cache=False until the chunk-hash / async-store "
+            "interaction has an end-to-end regression test."
+        )
+
+
+def _perf_check_blending(
+    config: LMCacheEngineConfig,
+    warnings: List[str],
+) -> None:
+    """``enable_blending=True`` activates blend kernels that consume
+    MemoryObj contents -- with TT placeholders this is likely unsafe.
+
+    Phrased as a warning rather than a hard validation error because we
+    have not exhaustively grep'd the blend code path; the user may have
+    a setup where blending is harmless. But the default expectation is
+    that blending and placeholder MemoryObjs do not mix.
+    """
+    if getattr(config, "enable_blending", False):
+        warnings.append(
+            "enable_blending=True together with the t3knic backend. "
+            "The blending pipeline (LMCBlender) consumes MemoryObj "
+            "contents which on TT are placeholder bytes -- likely "
+            "silent-corruption. Disable blending unless you have "
+            "verified compatibility for your specific use case."
+        )
+
+
+def _check_save_only_first_rank(
+    config: LMCacheEngineConfig,
+    metadata: LMCacheMetadata,
+    violations: List[str],
+) -> None:
+    """Premise 7: for MLA models with ``save_only_first_rank=True``,
+    the stock LMCache broadcast path would ship placeholder bytes to
+    other ranks. There are two ways to be safe:
+
+      1. ``extra_config['save_only_first_rank']=False`` -- every rank
+         retrieves independently, no broadcast happens.
+      2. The t3knic broadcast monkey-patch (auto-installed on import
+         of this package) replaces the data-broadcasting path with a
+         key-broadcasting path so each rank fabric_reads on its own
+         chip while keeping ``save_only_first_rank=True``.
+
+    Non-MLA models have ``save_only_first_rank`` forced to False by
+    LMCache itself, so the check is irrelevant there.
+    """
+    if not metadata.use_mla:
+        return
+    # Lazy import: this module is imported very early in package init,
+    # before _broadcast_patch's helper is available on the namespace.
+    try:
+        from lmcache_t3knic.t3knic_lmcache._broadcast_patch import (
+            t3knic_broadcast_patch_installed,
+        )
+    except ImportError:
+        broadcast_patched = False
+    else:
+        broadcast_patched = t3knic_broadcast_patch_installed()
+    if broadcast_patched:
+        return
+    extra = config.extra_config or {}
+    if extra.get("save_only_first_rank") is not False:
+        violations.append(
+            "MLA model detected (metadata.use_mla=True) and the t3knic "
+            "broadcast patch is not installed. Either import "
+            "lmcache_t3knic.t3knic_lmcache (which auto-installs the patch) "
+            "or set extra_config={'save_only_first_rank': False} so "
+            "LMCache skips the broadcast path that would ship placeholder "
+            "bytes to other ranks."
+        )
