@@ -0,0 +1,117 @@
+# SPDX-License-Identifier: Apache-2.0
+"""KV-cache spec adapter for stock vLLM specs + tt_transformers TT KV tensors.
+
+The connector's ``bind_tt_cache`` (via lmcache_t3knic.specs.describe_cache_groups) expects a
+structural model spec contract: per cache owner an object exposing ``block_size``,
+``get_cache_tensor_specs(num_blocks)`` (tensor specs with shape/dtype/layout/memory_config/nbytes),
+``transfer_member_ids``, ``transfer_tensor_partition_axes``, ``group_member_start_index`` and
+``transfer_layer_id``. Models served through vllm-tt-plugin (tt_transformers) publish only a stock
+vLLM ``FullAttentionSpec``. This module builds
+the equivalent contract FROM THE ALLOCATED ttnn TENSORS, so nothing about the layout is guessed:
+each layer's ``[k, v]`` handles give the per-device block shape, TT dtype, layout and memory config.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from math import prod
+from typing import Any, Sequence
+
+import ttnn
+
+# Standard TT tile sizes by dtype.
+_TILE_BYTES = {
+    ttnn.bfloat4_b: 576,
+    ttnn.bfloat8_b: 1088,
+    ttnn.bfloat16: 2048,
+    ttnn.uint16: 2048,
+    ttnn.float32: 4096,
+    ttnn.uint32: 4096,
+    ttnn.int32: 4096,
+}
+_ELEM_BYTES = {ttnn.uint8: 1, ttnn.bfloat16: 2, ttnn.float32: 4, ttnn.uint32: 4, ttnn.int32: 4}
+
+
+def _div_up(a: int, b: int) -> int:
+    return -(-a // b)
+
+
+def tt_nbytes(shape: Sequence[int], dtype: Any, layout: Any) -> int:
+    shape = tuple(int(d) for d in shape)
+    if layout == ttnn.TILE_LAYOUT:
+        outer = prod(shape[:-2]) if len(shape) > 2 else 1
+        tiles = outer * _div_up(shape[-2], ttnn.TILE_SIZE) * _div_up(shape[-1], ttnn.TILE_SIZE)
+        return tiles * _TILE_BYTES[dtype]
+    if layout == ttnn.ROW_MAJOR_LAYOUT:
+        return prod(shape) * _ELEM_BYTES[dtype]
+    raise AssertionError(f"unsupported layout {layout}")
+
+
+@dataclass(frozen=True)
+class PluginTensorSpec:
+    """One physical cache tensor for ``num_blocks`` blocks."""
+
+    shape: tuple[int, ...]
+    dtype: Any
+    layout: Any
+    memory_config: Any
+
+    @property
+    def nbytes(self) -> int:
+        return tt_nbytes(self.shape, self.dtype, self.layout)
+
+
+class PluginFullAttentionKVCacheSpec:
+    """Cache-owner spec for one attention layer, derived from its allocated [k, v] handles."""
+
+    transfer_member_ids = ("key", "value")
+    transfer_tensor_partition_axes = (1, 1)  # heads axis is the TP shard
+    group_member_start_index = 0
+    transfer_group_id = None  # -> the cache owner key
+
+    def __init__(self, layer_idx: int, k_handle: Any, v_handle: Any, block_size: int) -> None:
+        self.transfer_layer_id = int(layer_idx)
+        self.block_size = int(block_size)
+        self._handles = (k_handle, v_handle)
+        k_shape = tuple(int(d) for d in k_handle.shape)
+        if len(k_shape) != 4 or k_shape[2] != self.block_size:
+            raise ValueError(f"unexpected TT KV shape {k_shape} for block_size {self.block_size}")
+        self.per_device_num_kv_heads = k_shape[1]
+        self.num_kv_heads = k_shape[1]
+        self.head_size = k_shape[3]
+        self.head_size_v = tuple(int(d) for d in v_handle.shape)[3]
+
+    def get_cache_tensor_specs(self, num_blocks: int) -> tuple[PluginTensorSpec, ...]:
+        specs = []
+        for h in self._handles:
+            shape = tuple(int(d) for d in h.shape)
+            specs.append(
+                PluginTensorSpec(
+                    shape=(int(num_blocks),) + shape[1:],
+                    dtype=h.dtype,
+                    layout=h.layout,
+                    memory_config=h.memory_config(),
+                )
+            )
+        return tuple(specs)
+
+    @property
+    def page_size_bytes(self) -> int:
+        return sum(t.nbytes for t in self.get_cache_tensor_specs(1))
+
+
+def build_plugin_kv_specs(per_layer_handles: Sequence[Sequence[Any]], block_size: int):
+    """(layer_names, specs_by_owner, handles_by_owner) for ``per_layer_handles[i] == [k, v]``.
+
+    Owner keys follow the ``...layers.<N>...`` convention lmcache_t3knic parses as a fallback;
+    ``transfer_layer_id`` is declared anyway so the mapping never depends on the name.
+    """
+    names, specs, handles = [], {}, {}
+    for i, kv in enumerate(per_layer_handles):
+        if len(kv) != 2:
+            raise ValueError(f"layer {i}: expected [k, v] handles, got {len(kv)}")
+        name = f"model.layers.{i}.self_attn.attn"
+        names.append(name)
+        specs[name] = PluginFullAttentionKVCacheSpec(i, kv[0], kv[1], block_size)
+        handles[name] = list(kv)
+    return names, specs, handles
