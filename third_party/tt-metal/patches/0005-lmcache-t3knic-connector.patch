index 0000000000000000000000000000000000000000..c03760297935a625663ac7f755c2a331f09f7101
--- /dev/null
+++ b/lmcache-t3knic/lmcache_t3knic/t3knic_lmcache/gm_proxy.py
@@ -0,0 +1,205 @@
+# SPDX-FileCopyrightText: (c) 2026 Moreh
+#
+# SPDX-License-Identifier: Apache-2.0
+"""Global-master wire proxy (option 1-1, U-F F1).
+
+One PP rank -- the one owning the master chip -- runs the real kvcache wire
+client; every other rank forwards its PUT/GET/EXISTS through a zmq REQ/REP
+pair on the same host.
+
+Transport layering: the CONTROL frame is JSON ({op, key, slot, len}); chunk
+bytes ride a second zmq multipart segment. This v1 "inline" transport moves
+the chunk over ipc:// (same-host memcpy class). The planned fabric-staging
+transport (F2/F3/F4: forwarder pushes into a master-chip DRAM slot, frame
+carries only the slot index) drops in by populating `slot` and omitting the
+data segment -- the protocol already carries both fields so owners and
+forwarders can negotiate per-request.
+
+The proxy is transport-only: the owner side is handed plain callables so the
+protocol can be unit-tested without a device (tests/t3knic_lmcache/
+test_global_master_proxy.py) and wired to the real client afterwards.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import threading
+from typing import Callable, Optional
+
+import zmq
+
+from lmcache.logging import init_logger
+
+logger = init_logger(__name__)
+
+_OPS = ("put", "get", "exists", "detach")
+# A control frame is tiny; anything bigger than this is a corrupted or hostile peer.
+_MAX_FRAME_BYTES = 4096
+# One chunk per request; the wire's own max value size bounds real traffic far below this.
+_MAX_DATA_BYTES = 256 * 1024 * 1024
+
+
+def default_endpoint() -> str:
+    """ipc:// endpoint shared by the owner and forwarders on one host."""
+    sock = os.environ.get("T3KNIC_GM_SOCK")
+    if sock:
+        return sock
+    return f"ipc:///tmp/t3knic_gm_{os.getuid()}.sock"
+
+
+class GlobalMasterProxy:
+    """Owner-side REP service. One instance per wire-owner rank.
+
+    The executor callables run on the proxy thread and must be thread-safe
+    against the owner's own put/get path (the owner passes wrappers that take
+    its op lock).
+
+    v1 inline-data contract:
+      put_fn(key, data) -> bool               # False = wire store failed
+      get_fn(key, length) -> Optional[bytes]  # None = miss; length is the value
+                                              # size the requester's plan expects
+                                              # (wire GET needs a sized buffer)
+      exists_fn(key) -> bool
+    """
+
+    def __init__(
+        self,
+        put_fn: Callable[[bytes, bytes], bool],
+        get_fn: Callable[[bytes, int], Optional[bytes]],
+        exists_fn: Callable[[bytes], bool],
+        endpoint: Optional[str] = None,
+    ) -> None:
+        self._put_fn = put_fn
+        self._get_fn = get_fn
+        self._exists_fn = exists_fn
+        self.endpoint = endpoint or default_endpoint()
+        self._ctx = zmq.Context.instance()
+        self._sock = self._ctx.socket(zmq.REP)
+        # Owner restarts must not inherit a peer stuck mid-REQ: a bounded linger
+        # keeps close() prompt, and the forwarder side re-issues on timeout.
+        self._sock.setsockopt(zmq.LINGER, 0)
+        self._sock.bind(self.endpoint)
+        self._stop = threading.Event()
+        self._detach_count = 0
+        self._thread = threading.Thread(target=self._serve, name="t3knic-gm-proxy", daemon=True)
+        self._thread.start()
+        logger.info("[t3knic][gm] wire-owner proxy serving on %s", self.endpoint)
+
+    @property
+    def detach_count(self) -> int:
+        return self._detach_count
+
+    def close(self) -> None:
+        self._stop.set()
+        self._thread.join(timeout=5.0)
+        self._sock.close(0)
+
+    # -- internals ---------------------------------------------------------
+
+    def _serve(self) -> None:
+        poller = zmq.Poller()
+        poller.register(self._sock, zmq.POLLIN)
+        while not self._stop.is_set():
+            if not dict(poller.poll(timeout=100)):
+                continue
+            parts = self._sock.recv_multipart()
+            self._sock.send_multipart(self._handle(parts))
+
+    def _handle(self, parts: list) -> list:
+        try:
+            raw = parts[0]
+            data = parts[1] if len(parts) > 1 else b""
+            if len(raw) > _MAX_FRAME_BYTES:
+                raise ValueError(f"control frame too large ({len(raw)} bytes)")
+            if len(data) > _MAX_DATA_BYTES:
+                raise ValueError(f"data segment too large ({len(data)} bytes)")
+            req = json.loads(raw.decode("utf-8"))
+            op = req.get("op")
+            if op not in _OPS:
+                raise ValueError(f"unknown op {op!r}")
+            if op == "detach":
+                self._detach_count += 1
+                return [_ok()]
+            key = bytes.fromhex(req["key"])
+            if op == "exists":
+                return [_ok(hit=bool(self._exists_fn(key)))]
+            if op == "put":
+                declared = int(req["len"])
+                if declared <= 0:
+                    raise ValueError(f"put len must be positive; got {declared}")
+                if declared != len(data):
+                    raise ValueError(f"put len {declared} != data segment {len(data)} bytes")
+                if not self._put_fn(key, data):
+                    return [_err("put failed")]
+                return [_ok()]
+            # get
+            expected = int(req.get("len") or 0)
+            if expected <= 0:
+                raise ValueError(f"get needs the expected value length; got {expected}")
+            got = self._get_fn(key, expected)
+            if got is None:
+                return [_ok(hit=False)]
+            return [_ok(hit=True, len=len(got)), bytes(got)]
+        except Exception as exc:  # noqa: BLE001 - every fault must become a REP frame
+            # REP sockets require exactly one send per recv; a raised exception
+            # here would wedge the socket state for every later requester.
+            return [_err(f"{type(exc).__name__}: {exc}")]
+
+
+class GlobalMasterForwarder:
+    """Forwarder-side REQ client. One instance per non-owner rank."""
+
+    def __init__(self, endpoint: Optional[str] = None, timeout_ms: int = 60_000) -> None:
+        self.endpoint = endpoint or default_endpoint()
+        self._timeout_ms = timeout_ms
+        self._ctx = zmq.Context.instance()
+        self._sock = None
+        self._connect()
+
+    def _connect(self) -> None:
+        if self._sock is not None:
+            self._sock.close(0)
+        self._sock = self._ctx.socket(zmq.REQ)
+        self._sock.setsockopt(zmq.LINGER, 0)
+        self._sock.connect(self.endpoint)
+
+    def close(self) -> None:
+        if self._sock is not None:
+            self._sock.close(0)
+            self._sock = None
+
+    def request(self, op: str, key: bytes = b"", data: Optional[bytes] = None, slot: int = -1, length: int = 0) -> dict:
+        """One REQ/REP round trip. GET replies carry bytes under rep["data"].
+
+        ``length``: for GET, the value size the local plan expects (the owner
+        needs it to size the wire buffer). PUT derives len from ``data``.
+
+        Raises TimeoutError if the owner is gone. A timed-out REQ socket is
+        poisoned by zmq's strict alternation, so the socket is rebuilt before
+        raising -- the next request starts clean.
+        """
+        frame = {"op": op, "key": key.hex(), "slot": int(slot), "len": len(data) if data is not None else int(length)}
+        parts = [json.dumps(frame).encode("utf-8")]
+        if data is not None:
+            parts.append(bytes(data))
+        self._sock.send_multipart(parts)
+        if not self._sock.poll(self._timeout_ms, zmq.POLLIN):
+            self._connect()
+            raise TimeoutError(f"[t3knic][gm] wire-owner did not answer {op} within {self._timeout_ms} ms")
+        reply = self._sock.recv_multipart()
+        rep = json.loads(reply[0].decode("utf-8"))
+        if not rep.get("ok", False):
+            raise RuntimeError(f"[t3knic][gm] owner rejected {op}: {rep.get('err', 'unknown error')}")
+        if len(reply) > 1:
+            rep["data"] = reply[1]
+        return rep
+
+
+def _ok(**fields) -> bytes:
+    fields["ok"] = True
+    return json.dumps(fields).encode("utf-8")
+
+
+def _err(msg: str) -> bytes:
+    return json.dumps({"ok": False, "err": msg}).encode("utf-8")
diff --git a/lmcache-t3knic/lmcache_t3knic/t3knic_lmcache/intermesh.py b/lmcache-t3knic/lmcache_t3knic/t3knic_lmcache/intermesh.py
