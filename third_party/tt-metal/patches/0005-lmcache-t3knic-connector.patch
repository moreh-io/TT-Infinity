+"""Product lifecycle and TTNN operation provider binding tests."""
+
+from __future__ import annotations
+
+import importlib
+import runpy
+import sys
+from contextlib import nullcontext
+from pathlib import Path
+from types import SimpleNamespace
+
+_BACKEND = Path(__file__).parents[1] / "lmcache_t3knic" / "t3knic_lmcache" / "_kvm_backend.py"
+_CROSS_NODE_LAUNCHER = Path(__file__).parents[1] / "benchmarks" / "run_cross_node_ttft.sh"
+_OPERATIONS = (
+    "MAX_CLIENTS",
+    "gather_tp_shards_to_chip",
+    "scatter_chunk_from_chip",
+    "pack_local_shards",
+    "unpack_local_shards",
+    "reserve_gather_resources",
+    "release_gather_resources",
+)
+
+
+def _product(**overrides):
+    values = {"Client": object(), "Server": object()}
+    values.update(overrides)
+    return SimpleNamespace(**values)
+
+
+def _operations(**overrides):
+    values = {name: object() for name in _OPERATIONS}
+    values.update(overrides)
+    return SimpleNamespace(**values)
+
+
+def _load(monkeypatch, product, operations):
+    def fake_import(name):
+        if name == "kvcache_manager":
+            if isinstance(product, BaseException):
+                raise product
+            return product
+        if name == "ttnn.kvcache_manager":
+            if isinstance(operations, BaseException):
+                raise operations
+            return operations
+        raise AssertionError(f"unexpected import {name}")
+
+    monkeypatch.setattr(importlib, "import_module", fake_import)
+    return runpy.run_path(str(_BACKEND))
+
+
+def test_binds_product_lifecycle_and_ttnn_operations_separately(monkeypatch) -> None:
+    product = _product()
+    operations = _operations()
+
+    namespace = _load(monkeypatch, product, operations)
+
+    assert namespace["kvcache_manager"] is product
+    assert namespace["kvcache_operations"] is operations
+    assert namespace["__all__"] == ["kvcache_manager", "kvcache_operations"]
+
+
+def test_rejects_a_lifecycle_package_without_server(monkeypatch, expect_error) -> None:
