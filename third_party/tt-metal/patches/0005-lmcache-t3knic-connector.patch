+++ b/lmcache-t3knic/lmcache_t3knic/t3knic_lmcache/_broadcast_patch.py
@@ -0,0 +1,215 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Runtime monkey-patch for ``LMCacheEngine._broadcast_or_receive_memory_objs``.
+
+LMCache's MLA optimization sets ``save_only_first_rank=True`` by default,
+which routes only the first TP rank through the remote KV store and then
+broadcasts the loaded data from rank 0 to the other ranks. The stock
+broadcast body reads ``memory_obj.raw_tensor`` on rank 0 and ships it
+across; on the t3knic flow that tensor holds placeholder bytes (the
+real KV data travels fabric-direct from each chip's kvcache_server),
+so the broadcast would corrupt every non-zero rank silently.
+
+This module installs a t3knic-aware replacement. Rank 0 transmits only
+``(start, end, metadata_dict, key_str)`` and the other ranks register a
+pending-get entry on the shared :class:`TTKVCacheClient` and let
+``TTGPUConnector.to_gpu`` issue an independent fabric_read on its own
+chip. The patched function falls through to the stock implementation
+whenever ``self.gpu_connector`` is not a :class:`TTGPUConnector`, so
+every non-t3knic flow (plain CUDA / xpu / hpu / the existing P/D fanout
+in this repo) is unaffected.
+
+The patch is applied at package-import time by
+:mod:`lmcache_t3knic.t3knic_lmcache.__init__`. It is idempotent.
+
+Without this patch, MLA + TP>1 on the t3knic backend would require the
+user to set ``extra_config['save_only_first_rank']=False`` manually
+(the legacy work-around). With this patch in place, the LMCache
+default works safely, and :func:`validate_t3knic_config`'s premise 7
+relaxes to a no-op.
+"""
+
+from __future__ import annotations
+
+from typing import Any, List, Optional
+
+from lmcache.logging import init_logger
+
+logger = init_logger(__name__)
+
+
+_PATCH_MARKER = "_t3knic_broadcast_patch"
+
+
+class _BroadcastedKey:
+    """Stand-in for ``CacheEngineKey`` on non-zero ranks.
+
+    The t3knic broadcast patch only transmits the key's string form to
+    other ranks; we wrap that string here so the consumers
+    (``TTGPUConnector.to_gpu`` / ``TTRemoteConnector``) can keep
+    calling ``.to_string()`` without caring whether the object is a
+    real ``CacheEngineKey`` or a broadcast-side reconstruction.
+
+    The real ``CacheEngineKey`` is recoverable from the string via
+    ``CacheEngineKey.from_string`` if richer behaviour is ever needed.
+    """
+
+    __slots__ = ("_s",)
+
+    def __init__(self, key_str: str) -> None:
+        self._s = key_str
+
+    def to_string(self) -> str:
+        return self._s
+
+    def __repr__(self) -> str:
+        return f"_BroadcastedKey({self._s!r})"
+
+
+def install_t3knic_broadcast_patch() -> None:
+    """Replace ``LMCacheEngine._broadcast_or_receive_memory_objs`` with
+    the t3knic-aware variant.
+
+    Idempotent: a second call is a no-op. Silently skipped when LMCache
+    or torch is unavailable -- the patch only matters in environments
+    where LMCache actually runs.
+    """
+    try:
+        import lmcache.v1.cache_engine as _ce
+        from lmcache.v1.memory_management import (
+            MemoryObjMetadata,
+            TensorMemoryObj,
+        )
+        import torch
+    except ImportError:
+        return
+
+    existing = getattr(_ce.LMCacheEngine, "_broadcast_or_receive_memory_objs", None)
+    if existing is not None and getattr(existing, _PATCH_MARKER, False):
+        return
+
+    _orig = existing
+
+    def _patched(
+        self: Any,
+        reordered_chunks: List[Any],
+        ret_mask: Any,
+    ) -> None:
+        # Lazy import to avoid a circular import at module load time:
+        # this file is loaded during the package's __init__.py and
+        # tt_gpu_connector is part of the same package.
+        try:
+            from lmcache_t3knic.t3knic_lmcache.tt_gpu_connector import (
+                TTGPUConnector,
+            )
+        except ImportError:
+            if _orig is not None:
+                return _orig(self, reordered_chunks, ret_mask)
+            return None
+
+        if not isinstance(getattr(self, "gpu_connector", None), TTGPUConnector):
+            if _orig is not None:
+                return _orig(self, reordered_chunks, ret_mask)
+            return None
+
+        if self.metadata.is_first_rank():
+            _send_t3knic_chunks(self, reordered_chunks)
+            return None
+
+        _receive_t3knic_chunks(
+            self,
+            reordered_chunks,
+            ret_mask,
+            MemoryObjMetadata,
+            TensorMemoryObj,
+            torch,
+        )
+        return None
+
+    setattr(_patched, _PATCH_MARKER, True)
+    _patched._t3knic_orig = _orig  # type: ignore[attr-defined]
+    _ce.LMCacheEngine._broadcast_or_receive_memory_objs = _patched
+
+
+def t3knic_broadcast_patch_installed() -> bool:
+    """Return ``True`` iff :func:`install_t3knic_broadcast_patch` has
+    replaced ``LMCacheEngine._broadcast_or_receive_memory_objs``.
+
+    Returns ``False`` when LMCache is not importable or the method has
+    not been patched yet.
+    """
+    try:
+        import lmcache.v1.cache_engine as _ce
+    except ImportError:
+        return False
+    fn = getattr(_ce.LMCacheEngine, "_broadcast_or_receive_memory_objs", None)
+    return bool(getattr(fn, _PATCH_MARKER, False))
+
+
+# ---------------------------------------------------------------------------
+# Send / receive helpers (split out so the patched method body stays small
+# and individually testable).
+# ---------------------------------------------------------------------------
+
+
+def _send_t3knic_chunks(engine: Any, reordered_chunks: List[Any]) -> None:
+    """Rank-0 path: ship ``(start, end, metadata_dict, key_str)`` for
+    every chunk. No tensor broadcast -- other ranks fabric_read.
+    """
+    chunk_count = len(reordered_chunks)
+    engine.broadcast_object_fn(chunk_count, engine.metadata.first_rank)
+    for key, memory_obj, start, end in reordered_chunks:
+        metadata_dict = memory_obj.metadata.to_dict()
+        payload = (start, end, metadata_dict, key.to_string())
+        engine.broadcast_object_fn(payload, engine.metadata.first_rank)
+
+
+def _receive_t3knic_chunks(
+    engine: Any,
+    reordered_chunks: List[Any],
+    ret_mask: Any,
+    metadata_cls: Any,
+    memory_obj_cls: Any,
+    torch_mod: Any,
+) -> None:
+    """Non-zero rank path: receive payloads, register pending-get
+    entries on the shared TTKVCacheClient, append placeholder
+    ``(None, memory_obj, start, end)`` tuples to ``reordered_chunks``
+    so the upstream ``batched_to_gpu`` call can drive the fabric_read.
+    """
+    chunk_count = engine.broadcast_object_fn(None, engine.metadata.first_rank)
+    if chunk_count is None:
+        logger.warning(
+            "t3knic broadcast patch: rank=%d received None chunk_count; " "skipping",
+            engine.metadata.worker_id,
+        )
+        return
+
+    client = engine.gpu_connector.client
+    for _ in range(chunk_count):
+        payload = engine.broadcast_object_fn(None, engine.metadata.first_rank)
+        if payload is None:
+            logger.warning(
+                "t3knic broadcast patch: rank=%d received None payload; " "stopping early",
+                engine.metadata.worker_id,
+            )
+            break
+        start, end, metadata_dict, key_str = payload
+        ret_mask[start:end] = True
+
+        metadata = metadata_cls.from_dict(metadata_dict)
+        # Minimal raw_data: LMCache requires raw_data to construct the
+        # MemoryObj, but on TT we never read these bytes. A 1-byte uint8
+        # tensor would be enough; we size it to the metadata length so
+        # any defensive sanity check downstream (e.g. byte_array length)
+        # still passes.
+        raw_data = torch_mod.empty(
+            torch_mod.Size([max(metadata.get_size(), 1)]),
+            dtype=torch_mod.uint8,
+        )
+        memory_obj = memory_obj_cls(
+            raw_data=raw_data,
+            metadata=metadata,
+            parent_allocator=None,
+        )
+        client.record_pending_get(memory_obj, _BroadcastedKey(key_str))
+        reordered_chunks.append((None, memory_obj, start, end))
