@@ -0,0 +1,1648 @@
+# SPDX-License-Identifier: Apache-2.0
+"""``KVConnectorBase_V1`` facade for the t3knic LMCache backend.
+
+This is the single vllm-facing connector for the t3knic flow. It wraps one
+``LMCacheConnectorV1Dynamic`` child with a :class:`TTGPUConnector` injected
+through LMCache's TT connector context.
+
+One LMCache child owns either the selected gather chip or the per-chip
+wire clients. The t3knic flow has no virtual TP fanout or per-rank metadata
+aggregation.
+
+Lifecycle:
+  1. vllm constructs ``T3knicKVConnector(vllm_config, role, kv_cache_config)``.
+     Both roles build the LMCache child immediately. The WORKER's
+     :class:`TTGPUConnector` initially has no live Client.
+  2. The lmcache-t3knic worker calls :meth:`attach_mesh_device` from
+     ``init_device`` right after the MeshDevice is opened. We parse the
+     ``VLLM_TT_T3KNIC_URL`` env var, open the :class:`TTKVCacheClient`
+     through :func:`install_t3knic_backend`, and inject it into the existing
+     GPU connector.
+  3. Every vllm lifecycle hook (``bind_connector_metadata``,
+     ``start_load_kv``, ``save_kv_layer``, ``wait_for_save``, ...)
+     forwards to the single child.
+
+The hook is deliberately named ``attach_mesh_device`` because its mesh,
+NIC, and Server arguments differ from connector metadata hooks invoked by
+the model runner at other lifecycle points. The distinct name lets the
+worker dispatch via ``hasattr`` without invoking an incompatible hook.
+
+If a lifecycle method runs on a WORKER before
+:meth:`attach_mesh_device` has been called we raise an actionable
+RuntimeError. Silent fallback would hide the wiring bug -- the worker
+must call attach_mesh_device before the first forward pass.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import signal
+import time
+from collections import OrderedDict
+from typing import TYPE_CHECKING, Any, Iterable, List, Optional
+
+import torch
+
+from vllm.config import VllmConfig
+from vllm.distributed.kv_transfer.kv_connector.v1.base import (
+    KVConnectorBase_V1,
+    KVConnectorMetadata,
+    KVConnectorRole,
+)
+from vllm.logger import init_logger
+
+# The package-level hook installs LMCache integration. The context variable
+# injects this TT bridge while the LMCache child is being constructed.
+from lmcache_t3knic import apply as apply_lmcache_integration
+from lmcache_t3knic.factory import tt_npu_connector_ctx
+from lmcache_t3knic.t3knic_lmcache.config_guard import T3knicConfigError
+from lmcache_t3knic.t3knic_lmcache.tt_connector_adapter import clear_kvcache_client
+from lmcache_t3knic.t3knic_lmcache.tt_gpu_connector import TTGPUConnector
+from lmcache_t3knic.t3knic_lmcache.tt_kvcache_client import TTKVCacheClient
+from lmcache_t3knic.t3knic_lmcache.worker_hook import install_t3knic_backend
+
+if TYPE_CHECKING:
+    from vllm.attention.backends.abstract import AttentionMetadata
+    from vllm.forward_context import ForwardContext
+    from vllm.v1.core.kv_cache_manager import KVCacheBlocks
+    from vllm.v1.core.sched.output import SchedulerOutput
+    from vllm.v1.request import Request
+
+
+logger = init_logger(__name__)
+
+
+_DEFAULT_T3KNIC_URL = "t3knic://localhost:0?mode=intranode"
+
+
+class T3knicKVConnector(KVConnectorBase_V1):
+    """Single-child KVConnector for the t3knic standalone remote KV pool."""
+
+    # Capability flags consumed by the shared worker runtime via getattr:
+    # - KV slice/fill IO compiles request-shaped device programs on demand, so
+    #   the post-warmup program-cache-miss hard guard must stay off while this
+    #   connector is attached (warmup cannot cover request-dependent shapes).
+    # - The runtime's prefetch-KV-load machinery needs connector hooks we do
+    #   not implement (take_h2d_fences, D2H batch pairing); declare it
+    #   unsupported so a bound TransferDescriptor does not enable it (its
+    #   async-scheduling guard would otherwise hard-raise on the first hit).
+    kv_io_compiles_programs_on_demand = True
+    supports_prefetch_kv_load = False
+
+    def __init__(
+        self,
+        vllm_config: VllmConfig,
+        role: KVConnectorRole,
+        kv_cache_config: Optional[Any] = None,
+    ) -> None:
+        super().__init__(vllm_config=vllm_config, role=role, kv_cache_config=kv_cache_config)
+        # LMCache CPU shim + engine_id remap. Idempotent.
+        apply_lmcache_integration()
+        self._vllm_config = vllm_config
+        self._role = role
+        self._kv_cache_config = kv_cache_config
+        self._kv_spec = self._resolve_kv_spec(vllm_config, role, kv_cache_config)
+
+        self._child: Optional[Any] = None  # LMCacheConnectorV1Dynamic
+        self._tt_gpu_connector: Optional[TTGPUConnector] = None
+        self._tt_kvcache_client: Optional[TTKVCacheClient] = None
+
+        # Cache-spec bind state (see bind_tt_cache). The descriptor is kept
+        # under a t3knic-private name on purpose: generic names like
+        # transfer_policy/_stage_connectors would be picked up by getattr
+        # probes in the scheduler mixin / step machinery and enable paths we
+        # do not implement.
+        self._bound_transfer_descriptor: Optional[Any] = None
+        self._bound_handle_groups: Optional[tuple] = None
+
+        # Evict-to-wire store-mode gate:
+        #   eager (default) -- current behavior, no eviction scan.
+        #   observe         -- scheduler-side read-only LRU free-queue scan that
+        #                      logs evict-imminent cached blocks. No
+        #                      pin, no meta wrap; eager store still ON.
+        #   lazy            -- additionally touch()-pin the selected
+        #                      evict-imminent blocks and wrap the child meta so
+        #                      the pinned block list rides to the worker
+        #                      (T3knicOffloadMetadata). Release pins after the
+        #                      configured pipeline delay and store the selected
+        #                      blocks over the wire. Requires vLLM prefix caching ON.
+        # Both observe|lazy need prefix caching ON (else no block_hash on free
+        # blocks -> zero candidates). lazy additionally needs the serialized
+        # single-batch + dp==1 contract for the blind-free pin protocol.
+        # "auto" (the default) picks the store mode from kv_role:
+        #   kv_both  (single instance, non-P/D in-engine reuse) -> lazy
+        #            (evict-driven wire store = bandwidth save for our "single mode":
+        #             device KV + evict->kvcache_manager + retrieve-on-reuse).
+        #   kv_producer / kv_consumer (true P/D disagg) -> eager (the peer decode
+        #            instance needs the KV immediately; lazy cannot serve P/D).
+        # Explicit T3KNIC_STORE_MODE=eager|lazy|observe overrides auto.
+        _raw_mode = (os.environ.get("T3KNIC_STORE_MODE", "auto") or "auto").strip().lower()
+        _kv_role = None
+        try:
+            _ktc = getattr(vllm_config, "kv_transfer_config", None)
+            _kv_role = getattr(_ktc, "kv_role", None) if _ktc is not None else None
+        except Exception:  # noqa: BLE001
+            _kv_role = None
+        try:
+            _pp_size = int(getattr(vllm_config.parallel_config, "pipeline_parallel_size", 1) or 1)
+        except Exception:  # noqa: BLE001
+            _pp_size = 1
+        # vLLM prefix-caching state. The lazy evict-driven store is a NO-OP without
+        # it: cache_full_blocks is gated on enable_caching, so no free block ever
+        # gets a block_hash and the eviction scan finds zero candidates. So auto
+        # must NOT pick lazy when prefix caching is off, and an explicit lazy there
+        # is a footgun worth a loud warning.
+        try:
+            _pc_on = bool(getattr(getattr(vllm_config, "cache_config", None), "enable_prefix_caching", False))
+        except Exception:  # noqa: BLE001
+            _pc_on = False
+        if _raw_mode == "auto":
+            # kv_both (single-instance reuse) + PP==1 + prefix caching ON -> lazy
+            # (evict-driven wire store). Otherwise eager: producer/consumer (P/D)
+            # need the KV immediately; PP>1 splits KV per rank (see the R4 gate
+            # below); and prefix-caching-OFF makes lazy a silent no-op, so eager is
+            # the only mode that actually stores. This is what makes the "LMCache +
+            # prefix caching off" config auto-resolve to EAGER (store-after-prefill)
+            # rather than a broken lazy no-op.
+            if _kv_role == "kv_both" and _pp_size == 1 and _pc_on:
+                self._store_mode = "lazy"
+            else:
+                self._store_mode = "eager"
+            self._store_mode_auto = True
+        else:
+            self._store_mode = _raw_mode
+            self._store_mode_auto = False
+        logger.warning(
+            "[t3knic][offload] store_mode=%s%s (T3KNIC_STORE_MODE=%s, kv_role=%s, prefix_caching=%s, role=%s)",
+            self._store_mode,
+            " [auto-resolved]" if self._store_mode_auto else "",
+            _raw_mode,
+            _kv_role,
+            "on" if _pc_on else "off",
+            getattr(role, "name", role),
+        )
+        if self._store_mode == "lazy" and not _pc_on:
+            # Explicit T3KNIC_STORE_MODE=lazy with prefix caching off: not a
+            # correctness bug (reuse just recomputes), but the store will never
+            # fire. Warn loudly so it is not mistaken for a working config.
+            logger.warning(
+                "[t3knic][offload] store_mode=lazy but vLLM prefix caching is OFF -- the "
+                "evict-driven store has no block_hash to key on and will be a NO-OP (no "
+                "wire stores; reuse recomputes). Enable prefix caching for lazy, or use "
+                "T3KNIC_STORE_MODE=eager to store after prefill."
+            )
+        self._offload_observer: Optional[Any] = None
+        # lazy => wrap the child meta + carry the evict-imminent block list
+        # (store_specs) to the worker, and touch()-pin the resolved
+        # blocks so the scheduler can't reallocate them before the worker's wire
+        # store reads them. The pins are released on a PIPELINE DELAY
+        # (T3KNIC_PIN_FREE_DELAY, default 2 == async max_concurrent_batches): a
+        # set pinned at scan tick N is freed at tick N+delay, by which point the
+        # execute that read it has retired -- safe under async scheduling WITHOUT
+        # a worker->scheduler ack channel. Default 2 also covers sync (mcb=1).
+        self._wrap_enabled = self._store_mode == "lazy"
+        # Lazy evict->wire is valid only for
+        # pipeline_parallel_size==1 (world_size==1, single wire owner). Under PP>1
+        # the KV layers are split per rank (store_block would PUT only its stage's
+        # layers under a content key shared across ranks -> partial/overwriting
+        # chunk) and per-rank worker_id keys diverge from the scheduler's
+        # re-derived keys. auto already degraded to eager under PP>1; an EXPLICIT
+        # T3KNIC_STORE_MODE=lazy here is a misconfig -> fail loud + early (both
+        # roles). Proper PP support requires per-worker key re-derivation,
+        # per-stage layer store/reassembly, and pinning.
+        if self._wrap_enabled and _pp_size > 1:
+            raise T3knicConfigError(
+                "T3KNIC_STORE_MODE=lazy (evict->wire) is validated only for "
+                f"pipeline_parallel_size==1; got {_pp_size}. Under PP the KV cache "
+                "is split per rank and per-rank keys diverge, so the lazy store "
+                "would save partial/mis-keyed KV. Use eager (or observe) with PP, "
+                "or run PP=1 for lazy."
+            )
+        # Pinning is off by default. The lazy store runs synchronously in wait_for_save on the
+        # worker's forward thread, so cq0 orders forward(N), store(N), and forward(N+1). A later
+        # forward therefore cannot overwrite a block while the store reads it. Pinning remains
+        # opt-in for a future cross-request concurrency model, where that same-queue ordering may
+        # no longer hold.
+        self._pin_enabled = self._wrap_enabled and (
+            os.environ.get("T3KNIC_LAZY_PIN", "0").strip().lower() in ("1", "true", "yes", "on")
+        )
+        self._pin_free_delay = int(os.environ.get("T3KNIC_PIN_FREE_DELAY", "2") or 2)
+        # Map BlockHash(bytes) to CacheEngineKey.to_string().
+        # Populated at cache time (update_state_after_alloc) by re-deriving the
+        # LMCache chunk key via the child's live token_database, keyed by the
+        # vLLM per-block BlockHash. The eviction scan (which sees a block's
+        # block_hash) looks blocks up here to recover the exact key the reuse
+        # path uses. Content-addressed -> stale entry = miss, not corruption.
+        # Bounded LRU (>= num_gpu_blocks). Scheduler-role only.
+        self._offload_side_table: "OrderedDict[bytes, str]" = OrderedDict()
+        self._side_table_cap = int(os.environ.get("T3KNIC_SIDE_TABLE_CAP", "4096") or 4096)
+        self._offload_td: Optional[Any] = None  # cached ChunkedTokenDatabase
+        self._side_table_parity_ok: Optional[bool] = None  # one-shot metadata parity check
+        # Fail safe: the lazy evict->wire store is only
+        # correct in the validated envelope (single chip world_size==1/worker_id==0
+        # AND chunk_size==block_size, so block i <-> chunk i <-> block_hashes[i]).
+        # Outside it the re-derived key would silently mismatch the reuse key (lost
+        # reuse) or a block would map to the wrong chunk key. When the one-shot
+        # check below detects an unsupported config we set this flag and
+        # build_connector_meta SUPPRESSES the store entirely (lazy becomes a
+        # no-op -> reuse just recomputes = correct, only no speedup) rather than
+        # silently storing wrong-addressed/wrong-keyed KV. Loud ERROR once.
+        self._lazy_store_disabled = False
+        # Worker-side dedup of the evict-driven store. store_specs
+        # re-lists a block for as long as it lingers near eviction; the key is a
+        # content address (== CacheEngineKey), so once PUT the server has that
+        # content -- skip redundant re-PUTs and keep cumulative PUTs bounded.
+        # A stale skip for content the server later evicts just falls back to
+        # recompute on reuse.
+        self._lazy_stored_keys: "OrderedDict[str, bool]" = OrderedDict()
+        self._lazy_stored_cap = int(os.environ.get("T3KNIC_LAZY_STORED_CAP", "8192") or 8192)
+        self._lazy_store_calls = 0
+
+        # SCHEDULER role: no hardware, child is buildable immediately.
+        if role == KVConnectorRole.SCHEDULER:
+            self._child = self._build_lmcache_child()
+            logger.info("T3knicKVConnector: built scheduler-side child")
+            logger.warning("[t3knic][offload] SCHEDULER __init__ store_mode=%s", self._store_mode)
+            if self._store_mode in ("observe", "lazy"):
+                try:
+                    from lmcache_t3knic.t3knic_lmcache.t3knic_offload_manager import (
+                        T3knicOffloadObserver,
+                    )
+
+                    max_batched = int(getattr(vllm_config.scheduler_config, "max_num_batched_tokens", 0) or 0)
+                    self._offload_observer = T3knicOffloadObserver(
+                        kv_cache_config,
+                        max_batched,
+                        pin_enabled=self._pin_enabled,
+                        pin_free_delay=self._pin_free_delay,
+                    )
+                    logger.warning(
+                        "[t3knic][offload] store_mode=%s -> observer enabled "
+                        "(wrap=%s pin=%s). lazy: eager store OFF + evict-driven "
+                        "wire store ON; observe: read-only scan (eager ON).",
+                        self._store_mode,
+                        self._wrap_enabled,
+                        self._pin_enabled,
+                    )
+                except Exception as e:  # noqa: BLE001
+                    logger.warning("[t3knic][offload] observer init failed: %s", e)
+
+        # WORKER role: build the child NOW (not in attach_mesh_device) inside
+        # ``tt_npu_connector_ctx`` so LMCache's patched ``CreateGPUConnector``
+        # picks up our TT bridge and stamps it onto engine.gpu_connector. This
+        # avoids depending on ``attach_mesh_device`` running before the LMCache
+        # engine is built --
+        # vLLM v1's worker lifecycle was found to bypass attach in some paths,
+        # leaving the bridge un-injected and falling back to a CPU connector.
+        # The TT client is not available yet (it needs the mesh + nic submesh
+        # the worker hands us later), so we construct ``TTGPUConnector`` with
+        # ``client=None`` here and :meth:`attach_mesh_device` fills it in via
+        # ``set_client`` once ``install_t3knic_backend`` builds the persistent
+        # client. IO methods on TTGPUConnector are not exercised before that
+        # injection completes (lifecycle: init -> attach -> register -> forward).
+        if role == KVConnectorRole.WORKER:
+            spec = self._kv_spec
+            self._tt_gpu_connector = TTGPUConnector(
+                client=None,
+                num_layers=int(spec["num_layers"]),
+                kv_dim=1 if vllm_config.model_config.use_mla else 2,
+                hidden_dim_size=int(spec["num_kv_heads_total"]) * int(spec["head_size"]),
+                dtype=spec["kv_dtype"] if isinstance(spec.get("kv_dtype"), torch.dtype) else torch.bfloat16,
+                block_size=int(spec["block_size"]),
+            )
+            with tt_npu_connector_ctx(self._tt_gpu_connector):
+                self._child = self._build_lmcache_child()
+            logger.info(
+                "[t3knic] WORKER __init__: built child + TTGPUConnector(client=None) "
+                "under tt_npu_connector_ctx (role=%s)",
+                role,
+            )
+
+    # ------------------------------------------------------------------
+    # Init helpers
+    # ------------------------------------------------------------------
+
+    @staticmethod
+    def _resolve_kv_spec(
+        vllm_config: VllmConfig,
+        role: KVConnectorRole,
+        kv_cache_config: Optional[Any],
+    ) -> dict:
+        """Extract num_layers / block_size / dtype etc. from vllm config.
+
+        WORKER role requires the four shape fields; SCHEDULER tolerates
+        missing ones since it never touches the GPU bridge. This flow has no
+        fanout-divisibility requirement.
+        """
+        model_config = vllm_config.model_config
+        parallel_config = vllm_config.parallel_config
+        try:
+            num_kv_heads_total = model_config.get_num_kv_heads(parallel_config)
+            head_size = model_config.get_head_size()
+            num_layers = model_config.get_num_layers_by_block_type(parallel_config, "attention")
+        except Exception:  # noqa: BLE001
+            num_kv_heads_total = None
+            head_size = None
+            num_layers = None
+
+        block_size = None
+        kv_dtype = None
+        page_size_padded = None
+        if kv_cache_config is not None:
+            for group in getattr(kv_cache_config, "kv_cache_groups", []) or []:
+                spec = getattr(group, "kv_cache_spec", None)
+                if spec is None:
+                    continue
+                # A UniformTypeKVCacheSpecs wraps the per-layer specs and reports the GROUP's total
+                # page size, which is num_layers times too large. Unwrap to one representative layer
+                # Use one representative per-layer attention spec.
+                inner = getattr(spec, "kv_cache_specs", None)
+                if inner:
+                    spec = next(iter(inner.values()))
+                block_size = getattr(spec, "block_size", None)
+                kv_dtype = getattr(spec, "dtype", None)
+                # Physical per-device bytes for one block's K+V. Taken from the spec rather than
+                # derived from num_kv_heads // tp_size: qwen3 replicates KV heads (KV_REPEAT_COEF),
+                # so that division is right at TP=4 by coincidence and yields 0 at TP=8.
+                page_size_padded = getattr(spec, "page_size_padded", None)
+                if num_kv_heads_total is None:
+                    num_kv_heads_total = getattr(spec, "num_kv_heads", None)
+                if head_size is None:
+                    head_size = getattr(spec, "head_size", None)
+                break
+
+        if role == KVConnectorRole.WORKER:
+            required = {
+                "num_kv_heads_total": num_kv_heads_total,
+                "head_size": head_size,
+                "num_layers": num_layers,
+                "block_size": block_size,
+            }
+            missing = [k for k, v in required.items() if not v or v <= 0]
+            if missing:
+                raise ValueError(
+                    f"T3knicKVConnector(WORKER): cannot resolve KV spec, "
+                    f"missing or non-positive: {missing}. Ensure vllm_config "
+                    "carries a model_config and kv_cache_config with a populated "
+                    "kv_cache_spec."
+                )
+
+        return {
+            "num_kv_heads_total": num_kv_heads_total,
+            "head_size": head_size,
+            "num_layers": num_layers,
+            "block_size": block_size,
+            "kv_dtype": kv_dtype,
+            "page_size_padded": page_size_padded,
+        }
+
+    @staticmethod
+    def _resolve_url() -> str:
+        """Read the t3knic URL from ``VLLM_TT_T3KNIC_URL`` env var."""
+        return os.environ.get("VLLM_TT_T3KNIC_URL", _DEFAULT_T3KNIC_URL)
+
+    def _build_lmcache_child(self) -> Any:
+        """Construct the wrapped ``LMCacheConnectorV1Dynamic``.
+
+        Imported lazily so the LMCache dependency stays optional at
+        module load time. Callers (WORKER path) should wrap this call
+        in ``tt_npu_connector_ctx`` so LMCache picks up our TT bridge.
+        """
+        from lmcache.integration.vllm.lmcache_connector_v1 import (
+            LMCacheConnectorV1Dynamic,
+        )
+
+        return LMCacheConnectorV1Dynamic(self._vllm_config, self._role, self._kv_cache_config)
+
+    # ------------------------------------------------------------------
+    # WORKER setup
+    # ------------------------------------------------------------------
+
+    def _ensure_page_size_padded(self, tp_size: int) -> None:
+        """Fill kv_spec["page_size_padded"] when the model's KV spec does not carry it.
+
+        Some model integrations publish the TT physical block size as
+        ``page_size_padded`` on their KVCacheSpec; stock vLLM specs (tt_transformers models under
+        vllm-tt-plugin) only have ``page_size_bytes`` in the torch dtype. The wire blob needs the
+        per-chip TT bytes of one block's K+V: 2 x (kv_heads / tp) x block x head_size x bytes/elem,
+        where the TT KV cache is bfloat8_b (17/16 B per element, tile exponent padding) unless
+        T3KNIC_TT_KV_ELEM_BYTES overrides it. The 30B-A3B reference is 34816 B (1 head/chip, block
+        128, head 128).
+        """
+        ks = self._kv_spec
+        if ks.get("page_size_padded"):
+            return
+        heads_total = ks.get("num_kv_heads_total")
+        block = ks.get("block_size")
+        head = ks.get("head_size")
+        if not (heads_total and block and head and tp_size):
+            return
+        heads_per_chip = max(1, int(heads_total) // int(tp_size))
+        elem_bytes = float(os.environ.get("T3KNIC_TT_KV_ELEM_BYTES", str(17 / 16)))
+        page = int(round(2 * heads_per_chip * int(block) * int(head) * elem_bytes))
+        ks["page_size_padded"] = page
+        logger.info(
+            "[t3knic] kv spec has no page_size_padded (stock vLLM spec); derived %d B/chip/layer/block "
+            "from kv_heads=%s tp=%s block=%s head=%s elem_bytes=%.4f",
+            page,
+            heads_total,
+            tp_size,
+            block,
+            head,
+            elem_bytes,
+        )
+
+    def attach_mesh_device(
+        self,
+        mesh_device: object,
+        nic_submesh: object = None,
+        paired_server: object = None,
+        dp_size: int = 1,
+        tp_size: int = 1,
+        dp_axis: int = 0,
+        tp_axis: int = 1,
+        blocks_per_dp: object = None,
+        parent_mesh: object = None,
+        wire_stage_coord: object = None,
+        wire_mode: object = None,
+    ) -> None:
+        """Worker handshake: spin up the TT bridge and build the child.
+
+        Must run after the worker has opened its ``MeshDevice`` and
+        before vllm starts driving the connector through lifecycle
+        methods. Idempotent: re-invoking after the child is built is a
+        no-op.
+
+        Args:
+            mesh_device: vLLM-TT MeshDevice (sender submesh) the worker owns.
+                Forwarded to the TTKVCacheClient constructor.
+            nic_submesh: The co-launch nic submesh hosting the paired
+                kvcache_server Server. Forwarded so the TTKVCacheClient
+                can construct its ttnn Client(sender, nic). May be
+                ``None`` for external-mode setups.
+
+        Raises:
+            RuntimeError: If the worker child was somehow built without
+                a TT bridge in place (a programming error -- this hook
+                is the only path that should produce the WORKER child).
+        """
+        if self._role != KVConnectorRole.WORKER:
+            return
+        # New lifecycle: __init__ has already built self._child and
+        # self._tt_gpu_connector (with client=None). This call only opens the
+        # client against mesh + nic and lazy-injects it via set_client. So the
+        # idempotency key is the live client, not the child.
+        if self._tt_kvcache_client is not None:
+            logger.info("T3knicKVConnector.attach_mesh_device: client already attached, " "ignoring repeated call")
+            return
+        assert self._child is not None, (
+            "T3knicKVConnector: worker child must have been built in __init__ " "before attach_mesh_device runs."
+        )
+
+        from lmcache.integration.vllm.utils import lmcache_get_or_create_config
+
+        # 1) Mutate the LMCache singleton config to wire up t3knic plugin
+        #    + open the TTKVCacheClient.
+        url = self._resolve_url()
+        lmcache_config = lmcache_get_or_create_config()
+        # Thread the KV geometry + LMCache chunk_size down so the client can
+        # build the coalesce group plan and deterministically pre-allocate its
+        # wire-staging buffer pool at open() instead of discovering the plan
+        # lazily on the first put.
+        chunk_size = getattr(lmcache_config, "chunk_size", None)
+        # install_t3knic_backend opens the client only after all geometry is known.
+        self._ensure_page_size_padded(tp_size)
+        self._tt_kvcache_client = install_t3knic_backend(
+            lmcache_config=lmcache_config,
+            lmcache_metadata=None,  # metadata-aware validation skipped here
+            mesh_device=mesh_device,
+            kvcache_url=url,
+            nic_submesh=nic_submesh,
+            paired_server=paired_server,
+            parent_mesh=parent_mesh,
+            wire_stage_coord=wire_stage_coord,
+            wire_mode=wire_mode,
+            kv_spec=self._kv_spec,
+            chunk_size=chunk_size,
+        )
+
+        # 2) Inject the persistent client into the TTGPUConnector that
+        #    __init__ already constructed (with client=None) and pushed onto
+        #    the LMCache child via tt_npu_connector_ctx. The bridge is already
+        #    bound to engine.gpu_connector at this point; we only need to fill
+        #    in the live client now that mesh + nic are available.
+        assert self._tt_gpu_connector is not None, (
+            "T3knicKVConnector: TTGPUConnector should have been built in "
+            "__init__ for WORKER role before attach_mesh_device runs."
+        )
+        self._tt_gpu_connector.set_client(self._tt_kvcache_client)
+        # Multi-device (DP/TP) geometry for the paged tensor path. No-op for the
+        # single-device flow (dp_size==tp_size==1).
+        self._tt_gpu_connector.set_mesh_geometry(
+            dp_size=dp_size,
+            tp_size=tp_size,
+            dp_axis=dp_axis,
+            tp_axis=tp_axis,
+            blocks_per_dp=blocks_per_dp,
+            mesh_device=mesh_device,
+        )
+
+        # Belt-and-suspenders: LMCacheEngineBuilder caches engines by the
+        # static key ENGINE_NAME="vllm-instance", so if the SCHEDULER role ran
+        # _build_lmcache_child first (no tt_npu_connector_ctx), the WORKER
+        # __init__'s ctx push hits a cached engine and our TTGPUConnector
+        # never makes it onto engine.gpu_connector. Force-stamp it now that
+        # we have a live client; this is idempotent if the ctx push already
+        # succeeded.
+        impl = getattr(self._child, "_lmcache_engine", None)
+        engine = getattr(impl, "lmcache_engine", None) if impl is not None else None
+        if engine is not None:
+            old_gc = type(engine.gpu_connector).__name__
+            engine.gpu_connector = self._tt_gpu_connector
+            logger.info(
+                "[t3knic] attach_mesh_device: forced engine.gpu_connector %s -> TTGPUConnector",
+                old_gc,
+            )
+        else:
+            logger.warning(
+                "[t3knic] attach_mesh_device: cannot force-patch engine (impl=%r, engine=%r)",
+                impl,
+                engine,
+            )
+
+        spec = self._kv_spec
+        logger.info(
+            "[t3knic] attach complete (url=%s, layers=%d, block_size=%d, role=%s)",
+            url,
+            spec["num_layers"],
+            spec["block_size"],
+            self._role,
+        )
+        # Now that the client is live, wire up SIGUSR1 + /stats HTTP hooks
+        # (gated by T3KNIC_PROFILE env var). Done here (not __init__) so the
+        # hooks install in the EngineCore process where put_layer / get_layer_raw
+        # actually run.
+        self._install_profiling_hooks()
+
+    # ------------------------------------------------------------------
+    # Internal: guarded child access
+    # ------------------------------------------------------------------
+
+    def _require_child(self, op: str) -> Any:
+        if self._child is None:
+            raise RuntimeError(
+                f"T3knicKVConnector.{op}: child connector not built. "
+                "Worker must call attach_mesh_device(mesh_device) "
+                "after init_device and before the first forward pass."
+            )
+        return self._child
+
+    # ------------------------------------------------------------------
+    # Worker-side lifecycle (forwarded)
+    # ------------------------------------------------------------------
+
+    def register_kv_caches(self, kv_caches: dict) -> None:
+        # LMCache's vllm_v1_adapter.register_kv_caches stores the dict and then
+        # calls build_kv_layer_groups, which extracts {tensor.dtype, tensor.shape}
+        # per layer and stamps them onto KVLayerGroup. LMCache then uses
+        # .dtype.itemsize to size chunks. Passing the ttnn handles directly
+        # surfaces ttnn.DataType (no .itemsize attribute), which makes
+        # CreateConnector raise "'DataType' object has no attribute 'itemsize'",
+        # leaving RemoteBackend.connection=None, health checks fail, and the
+        # whole cache path is bypassed ("LMCache is unhealthy, skipping store").
+        #
+        # The real KV IO is intercepted by our TTGPUConnector (from_gpu/to_gpu)
+        # before LMCache ever reads these tensors, so LMCache only needs the
+        # per-layer (dtype, shape) metadata. Hand it meta-device torch
+        # placeholders carrying that metadata; meta tensors expose .dtype and
+        # .shape without allocating any memory.
+        import torch as _torch
+
+        spec = self._kv_spec
+        kv_dtype = spec.get("kv_dtype")
+        # spec.kv_dtype may itself be a ttnn DataType (no .itemsize); LMCache
+        # needs a real torch.dtype here for the size math to work.
+        if not isinstance(kv_dtype, _torch.dtype):
+            kv_dtype = _torch.bfloat16
+        # Hand the *real* ttnn handles to our TTGPUConnector first so
+        # from_gpu/to_gpu can address the live device tensors. The LMCache
+        # child below only gets torch-meta placeholders -- it never touches the
+        # bytes (TTGPUConnector intercepts D2H/H2D before LMCache sees them).
+        # Convert dict[layer_name, [k, v]] -> list[[k, v]] (per-layer order)
+        # because slice_kv_layer_for_chunk + _looks_like_ttnn_kvcaches expect
+        # the list-of-list-of-ttnn shape that lmcache-t3knic's paged kvcaches
+        # use. Python dicts preserve insertion order, and model_runner inserts
+        # in self._kv_layer_names order, so values() is layer-sorted.
+        if self._tt_gpu_connector is not None:
+            list_kvcaches = list(kv_caches.values())
+            self._tt_gpu_connector.set_real_kvcaches(list_kvcaches)
+            logger.info(
+                "[t3knic] register_kv_caches: stashed real ttnn kvcaches " "(n_layers=%d) onto TTGPUConnector",
+                len(list_kvcaches),
+            )
+
+        placeholder_dict: dict = {}
+        for name, handle in kv_caches.items():
+            # lmcache-t3knic registers each layer as a [K, V] list of ttnn
+            # tensors (not a single packed tensor). LMCache's KVLayerGroup
+            # expects a 5D shape (2, num_blocks, num_kv_heads, block_size,
+            # head_size); collapse the list to that form using K's shape.
+            if isinstance(handle, (list, tuple)):
+                k_handle = handle[0]
+                shape = _torch.Size([2] + [int(d) for d in k_handle.shape])
+            else:
+                shape = _torch.Size([int(d) for d in handle.shape])
+            placeholder_dict[name] = _torch.empty(shape, dtype=kv_dtype, device="meta")
+        self._require_child("register_kv_caches").register_kv_caches(placeholder_dict)
+
+    def bind_tt_cache(
+        self,
+        *,
+        cache_specs: dict,
+        handles: dict,
+        global_worker_rank: int,
+        devices: Any,
+        mesh_shape: Any,
+        tp_axis: Optional[int],
+        dp_axis: Optional[int],
+        num_blocks: int,
+        cp_size: int = 1,
+        block_interleave: int = 1,
+    ) -> Any:
+        """Cache-spec attach (the shared runtime's bind_tt_cache contract).
+
+        Builds a REAL lmcache_t3knic TransferDescriptor from the runner's
+        per-layer TT cache specs so the shared worker runtime takes its
+        normal spec path for us (no legacy register_kv_caches branch), and
+        so the descriptor can later drive RegionRawBackendConfig for the
+        raw-byte store/restore. Unlike the reference implementation we keep
+        our own LMCache child engine: this method only lowers specs,
+        validates + orders the ttnn handles, and then feeds them through the
+        existing register_kv_caches (real handles -> TTGPUConnector, meta
+        placeholders -> LMCache child).
+        """
+        from lmcache_t3knic.runtime import bind_handles
+        from lmcache_t3knic.specs import (
+            CacheDescriptor,
+            WorkerMeshTopology,
+            describe_cache_groups,
+            lower_transfer,
+        )
+
+        if self._role != KVConnectorRole.WORKER:
+            raise RuntimeError("bind_tt_cache is only valid on a WORKER connector")
+        if self._bound_transfer_descriptor is not None:
+            raise RuntimeError("bind_tt_cache is valid exactly once on a worker connector")
+        if self._tt_kvcache_client is None or self._tt_gpu_connector is None:
+            raise RuntimeError(
+                "bind_tt_cache called before attach_mesh_device: the worker must "
+                "hand the connector its mesh device (and build the TT bridge) "
+                "before the KV caches are bound."
+            )
+        # attach_mesh_device already stamped the mesh geometry onto the
+        # TTGPUConnector (set_mesh_geometry). The runtime independently
+        # resolves tp/dp axes; verify they agree instead of overwriting —
+        # with dcp>1 the runtime passes None, and int(None) would blow up
+        # set_mesh_geometry.
+        if tp_axis is not None and int(tp_axis) != int(self._tt_gpu_connector.tp_axis):
+            raise RuntimeError(
+                f"bind_tt_cache tp_axis={tp_axis} disagrees with attach_mesh_device "
+                f"tp_axis={self._tt_gpu_connector.tp_axis}"
+            )
+        if dp_axis is not None and int(dp_axis) != int(self._tt_gpu_connector.dp_axis):
+            raise RuntimeError(
+                f"bind_tt_cache dp_axis={dp_axis} disagrees with attach_mesh_device "
+                f"dp_axis={self._tt_gpu_connector.dp_axis}"
+            )
+
+        layout = describe_cache_groups(cache_specs)
+
+        kv_transfer_config = self._vllm_config.kv_transfer_config
+        engine_id = str(getattr(kv_transfer_config, "engine_id", None) or "t3knic")
+        kv_role = str(getattr(kv_transfer_config, "kv_role", None) or "kv_both")
+        pp_size = int(getattr(self._vllm_config.parallel_config, "pipeline_parallel_size", 1) or 1)
+        # Identity-only for now (worker_id/engine_id strings). The reference
+        # implementation additionally corrects the stage index from the PP
+        # rank-bindings file; adopt that helper if/when the descriptor is used
+        # for cross-instance handshakes.
+        pp_stage = 0 if pp_size <= 1 else int(os.environ.get("OMPI_COMM_WORLD_RANK", "0"))
+
+        descriptor = CacheDescriptor(
+            worker_id=f"{engine_id}:{kv_role}:pp{pp_stage}:worker{int(global_worker_rank)}",
+            engine_id=f"{engine_id}_pp{pp_stage}",
+            global_worker_rank=int(global_worker_rank),
+            pipeline_stage_rank=pp_stage,
+            devices=tuple(int(device) for device in devices),
+            mesh_topology=WorkerMeshTopology(
+                mesh_shape=tuple(int(size) for size in mesh_shape),
+                tensor_parallel_mesh_axis=None if tp_axis is None else int(tp_axis),
+                data_parallel_mesh_axis=None if dp_axis is None else int(dp_axis),
+                context_parallel_size=int(cp_size),
+            ),
+            num_blocks=int(num_blocks),
+            block_size=layout.block_size,
+            cache_groups=layout.groups,
+            context_block_interleave=int(block_interleave),
+        )
+        transfer_descriptor = lower_transfer(descriptor)
+        # Validates every handle (shape/dtype/layout/memory_config/devices per
+        # member) and returns per-group (K, V) tuples in (layer_id, group_id)
+        # ascending order — the ordering contract TTGPUConnector's positional
+        # layer indexing needs. Do NOT use the raw handles dict order (it is
+        # the runner's allocation-loop order, not a contract).
+        handle_groups = bind_handles(transfer_descriptor, handles)
+
+        groups = transfer_descriptor.local_cache.cache_groups
+        for group in groups:
+            if len(group.cache_owner_keys) != 1 or group.group_id != group.cache_owner_keys[0]:
+                raise RuntimeError(
+                    "t3knic bind_tt_cache requires one owner per group with "
+                    f"group_id == owner key; got group_id={group.group_id!r} "
+                    f"owners={group.cache_owner_keys!r}"
+                )
+        expected_layers = int(self._kv_spec.get("num_layers") or 0)
+        if expected_layers and len(groups) != expected_layers:
+            raise RuntimeError(
+                f"t3knic bind_tt_cache: {len(groups)} cache groups != " f"{expected_layers} layers in kv_spec"
+            )
+
+        # Feed the existing attach machinery in the validated group order:
+        # real ttnn handles -> TTGPUConnector, meta placeholders -> child.
+        ordered = {group.group_id: handles[group.group_id] for group in groups}
+        self.register_kv_caches(ordered)
+
+        self._bound_transfer_descriptor = transfer_descriptor
+        self._bound_handle_groups = tuple(handle_groups)
+        logger.info(
+            "[t3knic] bind_tt_cache READY: groups=%d block_size=%d num_blocks=%d "
+            "mesh=%s tp_axis=%s dp_axis=%s worker_id=%s",
+            len(groups),
+            layout.block_size,
+            int(num_blocks),
+            tuple(int(s) for s in mesh_shape),
+            tp_axis,
+            dp_axis,
+            descriptor.worker_id,
+        )
+        return transfer_descriptor
+
+    def bind_connector_metadata(self, connector_metadata: KVConnectorMetadata) -> None:
+        # Store the (possibly wrapped) meta on self so start_load_kv can read
+        # store_specs. In lazy mode the meta is a
+        # T3knicOffloadMetadata wrapper -- the LMCache child asserts its own
+        # LMCacheConnectorMetadata type, so unwrap and hand the child ONLY its
+        # child_meta. Non-wrapped meta (observe/eager) passes through unchanged.
+        super().bind_connector_metadata(connector_metadata)
+        child_meta = connector_metadata
+        from lmcache_t3knic.t3knic_lmcache.t3knic_offload_metadata import (
+            T3knicOffloadMetadata,
+        )
+
+        if isinstance(connector_metadata, T3knicOffloadMetadata):
+            child_meta = connector_metadata.child_meta
+        self._require_child("bind_connector_metadata").bind_connector_metadata(child_meta)
+
+    def clear_connector_metadata(self) -> None:
+        super().clear_connector_metadata()
+        if self._child is not None:
+            self._child.clear_connector_metadata()
+
+    def _dbg_devdrain(self, client: Any, op_name: str) -> None:
+        """[T3KNIC_DBG] Sync the mesh device and record how long the sync
+        BLOCKED = device work still pending at this point. Large => the device
+        was busy (async compute draining); ~0 => idle. Resolves whether
+        warm_ttft's big residual is real device forward vs an orchestration
+        stall -- the Python forward spans (tid=5) are dispatch-only and cannot
+        tell. Debug-only, never breaks the forward; recorded as both a /stats op
+        and a tid=7 trace span so the per-step prefill drain is isolable."""
+        if client is None:
+            return
+        dev = getattr(client, "mesh_device", None)
+        if dev is None:
+            return
+        try:
+            import ttnn as _ttnn
+
+            _t0 = time.monotonic()
+            _ttnn.synchronize_device(dev)
+            _t1 = time.monotonic()
+            client._record_op(op_name, 0, _t1 - _t0)
+            client._record_trace(op_name, "dbg", _t0, _t1, tid=7)
+        except Exception as e:  # debug-only: never let a probe break serving
+            logger.warning("[t3knic][dbg] devdrain %s failed: %s", op_name, e)
+
+    def start_load_kv(self, forward_context: "ForwardContext", **kwargs: Any) -> None:
+        # Mark the start of one vLLM forward step (prefill or decode). Paired
+        # with wait_for_save below to draw a forward-span bar on the trace
+        # (tid=5), in the SAME clock as the put/get wire ops. The first span
+        # in a request is the prefill forward (≈ TTFT); subsequent spans are
+        # decode steps. Lets the Perfetto view show "when does prefill end /
+        # put dispatch start / decode run" alongside the wire I/O lanes.
+        # The step counter is reset to 0 by reset_stats() (driver calls it right
+        # before the cold request), so the cold request's first forward is
+        # labeled 'prefill' and the rest 'decode'. We deliberately do NOT use a
+        # time-gap heuristic to detect new requests: background PUT work can
+        # create long gaps between cold decode forwards, which would mislabel
+        # decode steps as prefill.
+        # Caveat: the warm request (no reset between cold and warm) inherits the
+        # cold step counter, so warm forwards are all labeled 'decode' (its
+        # prefill is not separately marked). cold prefill is the one we care about.
+        # [T3KNIC_DBG] (1) device drain before this step reveals work pending from the
+        # inter-request gap.
+        # (2) wall clock so the worker timeline correlates with the scheduler's
+        # get_num_new_matched_tokens log. (3) time the child start_load_kv to
+        # localize time before the wire GET begins.
+        # Confirm the worker received the scheduler's selected evict-imminent
+        # block list. wait_for_save later turns these store specs into wire PUTs.
+        try:
+            _m = self._get_connector_metadata()
+            _specs = getattr(_m, "store_specs", None)
+            if _specs:
+                self._offload_recv_calls = getattr(self, "_offload_recv_calls", 0) + 1
+                if self._offload_recv_calls % 20 == 1:
+                    try:
+                        _bids = [s[0] for s in _specs[:8]]
+                    except Exception:  # noqa: BLE001
+                        _bids = list(_specs[:8])
+                    logger.warning(
+                        "[t3knic][offload][worker] received %d keyed store_specs; " "e.g. block_ids=%s",
+                        len(_specs),
+                        _bids,
+                    )
+        except Exception:  # noqa: BLE001
+            pass
+        _dbg = bool(os.environ.get("T3KNIC_DBG"))
+        _cl = self._tt_kvcache_client
+        if _dbg and _cl is not None:
+            self._dbg_devdrain(_cl, "dbg_gap_drain")
+            logger.info("[t3knic][dbg] start_load_kv enter wall=%.3f", time.time())
+        self._forward_t0 = time.monotonic()
+        if _dbg and _cl is not None:
+            _c0 = time.monotonic()
+            self._require_child("start_load_kv").start_load_kv(forward_context, **kwargs)
+            _cl._record_op("dbg_sllkv_child", 0, time.monotonic() - _c0)
+        else:
+            self._require_child("start_load_kv").start_load_kv(forward_context, **kwargs)
+
+    def wait_for_layer_load(self, layer_name: str) -> None:
+        self._require_child("wait_for_layer_load").wait_for_layer_load(layer_name)
+
+    def save_kv_layer(
+        self,
+        layer_name: str,
+        kv_layer: torch.Tensor,
+        attn_metadata: "AttentionMetadata",
+        **kwargs: Any,
+    ) -> None:
+        # Per-layer vLLM hook: invoked once for each transformer layer at the
+        # end of its forward. With non-layerwise LMCache config (our default),
+        # the actual chunk store dispatch happens in wait_for_save below, not
+        # here -- so this trace point measures pure hook overhead per layer.
+        t0 = time.monotonic()
+        try:
+            self._require_child("save_kv_layer").save_kv_layer(layer_name, kv_layer, attn_metadata, **kwargs)
+        finally:
+            client = self._tt_kvcache_client
+            if client is not None:
+                client._record_trace(
+                    "save_kv_layer",
+                    "vllm_hook",
+                    t0,
+                    time.monotonic(),
+                    tid=3,
+                    args={"layer": str(layer_name)},
+                )
+
+    def wait_for_save(self) -> None:
+        # Single call per forward, after all save_kv_layer's. This is where
+        # storage_manager.batched_put is invoked, which fire-and-forget
+        # dispatches the wire put coroutine via asyncio.run_coroutine_threadsafe
+        # and returns immediately. So the dur of this event is just the
+        # dispatch overhead, NOT the actual wire put wall-clock. The latter
+        # is captured by the TTRemoteConnector.{batched_put,put} traces on
+        # the background event loop lanes (tid 10/11).
+        # [MAF-20460 evict->wire] lazy (evict-driven) mode: SUPPRESS the child's
+        # eager save-after-compute. This call is exactly where LMCache dispatches
+        # batched_put for EVERY computed chunk; skipping it is the "eager off"
+        # that makes lazy actually reduce wire traffic. Instead we store ONLY the
+        # blocks the scheduler flagged as evict-imminent (store_specs). eager mode
+        # forwards to the child unchanged. Trace bookkeeping below runs for both.
+        t0 = time.monotonic()
+        try:
+            if self._wrap_enabled:
+                self._lazy_store_from_meta()
+            else:
+                self._require_child("wait_for_save").wait_for_save()
+        finally:
+            client = self._tt_kvcache_client
+            if client is not None:
+                now = time.monotonic()
+                client._record_trace(
+                    "wait_for_save",
+                    "vllm_hook",
+                    t0,
+                    now,
+                    tid=4,
+                )
+                # Forward-step span (tid=5): start_load_kv -> wait_for_save end.
+                # First step of a request = prefill forward; later steps =
+                # decode forwards. Drawn on the same clock as put/get so the
+                # Perfetto view shows prefill/decode bars next to the wire I/O.
+                fwd_t0 = getattr(self, "_forward_t0", None)
+                if fwd_t0 is not None:
+                    step = getattr(self, "_forward_step", 0)
+                    client._record_trace(
+                        "prefill" if step == 0 else "decode",
+                        "vllm_forward",
+                        fwd_t0,
+                        now,
+                        tid=5,
+                        args={"step": step},
+                    )
+                    self._forward_step = step + 1
+                    self._forward_t0 = None
+                # [T3KNIC_DBG] device drain at END of this forward step = device
+                # work still pending after the forward dispatch (the async
+                # forward-compute tail). Big on the prefill step => the device
+                # really is computing; ~0 => the forward span was just dispatch.
+                if os.environ.get("T3KNIC_DBG"):
+                    self._dbg_devdrain(client, "dbg_fwd_drain")
+
+    def _lazy_store_from_meta(self) -> None:
+        """Store scheduler-selected evict-imminent blocks to the wire.
+
+        Reads ``T3knicOffloadMetadata.store_specs`` bound for this forward -- a
+        list of ``(block_id, CacheEngineKey.to_string())`` the scheduler's
+        free-queue scan flagged as about-to-evict AND resolved to a live LMCache
+        key via the BlockHash-to-key side table. Each block's KV is sliced straight out of
+        the resident paged cache and PUT under that exact key, so the unchanged
+        reuse path (LMCache lookup -> exists -> get -> to_gpu) finds it later.
+
+        Runs on the worker's forward thread (single caller of cq0) after the
+        forward computed/updated the KV -- a same-command-queue foreground dispatch, not a
+        background stream. Dedupes by key so a block lingering near eviction over
+        several steps is sent once. Best-effort per block: a failure is logged and
+        skipped (reuse then falls back to recompute)."""
+        gc = self._tt_gpu_connector
+        if gc is None:
+            return
+        try:
+            meta = self._get_connector_metadata()
+        except Exception:  # noqa: BLE001
+            meta = None
+        specs = getattr(meta, "store_specs", None) if meta is not None else None
+        if not specs:
+            return
+        stored = 0
+        for item in specs:
+            try:
+                bid = int(item[0])
+                key_str = item[1]
+            except Exception:  # noqa: BLE001
+                continue
+            if key_str in self._lazy_stored_keys:
+                self._lazy_stored_keys.move_to_end(key_str)  # keep hot
+                continue
+            try:
+                gc.store_block(bid, key_str)
+            except Exception as e:  # noqa: BLE001
+                logger.warning("[t3knic][offload] lazy store block=%s failed: %s", bid, e)
+                continue
+            self._lazy_stored_keys[key_str] = True
+            self._lazy_stored_keys.move_to_end(key_str)
+            if len(self._lazy_stored_keys) > self._lazy_stored_cap:
+                self._lazy_stored_keys.popitem(last=False)
+            stored += 1
+        if stored:
+            self._lazy_store_calls += stored
+            logger.warning(
+                "[t3knic][offload] lazy store: PUT %d evict-imminent block(s) this step "
+                "(cumulative=%d, dedup_set=%d)",
+                stored,
+                self._lazy_store_calls,
+                len(self._lazy_stored_keys),
+            )
+
+    def get_finished(
+        self,
+        finished_req_ids: set,
+    ) -> tuple:
+        return self._require_child("get_finished").get_finished(finished_req_ids)
+
+    def get_block_ids_with_load_errors(self) -> set:
+        """Return physical KV block ids whose external load failed.
+
+        vLLM's model-runner mixin normally calls this after a forward and puts
+        the result on ``kv_connector_output.invalid_block_ids``; with
+        ``kv_load_failure_policy=recompute`` the scheduler then recomputes those
+        blocks instead of serving garbage KV. The base returns ``set()`` (so
+        t3knic previously dropped all load errors). We union two sources:
+
+        - **child (LMCache):** a short retrieve mask -- the server eviction was
+          visible at the worker's ``exists`` probe (``vllm_v1_adapter`` records it).
+        - **wire (TTKVCacheClient):** the residual race where the chunk was
+          present at the exists probe but gone by the wire GET, so
+          ``get_chunk_coalesced`` returned ``None`` and ``to_gpu`` left the
+          blocks unfilled (recorded via ``record_load_error``).
+
+        The TT model runtime bypasses the stock mixin, so it must call this
+        explicitly and assign
+        the result to ``kv_connector_output.invalid_block_ids``.
+        """
+        errors: set = set()
+        child = self._child
+        if child is not None:
+            try:
+                fn = getattr(child, "get_block_ids_with_load_errors", None)
+                if fn is not None:
+                    errors |= set(fn() or ())
+            except Exception as e:  # noqa: BLE001
+                logger.warning("[t3knic] child get_block_ids_with_load_errors raised: %s", e)
+        client = self._tt_kvcache_client
+        if client is not None:
+            try:
+                errors |= set(client.take_load_errors())
+            except Exception as e:  # noqa: BLE001
+                logger.warning("[t3knic] client take_load_errors raised: %s", e)
+        return errors
+
+    def shutdown(self) -> None:
+        # Trace shutdown timing on the same lane as wait_for_save so the
+        # engine-end wire flush window is visible. Recorded BEFORE close()
+        # so the client is still alive to receive the trace event.
+        t0 = time.monotonic()
+        shutdown_error: Optional[BaseException] = None
+        child = self._child
+        if child is not None:
+            try:
+                # LMCache 0.4.4's manager wraps lookup_client.close() in a
+                # ThreadPoolExecutor timeout, but leaving the executor context waits for the
+                # timed-out thread again.  Its ZMQ lookup client can therefore block shutdown
+                # forever after the context is terminated, preventing vLLM from ever reaching
+                # TTWorker.shutdown() and closing the fabric-owning Galaxy mesh.  The lookup
+                # client is host-only and the process is exiting; detach just this service so
+                # the remaining LMCache engine/backend teardown can complete normally.
+                lmcache_engine = getattr(child, "_lmcache_engine", None)
+                manager = getattr(lmcache_engine, "_manager", None)
+                if manager is not None and getattr(manager, "_lookup_client", None) is not None:
+                    logger.info(
+                        "[t3knic] detaching LMCache 0.4.4 lookup client before shutdown "
+                        "(upstream close may block past its timeout)"
+                    )
+                    manager._lookup_client = None
+                child.shutdown()
+                self._child = None
+            except Exception as e:  # noqa: BLE001
+                logger.warning("T3knicKVConnector.shutdown: child raised %s", e)
+                # The TT Client owns live fabric workers. Even if host-only LMCache teardown
+                # fails, continue to close those Clients while their mesh CQ still exists.
+                shutdown_error = e
+
+        client = self._tt_kvcache_client
+        if client is not None:
+            try:
+                client._record_trace(
+                    "shutdown",
+                    "vllm_hook",
+                    t0,
+                    time.monotonic(),
+                    tid=4,
+                )
+            except Exception as e:  # noqa: BLE001
+                logger.warning("T3knicKVConnector.shutdown: trace raised %s", e)
+            # Dump final profiling stats before close. Logged at INFO so it
+            # ends up in the engine log for post-run analysis without needing
+            # a separate fetch path.
+            try:
+                stats = client.get_stats()
+                logger.info("[t3knic] final stats: %s", json.dumps(stats, sort_keys=True))
+            except Exception as e:  # noqa: BLE001
+                logger.warning("T3knicKVConnector.shutdown: get_stats raised %s", e)
+            try:
+                logger.info("[t3knic][cleanup] closing TT KVM clients")
+                client.close()
+                logger.info("[t3knic][cleanup] TT KVM clients closed")
+            except Exception as e:  # noqa: BLE001
+                logger.warning("T3knicKVConnector.shutdown: client.close raised %s", e)
+                if shutdown_error is None:
+                    shutdown_error = e
+
+            if shutdown_error is None:
+                clear_kvcache_client(client)
+                if self._tt_gpu_connector is not None:
+                    self._tt_gpu_connector.clear_client(client)
+                self._tt_kvcache_client = None
+
+        if shutdown_error is not None:
+            raise shutdown_error
+
+    # ------------------------------------------------------------------
+    # Profiling
+    # ------------------------------------------------------------------
+
+    def dump_stats(self) -> dict:
+        """Return a stats snapshot from the underlying TTKVCacheClient.
+
+        Empty dict before the worker has built the client (SCHEDULER role or
+        pre-attach_mesh_device), or when ``T3KNIC_PROFILE`` is unset (the
+        client's _record_op short-circuits so all counters stay zero).
+        """
+        if self._tt_kvcache_client is None:
+            return {}
+        return self._tt_kvcache_client.get_stats()
+
+    def reset_stats(self) -> None:
+        """Clear accumulated stats (forwarded to the underlying client).
+
+        Also reset the forward-step counter so the next request's first forward
+        is labeled 'prefill' (step 0). Without this, warmup-request forwards
+        leave _forward_step > 0 and the cold request's prefill gets mislabeled
+        as 'decode'. The driver calls /stats/reset right before the cold
+        request, so this lands at the right boundary.
+        """
+        self._forward_step = 0
+        self._forward_t0 = None
+        if self._tt_kvcache_client is not None:
+            self._tt_kvcache_client.reset_stats()
+
+    def set_warmup_mode(self, enabled: bool) -> None:
+        """Toggle warmup mode on the client (skip wire put during warmup)."""
+        if self._tt_kvcache_client is not None:
+            self._tt_kvcache_client.set_warmup_mode(enabled)
+
+    def dump_trace(self) -> dict:
+        """Return a Perfetto/Chrome-Tracing JSON snapshot from the client.
+
+        Empty trace (no traceEvents) before the worker has built the client
+        or when ``T3KNIC_PROFILE`` is unset (the client's _record_trace
+        short-circuits, leaving the ring buffer empty).
+        """
+        if self._tt_kvcache_client is None:
+            return {"traceEvents": [], "displayTimeUnit": "ms"}
+        return self._tt_kvcache_client.get_trace()
+
+    def _install_profiling_hooks(self) -> None:
+        """Wire up SIGUSR1 + HTTP /stats endpoints when profiling is enabled.
+
+        Gated on the ``T3KNIC_PROFILE`` env var (same toggle as the
+        TTKVCacheClient stats collector). When unset / falsy, the hooks are
+        skipped entirely so production deployments don't open extra ports
+        or capture extra signals.
+
+        HTTP endpoint listens on ``T3KNIC_STATS_PORT`` (default 8001) at
+        127.0.0.1 only, serving:
+          GET  /stats        -> JSON snapshot of aggregate counters
+          POST /stats/reset  -> clear counters + trace ring, returns {"ok": true}
+          GET  /trace        -> Perfetto/Chrome-Tracing JSON (load in ui.perfetto.dev)
+        """
+        if os.environ.get("T3KNIC_PROFILE", "").strip().lower() not in ("1", "true", "yes", "on"):
+            return
+        self._install_sigusr1_stats_dump()
+        self._install_stats_http_endpoint()
+
+    def _install_sigusr1_stats_dump(self) -> None:
+        """SIGUSR1 -> logger.info(stats). Send ``kill -USR1 <engine_pid>``."""
+        try:
+
+            def _handler(_signum, _frame):
+                try:
+                    stats = self.dump_stats()
+                    logger.info("[t3knic] SIGUSR1 stats: %s", json.dumps(stats, sort_keys=True))
+                except Exception as e:  # noqa: BLE001
+                    logger.warning("[t3knic] SIGUSR1 dump failed: %s", e)
+
+            signal.signal(signal.SIGUSR1, _handler)
+            logger.info(
+                "[t3knic] SIGUSR1 stats dump handler installed (pid=%d).",
+                os.getpid(),
+            )
+        except (ValueError, AttributeError, OSError) as e:
+            logger.debug("[t3knic] SIGUSR1 stats dump handler not installed: %s", e)
+
+    def _install_stats_http_endpoint(self) -> None:
+        """Spawn a tiny HTTP server in a daemon thread serving /stats.
+
+        Daemon thread so it exits when the engine process exits; no explicit
+        teardown needed. Errors are logged at warning and the connector keeps
+        running (profiling is non-essential).
+        """
+        import http.server
+        import socketserver
+        import threading
+
+        connector_ref = self
+        port = int(os.environ.get("T3KNIC_STATS_PORT", "8001"))
+
+        class _Handler(http.server.BaseHTTPRequestHandler):
+            def _write_json(self, status, body):
+                payload = json.dumps(body).encode("utf-8")
+                self.send_response(status)
+                self.send_header("Content-Type", "application/json")
+                self.send_header("Content-Length", str(len(payload)))
+                self.end_headers()
+                self.wfile.write(payload)
+
+            def do_GET(self):
+                if self.path == "/stats":
+                    try:
+                        self._write_json(200, connector_ref.dump_stats())
+                    except Exception as e:  # noqa: BLE001
+                        self._write_json(500, {"error": str(e)})
+                    return
+                if self.path == "/trace":
+                    try:
+                        self._write_json(200, connector_ref.dump_trace())
+                    except Exception as e:  # noqa: BLE001
+                        self._write_json(500, {"error": str(e)})
+                    return
+                self._write_json(404, {"error": "not found", "path": self.path})
+
+            def do_POST(self):
+                if self.path == "/stats/reset":
+                    try:
+                        connector_ref.reset_stats()
+                        self._write_json(200, {"ok": True})
+                    except Exception as e:  # noqa: BLE001
+                        self._write_json(500, {"error": str(e)})
+                    return
+                # /warmup_mode?on or /warmup_mode?off  (query) -- toggle warmup
+                # mode on the underlying client so warmup requests skip wire put.
+                if self.path.startswith("/warmup_mode"):
+                    try:
+                        on = self.path.endswith("on")
+                        connector_ref.set_warmup_mode(on)
+                        self._write_json(200, {"ok": True, "warmup_mode": on})
+                    except Exception as e:  # noqa: BLE001
+                        self._write_json(500, {"error": str(e)})
+                    return
+                self._write_json(404, {"error": "not found", "path": self.path})
+
+            def log_message(self, *args, **kwargs):
+                # Silence access log; we don't need every poll noted.
+                return
+
+        try:
+            srv = socketserver.TCPServer(("127.0.0.1", port), _Handler)
+        except OSError as e:
+            logger.warning(
+                "[t3knic] /stats HTTP endpoint failed to bind 127.0.0.1:%d: %s",
+                port,
+                e,
+            )
+            return
+        srv.allow_reuse_address = True
+        t = threading.Thread(target=srv.serve_forever, daemon=True, name="t3knic-stats-http")
+        t.start()
+        logger.info("[t3knic] /stats HTTP endpoint listening on 127.0.0.1:%d", port)
+
+    def take_events(self) -> Iterable:
+        if self._child is None:
+            return ()
+        try:
+            return self._child.take_events() or ()
+        except Exception:  # noqa: BLE001
+            return ()
+
+    def get_handshake_metadata(self):
+        if self._child is None:
+            return None
+        return self._child.get_handshake_metadata()
+
+    # ------------------------------------------------------------------
+    # Scheduler-side methods (forwarded)
+    # ------------------------------------------------------------------
+
+    def _align_matched_to_block(self, request, num_computed_tokens: int, result):
+        """Floor the external hit so the model's cached prefix ends on a block boundary.
+
+        tt_transformers' prefix-caching prefill derives the chunk's page table as
+        ``source_page_table[:, num_cached_tokens // block_size : ...]`` and then has
+        ``paged_fill_cache`` write the new window at OFFSET 0 of that block. That is only
+        correct when ``num_cached_tokens`` is a multiple of block_size.
+
+        LMCache reports a full hit and then drops one token so the engine still computes
+        something (3296 -> 3295 for a 3296-token prompt at block_size 128). That lands
+        mid-block, so the recomputed window is written 95 tokens early and overwrites the
+        restored KV for the whole last block -- byte-perfect restore, garbage output.
+
+        Floor the hit to a block multiple, keeping at least one block to recompute.
+        DEFAULT OFF: shrinking the scheduler-side hit trips LMCache's worker-side
+        consistency assert ("Mismatch in tokens to load: 3200 vs 3296 - 0 - 1"), because the
+        worker recomputes the load count from its own lookup. The alignment is enforced on
+        the model side instead (the plugin floors the prefill start), which keeps LMCache's
+        bookkeeping intact. Kept behind T3KNIC_ALIGN_HIT=1 for experiments.
+        """
+        if os.environ.get("T3KNIC_ALIGN_HIT", "0").strip().lower() in ("0", "false", "no", "off"):
+            return result
+        try:
+            block = int(self._kv_spec.get("block_size") or 0)
+            if block <= 0:
+                return result
+            if isinstance(result, tuple):
+                matched, rest = result[0], result[1:]
+            else:
+                matched, rest = result, ()
+            if not isinstance(matched, int) or matched <= 0:
+                return result
+            total = getattr(request, "num_tokens", None)
+            if total is None:
+                ids = getattr(request, "all_token_ids", None) or getattr(request, "prompt_token_ids", None)
+                total = len(ids) if ids is not None else None
+            target = num_computed_tokens + matched
+            target -= target % block
+            if total is not None and target >= total:
+                target = ((total - 1) // block) * block
+            aligned = max(0, target - num_computed_tokens)
+            if aligned != matched:
+                logger.info(
+                    "[t3knic] hit %d -> %d tokens (floored to a %d-token block boundary; "
+                    "TT prefix prefill writes the recomputed window at block offset 0)",
+                    matched,
+                    aligned,
+                    block,
+                )
+            return (aligned, *rest) if isinstance(result, tuple) else aligned
+        except Exception as exc:  # noqa: BLE001 - never break scheduling on the clamp
+            logger.warning("[t3knic] hit alignment skipped (%s)", exc)
+            return result
+
+    def get_num_new_matched_tokens(
+        self,
+        request: "Request",
+        num_computed_tokens: int,
+    ) -> tuple:
+        # Forward to child; the t3knic flow DOES support producer-side
+        # reuse because this flow supports bidirectional store and retrieve.
+        # [T3KNIC_DBG] scheduler-side: time the external-match lookup + stamp a
+        # wall clock, so the worker's start_load_kv log can distinguish a slow lookup
+        # from scheduler queueing.
+        # (Scheduler role has no kvcache client, so log instead of _record_op.)
+        if os.environ.get("T3KNIC_DBG"):
+            _t0 = time.monotonic()
+            _r = self._require_child("get_num_new_matched_tokens").get_num_new_matched_tokens(
+                request, num_computed_tokens
+            )
+            logger.info(
+                "[t3knic][dbg] get_num_new_matched_tokens wall=%.3f dur=%.1fms ncomp=%s -> %s",
+                time.time(),
+                (time.monotonic() - _t0) * 1000.0,
+                num_computed_tokens,
+                _r,
+            )
+            return self._align_matched_to_block(request, num_computed_tokens, _r)
+        return self._align_matched_to_block(
+            request,
+            num_computed_tokens,
+            self._require_child("get_num_new_matched_tokens").get_num_new_matched_tokens(request, num_computed_tokens),
+        )
+
+    def update_state_after_alloc(
+        self,
+        request: "Request",
+        blocks: "KVCacheBlocks",
+        num_external_tokens: int,
+    ) -> None:
+        self._require_child("update_state_after_alloc").update_state_after_alloc(request, blocks, num_external_tokens)
+        # Populate the BlockHash->CacheEngineKey side table
+        # for this request's full blocks. Best-effort: never break scheduling.
+        if self._offload_observer is not None:
+            try:
+                self._populate_side_table(request)
+            except Exception as e:  # noqa: BLE001
+                logger.warning("[t3knic][offload] side-table populate failed: %s", e)
+
+    def _reach_token_database(self) -> Optional[Any]:
+        """Child's live ``ChunkedTokenDatabase`` (scheduler side), or None.
+
+        Chain: ``child._lmcache_engine.lookup_client`` -> unwrap HitLimit/
+        ChunkStatistics wrappers (which expose ``actual_lookup_client``) ->
+        ``.token_database``. Cached after first success. Reusing the child's live
+        instance guarantees byte-identical hashing to the child's store/reuse.
+        """
+        if self._offload_td is not None:
+            return self._offload_td
+        try:
+            eng = getattr(self._child, "_lmcache_engine", None)
+            lc = getattr(eng, "lookup_client", None) if eng is not None else None
+            guard = 0
+            while (
+                lc is not None
+                and not hasattr(lc, "token_database")
+                and hasattr(lc, "actual_lookup_client")
+                and guard < 8
+            ):
+                lc = lc.actual_lookup_client
+                guard += 1
+            td = getattr(lc, "token_database", None) if lc is not None else None
+            if td is not None:
+                self._offload_td = td
+                self._check_side_table_parity(td)
+            return td
+        except Exception as e:  # noqa: BLE001
+            logger.warning("[t3knic][offload] reach token_database failed: %s", e)
+            return None
+
+    def _check_side_table_parity(self, td: Any) -> None:
+        """One-shot: verify the lazy store's correctness envelope and, if it is
+        violated, DISABLE the store (fail-safe) instead of silently storing
+        wrong-addressed/wrong-keyed KV. Two premises:
+        (1) single-chip key metadata (world_size==1, worker_id==0) so the
+            scheduler's re-derived keys match the worker's store/reuse keys, and
+        (2) chunk_size==block_size so chunk i == block i == block_hashes[i]
+            (the 1:1 alignment _populate_side_table and store_block both assume).
+        dp>1/tp>1 and chunk_size!=block_size are out of scope (deferred); here we
+        make them fail LOUD + no-op rather than corrupt reuse."""
+        if self._side_table_parity_ok is not None:
+            return
+        try:
+            md = getattr(td, "metadata", None)
+            ws = int(getattr(md, "world_size", 1))
+            wid = int(getattr(md, "worker_id", 0))
+            self._side_table_parity_ok = ws == 1 and wid == 0
+            if not self._side_table_parity_ok:
+                self._lazy_store_disabled = True
+                logger.error(
+                    "[t3knic][offload] side-table parity FAIL (world_size=%s worker_id=%s): "
+                    "re-derived keys would not match worker store/reuse keys. DISABLING lazy "
+                    "evict->wire store (reuse falls back to recompute) -- restrict to "
+                    "single-chip (dp==tp==1, rank 0) for the lazy path.",
+                    ws,
+                    wid,
+                )
+            # Premise (2): chunk_size == block_size (1:1 block<->chunk<->hash).
+            chunk_size = getattr(td, "chunk_size", None)
+            block_size = self._kv_spec.get("block_size")
+            if (
+                isinstance(chunk_size, int)
+                and isinstance(block_size, int)
+                and chunk_size > 0
+                and block_size > 0
+                and chunk_size != block_size
+            ):
+                self._lazy_store_disabled = True
+                logger.error(
+                    "[t3knic][offload] chunk_size(%s) != block_size(%s): block<->chunk 1:1 "
+                    "alignment breaks (side-table would map blocks to wrong keys and store_block "
+                    "would PUT a short chunk). DISABLING lazy evict->wire store (reuse recomputes). "
+                    "Set chunk_size == block_size for the lazy path.",
+                    chunk_size,
+                    block_size,
+                )
+            if self._side_table_parity_ok and not self._lazy_store_disabled:
+                logger.warning(
+                    "[t3knic][offload] side-table parity OK (world_size=1 worker_id=0, " "chunk_size==block_size=%s)",
+                    block_size,
+                )
+        except Exception as e:  # noqa: BLE001
+            # On any doubt, fail safe: disable the store rather than risk corruption.
+            self._side_table_parity_ok = False
+            self._lazy_store_disabled = True
+            logger.warning(
+                "[t3knic][offload] side-table parity/envelope check failed (%s); " "DISABLING lazy store (fail-safe).",
+                e,
+            )
+
+    def _populate_side_table(self, request: Any) -> None:
+        block_hashes = getattr(request, "block_hashes", None)
+        if not block_hashes:
+            return
+        # mm/lora requests derive keys differently (mm mutates tokens; lora
+        # extra_keys) -- skip for now (follow-up). Best-effort detection.
+        if getattr(request, "lora_request", None) is not None:
+            return
+        if (
+            getattr(request, "mm_features", None)
+            or getattr(request, "mm_hashes", None)
+            or getattr(request, "mm_positions", None)
+        ):
+            return
+        td = self._reach_token_database()
+        if td is None:
+            return
+        tokens = getattr(request, "all_token_ids", None)
+        if not tokens:
+            return
+        req_cfg = None
+        try:
+            from lmcache.integration.vllm.vllm_v1_adapter import extract_request_configs
+
+            req_cfg = extract_request_configs(getattr(request, "sampling_params", None))
+        except Exception:  # noqa: BLE001
+            req_cfg = None
+        n_full = len(block_hashes)
+        st = self._offload_side_table
+        cap = self._side_table_cap
+        # process_tokens yields chunks in order; with chunk_size==block_size the
+        # i-th chunk == block i, aligning 1:1 with block_hashes[i] (full blocks).
+        for i, (_start, _end, key) in enumerate(
+            td.process_tokens(list(tokens), make_key=True, request_configs=req_cfg)
+        ):
+            if i >= n_full:
+                break  # only full blocks have a vLLM block_hash
+            try:
+                bh = bytes(block_hashes[i])
+                key_str = key.to_string()
+            except Exception:  # noqa: BLE001
+                continue
+            if bh in st:
+                st.move_to_end(bh)
+            else:
+                st[bh] = key_str
+                if len(st) > cap:
+                    st.popitem(last=False)  # evict LRU front
+        # Throttled observability: confirm the side-table is populating.
+        self._st_populate_calls = getattr(self, "_st_populate_calls", 0) + 1
+        if self._st_populate_calls % 20 == 1:
+            logger.warning(
+                "[t3knic][offload] side-table size=%d (req full_blocks=%d, parity_ok=%s)",
+                len(st),
+                n_full,
+                self._side_table_parity_ok,
+            )
+
+    def bind_gpu_block_pool(self, gpu_block_pool: Any) -> None:
+        # Auto-called by the scheduler
+        # (vllm scheduler.py: hasattr-guarded) with the live BlockPool right after
+        # KVCacheManager construction. We hand it to the read-only eviction
+        # observer. No-op unless store_mode is observe|lazy. Best-effort: a failure
+        # here must never break scheduler init.
+        logger.warning(
+            "[t3knic][offload] bind_gpu_block_pool called (observer=%s)",
+            self._offload_observer is not None,
+        )
+        if self._offload_observer is None:
+            return
+        try:
+            self._offload_observer.bind_gpu_block_pool(gpu_block_pool)
+        except Exception as e:  # noqa: BLE001
+            logger.warning("[t3knic][offload] bind_gpu_block_pool failed: %s", e)
+
+    def build_connector_meta(self, scheduler_output: "SchedulerOutput") -> KVConnectorMetadata:
+        meta = self._require_child("build_connector_meta").build_connector_meta(scheduler_output)
+        # Eviction scan:
+        #   observe mode: read-only log; return child meta unchanged.
+        #   lazy mode (pin_enabled): the observer blind-frees the previous step's
+        #     pins, selects+touch()-pins evict-imminent blocks, and returns their
+        #     ids. Wrap the child meta so the pinned id list rides to the worker
+        #     (T3knicOffloadMetadata); the worker unwraps and hands the child its
+        #     own meta. The worker turns the ids into wire PUTs.
+        if self._offload_observer is None:
+            return meta
+        try:
+            specs = self._offload_observer.step()
+        except Exception as e:  # noqa: BLE001
+            logger.warning("[t3knic][offload] step failed: %s", e)
+            return meta
+        if not self._wrap_enabled:
+            return meta  # observe/eager: log only, no metadata wrap
+        if self._lazy_store_disabled:
+            # An unsupported envelope (dp>1/tp>1 or
+            # chunk_size!=block_size) detected in _check_side_table_parity ->
+            # suppress the store (return the child meta unwrapped, no store_specs)
+            # so reuse recomputes instead of loading wrong-addressed/wrong-keyed KV.
+            return meta
+        # Resolve each selected (block_id, block_hash) to its LMCache
+        # CacheEngineKey via the side-table. Only blocks with a known key can be
+        # stored; the rest are dropped because they are not yet cached/keyed.
+        st = self._offload_side_table
+        resolved = []
+        n_sel = 0
+        for item in specs or ():
+            try:
+                bid, bh = item
+            except Exception:  # noqa: BLE001
+                continue
+            n_sel += 1
+            key = st.get(bytes(bh)) if bh else None
+            if key is not None:
+                resolved.append((int(bid), key))
+        if n_sel and self._offload_observer is not None and self._offload_observer._calls % 20 == 1:
+            logger.warning(
+                "[t3knic][offload] store_specs resolved %d/%d (side_table=%d)",
+                len(resolved),
+                n_sel,
+                len(st),
+            )
+        # Pin exactly the blocks we will store this tick (touch = keep
+        # them out of the allocator) so async scheduling can't reallocate them
+        # before the worker's wire store reads them. Called every lazy tick (even
+        # with an empty list) to keep the observer's free-delay FIFO aligned with
+        # scan ticks; the observer releases each pin pin_free_delay ticks later.
+        try:
+            self._offload_observer.pin([bid for bid, _ in resolved])
+        except Exception as e:  # noqa: BLE001
+            logger.warning("[t3knic][offload] pin failed: %s", e)
+
+        from lmcache_t3knic.t3knic_lmcache.t3knic_offload_metadata import (
+            T3knicOffloadMetadata,
+        )
+
+        return T3knicOffloadMetadata(per_child=(meta,), store_specs=tuple(resolved))
+
+    def request_finished(
+        self,
+        request: "Request",
+        block_ids: List[int],
+    ) -> tuple:
+        return self._require_child("request_finished").request_finished(request, block_ids)
