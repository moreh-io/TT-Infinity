@@ -0,0 +1,271 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Scheduler-side eviction observer for the t3knic evict->wire feature.
+
+This walks the GPU BlockPool's LRU free queue (front = about-to-evict) and
+selects cached, full (hashed) blocks near eviction. Observe mode only logs the
+selection. Lazy mode may pin selected blocks until the worker has read them;
+all observer failures are isolated from serving.
+
+It mirrors the block-selection shape of vLLM's
+``v1/simple_kv_offload/manager.py::_prepare_lazy_store_specs`` (cursor walk of
+``free_block_queue`` + ``_estimate_lazy_target_blocks`` watermark).
+
+Requires vLLM prefix caching ON: with caching off no GPU block ever gets a
+``block_hash`` (``cache_full_blocks`` is gated on ``enable_caching``), so this
+scan would find zero candidates. Use the ``lmcache-e1-pc`` serve config.
+"""
+
+from __future__ import annotations
+
+import os
+from collections import deque
+from typing import Any, Optional
+
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+
+def _cdiv(a: int, b: int) -> int:
+    return (a + b - 1) // b if b else 0
+
+
+def estimate_target_free_blocks(kv_cache_config: Any, max_num_batched_tokens: int) -> int:
+    """Watermark = ~2x one step's worst-case block consumption.
+
+    Simplified mirror of ``manager._estimate_lazy_target_blocks``: for each KV
+    cache group add ``cdiv(max_num_batched_tokens, block_size)`` (full attention;
+    Mamba/sliding-window get their own terms upstream but Llama/GPT-oss here are
+    full-attention), then double (WATERMARK_RATIO = 1.0). Best-effort with a
+    conservative fallback.
+    """
+    try:
+        target = 0
+        groups = getattr(kv_cache_config, "kv_cache_groups", None) or []
+        for g in groups:
+            spec = getattr(g, "kv_cache_spec", None)
+            bs = getattr(spec, "block_size", None) if spec is not None else None
+            if not bs:
+                continue
+            target += _cdiv(int(max_num_batched_tokens), int(bs))
+        if target <= 0:
+            return 64  # conservative fallback
+        return int(target * 2)
+    except Exception:  # noqa: BLE001
+        return 64
+
+
+class T3knicOffloadObserver:
+    """Read-only LRU free-queue observer for the scheduler process."""
+
+    def __init__(
+        self,
+        kv_cache_config: Any,
+        max_num_batched_tokens: int,
+        pin_enabled: bool = False,
+        pin_free_delay: int = 2,
+    ) -> None:
+        self._gpu_block_pool: Optional[Any] = None
+        self._target_free = estimate_target_free_blocks(kv_cache_config, max_num_batched_tokens)
+        # Watermark override. _target_free = how deep into the LRU
+        # free-queue front the scan treats a cached block as "evict-imminent" and
+        # selects it for store. Smaller = store fewer near-front blocks that may
+        # not actually evict this step (less over-store / wire PUT), at the risk
+        # of missing a block that evicts between scans (-> reuse recomputes it,
+        # safe). Default = estimate (2x one step's block consumption). Tune via
+        # T3KNIC_OFFLOAD_WATERMARK to trade PUT volume vs eviction-catch latency.
+        _wm_env = os.environ.get("T3KNIC_OFFLOAD_WATERMARK")
+        if _wm_env:
+            try:
+                self._target_free = max(1, int(_wm_env))
+            except ValueError:
+                logger.warning("[t3knic][offload] bad T3KNIC_OFFLOAD_WATERMARK=%r; using estimate", _wm_env)
+        # Front-of-queue window to walk each step (evict-imminent zone). Cheap,
+        # bounded; deeper blocks won't evict soon so they're not interesting yet.
+        self._scan_cap = max(int(self._target_free) * 4, 256)
+        self._log_every = int(os.environ.get("T3KNIC_OFFLOAD_LOG_EVERY", "50") or 50)
+        self._calls = 0
+        # cumulative peak for a compact end-of-run picture
+        self._peak_candidates = 0
+        # When True, the caller pin()s the resolved evict-imminent
+        # blocks (touch() = removed from the free queue so the scheduler can't
+        # reallocate them before the worker's wire store reads them), and the
+        # observer PIPELINE-DELAY blind-frees them: a set pinned at scan tick N is
+        # freed at tick N+pin_free_delay. With pin_free_delay == max_concurrent_
+        # batches (2 for async, 1 for sync), the execute that read the block has
+        # retired before the free -- so this is safe under async scheduling
+        # WITHOUT a worker->scheduler ack channel (mcb=2 => sched(N+2) only starts
+        # after exec(N) retires). When False, step() is pure read + log (observe).
+        self._pin_enabled = bool(pin_enabled)
+        self._pin_free_delay = max(1, int(pin_free_delay))
+        # FIFO of pinned block-id lists, one entry per pin() tick; the head is
+        # freed once it is pin_free_delay ticks old.
+        self._pin_fifo: "deque" = deque()
+        # Block ids currently pinned (across all live FIFO entries) so a block
+        # that stays evict-imminent over several ticks is not touch()ed twice.
+        self._pinned_now: set = set()
+        # Cap the pins per step well below capacity so get_new_blocks never
+        # starves (bounded by target_free).
+        self._max_pin = int(self._target_free)
+        logger.warning(
+            "[t3knic][offload] observer init: target_free=%d scan_cap=%d log_every=%d "
+            "pin_enabled=%s pin_free_delay=%d",
+            self._target_free,
+            self._scan_cap,
+            self._log_every,
+            self._pin_enabled,
+            self._pin_free_delay,
+        )
+
+    def bind_gpu_block_pool(self, block_pool: Any) -> None:
+        self._gpu_block_pool = block_pool
+        try:
+            total = getattr(block_pool, "num_gpu_blocks", None)
+        except Exception:  # noqa: BLE001
+            total = None
+        logger.warning("[t3knic][offload] bound gpu_block_pool (num_gpu_blocks=%s)", total)
+
+    def _touch_blocks(self, pool: Any, block_ids: list) -> bool:
+        """touch()-pin block ids. Returns True on success (all touched)."""
+        try:
+            pool.touch([pool.blocks[b] for b in block_ids])
+            return True
+        except Exception as e:  # noqa: BLE001
+            logger.warning("[t3knic][offload] touch failed: %s", e)
+            return False
+
+    def _free_blocks(self, pool: Any, block_ids) -> None:
+        """free_blocks() a set of pinned ids exactly once (blind-free/unpin)."""
+        try:
+            pool.free_blocks([pool.blocks[b] for b in block_ids])
+        except Exception as e:  # noqa: BLE001
+            logger.warning("[t3knic][offload] free_blocks failed: %s", e)
+
+    def _free_expired_pins(self, pool: Any) -> None:
+        """Free pin sets that have aged out (>= pin_free_delay ticks old).
+
+        Called at the top of each scan tick. Freeing on this pipeline delay --
+        rather than on an explicit worker ack -- is safe because a set pinned at
+        tick N is only released at tick N+pin_free_delay, and with
+        pin_free_delay == max_concurrent_batches the execute that read those
+        blocks (worker N's sync wire store) has retired by then: under mcb the
+        scheduler cannot start sched(N+mcb) until exec(N) is retired."""
+        while len(self._pin_fifo) >= self._pin_free_delay:
+            old = self._pin_fifo.popleft()
+            if old:
+                self._free_blocks(pool, old)
+                self._pinned_now.difference_update(old)
+
+    def pin(self, block_ids) -> int:
+        """touch()-pin the resolved evict-imminent blocks so the scheduler cannot
+        reallocate them before the worker's wire store reads them.
+
+        Records the newly pinned set as this tick's FIFO entry (freed
+        pin_free_delay ticks later by :meth:`_free_expired_pins`). MUST be called
+        exactly once per scan tick (even with an empty list) to keep the FIFO
+        cadence aligned with scan ticks. Skips ids already pinned in a live FIFO
+        entry so a block that lingers near eviction is not double-touched. No-op
+        (records an empty tick) unless pinning is enabled. Returns #newly pinned.
+        """
+        pool = self._gpu_block_pool
+        if not self._pin_enabled or pool is None:
+            return 0
+        fresh = [int(b) for b in block_ids if int(b) not in self._pinned_now]
+        if fresh and self._touch_blocks(pool, fresh):
+            self._pin_fifo.append(fresh)
+            self._pinned_now.update(fresh)
+            return len(fresh)
+        # nothing new (or touch failed): still record an empty tick so the delay
+        # cadence stays aligned with scan ticks.
+        self._pin_fifo.append([])
+        return 0
+
+    def step(self) -> tuple:
+        """Scan the LRU free-queue front for evict-imminent cached blocks and
+        return them as ``(block_id, stripped_block_hash)`` candidates. The caller
+        resolves each to an LMCache key (side-table) and calls :meth:`pin` on the
+        resolved ones. Also frees pins that have aged out (pipeline-delay
+        blind-free). Pure read + log in observe mode. Never raises (caller
+        guards)."""
+        pool = self._gpu_block_pool
+        if pool is None:
+            return ()
+        self._calls += 1
+
+        if self._pin_enabled:
+            self._free_expired_pins(pool)
+
+        fq = getattr(pool, "free_block_queue", None)
+        if fq is None:
+            return ()
+        head = getattr(fq, "fake_free_list_head", None)
+        tail = getattr(fq, "fake_free_list_tail", None)
+        if head is None or tail is None:
+            return ()
+
+        # Walk read-only: never touch() while iterating the free-queue linked
+        # list (touch mutates it). Collect candidates; pin happens later via pin().
+        node = getattr(head, "next_free_block", None)
+        walked = 0
+        candidates = 0  # cached full blocks (block_hash set) = evict-imminent reuse loss
+        within_watermark = 0  # candidates the LRU allocator would hit next (<= target_free deep)
+        selected: list = []  # evict-imminent (block_id, stripped hash) (bounded by _max_pin)
+
+        while node is not None and node is not tail and walked < self._scan_cap:
+            bhash = getattr(node, "block_hash", None)
+            is_null = bool(getattr(node, "is_null", False))
+            if bhash is not None and not is_null:
+                candidates += 1
+                if walked < self._target_free:
+                    within_watermark += 1
+                    bid = int(getattr(node, "block_id", -1))
+                    if bid >= 0 and len(selected) < self._max_pin:
+                        # (block_id, stripped BlockHash bytes). Strip the trailing
+                        # 4-byte group id (== vLLM get_block_hash) so the connector
+                        # can look the hash up in the connector's side table.
+                        bh = bytes(bhash)
+                        selected.append((bid, bh[:-4] if len(bh) > 4 else bh))
+            walked += 1
+            node = getattr(node, "next_free_block", None)
+
+        if candidates > self._peak_candidates:
+            self._peak_candidates = candidates
+
+        try:
+            num_free = pool.get_num_free_blocks()
+        except Exception:  # noqa: BLE001
+            num_free = -1
+
+        # Throttle: always log when there is something near eviction; otherwise
+        # only every _log_every calls to avoid flooding on an idle engine.
+        should_log = (within_watermark > 0 and self._calls % max(1, self._log_every // 5) == 0) or (
+            self._calls % self._log_every == 0
+        )
+        if should_log:
+            logger.warning(
+                "[t3knic][offload][%s] free=%s walked=%d/%d cached_evict_imminent=%d "
+                "within_watermark(%d)=%d selected=%d pinned_now=%d peak=%d front_ids=%s",
+                "pin" if self._pin_enabled else "scan",
+                num_free,
+                walked,
+                self._scan_cap,
+                candidates,
+                self._target_free,
+                within_watermark,
+                len(selected),
+                len(self._pinned_now),
+                self._peak_candidates,
+                [bid for bid, _ in selected][:8],
+            )
+        return tuple(selected)
+
+    def unpin_all(self) -> None:
+        """Release all outstanding pins (call on shutdown/reset to avoid leaks)."""
+        pool = self._gpu_block_pool
+        if pool is not None:
+            while self._pin_fifo:
+                s = self._pin_fifo.popleft()
+                if s:
+                    self._free_blocks(pool, s)
+        self._pin_fifo.clear()
+        self._pinned_now.clear()
