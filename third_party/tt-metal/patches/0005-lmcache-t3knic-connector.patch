+# SPDX-License-Identifier: Apache-2.0
+"""Canonical typed cache and transfer contracts.
+
+Composition:
+
+``CacheDescriptor`` describes one process-local cache owner and contains ordered
+``CacheGroupSpec`` values, each with ordered physical ``MemberSpec`` values.
+``lower_transfer`` lowers those groups without consulting another process and
+produces one ``TransferDescriptor`` containing ordered
+``TransferGroupDescriptor`` values. Backend preparation binds local TT handles;
+request execution later supplies only ranges, source offsets, direction, and
+slot mapping.
+
+Compatibility is structural: parsers require the exact typed field set and
+closed enum values, while fingerprints detect accidental divergence between a
+payload and its canonical contents. The fingerprint is a plain digest, not a
+MAC, and it is recomputed over the parsed entries, so it does not authenticate
+a payload or catch a change the parser normalizes away. There is no manually
+incremented global schema counter.
+
+The wire contract is the transfer descriptor alone. ``CacheDescriptor`` is
+process-local and is never exchanged.
+"""
+
+from .cache import (
+    CacheAddressSpace,
+    CacheDescriptor,
+    CacheGroupSpec,
+    CacheLayout,
+    WorkerMeshTopology,
+    MemberSpec,
+    MeshParallelRole,
+    TensorDistribution,
+    TensorDistributionKind,
+    describe_cache_groups,
+    validate_handles,
+)
+from .lowering import lower_transfer
+from .canonical_json import descriptor_to_json_value, fingerprint
+from .transfer import (
+    BlockDistribution,
+    TransferDescriptor,
+    SplitPrefixPolicy,
+    TransferBackendKind,
+    TransferGroupDescriptor,
+    TransferPlan,
+    TransferPolicy,
+    MemoryObjMemberSpec,
+    single_group_profile,
+)
+
+__all__ = [
+    "BlockDistribution",
+    "CacheAddressSpace",
+    "CacheDescriptor",
+    "CacheGroupSpec",
+    "CacheLayout",
+    "WorkerMeshTopology",
+    "MemberSpec",
+    "MeshParallelRole",
+    "SplitPrefixPolicy",
+    "TensorDistribution",
+    "TensorDistributionKind",
+    "TransferBackendKind",
+    "TransferDescriptor",
+    "TransferGroupDescriptor",
+    "TransferPlan",
+    "TransferPolicy",
+    "MemoryObjMemberSpec",
+    "describe_cache_groups",
+    "descriptor_to_json_value",
+    "fingerprint",
+    "lower_transfer",
+    "single_group_profile",
+    "validate_handles",
+]
