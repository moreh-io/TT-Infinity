+# SPDX-License-Identifier: Apache-2.0
+"""Bootstrap helpers for the T3K NIC LMCache 0.4.4 integration."""
+
+from __future__ import annotations
+
+import logging
+import os
+
+from ._bootstrap import ensure_numba_cache_dir
+from ._version import __version__
+
+logger = logging.getLogger(__name__)
+
+LMCACHE_UPSTREAM_VERSION = "0.4.4"
+LMCACHE_T3KNIC_PATCHED = False
+
+
+def _check_lmcache_version() -> None:
+    try:
+        import lmcache
+    except ImportError as exc:
+        raise RuntimeError("lmcache-t3knic requires lmcache==0.4.4") from exc
+
+    installed = getattr(lmcache, "__version__", None)
+    if installed != LMCACHE_UPSTREAM_VERSION:
+        raise RuntimeError(
+            f"lmcache-t3knic targets lmcache=={LMCACHE_UPSTREAM_VERSION}, " f"but installed version is {installed!r}."
+        )
+
+
+def _apply_runtime_shim() -> None:
+    from . import lmcache_compat
+
+    lmcache_compat.apply()
+
+
+def _patch_prometheus_route_name() -> None:
+    """Return no route name when a matching Starlette route has no path."""
+    try:
+        import prometheus_fastapi_instrumentator.routing as routing
+        from starlette.routing import Match, Mount
+    except ImportError:
+        return
+
+    original = routing._get_route_name
+    if getattr(original, "_t3knic_path_optional", False):
+        return
+
+    def _get_route_name(scope, routes, route_name=None):
+        for route in routes:
+            match, child_scope = route.matches(scope)
+            if match == Match.FULL:
+                path = getattr(route, "path", None)
+                if path is None:
+                    return None
+                route_name = path
+                child_scope = {**scope, **child_scope}
+                if isinstance(route, Mount) and route.routes:
+                    child_route_name = _get_route_name(child_scope, route.routes, route_name)
+                    if child_route_name is None:
+                        return None
+                    route_name += child_route_name
+                return route_name
+            if match == Match.PARTIAL and route_name is None:
+                path = getattr(route, "path", None)
+                if path is None:
+                    return None
+                route_name = path
+        return None
+
+    _get_route_name._t3knic_path_optional = True
+    routing._get_route_name = _get_route_name
+
+
+def _register_kv_connector() -> None:
+    try:
+        from vllm.distributed.kv_transfer.kv_connector.factory import KVConnectorFactory
+    except ImportError as exc:
+        logger.debug("Skipping KV connector registration: %s", exc)
+        return
+
+    connector_modules = {
+        "T3knicKVConnector": "lmcache_t3knic.t3knic_lmcache.t3knic_kv_connector",
+    }
+    for name, module_path in connector_modules.items():
+        if name in KVConnectorFactory._registry:
+            continue
+        try:
+            KVConnectorFactory.register_connector(name, module_path, name)
+        except ValueError as exc:
+            if "already registered" not in str(exc):
+                raise
+
+
+def register_vllm_connector() -> None:
+    """Register the T3K NIC connector without initializing LMCache."""
+    _register_kv_connector()
+
+
+def apply() -> None:
+    """Apply LMCache patches and register the vLLM KV connector once."""
+    global LMCACHE_T3KNIC_PATCHED
+    if LMCACHE_T3KNIC_PATCHED:
+        _register_kv_connector()
+        return
+
+    # _check_lmcache_version() imports LMCache, so the writable numba cache
+    # must be configured before the version check.
+    ensure_numba_cache_dir()
+    _check_lmcache_version()
+    _apply_runtime_shim()
+    _patch_prometheus_route_name()
+    _register_kv_connector()
+    LMCACHE_T3KNIC_PATCHED = True
+
+
+def register() -> None:
+    """Initialize the LMCache vLLM plugin entry point."""
+    # Connector-only registration avoids importing LMCache until the connector
+    # is selected explicitly by vLLM.
+    plugins = {plugin.strip() for plugin in os.environ.get("VLLM_PLUGINS", "").split(",")}
+    if "lmcache_t3knic" in plugins:
+        apply()
+    else:
+        register_vllm_connector()
+
+
+__all__ = [
+    "__version__",
+    "LMCACHE_UPSTREAM_VERSION",
+    "LMCACHE_T3KNIC_PATCHED",
+    "apply",
+    "register",
+    "register_vllm_connector",
+]
