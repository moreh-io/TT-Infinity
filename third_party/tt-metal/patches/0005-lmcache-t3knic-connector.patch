index 0000000000000000000000000000000000000000..47759188ebbcc2c47e93608ced0be666606e28fa
--- /dev/null
+++ b/lmcache-t3knic/lmcache_t3knic/t3knic_lmcache/worker_hook.py
@@ -0,0 +1,331 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Worker-side glue for the t3knic LMCache backend.
+
+This module gives a lmcache-t3knic worker the small set of calls it needs
+to enable the t3knic flow on top of an existing LMCache engine setup.
+It is intentionally minimal -- it does not introduce a new
+``KVConnectorBase_V1``. The worker is expected to call these helpers
+from a single point during initialization, before LMCache constructs
+the remote connector.
+
+Typical wiring (inside the worker / model runner ``init_device`` or
+``initialize_kv_cache`` path):
+
+    from lmcache_t3knic.t3knic_lmcache import worker_hook
+
+    parsed = worker_hook.parse_t3knic_url(kvcache_url)
+    client = worker_hook.setup_t3knic_kvcache_client(mesh_device, parsed)
+    worker_hook.apply_t3knic_plugin_config(lmcache_config, parsed.url)
+    worker_hook.validate_t3knic_config(lmcache_config, lmcache_metadata)
+
+After these run, LMCache's ``ConnectorManager`` discovers
+``TTConnectorAdapter`` via the plugin entries we injected, and
+``TTRemoteConnector`` uses the registered ``TTKVCacheClient`` to talk
+to the kvcache_server on the paired chip.
+
+The exact spot to call these is in the worker's device-init path;
+:func:`install_t3knic_backend` ties them together for the common case.
+"""
+
+from dataclasses import dataclass
+from enum import Enum
+from typing import Optional
+from urllib.parse import parse_qs, urlparse
+
+from lmcache.logging import init_logger
+from lmcache.v1.config import LMCacheEngineConfig
+from lmcache.v1.metadata import LMCacheMetadata
+
+from lmcache_t3knic.t3knic_lmcache.config_guard import (
+    T3knicConfigError,
+    validate_t3knic_config,
+    warn_t3knic_config_perf,
+)
+from lmcache_t3knic.t3knic_lmcache.tt_connector_adapter import (
+    register_kvcache_client,
+)
+from lmcache_t3knic.t3knic_lmcache.tt_kvcache_client import TTKVCacheClient
+
+logger = init_logger(__name__)
+
+
+_PLUGIN_NAME = "t3knic"
+_ADAPTER_MODULE = "lmcache_t3knic.t3knic_lmcache.tt_connector_adapter"
+_ADAPTER_CLASS = "TTConnectorAdapter"
+
+
+class T3knicMode(Enum):
+    """Where the kvcache_server daemon lives.
+
+    INTRANODE: the daemon runs as a SubDevice inside the same vLLM
+        process. The vLLM worker owns the MeshDevice and splits it
+        between the forward kernels and the kvcache_server NIC kernel.
+        Client and Server communicate over the shared parent mesh.
+
+    EXTERNAL: the Server runs as a separate process or host. The worker still
+        needs its local MeshDevice for the product Client's static inter-mesh
+        ESTABLISH.
+    """
+
+    INTRANODE = "intranode"
+    EXTERNAL = "external"
+
+
+@dataclass(frozen=True)
+class ParsedT3knicURL:
+    """Decoded ``t3knic://`` URL.
+
+    Attributes:
+        url: The original URL string (kept for diagnostics).
+        mode: Whether the kvcache_server is in-process or external.
+        host: Hostname (always populated; for INTRANODE this is the
+            local sentinel like ``"localhost"`` or ``"intranode"``).
+        port: Port (always populated; for INTRANODE this is the
+            sentinel value supplied in the URL -- we do not invent one).
+        subdevice: Optional SubDevice identifier for INTRANODE mode,
+            extracted from query parameter ``subdevice``.
+    """
+
+    url: str
+    mode: T3knicMode
+    host: str
+    port: int
+    subdevice: Optional[str]
+
+
+def parse_t3knic_url(url: str) -> ParsedT3knicURL:
+    """Parse a ``t3knic://`` URL into structured fields.
+
+    URL grammar (matches the rest of LMCache; see
+    ``lmcache.v1.storage_backend.connector.parse_remote_url``):
+
+        t3knic://<host>:<port>[?mode=intranode|external][&subdevice=<id>]
+
+    If ``mode`` is omitted we default to :attr:`T3knicMode.INTRANODE`,
+    the in-process deployment used by the worker integration.
+
+    Args:
+        url: URL string. Must start with ``t3knic://``.
+
+    Returns:
+        :class:`ParsedT3knicURL`.
+
+    Raises:
+        ValueError: On bad scheme, missing host/port, or unknown mode.
+    """
+    if not url.startswith("t3knic://"):
+        raise ValueError(f"expected t3knic:// scheme, got: {url!r}")
+    parsed = urlparse(url)
+    if not parsed.hostname:
+        raise ValueError(f"missing host in {url!r}")
+    if parsed.port is None:
+        raise ValueError(f"missing port in {url!r}")
+
+    query = parse_qs(parsed.query) if parsed.query else {}
+    raw_mode = query.get("mode", ["intranode"])[0].lower()
+    try:
+        mode = T3knicMode(raw_mode)
+    except ValueError as exc:
+        raise ValueError(
+            f"unknown t3knic mode {raw_mode!r}; expected one of " f"{[m.value for m in T3knicMode]}"
+        ) from exc
+
+    subdevice = query.get("subdevice", [None])[0] if "subdevice" in query else None
+
+    return ParsedT3knicURL(
+        url=url,
+        mode=mode,
+        host=parsed.hostname,
+        port=parsed.port,
+        subdevice=subdevice,
+    )
+
+
+def apply_t3knic_plugin_config(
+    config: LMCacheEngineConfig,
+    kvcache_url: str,
+) -> None:
+    """Wire LMCache's plugin framework so ``t3knic://`` resolves to our adapter.
+
+    Mutates ``config`` in place: appends ``"t3knic"`` to
+    ``remote_storage_plugins`` and registers the matching
+    ``extra_config["remote_storage_plugin.t3knic.{module_path,class_name}"]``
+    entries. LMCache's storage_backend `__init__` reads these and imports
+    :class:`TTConnectorAdapter` from this package, instantiating exactly one
+    ``RemoteBackend-t3knic``.
+
+    The legacy ``config.remote_url`` is intentionally NOT set here: setting
+    both creates two separate ``RemoteBackend`` instances (one keyed by
+    plugin name, one by URL) sharing the same TTKVCacheClient, which
+    silently doubles every put on the wire.
+
+    Args:
+        config: LMCache engine configuration to mutate.
+        kvcache_url: The full ``t3knic://...`` URL. We do not store it on
+            ``config.remote_url`` (would create the duplicate backend);
+            ``setup_t3knic_kvcache_client`` keeps its own copy via
+            :class:`ParsedT3knicURL` for the live connection.
+    """
+    # Defensive: warn if the caller (e.g. via yaml) already populated
+    # remote_url. LMCache would then register BOTH a URL-based RemoteBackend
+    # AND our plugin-based RemoteBackend, both sharing the same client, and
+    # double every wire op silently. Production should leave remote_url unset
+    # and route through remote_storage_plugins only.
+    if config.remote_url is not None:
+        logger.warning(
+            "apply_t3knic_plugin_config: config.remote_url is set to %r before "
+            "plugin registration. LMCache will register both a URL-based and a "
+            "plugin-based RemoteBackend, doubling every wire op. Recommend "
+            "leaving remote_url unset and configuring only the t3knic plugin.",
+            config.remote_url,
+        )
+
+    plugins = list(config.remote_storage_plugins or [])
+    if _PLUGIN_NAME not in plugins:
+        plugins.append(_PLUGIN_NAME)
+    config.remote_storage_plugins = plugins
+
+    if config.extra_config is None:
+        config.extra_config = {}
+    config.extra_config[f"remote_storage_plugin.{_PLUGIN_NAME}.module_path"] = _ADAPTER_MODULE
+    config.extra_config[f"remote_storage_plugin.{_PLUGIN_NAME}.class_name"] = _ADAPTER_CLASS
+
+
+def setup_t3knic_kvcache_client(
+    mesh_device: object,
+    parsed: ParsedT3knicURL,
+    *,
+    nic_submesh: object = None,
+    paired_server: object = None,
+    parent_mesh: object = None,
+    wire_stage_coord: object = None,
+    wire_mode: object = None,
+    kv_spec: Optional[dict] = None,
+    chunk_size: Optional[int] = None,
+) -> TTKVCacheClient:
+    """Create, open, and register a :class:`TTKVCacheClient` for this worker.
+
+    For INTRANODE mode, ``mesh_device`` must be the worker's MeshDevice and
+    the paired Server must already be running on ``nic_submesh``.
+
+    EXTERNAL mode constructs an endpoint-free product Client from the local
+    MeshDevice.
+
+    Args:
+        mesh_device: vLLM-TT MeshDevice used by both deployment modes.
+        parsed: Decoded URL.
+
+    Returns:
+        The constructed client.
+
+    Raises:
+        ValueError: If either mode is requested without ``mesh_device``.
+    """
+    if mesh_device is None:
+        raise ValueError(
+            f"t3knic {parsed.mode.value} mode requires the worker's MeshDevice; "
+            "the external product Client still runs on local hardware"
+        )
+
+    client_config: dict = {
+        "mode": parsed.mode.value,
+        "host": parsed.host,
+        "port": parsed.port,
+        "subdevice": parsed.subdevice,
+    }
+    client = TTKVCacheClient(
+        mesh_device=mesh_device,
+        config=client_config,
+        nic_submesh=nic_submesh,
+        paired_server=paired_server,
+        parent_mesh=parent_mesh,
+        wire_stage_coord=wire_stage_coord,
+        wire_mode=wire_mode,
+        kv_spec=kv_spec,
+        chunk_size=chunk_size,
+    )
+    client.open()
+    try:
+        register_kvcache_client(client)
+    except Exception:
+        try:
+            client.close()
+        except Exception:  # noqa: BLE001
+            logger.exception("t3knic client registration failed and rollback close also failed")
+        raise
+    logger.info(
+        "t3knic backend ready: mode=%s host=%s port=%d subdevice=%s",
+        parsed.mode.value,
+        parsed.host,
+        parsed.port,
+        parsed.subdevice,
+    )
+    return client
+
+
+def install_t3knic_backend(
+    lmcache_config: LMCacheEngineConfig,
+    lmcache_metadata: Optional[LMCacheMetadata],
+    mesh_device: object,
+    kvcache_url: str,
+    nic_submesh: object = None,
+    paired_server: object = None,
+    parent_mesh: object = None,
+    wire_stage_coord: object = None,
+    wire_mode: object = None,
+    kv_spec: Optional[dict] = None,
+    chunk_size: Optional[int] = None,
+) -> TTKVCacheClient:
+    """End-to-end install: parse URL, validate config, spin up client.
+
+    This is the recommended single call site from a lmcache-t3knic worker
+    init path. It performs every step needed before LMCache builds the
+    remote connector:
+
+      1. Parse and validate the t3knic URL.
+      2. Mutate ``lmcache_config`` so LMCache finds the t3knic adapter.
+      3. Run :func:`validate_t3knic_config` (premise enforcement).
+      4. Build and register the :class:`TTKVCacheClient`.
+
+    Args:
+        lmcache_config: Engine config to be passed to
+            ``LMCacheEngineBuilder.get_or_create``. Mutated in place.
+        lmcache_metadata: Engine metadata for the same call. May be
+            ``None`` when called from a context that does not yet have
+            an LMCacheMetadata instance (e.g. before the LMCache engine
+            is built); premise 7 (save_only_first_rank for MLA) is then
+            skipped and should be checked separately once metadata is
+            available.
+        mesh_device: Local MeshDevice that runs the sender Client in either mode.
+        kvcache_url: Full ``t3knic://...`` URL.
+        nic_submesh: Co-launch nic submesh hosting the paired Server. Required
+            for INTRANODE mode so the client can build Client(sender, nic);
+            ``None`` for external.
+
+    Returns:
+        The registered :class:`TTKVCacheClient` (caller may keep a
+        reference for explicit ``close()`` on shutdown).
+
+    Raises:
+        ValueError: On URL parse failure.
+        T3knicConfigError: On config-guard violation.
+    """
+    parsed = parse_t3knic_url(kvcache_url)
+    apply_t3knic_plugin_config(lmcache_config, parsed.url)
+    try:
+        validate_t3knic_config(lmcache_config, lmcache_metadata)
+    except T3knicConfigError:
+        # Surface config errors before we try to open hardware.
+        raise
+    warn_t3knic_config_perf(lmcache_config, lmcache_metadata)
+    return setup_t3knic_kvcache_client(
+        mesh_device,
+        parsed,
+        nic_submesh=nic_submesh,
+        paired_server=paired_server,
+        parent_mesh=parent_mesh,
+        wire_stage_coord=wire_stage_coord,
+        wire_mode=wire_mode,
+        kv_spec=kv_spec,
+        chunk_size=chunk_size,
+    )
