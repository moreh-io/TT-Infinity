index 0000000000000000000000000000000000000000..2850827a33e7d78da09d2154820bb446e5931c14
--- /dev/null
+++ b/lmcache-t3knic/lmcache_t3knic/t3knic_lmcache/intermesh.py
@@ -0,0 +1,282 @@
+# SPDX-FileCopyrightText: (c) 2026 Moreh
+#
+# SPDX-License-Identifier: Apache-2.0
+"""Static T3K<->Galaxy inter-mesh configuration, shared by both hosts.
+
+Single source for the values both sides must agree on. A mismatch here is a
+silent failure -- the routers hand-shake against the wrong address and simply
+never come up -- so the table lives in one file rather than in each launcher.
+
+Values are deployment-defined and must match the physical T3K-Galaxy connection.
+
+Two different indices are in play; keep them apart:
+
+* ``cable_index``   -- selects the deployment-defined cabled chip pair.
+* ``link_index``    -- which of the two Ethernet links on that cable this
+  process uses. This is ``FabricRouterConfig.static_intermesh_endpoint_link_index``.
+"""
+
+from __future__ import annotations
+
+import glob
+import os
+import re
+from typing import Optional
+
+from lmcache.logging import init_logger
+
+logger = init_logger(__name__)
+
+# cable_index -> (Galaxy physical chip, T3K physical chip). Physical IDs, not fabric IDs:
+# Galaxy physical D24 is fabric chip 0. Only cable 1 is currently cabled and validated.
+CABLE_ENDPOINT_CHIPS = {
+    0: (28, 0),
+    1: (24, 1),
+    2: (20, 3),
+    3: (16, 2),
+}
+NUM_LINKS_PER_CABLE = 2
+DEFAULT_CABLE_INDEX = 1
+
+# The deployment-defined PCI address of each endpoint card. The chip IDs above are the
+# IDs of a FULL cluster; a run that narrows the cluster (TT_VISIBLE_DEVICES, as every colaunch
+# preset does) gets a renumbered 0..N-1 cluster in which "physical chip 24" simply does not
+# exist -- the router then builds no endpoint at all and says nothing about it, which is a very
+# expensive silence. The BDF is stable across that renumbering, so it is what we resolve against.
+CABLE_ENDPOINT_BDFS = {
+    1: {"galaxy": "0000:c1:00.0", "t3k": "0000:4b:00.0"},
+}
+
+# The peer's ERISC L1 layout, keyed by MY role -- the two endpoints have different fabric memory
+# layouts, so each side must be told where the other one's handshake and receiver live.
+PEER_LAYOUT = {
+    "galaxy": {"handshake": 0x18000, "receiver_base": 0x29CE0, "receiver_slots": 16},
+    "t3k": {"handshake": 0x11000, "receiver_base": 0x2FD60, "receiver_slots": 11},
+}
+
+ROLES = ("galaxy", "t3k")
+
+# The peer process may start much later; the fabric router sync must not give up on it.
+FABRIC_ROUTER_SYNC_TIMEOUT_MS = "240000"
+
+
+def role_from_env() -> Optional[str]:
+    """``T3KNIC_INTERMESH_ROLE`` = galaxy | t3k, or unset for a single-node run."""
+    role = os.environ.get("T3KNIC_INTERMESH_ROLE", "").strip().lower()
+    if not role or role in ("off", "none", "disabled"):
+        return None
+    if role not in ROLES:
+        raise ValueError(f"T3KNIC_INTERMESH_ROLE must be one of {ROLES} (or unset); got {role!r}")
+    return role
+
+
+def cable_index_from_env() -> int:
+    idx = int(os.environ.get("T3KNIC_INTERMESH_CABLE", DEFAULT_CABLE_INDEX))
+    if idx not in CABLE_ENDPOINT_CHIPS:
+        raise ValueError(f"T3KNIC_INTERMESH_CABLE={idx} is not a known cable {sorted(CABLE_ENDPOINT_CHIPS)}")
+    return idx
+
+
+def link_index_from_env() -> int:
+    idx = int(os.environ.get("T3KNIC_INTERMESH_LINK", 0))
+    if not 0 <= idx < NUM_LINKS_PER_CABLE:
+        raise ValueError(f"T3KNIC_INTERMESH_LINK={idx} is outside 0..{NUM_LINKS_PER_CABLE - 1}")
+    return idx
+
+
+def _pcie_index_for_bdf(bdf: str) -> Optional[int]:
+    """Kernel-assigned Tenstorrent device index for a PCI address, or None if it is not present."""
+    nodes = glob.glob(f"/sys/bus/pci/devices/{bdf}/tenstorrent/tenstorrent!*")
+    if not nodes:
+        return None
+    return int(os.path.basename(nodes[0]).split("!")[1])
+
+
+def _chip_id_for_pcie_index(pcie_index: int) -> Optional[int]:
+    """Cluster chip ID owning a PCIe index, read from the live cluster descriptor.
+
+    ``chips_with_mmio`` is a list of one-entry ``chip: pcie_index`` maps. Reading it initializes
+    the cluster, which is fine here: this runs before ``set_fabric_config`` and before the mesh
+    opens, the same order the fabric benchmark uses.
+    """
+    import ttnn
+
+    try:
+        text = open(ttnn.cluster.serialize_cluster_descriptor()).read()
+    except Exception as exc:  # pragma: no cover - diagnostics only
+        logger.warning("[t3knic][intermesh] could not read the cluster descriptor: %s", exc)
+        return None
+    section = re.search(r"^chips_with_mmio:\n((?:\s+-\s+\d+:\s*\d+\n)+)", text, re.MULTILINE)
+    if not section:
+        return None
+    for chip, pcie in re.findall(r"-\s+(\d+):\s*(\d+)", section.group(1)):
+        if int(pcie) == pcie_index:
+            return int(chip)
+    return None
+
+
+def gateway_visible(role: str, cable_index: Optional[int] = None) -> bool:
+    """Whether this process's cluster contains the cable's endpoint card.
+
+    Under pipeline parallelism each rank opens only its own slice of the Galaxy, so exactly one
+    rank can see the cable; the rest reach it by forwarding to that rank. This is the test that
+    decides which rank that is, instead of pinning it by hand and hoping the rank-to-card
+    assignment never changes.
+    """
+    cable_index = cable_index_from_env() if cable_index is None else cable_index
+    bdf = CABLE_ENDPOINT_BDFS.get(cable_index, {}).get(role)
+    if not bdf:
+        return True  # no BDF table for this cable: fall back to the chip-ID constant
+    pcie_index = _pcie_index_for_bdf(bdf)
+    return pcie_index is not None and _chip_id_for_pcie_index(pcie_index) is not None
+
+
+def endpoint_physical_chip(role: str, cable_index: int) -> int:
+    """Local chip ID the cable lands on, as the currently visible cluster numbers it.
+
+    Resolution order: an explicit ``T3KNIC_INTERMESH_ENDPOINT_CHIP``, then the card's BDF looked
+    up in the live cluster, then the full-cluster constant. The BDF step is what keeps this
+    correct when TT_VISIBLE_DEVICES renumbers the cluster.
+    """
+    override = os.environ.get("T3KNIC_INTERMESH_ENDPOINT_CHIP", "").strip()
+    if override:
+        return int(override)
+
+    galaxy_chip, t3k_chip = CABLE_ENDPOINT_CHIPS[cable_index]
+    nominal = galaxy_chip if role == "galaxy" else t3k_chip
+
+    bdf = CABLE_ENDPOINT_BDFS.get(cable_index, {}).get(role)
+    if bdf:
+        pcie_index = _pcie_index_for_bdf(bdf)
+        if pcie_index is None:
+            raise RuntimeError(
+                f"cable {cable_index} {role} endpoint {bdf} is not bound to a Tenstorrent device on "
+                "this host; the cable cannot be reached from here"
+            )
+        resolved = _chip_id_for_pcie_index(pcie_index)
+        if resolved is None:
+            raise RuntimeError(
+                f"cable {cable_index} {role} endpoint {bdf} (Tenstorrent index {pcie_index}) is not in "
+                "the visible cluster; include it in TT_VISIBLE_DEVICES or the link has no path"
+            )
+        if resolved != nominal:
+            logger.info(
+                "[t3knic][intermesh] %s endpoint %s is chip %d in this cluster (full-cluster ID is %d)",
+                role,
+                bdf,
+                resolved,
+                nominal,
+            )
+        return resolved
+    return nominal
+
+
+# Endpoint chip id for ranks whose visible cluster does not contain the gateway card. Chip ids are
+# LOCAL to each rank's cluster view, so reusing the gateway rank's id would alias a random chip in
+# another rank's slice; the C++ side only ever compares `local_chip == endpoint_chip` before using
+# it, so a value no local chip can take keeps every global router knob identical (EDM variant,
+# vc0-only channel layout) while the endpoint itself stays inert on that rank.
+ENDPOINT_CHIP_ABSENT = 0x7FFFFFFF
+
+
+def fabric_router_config(
+    role: str,
+    cable_index: int,
+    link_index: int,
+    endpoint_chip: Optional[int] = None,
+    link_count: int = 1,
+):
+    """Build the FabricRouterConfig both hosts must agree on."""
+    import ttnn
+
+    if role not in ROLES:
+        raise ValueError(f"role must be one of {ROLES}; got {role!r}")
+    layout = PEER_LAYOUT[role]
+    router = ttnn.FabricRouterConfig()
+    # Directly connected endpoint-to-endpoint traffic stays on VC0; no VC1 router channels.
+    router.intermesh_vc0_only = True
+    router.static_intermesh_endpoint_role = (
+        ttnn.StaticIntermeshEndpointRole.GALAXY_GATEWAY
+        if role == "galaxy"
+        else ttnn.StaticIntermeshEndpointRole.T3K_ENDPOINT
+    )
+    router.static_intermesh_endpoint_physical_chip = (
+        endpoint_physical_chip(role, cable_index) if endpoint_chip is None else endpoint_chip
+    )
+    router.static_intermesh_endpoint_link_index = link_index
+    if link_count < 1:
+        raise ValueError(f"link_count must be positive; got {link_count}")
+    router.static_intermesh_endpoint_link_count = link_count
+    router.static_intermesh_peer_handshake_address = layout["handshake"]
+    router.static_intermesh_peer_receiver_base_address = layout["receiver_base"]
+    router.static_intermesh_peer_receiver_num_slots = layout["receiver_slots"]
+    return router
+
+
+def apply_fabric_config(
+    role: str,
+    cable_index: Optional[int] = None,
+    link_index: Optional[int] = None,
+    link_count: Optional[int] = None,
+) -> None:
+    """Select the static inter-mesh fabric for this host, before its mesh is opened.
+
+    ``fabric_config``/``fabric_router_config`` are NOT ``open_mesh_device`` keywords -- that pair is
+    the shape of pytest's ``device_params`` fixture, and passing it through to ``open_mesh_device``
+    raises ``TypeError: unexpected keyword argument 'fabric_config'``. The routers are built from
+    process-wide state set by ``ttnn.set_fabric_config``, so call this AFTER any other
+    ``set_fabric_config`` the caller performs (it would otherwise drop the router config) and
+    BEFORE opening the mesh.
+
+    Also pins the fabric router sync timeout, because whichever side opens its mesh first waits
+    for the other host's process.
+    """
+    import ttnn
+
+    cable_index = cable_index_from_env() if cable_index is None else cable_index
+    link_index = link_index_from_env() if link_index is None else link_index
+    link_count = int(os.environ.get("T3KNIC_INTERMESH_LINK_COUNT", "1")) if link_count is None else link_count
+    os.environ.setdefault("TT_METAL_FABRIC_ROUTER_SYNC_TIMEOUT_MS", FABRIC_ROUTER_SYNC_TIMEOUT_MS)
+    try:
+        router = fabric_router_config(role, cable_index, link_index, link_count=link_count)
+    except RuntimeError as exc:
+        # Multi-rank PP: only the gateway rank's slice contains the cable's card, but the fabric
+        # routers sync cluster-wide, so every rank still has to select the SAME router config
+        # (gateway-only selection leaves the other ranks on stock EDM and open_mesh_device spins
+        # forever, verified 2026-08-27). Ranks that cannot see the card carry an inert endpoint id.
+        if "not in the visible cluster" not in str(exc):
+            raise
+        router = fabric_router_config(
+            role, cable_index, link_index, endpoint_chip=ENDPOINT_CHIP_ABSENT, link_count=link_count
+        )
+    logger.info(
+        "[t3knic][intermesh] role=%s cable=%d link=%d link_count=%d endpoint_physical_chip=0x%x "
+        "peer_handshake=0x%x peer_receiver=0x%x slots=%d",
+        role,
+        cable_index,
+        link_index,
+        link_count,
+        router.static_intermesh_endpoint_physical_chip,
+        router.static_intermesh_peer_handshake_address,
+        router.static_intermesh_peer_receiver_base_address,
+        router.static_intermesh_peer_receiver_num_slots,
+    )
+    # The static link exists only under 2D, so this deliberately replaces whatever fabric the
+    # caller's preset selected.
+    ttnn.set_fabric_config(
+        ttnn.FabricConfig.FABRIC_2D,
+        fabric_tensix_config=ttnn.FabricTensixConfig.DISABLED,
+        router_config=router,
+    )
+
+
+def physical_chip_coord(mesh_device, physical_chip: int):
+    """Row-major ``MeshCoordinate`` of a physical chip inside an open mesh."""
+    import ttnn
+
+    device_ids = list(mesh_device.get_device_ids())
+    if physical_chip not in device_ids:
+        raise ValueError(f"physical chip {physical_chip} is not in this mesh ({device_ids})")
+    index = device_ids.index(physical_chip)
+    _, cols = mesh_device.shape
+    return ttnn.MeshCoordinate(index // cols, index % cols)
