index 0000000000000000000000000000000000000000..fdb9a957eb73f444ac9038353c56a13598fe3c64
--- /dev/null
+++ b/lmcache-t3knic/lmcache_t3knic/t3knic_lmcache/tt_gpu_connector.py
@@ -0,0 +1,767 @@
+# SPDX-License-Identifier: Apache-2.0
+"""LMCache ``GPUConnectorInterface`` implementation for Tenstorrent T3K.
+
+Design rationale:
+
+LMCache's default GPU connector copies KV from device into a host-pinned
+``MemoryObj`` and then the RemoteConnector ships that host buffer to the
+remote KV store. On TT we want to avoid the D->H copy entirely; the KV
+data is sent over TT-Fabric directly from the vLLM chip to the
+kvcache_server chip. ``MemoryObj`` becomes a placeholder whose bytes are
+never read by anyone in the steady state, but it still has to satisfy
+LMCache's shape / dtype expectations.
+
+LMCache does not pass the chunk key to the GPUConnector. To bridge
+that, the connector and the corresponding :class:`TTRemoteConnector`
+share a :class:`TTKVCacheClient` instance. ``from_gpu`` records a
+:class:`KVChunkRef` keyed by ``id(memory_obj)``;
+``TTRemoteConnector.put`` later pops the same entry and -- now armed
+with the chunk key -- issues the fabric writes. The reverse direction
+is symmetric: ``get`` registers a pending-get entry keyed by
+``id(memory_obj)`` carrying the chunk key, and ``to_gpu`` pops it and
+issues per-layer fabric reads into vLLM's device kv caches.
+
+Pending-registry leak prevention is handled by ``weakref.finalize`` in
+``TTKVCacheClient.record_pending_send`` and ``record_pending_get``.
+"""
+
+from typing import List, Optional, Union
+
+import torch
+
+from lmcache.logging import init_logger
+from lmcache.v1.gpu_connector import GPUConnectorInterface
+from lmcache.v1.memory_management import MemoryObj
+
+logger = init_logger(__name__)
+
+from lmcache_t3knic.t3knic_lmcache.tt_kvcache_client import (
+    KVChunkRef,
+    TTKVCacheClient,
+)
+from lmcache_t3knic.t3knic_lmcache.tt_paged_slice import (
+    FILL_ARENA_CAPACITIES,
+    PagedChunkLayout,
+    build_fill_arena,
+    _looks_like_ttnn_kvcaches,
+    _paged_fill_layer_coalesced,
+    decode_chunk_layout,
+    slice_kv_layer_for_chunk,
+    unslice_kv_layer_for_chunk,
+)
+
+
+class TTGPUConnector(GPUConnectorInterface):
+    """GPU connector that routes KV cache movement through TT-Fabric.
+
+    Args:
+        client: Shared :class:`TTKVCacheClient` instance. Must be the
+            same instance held by :class:`TTRemoteConnector`; the
+            pending-send and pending-get registries on that client are
+            how the two sides communicate without modifying LMCache.
+        num_layers: Number of transformer layers in the model. Used by
+            :meth:`get_shape` and to drive the per-layer fabric loops.
+        kv_dim: 1 for MLA, 2 otherwise.
+        hidden_dim_size: ``num_kv_heads * head_dim``. Used to compute
+            placeholder shapes.
+        dtype: KV cache dtype (e.g. ``torch.bfloat16``).
+        block_size: Tokens per page in the paged KV cache. When set,
+            :meth:`from_gpu` / :meth:`to_gpu` precompute the
+            :class:`PagedChunkLayout` once per chunk and reuse it across
+            the per-layer fabric loop. When ``None`` (legacy / test
+            path), the layout is left unset on :class:`KVChunkRef` and
+            phase-2 callers must decode per layer.
+        dp_size: Number of data-parallel groups the paged KV spans.
+            Defaults to 1 (t3knic single-chip flow). Ignored when
+            ``block_size`` is ``None``.
+        blocks_per_dp: Total blocks per DP group. Required for
+            ``dp_size > 1``. Ignored when ``block_size`` is ``None``.
+    """
+
+    # Trace-safe restore buffers, reserved at bind time by _maybe_build_fill_arena.
+    # None => per-request allocation (unsafe once a decode trace exists).
+    _fill_arena = None
+
+    def __init__(
+        self,
+        client: Optional[TTKVCacheClient] = None,
+        num_layers: int = 0,
+        kv_dim: int = 0,
+        hidden_dim_size: int = 0,
+        dtype: torch.dtype = torch.bfloat16,
+        block_size: Optional[int] = None,
+        dp_size: int = 1,
+        blocks_per_dp: Optional[int] = None,
+    ) -> None:
+        # ``client`` is intentionally optional so the connector can be
+        # constructed BEFORE the worker has the mesh device. T3knicKVConnector
+        # builds us in __init__ with ``client=None`` so the LMCache child can
+        # pick us up via ``tt_npu_connector_ctx``; the real ``TTKVCacheClient`` is
+        # injected later by ``attach_mesh_device`` via :meth:`set_client`.
+        # All fabric-IO methods below access ``self.client``, so they will fail
+        # loudly with AttributeError if invoked before set_client -- the worker
+        # lifecycle (init_device -> attach -> register -> forward) guarantees
+        # the injection happens before the first store/retrieve.
+        self.client = client
+        self.num_layers = num_layers
+        self.kv_dim = kv_dim
+        self.hidden_dim_size = hidden_dim_size
+        self.dtype = dtype
+        self.block_size = block_size
+        self.dp_size = dp_size
+        self.blocks_per_dp = blocks_per_dp
+        # Multi-device mesh geometry for the DP/TP-aware tensor path. Defaults
+        # describe the single-device flow (tp_size=1); the worker overwrites them
+        # via ``set_mesh_geometry`` once the mesh device is known.
+        self.tp_size = 1
+        self.dp_axis = 0
+        self.tp_axis = 1
+        self.mesh_device: Optional[object] = None
+
+        # vLLM kv_caches handed in via initialize_kvcaches_ptr / kwargs.
+        # Kept untouched on host -- accessed only to derive device pointers
+        # passed to the sender kernel.
+        self.kvcaches: Optional[object] = None
+        # Raw-byte store/restore codec (multi-device dict backends); built in
+        # set_real_kvcaches once the live handles are known.
+        self.raw_codec: Optional[object] = None
+
+    def set_client(self, client: TTKVCacheClient) -> None:
+        """Inject the persistent :class:`TTKVCacheClient` after the worker has
+        opened its mesh + nic submeshes.
+
+        Called from ``T3knicKVConnector.attach_mesh_device`` once
+        ``install_t3knic_backend`` has built the client. This must happen
+        before the first ``store``/``retrieve`` so the IO methods have a real
+        client to delegate to. Idempotent re-injection of the same instance is
+        a no-op; replacing an already-set client with a different one is
+        rejected to surface lifecycle bugs.
+        """
+        if self.client is not None and self.client is not client:
+            raise RuntimeError(
+                "TTGPUConnector.set_client: a different client is already set; "
+                "this method is intended for one-shot lazy injection."
+            )
+        self.client = client
+
+    def clear_client(self, expected: Optional[TTKVCacheClient] = None) -> None:
+        """Release the injected client without clearing a newer replacement."""
+        if expected is None or self.client is expected:
+            self.client = None
+
+    def set_mesh_geometry(
+        self,
+        dp_size: int,
+        tp_size: int,
+        dp_axis: int,
+        tp_axis: int,
+        blocks_per_dp: Optional[int] = None,
+        mesh_device: Optional[object] = None,
+    ) -> None:
+        """Set the sender-mesh DP/TP geometry for the multi-device tensor path.
+
+        Called from ``T3knicKVConnector.attach_mesh_device`` once the worker has
+        opened its sender submesh. For the single-device flow (dp_size==1 and
+        tp_size==1) tensor materialization takes the single-device path, so this
+        is effectively a no-op there.
+        """
+        self.dp_size = int(dp_size)
+        self.tp_size = int(tp_size)
+        self.dp_axis = int(dp_axis)
+        self.tp_axis = int(tp_axis)
+        if blocks_per_dp is not None:
+            self.blocks_per_dp = int(blocks_per_dp)
+        if mesh_device is not None:
+            self.mesh_device = mesh_device
+        logger.info(
+            "[t3knic] TTGPUConnector.set_mesh_geometry: dp_size=%s tp_size=%s "
+            "dp_axis=%s tp_axis=%s blocks_per_dp=%s",
+            self.dp_size,
+            self.tp_size,
+            self.dp_axis,
+            self.tp_axis,
+            self.blocks_per_dp,
+        )
+
+    def _maybe_build_fill_arena(self) -> None:
+        """Reserve the restore path's device buffers while it is still safe to allocate.
+
+        Runs at bind time, before the model captures its decode trace. Allocating
+        after capture is what corrupted warm decode (tt-metal's "Allocating device
+        buffers is unsafe due to the existence of an active trace" warning): the KV
+        round-trip stayed byte-exact but the traced decode read shifted addresses.
+        Disable with T3KNIC_FILL_ARENA=0 to fall back to per-request allocation.
+        """
+        import os
+
+        if self._fill_arena is not None:
+            return
+        if os.environ.get("T3KNIC_FILL_ARENA", "1").strip().lower() in ("0", "false", "no", "off"):
+            return
+        if self.dp_size <= 1 and self.tp_size <= 1:
+            return  # single-device restore does not build these tensors
+        if not _looks_like_ttnn_kvcaches(self.kvcaches) or not self.block_size:
+            return
+        try:
+            k_handle = self.kvcaches[0][0]  # type: ignore[index]
+            mesh = k_handle.device()
+            k_shape = tuple(int(d) for d in k_handle.shape)
+            heads_total = int(k_shape[1]) * int(self.tp_size)
+            head_size = int(k_shape[3])
+            max_chunks = max(FILL_ARENA_CAPACITIES)
+            self._fill_arena = build_fill_arena(
+                mesh,
+                tuple(mesh.shape),
+                int(self.dp_size),
+                int(self.tp_size),
+                int(self.dp_axis),
+                int(self.tp_axis),
+                heads_total,
+                int(self.block_size),
+                head_size,
+                max_chunks=max_chunks,
+            )
+        except Exception as exc:  # noqa: BLE001 - never block bring-up on the arena
+            logger.warning("[t3knic] restore arena unavailable (%s); falling back to per-request allocation", exc)
+            self._fill_arena = None
+
+    def _record_wire_load_miss(self, slot_mapping_slice: object) -> None:
+        """Report a whole-chunk wire GET miss as load errors.
+
+        The chunk's destination KV blocks were left unfilled (garbage) because
+        the server no longer had the key. Convert the chunk's slot_mapping slice
+        to physical block ids (``slot // block_size`` -- the convention vLLM's
+        scheduler + LMCache use) and hand them to the client accumulator, which
+        T3knicKVConnector drains into ``kv_connector_output.invalid_block_ids``
+        for recompute. dp==1 is required because slot_mapping is global there;
+        a dp>1 deployment needs a block-id shift before using this path.
+        """
+        if self.client is None or self.block_size is None:
+            return
+        try:
+            bs = int(self.block_size)
+            block_ids = {int(s) // bs for s in slot_mapping_slice if int(s) >= 0}  # type: ignore[union-attr]
+        except Exception:  # noqa: BLE001
+            return
+        if block_ids:
+            self.client.record_load_error(block_ids)
+
+    def _maybe_decode_layout(self, slot_mapping_slice: object) -> Optional[PagedChunkLayout]:
+        """Decode the chunk layout when ``block_size`` is configured.
+
+        Returns ``None`` if the connector was built without
+        ``block_size`` -- callers then keep the legacy "decode on every
+        slice" path.
+        """
+        if self.block_size is None:
+            return None
+        return decode_chunk_layout(
+            slot_mapping_slice,  # type: ignore[arg-type]
+            block_size=self.block_size,
+            dp_size=self.dp_size,
+            blocks_per_dp=self.blocks_per_dp,
+            tp_size=self.tp_size,
+            dp_axis=self.dp_axis,
+            tp_axis=self.tp_axis,
+        )
+
+    # ------------------------------------------------------------------
+    # GPUConnectorInterface
+    # ------------------------------------------------------------------
+
+    def initialize_kvcaches_ptr(self, **kwargs: object) -> None:
+        """Capture vLLM-TT's ``kv_caches`` without LMCache's permute pass.
+
+        The base class implementation calls
+        ``attempt_permute_to_contiguous_view``, which assumes
+        ``torch.Tensor`` leaves and recurses on lists. vLLM-TT supplies
+        ``list[list[ttnn.Tensor]]``; ttnn tensors are not torch tensors
+        so the helper would recurse forever. The TT side does not need
+        the permute fix-up either -- ttnn tensors are not strided in
+        the same way -- so we simply store the reference.
+        """
+        if "kvcaches" not in kwargs:
+            return
+        incoming = kwargs["kvcaches"]
+        # T3knicKVConnector.register_kv_caches stashes the *real* ttnn
+        # list[list[ttnn.Tensor]] directly onto us via set_real_kvcaches before
+        # the LMCache child sees a torch-meta placeholder. LMCache then hands
+        # us that placeholder back through initialize_kvcaches_ptr; if we let
+        # it overwrite our ttnn handles, slice_kv_layer_for_chunk would see a
+        # non-ttnn object and raise NotImplementedError. Keep the ttnn we
+        # already have when the incoming object is not ttnn-shaped.
+        if _looks_like_ttnn_kvcaches(self.kvcaches) and not _looks_like_ttnn_kvcaches(incoming):
+            return
+        self.kvcaches = incoming
+
+    def set_real_kvcaches(self, kvcaches: object) -> None:
+        """Stash the real ttnn ``list[list[ttnn.Tensor]]`` from model_runner so
+        from_gpu/to_gpu can address the device tensors directly, regardless of
+        what the LMCache child later hands us via initialize_kvcaches_ptr."""
+        self.kvcaches = kvcaches
+        self._maybe_build_fill_arena()
+        # Multi-device dict backends store/restore via the raw-byte codec
+        # (pure byte copies of the bfp8 TILE block regions — the torch-fill
+        # restore corrupted TP-sharded caches). Built here because it needs a
+        # live K handle for the per-shard block byte size; geometry was
+        # stamped earlier by set_mesh_geometry. Shared with TTRemoteConnector
+        # through the client (the PUT side only holds the client).
+        from lmcache_t3knic.t3knic_lmcache.tt_raw_byte import RawByteCodec
+
+        codec = RawByteCodec.maybe_build(
+            kvcaches=kvcaches,
+            tp_size=self.tp_size,
+            dp_size=self.dp_size,
+            tp_axis=self.tp_axis,
+            dp_axis=self.dp_axis,
+            block_size=self.block_size,
+            blocks_per_dp=self.blocks_per_dp,
+        )
+        self.raw_codec = codec
+        if self.client is not None:
+            self.client.raw_codec = codec
+
+    def store_block(self, block_id: int, key_str: str) -> None:
+        """[MAF-20460 evict->wire] Store ONE resident paged block's KV to the
+        wire under ``key_str`` (the evict-driven / lazy store).
+
+        Unlike :meth:`from_gpu` (which sources its layout from a live request's
+        ``slot_mapping`` recorded in the pending-send registry), this synthesizes
+        the block's slot range directly from ``block_id`` -- ``[block_id*bs ..
+        block_id*bs + bs)`` -- so an arbitrary about-to-evict block can be sliced
+        and PUT without any request context. ``chunk_size == block_size`` (wire
+        contract) => one block is exactly one wire chunk. Mirrors the coalesced
+        put in :class:`TTRemoteConnector`; ``wait_put_done`` flushes the durable
+        directory commit on the caller's cq0 thread under the connector's
+        single-caller command-queue contract.
+        """
+        if self.client is None or self.block_size is None:
+            raise RuntimeError(
+                "store_block: client/block_size not configured "
+                f"(client={self.client!r}, block_size={self.block_size!r})"
+            )
+        if not _looks_like_ttnn_kvcaches(self.kvcaches):
+            raise TypeError(
+                "store_block: kvcaches must be a ttnn list[list[Tensor]] "
+                "(set via set_real_kvcaches); got %r" % type(self.kvcaches).__name__
+            )
+        bs = int(self.block_size)
+        base = int(block_id) * bs
+        slot_mapping_slice = list(range(base, base + bs))
+        layout = self._maybe_decode_layout(slot_mapping_slice)
+        if layout is None:
+            raise RuntimeError("store_block: block_size not configured for layout decode")
+        on_device = bool(getattr(self.client, "_put_ondev", False))
+        if getattr(self.client, "_coalesce", False):
+            k_list, v_list = [], []
+            for layer_idx in range(self.num_layers):
+                k_src, v_src = slice_kv_layer_for_chunk(self.kvcaches, layout, layer_idx, on_device=on_device)
+                k_list.append(k_src)
+                v_list.append(v_src)
+            self.client.put_chunk_coalesced(key_str, k_list, v_list)
+        else:
+            for layer_idx in range(self.num_layers):
+                k_src, v_src = slice_kv_layer_for_chunk(self.kvcaches, layout, layer_idx)
+                self.client.put_layer(key_str, layer_idx, k_src, v_src)
+        self.client.wait_put_done(key_str)
+
+    def to_gpu(
+        self,
+        memory_obj: MemoryObj,
+        start: int,
+        end: int,
+        **kwargs: object,
+    ) -> None:
+        """Pull a KV chunk back from the KV pool into vLLM's device KV cache.
+
+        Called by LMCache on cache-hit during prefill. ``memory_obj`` is
+        the placeholder previously returned from
+        :meth:`TTRemoteConnector.get`; we use ``id(memory_obj)`` to
+        retrieve the chunk key that was recorded then. The actual data
+        is fetched layer-by-layer through :meth:`TTKVCacheClient.get_layer`.
+
+        Args:
+            memory_obj: Placeholder MemoryObj (host bytes ignored).
+            start: Start token index within the request's token sequence.
+            end: End token index (exclusive).
+            **kwargs: Must contain ``kvcaches`` and ``slot_mapping``.
+
+        Raises:
+            ValueError: If required kwargs are missing.
+            RuntimeError: If no pending-get entry exists for this
+                ``memory_obj`` -- indicates a programming error where
+                ``TTRemoteConnector.get`` did not run for this object.
+        """
+        if kwargs.get("kvcaches") is None:
+            raise ValueError("'kvcaches' must be provided in kwargs for to_gpu")
+        if kwargs.get("slot_mapping") is None:
+            raise ValueError("'slot_mapping' must be provided in kwargs for to_gpu")
+        self.initialize_kvcaches_ptr(**kwargs)
+
+        key = self.client.pop_pending_get(id(memory_obj))
+        if key is None:
+            raise RuntimeError(
+                f"TTGPUConnector.to_gpu: no pending-get entry for "
+                f"id(memory_obj)={id(memory_obj)}. "
+                "TTRemoteConnector.get must run before to_gpu; if you see "
+                "this in practice it likely means LMCache cached a "
+                "placeholder MemoryObj in LocalCPUBackend.hot_cache and "
+                "bypassed the remote connector -- check config_guard "
+                "premise 2 (local_cpu=False)."
+            )
+
+        slot_mapping = kwargs["slot_mapping"]
+        slot_mapping_slice = slot_mapping[start:end]  # type: ignore[index]
+        layout = self._maybe_decode_layout(slot_mapping_slice)
+        if layout is None:
+            raise RuntimeError(
+                "TTGPUConnector.to_gpu cannot dispatch slices: "
+                "block_size was not configured at construction time. "
+                "Pass block_size=... to TTGPUConnector so the chunk "
+                "layout can be decoded once and reused across layers."
+            )
+        key_str = key.to_string()
+        if not _looks_like_ttnn_kvcaches(self.kvcaches):
+            raise TypeError(
+                "TTGPUConnector.to_gpu: kvcaches must be a ttnn "
+                "list[list[Tensor]] (vllm-tt runtime layout); got %r" % type(self.kvcaches).__name__
+            )
+        if self.raw_codec is not None:
+            # Preferred: GET into the wire chip's DRAM and scatter chip-to-chip over fabric, so the
+            # restore never crosses PCIe. The host path below covers backends without that.
+            if getattr(self.client, "wire_uses_device_path", lambda: False)():
+                # The device path owns this restore, so a False is a real miss, not a reason to
+                # retry on the host path.
+                if not self.client.get_chunk_device(key_str, self.kvcaches, self.num_layers, slot_mapping_slice):
+                    self._record_wire_load_miss(slot_mapping_slice)
+                return
+            bufs = self.client.get_chunk_raw(key_str)
+            if bufs is None:
+                self._record_wire_load_miss(slot_mapping_slice)
+            else:
+                self.raw_codec.scatter_chunk(self.kvcaches, self.num_layers, slot_mapping_slice, bufs)
+            return
+        # BFP8-safe path: the stored objects are host ttnn.Tensors holding the
+        # original packed bytes. Feed them straight to the unslice that calls
+        # ttnn.to_device.
+        # Trace the whole chunk retrieve as a span (tid=12, cat="background"),
+        # symmetric to remote.put (tid=10). Individual wire gets are already on
+        # tid=2 (get_layer_raw); this parent span shows the per-chunk retrieve
+        # wall clock alongside the PUT lanes.
+        import time as _time
+
+        _t0 = _time.monotonic()
+        if getattr(self.client, "_coalesce", False):
+            # Coalesced retrieve: one grouped fabric get per layer-group, then
+            # split back into per-layer host tensors fed to the same unslice.
+            stored_map = self.client.get_chunk_coalesced(key_str)
+            if stored_map:
+                for layer_idx in range(self.num_layers):
+                    stored = stored_map.get(layer_idx)
+                    if stored is None:
+                        continue
+                    k_stored, v_stored = stored
+                    unslice_kv_layer_for_chunk(self.kvcaches, layout, layer_idx, k_stored, v_stored)
+            else:
+                # A whole-chunk wire GET can miss if the server evicts it between
+                # the lookup/exists probe and this GET): destination blocks left
+                # unfilled -> report as load errors so vLLM recomputes them.
+                self._record_wire_load_miss(slot_mapping_slice)
+        else:
+            any_hit = False
+            for layer_idx in range(self.num_layers):
+                stored = self.client.get_layer_raw(key_str, layer_idx)
+                if stored is None:
+                    continue
+                any_hit = True
+                k_stored, v_stored = stored
+                unslice_kv_layer_for_chunk(
+                    self.kvcaches,
+                    layout,
+                    layer_idx,
+                    k_stored,
+                    v_stored,
+                )
+            if not any_hit:
+                self._record_wire_load_miss(slot_mapping_slice)
+        self.client._record_trace(
+            "remote.get",
+            "background",
+            _t0,
+            _time.monotonic(),
+            tid=12,
+            args={"key": key_str[:40], "layers": int(self.num_layers)},
+        )
+
+    def from_gpu(
+        self,
+        memory_obj: MemoryObj,
+        start: int,
+        end: int,
+        **kwargs: object,
+    ) -> None:
+        """Stage a chunk for fabric send. Does not write to ``memory_obj``.
+
+        We do not have the chunk key here (LMCache does not pass it to
+        the GPU connector). Instead we record a :class:`KVChunkRef` keyed
+        by ``id(memory_obj)`` on the shared client. The downstream
+        :meth:`TTRemoteConnector.put` will receive that ``memory_obj``
+        together with the chunk key and issue the actual fabric writes.
+
+        Args:
+            memory_obj: Placeholder MemoryObj (host bytes NOT written).
+            start: Start token index within the request's token sequence.
+            end: End token index (exclusive).
+            **kwargs: Must contain ``kvcaches`` and ``slot_mapping``.
+
+        Raises:
+            ValueError: If required kwargs are missing.
+        """
+        if kwargs.get("kvcaches") is None:
+            raise ValueError("'kvcaches' must be provided in kwargs for from_gpu")
+        if kwargs.get("slot_mapping") is None:
+            raise ValueError("'slot_mapping' must be provided in kwargs for from_gpu")
+        self.initialize_kvcaches_ptr(**kwargs)
+
+        slot_mapping = kwargs["slot_mapping"]
+        slot_mapping_slice = slot_mapping[start:end]  # type: ignore[index]
+        info = KVChunkRef(
+            kvcaches=self.kvcaches,
+            slot_mapping_slice=slot_mapping_slice,
+            num_layers=self.num_layers,
+            layout=self._maybe_decode_layout(slot_mapping_slice),
+        )
+        self.client.record_pending_send(memory_obj, info)
+
+    def batched_to_gpu(
+        self,
+        memory_objs: Union[List[List[MemoryObj]], List[MemoryObj], List[int], None] = None,
+        starts: Optional[List[int]] = None,
+        ends: Optional[List[int]] = None,
+        **kwargs: object,
+    ) -> None:
+        """Batched ``to_gpu``.
+
+        Coalesced page-aware write per layer via
+        ``ttnn.experimental.moreh_paged_fill_cache_varlen``. Each chunk's
+        stored host ttnn blocks (from ``get_layer_raw``) are pushed to
+        device and concatenated along the token dim, then written in a
+        single kernel call per layer. The bfp8 TILE bytes round-trip
+        verbatim (MAF-19909).
+        """
+        if memory_objs is None or starts is None or ends is None:
+            raise ValueError("memory_objs, starts, ends are required")
+
+        if kwargs.get("kvcaches") is not None:
+            self.initialize_kvcaches_ptr(**kwargs)
+        if not _looks_like_ttnn_kvcaches(self.kvcaches):
+            raise TypeError(
+                "TTGPUConnector.batched_to_gpu: kvcaches must be a ttnn "
+                "list[list[Tensor]] (vllm-tt runtime layout); got %r" % type(self.kvcaches).__name__
+            )
+        # Coalesced retrieve path (fanout pattern). With the bfp8 TILE
+        # passthrough wire, get_layer_raw returns host ttnn K/V tensors with
+        # the same (num_blocks_in_chunk, kv_heads, block_size, head_size)
+        # shape the slice produced, so _paged_fill_layer_coalesced's existing
+        # to_device + concat-on-token-dim logic consumes them directly.
+        # Coalesced does a partial paged_fill at the chunk's slot_mapping
+        # position, leaving the rest of the layer cache intact.
+
+        # Resolve per-chunk metadata first, then iterate layers once.
+        slot_mapping = kwargs.get("slot_mapping")
+        if slot_mapping is None:
+            raise ValueError("'slot_mapping' must be provided in kwargs for batched_to_gpu (ttnn path)")
+        if self.block_size is None:
+            raise RuntimeError(
+                "TTGPUConnector.batched_to_gpu (ttnn path): block_size must be configured "
+                "at construction so we can derive destination page ids from slot_mapping."
+            )
+
+        chunk_meta = []  # list of (key_str, slot_mapping_slice, start)
+        for memory_obj, start, end in zip(memory_objs, starts, ends, strict=False):
+            key = self.client.pop_pending_get(id(memory_obj))
+            if key is None:
+                raise RuntimeError(
+                    f"TTGPUConnector.batched_to_gpu (ttnn): no pending-get entry for "
+                    f"id(memory_obj)={id(memory_obj)} -- TTRemoteConnector.get must run first."
+                )
+            slot_mapping_slice = slot_mapping[start:end]  # type: ignore[index]
+            chunk_meta.append((key.to_string(), slot_mapping_slice, int(start)))
+
+        if not chunk_meta:
+            return
+
+        logger.debug(
+            "batched_to_gpu coalesce: n_chunks=%d starts=%s block_size=%d",
+            len(chunk_meta),
+            [m[2] for m in chunk_meta],
+            self.block_size,
+        )
+
+        if self.raw_codec is not None:
+            # Raw-byte restore: scatter the stored block-region bytes straight
+            # into the paged cache (no dequant/requant, no fill kernel).
+            import time as _time
+
+            _t0 = _time.monotonic()
+            restored = 0
+            # Ask the client which path owns the restore. Keying on _wire_coord alone is wrong: the
+            # coordinate is set in host mode too, so this took the device path, got the refusal it
+            # returns there, and recorded it as a cache miss -- nothing was restored and the request
+            # decoded from an empty cache. The single-chunk branch above was corrected earlier; this
+            # batched one was missed.
+            on_device = getattr(self.client, "wire_uses_device_path", lambda: False)()
+            for key_str, slot_mapping_slice, _start in chunk_meta:
+                if on_device:
+                    # GET into the wire chip's DRAM, then scatter chip-to-chip; no PCIe leg.
+                    if self.client.get_chunk_device(key_str, self.kvcaches, self.num_layers, slot_mapping_slice):
+                        restored += 1
+                    else:
+                        self._record_wire_load_miss(slot_mapping_slice)
+                    continue
+                bufs = self.client.get_chunk_raw(key_str)
+                if bufs is None:
+                    self._record_wire_load_miss(slot_mapping_slice)
+                    continue
+                self.raw_codec.scatter_chunk(self.kvcaches, self.num_layers, slot_mapping_slice, bufs)
+                restored += 1
+            self.client._record_trace(
+                "remote.batched_get_raw",
+                "background",
+                _t0,
+                _time.monotonic(),
+                tid=13,
+                args={"chunks": restored, "layers": int(self.num_layers)},
+            )
+            return
+
+        # Trace the whole batched retrieve as a span (tid=13, cat="background"),
+        # symmetric to remote.batched_put (tid=11). Individual wire gets are on
+        # tid=2 (get_layer_raw).
+        import time as _time
+
+        # Coalesced retrieve: fetch each chunk's whole K/V once (grouped gets)
+        # up front, then the per-layer loop below reads from the in-memory map
+        # instead of issuing a fabric get per (layer, chunk).
+        coalesce = getattr(self.client, "_coalesce", False)
+        # T3KNIC_GET_ONDEV keeps the wire GET output on device and feeds it
+        # straight into the in-place page-fill, skipping the D2H + restore H2D.
+        # Only for single-device (dp==tp==1); the multi-device fill re-shards per
+        # group and needs the host gather, so leave it on the host path there.
+        ondev = bool(getattr(self.client, "_get_ondev", False)) and self.dp_size == 1 and self.tp_size == 1
+        chunk_maps = {}
+        if coalesce:
+            for key_str, _slot, _start in chunk_meta:
+                chunk_maps[key_str] = self.client.get_chunk_coalesced(key_str, on_device=ondev)
+            # Report whole-chunk wire GET misses (None) as load errors
+            # so vLLM recomputes those blocks instead of using garbage KV.
+            for key_str, slot_mapping_slice, _start in chunk_meta:
+                if chunk_maps.get(key_str) is None:
+                    self._record_wire_load_miss(slot_mapping_slice)
+
+        _t0 = _time.monotonic()
+        # Layer-invariant fill auxiliaries (page_table / cu_seqlens /
+        # start_positions) depend only on slot_mapping/starts, not on the layer.
+        # Build them once on the first layer and share across the whole layer
+        # loop via this dict, so a 32-layer restore issues 3 from_torch H2D
+        # instead of 96 (one per layer x 3). Freed right after the loop.
+        aux_cache: dict = {}
+        # [T3KNIC_PROFILE] accumulate per-substep restore timing across layers
+        # (to_device / concat / aux_build / kernel / dealloc) so restore_group
+        # decomposes instead of being one opaque number. None when profiling off.
+        restore_timing = {} if getattr(self.client, "_profile_enabled", False) else None
+        for layer_idx in range(self.num_layers):
+            chunk_blocks = []
+            slot_mappings = []
+            starts_local = []
+            for key_str, slot_mapping_slice, start in chunk_meta:
+                if coalesce:
+                    cmap = chunk_maps.get(key_str)
+                    stored = cmap.get(layer_idx) if cmap else None
+                else:
+                    stored = self.client.get_layer_raw(key_str, layer_idx)
+                if stored is None:
+                    continue
+                k_host, v_host = stored
+                chunk_blocks.append((k_host, v_host))
+                slot_mappings.append(slot_mapping_slice)
+                starts_local.append(start)
+            if not chunk_blocks:
+                continue
+            _paged_fill_layer_coalesced(
+                self.kvcaches,
+                layer_idx,
+                chunk_blocks,
+                slot_mappings,
+                starts_local,
+                self.block_size,
+                full_slot_mapping=slot_mapping,
+                dp_size=self.dp_size,
+                tp_size=self.tp_size,
+                dp_axis=self.dp_axis,
+                tp_axis=self.tp_axis,
+                blocks_per_dp=self.blocks_per_dp,
+                aux_cache=aux_cache,
+                timing=restore_timing,
+                arena=self._fill_arena,
+            )
+        # Free the shared layer-invariant auxiliaries built once above.
+        if aux_cache:
+            import ttnn as _ttnn
+
+            # With the trace-safe arena the aux tensors ARE arena buffers (reserved
+            # before trace capture and reused every request); freeing them would put
+            # the post-capture alloc/dealloc churn right back.
+            if self._fill_arena is None:
+                for _t in aux_cache.values():
+                    try:
+                        _ttnn.deallocate(_t)
+                    except Exception:  # noqa: BLE001
+                        pass
+            aux_cache.clear()
+        _t_end = _time.monotonic()
+        self.client._record_trace(
+            "remote.batched_get",
+            "background",
+            _t0,
+            _t_end,
+            tid=13,
+            args={"n_chunks": int(len(chunk_meta))},
+        )
+        # The per-layer restore (paged-fill) loop above was timed only into the
+        # trace span (tid=13), so its cost stayed
+        # invisible in /stats and was silently folded into the server's warm
+        # TTFT. Surface it as its own op so the profiler can decompose
+        # warm_ttft into GET(wire) + restore + forward instead of one opaque
+        # number. bytes=0: this is a device-side scatter, not a wire transfer,
+        # so MBps is meaningless here. No-op unless T3KNIC_PROFILE is set. The
+        # per-substep breakdown (to_device/concat/aux_build/kernel/dealloc) lets
+        # us localize the residual and re-evaluate GET_ONDEV (which removes the
+        # to_device D2H-reupload half of the round-trip).
+        self.client._record_op(
+            "restore_group",
+            0,
+            _t_end - _t0,
+            breakdown=restore_timing if restore_timing else None,
+        )
+
+    def batched_from_gpu(
+        self,
+        memory_objs: Union[List[List[MemoryObj]], List[MemoryObj]],
+        starts: List[int],
+        ends: List[int],
+        **kwargs: object,
+    ) -> None:
+        """Batched ``from_gpu``. Iterates ``from_gpu`` per chunk."""
+        for memory_obj, start, end in zip(memory_objs, starts, ends, strict=False):
+            self.from_gpu(memory_obj, start, end, **kwargs)  # type: ignore[arg-type]
+
+    def get_shape(self, num_tokens: int) -> torch.Size:
+        """Return the placeholder ``MemoryObj`` shape for ``num_tokens`` tokens.
+
+        Layout: ``[kv_dim, num_layers, num_tokens, hidden_dim_size]`` --
+        same as the default vLLM KV_2LTD / KV_MLA_FMT layout. Used by
+        LMCache only to size the placeholder buffer; the bytes are never
+        the source of truth on TT.
+        """
+        return torch.Size([self.kv_dim, self.num_layers, num_tokens, self.hidden_dim_size])
