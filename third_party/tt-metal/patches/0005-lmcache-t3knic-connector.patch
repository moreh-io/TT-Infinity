@@ -0,0 +1,102 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Minimal LMCache compatibility hooks required by the T3K NIC connector."""
+
+from __future__ import annotations
+
+import logging
+
+import torch
+
+logger = logging.getLogger(__name__)
+_APPLIED = False
+
+
+class _NullStream:
+    """CPU stand-in for the stream surface used by LMCache."""
+
+    def __init__(self, *args, **kwargs):
+        pass
+
+    def wait_stream(self, _other) -> None:
+        pass
+
+    def synchronize(self) -> None:
+        pass
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *_args) -> None:
+        return None
+
+    def __bool__(self) -> bool:
+        return True
+
+
+class _CpuTorchDev:
+    """Minimal ``torch.cuda``-like device API expected by LMCache."""
+
+    @staticmethod
+    def device_count() -> int:
+        return 1
+
+    @staticmethod
+    def current_device() -> int:
+        return 0
+
+    @staticmethod
+    def set_device(_worker_id: int) -> None:
+        pass
+
+    @staticmethod
+    def is_available() -> bool:
+        return True
+
+    @staticmethod
+    def Stream(*args, **kwargs):
+        return _NullStream()
+
+
+def apply() -> None:
+    """Install the TT connector injection and CPU-side LMCache device hooks."""
+    global _APPLIED
+    if _APPLIED:
+        return
+
+    try:
+        from lmcache.integration.vllm import utils as lmcache_vllm_utils
+        from lmcache.integration.vllm import vllm_v1_adapter
+        import lmcache.v1.gpu_connector as gpu_connector_module
+    except ImportError:
+        return
+
+    original_get_vllm_torch_dev = lmcache_vllm_utils.get_vllm_torch_dev
+
+    def get_vllm_torch_dev_with_cpu_fallback():
+        try:
+            return original_get_vllm_torch_dev()
+        except RuntimeError:
+            return _CpuTorchDev, "cpu"
+
+    lmcache_vllm_utils.get_vllm_torch_dev = get_vllm_torch_dev_with_cpu_fallback
+
+    from lmcache_t3knic.factory import (
+        CreateTTNPUConnector,
+        set_original_create_gpu_connector,
+    )
+
+    set_original_create_gpu_connector(gpu_connector_module.CreateGPUConnector)
+    gpu_connector_module.CreateGPUConnector = CreateTTNPUConnector
+
+    original_v1_init = vllm_v1_adapter.LMCacheConnectorV1Impl.__init__
+
+    def v1_init_with_cpu_device(self, *args, **kwargs):
+        original_v1_init(self, *args, **kwargs)
+        # vLLM's TT device is a MeshDevice. LMCache only uses this field for
+        # torch metadata such as slot mappings, which must remain on the CPU.
+        self.device = torch.device("cpu")
+
+    vllm_v1_adapter.LMCacheConnectorV1Impl.__init__ = v1_init_with_cpu_device
+
+    logger.info("lmcache_t3knic: installed TT connector compatibility hooks")
+    _APPLIED = True
diff --git a/lmcache-t3knic/lmcache_t3knic/runtime.py b/lmcache-t3knic/lmcache_t3knic/runtime.py
new file mode 100644
index 0000000000000000000000000000000000000000..7d0ea3417609840b76fe4a7bd6828be3d723b39d
--- /dev/null
+++ b/lmcache-t3knic/lmcache_t3knic/runtime.py
@@ -0,0 +1,382 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Runtime binding for immutable cache and transfer descriptors."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Mapping, Sequence
+
+import torch
+from lmcache.c_ops import TransferDirection
+
+from .specs import (
+    BlockDistribution,
+    CacheAddressSpace,
+    TransferDescriptor,
+    SplitPrefixPolicy,
+    TensorDistribution,
+    TensorDistributionKind,
+    MeshParallelRole,
+    TransferBackendKind,
+    TransferGroupDescriptor,
+    TransferPlan,
+    TransferPolicy,
+    MemoryObjMemberSpec,
+    descriptor_to_json_value,
+    fingerprint,
+    single_group_profile,
+    validate_handles,
+)
+from .specs.validation import require_exact_keys
+
+TRANSFER_DESCRIPTOR_KEY = "moreh_lmcache_transfer_descriptor"
+_MEMORY_OBJ_DTYPES = {"uint8": torch.uint8}
+
+
+def _tensor_distribution_from_dict(value: Mapping[str, Any]) -> TensorDistribution:
+    require_exact_keys("tensor distribution", value, {"kind", "mesh_role", "tensor_axis"})
+    return TensorDistribution(
+        kind=TensorDistributionKind(value["kind"]),
+        mesh_role=None if value["mesh_role"] is None else MeshParallelRole(value["mesh_role"]),
+        tensor_axis=None if value["tensor_axis"] is None else int(value["tensor_axis"]),
+    )
+
+
+def _group_from_dict(value: Mapping[str, Any]) -> TransferGroupDescriptor:
+    require_exact_keys(
+        "transfer group", value, {"group_id", "layer_id", "block_size", "memory_obj_members", "plan", "policy"}
+    )
+    plan = value["plan"]
+    require_exact_keys(
+        "transfer plan",
+        plan,
+        {
+            "backend_kind",
+            "address_space",
+            "block_distribution",
+            "tensor_parallel_size",
+            "member_tensor_distributions",
+        },
+    )
+    block_distribution = plan["block_distribution"]
+    require_exact_keys(
+        "block distribution",
+        block_distribution,
+        {"data_parallel_size", "context_parallel_size", "context_block_interleave"},
+    )
+    policy = value["policy"]
+    require_exact_keys("transfer policy", policy, {"allocation_alignment", "prefix_alignment", "split_prefix"})
+    memory_obj_members = value["memory_obj_members"]
+    for member in memory_obj_members:
+        require_exact_keys(
+            "MemoryObj member",
+            member,
+            {"member_id", "shape_tail", "dtype", "bytes_per_block", "bytes_per_token"},
+        )
+    return TransferGroupDescriptor(
+        group_id=str(value["group_id"]),
+        layer_id=int(value["layer_id"]),
+        block_size=int(value["block_size"]),
+        memory_obj_members=tuple(
+            MemoryObjMemberSpec(
+                member_id=str(member["member_id"]),
+                shape_tail=tuple(int(dim) for dim in member["shape_tail"]),
+                dtype=_MEMORY_OBJ_DTYPES[str(member["dtype"])],
+                bytes_per_block=int(member["bytes_per_block"]),
+                bytes_per_token=int(member["bytes_per_token"]),
+            )
+            for member in memory_obj_members
+        ),
+        plan=TransferPlan(
+            backend_kind=TransferBackendKind(plan["backend_kind"]),
+            address_space=CacheAddressSpace(plan["address_space"]),
+            block_distribution=BlockDistribution(
+                data_parallel_size=int(block_distribution["data_parallel_size"]),
+                context_parallel_size=int(block_distribution["context_parallel_size"]),
+                context_block_interleave=int(block_distribution["context_block_interleave"]),
+            ),
+            tensor_parallel_size=int(plan["tensor_parallel_size"]),
+            member_tensor_distributions=tuple(
+                _tensor_distribution_from_dict(item) for item in plan["member_tensor_distributions"]
+            ),
+        ),
+        policy=TransferPolicy(
+            allocation_alignment=int(policy["allocation_alignment"]),
+            prefix_alignment=int(policy["prefix_alignment"]),
+            split_prefix=SplitPrefixPolicy(policy["split_prefix"]),
+        ),
+    )
+
+
+def descriptor_payload(descriptor: TransferDescriptor) -> dict[str, Any]:
+    """Encode the transfer descriptor for the prefiller-to-decoder handshake.
+
+    Every group carries the same geometry -- the connector, the backend and the
+    allocator profile all require it -- and only the ``(group_id, layer_id)``
+    identity actually varies. Serializing one profile plus the identities keeps
+    a 92-layer payload around a kilobyte instead of repeating the same body 92
+    times, and the fingerprint then covers one copy rather than 92 identical
+    ones. What is reconstructed on the far side is unchanged.
+    """
+
+    profile = single_group_profile(
+        descriptor.transfer_groups,
+        requirement=f"{TRANSFER_DESCRIPTOR_KEY} carries one transfer profile for every layer",
+    )
+    body = descriptor_to_json_value(profile)
+    body.pop("group_id")
+    body.pop("layer_id")
+    groups = [{"group_id": group.group_id, "layer_id": group.layer_id} for group in descriptor.transfer_groups]
+    content = {"profile": body, "groups": groups}
+    return {"fingerprint": fingerprint(content), **content}
+
+
+def transfer_groups_from_payload(payload: Mapping[str, Any]) -> tuple[TransferGroupDescriptor, ...]:
+    try:
+        require_exact_keys(TRANSFER_DESCRIPTOR_KEY, payload, {"fingerprint", "profile", "groups"})
+        body = payload["profile"]
+        if not isinstance(body, Mapping):
+            raise TypeError("transfer profile must be a mapping")
+        entries = []
+        for group in payload["groups"]:
+            require_exact_keys("transfer group identity", group, {"group_id", "layer_id"})
+            entries.append(_group_from_dict({**body, "group_id": group["group_id"], "layer_id": group["layer_id"]}))
+        entries = tuple(entries)
+    except (KeyError, TypeError, ValueError) as exc:
+        raise ValueError(f"invalid {TRANSFER_DESCRIPTOR_KEY}: {exc}") from exc
+    content = {"profile": payload["profile"], "groups": payload["groups"]}
+    if payload.get("fingerprint") != fingerprint(content):
+        raise ValueError(f"{TRANSFER_DESCRIPTOR_KEY} fingerprint does not match its contents")
+    layer_ids = tuple(group.layer_id for group in entries)
+    group_ids = tuple(group.group_id for group in entries)
+    if not entries or len(layer_ids) != len(set(layer_ids)) or len(group_ids) != len(set(group_ids)):
+        raise ValueError(f"{TRANSFER_DESCRIPTOR_KEY} must contain unique layer and group entries")
+    return entries
+
+
+def memory_obj_profile(payload: Mapping[str, Any]) -> TransferGroupDescriptor:
+    """Return the one LMCache MemoryObj allocation profile or reject the worker.
+
+    The descriptor remains group-complete. The binding constraint is LMCache's
+    layerwise ABI: ``get_shape(self, num_tokens)`` carries no ``layer_id``, so a
+    connector can only answer with one shape for every layer. The allocator is
+    not the constraint -- upstream builds heterogeneous layer groups in
+    ``kv_layer_groups.build_kv_layer_groups`` and the stock allocator admits
+    smaller shapes -- so this is our own single-profile requirement, not a
+    limit LMCache imposes. No member-count restriction is imposed here.
+    """
+
+    return single_group_profile(
+        transfer_groups_from_payload(payload),
+        requirement="LMCache 0.4 requires one MemoryObj profile per worker connector",
+    )
+
+
+def inspect_handle(handle: object) -> tuple[tuple[int, ...], object, object, object, tuple[int, ...]]:
+    memory_config = getattr(handle, "memory_config", None)
+    memory_config = memory_config() if callable(memory_config) else memory_config
+    device = getattr(handle, "device", None)
+    device = device() if callable(device) else device
+    get_device_ids = getattr(device, "get_device_ids", None)
+    if callable(get_device_ids):
+        devices = tuple(int(index) for index in get_device_ids())
+    else:
+        device_id = getattr(device, "id", None)
+        device_id = device_id() if callable(device_id) else device_id
+        devices = () if device_id is None else (int(device_id),)
+    return (
+        tuple(int(dim) for dim in getattr(handle, "shape")),
+        getattr(handle, "dtype", None),
+        getattr(handle, "layout", None),
+        memory_config,
+        devices,
+    )
+
+
+def bind_handles(
+    descriptor: TransferDescriptor,
+    handles_by_owner: Mapping[str, Sequence[object]],
+) -> tuple[tuple[object, ...], ...]:
+    validate_handles(descriptor.local_cache, handles_by_owner, inspect_handle)
+    return tuple(
+        tuple(handles_by_owner[member.cache_owner_key][member.handle_index] for member in group.members)
+        for group in descriptor.local_cache.cache_groups
+    )
+
+
+@dataclass(frozen=True, slots=True)
+class BlockTransferBinding:
+    """The complete request-varying input for paged-block transfer."""
+
+    direction: TransferDirection
+    starts: tuple[int, ...]
+    ends: tuple[int, ...]
+    source_starts: tuple[int, ...]
+    slot_mapping: torch.Tensor
+
+    def __post_init__(self) -> None:
+        if not isinstance(self.direction, TransferDirection):
+            raise ValueError("invalid block transfer direction")
+        count = len(self.starts)
+        if not (count == len(self.ends) == len(self.source_starts)):
+            raise ValueError("block transfer binding ranges must have equal lengths")
+        if self.slot_mapping.device.type != "cpu" or self.slot_mapping.dtype != torch.long:
+            raise ValueError("block transfer slot mapping must be a CPU int64 tensor")
+        if not self.slot_mapping.is_contiguous():
+            raise ValueError("block transfer slot mapping must be contiguous")
+
+
+def lower_block_binding(
+    descriptor: TransferDescriptor,
+    *,
+    direction: TransferDirection,
+    starts: Sequence[int],
+    ends: Sequence[int],
+    slot_mapping: torch.Tensor,
+    source_starts: Sequence[int] | None = None,
+) -> BlockTransferBinding:
+    """Validate and lower vLLM token slots once to the block backend contract."""
+
+    profile = descriptor.transfer_groups[0]
+    block_size = profile.block_size
+    starts_tuple = tuple(int(value) for value in starts)
+    ends_tuple = tuple(int(value) for value in ends)
+    if source_starts is None:
+        source_tuple = (0,) * len(starts_tuple)
+    else:
+        source_tuple = tuple(int(value) for value in source_starts)
+    if not (len(starts_tuple) == len(ends_tuple) == len(source_tuple)):
+        raise ValueError("transfer starts, ends, and source starts must have equal lengths")
+
+    # For the usual CPU int64 contiguous input this is a no-op chain, so `slots`
+    # aliases the caller's tensor and the frozen binding does not own its slot
+    # mapping. That is safe because the planners consume slot_mapping
+    # synchronously on this thread -- build_*_region_raw_mesh_runs copies it into
+    # value-typed byte runs before any enqueue, and the enqueue carries only the
+    # MemoryObj payload pointer -- and every producer allocates a fresh mapping
+    # per request. Copy defensively if either of those stops holding.
+    slots = slot_mapping.detach().to(device="cpu", dtype=torch.long).contiguous()
+    if bool(torch.any(slots < -1)):
+        raise ValueError("slot mapping values must be -1 or non-negative")
+
+    for start, end, source_start in zip(starts_tuple, ends_tuple, source_tuple, strict=True):
+        if start < 0 or end <= start or end > int(slots.numel()):
+            raise ValueError("transfer ranges must be non-empty and covered by the slot mapping")
+        if start % block_size:
+            raise ValueError(
+                f"paged-block transfer starts must be block-aligned: start={start}, block_size={block_size}"
+            )
+        if source_start < 0 or source_start % block_size:
+            raise ValueError(
+                f"paged-block source offsets must be block-aligned: source_start={source_start}, block_size={block_size}"
+            )
+        active = slots[start:end]
+        if bool(torch.any(active < 0)):
+            raise ValueError("active paged-block transfer ranges cannot contain padding slots")
+        logical_offsets = torch.arange(start, end, dtype=torch.long) % block_size
+        if not torch.equal(active % block_size, logical_offsets):
+            raise ValueError("slot mapping is not sequential within physical cache blocks")
+        if active.numel() > 1:
+            positions = torch.arange(start, end, dtype=torch.long)
+            same_logical_block = positions[1:].div(block_size, rounding_mode="floor") == positions[:-1].div(
+                block_size, rounding_mode="floor"
+            )
+            if bool(torch.any(same_logical_block & (active[1:] != active[:-1] + 1))):
+                raise ValueError("slot mapping contains a non-contiguous intra-block range")
+    _validate_backend_capacity(descriptor, slots, starts_tuple, ends_tuple)
+
+    return BlockTransferBinding(
+        direction=direction,
+        starts=starts_tuple,
+        ends=ends_tuple,
+        source_starts=source_tuple,
+        slot_mapping=slots,
+    )
+
+
+def _validate_backend_capacity(
+    descriptor: TransferDescriptor,
+    slots: torch.Tensor,
+    starts: tuple[int, ...],
+    ends: tuple[int, ...],
+) -> None:
+    """Reject page IDs the selected native planner cannot address."""
+
+    profile = descriptor.transfer_groups[0]
+    block_size = profile.block_size
+    block_distribution = profile.plan.block_distribution
+    if block_distribution.context_parallel_size == 1:
+        block_capacity = descriptor.local_cache.num_blocks * block_distribution.data_parallel_size
+        for start, end in zip(starts, ends, strict=True):
+            block_slots = slots[start:end:block_size]
+            if bool(torch.any(block_slots.div(block_size, rounding_mode="floor") >= block_capacity)):
+                raise ValueError(
+                    "paged-block slot mapping exceeds "
+                    f"{profile.plan.backend_kind.value} capacity of {block_capacity} blocks"
+                )
+        return
+
+    cp_size = block_distribution.context_parallel_size
+    blocks_per_rank = descriptor.local_cache.num_blocks
+    group_tokens = block_size * cp_size
+    relevant_groups: dict[int, int] = {}
+    for start, end in zip(starts, ends, strict=True):
+        for position in range(start, end, block_size):
+            local_virtual_block = (position // block_size) // cp_size
+            relevant_groups.setdefault(local_virtual_block, int(slots[position]))
+
+    for local_virtual_block, fallback_slot in relevant_groups.items():
+        group_start = local_virtual_block * group_tokens
+        group_end = min(group_start + group_tokens, int(slots.numel()))
+        if 0 <= group_start < group_end:
+            group_slots = slots[group_start:group_end]
+            present = group_slots >= 0
+            observed_slots = group_slots[present]
+        else:
+            observed_slots = slots.new_empty((0,))
+        if observed_slots.numel() == 0:
+            physical_block = fallback_slot // block_size
+        else:
+            observed_blocks = observed_slots.div(block_size, rounding_mode="floor")
+            first_block = observed_blocks[0]
+            if bool(torch.all(observed_blocks == first_block)):
+                physical_block = int(first_block)
+            else:
+                positions = torch.arange(group_start, group_end, dtype=torch.long)[present]
+                cp_block_offsets = positions.remainder(group_tokens).div(block_size, rounding_mode="floor")
+                observed_bases = observed_blocks - cp_block_offsets
+                first_base = observed_bases[0]
+                if not bool(torch.all(observed_bases == first_base)):
+                    raise ValueError("block-cyclic slot mapping has inconsistent physical page IDs within a CP group")
+                physical_block = int(first_base)
+        # Mirrors the CP planner's precondition in
+        # moreh_raw_byte_copy_nanobind.cpp: it rejects physical_block <= 0 and
+        # out-of-range blocks with std::nullopt, which surfaces as TT_FATAL.
+        # Rejecting here keeps that a ValueError instead of a device abort.
+        if physical_block <= 0:
+            raise ValueError(
+                "block-cyclic slot mapping resolves to page id 0, which vLLM reserves as the null block: "
+                f"physical_block={physical_block}"
+            )
+        if physical_block >= blocks_per_rank:
+            raise ValueError(
+                "block-cyclic slot mapping resolves outside owner-local capacity: "
+                f"physical_block={physical_block}, blocks_per_rank={blocks_per_rank}"
+            )
+
+
+def placeholder_shapes(group: TransferGroupDescriptor, num_blocks: int) -> tuple[tuple[int, ...], ...]:
+    return tuple((int(num_blocks), group.block_size, *member.shape_tail) for member in group.memory_obj_members)
+
+
+__all__ = [
+    "TRANSFER_DESCRIPTOR_KEY",
+    "BlockTransferBinding",
+    "bind_handles",
+    "descriptor_payload",
+    "memory_obj_profile",
+    "inspect_handle",
+    "lower_block_binding",
+    "placeholder_shapes",
+    "transfer_groups_from_payload",
+]
