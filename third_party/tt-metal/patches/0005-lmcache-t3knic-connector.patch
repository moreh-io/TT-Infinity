+#!/usr/bin/env python3
+# SPDX-FileCopyrightText: (c) 2026 Moreh
+#
+# SPDX-License-Identifier: Apache-2.0
+
+"""TTFT for a cross-node KV cache hit: send one cold and at least two warm requests.
+
+The first request misses and stores the KV. Later requests restore it over the cable, and the
+warm responses are compared with one another.
+
+    python3 t3knic_ttft.py                      # 3 requests, ISL 3296 / OSL 16
+    python3 t3knic_ttft.py --requests 5         # more warm samples
+    python3 t3knic_ttft.py --base http://host:8000
+
+Measures only the requests: it assumes a server is already up, and does not touch the cable, the
+device locks, or the link state. Start the server however the deployment does, then run this.
+
+For the number to mean anything the server must be started with vLLM's own prefix caching OFF
+(`--no-enable-prefix-caching`); otherwise the second request hits vLLM's cache and never reaches
+the connector. The script reports the engine's prompt_tokens so a run can prove it sent ISL 3296.
+
+What counts as correct here needs saying, because the obvious check is the wrong one. A warm
+answer is NOT required to match the cold one. A cold request prefills all 3296 tokens in one
+pass; a warm request restores whole 128-token blocks and forwards only the ragged tail. Those two
+reduce in a different order, so their floating point can differ, and far enough into a greedy
+decode that can flip a token. That is arithmetic, not a broken cache.
+
+What IS required is that every warm answer matches every other warm answer: they all take the
+same path, so any disagreement between them means the restore is not deterministic. That is the
+check this script fails on.
+
+Neither check proves the restored KV equals the stored KV -- deterministically wrong is still
+wrong. `T3KNIC_KVDIFF=1` is what proves that: it digests the KV at the store and load boundaries
+and compares them. Run it when the question is correctness; leave it off when the question is
+speed, because it costs a device round trip per chunk.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import pathlib
+import time
+import urllib.request
+
+DEFAULT_PROMPT = pathlib.Path(__file__).with_name("prompt_isl3296.txt")
+
+
+def _model(base: str, timeout: float) -> str:
+    with urllib.request.urlopen(base + "/v1/models", timeout=timeout) as r:
+        return json.loads(r.read())["data"][0]["id"]
+
+
+def one_request(base: str, model: str, prompt: str, max_tokens: int, timeout: float):
+    """Stream one completion. Returns (ttft_s, total_s, text, prompt_tokens)."""
+    body = json.dumps(
+        {
+            "model": model,
+            "prompt": prompt,
+            "max_tokens": max_tokens,
+            "temperature": 0,
+            "stream": True,
+            "stream_options": {"include_usage": True},
+        }
+    ).encode()
+    req = urllib.request.Request(base + "/v1/completions", data=body, headers={"Content-Type": "application/json"})
+    start = time.monotonic()
+    ttft = None
+    text = ""
+    prompt_tokens = None
+    with urllib.request.urlopen(req, timeout=timeout) as r:
+        for raw in r:
+            line = raw.decode(errors="replace").strip()
+            if not line.startswith("data:"):
+                continue
+            payload = line[5:].strip()
+            if payload == "[DONE]":
+                continue
+            try:
+                chunk = json.loads(payload)
+            except ValueError:
+                continue
+            usage = chunk.get("usage")
+            if usage and usage.get("prompt_tokens"):
+                prompt_tokens = usage["prompt_tokens"]
+            choices = chunk.get("choices") or []
+            piece = choices[0].get("text", "") if choices else ""
+            if piece and ttft is None:
+                ttft = time.monotonic() - start
+            text += piece
+    return ttft, time.monotonic() - start, text, prompt_tokens
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--base", default="http://localhost:8000", help="OpenAI-compatible server base URL")
+    ap.add_argument("--prompt", type=pathlib.Path, default=DEFAULT_PROMPT, help="prompt file (default: ISL 3296)")
+    ap.add_argument(
+        "--prompt-tokens",
+        type=int,
+        help="generate a synthetic prompt with exactly this many tokenizer tokens instead of reading --prompt",
+    )
+    ap.add_argument(
+        "--requests", type=int, default=3, help="how many times to send it (default 3: one cold, two warm to compare)"
+    )
+    ap.add_argument("--max-tokens", type=int, default=16, help="OSL (default 16)")
+    ap.add_argument("--timeout", type=float, default=900.0, help="per-request timeout in seconds")
+    ap.add_argument(
+        "--inter-request-delay",
+        type=float,
+        default=0.0,
+        help="seconds to wait after each request so asynchronous cache stores can finish",
+    )
+    ap.add_argument("--prime-resumed-tail", type=int, help="run only an untimed cold+extended pair with this tail size")
+    ap.add_argument("--prime-prefix-tokens", type=int, default=4096, help="prefix size for --prime-resumed-tail")
+    args = ap.parse_args()
+
+    model = _model(args.base, args.timeout)
+    if args.prime_resumed_tail is not None:
+        if args.prime_prefix_tokens <= 0 or args.prime_resumed_tail <= 0:
+            ap.error("prime prefix and tail token counts must be positive")
+        from transformers import AutoTokenizer
+
+        tokenizer = AutoTokenizer.from_pretrained(model, local_files_only=True)
+        lengths = (args.prime_prefix_tokens, args.prime_prefix_tokens + args.prime_resumed_tail)
+        prompts = tuple(" the" * length for length in lengths)
+        actual = tuple(len(tokenizer.encode(prompt, add_special_tokens=False)) for prompt in prompts)
+        if actual != lengths:
+            raise RuntimeError(f"resumed-prefill prime token mismatch: requested {lengths}, got {actual}")
+        print(f"model={model}  priming resumed prefill: prefix={lengths[0]} tail={args.prime_resumed_tail}")
+        for index, (length, prompt) in enumerate(zip(lengths, prompts)):
+            ttft, total, _, prompt_tokens = one_request(args.base, model, prompt, 1, args.timeout)
+            print(f"  prime{index + 1} ISL={prompt_tokens or length} ttft={ttft:.3f}s total={total:.3f}s")
+            if index == 0 and args.inter_request_delay > 0:
+                time.sleep(args.inter_request_delay)
+        return 0
+
+    if args.prompt_tokens is not None:
+        if args.prompt_tokens <= 0:
+            ap.error("--prompt-tokens must be positive")
+        from transformers import AutoTokenizer
+
+        tokenizer = AutoTokenizer.from_pretrained(model, local_files_only=True)
+        prompt = " the" * args.prompt_tokens
+        actual_tokens = len(tokenizer.encode(prompt, add_special_tokens=False))
+        if actual_tokens != args.prompt_tokens:
+            raise RuntimeError(
+                f"synthetic prompt token count mismatch: requested {args.prompt_tokens}, got {actual_tokens}"
+            )
+        prompt_name = f"synthetic_isl{args.prompt_tokens}"
+    else:
+        prompt = args.prompt.read_text()
+        prompt_name = args.prompt.name
+    print(f"model={model}  prompt={prompt_name}  OSL={args.max_tokens}")
+
+    results = []
+    for i in range(args.requests):
+        label = "cold" if i == 0 else f"warm{i}"
+        ttft, total, text, ptok = one_request(args.base, model, prompt, args.max_tokens, args.timeout)
+        results.append((label, ttft, total, text))
+        isl = f"ISL={ptok}" if ptok else "ISL=?"
+        shown = text.replace("\n", " ")[:60]
+        print(f"  {label:6s} ttft={ttft:.3f}s total={total:.3f}s {isl}  -> {shown}")
+        if i + 1 < args.requests and args.inter_request_delay > 0:
+            time.sleep(args.inter_request_delay)
+
+    cold = results[0]
+    warms = results[1:]
+    if warms and cold[1] and all(w[1] for w in warms):
+        best = min(w[1] for w in warms)
+        print(f"\ncold {cold[1]:.3f}s -> warm {best:.3f}s  ({cold[1] / best:.2f}x)")
+    # The invariant: every warm answer takes the same path, so they must agree with each other.
+    disagreeing = [w[0] for w in warms[1:] if w[3] != warms[0][3]]
+    if disagreeing:
+        print(f"FAIL: {', '.join(disagreeing)} disagree with {warms[0][0]} -- the restore is not deterministic")
+        return 1
+
+    # Cold may legitimately differ (see the module docstring): report where, and let the reader
+    # judge. A divergence in the first token or two is worth chasing; one near the end is the
+    # tail forward's arithmetic.
+    if warms and warms[0][3] != cold[3]:
+        warm_text = warms[0][3]
+        limit = min(len(warm_text), len(cold[3]))
+        at = next((i for i in range(limit) if warm_text[i] != cold[3][i]), limit)
+        print(f"\nwarm agrees with warm; differs from cold from character {at} of {len(cold[3])}")
+        print(f"  cold: ...{cold[3][at:at + 40]!r}")
+        print(f"  warm: ...{warm_text[at:at + 40]!r}")
+        print("  (expected: cold prefills in one pass, warm restores blocks and forwards the tail.")
+        print("   Run with T3KNIC_KVDIFF=1 to compare the KV itself rather than what it decodes to.)")
+    elif warms:
+        print("all responses identical, cold included")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
