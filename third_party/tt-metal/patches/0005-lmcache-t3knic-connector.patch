@@ -0,0 +1,39 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Scheduler-to-worker metadata for t3knic lazy eviction offload.
+
+The t3knic connector normally returns the wrapped LMCache child's
+``KVConnectorMetadata`` straight from ``build_connector_meta``. In ``lazy``
+store-mode we instead return this wrapper, which:
+
+- carries the child's metadata under ``per_child`` (a length-1 tuple), so the
+  worker can unwrap it and hand the child exactly the ``LMCacheConnectorMetadata``
+  it asserts on (``vllm_v1_adapter`` start_load_kv/save), AND so
+  ``kv_transfer_utils.kv_metadata_has_load_work`` still detects the child's load
+  work because that helper recursively inspects ``per_child``;
+- carries ``store_specs`` -- the evict-imminent block ids and wire keys the
+  scheduler selected this step. The worker turns these into wire PUTs.
+  Physical/global block ids require dp==1.
+
+Kept a plain picklable dataclass (rides ``SchedulerOutput.kv_connector_metadata``
+to the worker via the normal serialization path).
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Optional
+
+from vllm.distributed.kv_transfer.kv_connector.v1.base import KVConnectorMetadata
+
+
+@dataclass
+class T3knicOffloadMetadata(KVConnectorMetadata):
+    # Length-1 tuple ``(child_meta,)`` (empty if no child). Named ``per_child``
+    # so kv_metadata_has_load_work recurses into it.
+    per_child: tuple = field(default_factory=tuple)
+    # Evict-imminent block ids the scheduler touch()-pinned this step.
+    store_specs: tuple = field(default_factory=tuple)
+
+    @property
+    def child_meta(self) -> Optional[KVConnectorMetadata]:
+        return self.per_child[0] if self.per_child else None
diff --git a/lmcache-t3knic/lmcache_t3knic/t3knic_lmcache/tt_connector_adapter.py b/lmcache-t3knic/lmcache_t3knic/t3knic_lmcache/tt_connector_adapter.py
