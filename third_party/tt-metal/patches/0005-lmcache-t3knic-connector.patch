+# SPDX-FileCopyrightText: (c) 2026 Moreh
+#
+# SPDX-License-Identifier: Apache-2.0
+
+"""Bind the product lifecycle package to TTNN's device operations."""
+
+from __future__ import annotations
+
+import importlib
+
+
+def _resolve():
+    try:
+        product = importlib.import_module("kvcache_manager")
+    except ImportError as exc:
+        raise ImportError(
+            "lmcache-t3knic requires the external kvcache-manager package built " "against this TTNN installation"
+        ) from exc
+
+    try:
+        operations = importlib.import_module("ttnn.kvcache_manager")
+    except ImportError as exc:
+        raise ImportError("lmcache-t3knic requires TTNN with the kvcache_manager device operations") from exc
+
+    missing_product = [name for name in ("Client", "Server") if not hasattr(product, name)]
+    required_operations = (
+        "MAX_CLIENTS",
+        "gather_tp_shards_to_chip",
+        "scatter_chunk_from_chip",
+        "pack_local_shards",
+        "unpack_local_shards",
+        "reserve_gather_resources",
+        "release_gather_resources",
+    )
+    missing_operations = [name for name in required_operations if not hasattr(operations, name)]
+    if missing_product or missing_operations:
+        details = []
+        if missing_product:
+            details.append("product package missing " + ", ".join(missing_product))
+        if missing_operations:
+            details.append("TTNN operations missing " + ", ".join(missing_operations))
+        raise ImportError("incompatible kvcache-manager installation: " + "; ".join(details))
+
+    return product, operations
+
+
+kvcache_manager, kvcache_operations = _resolve()
+
+__all__ = ["kvcache_manager", "kvcache_operations"]
