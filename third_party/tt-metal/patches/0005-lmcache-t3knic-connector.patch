@@ -0,0 +1,3646 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Client wrapper around the ``ttnn.kvcache_manager`` bindings (MAF-19909).
+
+This module owns the **pending-op registries** that bridge TTGPUConnector
+(which has the device-side context: kvcaches, slot_mapping) and
+TTRemoteConnector (which has the chunk key). LMCache's
+``GPUConnectorInterface.batched_from_gpu`` / ``batched_to_gpu`` do not
+receive the ``CacheEngineKey``, so the GPU connector cannot directly tell
+the remote connector which chunk it is working on. The two share an
+id(memory_obj) -> info dict through this client instance instead:
+``from_gpu`` registers a pending-send entry, ``put`` pops it. The reverse
+path (``get`` registers a pending-get entry that ``to_gpu`` pops) handles
+the LOAD side symmetrically.
+"""
+
+import itertools
+import os
+import secrets
+import time
+import weakref
+from collections import OrderedDict, defaultdict, deque
+from dataclasses import dataclass
+from threading import Lock
+from typing import Any, Deque, Dict, Optional, Tuple, TYPE_CHECKING
+
+import torch
+
+from lmcache_t3knic.t3knic_lmcache import tt_kv_serde
+
+from lmcache.logging import init_logger
+
+# Mirrors RawByteCodec.HEADER_ALIGN. Duplicated on purpose: the blob is sized in open(), before
+# the codec exists, and the two must agree or the pre-allocated blob is the wrong size.
+_RAW_HEADER_ALIGN = 32
+
+
+logger = init_logger(__name__)
+
+
+def _profile_enabled() -> bool:
+    """Check the T3KNIC_PROFILE env var (default OFF).
+
+    Accepts "1", "true", "yes", "on" (case-insensitive). Anything else
+    disables the per-op stats collector entirely so production deployments
+    pay no overhead.
+    """
+    return os.environ.get("T3KNIC_PROFILE", "").strip().lower() in (
+        "1",
+        "true",
+        "yes",
+        "on",
+    )
+
+
+if TYPE_CHECKING:
+    from lmcache_t3knic.t3knic_lmcache.tt_paged_slice import PagedChunkLayout
+
+
+@dataclass(frozen=True)
+class KVChunkRef:
+    """Reference to a KV chunk that lives on the vLLM-TT device.
+
+    Created by :meth:`TTGPUConnector.from_gpu` and consumed by
+    :meth:`TTRemoteConnector.put`. The two see the same instance via
+    the pending-send registry; the data structure is the side-channel
+    payload between them.
+
+    Attributes:
+        kvcaches: vLLM-TT's ``self.kv_caches`` object
+            (``list[list[ttnn.Tensor]]``). Held as a reference, not a
+            snapshot -- callers must ensure the underlying slots are
+            still valid at consumption time. The scheduler's
+            same-command-queue execution contract keeps production
+            accesses sequential; see README §7.
+        slot_mapping_slice: The ``slot_mapping[start:end]`` slice for
+            this chunk. Used by paged-slice helpers to address the
+            chunk's rows in each layer.
+        num_layers: Number of transformer layers to iterate.
+        layout: Pre-computed :class:`PagedChunkLayout` for this chunk.
+            ``None`` when ``TTGPUConnector`` was constructed without
+            ``block_size`` (legacy / test path). When present, the
+            phase-2 slice helper consumes this directly so the per-layer
+            loop does not re-decode the same ``slot_mapping_slice`` N
+            times.
+    """
+
+    kvcaches: Any
+    slot_mapping_slice: Any
+    num_layers: int
+    layout: Optional["PagedChunkLayout"] = None
+
+
+class TTKVCacheClient:
+    """Per-vLLM-process handle to the ``kvcache_server`` daemon on the
+    paired T3K chip or the static Galaxy-to-T3K endpoint.
+
+    The client is created once at engine init (after the SubDevice split
+    between vLLM forward kernels and the kvcache_server NIC kernel is
+    in place) and reused for every put / get / exists / delete op.
+
+    Args:
+        mesh_device: The sender MeshDevice this vLLM process attaches to.
+            It may be multi-chip; ``wire_stage_coord`` selects the Client chip
+            for gather mode and per-chip mode attaches every owning chip.
+        config: Implementation-specific config dict.
+        nic_submesh: The (1, 1) submesh hosting an in-process product Server.
+            Required only in intranode mode.
+    """
+
+    # Warn once per process that the trace-capture exclusion is absent; this is on the
+    # per-chunk path and a warning per chunk would bury the log it belongs in.
+    _device_lock_warned = False
+
+    def __init__(
+        self,
+        mesh_device: object,
+        config: dict,
+        *,
+        nic_submesh: object = None,
+        paired_server: object = None,
+        parent_mesh: object = None,
+        wire_stage_coord: object = None,
+        wire_mode: object = None,
+        kv_spec: Optional[dict] = None,
+        chunk_size: Optional[int] = None,
+    ) -> None:
+        self.mesh_device = mesh_device
+        # Model-mesh coordinate of the sender chip selected for gather mode, computed by
+        # colaunch.wire_stage_coord_from_geometry from the co-launch geometry. Used
+        # as the kvcache_manager Client's coordinate on a multi-chip sender.
+        self.wire_stage_coord = tuple(wire_stage_coord) if wire_stage_coord is not None else None
+        # How a chunk reaches the Server. "device" gathers it chip-to-chip over fabric and PUTs from
+        # the gathering chip; "host" is the last-resort path that reads every shard back to the host
+        # and writes the blob down again, kept for backends that cannot do better (dict backend,
+        # single-chip sender) and for testing that path deliberately. "auto" picks device whenever
+        # the geometry allows. Env wins over the model preset so a run can be pinned without editing
+        # config. See README §2b.
+        self.wire_mode = self._resolve_wire_mode(wire_mode)
+        # Option 1-1 "global master": every PP stage funnels its chunks through ONE
+        # rank's wire client. The owner rank (T3KNIC_GM_IS_OWNER=1) resolves to its
+        # backing mode and serves a zmq REP proxy; the other ranks keep
+        # wire_mode == "global_master" and forward. v1 transport carries the chunk
+        # bytes inline over ipc://; the fabric staging ring (F2-F4) replaces that
+        # leg later without touching this mode split.
+        self._gm_role = None
+        self._gm_proxy = None
+        self._gm_fwd = None
+        self._gm_mock_store: Dict[bytes, bytes] = {}
+        if self.wire_mode == "global_master":
+            if self._resolve_gm_owner():
+                self._gm_role = "owner"
+                self.wire_mode = os.environ.get("T3KNIC_GM_OWNER_BACKEND", "device")
+                if self.wire_mode not in ("device", "mock"):
+                    raise ValueError(f"T3KNIC_GM_OWNER_BACKEND must be 'device' or 'mock'; got {self.wire_mode!r}")
+            else:
+                self._gm_role = "forwarder"
+        # Co-launch parent mesh that owns both sender and NIC submeshes.
+        self.parent_mesh = parent_mesh
+        # Mesh that owns the live cache and replicated wire blob. A Client is
+        # scoped to one coordinate rather than creating a sibling mesh view.
+        self._wire_mesh = mesh_device
+        # Which chip of the model mesh runs the wire (None = the mesh is already (1,1)).
+        self._wire_coord = None
+        # Blob tensor reused by the on-device gather/scatter path, grown on demand.
+        self._wire_blob = None
+        self._wire_blob_words = 0
+        self._gather_resources_reserved = False
+        # Per-chip wire clients, keyed by model-mesh coordinate. Only populated in "per_chip" mode,
+        # where every chip PUTs its own shard instead of routing it through one gathering chip.
+        self._shard_clients: Dict[tuple, object] = {}
+        self._external_server_shards = 1
+        self._external_lane_count = 1
+        # In mock wire mode, host memory stands in for the Server. Real plans and real
+        # on-device pack/unpack, but the wire leg is a D2H/H2D copy against this dict. Exists so the
+        # client side can be exercised on meshes that have no chip to spare for a Server (the
+        # 32-chip PP preset) before the inter-node transport lands.
+        self._mock_wire_store: Dict[bytes, tuple] = {}
+        self._mock_blob = None
+        self._mock_blob_words = 0
+        self.nic_submesh = nic_submesh
+        # The in-process Server handle is retained to enforce Client-before-Server teardown.
+        self.paired_server = paired_server
+        self._server_node = None
+        self.config = config
+        self._opened = False
+
+        # Warmup mode: when True, TTRemoteConnector.put / batched_put skip the
+        # actual wire put_layer (store) but the vLLM forward (prefill/decode
+        # kernels) still runs. Used to warm up the forward path without
+        # polluting cache state, stats, or trace. Toggled via the connector's
+        # POST /warmup_mode endpoint (T3KNIC_PROFILE). Default False.
+        self._warmup_mode = False
+
+        # The product kvcache_manager.Client is created in open() and owns the fabric attachment
+        # for this client's lifetime. ``_layer_shapes`` learns each layer's
+        # (k_shape, v_shape) on put so the caller-allocated get out_tensor
+        # can be sized correctly without side storage (all chunks share the
+        # same per-layer shape).
+        self._ttnn_client: Any = None
+        self._layer_shapes: Dict[int, Tuple[Tuple[int, ...], Tuple[int, ...]]] = {}
+
+        # Coalesced PUT/GET (MAF-19909 batch-sweep follow-up). When enabled
+        # (env T3KNIC_COALESCE), put_chunk_coalesced concatenates several
+        # layers' K (and V) tensors along dim 0 into one (G,kv_heads,block,
+        # head) tensor and issues a single Client.put per group instead of one
+        # per layer/component. This amortizes the per-call fabric handshake.
+        # Coalescing is on by default; set T3KNIC_COALESCE=0 to disable it.
+        #
+        # T3KNIC_COALESCE_CAP caps the per-put value bytes used to size coalesce
+        # groups: group size G = cap // per_layer_bytes (under T3KNIC_KV_MERGE the
+        # stored value is concat[kg, vg] = 2x the per-group K bytes, so the planner
+        # budgets 2x per layer -- see _build_group_plan). The cap defaults to the
+        # C++ wire's ACTUAL single-value limit (kMaxMultiChunkValueBytes) instead
+        # of a stale hard-coded 3 MiB, so the Python planner agrees with the wire:
+        # KVM_COMMON_MAX_VALUE_BYTES if set (the same env the Server/Client read),
+        # else kMaxMultiChunkValueBytesDefault = 64 MiB (packet.hpp). 32 llama
+        # layers @ 69,632 B = 2.18 MiB still coalesce into one group either way.
+        _coalesce_env = os.environ.get("T3KNIC_COALESCE", "1").strip().lower()
+        self._coalesce = _coalesce_env in ("1", "true", "yes", "on")
+        self._coalesce_cap_bytes = self._resolve_coalesce_cap()
+        # Group plan: list of layer-index lists, built once on the first
+        # coalesced put (deterministic in num_layers + per-layer byte size, so
+        # the same plan is reused by get/delete in this process). Also stores
+        # each group's K/V tensor shape so get can allocate the out tensor.
+        self._coalesce_groups: Optional[list] = None
+        self._coalesce_group_shapes: Dict[int, Tuple[Tuple[int, ...], Tuple[int, ...]]] = {}
+
+        # KV geometry. The connector
+        # resolves these from vllm_config + lmcache_config and threads them down
+        # so open() can build the coalesce group plan and pre-allocate the
+        # wire-staging buffer pool deterministically, instead of discovering the
+        # plan lazily on the first put. Device-free unit tests may omit these,
+        # but every device-backed mode requires complete geometry at open().
+        def _pos_int(v: Any) -> Optional[int]:
+            try:
+                iv = int(v)
+            except (TypeError, ValueError):
+                return None
+            return iv if iv > 0 else None
+
+        ks = kv_spec or {}
+        self._spec_num_layers = _pos_int(ks.get("num_layers"))
+        self._spec_num_kv_heads = _pos_int(ks.get("num_kv_heads_total"))
+        self._spec_head_size = _pos_int(ks.get("head_size"))
+        self._spec_block_size = _pos_int(ks.get("block_size"))
+        self._spec_chunk_size = _pos_int(chunk_size)
+        # Physical per-device bytes for one block's K+V, straight from the cache spec. Sizing the
+        # wire blob needs this and it must NOT be derived as num_kv_heads // tp_size: qwen3
+        # replicates KV heads (KV_REPEAT_COEF), so that division happens to be right at TP=4 and
+        # gives zero at TP=8.
+        self._spec_page_size_padded = _pos_int(ks.get("page_size_padded"))
+
+        # Persistent wire-staging buffer pool. Allocated once in
+        # open() and reused by every put/get instead of allocating + freeing a
+        # fresh device tensor per call. Freed only in close(). The pool is
+        # pre-allocated in open(); whether the put/get hot paths consume it is gated by
+        # ``T3KNIC_BUF_REUSE`` below. Keyed by group id (GET out-buffers) and
+        # layer index (PUT staging). Stays empty when the KV geometry above is
+        # incomplete or allocation fails.
+        self._pool_get_kg: Dict[int, Any] = {}
+        self._pool_get_vg: Dict[int, Any] = {}
+        self._pool_get_kv: Dict[int, Any] = {}  # merged K+V GET out-buffer (T3KNIC_KV_MERGE)
+        self._pool_put_stage_k: Dict[int, Any] = {}
+        self._pool_put_stage_v: Dict[int, Any] = {}
+        self._pool_allocated = False
+        self._pool_per_layer_shape: Optional[Tuple[int, ...]] = None
+        self._pool_shape_validated = False
+        # Set by _validate_pool_against_authoritative on the first put: True
+        # iff the open()-time pre-allocated per-layer shape matches the
+        # authoritative first-put shape. The reuse path is a hard no-op
+        # unless this is True (a mismatched pool must never be fed to the wire).
+        self._pool_shape_ok = False
+
+        # When T3KNIC_BUF_REUSE is on,
+        # put_chunk_coalesced / get_chunk_coalesced consume the persistent pool
+        # instead of allocating a fresh staging / out tensor per call:
+        #   * GET (G1): reuse _pool_get_kg/_vg as the Client.get out-param. A hit
+        #     fully overwrites it (client.cpp), a miss returns None without
+        #     reading it, so reusing the buffer across calls is safe.
+        #   * PUT (P1/P2): copy each layer's host K/V into the pinned
+        #     _pool_put_stage_k/_v with copy_host_to_device_tensor instead of
+        #     to_device (no per-call alloc), and skip the per-layer dealloc.
+        # Default OFF; byte-exact tests cover reuse on and off.
+        _reuse_env = os.environ.get("T3KNIC_BUF_REUSE", "0").strip().lower()
+        self._buf_reuse = _reuse_env in ("1", "true", "yes", "on")
+
+        # T3KNIC_GET_ONDEV returns
+        # the wire output as ON-DEVICE per-layer slices (skipping ttnn.from_device)
+        # so the restore feeds them straight into moreh_paged_fill_cache_varlen
+        # without the host round-trip (D2H + restore-side H2D). The live llama
+        # restore is an in-place page-table scatter that already consumes
+        # on-device tensors, so this is a localized edit. ttnn slicing allocates
+        # a fresh device buffer (a copy independent of the reused pool out-buffer),
+        # so this stays compatible with T3KNIC_BUF_REUSE. Gated additionally by
+        # dp==1/tp==1 at the connector (multi-device still needs the host gather).
+        # Default OFF.
+        _get_ondev_env = os.environ.get("T3KNIC_GET_ONDEV", "0").strip().lower()
+        self._get_ondev = _get_ondev_env in ("1", "true", "yes", "on")
+
+        # T3KNIC_PUT_ONDEV is the symmetric store-side path. When on,
+        # slice_kv_layer_for_chunk keeps the per-layer source
+        # slices ON DEVICE (skipping ttnn.from_device), and put_chunk_coalesced
+        # detects the device tensors and skips the H2D re-staging -- so the KV
+        # never leaves the device on the store path. Today's flow is a pure
+        # device->host(D2H slice)->device(H2D stage) round-trip whose only purpose
+        # was the LMCache host MemoryObj abstraction; the wire reader already reads
+        # the value from device DRAM, so the host hop is wasted. Eliminating it is
+        # O(chunks x layers) D2H+H2D transfers removed -- the dominant store FE cost
+        # at long sequences. Single-device only (multi-device GPT-oss still needs
+        # the host torch-gather); gated inside _ttnn_chunk_block_to_host.
+        #
+        # Default ON. Multi-device automatically falls back to the host
+        # gather (slice_kv_layer_for_chunk ignores on_device when dp/tp>1), so the
+        # default is safe for GPT-oss too. Set T3KNIC_PUT_ONDEV=0 to force the
+        # legacy device->host->device store round-trip.
+        _put_ondev_env = os.environ.get("T3KNIC_PUT_ONDEV", "1").strip().lower()
+        self._put_ondev = _put_ondev_env in ("1", "true", "yes", "on")
+
+        # T3KNIC_OFFLOAD_BACKEND (MAF-20460): where evicted/eager KV is stored for
+        # reuse, so we can A/B the offload MEDIUM at a fixed reuse mechanism:
+        #   wire (default) -> remote chip device DRAM over the NIC wire.
+        #   host           -> HOST system RAM  (dict of host ttnn slices; D2H store,
+        #                       H2D paged-fill restore).
+        #   local          -> LOCAL device DRAM (dict of on-device slices; the
+        #                       restore is a device->device paged-fill, no PCIe).
+        # host/local are "dict-backed": the NIC wire is disabled (open() skips the
+        # Client) and store/restore go to an in-process OrderedDict via the existing
+        # put/get_chunk_coalesced path. T3KNIC_HOST_OFFLOAD=1 aliases backend=host.
+        # Requires COALESCE (store/restore go through put/get_chunk_coalesced).
+        _backend = os.environ.get("T3KNIC_OFFLOAD_BACKEND", "").strip().lower()
+        if not _backend and os.environ.get("T3KNIC_HOST_OFFLOAD", "0").strip().lower() in ("1", "true", "yes", "on"):
+            _backend = "host"
+        self._offload_backend = _backend if _backend in ("host", "local") else "wire"
+        self._host_offload = self._offload_backend in (
+            "host",
+            "local",
+        )  # dict-backed (no wire)
+        # Entries are either the legacy (k_list, v_list) ttnn-tensor pairs or
+        # ("raw", {layer_idx: uint8 tensor}) buffers from the raw-byte codec.
+        self._host_store: "OrderedDict[str, Tuple]" = OrderedDict()
+        # Raw-byte codec shared by TTGPUConnector (which builds it once the
+        # live handles are known) and TTRemoteConnector (PUT side).
+        self.raw_codec: Optional[Any] = None
+        # Cap the retained-chunk count so the dict does not grow without bound. The
+        # LOCAL backend retains ON-DEVICE tensors -> device DRAM is scarce, so a
+        # small default (LRU-evict + deallocate old chunks) keeps device memory
+        # bounded; without it a long distinct-prompt run accumulates every prompt's
+        # KV on device and the pressure inflates warm1 at large ISL. The HOST
+        # backend retains host RAM (cheap) so it can hold far more.
+        _cap_default = "128" if self._offload_backend == "local" else "8192"
+        try:
+            self._host_store_cap = max(1, int(os.environ.get("T3KNIC_HOST_OFFLOAD_CAP", _cap_default)))
+        except ValueError:
+            self._host_store_cap = int(_cap_default)
+        if self._host_offload:
+            # local -> keep slices ON device (device->device restore, no PCIe);
+            # host  -> slices on host (D2H slice on store, H2D fill on restore).
+            _ondev = self._offload_backend == "local"
+            self._put_ondev = _ondev
+            self._get_ondev = _ondev
+            logger.warning(
+                "[t3knic] T3KNIC_OFFLOAD_BACKEND=%s: KV offload to %s (in-process dict); wire DISABLED, "
+                "PUT/GET_ONDEV=%s, store cap=%d chunks.",
+                self._offload_backend,
+                "LOCAL device DRAM" if _ondev else "HOST CPU DRAM",
+                _ondev,
+                self._host_store_cap,
+            )
+
+        if self._put_ondev and not self._coalesce:
+            # The on-device store path is threaded only through the coalesced
+            # put (put_chunk_coalesced); the non-coalesced put_layer path still
+            # does the full D2H+H2D round-trip. Warn so PUT_ONDEV isn't a silent
+            # no-op under T3KNIC_COALESCE=0.
+            logger.warning(
+                "[t3knic] T3KNIC_PUT_ONDEV=1 has no effect with T3KNIC_COALESCE=0 "
+                "(non-coalesced put still does D2H+H2D). Set T3KNIC_COALESCE=1."
+            )
+
+        # K+V merge (MAF-20221 / T3KNIC_KV_MERGE): store a group's K and V as ONE
+        # wire value/key (concat[kg, vg] on dim 0, K rows then V rows) instead of
+        # two -- halves the per-chunk PUT *and* GET op count (8 chunks: 16 -> 8).
+        # The wire-put COUNT is the dominant store FE at long sequences once the
+        # D2H is gone (T3KNIC_PUT_ONDEV), so this is the long-seq lever. Orthogonal
+        # to prefix reuse: chunk keys are unchanged, only the per-group K/V keys
+        # collapse to one "kv" key. Needs ~2x the per-value size (the wire cap is
+        # already 64 MiB) and a 2x merged GET out-buffer (pooled below). Requires
+        # coalesce. Default OFF; opt-in (e.g. a long-seq-tuned deployment).
+        _kv_merge_env = os.environ.get("T3KNIC_KV_MERGE", "0").strip().lower()
+        self._kv_merge = (_kv_merge_env in ("1", "true", "yes", "on")) and self._coalesce
+
+        # KV-diff consistency check (MAF-20221 / T3KNIC_KVDIFF). The gold-standard
+        # KV-reuse correctness gate (consistency_check #5): instead of comparing
+        # decode OUTPUT sha (which drifts on tail-token SDPA numerics even when the
+        # KV is exact), capture the per-layer KV tensors at the STORE boundary
+        # (put_chunk_coalesced input) and the LOAD boundary (get_chunk_coalesced
+        # output) for the same chunk key, then diff them tensor-wise (max/mean abs
+        # error per layer). A clean round-trip is bit-exact (err 0); a block-edge
+        # spike signals a partial-block / paged-slice bug. Bypasses all decode
+        # nondeterminism. Default OFF (debug-only; dequant-to-torch per chunk).
+        _kvdiff_env = os.environ.get("T3KNIC_KVDIFF", "").strip().lower()
+        self._kvdiff_enabled = _kvdiff_env in ("1", "true", "yes", "on")
+        self._kvdiff_store: Dict[str, Dict[int, Tuple[Any, Any]]] = {}
+        self._kvdiff_results: list = []
+
+        # Side-channel registries shared between TTGPUConnector and
+        # TTRemoteConnector. Keyed by id(memory_obj). See class docstring.
+        self._pending_lock = Lock()
+        self._pending_sends: Dict[int, Any] = {}
+        self._pending_gets: Dict[int, Any] = {}
+
+        # Wire-GET load-error accumulator. When a retrieve
+        # (TTGPUConnector.to_gpu) finds a chunk absent on the server
+        # (get_chunk_coalesced -> None) AFTER the scheduler already committed to
+        # those tokens as externally cached, the destination KV blocks are left
+        # as garbage. We record their physical block ids here; T3knicKVConnector.
+        # get_block_ids_with_load_errors() drains them into kv_connector_output.
+        # invalid_block_ids so vLLM recomputes them (kv_load_failure_policy=
+        # recompute). Recorded on the LMCache bg loop, drained on the worker step
+        # thread -> guard with its own lock.
+        self._load_err_lock = Lock()
+        self._load_errors: set = set()
+
+        # Op-level profiling collector. Gated by T3KNIC_PROFILE env var so
+        # production deployments pay zero overhead. When enabled, each record
+        # entry tracks op name, total bytes moved (k+v), per-step elapsed
+        # seconds, and a hit flag for retrieves. A ring buffer keeps the
+        # recent N events for debugging; cumulative counters drive aggregate
+        # MB/s / p50/p99 stats.
+        self._profile_enabled = _profile_enabled()
+        self._timing_log_left = int(os.environ.get("T3KNIC_TIMING_LOG", "0") or 0)
+        # Aggregate of the python-level wire calls, so a run reports what the MODEL actually paid
+        # for KV transfer: total seconds spent inside kvcache_manager Client.put/get and the
+        # throughput that implies. Per-call lines are for spotting outliers; this is the number to
+        # quote. Summarised (and reset) every T3KNIC_WIRE_AGG chunks, default one request's worth
+        # for the 3296-token benchmark.
+        self._wire_agg = {"PUT": [0, 0.0, 0], "GET": [0, 0.0, 0]}
+        self._wire_agg_every = int(os.environ.get("T3KNIC_WIRE_AGG", "26") or 26)
+        # Byte-level KV verification for the device wire paths shares the
+        # _kvdiff_enabled flag above (the legacy hooks live on the coalesced path;
+        # these are the ones that fire on device/per_chip). PUT remembers a digest of
+        # the exact bytes sent per wire key; GET compares the received bytes against
+        # it (wire leg), then re-gathers/re-packs from the live caches and compares
+        # against the received bytes (restore leg). Greedy output equality cannot
+        # distinguish "retrieve worked" from "retrieve silently recomputed"; this can.
+        self._kvdiff_digests: "OrderedDict[bytes, str]" = OrderedDict()
+        self._stats_lock = Lock()
+        # Store failures are counted, not just logged: a chunk store that raises is caught by the
+        # connector so one bad chunk cannot kill the worker, which means a systematic failure looks
+        # exactly like a healthy run until someone reads the log. It happened -- an 8-chip run
+        # stored nothing for an entire session while its KV checks passed, because greedy decoding
+        # is deterministic with or without a cache.
+        self._store_failures = 0
+        self._store_failures_consecutive = 0
+        self._store_successes = 0
+        self._stats_events: Deque[dict] = deque(maxlen=10000)
+        self._stats_counters: Dict[str, int] = defaultdict(int)
+        self._stats_bytes: Dict[str, int] = defaultdict(int)
+        self._stats_elapsed: Dict[str, float] = defaultdict(float)
+        # Per-step elapsed lists for percentile computation. Cap each at 5000
+        # samples (oldest discarded) so a long-running engine doesn't grow
+        # unbounded memory.
+        self._stats_step_elapsed: Dict[str, Deque[float]] = defaultdict(lambda: deque(maxlen=5000))
+        self._stats_t0 = time.monotonic()
+
+        # Perfetto/Chrome-Tracing-format event ring buffer. Each entry is a
+        # complete ("ph": "X") trace event suitable for direct dump to
+        # ui.perfetto.dev. Records start_us (wall clock since t0) + duration_us
+        # + name + cat + tid + args. Time origin is _stats_t0 monotonic ref
+        # (so all timestamps fit in 32-bit float JSON without precision loss).
+        # Capped at 50k events: at ~5 events / put_layer call, holds ~10k chunks
+        # of history before overwriting oldest.
+        self._trace_events: Deque[dict] = deque(maxlen=50000)
+
+    # ------------------------------------------------------------------
+    # Pending-op registry — used by TTGPUConnector & TTRemoteConnector
+    #
+    # Entries are keyed by ``id(memory_obj)``. To prevent leaks (and to
+    # avoid the dangerous id() reuse case where a new object lands at the
+    # same memory address as a freed one) every record_* call attaches a
+    # ``weakref.finalize`` to the memory_obj. When the memory_obj is GC'd
+    # the finalizer removes the registry entry automatically.
+    #
+    # The finalizer is dispatched to ``_cleanup_after_gc`` rather than a
+    # captured closure so it never holds a reference to memory_obj itself
+    # (only to ``self`` and an int).
+    # ------------------------------------------------------------------
+
+    def record_load_error(self, block_ids: Any) -> None:
+        """Record physical KV block ids whose wire GET missed or failed.
+
+        Called from ``TTGPUConnector.to_gpu``/``batched_to_gpu`` when a chunk is
+        absent on the server (``get_chunk_coalesced`` -> ``None``) so the
+        destination blocks were left unfilled. Drained by
+        ``T3knicKVConnector.get_block_ids_with_load_errors``.
+        """
+        try:
+            ids = {int(b) for b in block_ids if int(b) >= 0}
+        except Exception:  # noqa: BLE001
+            return
+        if not ids:
+            return
+        with self._load_err_lock:
+            self._load_errors.update(ids)
+
+    def take_load_errors(self) -> set:
+        """Drain and return accumulated wire-GET load-error block ids."""
+        with self._load_err_lock:
+            if not self._load_errors:
+                return set()
+            out = self._load_errors
+            self._load_errors = set()
+            return out
+
+    def record_pending_send(self, memory_obj: Any, info: Any) -> None:
+        """Register a pending fabric send keyed by ``id(memory_obj)``.
+
+        Called by ``TTGPUConnector.from_gpu`` with everything needed to
+        actually issue the send once the chunk key is available
+        (kvcaches snapshot, slot_mapping slice, layer indices, ...).
+
+        A ``weakref.finalize`` is attached to ``memory_obj`` so the
+        entry is removed automatically if the placeholder is garbage
+        collected before ``TTRemoteConnector.put`` consumes it.
+
+        Args:
+            memory_obj: The placeholder MemoryObj LMCache will hand to
+                ``TTRemoteConnector.put``. Must support weak references
+                (LMCache's ``TensorMemoryObj`` / ``BytesBufferMemoryObj``
+                do).
+            info: Opaque payload; ``TTRemoteConnector.put`` is the only
+                consumer and decides the schema.
+        """
+        moid = id(memory_obj)
+        with self._pending_lock:
+            self._pending_sends[moid] = info
+        weakref.finalize(memory_obj, self._cleanup_after_gc, moid, "send")
+
+    def pop_pending_send(self, memory_obj_id: int) -> Optional[Any]:
+        """Consume the pending-send entry for ``memory_obj_id``.
+
+        Returns ``None`` if the entry is missing (e.g. duplicate put
+        deduped by ``RemoteBackend.exists_in_put_tasks``). Caller is
+        expected to skip the fabric send in that case.
+        """
+        with self._pending_lock:
+            return self._pending_sends.pop(memory_obj_id, None)
+
+    def record_pending_get(self, memory_obj: Any, key: Any) -> None:
+        """Register a pending fabric get keyed by ``id(memory_obj)``.
+
+        Called by ``TTRemoteConnector.get`` when it allocates the
+        placeholder; ``TTGPUConnector.to_gpu`` will pop the entry and
+        issue ``client.get_layer`` calls.
+
+        See :meth:`record_pending_send` for the GC-cleanup contract.
+
+        Args:
+            memory_obj: The placeholder MemoryObj that
+                ``TTRemoteConnector.get`` will return to LMCache.
+            key: The chunk key (CacheEngineKey) the caller wants
+                associated with this MemoryObj.
+        """
+        moid = id(memory_obj)
+        with self._pending_lock:
+            self._pending_gets[moid] = key
+        weakref.finalize(memory_obj, self._cleanup_after_gc, moid, "get")
+
+    def pop_pending_get(self, memory_obj_id: int) -> Optional[Any]:
+        """Consume the pending-get entry for ``memory_obj_id``."""
+        with self._pending_lock:
+            return self._pending_gets.pop(memory_obj_id, None)
+
+    @property
+    def pending_send_count(self) -> int:
+        """Number of unconsumed pending-send entries."""
+        with self._pending_lock:
+            return len(self._pending_sends)
+
+    @property
+    def pending_get_count(self) -> int:
+        """Number of unconsumed pending-get entries."""
+        with self._pending_lock:
+            return len(self._pending_gets)
+
+    def _cleanup_after_gc(self, memory_obj_id: int, kind: str) -> None:
+        """Finalizer callback: drop the registry entry for a GC'd MemoryObj.
+
+        Called by the ``weakref.finalize`` attached in
+        :meth:`record_pending_send` / :meth:`record_pending_get`. The
+        normal happy-path is for ``pop_pending_*`` to remove the entry
+        before this fires, in which case this is a no-op. Surviving
+        entries (the leak case) are cleaned up here so:
+
+          * ``id()`` reuse for a different MemoryObj cannot collide with
+            a stale entry, and
+          * the registry never grows unboundedly when LMCache abandons
+            a MemoryObj without going through put / to_gpu.
+        """
+        with self._pending_lock:
+            if kind == "send":
+                self._pending_sends.pop(memory_obj_id, None)
+            else:
+                self._pending_gets.pop(memory_obj_id, None)
+
+    # ------------------------------------------------------------------
+    # Profiling: per-op timing + aggregate stats
+    # ------------------------------------------------------------------
+
+    def _record_op(
+        self,
+        op: str,
+        bytes_count: int,
+        total_elapsed: float,
+        *,
+        hit: Optional[bool] = None,
+        breakdown: Optional[Dict[str, float]] = None,
+    ) -> None:
+        """Append one op record to the stats collector.
+
+        No-op when ``T3KNIC_PROFILE`` env var is not set / falsy: production
+        deployments pay zero overhead. To opt in, start the server with e.g.
+        ``T3KNIC_PROFILE=1 site-device-lock run serve ...``.
+
+        Args:
+            op: ``"put_layer"`` or ``"get_layer_raw"`` (or future ``"exists"`` /
+                ``"delete"``). Used as the aggregate counter key.
+            bytes_count: Total bytes moved by this op (k + v packed bytes).
+            total_elapsed: End-to-end seconds for the whole op.
+            hit: For retrieves, True if data was returned. None for puts.
+            breakdown: Optional dict of step name -> elapsed seconds. Each step
+                name becomes its own percentile bucket.
+        """
+        if not self._profile_enabled:
+            return
+        with self._stats_lock:
+            self._stats_events.append(
+                {
+                    "t": time.time(),
+                    "op": op,
+                    "bytes": int(bytes_count),
+                    "elapsed": float(total_elapsed),
+                    "hit": hit,
+                    "breakdown": dict(breakdown) if breakdown else None,
+                }
+            )
+            self._stats_counters[op] += 1
+            self._stats_counters[f"{op}_hit"] += int(hit) if hit is True else 0
+            self._stats_counters[f"{op}_miss"] += int(hit is False)
+            self._stats_bytes[op] += int(bytes_count)
+            self._stats_elapsed[op] += float(total_elapsed)
+            self._stats_step_elapsed[op].append(float(total_elapsed))
+            if breakdown:
+                for step, dt in breakdown.items():
+                    self._stats_step_elapsed[f"{op}.{step}"].append(float(dt))
+        if breakdown:
+            # Emit per call, not only in the shutdown summary. Profiling is opt-in, and a run that
+            # is killed rather than shut down (which is how the harnesses end) never reaches that
+            # summary -- the measurement would be silently lost exactly when it is being taken.
+            logger.info(
+                "[t3knic] %s %.2f ms total (%s) %d B",
+                op,
+                total_elapsed * 1000.0,
+                " ".join(f"{k}={v * 1000.0:.2f}ms" for k, v in sorted(breakdown.items())),
+                int(bytes_count),
+            )
+
+    @staticmethod
+    def _percentiles(samples: list, qs=(0.5, 0.9, 0.99)) -> Dict[str, float]:
+        """Compute p50/p90/p99 over `samples` (seconds). Returns ms."""
+        if not samples:
+            return {f"p{int(q*100)}_ms": 0.0 for q in qs}
+        s = sorted(samples)
+        n = len(s)
+        out = {}
+        for q in qs:
+            idx = min(int(q * n), n - 1)
+            out[f"p{int(q*100)}_ms"] = round(s[idx] * 1000.0, 3)
+        return out
+
+    def record_store_result(self, ok: bool, exc: Optional[BaseException] = None) -> None:
+        """Count a chunk store outcome and escalate when failures are systematic.
+
+        Set T3KNIC_STORE_FAIL_FATAL=1 to turn any failure into a raise instead -- validation runs
+        want to stop at the first one rather than finish looking healthy.
+        """
+        with self._stats_lock:
+            if ok:
+                self._store_successes += 1
+                self._store_failures_consecutive = 0
+                return
+            self._store_failures += 1
+            self._store_failures_consecutive += 1
+            consecutive = self._store_failures_consecutive
+            total = self._store_failures
+
+        if os.environ.get("T3KNIC_STORE_FAIL_FATAL", "") == "1":
+            raise RuntimeError(f"t3knic chunk store failed and T3KNIC_STORE_FAIL_FATAL=1 is set") from exc
+        if consecutive in (1, 3) or consecutive % 25 == 0:
+            logger.error(
+                "[t3knic] chunk store FAILED (%d in a row, %d total, %d succeeded since start). "
+                "The cache is not being written; retrieves will miss and the run will still look "
+                "healthy because decoding is deterministic without a cache.",
+                consecutive,
+                total,
+                self._store_successes,
+            )
+
+    def store_failure_counts(self) -> Tuple[int, int]:
+        """(failures, successes) chunk stores since init, for tests and the stats snapshot."""
+        with self._stats_lock:
+            return self._store_failures, self._store_successes
+
+    def get_stats(self) -> Dict[str, Any]:
+        """Return a snapshot dict summarizing all op activity since init.
+
+        Top-level structure:
+            {
+              "since_seconds": <float>,
+              "ops": {
+                "put_layer": {count, total_bytes, total_elapsed_s, MBps, p50_ms, p90_ms, p99_ms},
+                "get_layer_raw": {count, hit_count, miss_count, ...},
+              },
+              "steps": {
+                "put_layer.h2d":   {p50_ms, p90_ms, p99_ms},
+                "put_layer.put_k": {...},
+                ...
+              },
+              "size_hist": {
+                "get_group": [{bytes, count, total_elapsed_s, MBps, Gbps,
+                               p50_ms, p90_ms, p99_ms}, ...sorted by bytes],
+                "put_group": [...],
+              },
+            }
+
+        ``size_hist`` buckets each op's transfers by payload size (rounded to
+        the nearest KiB) so the workload's per-size frequency + throughput is
+        visible, which the per-op aggregate hides.
+        """
+        with self._stats_lock:
+            now = time.monotonic()
+            since = now - self._stats_t0
+            ops: Dict[str, Any] = {}
+            for op, count in self._stats_counters.items():
+                if op.endswith("_hit") or op.endswith("_miss"):
+                    continue
+                total_bytes = self._stats_bytes.get(op, 0)
+                total_elapsed = self._stats_elapsed.get(op, 0.0)
+                mbps = (total_bytes / 1_000_000.0) / total_elapsed if total_elapsed > 0 else 0.0
+                rec = {
+                    "count": count,
+                    "total_bytes": total_bytes,
+                    "total_elapsed_s": round(total_elapsed, 3),
+                    "MBps": round(mbps, 3),
+                }
+                if f"{op}_hit" in self._stats_counters or f"{op}_miss" in self._stats_counters:
+                    rec["hit_count"] = self._stats_counters.get(f"{op}_hit", 0)
+                    rec["miss_count"] = self._stats_counters.get(f"{op}_miss", 0)
+                rec.update(self._percentiles(list(self._stats_step_elapsed.get(op, []))))
+                ops[op] = rec
+            steps: Dict[str, Any] = {}
+            for key, samples in self._stats_step_elapsed.items():
+                if "." not in key:
+                    continue  # already in `ops` (top-level op)
+                steps[key] = {"count": len(samples), **self._percentiles(list(samples))}
+            # Per-size histogram: bucket each op's events by payload size so the
+            # workload's GET/PUT size distribution (how many ops of each size and
+            # the throughput at that size) is visible -- the per-op aggregate
+            # above hides that a run mixes full coalesced groups with smaller
+            # partial-chunk / partial-group transfers. Size key is bytes rounded
+            # to the nearest KiB to collapse near-identical group sizes into one
+            # "size class". Built from the same _stats_events the trace uses, so
+            # it adds no per-op overhead.
+            by_op_size: Dict[str, Dict[int, list]] = defaultdict(lambda: defaultdict(list))
+            for ev in self._stats_events:
+                op_name = ev.get("op")
+                b = int(ev.get("bytes", 0))
+                if not op_name or b <= 0:
+                    continue
+                size_key = int(round(b / 1024.0)) * 1024
+                by_op_size[op_name][size_key].append(float(ev.get("elapsed", 0.0)))
+            size_hist: Dict[str, Any] = {}
+            for op_name, buckets in by_op_size.items():
+                rows = []
+                for size_key in sorted(buckets):
+                    samples = buckets[size_key]
+                    cnt = len(samples)
+                    tot = sum(samples)
+                    mbps = (size_key / 1_000_000.0) * cnt / tot if tot > 0 else 0.0
+                    rows.append(
+                        {
+                            "bytes": size_key,
+                            "count": cnt,
+                            "total_elapsed_s": round(tot, 3),
+                            "MBps": round(mbps, 3),
+                            "Gbps": round(mbps * 8 / 1000.0, 4),
+                            **self._percentiles(samples),
+                        }
+                    )
+                size_hist[op_name] = rows
+            return {
+                "since_seconds": round(since, 1),
+                "ops": ops,
+                "steps": steps,
+                "size_hist": size_hist,
+                "kvdiff": list(self._kvdiff_results),
+                # A non-zero "failed" means chunks never reached the server: retrieves will miss
+                # while the run still looks healthy, so it belongs in every snapshot.
+                "stores": {
+                    "ok": self._store_successes,
+                    "failed": self._store_failures,
+                    "failed_consecutive": self._store_failures_consecutive,
+                },
+            }
+
+    def set_warmup_mode(self, enabled: bool) -> None:
+        """Enable/disable warmup mode (skip wire put_layer in TTRemoteConnector).
+
+        When enabled, the vLLM forward still runs (prefill/decode kernels warm
+        up) but no KV is stored to the pool, so cache state / stats / trace stay
+        clean. Toggled around a warmup request by the driver.
+        """
+        self._warmup_mode = bool(enabled)
+
+    def reset_stats(self) -> None:
+        """Clear all accumulated stats (counters + ring buffer + trace)."""
+        with self._stats_lock:
+            self._stats_events.clear()
+            self._stats_counters.clear()
+            self._stats_bytes.clear()
+            self._stats_elapsed.clear()
+            self._stats_step_elapsed.clear()
+            self._trace_events.clear()
+            self._kvdiff_store.clear()
+            self._kvdiff_results.clear()
+            self._stats_t0 = time.monotonic()
+
+    def _record_trace(
+        self,
+        name: str,
+        cat: str,
+        start_mono: float,
+        end_mono: float,
+        tid: int = 0,
+        args: Optional[Dict[str, Any]] = None,
+    ) -> None:
+        """Append a single Chrome-Tracing complete event.
+
+        Args:
+            name: short event label (rendered as the box title in Perfetto).
+            cat: category for filtering (e.g. ``"wire"``, ``"alloc"``, ``"stats"``).
+            start_mono / end_mono: ``time.monotonic()`` values. Converted to
+                microseconds since ``self._stats_t0`` for the ``ts`` field.
+            tid: thread id (for grouping nested events in a swimlane). Use the
+                same tid for parent + children so Perfetto stacks them.
+            args: dict of free-form key/value pairs that show in the tooltip.
+        """
+        if not self._profile_enabled:
+            return
+        ts_us = (start_mono - self._stats_t0) * 1_000_000.0
+        dur_us = (end_mono - start_mono) * 1_000_000.0
+        ev = {
+            "name": name,
+            "cat": cat,
+            "ph": "X",
+            "ts": ts_us,
+            "dur": dur_us,
+            "pid": 1,
+            "tid": tid,
+        }
+        if args:
+            ev["args"] = args
+        with self._stats_lock:
+            self._trace_events.append(ev)
+
+    def get_trace(self) -> Dict[str, Any]:
+        """Return a Chrome-Tracing-format trace dump (Perfetto-compatible).
+
+        Resulting JSON can be saved to a .json file and loaded directly at
+        https://ui.perfetto.dev/ (or chrome://tracing/). Empty traceEvents
+        list when T3KNIC_PROFILE is off.
+        """
+        with self._stats_lock:
+            return {
+                "traceEvents": list(self._trace_events),
+                "displayTimeUnit": "ms",
+                "otherData": {
+                    "since_seconds": round(time.monotonic() - self._stats_t0, 1),
+                    "event_count": len(self._trace_events),
+                },
+            }
+
+    def open(self) -> None:
+        """Open the client transactionally and roll back every partial resource."""
+        if self._opened:
+            return
+        try:
+            self._open()
+            if self._gm_role == "owner":
+                self._start_gm_proxy()
+        except BaseException:
+            try:
+                self.close()
+            except Exception:  # noqa: BLE001 - preserve the original open failure
+                logger.exception("[t3knic] failed to roll back a partial client open")
+            raise
+
+    def _open(self) -> None:
+        """Connect to the kvcache_server. Idempotent.
+
+        Construct the product Client after its Server is running and verify the
+        attachment with a 64-byte Fabric ping.
+        """
+        if self._opened:
+            return
+        if self._host_offload:
+            # Host-CPU-DRAM offload: no NIC wire / no kvcache_server. Skip the
+            # Client construction, ping, and staging-pool alloc entirely -- the
+            # store/restore go to the in-process _host_store dict (put/get/exists/
+            # delete_chunk_coalesced short-circuit before touching the wire).
+            self._opened = True
+            logger.warning(
+                "[t3knic] open(): offload backend=%s -> wire skipped (in-process dict store).",
+                self._offload_backend,
+            )
+            return
+        if self._gm_role == "forwarder":
+            self._open_gm_forwarder()
+            return
+        if self.config.get("mode") == "external":
+            self._open_external()
+            return
+        if self.wire_mode == "mock":
+            # No Server, no nic submesh, no Client: everything wire-shaped is served from
+            # _mock_wire_store. The device ops are real, so the gather staging must still be
+            # reserved before any trace capture, and the blob pre-allocated for the same reason.
+            if self.mesh_device is None:
+                raise ValueError("TTKVCacheClient(mock): mesh_device is required")
+            self._wire_mesh = self.mesh_device
+            if tuple(self.mesh_device.shape) == (1, 1):
+                self._wire_coord = None
+            else:
+                self._wire_coord = (
+                    tuple(self.wire_stage_coord)
+                    if self.wire_stage_coord is not None
+                    else (0,) * len(tuple(self.mesh_device.shape))
+                )
+            from lmcache_t3knic.t3knic_lmcache._kvm_backend import kvcache_operations
+
+            kvcache_operations.reserve_gather_resources(self._wire_mesh)
+            self._gather_resources_reserved = True
+            logger.info(
+                "[t3knic] wire mode=mock -> chunks take the on-device pack path with HOST MEMORY "
+                "standing in for the Server (no wire, no attachment); for integration testing only"
+            )
+            if self._kvdiff_enabled:
+                logger.warning(
+                    "[t3knic][kvdiff] T3KNIC_KVDIFF=1 but mock mode has no kvdiff hooks -- "
+                    "no verdicts will be emitted; use device/per_chip for byte verification"
+                )
+            self._prealloc_mock_blob()
+            self._opened = True
+            return
+        if self.mesh_device is None or self.nic_submesh is None:
+            raise ValueError(
+                "TTKVCacheClient requires both mesh_device (sender) and "
+                "nic_submesh; got mesh_device=%r nic_submesh=%r" % (self.mesh_device, self.nic_submesh)
+            )
+        from lmcache_t3knic.t3knic_lmcache._kvm_backend import (
+            kvcache_manager,
+            kvcache_operations,
+        )
+
+        if self.paired_server is None:
+            raise ValueError(
+                "TTKVCacheClient.open: paired_server is None. The Client ctor "
+                "must not outlive the kvcache_manager.Server running on nic_submesh. "
+                "Make sure the worker passes the Server handle through "
+                "attach_mesh_device -> install_t3knic_backend -> TTKVCacheClient."
+            )
+        # A multi-chip sender keeps one MeshDevice and scopes each Client workload
+        # with client_coord. This preserves the model command-queue state while
+        # allowing gather-to-one-chip and per-chip wire modes.
+        import ttnn as _ttnn
+
+        if tuple(self.mesh_device.shape) == (1, 1):
+            self._wire_mesh = self.mesh_device
+            self._wire_coord = None
+        else:
+            # The client runs as a single-coordinate workload on the model's own mesh. Sharing one
+            # MeshDevice is what makes this safe: sibling views of one chip have independent
+            # dispatch state and cannot represent the model queue's completion. It also puts the
+            # wire on the chip where on-device gather lands, avoiding a host round trip.
+            self._wire_mesh = self.mesh_device
+            if self.wire_stage_coord is not None:
+                _stage_coord = tuple(self.wire_stage_coord)
+                shape = tuple(self.mesh_device.shape)
+                if len(_stage_coord) != len(shape) or any(c >= s for c, s in zip(_stage_coord, shape)):
+                    # An explicit placement that cannot be honoured is a misconfiguration, not a
+                    # hint. Relocating it to (0, 0) would run every gather on a chip nobody chose
+                    # and show up only as unexplained wire latency (colaunch validates the env/
+                    # preset forms up front; this catches direct API callers).
+                    raise ValueError(
+                        f"[t3knic] wire_stage_coord {_stage_coord} is not a coordinate of the " f"model mesh {shape}"
+                    )
+            else:
+                _stage_coord = (0,) * len(tuple(self.mesh_device.shape))
+            self._wire_coord = _stage_coord
+            logger.info(
+                "[t3knic] wire client runs on the model mesh %s at coordinate %s (no staging chip)",
+                tuple(self.mesh_device.shape),
+                _stage_coord,
+            )
+        self._server_node = self.nic_submesh.get_fabric_node_id(_ttnn.MeshCoordinate(0, 0))
+        self._ttnn_client = kvcache_manager.Client(
+            self._wire_mesh,
+            server_node=self._server_node,
+            client_coord=(_ttnn.MeshCoordinate(*self._wire_coord) if self._wire_coord is not None else None),
+        )
+        # Logged AFTER the client exists: wire_uses_device_path() requires it, so reporting the
+        # chosen path any earlier always claimed the host fallback -- including in "device" mode,
+        # which is precisely the misreport this line was added to prevent.
+        # Decided from what is known at open(): the mode and whether a model-mesh coordinate was
+        # resolved. wire_uses_device_path() cannot be used here -- it also requires raw_codec, which
+        # set_real_kvcaches only assigns later, so it would report the host path for every run.
+        if self._uses_per_chip():
+            _path = "per-chip PUT (each owning chip sends its own shard)"
+        elif self.wire_mode != "host" and self._wire_coord is not None:
+            _path = "on-device gather/scatter"
+        else:
+            _path = "HOST gather/scatter (last resort)"
+        logger.info("[t3knic] wire mode=%s -> chunks take the %s path", self.wire_mode, _path)
+        payload = secrets.token_bytes(64)
+        echoed = self._ttnn_client.ping(payload)
+        if echoed != payload:
+            raise RuntimeError("TTKVCacheClient.open: kvcache_server ping self-check byte mismatch")
+        # Everything below allocates device memory that outlives the call, so it must happen before
+        # the first trace that OUTLIVES this call -- the decode trace compile_or_warm_up_model
+        # captures right after initialize_kv_cache. (An earlier decode trace is captured while
+        # measuring DRAM, but _measure_dram discards it, which restores mark_allocations_safe, so
+        # open() runs in a clean window.) tt_metal only tolerates a buffer allocated while a trace
+        # exists if its lifetime ends before that trace runs, and none of these can promise that:
+        # a replaying trace then clobbers the L1 the allocator handed us, which strands a blocking
+        # enqueue holding the mesh-wide API mutex and takes the device down silently.
+        #
+        # Deliberately NOT gated on raw_codec: open() runs from attach_connector, which the worker
+        # calls BEFORE initialize_kv_cache, and raw_codec is only set later by set_real_kvcaches.
+        # Gating on it here means never running at all -- the failure this whole block prevents.
+        if self.wire_mode != "host" and self._wire_coord is not None:
+            kvcache_operations.reserve_gather_resources(self._wire_mesh)
+            self._gather_resources_reserved = True
+        if self._uses_per_chip():
+            shape = tuple(int(d) for d in self._wire_mesh.shape)
+            chips = 1
+            for dim in shape:
+                chips *= dim
+            limit = int(getattr(kvcache_operations, "MAX_CLIENTS", 0) or 0)
+            if limit and chips > limit:
+                raise RuntimeError(
+                    f"T3KNIC_WIRE_MODE=per_chip attaches one Client per model chip ({chips} for mesh "
+                    f"{shape}), but a Server holds at most {limit}. Use 'device' (one gathering chip) "
+                    f"here, or raise protocol::kMaxClients."
+                )
+            # Attach every chip now rather than on first use. Which chips can own a chunk is pure
+            # geometry -- every coordinate of the model mesh -- so there is nothing to wait for.
+            for coord in itertools.product(*(range(d) for d in shape)):
+                self._shard_client(coord)
+            logger.info(
+                "[t3knic] per_chip: %d wire clients attached in open(), i.e. before "
+                "compile_or_warm_up_model captures the decode trace that lives for the run",
+                chips,
+            )
+        # Build the coalesce group plan and pre-allocate the
+        # persistent wire-staging buffer pool before trace capture.
+        self._init_plan_and_pool()
+
+        # Kept out of _init_plan_and_pool on purpose: that returns early when coalescing is off,
+        # which would silently skip this on the very deployments that use the raw wire.
+        if self.wire_mode != "host" and self._wire_coord is not None:
+            self._prealloc_wire_blob()
+
+        self._opened = True
+
+    def _open_external(self) -> None:
+        """Open the product Client through the static Galaxy-to-T3K route."""
+        if self.wire_mode == "mock":
+            raise ValueError("external mode contradicts wire mode 'mock' (mock has no Server)")
+        if self.mesh_device is None:
+            raise ValueError("TTKVCacheClient external open requires mesh_device")
+        ready_file = os.environ.get("T3KNIC_SERVER_READY")
+        if ready_file:
+            ready_timeout = float(os.environ.get("T3KNIC_SERVER_READY_TIMEOUT", "900"))
+            if ready_timeout <= 0:
+                raise ValueError("T3KNIC_SERVER_READY_TIMEOUT must be positive")
+            deadline = time.monotonic() + ready_timeout
+            logger.info("[t3knic] waiting for product Server readiness marker %s", ready_file)
+            while not os.path.exists(ready_file):
+                if time.monotonic() >= deadline:
+                    raise TimeoutError(
+                        f"product Server readiness marker {ready_file} did not appear within {ready_timeout}s"
+                    )
+                time.sleep(0.25)
+        import ttnn as _ttnn
+        from lmcache_t3knic.t3knic_lmcache._kvm_backend import (
+            kvcache_manager,
+            kvcache_operations,
+        )
+
+        # Same stage-coordinate resolution as the paired path: the wire client runs as a
+        # single-coordinate workload on the model's own mesh.
+        if tuple(self.mesh_device.shape) == (1, 1):
+            self._wire_mesh = self.mesh_device
+            self._wire_coord = None
+        else:
+            self._wire_mesh = self.mesh_device
+            if self.wire_stage_coord is not None:
+                _stage_coord = tuple(self.wire_stage_coord)
+                shape = tuple(self.mesh_device.shape)
+                if len(_stage_coord) != len(shape) or any(c >= s for c, s in zip(_stage_coord, shape)):
+                    raise ValueError(
+                        f"[t3knic] wire_stage_coord {_stage_coord} is not a coordinate of the " f"model mesh {shape}"
+                    )
+            else:
+                _stage_coord = (0,) * len(tuple(self.mesh_device.shape))
+            self._wire_coord = _stage_coord
+
+        shape = tuple(int(dimension) for dimension in self._wire_mesh.shape)
+        master_flat = self._flat_chip_index(self._wire_coord) if self._wire_coord is not None else 0
+        self._external_server_shards = int(os.environ.get("T3KNIC_SERVER_SHARDS", "1"))
+        if not 1 <= self._external_server_shards <= 8:
+            raise ValueError("T3KNIC_SERVER_SHARDS must be in [1, 8]; got " f"{self._external_server_shards}")
+        self._external_lane_count = int(os.environ.get("T3KNIC_INTERMESH_LINK_COUNT", "1"))
+        if self._external_lane_count < 1:
+            raise ValueError("T3KNIC_INTERMESH_LINK_COUNT must be positive; got " f"{self._external_lane_count}")
+        if self._external_server_shards > 1 and self._external_lane_count != 2:
+            raise ValueError(
+                "multi-shard external mode requires T3KNIC_INTERMESH_LINK_COUNT=2; got " f"{self._external_lane_count}"
+            )
+
+        master_group, master_lane = self._external_route_for_flat(master_flat)
+
+        self._ttnn_client = kvcache_manager.Client(
+            self._wire_mesh,
+            server_node=None,
+            client_coord=(_ttnn.MeshCoordinate(*self._wire_coord) if self._wire_coord is not None else None),
+            static_intermesh_galaxy_to_t3k=True,
+            server_worker_group=master_group,
+            static_intermesh_lane=master_lane,
+        )
+        logger.info(
+            "[t3knic] wire mode=%s -> product Client attached through the static "
+            "Galaxy-to-T3K route (server shard=%d, lane=%d)",
+            self.wire_mode,
+            master_group,
+            master_lane,
+        )
+        payload = secrets.token_bytes(64)
+        echoed = self._ttnn_client.ping(payload)
+        if echoed != payload:
+            raise RuntimeError("TTKVCacheClient external open: ping self-check byte mismatch")
+        if self.wire_mode != "host" and self._wire_coord is not None:
+            kvcache_operations.reserve_gather_resources(self._wire_mesh)
+            self._gather_resources_reserved = True
+        if self._uses_per_chip():
+            chips = 1
+            for dimension in shape:
+                chips *= dimension
+            limit = int(getattr(kvcache_operations, "MAX_CLIENTS", 0) or 0)
+            if limit and chips > limit:
+                raise RuntimeError(
+                    f"T3KNIC_WIRE_MODE=per_chip needs {chips} Clients for mesh {shape}, "
+                    f"but the Server supports at most {limit}"
+                )
+            for coord in itertools.product(*(range(dimension) for dimension in shape)):
+                self._shard_client(coord)
+        self._init_plan_and_pool()
+        if self.wire_mode != "host" and self._wire_coord is not None:
+            self._prealloc_wire_blob()
+        self._opened = True
+
+    def _open_gm_forwarder(self) -> None:
+        """Open a global-master FORWARDER: device gather stays local, the wire is remote.
+
+        Mirrors the device-mode open minus the Client: this rank still packs its
+        stage's chunk into its own blob (so the gather staging and blob must be
+        reserved before trace capture), then hands the bytes to the owner over zmq.
+        """
+        from lmcache_t3knic.t3knic_lmcache._kvm_backend import kvcache_operations
+
+        from lmcache_t3knic.t3knic_lmcache.gm_proxy import GlobalMasterForwarder
+
+        if self.mesh_device is None:
+            raise ValueError("TTKVCacheClient(global_master forwarder): mesh_device is required")
+        self._wire_mesh = self.mesh_device
+        if tuple(self.mesh_device.shape) == (1, 1):
+            self._wire_coord = None
+        else:
+            self._wire_coord = (
+                tuple(self.wire_stage_coord)
+                if self.wire_stage_coord is not None
+                else (0,) * len(tuple(self.mesh_device.shape))
+            )
+        self._gm_fwd = GlobalMasterForwarder()
+        logger.info(
+            "[t3knic][gm] forwarder: chunks gather locally at %s then forward to the wire owner at %s",
+            self._wire_coord,
+            self._gm_fwd.endpoint,
+        )
+        kvcache_operations.reserve_gather_resources(self._wire_mesh)
+        self._gather_resources_reserved = True
+        self._init_plan_and_pool()
+        if self._wire_coord is not None:
+            self._prealloc_wire_blob()
+        self._opened = True
+
+    def _start_gm_proxy(self) -> None:
+        """Start the wire-owner REP service (F1) over this client's opened backend."""
+        from lmcache_t3knic.t3knic_lmcache.gm_proxy import GlobalMasterProxy
+
+        self._gm_proxy = GlobalMasterProxy(self._gm_put_fn, self._gm_get_fn, self._gm_exists_fn)
+        logger.info(
+            "[t3knic][gm] owner: serving the wire (backend=%s) for forwarder ranks",
+            self.wire_mode,
+        )
+
+    def _gm_pages_tensor(self, data: bytes):
+        """Host bytes -> (n, 8192) int32 pages padded to the wire's 32 KiB page shape."""
+        import torch
+
+        total = len(data)
+        pad = (-total) % (8192 * 4)
+        buf = torch.frombuffer(bytearray(data) + b"\x00" * pad, dtype=torch.uint8)
+        return buf.view(torch.int32).reshape(-1, 8192)
+
+    def _gm_put_fn(self, key: bytes, data: bytes) -> bool:
+        """Owner executor: land forwarded bytes on the wire (or the mock dict)."""
+        import ttnn
+
+        try:
+            if self._uses_mock():
+                self._gm_mock_store[key] = bytes(data)
+                return True
+            with self._device_lock():
+                dev = self._wire_from_host(self._gm_pages_tensor(data))
+                try:
+                    self._ttnn_client.put(key, dev, len(data), sync_commit=True)
+                finally:
+                    ttnn.deallocate(dev)
+            return True
+        except Exception:  # noqa: BLE001 - the proxy turns False into an error frame
+            logger.exception("[t3knic][gm] owner PUT failed for a forwarded chunk")
+            return False
+
+    def _gm_get_fn(self, key: bytes, length: int) -> Optional[bytes]:
+        """Owner executor: serve a forwarded GET; None = miss."""
+        import torch
+        import ttnn
+
+        if self._uses_mock():
+            return self._gm_mock_store.get(key)
+        ub = int(length) + ((-int(length)) % (8192 * 4))
+        with self._device_lock():
+            out = self._wire_from_host(torch.zeros(ub // 4, dtype=torch.int32).reshape(-1, 8192))
+            try:
+                if not self._ttnn_client.get(key, out):
+                    return None
+                host = self._wire_to_host(out).contiguous().view(torch.uint8).reshape(-1)
+            finally:
+                ttnn.deallocate(out)
+        return host[: int(length)].numpy().tobytes()
+
+    def _gm_exists_fn(self, key: bytes) -> bool:
+        if self._uses_mock():
+            return key in self._gm_mock_store
+        with self._device_lock():
+            return bool(self._ttnn_client.exists(key))
+
+    def close(self) -> None:
+        """Detach from the kvcache_server. Idempotent."""
+        # Free the persistent buffer pool before tearing down the fabric
+        # attachment (the pool tensors live on _wire_mesh, independent of the
+        # ttnn Client, but ordering tensors-then-attachment is the safe one).
+        self._free_pool()
+        self._free_host_store()  # deallocate retained offload slices (ttnn tensors)
+        if self._wire_blob is not None:
+            try:
+                import ttnn
+
+                ttnn.deallocate(self._wire_blob)
+            except Exception:  # noqa: BLE001 - teardown must tolerate an already-freed tensor
+                logger.debug("[t3knic] deallocating the wire blob failed", exc_info=True)
+            self._wire_blob = None
+            self._wire_blob_words = 0
+        # Per-chip clients first: each holds a Server attachment entry, and the Server must outlive
+        # every Client attached to it.
+        for coord, client in list(self._shard_clients.items()):
+            try:
+                client.close()
+            except Exception:  # noqa: BLE001
+                logger.exception("[t3knic] failed to close the per-chip wire client at %s", coord)
+            else:
+                del self._shard_clients[coord]
+        if self._shard_clients:
+            raise RuntimeError(
+                "TTKVCacheClient.close: one or more per-chip Clients remain attached at "
+                f"{sorted(self._shard_clients)}"
+            )
+        self._mock_wire_store.clear()
+        if self._mock_blob is not None:
+            try:
+                import ttnn
+
+                ttnn.deallocate(self._mock_blob)
+            except Exception:  # noqa: BLE001 - teardown must not fail on a buffer already gone
+                pass
+            self._mock_blob = None
+            self._mock_blob_words = 0
+        if self._gm_fwd is not None:
+            try:
+                self._gm_fwd.request("detach")
+            except Exception:  # noqa: BLE001 - the owner may already be gone at teardown
+                logger.debug("[t3knic][gm] detach to the wire owner failed", exc_info=True)
+            self._gm_fwd.close()
+            self._gm_fwd = None
+        if self._gm_proxy is not None:
+            # Stop serving forwarders BEFORE the wire client goes away.
+            self._gm_proxy.close()
+            self._gm_proxy = None
+        if self._ttnn_client is not None:
+            self._ttnn_client.close()
+            self._ttnn_client = None
+        if self._gather_resources_reserved:
+            try:
+                from lmcache_t3knic.t3knic_lmcache._kvm_backend import (
+                    kvcache_operations,
+                )
+
+                kvcache_operations.release_gather_resources(self._wire_mesh)
+                self._gather_resources_reserved = False
+            except Exception:  # noqa: BLE001 - teardown must not fail on a buffer we reserved
+                logger.debug("[t3knic] releasing the gather L1 reservation failed", exc_info=True)
+        self._opened = False
+
+    def _free_host_store(self) -> None:
+        """Deallocate every retained offload slice (host or on-device ttnn tensor)
+        then clear the dict. Prevents the ttnn-tensor leak / EngineDead at
+        teardown for the host/local dict backends. Best-effort per tensor."""
+        if not self._host_store:
+            return
+        for entry in self._host_store.values():
+            self._free_host_entry(entry)
+        self._host_store.clear()
+
+    def _init_plan_and_pool(self) -> None:
+        """Build the coalesce group plan and pre-allocate the persistent
+        wire-staging buffer pool.
+
+        Called from :meth:`open` once the wire mesh + ttnn Client are live.
+        Deterministic in the KV geometry threaded in by the connector
+        (num_layers / num_kv_heads / head_size / block_size + chunk_size), so
+        the group plan no longer has to be discovered lazily on the first put.
+
+        Pool layout (all on ``_wire_mesh``; multi-chip allocations are replicated
+        so the selected or per-chip Client can address its local shard):
+          * ``_pool_get_kg[gid] / _pool_get_vg[gid]`` -- one GET out-buffer per
+            coalesce group, shape ``(G*nb, kv_heads, block, head)``.
+          * ``_pool_put_stage_k[li] / _pool_put_stage_v[li]`` -- one PUT/GET D2D
+            staging buffer per layer, shape ``(nb, kv_heads, block, head)``.
+
+        A live multi-chip device path fails open() if geometry or allocation is
+        incomplete, because allocating the persistent pool after trace capture
+        is unsafe. Device-free helpers retain the lazy fallback for unit tests.
+        """
+        if not self._coalesce:
+            return
+        fields = (
+            self._spec_num_layers,
+            self._spec_num_kv_heads,
+            self._spec_head_size,
+            self._spec_block_size,
+            self._spec_chunk_size,
+        )
+        if any(f is None for f in fields):
+            if self.wire_mode != "host" and self._wire_coord is not None:
+                raise RuntimeError(
+                    "TTKVCacheClient.open: device wire pool geometry is incomplete "
+                    f"(num_layers={self._spec_num_layers}, kv_heads={self._spec_num_kv_heads}, "
+                    f"head={self._spec_head_size}, block={self._spec_block_size}, "
+                    f"chunk={self._spec_chunk_size})"
+                )
+            logger.info(
+                "[t3knic] pool: KV geometry incomplete "
+                "(num_layers=%s kv_heads=%s head=%s block=%s chunk=%s); "
+                "skipping open()-time plan+pool, hot path will lazy-allocate.",
+                *fields,
+            )
+            return
+
+        import ttnn
+
+        num_layers = self._spec_num_layers
+        kv_heads = self._spec_num_kv_heads
+        block = self._spec_block_size
+        head = self._spec_head_size
+        # Full-chunk block count. nb=1 for the supported chunk_size==block_size
+        # config; computed (not hard-coded) so a future multi-block chunk sizes
+        # the pool correctly. Using the FULL-chunk nb makes per_layer_bytes an
+        # upper bound, so the group size G is never too large to exceed the wire
+        # value cap (a partial last chunk only ever produces fewer bytes).
+        nb = max(1, self._spec_chunk_size // block)
+        per_layer_shape = (nb, kv_heads, block, head)
+
+        # bfp8 TILE byte length of one layer's K (== V): num_tiles * tile_size.
+        # ceil-div to tiles mirrors the device's tile padding of the last two
+        # dims (see tt_kv_serde._bfp8_tile_n_bytes); for tile-aligned block/head
+        # it is exact and matches the first put's _bfp8_tile_n_bytes(k_list[0]),
+        # so the group partition is identical to the current lazy build.
+        tiles = nb * kv_heads * ((block + 31) // 32) * ((head + 31) // 32)
+        per_layer_bytes = tiles * ttnn.tile_size(ttnn.bfloat8_b)
+
+        groups = self._build_group_plan(num_layers, per_layer_bytes)
+
+        # Allocate the pool. allocate_tensor_on_device is a pure DRAM allocation
+        # (no zeros / no H2D / no tilize) -- on a hit the wire fully overwrites a
+        # GET out-buffer, and on a miss it leaves it untouched (the caller treats
+        # a miss as "not present"), so uninitialized contents are safe.
+        mem = ttnn.DRAM_MEMORY_CONFIG
+
+        def _alloc(shape: Tuple[int, ...]) -> Any:
+            return ttnn.allocate_tensor_on_device(
+                ttnn.Shape(list(shape)),
+                ttnn.bfloat8_b,
+                ttnn.TILE_LAYOUT,
+                self._wire_mesh,
+                mem,
+            )
+
+        try:
+            for li in range(num_layers):
+                self._pool_put_stage_k[li] = _alloc(per_layer_shape)
+                self._pool_put_stage_v[li] = _alloc(per_layer_shape)
+            for gid, layer_idxs in enumerate(groups):
+                grp_shape = (len(layer_idxs) * nb, kv_heads, block, head)
+                if self._kv_merge:
+                    # One merged 2x out-buffer (K rows + V rows) for the single
+                    # "kv" GET; no separate kg/vg buffers in merge mode.
+                    self._pool_get_kv[gid] = _alloc((2 * len(layer_idxs) * nb, kv_heads, block, head))
+                else:
+                    self._pool_get_kg[gid] = _alloc(grp_shape)
+                    self._pool_get_vg[gid] = _alloc(grp_shape)
+        except Exception as e:  # noqa: BLE001
+            self._free_pool()
+            if self.wire_mode != "host" and self._wire_coord is not None:
+                raise RuntimeError("TTKVCacheClient.open: device wire pool pre-allocation failed") from e
+            logger.warning("[t3knic] pool: allocation failed (%s); hot path will lazy-allocate.", e)
+            return
+
+        # Commit the deterministic group plan now that its backing pool is live.
+        # The hot path's lazy ``if self._coalesce_groups is None`` build is then
+        # skipped and reuses this plan (same num_layers + per-layer bytes => the
+        # identical partition the first full chunk would have produced).
+        self._coalesce_groups = groups
+        self._pool_per_layer_shape = per_layer_shape
+        self._pool_allocated = True
+        logger.info(
+            "[t3knic] pool: pre-allocated %d group + %d layer buffers on wire mesh "
+            "(per_layer_shape=%s, nb=%d, per_layer_bytes=%d, group_sizes=%s)",
+            len(groups),
+            num_layers,
+            per_layer_shape,
+            nb,
+            per_layer_bytes,
+            [len(g) for g in groups],
+        )
+
+    def _free_pool(self) -> None:
+        """Deallocate every persistent pool buffer. Idempotent; safe to call
+        when the pool was never allocated."""
+        try:
+            import ttnn
+        except ImportError:
+            ttnn = None
+        for d in (
+            self._pool_get_kg,
+            self._pool_get_vg,
+            self._pool_get_kv,
+            self._pool_put_stage_k,
+            self._pool_put_stage_v,
+        ):
+            if ttnn is not None:
+                for t in d.values():
+                    try:
+                        ttnn.deallocate(t)
+                    except Exception:  # noqa: BLE001
+                        pass
+            d.clear()
+        self._pool_allocated = False
+        self._pool_shape_validated = False
+        self._pool_shape_ok = False
+
+    def put_layer(
+        self,
+        key: str,
+        layer_idx: int,
+        k_device_tensor: torch.Tensor,
+        v_device_tensor: torch.Tensor,
+    ) -> None:
+        """Synchronously land one layer's KV cache in Server staging DRAM.
+
+        Caller is responsible for ensuring the tensors live on the vLLM
+        chip's L1 / DRAM until this call returns. Return means the source
+        tensor is reusable and device landing/read-back has completed. In paired
+        mode, ``wait_put_done`` separately flushes directory commit visibility;
+        detached mode has no remote host commit-drain operation.
+
+        Args:
+            key: Stable identifier for this KV chunk (vLLM hash).
+            layer_idx: 0-based layer index.
+            k_device_tensor: K cache slice for this layer, on TT device.
+            v_device_tensor: V cache slice for this layer, on TT device.
+        """
+        # bfp8 TILE passthrough. Move host K/V to sender DRAM (the wire
+        # requires an INTERLEAVED-DRAM allocation on the sender chip); the
+        # bfp8 TILE bytes ship verbatim so the round-trip is byte-exact. K
+        # and V are stored under independent ``"k"`` / ``"v"`` wire keys so
+        # each tensor has a single concrete spec on the wire.
+        import ttnn
+
+        profile = self._profile_enabled
+        if not profile:
+            # Fast path: no timer / no record_op / no trace. Production overhead 0.
+            k_dev = tt_kv_serde.place_on_sender_dram(k_device_tensor, self._wire_mesh)
+            v_dev = tt_kv_serde.place_on_sender_dram(v_device_tensor, self._wire_mesh)
+            try:
+                k_n_bytes = tt_kv_serde._bfp8_tile_n_bytes(k_dev)
+                v_n_bytes = tt_kv_serde._bfp8_tile_n_bytes(v_dev)
+                hash_k = tt_kv_serde.hash_layer_key(key, layer_idx, "k").encode("utf-8")
+                hash_v = tt_kv_serde.hash_layer_key(key, layer_idx, "v").encode("utf-8")
+                self._ttnn_client.put(hash_k, k_dev, k_n_bytes)
+                self._ttnn_client.put(hash_v, v_dev, v_n_bytes)
+            finally:
+                ttnn.deallocate(k_dev)
+                ttnn.deallocate(v_dev)
+            self._layer_shapes.setdefault(layer_idx, (tuple(k_device_tensor.shape), tuple(v_device_tensor.shape)))
+            return
+
+        # Profiling path: granular micro-steps + Perfetto trace events.
+        # Each micro-step is timed independently and recorded as a child
+        # event under the put_layer parent (same tid -> Perfetto stacks them).
+        # The micro-steps attribute frontend time to Python/GIL overhead, fabric, or allocation.
+        tid = 1  # all put_layer activity on the same logical lane
+        t_total_start = time.monotonic()
+
+        t = time.monotonic()
+        k_dev = tt_kv_serde.place_on_sender_dram(k_device_tensor, self._wire_mesh)
+        v_dev = tt_kv_serde.place_on_sender_dram(v_device_tensor, self._wire_mesh)
+        t_h2d_end = time.monotonic()
+        self._record_trace("h2d", "alloc", t, t_h2d_end, tid=tid)
+        try:
+            # ---- bookkeeping micro-steps (previously lumped into "Python overhead") ----
+            t = time.monotonic()
+            k_n_bytes = tt_kv_serde._bfp8_tile_n_bytes(k_dev)
+            v_n_bytes = tt_kv_serde._bfp8_tile_n_bytes(v_dev)
+            t_size_end = time.monotonic()
+            self._record_trace("size_calc", "bookkeep", t, t_size_end, tid=tid)
+
+            t = time.monotonic()
+            hash_k = tt_kv_serde.hash_layer_key(key, layer_idx, "k").encode("utf-8")
+            hash_v = tt_kv_serde.hash_layer_key(key, layer_idx, "v").encode("utf-8")
+            t_hash_end = time.monotonic()
+            self._record_trace("hash_key", "bookkeep", t, t_hash_end, tid=tid)
+
+            # ---- fabric round-trips (the actual wire I/O) ----
+            t = time.monotonic()
+            self._ttnn_client.put(hash_k, k_dev, k_n_bytes)
+            t_put_k_end = time.monotonic()
+            self._record_trace(
+                "put_k",
+                "wire",
+                t,
+                t_put_k_end,
+                tid=tid,
+                args={"bytes": k_n_bytes, "layer": layer_idx},
+            )
+
+            t = time.monotonic()
+            self._ttnn_client.put(hash_v, v_dev, v_n_bytes)
+            t_put_v_end = time.monotonic()
+            self._record_trace(
+                "put_v",
+                "wire",
+                t,
+                t_put_v_end,
+                tid=tid,
+                args={"bytes": v_n_bytes, "layer": layer_idx},
+            )
+        finally:
+            t = time.monotonic()
+            ttnn.deallocate(k_dev)
+            ttnn.deallocate(v_dev)
+            t_dealloc_end = time.monotonic()
+            self._record_trace("dealloc", "alloc", t, t_dealloc_end, tid=tid)
+
+        t = time.monotonic()
+        self._layer_shapes.setdefault(layer_idx, (tuple(k_device_tensor.shape), tuple(v_device_tensor.shape)))
+        t_shape_end = time.monotonic()
+        # Only record non-trivial calls so timer noise does not dominate.
+        if t_shape_end - t > 1e-6:
+            self._record_trace("shape_record", "bookkeep", t, t_shape_end, tid=tid)
+
+        # Parent event spans the whole call (start -> after everything above).
+        t_total_end = time.monotonic()
+        self._record_trace(
+            "put_layer",
+            "put_layer",
+            t_total_start,
+            t_total_end,
+            tid=tid,
+            args={
+                "layer": layer_idx,
+                "bytes": k_n_bytes + v_n_bytes,
+                "key_prefix": key[:40],
+            },
+        )
+        # Aggregate stats (separate from trace, for /stats summary).
+        self._record_op(
+            "put_layer",
+            bytes_count=k_n_bytes + v_n_bytes,
+            total_elapsed=t_total_end - t_total_start,
+            breakdown={
+                "h2d": t_h2d_end - t_total_start,
+                "size_calc": t_size_end - t_h2d_end,
+                "hash_key": t_hash_end - t_size_end,
+                "put_k": t_put_k_end - t_hash_end,
+                "put_v": t_put_v_end - t_put_k_end,
+                "dealloc": t_dealloc_end - t_put_v_end,
+            },
+        )
+
+    def get_layer_raw(self, key: str, layer_idx: int) -> Optional[Tuple[Any, Any]]:
+        """Return the layer's ``(k_host, v_host)`` ttnn host tensors, or ``None``.
+
+        bfp8 TILE passthrough: allocate K and V out_tensors with the spec
+        recorded at put time, run two GETs, and pull each result back to
+        host as a ttnn.Tensor (matching what the slice path produced -- the
+        unslice / coalesce step calls ``to_device`` again to push the chunk
+        into the model chip's KV cache).
+        """
+        shapes = self._layer_shapes.get(layer_idx)
+        if shapes is None:
+            # No put for this layer in this process => cannot size the get.
+            # (cross-process / restart reuse needs spec-based sizing; future.)
+            return None
+        k_shape, v_shape = shapes
+        import ttnn
+
+        profile = self._profile_enabled
+        if not profile:
+            # Fast path: no timer / no record_op / no trace.
+            k_out = tt_kv_serde.make_empty_bfp8_tile_dram(k_shape, self._wire_mesh)
+            v_out = tt_kv_serde.make_empty_bfp8_tile_dram(v_shape, self._wire_mesh)
+            result: Optional[Tuple[Any, Any]] = None
+            try:
+                hash_k = tt_kv_serde.hash_layer_key(key, layer_idx, "k").encode("utf-8")
+                hash_v = tt_kv_serde.hash_layer_key(key, layer_idx, "v").encode("utf-8")
+                hit_k = self._ttnn_client.get(hash_k, k_out)
+                hit_v = self._ttnn_client.get(hash_v, v_out)
+                if not (hit_k and hit_v):
+                    return None
+                k_host = tt_kv_serde.to_host_ttnn(k_out)
+                v_host = tt_kv_serde.to_host_ttnn(v_out)
+                result = (k_host, v_host)
+            finally:
+                ttnn.deallocate(k_out)
+                ttnn.deallocate(v_out)
+            return result
+
+        # Profiling path: granular micro-steps + Perfetto trace events.
+        tid = 2  # all get_layer_raw activity on lane 2 (put_layer is lane 1)
+        t_total_start = time.monotonic()
+
+        t = time.monotonic()
+        k_out = tt_kv_serde.make_empty_bfp8_tile_dram(k_shape, self._wire_mesh)
+        v_out = tt_kv_serde.make_empty_bfp8_tile_dram(v_shape, self._wire_mesh)
+        t_alloc_end = time.monotonic()
+        self._record_trace("alloc_out", "alloc", t, t_alloc_end, tid=tid)
+
+        result: Optional[Tuple[Any, Any]] = None
+        try:
+            t = time.monotonic()
+            hash_k = tt_kv_serde.hash_layer_key(key, layer_idx, "k").encode("utf-8")
+            hash_v = tt_kv_serde.hash_layer_key(key, layer_idx, "v").encode("utf-8")
+            t_hash_end = time.monotonic()
+            self._record_trace("hash_key", "bookkeep", t, t_hash_end, tid=tid)
+
+            t = time.monotonic()
+            hit_k = self._ttnn_client.get(hash_k, k_out)
+            t_get_k_end = time.monotonic()
+            self._record_trace(
+                "get_k",
+                "wire",
+                t,
+                t_get_k_end,
+                tid=tid,
+                args={"layer": layer_idx, "hit": bool(hit_k)},
+            )
+
+            t = time.monotonic()
+            hit_v = self._ttnn_client.get(hash_v, v_out)
+            t_get_v_end = time.monotonic()
+            self._record_trace(
+                "get_v",
+                "wire",
+                t,
+                t_get_v_end,
+                tid=tid,
+                args={"layer": layer_idx, "hit": bool(hit_v)},
+            )
+
+            if not (hit_k and hit_v):
+                t_total_end = time.monotonic()
+                self._record_trace(
+                    "get_layer_raw",
+                    "get_layer",
+                    t_total_start,
+                    t_total_end,
+                    tid=tid,
+                    args={"layer": layer_idx, "hit": False, "key_prefix": key[:40]},
+                )
+                self._record_op(
+                    "get_layer_raw",
+                    bytes_count=0,
+                    total_elapsed=t_total_end - t_total_start,
+                    hit=False,
+                    breakdown={
+                        "alloc": t_alloc_end - t_total_start,
+                        "hash_key": t_hash_end - t_alloc_end,
+                        "get_k": t_get_k_end - t_hash_end,
+                        "get_v": t_get_v_end - t_get_k_end,
+                    },
+                )
+                return None
+
+            t = time.monotonic()
+            k_host = tt_kv_serde.to_host_ttnn(k_out)
+            v_host = tt_kv_serde.to_host_ttnn(v_out)
+            t_d2h_end = time.monotonic()
+            self._record_trace("d2h", "alloc", t, t_d2h_end, tid=tid)
+            result = (k_host, v_host)
+
+            n_bytes = tt_kv_serde._bfp8_tile_n_bytes(k_out) + tt_kv_serde._bfp8_tile_n_bytes(v_out)
+        finally:
+            t = time.monotonic()
+            ttnn.deallocate(k_out)
+            ttnn.deallocate(v_out)
+            t_dealloc_end = time.monotonic()
+            self._record_trace("dealloc", "alloc", t, t_dealloc_end, tid=tid)
+
+        t_total_end = time.monotonic()
+        self._record_trace(
+            "get_layer_raw",
+            "get_layer",
+            t_total_start,
+            t_total_end,
+            tid=tid,
+            args={
+                "layer": layer_idx,
+                "hit": True,
+                "bytes": n_bytes,
+                "key_prefix": key[:40],
+            },
+        )
+        self._record_op(
+            "get_layer_raw",
+            bytes_count=n_bytes,
+            total_elapsed=t_total_end - t_total_start,
+            hit=True,
+            breakdown={
+                "alloc": t_alloc_end - t_total_start,
+                "hash_key": t_hash_end - t_alloc_end,
+                "get_k": t_get_k_end - t_hash_end,
+                "get_v": t_get_v_end - t_get_k_end,
+                "d2h": t_d2h_end - t_get_v_end,
+                "dealloc": t_dealloc_end - t_d2h_end,
+            },
+        )
+        return result
+
+    # ------------------------------------------------------------------
+    # Coalesced PUT / GET (T3KNIC_COALESCE)
+    #
+    # Group several layers' K (and V) tensors along dim 0 into one
+    # (G, kv_heads, block, head) tensor and issue a single Client.put / get
+    # per group. dim 0 is the (untiled) block/batch axis so concat-then-slice
+    # is byte-exact for bfp8 TILE (verified by the standalone batch sweep,
+    # --stack mode). Wire keys use component "kg"/"vg" with the group index in
+    # the layer-idx slot so they never collide with the per-layer "k"/"v"
+    # entries of the non-coalesced path.
+    # ------------------------------------------------------------------
+
+    @staticmethod
+    def _resolve_coalesce_cap() -> int:
+        """Resolve the per-put value byte cap used to size coalesce groups.
+
+        Resolution order (so the Python group planner matches the C++ wire's
+        actual single-value limit rather than a stale 3 MiB constant):
+          1. ``T3KNIC_COALESCE_CAP``        -- explicit Python-side override
+          2. ``KVM_COMMON_MAX_VALUE_BYTES`` -- the same env the kvcache_manager
+             Server/Client read for ``kMaxMultiChunkValueBytes``
+          3. 64 MiB                          -- ``kMaxMultiChunkValueBytesDefault``
+             (ttnn/.../common/protocol/packet.hpp)
+        """
+        for env in ("T3KNIC_COALESCE_CAP", "KVM_COMMON_MAX_VALUE_BYTES"):
+            v = os.environ.get(env)
+            if v is not None and v.strip():
+                try:
+                    iv = int(v.strip())
+                    if iv > 0:
+                        return iv
+                    logger.warning("[t3knic] %s=%r non-positive; ignoring", env, v)
+                except ValueError:
+                    logger.warning("[t3knic] %s=%r not an integer; ignoring", env, v)
+        return 64 * 1024 * 1024  # kMaxMultiChunkValueBytesDefault
+
+    def _build_group_plan(self, num_layers: int, per_layer_bytes: int) -> list:
+        """Partition ``[0, num_layers)`` into groups fitting the value cap.
+
+        Group size ``G = max(1, cap // eff_per_layer)`` so each group's stored
+        value stays under the wire's ``kMaxMultiChunkValueBytes``. Under
+        T3KNIC_KV_MERGE the stored value is ``concat[kg, vg]`` = 2x the per-group
+        K bytes, so the per-layer budget is doubled (``eff_per_layer``) to keep
+        the merged value under cap. Deterministic in the inputs, so the same plan
+        is reused by get / delete within this process.
+        """
+        eff_per_layer = per_layer_bytes * (2 if self._kv_merge else 1)
+        g = max(1, self._coalesce_cap_bytes // max(1, eff_per_layer))
+        return [list(range(start, min(start + g, num_layers))) for start in range(0, num_layers, g)]
+
+    def _validate_pool_against_authoritative(self, k_list: list) -> None:
+        """One-shot check that the open()-time pool shape matches the first
+        put's authoritative per-layer shape.
+
+        Logs a warning on mismatch (the pool remains unused, so per-call allocation handles the
+        authoritative shape) and
+        an info confirmation on match. Never raises into the hot path.
+        """
+        self._pool_shape_validated = True
+        try:
+            actual = tuple(int(d) for d in k_list[0].shape)
+            expected = tuple(int(d) for d in (self._pool_per_layer_shape or ()))
+            self._pool_shape_ok = actual == expected
+            if not self._pool_shape_ok:
+                logger.warning(
+                    "[t3knic] pool: per-layer shape mismatch -- open()-time prealloc "
+                    "%s vs first-put authoritative %s. Buffer reuse is "
+                    "disabled (hot path will lazy-allocate per call).",
+                    expected,
+                    actual,
+                )
+            else:
+                logger.info(
+                    "[t3knic] pool: per-layer shape %s confirmed against first put%s.",
+                    actual,
+                    " (buffer reuse ACTIVE)" if self._buf_reuse else "",
+                )
+        except Exception as e:  # noqa: BLE001
+            self._pool_shape_ok = False
+            logger.debug("[t3knic] pool: shape validation skipped (%s)", e)
+
+    # ---- raw-over-wire bridge (MAF-20670: TP>1 model + wire backend) ----
+    # The raw-byte codec is mandatory for TP-sharded caches (torch-fill restore
+    # corrupts them), and the wire is a plain byte store, so a chunk's raw
+    # buffers ride the wire as ONE serialized value under a single "raw" key:
+    #   int32 header [MAGIC, num_layers, nbytes(layer_0..L-1)] | payload bytes.
+
+    _RAW_WIRE_MAGIC = 0x524B564D  # 'RKVM'
+
+    @staticmethod
+    def _raw_wire_key(key: str) -> bytes:
+        return tt_kv_serde.hash_layer_key(key, 0, "raw").encode("utf-8")
+
+    def _raw_wire_upper_bound_bytes(self) -> int:
+        """Upper bound for a serialized full chunk (allocation size for GET)."""
+        seen = getattr(self, "_raw_wire_seen_max", 0)
+        n_layers = self._spec_num_layers or 0
+        chunk = self._spec_chunk_size or self._spec_block_size or 0
+        heads = self._spec_num_kv_heads or 0
+        head = self._spec_head_size or 0
+        est = 0
+        if n_layers and chunk and heads and head:
+            per_layer = 2 * chunk * heads * head * 2  # K|V regions, bf16-size upper bound
+            est = 4 * (2 + n_layers) + n_layers * per_layer
+        total = max(seen, est)
+        return (total + 3) & ~3
+
+    # ------------------------------------------------------------------
+    # on-device chunk path (no host round trip)
+    # ------------------------------------------------------------------
+
+    _WIRE_MODES = ("auto", "device", "per_chip", "mock", "host", "global_master")
+
+    @staticmethod
+    def _resolve_wire_mode(configured: object) -> str:
+        mode = os.environ.get("T3KNIC_WIRE_MODE") or (str(configured) if configured is not None else "auto")
+        mode = mode.strip().lower()
+        if mode not in TTKVCacheClient._WIRE_MODES:
+            raise ValueError(
+                f"T3KNIC_WIRE_MODE/kvcache_wire_mode must be one of {TTKVCacheClient._WIRE_MODES}; got {mode!r}"
+            )
+        return mode
+
+    def wire_uses_device_path(self) -> bool:
+        """Whether chunk store/retrieve takes the on-device path, mode included.
+
+        Callers must key their branching on this and not on the wire coordinate alone: in "host"
+        mode the coordinate is still set, so a coordinate check would route to the device path and
+        treat its refusal as a cache miss.
+        """
+        return self.wire_mode != "host" and self._device_path_available()
+
+    def _device_path_available(self) -> bool:
+        if self._uses_mock():
+            # No Client exists in mock mode; the "wire" is the in-process dict.
+            return self.raw_codec is not None and self._opened
+        if self._gm_role == "forwarder":
+            # No Client on a forwarder either; the wire lives behind the owner's proxy.
+            return self.raw_codec is not None and self._opened and self._wire_coord is not None
+        return self.raw_codec is not None and self._ttnn_client is not None and self._wire_coord is not None
+
+    def _use_device_path(self, op: str) -> bool:
+        """Whether this op takes the on-device path, honouring the configured mode.
+
+        "device" and "per_chip" refuse to fall back silently: a deployment that asked for one and
+        cannot have it is misconfigured, and discovering that through a quiet drop to the host path
+        is how a performance regression hides for weeks.
+        """
+        if self.wire_mode == "host":
+            return False
+        available = self._device_path_available()
+        if self.wire_mode in ("device", "per_chip", "mock", "global_master") and not available:
+            raise RuntimeError(
+                f"T3KNIC wire mode {self.wire_mode!r} was requested but the on-device {op} path is "
+                f"unavailable (raw_codec={self.raw_codec is not None}, "
+                f"client={self._ttnn_client is not None}, wire_coord={self._wire_coord})"
+            )
+        return available
+
+    def _device_lock(self):
+        """Exclusion against trace capture, where this stack has none.
+
+        The wire client enqueues on the model's own mesh. An op issued between
+        begin_trace_capture and end_trace_capture is recorded into the trace instead of run, so
+        a restore that lands in a capture window writes nothing and the cache keeps stale KV.
+
+        A plain in-process mutex only excludes when both sides take it. This stack captures in
+        models/tt_transformers/tt/generator.py, which exposes no mutex for the connector to share.
+        Returning a null context is therefore the honest answer; doing it silently was not, which
+        is why this says so once.
+
+        Keeping capture out of the serving path is the mitigation that does work --
+        TT_WARMUP_PREFILL_RESUMED moves the resumed-prefill capture to start-up. It narrows the
+        window rather than closing it: any capture vLLM performs later is still unguarded.
+        """
+        import contextlib
+
+        if not TTKVCacheClient._device_lock_warned:
+            TTKVCacheClient._device_lock_warned = True
+            logger.warning(
+                "[t3knic] no trace-capture exclusion on this stack: device ops are not held off "
+                "trace capture. Harmless while every capture happens at start-up "
+                "(TT_WARMUP_PREFILL_RESUMED=1); a capture during serving can swallow a restore."
+            )
+        return contextlib.nullcontext()
+
+    def _prealloc_wire_blob(self) -> None:
+        """Allocate the wire blob at open() instead of on the first chunk store.
+
+        The first store lands after compile_or_warm_up_model has captured the decode trace that
+        runs for the rest of the process, and tt_metal only tolerates a buffer allocated then if
+        its lifetime ends before that trace runs -- which this one's does not (it is reused for
+        every chunk). Doing it here is what keeps the allocator out of trace-owned memory.
+
+        The size is fully determined by configuration, so this needs neither raw_codec nor the live
+        cache tensors (neither of which exists yet at open()): per layer the blob holds one block's
+        K+V for each contributing chip, plus a 32-byte-aligned header. A partial chunk is smaller,
+        so a full chunk is the exact maximum rather than a guess.
+        """
+        layers = self._spec_num_layers
+        page = self._spec_page_size_padded
+        block = self._spec_block_size
+        chunk = self._spec_chunk_size
+        if not (layers and page and block and chunk):
+            raise RuntimeError(
+                "TTKVCacheClient.open: device wire blob geometry is incomplete "
+                f"(layers={layers}, page_size_padded={page}, block={block}, chunk={chunk})"
+            )
+
+        n_blocks = (chunk + block - 1) // block
+        header_words = 2 + layers  # magic + layer count + one size per layer
+        header_words += (-header_words * 4 % _RAW_HEADER_ALIGN) // 4
+        header_bytes = 4 * header_words
+        # Per-chip PUT stores one rank's shard, so one chip contributes. The gather path packs the
+        # whole TP row into one blob. The model mesh is laid out (dp, tp), so its second axis is the
+        # TP width -- the same source device_shard_plan uses for its coordinates.
+        shape = tuple(int(d) for d in self._wire_mesh.shape)
+        contributors = 1 if self._uses_per_chip() else (shape[1] if len(shape) > 1 else 1)
+        value_len = header_bytes + layers * n_blocks * page * contributors
+
+        self._wire_blob_tensor((value_len + 3) // 4)
+        logger.info(
+            "[t3knic] wire blob pre-allocated: %.2f MiB per chip (%d layers x %d block(s) x %d B x %d chip(s))",
+            value_len / (1024 * 1024),
+            layers,
+            n_blocks,
+            page,
+            contributors,
+        )
+
+    def _wire_blob_tensor(self, words: int):
+        """A blob tensor on the model mesh, reused across chunks and grown when needed."""
+        import torch
+        import ttnn
+
+        if self._wire_blob is not None and self._wire_blob_words >= words:
+            return self._wire_blob
+        if self._opened:
+            # Growing after open() means allocating while vLLM's decode trace is captured, which is
+            # the pattern that hung the device once already (a trace can land on the L1 the
+            # allocator hands out). _prealloc_wire_blob sizes for a FULL chunk from configuration,
+            # so reaching here means that sizing is wrong -- say so rather than let it recur
+            # silently, and say by how much so the formula can be corrected.
+            raise RuntimeError(
+                "TTKVCacheClient wire blob capacity was underestimated at open(): "
+                f"need {words} words, have {self._wire_blob_words}; refusing allocation after trace capture"
+            )
+        if self._wire_blob is not None:
+            ttnn.deallocate(self._wire_blob)
+            self._wire_blob = None
+        # 32 KiB pages: the wire requires page_size % 32 == 0 and the ops address DRAM per page.
+        pages = (words + 8191) // 8192
+        mapper = ttnn.ReplicateTensorToMesh(self._wire_mesh) if self._wire_coord is not None else None
+        kwargs = {"mesh_mapper": mapper} if mapper is not None else {}
+        self._wire_blob = ttnn.from_torch(
+            torch.zeros(pages * 8192, dtype=torch.int32).reshape(pages, 8192),
+            device=self._wire_mesh,
+            layout=ttnn.ROW_MAJOR_LAYOUT,
+            memory_config=ttnn.DRAM_MEMORY_CONFIG,
+            **kwargs,
+        )
+        self._wire_blob_words = pages * 8192
+        return self._wire_blob
+
+    def _wire_master_coord(self):
+        import ttnn
+
+        return ttnn.MeshCoordinate(*(self._wire_coord if self._wire_coord is not None else (0, 0)))
+
+    @staticmethod
+    def _rank_coords(plan):
+        import ttnn
+
+        return [ttnn.MeshCoordinate(*c) for c in plan["rank_coords"]]
+
+    def _uses_per_chip(self) -> bool:
+        """Per-chip PUT: every owning chip sends its own shard, so there is no gather leg."""
+        return self.wire_mode == "per_chip"
+
+    def _uses_mock(self) -> bool:
+        """Mock wire: host memory stands in for the Server; device ops stay real."""
+        return self.wire_mode == "mock"
+
+    def _wire_agg_add(self, kind: str, nbytes: int, seconds: float) -> None:
+        """Accumulate one python-level wire call and summarise a batch of them."""
+        slot = self._wire_agg.get(kind)
+        if slot is None or self._wire_agg_every <= 0:
+            return
+        slot[0] += int(nbytes)
+        slot[1] += float(seconds)
+        slot[2] += 1
+        if slot[2] >= self._wire_agg_every:
+            total_bytes, total_s, calls = slot
+            logger.info(
+                "[t3knic][wire] %s x%d: %.2f MiB in %.3f s -> %.2f Gbit/s (%.2f GB/s), %.2f ms/call",
+                kind,
+                calls,
+                total_bytes / 1048576.0,
+                total_s,
+                (total_bytes * 8.0 / 1e9) / total_s if total_s > 0 else 0.0,
+                (total_bytes / 1e9) / total_s if total_s > 0 else 0.0,
+                total_s * 1e3 / calls,
+            )
+            self._wire_agg[kind] = [0, 0.0, 0]
+
+    @staticmethod
+    def _resolve_gm_owner() -> bool:
+        """Whether THIS rank owns the global-master wire (option 1-1, F6).
+
+        Priority: explicit T3KNIC_GM_IS_OWNER (deployments that must pin the owner
+        to a specific host/process) > this worker's PP rank equals
+        T3KNIC_GLOBAL_MASTER_STAGE (default 0; every rank can run the same env) >
+        single-process fallback (no PP group initialized -> the only rank owns).
+        """
+        explicit = os.environ.get("T3KNIC_GM_IS_OWNER")
+        if explicit is not None:
+            return explicit == "1"
+        from lmcache_t3knic.t3knic_lmcache import intermesh
+
+        # Cross-node: ownership is not a free choice. Only the rank whose slice of the Galaxy holds
+        # the cable's card can drive the wire, so let that fact elect the owner rather than a
+        # hand-set stage number that silently rots when the rank-to-card assignment changes.
+        if intermesh.role_from_env() == "galaxy":
+            return intermesh.gateway_visible("galaxy")
+        want = int(os.environ.get("T3KNIC_GLOBAL_MASTER_STAGE", "0"))
+        try:
+            from vllm.distributed import get_pp_group
+
+            return int(get_pp_group().rank_in_group) == want
+        except Exception:  # noqa: BLE001 - no distributed context = single process
+            return True
+
+    def _shard_client(self, coord: tuple):
+        """Return the wire client preattached to ``coord`` during open()."""
+        import ttnn
+        from lmcache_t3knic.t3knic_lmcache._kvm_backend import kvcache_manager
+
+        key = tuple(int(c) for c in coord)
+        client = self._shard_clients.get(key)
+        if client is not None:
+            return client
+        if key == tuple(self._wire_coord or ()):
+            # The master already holds an attachment for this chip; a second Client on the same
+            # coordinate is rejected by the ttnn client registry, so reuse it. Deliberately NOT
+            # cached here: close() closes everything in this dict and then closes the master, so an
+            # alias would detach the same attachment twice.
+            return self._ttnn_client
+        if self._opened:
+            # open() attaches every model-mesh coordinate up front, so a miss here means the caller
+            # named a chip outside the mesh. Attaching now would allocate this Client's L1 after
+            # trace capture -- the exact pattern open() front-loads to avoid.
+            raise RuntimeError(
+                f"[t3knic] no per-chip wire client for coordinate {key}; model mesh is "
+                f"{tuple(int(d) for d in self._wire_mesh.shape)}"
+            )
+        if self.config.get("mode") == "external":
+            flat = self._flat_chip_index(key)
+            server_group, lane = self._external_route_for_flat(flat)
+            client = kvcache_manager.Client(
+                self._wire_mesh,
+                server_node=None,
+                client_coord=ttnn.MeshCoordinate(*key),
+                static_intermesh_galaxy_to_t3k=True,
+                server_worker_group=server_group,
+                static_intermesh_lane=lane,
+            )
+        else:
+            client = kvcache_manager.Client(
+                self._wire_mesh,
+                server_node=self._server_node,
+                client_coord=ttnn.MeshCoordinate(*key),
+            )
+        self._shard_clients[key] = client
+        logger.debug("[t3knic] per-chip wire client attached at model-mesh coordinate %s", key)
+        return client
+
+    def _external_route_for_flat(self, flat: int) -> tuple[int, int]:
+        """Match each client to the same lane used by its Server shard's shared MUX channel."""
+        server_group = int(flat) % self._external_server_shards
+        return server_group, server_group % self._external_lane_count
+
+    def _raw_shard_key(self, key: str, tp_rank: int) -> bytes:
+        """Per-shard key, distinguished by TP RANK -- deliberately not by the chip's flat shard
+        index.
+
+        DP groups replicate the weights, so the KV a given TP rank computes for a given token
+        sequence is the same bytes whichever group ran it. Keying by rank therefore keeps a lookup
+        well defined without knowing which group stored the chunk (``exists`` has no slot mapping to
+        derive it from), and lets one group's stores serve the other's reads.
+        """
+        return tt_kv_serde.hash_layer_key(key, int(tp_rank), "raw").encode("utf-8")
+
+    def _shard_indices(self) -> range:
+        return range(self.raw_codec.tp_size)
+
+    def _shard_client_for_rank(self, tp_rank: int):
+        """Return the client whose Server directory owns ``tp_rank``.
+
+        Shard keys intentionally omit the DP row. Query the wire master's DP row
+        and select the requested TP column so lookup and deletion reach the same
+        independent Server shard that handled the store.
+        """
+        shape = tuple(int(dimension) for dimension in self._wire_mesh.shape)
+        if len(shape) == 1:
+            coord = (int(tp_rank),)
+        else:
+            master = tuple(int(component) for component in (self._wire_coord or (0,) * len(shape)))
+            coord = (*master[:-1], int(tp_rank))
+        return self._shard_client(coord)
+
+    def _pack_local_shards(self, plans, blob):
+        """Pack every chip's own shard of the chunk into its own blob replica, simultaneously.
+
+        No fabric traffic: each chip copies its own cache blocks into its own blob shard. The copy
+        exists only because Client.put takes ONE contiguous buffer while a chunk's bytes live in one
+        block of each of the ~2*num_layers cache tensors.
+
+        One batched op rather than a per-chip loop preserves chip-level parallelism; per-chip calls
+        would serialize behind blocking enqueues. The per-shard plans share every geometric field
+        and differ only in the chip they name, which is what makes one call for all of them possible.
+        """
+        from lmcache_t3knic.t3knic_lmcache._kvm_backend import kvcache_operations
+
+        first = plans[0]
+        kvcache_operations.pack_local_shards(
+            first["members"],
+            blob,
+            [self._coord_of(p["coord"]) for p in plans],
+            first["block_ids"],
+            int(first["shard_block_bytes"]),
+            first["region_bases"],
+            first["header_words"],
+        )
+
+    def _unpack_local_shards(self, plans, blob):
+        """Inverse of :meth:`_pack_local_shards`: every chip writes its shard back, simultaneously."""
+        from lmcache_t3knic.t3knic_lmcache._kvm_backend import kvcache_operations
+
+        first = plans[0]
+        kvcache_operations.unpack_local_shards(
+            blob,
+            first["members"],
+            [self._coord_of(p["coord"]) for p in plans],
+            first["block_ids"],
+            int(first["shard_block_bytes"]),
+            first["region_bases"],
+        )
+
+    def _flat_chip_index(self, coord) -> int:
+        """get_device_tensors index of a model-mesh coordinate (row-major)."""
+        shape = tuple(int(d) for d in self._wire_mesh.shape)
+        idx = 0
+        for dim, c in zip(shape, tuple(int(x) for x in coord)):
+            idx = idx * dim + c
+        return idx
+
+    def _mock_blob_tensor(self, words: int):
+        """The mock wire's blob: dim-0 SHARDED so each chip's rows hold that chip's bytes.
+
+        Sharded rather than replicated because a GET must place DIFFERENT bytes on each chip
+        (its own shard), and a sharded host tensor lets one in-place copy_host_to_device_tensor
+        do that without allocating -- allocating per GET is the captured-trace hazard all the
+        wire's buffers exist to avoid.
+        """
+        import torch
+        import ttnn
+
+        chips = 1
+        for d in tuple(self._wire_mesh.shape):
+            chips *= int(d)
+        pages = (words + 8191) // 8192
+        if self._mock_blob is not None and self._mock_blob_words >= pages * 8192:
+            return self._mock_blob
+        if self._opened:
+            raise RuntimeError(
+                "TTKVCacheClient mock blob capacity was underestimated at open(): "
+                f"need {pages * 8192} words/chip, have {self._mock_blob_words}; "
+                "refusing allocation after trace capture"
+            )
+        if self._mock_blob is not None:
+            ttnn.deallocate(self._mock_blob)
+            self._mock_blob = None
+        self._mock_blob = ttnn.from_torch(
+            torch.zeros(chips * pages, 8192, dtype=torch.int32),
+            device=self._wire_mesh,
+            layout=ttnn.ROW_MAJOR_LAYOUT,
+            memory_config=ttnn.DRAM_MEMORY_CONFIG,
+            mesh_mapper=ttnn.ShardTensorToMesh(self._wire_mesh, dim=0),
+        )
+        self._mock_blob_words = pages * 8192
+        return self._mock_blob
+
+    def _prealloc_mock_blob(self) -> None:
+        """Size the mock blob from configuration, mirroring _prealloc_wire_blob (contributors=1)."""
+        layers = self._spec_num_layers
+        page = self._spec_page_size_padded
+        block = self._spec_block_size
+        chunk = self._spec_chunk_size
+        if not (layers and page and block and chunk):
+            raise RuntimeError(
+                "TTKVCacheClient.open: mock wire blob geometry is incomplete "
+                f"(layers={layers}, page_size_padded={page}, block={block}, chunk={chunk})"
+            )
+        n_blocks = (chunk + block - 1) // block
+        header_words = 2 + layers
+        header_words += (-header_words * 4 % _RAW_HEADER_ALIGN) // 4
+        value_len = 4 * header_words + layers * n_blocks * page  # one chip's shard
+        self._mock_blob_tensor((value_len + 3) // 4)
+        logger.info(
+            "[t3knic] mock blob pre-allocated: %.2f MiB per chip",
+            value_len / (1024 * 1024),
+        )
+
+    def put_chunk_mock(self, key: str, kvcaches: object, num_layers: int, slot_mapping_slice: object) -> bool:
+        """Mock store: real plans, real on-device pack -- then D2H into host memory instead of a PUT."""
+        import ttnn
+
+        t_entry = time.monotonic()
+        with self._device_lock():
+            plans = [
+                self.raw_codec.device_shard_plan(kvcaches, num_layers, slot_mapping_slice, tp_rank)
+                for tp_rank in self._shard_indices()
+            ]
+            value_len = int(plans[0]["value_len"])
+            words = (value_len + 3) // 4
+            blob = self._mock_blob_tensor(words)
+            t_pack = time.monotonic()
+            self._pack_local_shards(plans, blob)
+            t_d2h = time.monotonic()
+            shards = ttnn.get_device_tensors(blob)
+            for plan in plans:
+                shard = ttnn.to_torch(shards[self._flat_chip_index(plan["coord"])]).reshape(-1)
+                self._mock_wire_store[self._raw_shard_key(key, plan["tp_rank"])] = (
+                    value_len,
+                    shard[:words].clone(),
+                )
+            t_end = time.monotonic()
+        self._record_op(
+            "chunk_store_mock",
+            value_len * len(plans),
+            t_end - t_entry,
+            breakdown={"pack": t_d2h - t_pack, "d2h": t_end - t_d2h},
+        )
+        return True
+
+    def get_chunk_mock(self, key: str, kvcaches: object, num_layers: int, slot_mapping_slice: object) -> bool:
+        """Mock restore: host memory -> in-place H2D into the sharded blob -> real on-device unpack."""
+        import torch
+        import ttnn
+
+        t_entry = time.monotonic()
+        with self._device_lock():
+            plans = [
+                self.raw_codec.device_shard_plan(kvcaches, num_layers, slot_mapping_slice, tp_rank)
+                for tp_rank in self._shard_indices()
+            ]
+            stored = []
+            for plan in plans:
+                entry = self._mock_wire_store.get(self._raw_shard_key(key, plan["tp_rank"]))
+                if entry is None:
+                    return False  # a chunk is whole or absent -- same rule as per_chip
+                stored.append((plan, entry))
+            value_len = int(plans[0]["value_len"])
+            words = (value_len + 3) // 4
+            blob = self._mock_blob_tensor(words)
+            pages = self._mock_blob_words // 8192
+            chips = 1
+            for d in tuple(self._wire_mesh.shape):
+                chips *= int(d)
+            t_h2d = time.monotonic()
+            host = torch.zeros(chips * pages, 8192, dtype=torch.int32)
+            for plan, (_len, data) in stored:
+                flat = self._flat_chip_index(plan["coord"])
+                host.reshape(chips, -1)[flat, : data.numel()] = data
+            src = ttnn.from_torch(
+                host,
+                dtype=ttnn.int32,
+                layout=ttnn.ROW_MAJOR_LAYOUT,
+                mesh_mapper=ttnn.ShardTensorToMesh(self._wire_mesh, dim=0),
+            )
+            ttnn.copy_host_to_device_tensor(src, blob)
+            t_unpack = time.monotonic()
+            self._unpack_local_shards(plans, blob)
+            t_end = time.monotonic()
+        self._record_op(
+            "chunk_load_mock",
+            value_len * len(plans),
+            t_end - t_entry,
+            hit=True,
+            breakdown={"h2d": t_unpack - t_h2d, "unpack": t_end - t_unpack},
+        )
+        return True
+
+    # ------------------------------------------------------------------
+    # Byte-exact verification of the device wire paths.
+    # ------------------------------------------------------------------
+    def _kvdiff_digest(self, blob, device_index: int, value_len: int) -> str:
+        """sha256 of the first value_len bytes of one chip's blob replica (one D2H)."""
+        import hashlib
+
+        import ttnn
+
+        words = (value_len + 3) // 4
+        host = ttnn.to_torch(ttnn.get_device_tensors(blob)[device_index]).reshape(-1)[:words]
+        return hashlib.sha256(host.numpy().tobytes()[:value_len]).hexdigest()
+
+    def _kvdiff_remember(self, wire_key: bytes, digest: str) -> None:
+        d = self._kvdiff_digests
+        d[wire_key] = digest
+        d.move_to_end(wire_key)
+        while len(d) > 8192:  # bounded: a stale eviction downgrades a later verdict to unknown, not wrong
+            d.popitem(last=False)
+
+    def _kvdiff_wire_verdict(self, wire_key: bytes, received: str) -> str:
+        stored = self._kvdiff_digests.get(wire_key)
+        if stored is None:
+            return "unknown"
+        return "bit_exact" if stored == received else "MISMATCH"
+
+    @staticmethod
+    def _kvdiff_summary(verdicts) -> str:
+        bad = sum(1 for v in verdicts if v == "MISMATCH")
+        if bad:
+            return f"MISMATCH({bad}/{len(verdicts)})"
+        if any(v == "unknown" for v in verdicts):
+            return "unknown"
+        return "bit_exact"
+
+    def _kvdiff_poison_blob(self, blob) -> None:
+        """Overwrite every replica of the blob with zeros before the restore-leg re-op.
+
+        Without this the comparison buffer is pre-seeded with the expected answer: the
+        received bytes are already in the blob, so a re-pack/re-gather that silently does
+        nothing would digest as bit_exact. Zeroed, a dead re-op fails at the first header
+        word (MAGIC is nonzero). Host-side allocation only; the device buffer is reused.
+        """
+        import ttnn
+
+        host = torch.zeros(tuple(blob.shape), dtype=torch.int32)
+        src = ttnn.from_torch(
+            host,
+            dtype=ttnn.int32,
+            layout=ttnn.ROW_MAJOR_LAYOUT,
+            mesh_mapper=ttnn.ReplicateTensorToMesh(self._wire_mesh),
+        )
+        ttnn.copy_host_to_device_tensor(src, blob)
+
+    def _kvdiff_log(self, path: str, key: str, wire: str, restore: str, detail: str = "") -> None:
+        both = wire + restore
+        if "MISMATCH" in both:
+            self._stats_counters["kvdiff_mismatch"] += 1
+            level = logger.error
+        elif "unknown" in both:
+            level = logger.warning
+        else:
+            level = logger.info
+        level(
+            "[t3knic][kvdiff] path=%s key=..%s wire=%s restore=%s%s",
+            path,
+            key[-24:],
+            wire,
+            restore,
+            f" {detail}" if detail else "",
+        )
+
+    def put_chunk_per_chip(self, key: str, kvcaches: object, num_layers: int, slot_mapping_slice: object) -> bool:
+        """Store one chunk as one value per owning chip -- no gather, one fabric leg instead of two.
+
+        Every shard must land: a chunk whose shards are partly stored would restore mixed KV, and
+        the directory has no notion of a group. So a failure here raises rather than reporting a
+        partial store, and the connector's store-failure counter escalates it (see B-1).
+        """
+
+        t_entry = time.monotonic()
+        with self._device_lock():
+            plans = [
+                self.raw_codec.device_shard_plan(kvcaches, num_layers, slot_mapping_slice, tp_rank)
+                for tp_rank in self._shard_indices()
+            ]
+            # Identical across ranks: the per-shard plans share their geometry and differ only in
+            # which chip they name.
+            value_len = int(plans[0]["value_len"])
+            blob = self._wire_blob_tensor((value_len + 3) // 4)
+            t_pack = time.monotonic()
+            self._pack_local_shards(plans, blob)
+            t_put = time.monotonic()
+            for plan in plans:
+                self._shard_client(plan["coord"]).put(self._raw_shard_key(key, plan["tp_rank"]), blob, value_len)
+            t_end = time.monotonic()
+            if self._kvdiff_enabled:
+                try:
+                    for plan in plans:
+                        self._kvdiff_remember(
+                            self._raw_shard_key(key, plan["tp_rank"]),
+                            self._kvdiff_digest(blob, self._flat_chip_index(plan["coord"]), value_len),
+                        )
+                except Exception as e:  # noqa: BLE001
+                    logger.error(
+                        "[t3knic][kvdiff] ERROR verification machinery failed (per_chip put): %s",
+                        e,
+                    )
+        self._record_op(
+            "chunk_store_per_chip",
+            value_len * len(plans),
+            t_end - t_entry,
+            breakdown={"pack": t_put - t_pack, "put": t_end - t_put},
+        )
+        return True
+
+    def get_chunk_per_chip(self, key: str, kvcaches: object, num_layers: int, slot_mapping_slice: object) -> bool:
+        """Restore one chunk, each chip pulling its own shard back into its own cache blocks.
+
+        A miss on any shard is a miss for the whole chunk: the caller must not be handed a cache
+        where some ranks were refilled and others still hold whatever was there.
+        """
+        t_entry = time.monotonic()
+        with self._device_lock():
+            plans = [
+                self.raw_codec.device_shard_plan(kvcaches, num_layers, slot_mapping_slice, tp_rank)
+                for tp_rank in self._shard_indices()
+            ]
+            blob = self._wire_blob_tensor((max(int(p["value_len"]) for p in plans) + 3) // 4)
+            # Two passes. The blob is replicated across the mesh, so each chip's GET lands in its
+            # own shard and the fetches do not collide -- which lets every shard be in hand before
+            # the first byte is written back. A miss discovered mid-scatter would otherwise leave
+            # some ranks refilled and others holding whatever was there, which is worse than a miss.
+            t_get = time.monotonic()
+            clients = [self._shard_client(plan["coord"]) for plan in plans]
+            keys = [self._raw_shard_key(key, plan["tp_rank"]) for plan in plans]
+            if not all(type(clients[0]).get_parallel(clients, keys, blob)):
+                return False
+            t_unpack = time.monotonic()
+            self._unpack_local_shards(plans, blob)
+            t_end = time.monotonic()
+            if self._kvdiff_enabled:
+                # Verification only: it must never turn a load that already landed into
+                # a failure, so machinery errors are logged (kv_verify greps for them)
+                # rather than raised.
+                try:
+                    # The unpack only reads the blob, so the received bytes are still in it.
+                    received = {
+                        plan["tp_rank"]: self._kvdiff_digest(
+                            blob,
+                            self._flat_chip_index(plan["coord"]),
+                            int(plan["value_len"]),
+                        )
+                        for plan in plans
+                    }
+                    wire = self._kvdiff_summary(
+                        [
+                            self._kvdiff_wire_verdict(
+                                self._raw_shard_key(key, p["tp_rank"]),
+                                received[p["tp_rank"]],
+                            )
+                            for p in plans
+                        ]
+                    )
+                    # Re-pack from the live caches: reproducing the received bytes proves the
+                    # unpack landed every byte where the next forward will read it. Poison
+                    # first, or a dead re-pack would compare the received bytes to themselves.
+                    self._kvdiff_poison_blob(blob)
+                    self._pack_local_shards(plans, blob)
+                    restore = self._kvdiff_summary(
+                        [
+                            (
+                                "bit_exact"
+                                if self._kvdiff_digest(
+                                    blob,
+                                    self._flat_chip_index(p["coord"]),
+                                    int(p["value_len"]),
+                                )
+                                == received[p["tp_rank"]]
+                                else "MISMATCH"
+                            )
+                            for p in plans
+                        ]
+                    )
+                    self._kvdiff_log("per_chip", key, wire, restore)
+                except Exception as e:  # noqa: BLE001
+                    logger.error(
+                        "[t3knic][kvdiff] ERROR verification machinery failed (per_chip): %s",
+                        e,
+                    )
+        self._record_op(
+            "chunk_load_per_chip",
+            sum(int(p["value_len"]) for p in plans),
+            t_end - t_entry,
+            hit=True,
+            breakdown={"get": t_unpack - t_get, "unpack": t_end - t_unpack},
+        )
+        return True
+
+    @staticmethod
+    def _coord_of(coord):
+        import ttnn
+
+        return ttnn.MeshCoordinate(*(int(c) for c in coord))
+
+    def put_chunk_device(self, key: str, kvcaches: object, num_layers: int, slot_mapping_slice: object) -> bool:
+        """Store one chunk straight from the live caches: fabric gather, then wire PUT.
+
+        Returns False when this path does not apply (no raw codec, or a dict backend), so the
+        caller can fall back to the host gather.
+        """
+        if not self._use_device_path("store"):
+            return False
+        if self._uses_mock():
+            return self.put_chunk_mock(key, kvcaches, num_layers, slot_mapping_slice)
+        if self._uses_per_chip():
+            return self.put_chunk_per_chip(key, kvcaches, num_layers, slot_mapping_slice)
+        if self._gm_role == "forwarder":
+            return self.put_chunk_gm_forward(key, kvcaches, num_layers, slot_mapping_slice)
+        from lmcache_t3knic.t3knic_lmcache._kvm_backend import kvcache_operations
+
+        plan = self.raw_codec.device_chunk_plan(kvcaches, num_layers, slot_mapping_slice)
+        value_len = int(plan["value_len"])
+        # Split the two legs. Which one dominates decides whether the gather is worth removing
+        # for per-chip PUT or whether the wire is the ceiling either way.
+        t_entry = time.monotonic()
+        with self._device_lock():
+            blob = self._wire_blob_tensor((value_len + 3) // 4)
+            t_gather = time.monotonic()
+            kvcache_operations.gather_tp_shards_to_chip(
+                plan["members"],
+                blob,
+                self._wire_master_coord(),
+                self._rank_coords(plan),
+                plan["block_ids"],
+                int(plan["shard_block_bytes"]),
+                plan["region_bases"],
+                plan["header_words"],
+            )
+            t_put = time.monotonic()
+            self._ttnn_client.put(self._raw_wire_key(key), blob, value_len)
+            t_end = time.monotonic()
+            self._wire_agg_add("PUT", value_len, t_end - t_put)
+            if self._kvdiff_enabled:
+                try:
+                    self._kvdiff_remember(
+                        self._raw_wire_key(key),
+                        self._kvdiff_digest(blob, self._wire_shard_index(), value_len),
+                    )
+                except Exception as e:  # noqa: BLE001
+                    logger.error(
+                        "[t3knic][kvdiff] ERROR verification machinery failed (device put): %s",
+                        e,
+                    )
+        self._record_op(
+            "chunk_store_device",
+            value_len,
+            t_end - t_entry,
+            breakdown={"gather": t_put - t_gather, "put": t_end - t_put},
+        )
+        return True
+
+    def get_chunk_device(self, key: str, kvcaches: object, num_layers: int, slot_mapping_slice: object) -> bool:
+        """Restore one chunk into the live caches: wire GET, then fabric scatter.
+
+        Returns False on a miss or when this path does not apply.
+        """
+        if not self._use_device_path("retrieve"):
+            return False
+        if self._uses_mock():
+            return self.get_chunk_mock(key, kvcaches, num_layers, slot_mapping_slice)
+        if self._uses_per_chip():
+            return self.get_chunk_per_chip(key, kvcaches, num_layers, slot_mapping_slice)
+        if self._gm_role == "forwarder":
+            return self.get_chunk_gm_forward(key, kvcaches, num_layers, slot_mapping_slice)
+        from lmcache_t3knic.t3knic_lmcache._kvm_backend import kvcache_operations
+
+        plan = self.raw_codec.device_chunk_plan(kvcaches, num_layers, slot_mapping_slice)
+        # Split the two legs to distinguish gather/scatter time from wire time.
+        t_entry = time.monotonic()
+        with self._device_lock():
+            blob = self._wire_blob_tensor((int(plan["value_len"]) + 3) // 4)
+            t_get = time.monotonic()
+            if not self._ttnn_client.get(self._raw_wire_key(key), blob):
+                return False
+            t_scatter = time.monotonic()
+            kvcache_operations.scatter_chunk_from_chip(
+                blob,
+                plan["members"],
+                self._wire_master_coord(),
+                self._rank_coords(plan),
+                plan["block_ids"],
+                int(plan["shard_block_bytes"]),
+                plan["region_bases"],
+            )
+            t_end = time.monotonic()
+            # T3KNIC_TIMING_LOG: where a device-path restore actually spends its time. The
+            # raw-byte codec routes through here, not through get_chunk_coalesced, so the split
+            # that matters is blob-alloc / wire GET / fabric scatter.
+            self._wire_agg_add("GET", int(plan["value_len"]), t_scatter - t_get)
+            if self._timing_log_left > 0:
+                self._timing_log_left -= 1
+                logger.info(
+                    "[t3knic][timing] chunk restore %.1f ms for %.2f MiB "
+                    "(blob %.1f | WIRE-GET %.1f | scatter %.1f ms)",
+                    (t_end - t_entry) * 1e3,
+                    int(plan["value_len"]) / 1048576.0,
+                    (t_get - t_entry) * 1e3,
+                    (t_scatter - t_get) * 1e3,
+                    (t_end - t_scatter) * 1e3,
+                )
+            if self._kvdiff_enabled:
+                try:
+                    value_len = int(plan["value_len"])
+                    received = self._kvdiff_digest(blob, self._wire_shard_index(), value_len)
+                    wire = self._kvdiff_wire_verdict(self._raw_wire_key(key), received)
+                    # Re-gather from the live caches into the blob and compare with what
+                    # the wire delivered -- proves the scatter landed every byte. Poison
+                    # first, or a dead re-gather would compare the received bytes to themselves.
+                    #
+                    # Synchronize at each boundary. This leg interleaves a host-to-device copy
+                    # (the poison) with device workloads (the re-gather) and a device-to-host read
+                    # (the digest), and nothing orders those against each other. Without the
+                    # syncs it reported MISMATCH on roughly 1% of chunks while the wire was
+                    # bit_exact and the model's own output was unchanged -- the verification was
+                    # reading ahead of the work, not catching a lost scatter. Measured over two
+                    # runs of 1,092 verdicts each, identical but for these calls: 10 mismatches
+                    # without, 0 with. The restore path itself is untouched and was never wrong.
+                    _ttnn_sync = __import__("ttnn")
+                    _ttnn_sync.synchronize_device(self._wire_mesh)
+                    self._kvdiff_poison_blob(blob)
+                    _ttnn_sync.synchronize_device(self._wire_mesh)
+                    kvcache_operations.gather_tp_shards_to_chip(
+                        plan["members"],
+                        blob,
+                        self._wire_master_coord(),
+                        self._rank_coords(plan),
+                        plan["block_ids"],
+                        int(plan["shard_block_bytes"]),
+                        plan["region_bases"],
+                        plan["header_words"],
+                    )
+                    _ttnn_sync.synchronize_device(self._wire_mesh)
+                    restore = (
+                        "bit_exact"
+                        if self._kvdiff_digest(blob, self._wire_shard_index(), value_len) == received
+                        else "MISMATCH"
+                    )
+                    slots = self.raw_codec._chunk_slots(slot_mapping_slice)
+                    self._kvdiff_log(
+                        "device",
+                        key,
+                        wire,
+                        restore,
+                        "blocks=%s slots=%d..%d n=%d"
+                        % (
+                            plan["block_ids"],
+                            int(slots[0]),
+                            int(slots[-1]),
+                            int(slots.numel()),
+                        ),
+                    )
+                except Exception as e:  # noqa: BLE001
+                    logger.error(
+                        "[t3knic][kvdiff] ERROR verification machinery failed (device): %s",
+                        e,
+                    )
+        self._record_op(
+            "chunk_load_device",
+            int(plan["value_len"]),
+            t_end - t_entry,
+            hit=True,
+            breakdown={"get": t_scatter - t_get, "scatter": t_end - t_scatter},
+        )
+        return True
+
+    def put_chunk_gm_forward(self, key: str, kvcaches: object, num_layers: int, slot_mapping_slice: object) -> bool:
+        """Forwarder store: local fabric gather (device-shaped), one D2H, zmq to the owner.
+
+        The gather leg is identical to device mode -- the chunk lands contiguous on this
+        stage's wire chip -- so the owner receives exactly the bytes a local wire PUT
+        would have sent, header included. KVDIFF digests therefore stay comparable
+        across the process boundary.
+        """
+        import ttnn
+        from lmcache_t3knic.t3knic_lmcache._kvm_backend import kvcache_operations
+
+        plan = self.raw_codec.device_chunk_plan(kvcaches, num_layers, slot_mapping_slice)
+        value_len = int(plan["value_len"])
+        words = (value_len + 3) // 4
+        t_entry = time.monotonic()
+        with self._device_lock():
+            blob = self._wire_blob_tensor(words)
+            t_gather = time.monotonic()
+            kvcache_operations.gather_tp_shards_to_chip(
+                plan["members"],
+                blob,
+                self._wire_master_coord(),
+                self._rank_coords(plan),
+                plan["block_ids"],
+                int(plan["shard_block_bytes"]),
+                plan["region_bases"],
+                plan["header_words"],
+            )
+            t_d2h = time.monotonic()
+            host = ttnn.to_torch(ttnn.get_device_tensors(blob)[self._wire_shard_index()]).reshape(-1)[:words]
+            data = host.numpy().tobytes()[:value_len]
+        t_fwd = time.monotonic()
+        self._gm_fwd.request("put", self._raw_wire_key(key), data=data)
+        t_end = time.monotonic()
+        if self._kvdiff_enabled:
+            try:
+                import hashlib
+
+                self._kvdiff_remember(self._raw_wire_key(key), hashlib.sha256(data).hexdigest())
+            except Exception as e:  # noqa: BLE001
+                logger.error(
+                    "[t3knic][kvdiff] ERROR verification machinery failed (gm put): %s",
+                    e,
+                )
+        self._record_op(
+            "chunk_store_gm_forward",
+            value_len,
+            t_end - t_entry,
+            breakdown={
+                "gather": t_d2h - t_gather,
+                "d2h": t_fwd - t_d2h,
+                "zmq_put": t_end - t_fwd,
+            },
+        )
+        return True
+
+    def get_chunk_gm_forward(self, key: str, kvcaches: object, num_layers: int, slot_mapping_slice: object) -> bool:
+        """Forwarder restore: zmq GET from the owner, one H2D, then local fabric scatter."""
+        import torch
+        import ttnn
+        from lmcache_t3knic.t3knic_lmcache._kvm_backend import kvcache_operations
+
+        plan = self.raw_codec.device_chunk_plan(kvcaches, num_layers, slot_mapping_slice)
+        value_len = int(plan["value_len"])
+        words = (value_len + 3) // 4
+        t_entry = time.monotonic()
+        rep = self._gm_fwd.request("get", self._raw_wire_key(key), length=value_len)
+        if not rep.get("hit"):
+            return False
+        data = rep["data"]
+        if len(data) < value_len:
+            raise RuntimeError(f"[t3knic][gm] owner returned {len(data)} bytes for a {value_len}-byte chunk")
+        t_h2d = time.monotonic()
+        with self._device_lock():
+            blob = self._wire_blob_tensor(words)
+            pages = self._wire_blob_words // 8192
+            chips = 1
+            for d in tuple(self._wire_mesh.shape):
+                chips *= int(d)
+            pad = (-value_len) % 4
+            shard = torch.frombuffer(bytearray(data) + b"\x00" * pad, dtype=torch.uint8).view(torch.int32)
+            host = torch.zeros(chips * pages, 8192, dtype=torch.int32)
+            host.reshape(chips, -1)[self._flat_chip_index(self._wire_coord), : shard.numel()] = shard
+            src = ttnn.from_torch(
+                host,
+                dtype=ttnn.int32,
+                layout=ttnn.ROW_MAJOR_LAYOUT,
+                mesh_mapper=ttnn.ShardTensorToMesh(self._wire_mesh, dim=0),
+            )
+            ttnn.copy_host_to_device_tensor(src, blob)
+            t_scatter = time.monotonic()
+            kvcache_operations.scatter_chunk_from_chip(
+                blob,
+                plan["members"],
+                self._wire_master_coord(),
+                self._rank_coords(plan),
+                plan["block_ids"],
+                int(plan["shard_block_bytes"]),
+                plan["region_bases"],
+            )
+            t_end = time.monotonic()
+            if self._kvdiff_enabled:
+                try:
+                    import hashlib
+
+                    received = hashlib.sha256(bytes(data[:value_len])).hexdigest()
+                    wire = self._kvdiff_wire_verdict(self._raw_wire_key(key), received)
+                    self._kvdiff_poison_blob(blob)
+                    kvcache_operations.gather_tp_shards_to_chip(
+                        plan["members"],
+                        blob,
+                        self._wire_master_coord(),
+                        self._rank_coords(plan),
+                        plan["block_ids"],
+                        int(plan["shard_block_bytes"]),
+                        plan["region_bases"],
+                        plan["header_words"],
+                    )
+                    restore = (
+                        "bit_exact"
+                        if self._kvdiff_digest(blob, self._wire_shard_index(), value_len) == received
+                        else "MISMATCH"
+                    )
+                    self._kvdiff_log("gm_forward", key, wire, restore)
+                except Exception as e:  # noqa: BLE001
+                    logger.error(
+                        "[t3knic][kvdiff] ERROR verification machinery failed (gm get): %s",
+                        e,
+                    )
+        self._record_op(
+            "chunk_load_gm_forward",
+            value_len,
+            t_end - t_entry,
+            hit=True,
+            breakdown={
+                "zmq_get": t_h2d - t_entry,
+                "h2d": t_scatter - t_h2d,
+                "scatter": t_end - t_scatter,
+            },
+        )
+        return True
+
+    def _wire_shard_index(self) -> int:
+        """Linear (row-major) index of the wire chip within the wire mesh."""
+        if self._wire_coord is None:
+            return 0
+        shape = tuple(self._wire_mesh.shape)
+        idx = 0
+        for dim, coord in zip(shape, self._wire_coord):
+            idx = idx * dim + int(coord)
+        return idx
+
+    def _wire_from_host(self, host_int32_2d):
+        """Put a host blob on the wire chip. Replicated when the wire shares a multi-chip mesh."""
+        import ttnn
+
+        kwargs = {}
+        if self._wire_coord is not None:
+            kwargs["mesh_mapper"] = ttnn.ReplicateTensorToMesh(self._wire_mesh)
+        return ttnn.from_torch(
+            host_int32_2d,
+            device=self._wire_mesh,
+            layout=ttnn.ROW_MAJOR_LAYOUT,
+            memory_config=ttnn.DRAM_MEMORY_CONFIG,
+            **kwargs,
+        )
+
+    def _wire_to_host(self, dev):
+        """Read back the WIRE CHIP's shard -- the wire writes there, not on chip 0."""
+        import ttnn
+
+        if self._wire_coord is None:
+            return ttnn.to_torch(dev)
+        shards = ttnn.get_device_tensors(dev)
+        return ttnn.to_torch(shards[self._wire_shard_index()])
+
+    def _put_chunk_raw_wire(self, key: str, bufs: Dict[int, "torch.Tensor"]) -> None:
+        import torch
+        import ttnn
+
+        if not getattr(self, "_host_path_announced", False):
+            self._host_path_announced = True
+            logger.info("[t3knic] chunk store is using the HOST gather path (PCIe both ways)")
+
+        layers = sorted(bufs.keys())
+        parts = [bufs[i].contiguous().view(torch.uint8).reshape(-1) for i in layers]
+        header = torch.tensor(
+            [self._RAW_WIRE_MAGIC, len(layers)] + [int(t.numel()) for t in parts],
+            dtype=torch.int32,
+        )
+        blob = torch.cat([header.view(torch.uint8)] + parts)
+        total = int(blob.numel())  # value_len excludes padding; GET re-parses via the header
+        # Wire DRAM tensors need 32B-aligned pages; shape (n, 8192) int32 gives 32 KiB pages.
+        pad = (-total) % (8192 * 4)
+        if pad:
+            blob = torch.cat([blob, torch.zeros(pad, dtype=torch.uint8)])
+        self._raw_wire_seen_max = max(getattr(self, "_raw_wire_seen_max", 0), int(blob.numel()))
+        dev = self._wire_from_host(blob.view(torch.int32).reshape(-1, 8192))
+        try:
+            self._ttnn_client.put(self._raw_wire_key(key), dev, total)
+        finally:
+            ttnn.deallocate(dev)
+
+    def _get_chunk_raw_wire(self, key: str) -> Optional[Dict[int, "torch.Tensor"]]:
+        import torch
+        import ttnn
+
+        ub = self._raw_wire_upper_bound_bytes()
+        if ub <= 8:
+            return None
+        ub += (-ub) % (8192 * 4)  # match the PUT-side 32 KiB page shape
+        out = self._wire_from_host(torch.zeros(ub // 4, dtype=torch.int32).reshape(-1, 8192))
+        try:
+            if not self._ttnn_client.get(self._raw_wire_key(key), out):
+                return None
+            blob = self._wire_to_host(out).contiguous().view(torch.uint8).reshape(-1)
+        finally:
+            ttnn.deallocate(out)
+        hdr = blob[:8].contiguous().view(torch.int32)
+        if int(hdr[0]) != self._RAW_WIRE_MAGIC:
+            raise RuntimeError(
+                f"raw-over-wire GET for key {key[:40]!r}: bad magic {int(hdr[0]):#x} "
+                "(stored by a different path or upper bound truncated the value)"
+            )
+        n_layers = int(hdr[1])
+        sizes = blob[8 : 8 + 4 * n_layers].contiguous().view(torch.int32).tolist()
+        off = 8 + 4 * n_layers
+        bufs: Dict[int, "torch.Tensor"] = {}
+        for i, sz in enumerate(sizes):
+            bufs[i] = blob[off : off + sz].clone()
+            off += sz
+        return bufs
+
+    def put_chunk_raw(self, key: str, bufs: Dict[int, "torch.Tensor"]) -> None:
+        """Store a chunk's raw block-region bytes (raw-byte codec path).
+
+        Dict backends stash the host buffers in the LRU; the wire backend
+        serializes them into a single wire value (raw-over-wire bridge above).
+        """
+        if not self._host_offload:
+            self._put_chunk_raw_wire(key, bufs)
+            return
+        with self._stats_lock:
+            self._host_store[key] = ("raw", bufs)
+            self._host_store.move_to_end(key)
+            while len(self._host_store) > self._host_store_cap:
+                _ek, entry = self._host_store.popitem(last=False)
+                self._free_host_entry(entry)
+
+    def get_chunk_raw(self, key: str) -> Optional[Dict[int, "torch.Tensor"]]:
+        """Return a chunk's stored raw buffers, or None on miss."""
+        if not self._host_offload:
+            return self._get_chunk_raw_wire(key)
+        with self._stats_lock:
+            entry = self._host_store.get(key)
+            if entry is None:
+                return None
+            if not (isinstance(entry, tuple) and len(entry) == 2 and entry[0] == "raw"):
+                raise RuntimeError(
+                    f"get_chunk_raw: key {key[:40]!r} was stored by the legacy "
+                    "tensor path; raw and tensor entries cannot mix within one "
+                    "process (codec activation changed mid-run?)"
+                )
+            self._host_store.move_to_end(key)
+            return entry[1]
+
+    @staticmethod
+    def _free_host_entry(entry: tuple) -> None:
+        """Best-effort free for one _host_store entry (tensor or raw)."""
+        if isinstance(entry, tuple) and len(entry) == 2 and entry[0] == "raw":
+            return  # plain torch buffers; GC handles them
+        try:
+            import ttnn
+
+            k_list, v_list = entry
+            for t in list(k_list) + list(v_list):
+                try:
+                    ttnn.deallocate(t)
+                except Exception:  # noqa: BLE001
+                    pass
+        except Exception:  # noqa: BLE001
+            pass
+
+    def put_chunk_coalesced(self, key: str, k_list: list, v_list: list) -> None:
+        """Store a whole chunk's K/V with coalesced (grouped) fabric puts.
+
+        Args:
+            key: Chunk key (vLLM hash).
+            k_list / v_list: Per-layer host ttnn tensors (index == layer_idx),
+                each ``(num_blocks_in_chunk, kv_heads, block, head)`` bfp8 TILE
+                as produced by ``slice_kv_layer_for_chunk``. All layers of a
+                chunk share the same shape.
+        """
+        import ttnn
+
+        num_layers = len(k_list)
+        if num_layers == 0:
+            return
+        # KV-diff: snapshot the store-side KV to host BEFORE the group loop (which
+        # may dealloc the on-device slices under T3KNIC_PUT_ONDEV). Compared against
+        # the load-side KV in get_chunk_coalesced for the same key.
+        if self._kvdiff_enabled:
+            self._kvdiff_capture_store(key, k_list, v_list)
+        if self._host_offload:
+            # Host-CPU-DRAM offload: retain the host per-layer slices in RAM (no
+            # wire staging, no fabric put). slice_kv_layer_for_chunk(on_device=
+            # False) returned fresh host tensors independent of the live paged
+            # cache, and store_block does not deallocate them, so holding a
+            # reference here keeps the bytes alive (bfp8 TILE, byte-exact). LRU-
+            # bounded by cap. get_chunk_coalesced restores from this dict.
+            self._host_store[key] = (list(k_list), list(v_list))
+            self._host_store.move_to_end(key)
+            while len(self._host_store) > self._host_store_cap:
+                _ek, entry = self._host_store.popitem(last=False)
+                self._free_host_entry(entry)
+            return
+        # Per-layer byte size (host padded_shape works for _bfp8_tile_n_bytes).
+        per_layer_bytes = max(
+            tt_kv_serde._bfp8_tile_n_bytes(k_list[0]),
+            tt_kv_serde._bfp8_tile_n_bytes(v_list[0]),
+        )
+        if self._coalesce_groups is None:
+            self._coalesce_groups = self._build_group_plan(num_layers, per_layer_bytes)
+
+        # Confirm the open()-time pre-allocated pool matches this put's
+        # authoritative per-layer shape (one-shot). Sets _pool_shape_ok, which
+        # the reuse gate below requires.
+        if self._pool_allocated and not self._pool_shape_validated:
+            self._validate_pool_against_authoritative(k_list)
+
+        # T3KNIC_PUT_ONDEV: the slices came back ON DEVICE (slice_kv_layer_for_chunk
+        # skipped from_device). Detect that and use them directly as the wire
+        # tensors -- no H2D re-stage and no pool copy. The KV never leaves the
+        # device. Auto-detected from the tensor storage so the connector flag need
+        # not be threaded down here. (Single-device only; multi-device returns host
+        # tensors from the torch-gather, so on_device stays False there.)
+        on_device = ttnn.is_tensor_storage_on_device(k_list[0])
+
+        # Reuse the pinned per-layer staging buffers instead of
+        # to_device + per-layer dealloc. Hard-gated on the validated pool so a
+        # geometry mismatch can never feed a wrong-shape tensor to the wire.
+        # copy_host_to_device_tensor requires an exact shape match, so also
+        # require this chunk's per-layer shape to equal the pre-allocated pool
+        # shape -- a partial (short) final chunk falls back to per-call alloc.
+        # Pool reuse is a HOST-staging optimization, so it is mutually exclusive
+        # with the on-device path.
+        reuse = (
+            not on_device
+            and self._buf_reuse
+            and self._pool_allocated
+            and self._pool_shape_ok
+            and tuple(int(d) for d in k_list[0].shape) == tuple(int(d) for d in (self._pool_per_layer_shape or ()))
+        )
+
+        profile = self._profile_enabled
+        for gid, layer_idxs in enumerate(self._coalesce_groups):
+            # Sub-step timestamps attribute the op's python-thread wall-clock to
+            # our frontend (h2d/concat/meta/dealloc) vs the kvcache_manager wire
+            # (client.put). `wire_put` is the only kvcache_manager term; the rest
+            # is our code, so the split attributes frontend and wire cost. put
+            # blocks through device landing/read-back. A paired Client defers the
+            # directory commit fence to wait_put_done; detached mode cannot request it.
+            t0 = time.monotonic()
+            if on_device:
+                # T3KNIC_PUT_ONDEV: the per-layer slices are already device
+                # tensors (fresh copies from the dim-0 slice, independent of the
+                # live paged cache). Use them straight as the concat inputs -- no
+                # H2D. They are deallocated below via the `not reuse` cleanup.
+                k_devs = [k_list[li] for li in layer_idxs]
+                v_devs = [v_list[li] for li in layer_idxs]
+            elif reuse:
+                # P1: copy host K/V into the pinned per-layer staging buffers
+                # (no alloc). The buffers were pre-allocated to per_layer_shape,
+                # which equals k_list[li].shape (guarded by _pool_shape_ok).
+                k_devs = []
+                for li in layer_idxs:
+                    buf = self._pool_put_stage_k[li]
+                    ttnn.copy_host_to_device_tensor(k_list[li], buf)
+                    k_devs.append(buf)
+                v_devs = []
+                for li in layer_idxs:
+                    buf = self._pool_put_stage_v[li]
+                    ttnn.copy_host_to_device_tensor(v_list[li], buf)
+                    v_devs.append(buf)
+            else:
+                k_devs = [tt_kv_serde.place_on_sender_dram(k_list[li], self._wire_mesh) for li in layer_idxs]
+                v_devs = [tt_kv_serde.place_on_sender_dram(v_list[li], self._wire_mesh) for li in layer_idxs]
+            t_h2d = time.monotonic()
+            # The wire (Client::put -> validate_tensor_layout) requires the value
+            # tensor to be DRAM + INTERLEAVED. The host path normalized via
+            # place_on_sender_dram; force it here so the concat output is layout-
+            # independent of the inputs (matters for the on-device path, whose
+            # inputs are raw cache slices). Default-OFF T3KNIC_PUT_ONDEV with a
+            # single-layer group (G==1) would feed kg=k_devs[0] verbatim, i.e. the
+            # cache's own memory_config -- safe today (single-device paged caches
+            # are DRAM-INTERLEAVED and our group size is 32, so concat runs), but
+            # a future sharded/L1 cache hitting G==1 would TT_FATAL at the wire.
+            kg = ttnn.concat(k_devs, dim=0, memory_config=ttnn.DRAM_MEMORY_CONFIG) if len(k_devs) > 1 else k_devs[0]
+            vg = ttnn.concat(v_devs, dim=0, memory_config=ttnn.DRAM_MEMORY_CONFIG) if len(v_devs) > 1 else v_devs[0]
+            t_concat = time.monotonic()
+            t_meta = t_wire = t_concat
+            # kvg (merge mode) is bound before the try so the finally frees it
+            # exception-safely, like kg/vg -- a put that raises must not leak the
+            # fresh 2x merged DRAM buffer.
+            kvg = None
+            try:
+                k_n = tt_kv_serde._bfp8_tile_n_bytes(kg)
+                v_n = tt_kv_serde._bfp8_tile_n_bytes(vg)
+                if self._kv_merge:
+                    # T3KNIC_KV_MERGE: one value/key per group -- concat K rows then
+                    # V rows on dim 0; get splits it back at k_shape[0]. Halves the
+                    # per-chunk wire-put count. kvg is a fresh concat (never aliases
+                    # kg/vg); it is freed in the finally (covers both the success and
+                    # the put-raises paths; Client.put makes its source reusable
+                    # before returning, so freeing after the put is safe).
+                    kvg = ttnn.concat([kg, vg], dim=0, memory_config=ttnn.DRAM_MEMORY_CONFIG)
+                    hash_kv = tt_kv_serde.hash_layer_key(key, gid, "kv").encode("utf-8")
+                    t_meta = time.monotonic()
+                    self._ttnn_client.put(hash_kv, kvg, k_n + v_n)
+                    t_wire = time.monotonic()
+                else:
+                    hash_kg = tt_kv_serde.hash_layer_key(key, gid, "kg").encode("utf-8")
+                    hash_vg = tt_kv_serde.hash_layer_key(key, gid, "vg").encode("utf-8")
+                    t_meta = time.monotonic()
+                    self._ttnn_client.put(hash_kg, kg, k_n)
+                    self._ttnn_client.put(hash_vg, vg, v_n)
+                    t_wire = time.monotonic()
+                # Record group shapes (same for every chunk) so get can size
+                # the out tensor, plus per-layer shapes for exists/delete reuse.
+                self._coalesce_group_shapes.setdefault(gid, (tuple(kg.shape), tuple(vg.shape)))
+                for li in layer_idxs:
+                    self._layer_shapes.setdefault(li, (tuple(k_list[li].shape), tuple(v_list[li].shape)))
+            finally:
+                # concat returns a fresh tensor; dealloc it. (When G==1, kg IS
+                # k_devs[0], so the identity guard skips it.)
+                if kg is not (k_devs[0] if k_devs else None):
+                    ttnn.deallocate(kg)
+                if vg is not (v_devs[0] if v_devs else None):
+                    ttnn.deallocate(vg)
+                if kvg is not None:  # merge mode: fresh concat, free on success or error
+                    ttnn.deallocate(kvg)
+                # The staged per-layer copies are persistent pool buffers in
+                # reuse mode (freed only in close()); only dealloc them when
+                # they were freshly allocated this call.
+                if not reuse:
+                    for d in k_devs:
+                        ttnn.deallocate(d)
+                    for d in v_devs:
+                        ttnn.deallocate(d)
+            if profile:
+                t1 = time.monotonic()
+                self._record_trace(
+                    "put_group",
+                    "put_layer",
+                    t0,
+                    t1,
+                    tid=1,
+                    args={
+                        "group": gid,
+                        "layers": len(layer_idxs),
+                        "bytes": k_n + v_n,
+                        "key_prefix": key[:40],
+                    },
+                )
+                self._record_op(
+                    "put_group",
+                    bytes_count=k_n + v_n,
+                    total_elapsed=t1 - t0,
+                    breakdown={
+                        "fe_h2d": t_h2d - t0,
+                        "fe_concat": t_concat - t_h2d,
+                        "fe_meta": t_meta - t_concat,
+                        "wire_put": t_wire - t_meta,
+                        "fe_dealloc": t1 - t_wire,
+                    },
+                )
+
+    def get_chunk_coalesced(self, key: str, on_device: bool = False) -> Optional[Dict[int, Tuple[Any, Any]]]:
+        """Retrieve a whole chunk with coalesced (grouped) fabric gets.
+
+        Returns a ``{layer_idx: (k, v)}`` map of per-layer ttnn tensors (each one
+        layer's slice, matching what ``slice_kv_layer_for_chunk`` produced), or
+        ``None`` if the chunk is not present / un-sized.
+
+        ``on_device`` (T3KNIC_GET_ONDEV): when True the per-layer tensors
+        are left ON DEVICE (the ``ttnn.from_device`` D2H is skipped) so the
+        restore can feed them straight into the in-place page-fill kernel without
+        a host round-trip. Each returned tensor is a fresh device slice (a copy,
+        independent of the reused pool out-buffer), and the restore is
+        responsible for deallocating it. When False (default) the tensors are
+        host ttnn tensors as before.
+        """
+        if self._host_offload:
+            # Host-CPU-DRAM offload: return the retained host per-layer slices
+            # (the H2D paged-fill happens in the caller, to_gpu/_paged_fill).
+            # Runs BEFORE the _coalesce_groups gate below because the host store
+            # path never builds a coalesce group plan (put skipped wire staging).
+            stored = self._host_store.get(key)
+            if stored is None:
+                return None
+            if isinstance(stored, tuple) and len(stored) == 2 and stored[0] == "raw":
+                raise RuntimeError(
+                    f"get_chunk_coalesced: key {key[:40]!r} holds raw-byte codec "
+                    "buffers; the raw restore path (get_chunk_raw) must be used."
+                )
+            self._host_store.move_to_end(key)
+            k_list, v_list = stored
+            hresult: Dict[int, Tuple[Any, Any]] = {li: (k_list[li], v_list[li]) for li in range(len(k_list))}
+            if self._kvdiff_enabled:
+                self._kvdiff_compare(key, hresult)
+            return hresult
+        if self._coalesce_groups is None:
+            # No put happened in this process => cannot size the gets.
+            return None
+        import ttnn
+
+        # Reuse the pinned per-group GET out-buffers instead of
+        # allocating a zeros-filled tensor per call. A
+        # hit fully overwrites the buffer and a miss returns None without
+        # reading it, so reuse across calls is safe. Hard-gated on the validated
+        # pool; a per-group shape check below falls back if a buffer is missing
+        # or mis-sized.
+        reuse = self._buf_reuse and self._pool_allocated and self._pool_shape_ok
+
+        profile = self._profile_enabled
+        result: Dict[int, Tuple[Any, Any]] = {}
+        for gid, layer_idxs in enumerate(self._coalesce_groups):
+            shapes = self._coalesce_group_shapes.get(gid)
+            if shapes is None:
+                return None
+            k_shape, v_shape = shapes
+            # T3KNIC_KV_MERGE: one merged "kv" value (K rows then V rows) read into
+            # a single 2x out-buffer, split below into per-layer K/V regions.
+            # `pool_bufs` is the out-buffer set to free on a fresh (non-pool) alloc:
+            # (kv_out,) in merge mode, (k_out, v_out) otherwise.
+            if self._kv_merge:
+                kv_shape = (int(k_shape[0]) + int(v_shape[0]),) + tuple(int(d) for d in k_shape[1:])
+                reuse_grp = (
+                    reuse
+                    and gid in self._pool_get_kv
+                    and tuple(int(d) for d in self._pool_get_kv[gid].shape) == kv_shape
+                )
+            else:
+                reuse_grp = (
+                    reuse
+                    and gid in self._pool_get_kg
+                    and gid in self._pool_get_vg
+                    and tuple(int(d) for d in self._pool_get_kg[gid].shape) == tuple(int(d) for d in k_shape)
+                    and tuple(int(d) for d in self._pool_get_vg[gid].shape) == tuple(int(d) for d in v_shape)
+                )
+            # Sub-step timestamps attribute the get's python-thread wall-clock to
+            # our frontend (out-tensor alloc / d2h-split / dealloc) vs the
+            # kvcache_manager wire (client.get). get is SYNC, so `wire_get` is the
+            # real blocking retrieve (server-push + status readback); a wire-heavy
+            # split means the lever is on the kvcache_manager side, not our python.
+            t0 = time.monotonic()
+            if self._kv_merge:
+                kv_out = (
+                    self._pool_get_kv[gid]
+                    if reuse_grp
+                    else tt_kv_serde.make_empty_bfp8_tile_dram(kv_shape, self._wire_mesh)
+                )
+                pool_bufs = (kv_out,)
+            elif reuse_grp:
+                k_out = self._pool_get_kg[gid]
+                v_out = self._pool_get_vg[gid]
+                pool_bufs = (k_out, v_out)
+            else:
+                k_out = tt_kv_serde.make_empty_bfp8_tile_dram(k_shape, self._wire_mesh)
+                v_out = tt_kv_serde.make_empty_bfp8_tile_dram(v_shape, self._wire_mesh)
+                pool_bufs = (k_out, v_out)
+            t_alloc = time.monotonic()
+            t_meta = t_wire = t_split = t_alloc
+            try:
+                # Each layer occupies ``nb`` rows (num_blocks_in_chunk); all layers
+                # in a chunk share the same nb, so nb = K-rows / num_layers_in_group.
+                # In merge mode V rows start at ``half`` (after all K rows).
+                nb = int(k_shape[0]) // len(layer_idxs)
+                half = int(k_shape[0])
+                if self._kv_merge:
+                    hash_kv = tt_kv_serde.hash_layer_key(key, gid, "kv").encode("utf-8")
+                    t_meta = time.monotonic()
+                    hit = self._ttnn_client.get(hash_kv, kv_out)
+                    t_wire = time.monotonic()
+                    if not hit:
+                        return None
+                else:
+                    hash_kg = tt_kv_serde.hash_layer_key(key, gid, "kg").encode("utf-8")
+                    hash_vg = tt_kv_serde.hash_layer_key(key, gid, "vg").encode("utf-8")
+                    t_meta = time.monotonic()
+                    hit_k = self._ttnn_client.get(hash_kg, k_out)
+                    hit_v = self._ttnn_client.get(hash_vg, v_out)
+                    t_wire = time.monotonic()
+                    if not (hit_k and hit_v):
+                        return None
+                for j, li in enumerate(layer_idxs):
+                    if self._kv_merge:
+                        kreg = kv_out[j * nb : j * nb + nb]
+                        vreg = kv_out[half + j * nb : half + j * nb + nb]
+                    else:
+                        kreg = k_out[j * nb : j * nb + nb]
+                        vreg = v_out[j * nb : j * nb + nb]
+                    # T3KNIC_GET_ONDEV keeps the slice on
+                    # device for the restore; else D2H. ttnn slicing allocates a
+                    # fresh device buffer (a copy), independent of the reused pool
+                    # out-buffer, so it survives the next GET overwriting it.
+                    if on_device:
+                        result[li] = (kreg, vreg)
+                    else:
+                        result[li] = (ttnn.from_device(kreg), ttnn.from_device(vreg))
+                t_split = time.monotonic()
+                # T3KNIC_TIMING_LOG: wire-vs-host split from clocks this path already takes.
+                # Separate from T3KNIC_PROFILE, which also switches on the tt-metal device
+                # profiler and slows a request enough to time the harness out; get_stats() only
+                # surfaces at shutdown, which a killed server never reaches.
+                if self._timing_log_left > 0:
+                    self._timing_log_left -= 1
+                    _mib = sum(tt_kv_serde._bfp8_tile_n_bytes(_b) for _b in pool_bufs) / 1048576.0
+                    logger.info(
+                        "[t3knic][timing] GET group %.1f ms for %.1f MiB "
+                        "(alloc %.1f | meta %.1f | WIRE %.1f | d2h_split %.1f ms)",
+                        (t_split - t0) * 1e3,
+                        _mib,
+                        (t_alloc - t0) * 1e3,
+                        (t_meta - t_alloc) * 1e3,
+                        (t_wire - t_meta) * 1e3,
+                        (t_split - t_wire) * 1e3,
+                    )
+            finally:
+                # Pool buffers are persistent (freed only in close()); only dealloc
+                # freshly allocated ones.
+                if not reuse_grp:
+                    for _b in pool_bufs:
+                        ttnn.deallocate(_b)
+            if profile:
+                t1 = time.monotonic()
+                n_bytes = sum(tt_kv_serde._bfp8_tile_n_bytes(_b) for _b in pool_bufs)
+                self._record_trace(
+                    "get_group",
+                    "get_layer",
+                    t0,
+                    t1,
+                    tid=2,
+                    args={
+                        "group": gid,
+                        "layers": len(layer_idxs),
+                        "bytes": n_bytes,
+                        "key_prefix": key[:40],
+                    },
+                )
+                _bd = {
+                    "fe_alloc": t_alloc - t0,
+                    "fe_meta": t_meta - t_alloc,
+                    "wire_get": t_wire - t_meta,
+                    "fe_d2h_split": t_split - t_wire,
+                    "fe_dealloc": t1 - t_split,
+                }
+                self._record_op(
+                    "get_group",
+                    bytes_count=n_bytes,
+                    total_elapsed=t1 - t0,
+                    hit=True,
+                    breakdown=_bd,
+                )
+
+        if self._kvdiff_enabled:
+            self._kvdiff_compare(key, result)
+        return result
+
+    # ------------------------------------------------------------------
+    # KV-diff consistency check (T3KNIC_KVDIFF) — store/load tensor diff
+    # ------------------------------------------------------------------
+
+    @staticmethod
+    def _kvdiff_to_torch(t):
+        """to_torch that tolerates multi-device tensors (newer ttnn demands a
+        composer). The wire buffers are single-shard-valid (the attached chip),
+        and shard 0 is what the restore path reads, so diff shard 0."""
+        import ttnn
+
+        try:
+            return ttnn.to_torch(t)
+        except RuntimeError as exc:
+            if "mesh composer" not in str(exc):
+                raise
+            return ttnn.to_torch(ttnn.get_device_tensors(t)[0])
+
+    def _kvdiff_capture_store(self, key: str, k_list: list, v_list: list) -> None:
+        """Snapshot the store-side per-layer KV (put input) to host fp32.
+
+        Called from put_chunk_coalesced before the group loop. Tolerates host or
+        on-device input tensors (ttnn.to_torch dequantises bfp8 either way).
+        """
+        try:
+            import ttnn
+
+            layers: Dict[int, Tuple[Any, Any]] = {}
+            for li in range(len(k_list)):
+                kt = self._kvdiff_to_torch(k_list[li]).float()
+                vt = self._kvdiff_to_torch(v_list[li]).float()
+                layers[li] = (kt, vt)
+            with self._stats_lock:
+                self._kvdiff_store[key] = layers
+        except Exception as e:  # noqa: BLE001 — debug-only, never break store
+            logger.warning("[kvdiff] store capture failed for key=%s: %s", key[:40], e)
+
+    def _kvdiff_compare(self, key: str, result: Optional[Dict[int, Tuple[Any, Any]]]) -> None:
+        """Diff the load-side restored KV against the captured store-side KV.
+
+        Records per-layer / overall max & mean abs error into _kvdiff_results
+        (also surfaced via get_stats). err==0 => bit-exact wire round-trip; a
+        per-layer or block-edge spike => paged-slice / partial-block bug.
+        """
+        if not result:
+            return
+        with self._stats_lock:
+            store = self._kvdiff_store.get(key)
+        if store is None:
+            logger.info("[kvdiff] no store snapshot for key=%s (load before store?)", key[:40])
+            return
+        try:
+            import ttnn
+
+            per_layer = []
+            k_max = v_max = 0.0
+            for li, (k_dev, v_dev) in result.items():
+                sk, sv = store.get(li, (None, None))
+                if sk is None:
+                    continue
+                kt = self._kvdiff_to_torch(k_dev).float()
+                vt = self._kvdiff_to_torch(v_dev).float()
+                ka = (kt - sk).abs()
+                va = (vt - sv).abs()
+                km, vm = float(ka.max()), float(va.max())
+                per_layer.append(
+                    {
+                        "layer": li,
+                        "k_max": km,
+                        "k_mean": float(ka.mean()),
+                        "v_max": vm,
+                        "v_mean": float(va.mean()),
+                    }
+                )
+                k_max = max(k_max, km)
+                v_max = max(v_max, vm)
+            rec = {
+                "key": key[:40],
+                "n_layers": len(per_layer),
+                "k_max_abs": k_max,
+                "v_max_abs": v_max,
+                "bit_exact": (k_max == 0.0 and v_max == 0.0),
+                "per_layer": per_layer,
+            }
+            with self._stats_lock:
+                self._kvdiff_results.append(rec)
+                self._kvdiff_store.pop(key, None)
+            logger.info(
+                "[kvdiff] key=%s layers=%d k_max_abs=%.6g v_max_abs=%.6g bit_exact=%s",
+                key[:40],
+                len(per_layer),
+                k_max,
+                v_max,
+                rec["bit_exact"],
+            )
+        except Exception as e:  # noqa: BLE001 — debug-only, never break load
+            logger.warning("[kvdiff] compare failed for key=%s: %s", key[:40], e)
+
+    def exists(self, key: str) -> bool:
+        """Synchronously check whether the KV pool holds ``key``.
+
+        Layer-0 K proxy: a chunk is put atomically across all layers and
+        both K/V components, so the presence of (layer 0, "k") implies the
+        whole chunk is present. In coalesce mode the proxy is
+        group-0's "kg" entry (group ids are deterministic, so group 0 always
+        exists for any stored chunk -- no group plan needed to compute it).
+        """
+        if self._host_offload:
+            return key in self._host_store
+        if getattr(self, "raw_codec", None) is not None and self._uses_mock():
+            # Same all-shards rule as per_chip, answered from the in-process store.
+            return all(self._raw_shard_key(key, r) in self._mock_wire_store for r in self._shard_indices())
+        if getattr(self, "raw_codec", None) is not None and self._uses_per_chip():
+            # Per-chip PUT stores one value PER SHARD, so the layer-0 proxy above does not apply:
+            # a chunk is present only if every shard is. Checking one would report a hit for a
+            # partially stored chunk and hand back mixed KV, which is the failure this whole path
+            # is least able to detect afterwards. Costs tp_size round trips per lookup.
+            # Each client may target an independent Server directory shard. Querying every key
+            # through the master would ask one shard about keys stored on the others.
+            return all(
+                self._shard_client_for_rank(r).exists(self._raw_shard_key(key, r)) for r in self._shard_indices()
+            )
+        if getattr(self, "raw_codec", None) is not None and self._gm_role == "forwarder":
+            # Global-master forwarder: one value per chunk (device-shaped), owner answers.
+            return bool(self._gm_fwd.request("exists", self._raw_wire_key(key))["hit"])
+        if getattr(self, "raw_codec", None) is not None:
+            _hk = self._raw_wire_key(key)  # raw-over-wire: one entry per chunk
+        elif self._coalesce:
+            _proxy = "kv" if self._kv_merge else "kg"  # group-0 merged or K-group
+            _hk = tt_kv_serde.hash_layer_key(key, 0, _proxy).encode("utf-8")
+        else:
+            _hk = tt_kv_serde.hash_layer_key(key, 0, "k").encode("utf-8")
+        # [T3KNIC_DBG] exists() is one wire round-trip per chunk-group, called by
+        # LMCache's batched_contains in BOTH the scheduler lookup (the inter-request
+        # GAP) and the retrieve get_block_mapping (the start_load_kv BLOCK). Probe
+        # count + per-call latency to attribute warm_ttft between existence
+        # checks and the wire GET. No-op unless T3KNIC_DBG.
+        if os.environ.get("T3KNIC_DBG") and self._profile_enabled:
+            _t0 = time.monotonic()
+            _r = self._ttnn_client.exists(_hk)
+            self._record_op("dbg_exists", 0, time.monotonic() - _t0)
+            return _r
+        return self._ttnn_client.exists(_hk)
+
+    def delete(self, key: str) -> bool:
+        """Synchronously delete ``key`` from the KV pool.
+
+        Returns:
+            True on success, False if the key was not present.
+        """
+        if self._host_offload:
+            return self._host_store.pop(key, None) is not None
+        removed_any = False
+        if self.raw_codec is not None and self._uses_mock():
+            found = False
+            for r in self._shard_indices():
+                found = self._mock_wire_store.pop(self._raw_shard_key(key, r), None) is not None or found
+            return found
+        if self.raw_codec is not None and self._uses_per_chip():
+            # One value per shard: deleting only the first would leak the rest on the server.
+            # Every shard is attempted even if an earlier one was absent, so a partially stored
+            # chunk still gets fully cleaned up.
+            return all(
+                [self._shard_client_for_rank(r).delete(self._raw_shard_key(key, r)) for r in self._shard_indices()]
+            )
+        if self.raw_codec is not None:
+            # The raw path stores one value per chunk under its own key, so the per-layer loop
+            # below would delete nothing and leak the chunk on the server.
+            return self._ttnn_client.delete(self._raw_wire_key(key))
+        if self._coalesce:
+            # Coalesce mode: per-group keys are "kv" (T3KNIC_KV_MERGE) or "kg"/"vg".
+            components = ("kv",) if self._kv_merge else ("kg", "vg")
+            for gid in range(len(self._coalesce_groups or [])):
+                for component in components:
+                    hashed = tt_kv_serde.hash_layer_key(key, gid, component).encode("utf-8")
+                    if self._ttnn_client.delete(hashed):
+                        removed_any = True
+            return removed_any
+        # Remove every layer's K and V entries. Report True if any was present.
+        for layer_idx in self._layer_shapes:
+            for component in ("k", "v"):
+                hashed = tt_kv_serde.hash_layer_key(key, layer_idx, component).encode("utf-8")
+                if self._ttnn_client.delete(hashed):
+                    removed_any = True
+        return removed_any
+
+    def wait_put_done(self, key: Optional[str] = None) -> None:
+        """Complete the connector's PUT boundary.
+
+        Args:
+            key: Retained for the connector interface. The wire exposes a
+                Server-wide commit frontier, so flush drains every preceding PUT.
+        """
+        del key
+        if self._host_offload or self._uses_mock():
+            return
+        if self._gm_role == "forwarder":
+            # The zmq PUT is synchronous end-to-end: the owner answers only after its
+            # wire PUT (or mock store) returned, so "landed" is already guaranteed here.
+            # Commit-drain durability is the wire owner's concern.
+            return
+        if self._ttnn_client is None:
+            raise RuntimeError("TTKVCacheClient.wait_put_done: wire client is not open")
+        if self.config.get("mode") != "external" or not self._uses_per_chip():
+            self._ttnn_client.flush()
+            return
+
+        # Each product Server shard owns an independent commit frontier. Flush
+        # one representative Client per shard instead of assuming the primary
+        # attachment drains every worker group.
+        representatives = {
+            self._flat_chip_index(self._wire_coord or (0, 0)) % self._external_server_shards: self._ttnn_client
+        }
+        for coord, client in self._shard_clients.items():
+            representatives.setdefault(
+                self._flat_chip_index(coord) % self._external_server_shards,
+                client,
+            )
+        for client in representatives.values():
+            client.flush()
