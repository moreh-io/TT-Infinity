+# SPDX-License-Identifier: Apache-2.0
+"""``RemoteConnector`` for the t3knic LMCache backend.
+
+This connector is the LMCache-facing side of the
+TTGPUConnector / TTRemoteConnector / TTKVCacheClient triplet. It is
+invoked through ``storage_backend.connector.CreateConnector`` whenever
+an LMCache engine is configured with a ``t3knic://`` remote URL.
+
+Design summary:
+  * ``put(key, memory_obj)``: the ``memory_obj`` is a placeholder whose
+    host bytes are never read. ``TTGPUConnector.from_gpu`` already
+    registered a pending-send entry keyed by ``id(memory_obj)`` on the
+    shared ``TTKVCacheClient``. Here we pop that entry and call the
+    fabric ``put_layer`` for each layer of the chunk.
+  * ``get(key)``: allocate a placeholder MemoryObj of the right shape
+    via the LocalCPUBackend allocator, register a pending-get entry,
+    and return the placeholder. The actual fabric ``get_layer`` calls
+    happen later in ``TTGPUConnector.to_gpu``, which has access to the
+    destination device kvcaches.
+  * ``exists`` / ``remove_sync`` / ``list``: forwarded straight to the
+    ``TTKVCacheClient``.
+
+All product ``kvcache_manager.Client`` interaction is delegated to
+``TTKVCacheClient``; the worker's ``colaunch.open_for_worker`` owns the
+paired ``Server``. This module can therefore use a stub client in unit tests.
+"""
+
+import asyncio
+from typing import List, Optional
+
+from lmcache.logging import init_logger
+from lmcache.utils import CacheEngineKey
+from lmcache.v1.config import LMCacheEngineConfig
+from lmcache.v1.memory_management import MemoryObj
+from lmcache.v1.metadata import LMCacheMetadata
+from lmcache.v1.storage_backend.connector.base_connector import RemoteConnector
+from lmcache.v1.storage_backend.local_cpu_backend import LocalCPUBackend
+
+from lmcache_t3knic.t3knic_lmcache.tt_kvcache_client import (
+    KVChunkRef,
+    TTKVCacheClient,
+)
+from lmcache_t3knic.t3knic_lmcache.tt_paged_slice import slice_kv_layer_for_chunk
+
+logger = init_logger(__name__)
+
+
+class TTRemoteConnector(RemoteConnector):
+    """LMCache ``RemoteConnector`` that routes KV chunks through TT-Fabric.
+
+    Args:
+        client: Shared :class:`TTKVCacheClient` instance. The same
+            instance is also held by the corresponding
+            :class:`TTGPUConnector`, which is how the pending-op
+            registry crosses the LMCache API boundary without modifying
+            LMCache.
+        loop: Asyncio event loop owned by LMCache; used to drive the
+            sync facade methods (``exists_sync``, ``remove_sync``) when
+            the underlying client call is naturally async.
+        local_cpu_backend: LMCache's CPU allocator. Used to allocate the
+            placeholder MemoryObj returned from :meth:`get`. With
+            ``config.local_cpu=False`` its ``hot_cache`` is disabled but
+            the allocator itself is still constructed (LMCache requires
+            it) — see config_guard premise 2.
+        config: LMCache engine configuration.
+        metadata: LMCache engine metadata. Passed up to ``RemoteConnector``
+            so ``meta_shapes`` / ``meta_dtypes`` / ``meta_fmt`` are
+            populated; we use these to size the get() placeholder.
+    """
+
+    def __init__(
+        self,
+        client: TTKVCacheClient,
+        loop: asyncio.AbstractEventLoop,
+        local_cpu_backend: LocalCPUBackend,
+        config: LMCacheEngineConfig,
+        metadata: LMCacheMetadata,
+    ) -> None:
+        super().__init__(config, metadata)
+        self.client = client
+        self.loop = loop
+        self.local_cpu_backend = local_cpu_backend
+
+    # ------------------------------------------------------------------
+    # exists
+    # ------------------------------------------------------------------
+
+    async def exists(self, key: CacheEngineKey) -> bool:
+        """Check whether ``key`` is present in the KV pool."""
+        return self.client.exists(key.to_string())
+
+    def exists_sync(self, key: CacheEngineKey) -> bool:
+        """Synchronous variant of :meth:`exists`."""
+        return self.client.exists(key.to_string())
+
+    # ------------------------------------------------------------------
+    # put
+    # ------------------------------------------------------------------
+
+    async def put(self, key: CacheEngineKey, memory_obj: MemoryObj) -> None:
+        """Trigger fabric writes for the pending-send entry tied to ``memory_obj``.
+
+        If no pending-send entry exists for ``id(memory_obj)`` we log
+        and return silently: this happens for the dedupe path in
+        ``RemoteBackend.submit_put_task`` where the same key is already
+        in flight, so the original chunk's fabric write is already
+        scheduled.
+        """
+        # Warmup mode: skip the wire put entirely (forward already ran in vLLM).
+        # Still pop the pending-send so the registry doesn't leak.
+        if getattr(self.client, "_warmup_mode", False):
+            self.client.pop_pending_send(id(memory_obj))
+            logger.debug("put: warmup mode, skipping wire put for key=%s", key)
+            return
+
+        info = self.client.pop_pending_send(id(memory_obj))
+        if info is None:
+            logger.debug("put: no pending-send for id(mo)=%d key=%s; skipping", id(memory_obj), key)
+            return
+        if not isinstance(info, KVChunkRef):
+            raise TypeError(
+                "TTRemoteConnector.put expected KVChunkRef in the " f"pending-send registry, got {type(info).__name__}"
+            )
+        if info.layout is None:
+            raise RuntimeError(
+                "TTRemoteConnector.put: pending-send entry has no cached "
+                "PagedChunkLayout. TTGPUConnector must be constructed "
+                "with block_size=... so the chunk layout is decoded once "
+                "in from_gpu and reused here."
+            )
+        key_str = key.to_string()
+        import time as _time
+
+        t_start = _time.monotonic()
+        raw_codec = getattr(self.client, "raw_codec", None)
+        if raw_codec is not None:
+            # Raw-byte store: fused per-layer gather of the chunk's block
+            # regions as bytes (multi-device dict backends). No torch
+            # dequant/requant round-trip; the stored bytes are the cache bytes.
+            # Preferred: gather the chunk chip-to-chip over fabric and PUT it straight from the
+            # gathering chip's DRAM. The host gather below is the fallback for backends that
+            # cannot do that (dict backend, single-chip sender).
+            on_device = False
+            if getattr(self.client, "wire_uses_device_path", lambda: False)():
+                on_device = self.client.put_chunk_device(
+                    key_str, info.kvcaches, info.num_layers, info.slot_mapping_slice
+                )
+            if on_device:
+                self.client._record_op("save_group", 0, _time.monotonic() - t_start)
+            else:
+                bufs = raw_codec.gather_chunk(info.kvcaches, info.num_layers, info.slot_mapping_slice)
+                self.client._record_op("save_group", 0, _time.monotonic() - t_start)
+                self.client.put_chunk_raw(key_str, bufs)
+            self.client.wait_put_done(key_str)
+            logger.info(
+                "[t3knic] put done (raw): key=%s  layers=%d  tokens=%d  %.3fs",
+                key_str[:40],
+                info.num_layers,
+                info.layout.total_tokens,
+                _time.monotonic() - t_start,
+            )
+            self.client._record_trace(
+                "remote.put",
+                "background",
+                t_start,
+                _time.monotonic(),
+                tid=10,
+                args={
+                    "key": key_str[:40],
+                    "layers": int(info.num_layers),
+                    "raw": True,
+                    "on_device": bool(on_device),
+                },
+            )
+            return
+        if getattr(self.client, "_coalesce", False):
+            # Coalesced path: slice every layer first, then hand the whole
+            # chunk to the client which concatenates groups of layers into one
+            # fabric put each, reducing fixed per-call overhead.
+            # T3KNIC_PUT_ONDEV: keep the per-layer slices ON DEVICE (skip D2H);
+            # put_chunk_coalesced detects them and skips the H2D re-stage, so the
+            # KV never leaves the device on the store path. Single-device only --
+            # _ttnn_chunk_block_to_host ignores on_device for multi-device (host
+            # torch-gather). save_group then measures pure on-device slice time.
+            on_device = bool(getattr(self.client, "_put_ondev", False))
+            k_list, v_list = [], []
+            for layer_idx in range(info.num_layers):
+                k_src, v_src = slice_kv_layer_for_chunk(info.kvcaches, info.layout, layer_idx, on_device=on_device)
+                k_list.append(k_src)
+                v_list.append(v_src)
+            # The per-layer D2H extract above (slice_kv_layer_for_chunk ->
+            # ttnn.from_device) is the save-side
+            # mirror of restore_group on the load side. Like restore, it lived
+            # only in the remote.put trace span (tid=10) and was invisible in
+            # /stats, folding into the opaque background-PUT cost. Surface it as
+            # its own op so PUT decomposes into save(D2H extract) + wire_put.
+            # Recorded only on the coalesced path, where the slice loop is a
+            # clean prefix before the wire put. bytes=0: device slice + D2H, not
+            # a wire transfer. No-op unless T3KNIC_PROFILE is set.
+            self.client._record_op("save_group", 0, _time.monotonic() - t_start)
+            self.client.put_chunk_coalesced(key_str, k_list, v_list)
+        else:
+            for layer_idx in range(info.num_layers):
+                k_src, v_src = slice_kv_layer_for_chunk(info.kvcaches, info.layout, layer_idx)
+                self.client.put_layer(key_str, layer_idx, k_src, v_src)
+        self.client.wait_put_done(key_str)
+        elapsed = _time.monotonic() - t_start
+        logger.info(
+            "[t3knic] put done: key=%s  layers=%d  tokens=%d  %.3fs",
+            key_str[:40],
+            info.num_layers,
+            info.layout.total_tokens,
+            elapsed,
+        )
+        # Background-coroutine entry/exit trace. Runs on the LMCache worker
+        # event loop (NOT the vllm main loop), so this fires on whatever
+        # thread asyncio.run_coroutine_threadsafe dispatched onto. tid=10 to
+        # keep this lane separate from the vllm-side hooks (tid 3/4) and the
+        # per-call wire put_layer wrappers (tid 1).
+        self.client._record_trace(
+            "remote.put",
+            "background",
+            t_start,
+            _time.monotonic(),
+            tid=10,
+            args={
+                "key": key_str[:40],
+                "layers": int(info.num_layers),
+                "tokens": int(info.layout.total_tokens),
+            },
+        )
+
+    async def batched_put(self, keys: List[CacheEngineKey], memory_objs: List[MemoryObj]) -> None:
+        """Batched variant of :meth:`put`. Same per-key contract."""
+        import time as _time
+
+        t_batch_start = _time.monotonic()
+        logger.debug("batched_put: %d keys", len(keys))
+        for i, (key, memory_obj) in enumerate(zip(keys, memory_objs, strict=False)):
+            try:
+                await self.put(key, memory_obj)
+            except Exception as exc:  # noqa: BLE001 - one bad chunk must not kill the worker
+                logger.exception("batched_put chunk %d failed", i)
+                # Counted and escalated: a store that only logs is invisible in practice, and a
+                # systematically failing store leaves a run looking healthy (see
+                # TTKVCacheClient.record_store_result).
+                self.client.record_store_result(False, exc)
+            else:
+                self.client.record_store_result(True)
+        # Parent span over the whole batched_put coroutine on the LMCache
+        # worker loop. dur of this trace == total wire wall-clock for all
+        # chunks of this batch (= chunk count × 32 layers × per-put time).
+        # Compare against wait_for_save's duration (tid=4) to identify how much
+        # background work remains after the foreground dispatch returns.
+        self.client._record_trace(
+            "remote.batched_put",
+            "background",
+            t_batch_start,
+            _time.monotonic(),
+            tid=11,
+            args={"n_keys": int(len(keys))},
+        )
+
+    def support_batched_put(self) -> bool:
+        """Force RemoteBackend to use the batched path (premise 4).
+
+        The single-key ``put`` goes through
+        ``RemoteBackend.exists_in_put_tasks`` dedupe, which can drop the
+        call entirely and leave a pending-send entry leaking. The
+        batched path skips that check.
+        """
+        return True
+
+    # ------------------------------------------------------------------
+    # get
+    # ------------------------------------------------------------------
+
+    async def get(self, key: CacheEngineKey) -> Optional[MemoryObj]:
+        """Allocate a placeholder MemoryObj and register a pending-get entry.
+
+        We do not perform the fabric read here -- only TTGPUConnector.to_gpu
+        has the destination ``kvcaches`` and ``slot_mapping`` it needs to
+        write to. The pending-get registry hands the chunk key over so
+        ``to_gpu`` can call ``client.get_layer`` against the correct chunk.
+
+        Returns ``None`` if the local CPU allocator is exhausted.
+
+        NOTE: we deliberately do NOT re-probe ``client.exists`` here. LMCache's
+        retrieve path already filtered to cache hits before reaching get():
+        ``StorageManager.get_block_mapping`` runs ``batched_contains`` (one
+        ``client.exists`` wire round-trip per chunk) and hands ``batched_get``
+        ONLY the prefix keys that returned True
+        (lmcache.v1.cache_engine._process_tokens_internal). The previous
+        ``if not self.client.exists(...)`` here re-queried the SAME key over the
+        wire a second time -- a 100% redundant round-trip that doubled the GET
+        existence traffic (O(chunks) per retrieve; ~1k extra round-trips at a
+        64k-token prefill). The actual fetch happens in
+        to_gpu/batched_to_gpu via get_chunk_coalesced, which independently
+        no-ops on a (here unreachable) miss, so dropping the probe cannot return
+        stale data. Verified against lmcache v1 storage_manager.get_block_mapping
+        + cache_engine._process_tokens_internal.
+        """
+        # The shape/dtype/fmt come from the base RemoteConnector init
+        # via metadata. For TT we only need this MemoryObj as a placeholder,
+        # so any single-group shape works -- LMCache will read its
+        # metadata, never its bytes.
+        assert self.meta_shapes, "RemoteConnector meta_shapes unexpectedly empty"
+        memory_obj = self.local_cpu_backend.allocate(
+            self.meta_shapes[0],
+            self.meta_dtypes[0],
+            fmt=self.meta_fmt,
+        )
+        if memory_obj is None:
+            logger.warning(
+                "TTRemoteConnector.get: LocalCPUBackend.allocate returned "
+                "None for key=%s; cannot return placeholder",
+                key,
+            )
+            return None
+
+        self.client.record_pending_get(memory_obj, key)
+        return memory_obj
+
+    async def batched_get(self, keys: List[CacheEngineKey]) -> List[Optional[MemoryObj]]:
+        """Batched variant of :meth:`get`."""
+        results: List[Optional[MemoryObj]] = []
+        for key in keys:
+            results.append(await self.get(key))
+        return results
+
+    def support_batched_get(self) -> bool:
+        return True
+
+    # ------------------------------------------------------------------
+    # list / remove / close
+    # ------------------------------------------------------------------
+
+    async def list(self) -> List[str]:
+        """Listing chunks is not exposed by the kvcache_server protocol.
+
+        The wire intentionally exposes only put/get/exists/delete.
+        Listing would require an extra round trip we don't need for
+        LMCache's correctness; LMCache only calls ``list`` from CLI
+        tools and tests. Returning an empty list is the consistent
+        behaviour for "we don't enumerate".
+        """
+        return []
+
+    def remove_sync(self, key: CacheEngineKey) -> bool:
+        """Delete ``key`` from the KV pool."""
+        return self.client.delete(key.to_string())
+
+    async def close(self) -> None:
+        """Close the kvcache_server connection."""
+        self.client.close()
diff --git a/lmcache-t3knic/lmcache_t3knic/t3knic_lmcache/worker_hook.py b/lmcache-t3knic/lmcache_t3knic/t3knic_lmcache/worker_hook.py
