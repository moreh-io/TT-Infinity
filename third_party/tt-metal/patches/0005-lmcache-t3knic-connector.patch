@@ -0,0 +1,1117 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Paged KV-cache slicing for the t3knic flow.
+
+vLLM-TT stores KV caches as ``list[list[ttnn.Tensor]]`` -- one ``[k, v]``
+pair per layer, each tensor laid out in pages of
+``(num_blocks, block_size, num_heads, head_size)``. Both
+:class:`TTGPUConnector` and :class:`TTRemoteConnector` need to address
+the same logical chunk -- the rows of layer L's K/V corresponding to
+``slot_mapping[start:end]``.
+
+Layout decoding turns ``slot_mapping`` into per-DP-group block runs and
+intra-block offsets using pure Python with no hardware dependency. Tensor
+materialization then builds the ttnn handles consumed by the sender and
+receiver paths using :func:`_ttnn_chunk_block_to_host` and
+:func:`_host_ttnn_layer_to_device`; the wire preserves bfp8 TILE bytes.
+
+The decoder owns its DP-overflow rule locally: slots beyond the configured
+partitions are attributed to the final DP group with an offset relative to
+that group. Keeping the rule here avoids coupling this flow to connector
+internals.
+"""
+
+import os
+import time
+from dataclasses import dataclass
+from typing import Optional, Sequence, Tuple
+
+import torch
+
+from lmcache.logging import init_logger
+
+logger = init_logger(__name__)
+
+
+# ---------------------------------------------------------------------------
+# Layout decoding (hardware-independent)
+# ---------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class PagedChunkLayout:
+    """Decoded layout of a chunk's token positions in paged KV cache.
+
+    All fields are immutable tuples so the dataclass is hashable and
+    safe to share across threads (e.g. via the pending-send registry).
+
+    The four per-DP tuples are aligned: index ``g`` in each gives the
+    data for DP group ``g``. Within a group, the three token-aligned
+    tuples (``intra_offsets``, ``chunk_positions``, ``local_blocks``)
+    are sorted by ``(local_block_id, intra_offset, chunk_position)`` so
+    tensor materialization can iterate runs and gather token rows deterministically.
+
+    Attributes:
+        block_size: Number of tokens per page.
+        dp_size: Number of data-parallel groups the paged KV is split
+            across. ``1`` for the t3knic single-chip flow.
+        per_dp_runs: For each DP group, a tuple of
+            ``(block_start, block_end)`` pairs covering every page
+            that group needs. ``block_end`` is exclusive.
+        per_dp_intra_offsets: For each DP group, the intra-block offset
+            of every token assigned to that group, in sorted order.
+        per_dp_chunk_positions: For each DP group, the original
+            positions (indexes into ``slot_mapping_slice``) of the
+            tokens that group owns.
+        per_dp_local_blocks: For each DP group, the local block id of
+            every token (sorted same as the other token tuples). Used
+            during tensor materialization to map each token to its row inside the
+            concatenated-run output.
+    """
+
+    block_size: int
+    dp_size: int
+    per_dp_runs: Tuple[Tuple[Tuple[int, int], ...], ...]
+    per_dp_intra_offsets: Tuple[Tuple[int, ...], ...]
+    per_dp_chunk_positions: Tuple[Tuple[int, ...], ...]
+    per_dp_local_blocks: Tuple[Tuple[int, ...], ...]
+    # Mesh geometry for the multi-device (TP-sharded kv_heads + DP-sharded
+    # blocks) tensor path. Defaults describe the single-device t3knic flow
+    # (tp_size=1), where materialization takes the single-device slice/fill.
+    tp_size: int = 1
+    dp_axis: int = 0
+    tp_axis: int = 1
+
+    @property
+    def total_tokens(self) -> int:
+        """Number of tokens covered by this layout (sum across DP groups)."""
+        return sum(len(g) for g in self.per_dp_chunk_positions)
+
+
+def build_block_index_within_runs(
+    runs: Sequence[Tuple[int, int]],
+    local_blocks: Sequence[int],
+) -> Tuple[int, ...]:
+    """For each token's ``local_block`` id, the index that block occupies
+    in the concatenated-run output ``ttnn.slice`` will produce.
+
+    Tensor materialization walks the runs in order to do per-run fabric IO, then
+    gathers token rows from the resulting (concatenated) tensor; this
+    helper turns each token's logical block id into a row in that
+    tensor.
+
+    Args:
+        runs: Same ordering as ``PagedChunkLayout.per_dp_runs[g]``.
+        local_blocks: Same ordering as
+            ``PagedChunkLayout.per_dp_local_blocks[g]``.
+
+    Returns:
+        A tuple aligned with ``local_blocks`` giving the within-run
+        block index for each token.
+
+    Raises:
+        KeyError: If a ``local_blocks`` entry is not covered by ``runs``
+            (indicates an inconsistency between layout decoding and materialization).
+    """
+    run_offset_by_block: dict[int, int] = {}
+    offset = 0
+    for rs, re in runs:
+        for b in range(rs, re):
+            run_offset_by_block[b] = offset
+            offset += 1
+    return tuple(run_offset_by_block[b] for b in local_blocks)
+
+
+def decode_chunk_layout(
+    slot_mapping_slice: Sequence[int],
+    block_size: int,
+    *,
+    dp_size: int = 1,
+    blocks_per_dp: Optional[int] = None,
+    tp_size: int = 1,
+    dp_axis: int = 0,
+    tp_axis: int = 1,
+) -> PagedChunkLayout:
+    """Decode ``slot_mapping[start:end]`` into a :class:`PagedChunkLayout`.
+
+    This hardware-independent result drives the ttnn tensor materialization
+    implemented by :func:`slice_kv_layer_for_chunk`.
+
+    Args:
+        slot_mapping_slice: Sequence of global slot indices for the
+            tokens in this chunk. ``torch.Tensor`` works via
+            iteration; for performance pass ``slot_mapping_slice.tolist()``.
+        block_size: Tokens per page.
+        dp_size: Number of DP groups the paged KV spans. The t3knic
+            single-chip case uses ``1``.
+        blocks_per_dp: Total blocks within each DP group. Only required
+            when ``dp_size > 1``. ``None`` is accepted for the dp_size=1
+            case and treated as "all blocks live in DP group 0".
+
+    Returns:
+        :class:`PagedChunkLayout` with deterministic per-DP-group runs,
+        intra offsets, chunk positions, and local block ids.
+
+    Raises:
+        ValueError: If ``block_size <= 0``, ``dp_size <= 0``, any slot
+            is negative, or ``dp_size > 1`` with ``blocks_per_dp`` unset.
+    """
+    if block_size <= 0:
+        raise ValueError(f"block_size must be positive, got {block_size}")
+    if dp_size <= 0:
+        raise ValueError(f"dp_size must be positive, got {dp_size}")
+    if dp_size > 1 and (blocks_per_dp is None or blocks_per_dp <= 0):
+        raise ValueError(f"dp_size={dp_size} requires blocks_per_dp > 0, got {blocks_per_dp}")
+
+    # Materialize to a list once. Cheap for ints, tolerates torch.Tensor.
+    slots = [int(s) for s in slot_mapping_slice]
+    for i, s in enumerate(slots):
+        if s < 0:
+            raise ValueError(f"negative slot {s} at position {i}")
+
+    # Per-DP-group raw tuples: (local_block, intra, chunk_pos).
+    per_dp_raw: list[list[Tuple[int, int, int]]] = [[] for _ in range(dp_size)]
+
+    for chunk_pos, slot in enumerate(slots):
+        global_block, intra = divmod(slot, block_size)
+        if dp_size == 1:
+            dp = 0
+            local_block = global_block
+        else:
+            assert blocks_per_dp is not None  # validated above
+            dp, local_block = divmod(global_block, blocks_per_dp)
+            if dp >= dp_size:
+                # Preserve overflow slots by assigning them to the final DP
+                # group with an offset relative to that group's base.
+                dp = dp_size - 1
+                local_block = global_block - dp * blocks_per_dp
+        per_dp_raw[dp].append((local_block, intra, chunk_pos))
+
+    per_dp_runs: list[Tuple[Tuple[int, int], ...]] = []
+    per_dp_intra: list[Tuple[int, ...]] = []
+    per_dp_positions: list[Tuple[int, ...]] = []
+    per_dp_local: list[Tuple[int, ...]] = []
+
+    for raw in per_dp_raw:
+        if not raw:
+            per_dp_runs.append(())
+            per_dp_intra.append(())
+            per_dp_positions.append(())
+            per_dp_local.append(())
+            continue
+        raw_sorted = sorted(raw, key=lambda t: (t[0], t[1], t[2]))
+        unique_blocks = sorted({t[0] for t in raw_sorted})
+
+        runs: list[Tuple[int, int]] = []
+        rs = unique_blocks[0]
+        re = rs + 1
+        for blk in unique_blocks[1:]:
+            if blk == re:
+                re += 1
+            else:
+                runs.append((rs, re))
+                rs, re = blk, blk + 1
+        runs.append((rs, re))
+
+        per_dp_runs.append(tuple(runs))
+        per_dp_intra.append(tuple(t[1] for t in raw_sorted))
+        per_dp_positions.append(tuple(t[2] for t in raw_sorted))
+        per_dp_local.append(tuple(t[0] for t in raw_sorted))
+
+    return PagedChunkLayout(
+        block_size=block_size,
+        dp_size=dp_size,
+        per_dp_runs=tuple(per_dp_runs),
+        per_dp_intra_offsets=tuple(per_dp_intra),
+        per_dp_chunk_positions=tuple(per_dp_positions),
+        per_dp_local_blocks=tuple(per_dp_local),
+        tp_size=tp_size,
+        dp_axis=dp_axis,
+        tp_axis=tp_axis,
+    )
+
+
+# ---------------------------------------------------------------------------
+# ttnn tensor materialization
+# ---------------------------------------------------------------------------
+
+
+def slice_kv_layer_for_chunk(
+    kvcaches: object,
+    layout: PagedChunkLayout,
+    layer_idx: int,
+    on_device: bool = False,
+) -> Tuple[object, object]:
+    """Return the (K, V) ttnn host tensors for ``layer_idx``'s rows
+    described by the pre-computed ``layout``.
+
+    BFP8-safe host path: the chunk's source blocks are sliced on dim-0 and
+    pulled to host via ``ttnn.from_device``, preserving the bfp8 TILE
+    bytes. The caller (TTKVCacheClient) serializes these host tensors
+    through ``tt_kv_serde`` into the kvcache_manager wire.
+
+    The caller is expected to have already produced ``layout`` via
+    :func:`decode_chunk_layout` and to pass the same instance for every
+    layer of the same chunk. That way the integer math runs once per
+    chunk rather than once per (chunk, layer) pair.
+
+    Args:
+        kvcaches: vLLM-TT's ``self.kv_caches`` (``list[list[ttnn.Tensor]]``).
+        layout: Pre-decoded :class:`PagedChunkLayout` for this chunk.
+        layer_idx: 0-based transformer layer.
+
+    Returns:
+        ``(k_block_host, v_block_host)`` ttnn host tensors of shape
+        ``(num_blocks_in_chunk, num_kv_heads, block_size, head_size)``.
+    """
+    if not _looks_like_ttnn_kvcaches(kvcaches):
+        raise TypeError(
+            "slice_kv_layer_for_chunk: kvcaches must be a ttnn " "list[list[Tensor]]; got %r" % type(kvcaches).__name__
+        )
+    return _ttnn_chunk_block_to_host(kvcaches, layout, layer_idx, on_device=on_device)
+
+
+def unslice_kv_layer_for_chunk(
+    kvcaches: object,
+    layout: PagedChunkLayout,
+    layer_idx: int,
+    k_host: object,
+    v_host: object,
+) -> None:
+    """Scatter host ttnn ``(k_host, v_host)`` back into ``kvcaches[layer_idx]``.
+
+    Reverse of :func:`slice_kv_layer_for_chunk`. Pushes the host bfp8 TILE
+    bytes back to the device paged cache via ``ttnn.to_device``.
+
+    Args:
+        kvcaches: vLLM-TT's ``self.kv_caches`` (ttnn list-of-list).
+        layout: Same :class:`PagedChunkLayout` that was passed to
+            :func:`slice_kv_layer_for_chunk` on the put side.
+        layer_idx: 0-based transformer layer.
+        k_host: Host K ttnn.Tensor (bfp8 TILE) from
+            :func:`slice_kv_layer_for_chunk`.
+        v_host: Host V ttnn.Tensor (bfp8 TILE) symmetric to k_host.
+    """
+    if not _looks_like_ttnn_kvcaches(kvcaches):
+        raise TypeError(
+            "unslice_kv_layer_for_chunk: kvcaches must be a ttnn "
+            "list[list[Tensor]]; got %r" % type(kvcaches).__name__
+        )
+    if not (_is_ttnn_host_tensor(k_host) and _is_ttnn_host_tensor(v_host)):
+        raise TypeError(
+            "unslice_kv_layer_for_chunk: k_host/v_host must be ttnn host "
+            "tensors (output of slice_kv_layer_for_chunk); got %r/%r" % (type(k_host).__name__, type(v_host).__name__)
+        )
+    _host_ttnn_layer_to_device(kvcaches, layer_idx, k_host, v_host)
+
+
+def _is_ttnn_host_tensor(t: object) -> bool:
+    """Best-effort check that ``t`` is a host-resident ``ttnn.Tensor``."""
+    try:
+        import ttnn as _ttnn
+
+        return isinstance(t, _ttnn.Tensor)
+    except ImportError:
+        return False
+
+
+def _looks_like_ttnn_kvcaches(kvcaches: object) -> bool:
+    """Detect ttnn.Tensor-backed list-of-list paged layout."""
+    try:
+        import ttnn as _ttnn
+
+        if not isinstance(kvcaches, (list, tuple)) or not kvcaches:
+            return False
+        first = kvcaches[0]
+        if not isinstance(first, (list, tuple)) or len(first) < 2:
+            return False
+        return isinstance(first[0], _ttnn.Tensor) and isinstance(first[1], _ttnn.Tensor)
+    except (IndexError, AttributeError, ImportError):
+        return False
+
+
+def _owning_dp_group(layout: "PagedChunkLayout") -> int:
+    """Return the single DP group that owns this chunk's blocks.
+
+    A chunk is the contiguous tokens of one request, and vLLM assigns a request
+    to one DP rank, so exactly one ``per_dp_runs`` entry is non-empty.
+    """
+    groups = [g for g, runs in enumerate(layout.per_dp_runs) if runs]
+    if len(groups) != 1:
+        raise NotImplementedError(f"device tensor path expects a chunk in exactly one DP group; got groups={groups}")
+    return groups[0]
+
+
+def _ttnn_chunk_block_to_host(
+    kvcaches: object,
+    layout: "PagedChunkLayout",
+    layer_idx: int,
+    on_device: bool = False,
+) -> Tuple[object, object]:
+    """Pull the chunk's source blocks from device to host as ``ttnn.Tensor``.
+
+    Device store helper. Single-device flow (dp_size==tp_size==1): BFP8-safe
+    dim-0 slice + ``from_device`` (bytes preserved).
+
+    When ``on_device`` is set (T3KNIC_PUT_ONDEV, single-device only), the
+    ``from_device`` (D2H) is SKIPPED and the on-device dim-0 slice is returned
+    directly: the wire put reads its value from device DRAM, so the host hop is
+    pure waste. The slice op allocates a fresh device tensor (a copy independent
+    of the live paged cache), so the async wire read is snapshot-safe. The
+    multi-device branch ignores ``on_device`` (its TP/DP gather goes through host
+    torch). Symmetric to T3KNIC_GET_ONDEV on the GET/restore side.
+
+    Multi-device flow (GPT-oss: TP-sharded kv_heads on ``tp_axis`` + DP-sharded
+    blocks on ``dp_axis``): on-device slice the chunk's block range (small), then
+    a 2D mesh gather (dp mesh-axis -> tensor dim0 blocks, tp mesh-axis -> tensor
+    dim1 kv_heads) brings every TP shard together; we keep only the owning DP
+    group's rows. Returned as a single host bfp8 TILE tensor (all kv_heads).
+    NOTE: the gather goes through torch (dequant->requant); byte-exactness relies
+    on bfp8 requant being idempotent on already-quantized values -- verified by
+    the multi-device byte-exact tests.
+
+    Returns:
+        ``(k_block_host, v_block_host)`` host ``ttnn.Tensor`` of shape
+        ``(num_blocks_in_chunk, num_kv_heads_total, block_size, head_size)``.
+    """
+    import ttnn as _ttnn
+
+    multi_device = (layout.dp_size > 1) or (layout.tp_size > 1)
+
+    if not multi_device:
+        if layout.dp_size != 1:
+            raise NotImplementedError(f"single-device store got dp_size={layout.dp_size}")
+        runs = layout.per_dp_runs[0]
+        if len(runs) != 1:
+            raise NotImplementedError(f"device chunk-block store supports single-run chunks; got {runs}")
+        rs, re = runs[0]
+        k_dev, v_dev = kvcaches[layer_idx]  # type: ignore[index]
+        if on_device:
+            # T3KNIC_PUT_ONDEV: keep the slice on device (no D2H). The wire put
+            # reads from device DRAM; eliminating from_device here (and the H2D
+            # re-stage in put_chunk_coalesced) removes the whole host round-trip.
+            return k_dev[rs:re], v_dev[rs:re]
+        return _ttnn.from_device(k_dev[rs:re]), _ttnn.from_device(v_dev[rs:re])
+
+    # --- multi-device gather ---
+    dp = _owning_dp_group(layout)
+    runs = layout.per_dp_runs[dp]
+    if len(runs) != 1:
+        raise NotImplementedError(f"multi-device store supports single-run chunks; got {runs}")
+    rs, re = runs[0]  # LOCAL block range within DP group `dp`
+    n_blk = re - rs
+
+    k_dev, v_dev = kvcaches[layer_idx]  # type: ignore[index]
+    mesh = k_dev.device()
+    mesh_shape = tuple(mesh.shape)
+    # mesh axis dp_axis -> tensor dim0 (blocks); mesh axis tp_axis -> tensor dim1 (kv_heads)
+    dims = [0, 0]
+    dims[layout.dp_axis] = 0
+    dims[layout.tp_axis] = 1
+    composer = _ttnn.ConcatMesh2dToTensor(mesh, mesh_shape=mesh_shape, dims=tuple(dims))
+
+    k_g = _ttnn.to_torch(k_dev[rs:re], mesh_composer=composer)  # [dp_size*n_blk, kv_heads_total, bs, hd]
+    v_g = _ttnn.to_torch(v_dev[rs:re], mesh_composer=composer)
+    k_chunk = k_g[dp * n_blk : (dp + 1) * n_blk].contiguous()
+    v_chunk = v_g[dp * n_blk : (dp + 1) * n_blk].contiguous()
+
+    k_host = _ttnn.from_torch(k_chunk, dtype=_ttnn.bfloat8_b, layout=_ttnn.TILE_LAYOUT)
+    v_host = _ttnn.from_torch(v_chunk, dtype=_ttnn.bfloat8_b, layout=_ttnn.TILE_LAYOUT)
+    return k_host, v_host
+
+
+# --------------------------------------------------------------------------
+# Trace-safe restore arena
+#
+# tt-metal warns "Allocating device buffers is unsafe due to the existence of an
+# active trace": a traced program records the addresses its buffers had at capture
+# time, so any allocate/deallocate afterwards can shift what those addresses hold.
+# The restore path used to allocate k_fill/v_fill/page_table/cu_seqlens per request
+# -- i.e. after the model captured its decode trace -- which corrupted decode while
+# the KV round-trip itself stayed byte-exact (garbage tokens, different every run).
+# The arena reserves every one of those buffers at bind time, before capture, and
+# the hot path only copies into them.
+# --------------------------------------------------------------------------
+
+FILL_ARENA_CAPACITIES = (1, 2, 4, 8, 16, 32)  # in chunks; padded up to the next one
+
+
+def _arena_fill_slots(arena: object, total_tokens: int):
+    """Smallest pre-allocated (k, v, capacity_tokens) that holds ``total_tokens``."""
+    if not isinstance(arena, dict):
+        return None
+    for cap, slots in arena.get("fill", ()):  # ascending
+        if cap >= total_tokens:
+            return slots[0], slots[1], cap
+    return None
+
+
+def _arena_disabled(arena: object) -> bool:
+    return isinstance(arena, dict) and bool(arena.get("disabled"))
+
+
+def _pad_tokens(t: "torch.Tensor", cap: int) -> "torch.Tensor":
+    """Pad the token dim (2) up to ``cap``. cu_seqlens keeps the padding unread."""
+    n = int(t.shape[2])
+    if n == cap:
+        return t
+    pad = torch.zeros((t.shape[0], t.shape[1], cap - n, t.shape[3]), dtype=t.dtype)
+    return torch.cat([t, pad], dim=2)
+
+
+def build_fill_arena(
+    mesh, mesh_shape, dp_size, tp_size, dp_axis, tp_axis, kv_heads_total, block_size, head_size, max_chunks=32
+):
+    """Reserve the restore path's device buffers. MUST run before the model captures
+    its decode trace (i.e. at connector bind time, not on the first request)."""
+    import ttnn as _ttnn
+
+    kv_dims = [None, None]
+    kv_dims[dp_axis] = None
+    kv_dims[tp_axis] = 1
+    mapper = _ttnn.ShardTensor2dMesh(mesh, mesh_shape=mesh_shape, dims=tuple(kv_dims))
+    fill = []
+    for mult in FILL_ARENA_CAPACITIES:
+        if mult > max_chunks:
+            break
+        cap = mult * block_size
+        z = torch.zeros((1, kv_heads_total, cap, head_size), dtype=torch.bfloat16)
+        pair = tuple(
+            _ttnn.from_torch(
+                z,
+                dtype=_ttnn.bfloat8_b,
+                layout=_ttnn.TILE_LAYOUT,
+                device=mesh,
+                memory_config=_ttnn.DRAM_MEMORY_CONFIG,
+                mesh_mapper=mapper,
+            )
+            for _ in range(2)
+        )
+        fill.append((cap, pair))
+
+    pt_dims = [None, None]
+    pt_dims[dp_axis] = 0
+    pt_dims[tp_axis] = None
+    pt_max = max(max_chunks, 1)
+    page_table = _ttnn.from_torch(
+        torch.full((dp_size, pt_max), -1, dtype=torch.int32),
+        dtype=_ttnn.int32,
+        layout=_ttnn.ROW_MAJOR_LAYOUT,
+        device=mesh,
+        memory_config=_ttnn.DRAM_MEMORY_CONFIG,
+        mesh_mapper=_ttnn.ShardTensor2dMesh(mesh, mesh_shape=mesh_shape, dims=tuple(pt_dims)),
+    )
+    cu = _ttnn.from_torch(
+        torch.zeros(2, dtype=torch.int32),
+        device=mesh,
+        layout=_ttnn.ROW_MAJOR_LAYOUT,
+        memory_config=_ttnn.DRAM_MEMORY_CONFIG,
+    )
+    sp = _ttnn.from_torch(
+        torch.zeros(1, dtype=torch.int32),
+        device=mesh,
+        layout=_ttnn.ROW_MAJOR_LAYOUT,
+        memory_config=_ttnn.DRAM_MEMORY_CONFIG,
+    )
+    logger.info(
+        "[t3knic] restore arena reserved before trace capture: %d fill capacities %s tokens, "
+        "page_table %dx%d, heads=%d block=%d head=%d",
+        len(fill),
+        [c for c, _ in fill],
+        dp_size,
+        pt_max,
+        kv_heads_total,
+        block_size,
+        head_size,
+    )
+    return {"fill": fill, "page_table": page_table, "cu_seqlens": cu, "start_positions": sp}
+
+
+_SHARD_DIAG_DONE = False
+_FILL_VERIFY_DONE = set()
+
+
+def _paged_fill_layer_coalesced_multidev(
+    kvcaches: object,
+    layer_idx: int,
+    chunk_blocks: list,
+    slot_mappings: list,
+    starts: list,
+    block_size: int,
+    *,
+    full_slot_mapping: object,
+    dp_size: int,
+    tp_size: int,
+    dp_axis: int,
+    tp_axis: int,
+    blocks_per_dp: int,
+    aux_cache: object = None,
+    arena: object = None,
+) -> None:
+    """Multi-device (DP/TP) coalesced paged fill for GPT-oss-style KV.
+
+    The chunk host tensors carry ALL kv_heads (gathered by
+    :func:`_ttnn_chunk_block_to_host`). We write them back into the owning DP
+    group's local blocks only:
+      * k_fill/v_fill: replicate the chunk across the DP mesh-axis and shard
+        kv_heads (tensor dim 1) across the TP mesh-axis -- matching the model's
+        KV layout (per-device kv_heads = kv_heads_total / tp_size).
+      * page_table: shard a ``(dp_size, num_blocks_in_seq)`` table across the DP
+        mesh-axis; the owning DP group's row holds the real LOCAL block ids,
+        every other DP row is -1 (skipped by the varlen writer's -1 guard).
+    So each chip writes only its own DP group's blocks; non-owning groups skip.
+    """
+    import ttnn as _ttnn
+
+    cache_k, cache_v = kvcaches[layer_idx]  # type: ignore[index]
+    mesh = cache_k.device()
+    mesh_shape = tuple(mesh.shape)
+
+    def _to_int(v):
+        try:
+            return int(v.item())
+        except AttributeError:
+            return int(v)
+
+    # Per-sequence LOCAL page table + owning DP group. Layer-invariant (depends
+    # only on the slot mappings), so build once and reuse across the layer loop
+    # when aux_cache is supplied; the caller frees it after the loop.
+    if aux_cache is not None and "page_table" in aux_cache:
+        page_table_tensor = aux_cache["page_table"]
+    else:
+        if full_slot_mapping is not None:
+            seq_slots = (
+                list(full_slot_mapping.tolist()) if hasattr(full_slot_mapping, "tolist") else list(full_slot_mapping)
+            )
+        else:
+            seq_slots = []
+            for sm in slot_mappings:
+                seq_slots.extend(list(sm.tolist()) if hasattr(sm, "tolist") else list(sm))
+        seq_len = len(seq_slots)
+        num_blocks_in_seq = (seq_len + block_size - 1) // block_size
+        dp = (_to_int(seq_slots[0]) // block_size) // blocks_per_dp
+        local_row = [
+            ((_to_int(seq_slots[b * block_size]) // block_size) % blocks_per_dp) for b in range(num_blocks_in_seq)
+        ]
+
+        pt = torch.full((dp_size, num_blocks_in_seq), -1, dtype=torch.int32)
+        pt[dp] = torch.tensor(local_row, dtype=torch.int32)
+        pt_dims = [None, None]
+        pt_dims[dp_axis] = 0  # shard the (dp_size) rows across the DP mesh-axis
+        pt_dims[tp_axis] = None  # replicate across TP
+        pt_mapper = _ttnn.ShardTensor2dMesh(mesh, mesh_shape=mesh_shape, dims=tuple(pt_dims))
+        pt_slot = arena.get("page_table") if isinstance(arena, dict) else None
+        if pt_slot is not None:
+            # Trace-safe: copy into the buffer reserved before the decode trace was
+            # captured instead of allocating one now. Unused columns stay -1, which
+            # the varlen writer skips, so a max-width table serves every request.
+            pt_max = int(pt_slot.shape[-1])
+            if num_blocks_in_seq > pt_max:
+                raise ValueError(f"page table needs {num_blocks_in_seq} blocks; arena holds {pt_max}")
+            pt_full = torch.full((dp_size, pt_max), -1, dtype=torch.int32)
+            pt_full[:, :num_blocks_in_seq] = pt
+            _ttnn.copy_host_to_device_tensor(
+                _ttnn.from_torch(pt_full, dtype=_ttnn.int32, layout=_ttnn.ROW_MAJOR_LAYOUT, mesh_mapper=pt_mapper),
+                pt_slot,
+            )
+            page_table_tensor = pt_slot
+        else:
+            page_table_tensor = _ttnn.from_torch(
+                pt,
+                dtype=_ttnn.int32,
+                layout=_ttnn.ROW_MAJOR_LAYOUT,
+                device=mesh,
+                memory_config=_ttnn.DRAM_MEMORY_CONFIG,
+                mesh_mapper=pt_mapper,
+            )
+        if layer_idx == 0:
+            logger.debug(
+                "_paged_fill_layer_coalesced_multidev: dp=%d num_blocks=%d local_row=%s",
+                dp,
+                num_blocks_in_seq,
+                local_row,
+            )
+        if aux_cache is not None:
+            aux_cache["page_table"] = page_table_tensor
+
+    # k_fill / v_fill: concat chunks along the token dim, then place on mesh with
+    # kv_heads sharded across TP and replicated across DP.
+    # The chunk buffers are REPLICATED across the wire mesh (pool _alloc uses ReplicateTensorToMesh),
+    # so any one shard is the whole chunk. Older ttnn let to_torch() take that shard implicitly;
+    # newer ttnn (pytensor.cpp) refuses a multi-device tensor without a mesh composer, so read
+    # shard 0 explicitly when the implicit path is rejected.
+    def _to_torch_replicated(t):
+        try:
+            return _ttnn.to_torch(t)
+        except RuntimeError as exc:
+            if "mesh composer" not in str(exc):
+                raise
+            global _SHARD_DIAG_DONE
+            if os.environ.get("T3KNIC_SHARD_DIAG") == "1" and not _SHARD_DIAG_DONE:
+                _SHARD_DIAG_DONE = True
+                shards = _ttnn.get_device_tensors(t)
+                stats = []
+                for si, sh in enumerate(shards):
+                    th = _ttnn.to_torch(sh).to(torch.float32)
+                    stats.append(f"s{si}: nz={int(torch.count_nonzero(th))} sum={float(th.abs().sum()):.3e}")
+                logger.info("[t3knic][shard-diag] restore chunk shards (layer0, first call): %s", "; ".join(stats))
+            return _ttnn.to_torch(_ttnn.get_device_tensors(t)[0])
+
+    k_torchs = [_to_torch_replicated(k_h) for (k_h, _v_h) in chunk_blocks]
+    v_torchs = [_to_torch_replicated(v_h) for (_k_h, v_h) in chunk_blocks]
+    k_cat = k_torchs[0] if len(k_torchs) == 1 else torch.cat(k_torchs, dim=2)
+    v_cat = v_torchs[0] if len(v_torchs) == 1 else torch.cat(v_torchs, dim=2)
+    total_tokens = int(k_cat.shape[2])
+
+    kv_dims = [None, None]
+    kv_dims[dp_axis] = None  # replicate the chunk across DP
+    kv_dims[tp_axis] = 1  # shard kv_heads (tensor dim 1) across TP
+    kv_mapper = _ttnn.ShardTensor2dMesh(mesh, mesh_shape=mesh_shape, dims=tuple(kv_dims))
+    fill_slots = None if _arena_disabled(arena) else _arena_fill_slots(arena, total_tokens)
+    if fill_slots is not None:
+        # Trace-safe path: reuse buffers reserved before the decode trace was captured.
+        # The capacity is a power-of-two multiple of the chunk size, so pad the token
+        # dim up to it; cu_seqlens still bounds the write to `total_tokens`, leaving the
+        # padding unread.
+        k_slot, v_slot, cap = fill_slots
+        try:
+            k_src, v_src = _pad_tokens(k_cat, cap), _pad_tokens(v_cat, cap)
+            _ttnn.copy_host_to_device_tensor(
+                _ttnn.from_torch(k_src, dtype=_ttnn.bfloat8_b, layout=_ttnn.TILE_LAYOUT, mesh_mapper=kv_mapper), k_slot
+            )
+            _ttnn.copy_host_to_device_tensor(
+                _ttnn.from_torch(v_src, dtype=_ttnn.bfloat8_b, layout=_ttnn.TILE_LAYOUT, mesh_mapper=kv_mapper), v_slot
+            )
+            k_fill, v_fill = k_slot, v_slot
+        except Exception as exc:  # noqa: BLE001 - degrade to allocation, never fail the request
+            logger.warning("[t3knic] restore arena copy failed (%s); disabling arena for this process", exc)
+            if isinstance(arena, dict):
+                arena["disabled"] = True
+            fill_slots = None
+    if fill_slots is None:
+        k_fill = _ttnn.from_torch(
+            k_cat,
+            dtype=_ttnn.bfloat8_b,
+            layout=_ttnn.TILE_LAYOUT,
+            device=mesh,
+            memory_config=_ttnn.DRAM_MEMORY_CONFIG,
+            mesh_mapper=kv_mapper,
+        )
+        v_fill = _ttnn.from_torch(
+            v_cat,
+            dtype=_ttnn.bfloat8_b,
+            layout=_ttnn.TILE_LAYOUT,
+            device=mesh,
+            memory_config=_ttnn.DRAM_MEMORY_CONFIG,
+            mesh_mapper=kv_mapper,
+        )
+
+    # cu_seqlens / start_positions are layer-invariant too (total_tokens is the
+    # same for every layer; first_start is fixed). Build once and reuse via
+    # aux_cache; the caller frees them after the layer loop.
+    if aux_cache is not None and "cu_seqlens" in aux_cache:
+        cu_seqlens_tensor = aux_cache["cu_seqlens"]
+        start_positions_tensor = aux_cache["start_positions"]
+    else:
+        first_start = int(starts[0])
+        if first_start % 32 != 0:
+            raise ValueError(
+                f"moreh_paged_fill_cache_varlen requires start_positions multiple of 32; got {first_start}"
+            )
+        cu_slot = arena.get("cu_seqlens") if isinstance(arena, dict) else None
+        sp_slot = arena.get("start_positions") if isinstance(arena, dict) else None
+        if cu_slot is not None and sp_slot is not None:
+            _ttnn.copy_host_to_device_tensor(
+                _ttnn.from_torch(torch.tensor([0, total_tokens], dtype=torch.int32), layout=_ttnn.ROW_MAJOR_LAYOUT),
+                cu_slot,
+            )
+            _ttnn.copy_host_to_device_tensor(
+                _ttnn.from_torch(torch.tensor([first_start], dtype=torch.int32), layout=_ttnn.ROW_MAJOR_LAYOUT),
+                sp_slot,
+            )
+            cu_seqlens_tensor, start_positions_tensor = cu_slot, sp_slot
+        else:
+            cu_seqlens_tensor = _ttnn.from_torch(
+                torch.tensor([0, total_tokens], dtype=torch.int32),
+                device=mesh,
+                layout=_ttnn.ROW_MAJOR_LAYOUT,
+                memory_config=_ttnn.DRAM_MEMORY_CONFIG,
+            )
+            start_positions_tensor = _ttnn.from_torch(
+                torch.tensor([first_start], dtype=torch.int32),
+                device=mesh,
+                layout=_ttnn.ROW_MAJOR_LAYOUT,
+                memory_config=_ttnn.DRAM_MEMORY_CONFIG,
+            )
+        if aux_cache is not None:
+            aux_cache["cu_seqlens"] = cu_seqlens_tensor
+            aux_cache["start_positions"] = start_positions_tensor
+
+    _ttnn.experimental.moreh_paged_fill_cache_varlen(
+        k_fill,
+        v_fill,
+        cu_seqlens_tensor,
+        page_table_tensor,
+        start_positions_tensor,
+        cache_k,
+        cache_v,
+    )
+
+    # T3KNIC_FILL_VERIFY: read the destination blocks back out of the model's own KV
+    # cache and compare against the chunk we just wrote. Answers "did the write land
+    # where/how we intended" independently of the wire (which kvdiff already covers).
+    global _FILL_VERIFY_DONE
+    _fv_layers = {0, 31, 63}
+    if os.environ.get("T3KNIC_FILL_VERIFY") == "1" and layer_idx in _fv_layers and layer_idx not in _FILL_VERIFY_DONE:
+        _FILL_VERIFY_DONE.add(layer_idx)
+        try:
+            if full_slot_mapping is not None:
+                seq = (
+                    list(full_slot_mapping.tolist())
+                    if hasattr(full_slot_mapping, "tolist")
+                    else list(full_slot_mapping)
+                )
+            else:
+                seq = []
+                for sm in slot_mappings:
+                    seq.extend(list(sm.tolist()) if hasattr(sm, "tolist") else list(sm))
+            first = int(starts[0])
+            nblk = total_tokens // block_size
+            dst = [
+                ((_to_int(seq[(first // block_size + b) * block_size]) // block_size) % blocks_per_dp)
+                for b in range(nblk)
+            ]
+            gdims = [0, 0]
+            gdims[dp_axis] = 0
+            gdims[tp_axis] = 1
+            comp = _ttnn.ConcatMesh2dToTensor(mesh, mesh_shape=mesh_shape, dims=tuple(gdims))
+            lo, hi = min(dst), max(dst) + 1
+            back = _ttnn.to_torch(cache_k[lo:hi], mesh_composer=comp).float()  # [blocks, heads_total, block, head]
+            # k_cat is (1, H, nblk*block, D): split the token dim, then bring blocks to dim0
+            # (a plain reshape would interleave heads with blocks).
+            want = (
+                k_cat.float()
+                .reshape(k_cat.shape[0], k_cat.shape[1], nblk, block_size, k_cat.shape[3])[0]
+                .permute(1, 0, 2, 3)
+                .contiguous()
+            )
+            got = torch.stack([back[b - lo] for b in dst], dim=0)
+            # Composer-vs-device-order cross-check. The readback above uses the SAME
+            # ConcatMesh2dToTensor the PUT-side gather uses, so a composer whose chip
+            # order disagrees with ShardTensor2dMesh's would round-trip cleanly while
+            # the data physically sits on the wrong chips. Rebuild the same window by
+            # reading each shard explicitly (device order) and compare.
+            try:
+                shards = _ttnn.get_device_tensors(cache_k[lo:hi])
+                manual = torch.cat([_ttnn.to_torch(sh).float() for sh in shards], dim=1)
+                comp_err = (back - manual).abs()
+                logger.info(
+                    "[t3knic][mesh-order] composer vs per-shard: max_abs=%.6g mean_abs=%.6g "
+                    "(composer heads %s | per-shard heads %s)",
+                    float(comp_err.max()),
+                    float(comp_err.mean()),
+                    ["%.3g" % float(back[:, h].abs().max()) for h in range(back.shape[1])],
+                    ["%.3g" % float(manual[:, h].abs().max()) for h in range(manual.shape[1])],
+                )
+            except Exception as exc:  # noqa: BLE001
+                logger.warning("[t3knic][mesh-order] check failed: %s", exc)
+            err = (got - want).abs()
+            per_head = [float(err[:, h].max()) for h in range(err.shape[1])]
+            logger.info(
+                "[t3knic][fill-verify] layer%d dst_blocks=%s max_abs=%.6g mean_abs=%.6g per_head_max=%s "
+                "src_head_absmax=%s",
+                layer_idx,
+                dst,
+                float(err.max()),
+                float(err.mean()),
+                ["%.3g" % x for x in per_head],
+                ["%.3g" % float(want[:, h].abs().max()) for h in range(want.shape[1])],
+            )
+        except Exception as exc:  # noqa: BLE001 - diagnostic only
+            logger.warning("[t3knic][fill-verify] failed: %s", exc)
+
+    # k_fill/v_fill are per-layer; aux (page_table/cu_seqlens/start_positions) is
+    # freed by the caller after the loop when shared via aux_cache.
+    # Arena buffers are owned by the connector and outlive the request; freeing one
+    # would reintroduce exactly the post-capture allocator churn the arena avoids.
+    if fill_slots is None:
+        _ttnn.deallocate(k_fill)
+        _ttnn.deallocate(v_fill)
+    if aux_cache is None and not isinstance(arena, dict):
+        _ttnn.deallocate(page_table_tensor)
+        _ttnn.deallocate(cu_seqlens_tensor)
+        _ttnn.deallocate(start_positions_tensor)
+
+
+def _paged_fill_layer_coalesced(
+    kvcaches: object,
+    layer_idx: int,
+    chunk_blocks: list,
+    slot_mappings: list,
+    starts: list,
+    block_size: int,
+    full_slot_mapping: object = None,
+    arena: object = None,
+    *,
+    dp_size: int = 1,
+    tp_size: int = 1,
+    dp_axis: int = 0,
+    tp_axis: int = 1,
+    blocks_per_dp: object = None,
+    aux_cache: object = None,
+    timing: object = None,
+) -> None:
+    """Page-aware write of N chunks' source blocks into dest cache layer.
+
+    Device load helper. For a coalesced batch of N chunks of the same
+    request, build the inputs to
+    ``ttnn.experimental.moreh_paged_fill_cache_varlen`` and do a single
+    in-place write to ``kvcaches[layer_idx][0/1]`` for this layer.
+
+    Args:
+        kvcaches: vLLM-TT's ``self.kv_caches`` list-of-list of ttnn tensors.
+        layer_idx: 0-based transformer layer.
+        chunk_blocks: List of ``(k_block_host, v_block_host)`` per chunk
+            -- host ``ttnn.Tensor`` of shape
+            ``(num_blocks_in_chunk, num_kv_heads, block_size, head_size)``
+            produced by :func:`_ttnn_chunk_block_to_host`. Assumed to be 1
+            block per chunk for the chunk_size == block_size case.
+        slot_mappings: List of ``slot_mapping_slice`` (torch.Tensor or
+            list of int) per chunk. Used to derive destination block id.
+        starts: List of token-position-in-request per chunk (the
+            ``start`` argument LMCache passes to ``to_gpu``).
+        block_size: Token capacity per paged block.
+
+    Constraints:
+        * ``starts[0]`` must be a multiple of 32 (kernel requirement).
+          With ``chunk_size == block_size == 64`` and chunks aligned to
+          request start, this is always satisfied.
+        * Chunks must be in ascending ``starts`` order.
+        * One source block per chunk (chunk_size == block_size). Multi-
+          block chunks would require additional reshape/concat logic.
+    """
+    import ttnn as _ttnn
+
+    if not chunk_blocks:
+        return
+
+    if (dp_size > 1) or (tp_size > 1):
+        _paged_fill_layer_coalesced_multidev(
+            kvcaches,
+            layer_idx,
+            chunk_blocks,
+            slot_mappings,
+            starts,
+            block_size,
+            full_slot_mapping=full_slot_mapping,
+            dp_size=dp_size,
+            tp_size=tp_size,
+            dp_axis=dp_axis,
+            tp_axis=tp_axis,
+            blocks_per_dp=int(blocks_per_dp),
+            aux_cache=aux_cache,
+            arena=arena,
+        )
+        return
+
+    n_chunks = len(chunk_blocks)
+    cache_k, cache_v = kvcaches[layer_idx]  # type: ignore[index]
+    device = cache_k.device()
+
+    # Decompose restore into to_device / concat / aux_build / kernel / dealloc
+    # so profiling can attribute time to the responsible segment. The caller
+    # accumulates across layers; this is a no-op when timing is None.
+    _prof = timing is not None
+    _t = time.monotonic() if _prof else 0.0
+
+    # Push each chunk's source block back to device. Use DRAM_MEMORY_CONFIG
+    # so the temp tensors don't fight the live cache for L1/sharded slots.
+    # T3KNIC_GET_ONDEV: when the connector already handed us ON-DEVICE
+    # tensors (the wire GET output, no host hop), use them directly and skip the
+    # H2D. The kernel reads the source into a CB and scatters into the separately
+    # owned cache, so feeding the device slice is byte-equivalent to the host
+    # round-trip. Detect via the first block's storage; all blocks are uniform.
+    if chunk_blocks and _ttnn.is_tensor_storage_on_device(chunk_blocks[0][0]):
+        k_devs = [k_h for (k_h, _v_h) in chunk_blocks]
+        v_devs = [v_h for (_k_h, v_h) in chunk_blocks]
+    else:
+        k_devs = [_ttnn.to_device(k_h, device, memory_config=_ttnn.DRAM_MEMORY_CONFIG) for (k_h, _v_h) in chunk_blocks]
+        v_devs = [_ttnn.to_device(v_h, device, memory_config=_ttnn.DRAM_MEMORY_CONFIG) for (_k_h, v_h) in chunk_blocks]
+
+    if _prof:
+        _n = time.monotonic()
+        timing["to_device"] = timing.get("to_device", 0.0) + (_n - _t)
+        _t = _n
+
+    # Concat along the token (block_size) dim to form
+    # (1, num_kv_heads, n_chunks * block_size, head_size). Each k_dev is
+    # (1, num_kv_heads, block_size, head_size).
+    if n_chunks == 1:
+        k_fill = k_devs[0]
+        v_fill = v_devs[0]
+    else:
+        k_fill = _ttnn.concat(k_devs, dim=2)
+        v_fill = _ttnn.concat(v_devs, dim=2)
+        for t in (*k_devs, *v_devs):
+            _ttnn.deallocate(t)
+
+    total_tokens = n_chunks * block_size
+
+    if _prof:
+        _n = time.monotonic()
+        timing["concat"] = timing.get("concat", 0.0) + (_n - _t)
+        _t = _n
+
+    # Layer-invariant fill auxiliaries: page_table / cu_seqlens / start_positions
+    # depend only on slot_mappings / starts / total_tokens, NOT on layer_idx (a
+    # chunk's blocks live at the same paged slots in every layer). When the
+    # caller supplies ``aux_cache`` (batched_to_gpu's per-restore dict) they are
+    # built once on the first layer and reused across all layers, so a 32-layer
+    # restore issues 3 from_torch H2D instead of 96. The caller frees the cached
+    # tensors after the layer loop; with aux_cache=None we build+free locally
+    # (byte-identical to the pre-hoist path). k_fill/v_fill above stay per-layer.
+    if aux_cache is not None and "page_table" in aux_cache:
+        page_table_tensor = aux_cache["page_table"]
+        cu_seqlens_tensor = aux_cache["cu_seqlens"]
+        start_positions_tensor = aux_cache["start_positions"]
+    else:
+        # page_table: destination block id per chunk.
+        def _slot_to_int(slot_value):
+            try:
+                return int(slot_value.item())  # torch tensor scalar
+            except AttributeError:
+                return int(slot_value)
+
+        # Build full page_table for the sequence. The kernel uses
+        # ``block_idx_in_seq = sequence_position // block_size`` to index
+        # page_table[batch][:], so page_table must cover ALL blocks the
+        # sequence touches, not just the chunks we're writing. Otherwise
+        # the kernel reads out-of-bounds entries and writes to garbage
+        # block ids when start_position > 0 (e.g. when vLLM already
+        # prefix-cached the leading chunks).
+        if full_slot_mapping is not None:
+            if hasattr(full_slot_mapping, "tolist"):
+                seq_slots = list(full_slot_mapping.tolist())
+            else:
+                seq_slots = list(full_slot_mapping)
+            seq_len = len(seq_slots)
+            num_blocks_in_seq = (seq_len + block_size - 1) // block_size
+            page_table_row = []
+            for blk_idx_in_seq in range(num_blocks_in_seq):
+                slot = seq_slots[blk_idx_in_seq * block_size]
+                page_table_row.append(_slot_to_int(slot) // block_size)
+        else:
+            # Fallback: only the chunks we're writing. Works when start=0
+            # and we cover every position from 0 to total_tokens (legacy
+            # behaviour pre-coalesce).
+            page_table_row = []
+            for slot_mapping_slice in slot_mappings:
+                first_slot = slot_mapping_slice[0]
+                page_table_row.append(_slot_to_int(first_slot) // block_size)
+        page_table_tensor = _ttnn.from_torch(
+            torch.tensor([page_table_row], dtype=torch.int32),
+            device=device,
+            layout=_ttnn.ROW_MAJOR_LAYOUT,
+        )
+
+        cu_seqlens_tensor = _ttnn.from_torch(
+            torch.tensor([0, total_tokens], dtype=torch.int32),
+            device=device,
+            layout=_ttnn.ROW_MAJOR_LAYOUT,
+        )
+
+        first_chunk_start = int(starts[0])
+        if first_chunk_start % 32 != 0:
+            raise ValueError(
+                "moreh_paged_fill_cache_varlen requires start_positions to be "
+                f"multiples of 32; got starts[0]={first_chunk_start}. Ensure "
+                "LMCache chunk_size aligns chunks to the kernel's tile boundary."
+            )
+        start_positions_tensor = _ttnn.from_torch(
+            torch.tensor([first_chunk_start], dtype=torch.int32),
+            device=device,
+            layout=_ttnn.ROW_MAJOR_LAYOUT,
+        )
+
+        if layer_idx == 0:
+            logger.debug(
+                "_paged_fill_layer_coalesced: n_chunks=%d total_tokens=%d " "page_table=%s start=%d",
+                n_chunks,
+                total_tokens,
+                page_table_row,
+                first_chunk_start,
+            )
+
+        if aux_cache is not None:
+            aux_cache["page_table"] = page_table_tensor
+            aux_cache["cu_seqlens"] = cu_seqlens_tensor
+            aux_cache["start_positions"] = start_positions_tensor
+
+    if _prof:
+        _n = time.monotonic()
+        timing["aux_build"] = timing.get("aux_build", 0.0) + (_n - _t)
+        _t = _n
+
+    _ttnn.experimental.moreh_paged_fill_cache_varlen(
+        k_fill,
+        v_fill,
+        cu_seqlens_tensor,
+        page_table_tensor,
+        start_positions_tensor,
+        cache_k,
+        cache_v,
+    )
+
+    if _prof:
+        _n = time.monotonic()
+        timing["kernel"] = timing.get("kernel", 0.0) + (_n - _t)
+        _t = _n
+
+    # Cleanup temporaries. The layer-invariant auxiliaries are freed by the
+    # caller after the layer loop when aux_cache is supplied (shared across
+    # layers); otherwise we own and free them here.
+    _ttnn.deallocate(k_fill)
+    _ttnn.deallocate(v_fill)
+    if aux_cache is None:
+        _ttnn.deallocate(page_table_tensor)
+        _ttnn.deallocate(cu_seqlens_tensor)
+        _ttnn.deallocate(start_positions_tensor)
+
+    if _prof:
+        timing["dealloc"] = timing.get("dealloc", 0.0) + (time.monotonic() - _t)
+
+
+def _host_ttnn_layer_to_device(
+    kvcaches: object,
+    layer_idx: int,
+    k_host: object,
+    v_host: object,
+) -> None:
+    """Restore a layer's K/V from a host ``ttnn.Tensor`` pair.
+
+    The host tensors are expected to have been produced by
+    :func:`_ttnn_layer_to_host`, i.e. they already carry the original
+    BFP8 + TILE packed bytes. We push them back via ``ttnn.to_device``
+    using the same ``MemoryConfig`` as the existing layer slot, then
+    replace the list element (attention re-dereferences
+    ``kv_cache[layer_idx][0/1]`` every forward, so the swap is
+    observable).
+    """
+    import ttnn as _ttnn
+
+    k_dev, v_dev = kvcaches[layer_idx]  # type: ignore[index]
+    device = k_dev.device()
+    # Preserve the original tensor's MemoryConfig so the consumer
+    # kernels still see the layout they were compiled for.
+    k_memcfg = k_dev.memory_config()
+    v_memcfg = v_dev.memory_config()
+
+    # Free the old device buffer BEFORE allocating the new one to keep
+    # DRAM bounded. Without this, restoring 32 layers × (k+v) at ~22MB
+    # each overflows the 1GB DRAM bank (the existing live KV cache is
+    # already resident).
+    _ttnn.deallocate(k_dev)
+    _ttnn.deallocate(v_dev)
+    k_back = _ttnn.to_device(k_host, device, memory_config=k_memcfg)
+    v_back = _ttnn.to_device(v_host, device, memory_config=v_memcfg)
+    kvcaches[layer_idx][0] = k_back  # type: ignore[index]
+    kvcaches[layer_idx][1] = v_back  # type: ignore[index]
