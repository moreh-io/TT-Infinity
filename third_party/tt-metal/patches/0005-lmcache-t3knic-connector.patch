@@ -0,0 +1,253 @@
+# SPDX-FileCopyrightText: (c) 2026 Moreh
+#
+# SPDX-License-Identifier: Apache-2.0
+"""Standalone kvcache Server for the T3K side of the static inter-mesh link.
+
+No RPC listener, no vLLM: open the mesh with the T3K endpoint's
+``FabricRouterConfig``, put a ``kvcache_manager.Server`` on the chip the cable
+lands on, publish an optional orchestration-ready marker, and wait. Galaxy-side
+product Clients use endpoint-free ESTABLISH; the Server handles never leave
+this process.
+
+Run on the T3K host, AFTER the link is up::
+
+    python -m lmcache_t3knic.t3knic_lmcache.t3k_kvcache_server \\
+        --ready-file /shared/t3knic/server.ready
+
+Stop it with SIGINT/SIGTERM; the Server and the mesh are closed on the way out.
+"""
+
+from __future__ import annotations
+
+import argparse
+import os
+import pathlib
+import signal
+import sys
+import threading
+import time
+
+from lmcache.logging import init_logger
+
+from lmcache_t3knic.t3knic_lmcache import intermesh
+
+logger = init_logger(__name__)
+
+
+def _configure_remote_server_environment() -> None:
+    os.environ["KVM_SERVER_MAPPED_GET_COMPLETION"] = "0"
+    os.environ["KVM_SERVER_MAPPED_GET_INGRESS"] = "0"
+
+
+def _require_server_ready(server) -> None:
+    if not bool(server.is_ready()):
+        raise RuntimeError("kvcache Server is not healthy after launch")
+
+
+def _close_servers_then_mesh(servers, parent_mesh, ttnn) -> None:
+    failure = None
+    for server in reversed(servers):
+        try:
+            server.close()
+        except Exception as exc:  # noqa: BLE001 - close the remaining shards too
+            logger.exception("[t3knic][t3k-server] Server shard close failed; leaving the parent mesh open")
+            if failure is None:
+                failure = exc
+    if failure is not None:
+        raise failure
+    ttnn.close_mesh_device(parent_mesh)
+
+
+def _close_server_then_mesh(server, parent_mesh, ttnn) -> None:
+    """Compatibility helper for the single-shard lifecycle test."""
+    _close_servers_then_mesh([] if server is None else [server], parent_mesh, ttnn)
+
+
+def parse_args(argv=None) -> argparse.Namespace:
+    p = argparse.ArgumentParser(description="kvcache Server on the T3K static inter-mesh endpoint")
+    p.add_argument(
+        "--ready-file",
+        default=os.environ.get("T3KNIC_SERVER_READY"),
+        help="optional readiness marker for orchestration (default: $T3KNIC_SERVER_READY)",
+    )
+    p.add_argument("--cable", type=int, default=None, help="deployment cable index; default from env")
+    p.add_argument("--link", type=int, default=None, help="link within the cable (0-based); default from env")
+    p.add_argument(
+        "--mesh-shape",
+        default="2,4",
+        help="T3K parent mesh shape as rows,cols (default 2,4 = the whole T3K)",
+    )
+    p.add_argument(
+        "--remote-mesh-id",
+        type=int,
+        default=int(os.environ.get("T3KNIC_REMOTE_MESH_ID", 0)),
+        help="expected fabric mesh id of the Galaxy side, validated during ESTABLISH",
+    )
+    p.add_argument(
+        "--start-gate",
+        default=None,
+        help=(
+            "wait for this file to appear before opening the mesh. Use it to keep this Server from "
+            "entering static inter-mesh mode until the Galaxy host has finished its own UMD "
+            "topology discovery (see the rendezvous note in main())"
+        ),
+    )
+    p.add_argument(
+        "--start-gate-timeout",
+        type=float,
+        default=900.0,
+        help="seconds to wait for --start-gate before giving up (default 900)",
+    )
+    return p.parse_args(argv)
+
+
+def main(argv=None) -> int:
+    args = parse_args(argv)
+    cable = intermesh.cable_index_from_env() if args.cable is None else args.cable
+    link = intermesh.link_index_from_env() if args.link is None else args.link
+    rows, cols = (int(v) for v in args.mesh_shape.split(","))
+
+    if args.ready_file:
+        try:
+            os.remove(args.ready_file)
+        except FileNotFoundError:
+            pass
+
+    # Host-mapped GET completion is unusable across the cable: it has the Server's host worker touch
+    # the Client's L1 directly, and the Client is on the other machine. A remote Client therefore
+    # takes the fabric-direct GET path; disabling it here keeps the Server from
+    # waiting on a completion notice that will never
+    # arrive. This Server serves only remote Clients, so a process-wide switch is enough -- mixing
+    # local and remote Clients on one Server would instead need a per-client bit in ESTABLISH.
+    _configure_remote_server_environment()
+
+    import ttnn
+    from lmcache_t3knic.t3knic_lmcache._kvm_backend import kvcache_manager
+
+    # Rendezvous, in three steps, and the order matters.
+    #
+    # UMD topology discovery walks every Ethernet core and requires its heartbeat to advance. The
+    # moment one host puts the cable's Ethernet core into static inter-mesh mode, the OTHER host's
+    # discovery hangs on that core and dies with "Timed out waiting for ETH heartbeat" (observed
+    # both ways round: whichever host flipped second was the one that failed). So:
+    #
+    #   1. force this host's discovery now, while both ends are still ordinary Ethernet;
+    #   2. wait for the Galaxy to finish its own discovery (--start-gate);
+    #   3. only then select the inter-mesh fabric and open the mesh.
+    #
+    # Fabric router sync tolerates the resulting skew -- it waits FABRIC_ROUTER_SYNC_TIMEOUT_MS for
+    # the peer.
+    logger.info("[t3knic][t3k-server] running topology discovery before the link is claimed")
+    ttnn.get_num_devices()
+
+    if args.start_gate:
+        gate = pathlib.Path(args.start_gate)
+        deadline = time.monotonic() + args.start_gate_timeout
+        logger.info("[t3knic][t3k-server] waiting for start gate %s", gate)
+        while not gate.exists():
+            if time.monotonic() > deadline:
+                raise TimeoutError(
+                    f"start gate {gate} did not appear within {args.start_gate_timeout}s; the Galaxy "
+                    "side never reached its fabric init"
+                )
+            time.sleep(0.5)
+        logger.info("[t3knic][t3k-server] start gate seen; claiming the link")
+
+    endpoint_chip = intermesh.endpoint_physical_chip("t3k", cable)
+
+    # Fabric is process-wide state selected before the mesh opens, not an open_mesh_device kwarg.
+    intermesh.apply_fabric_config("t3k", cable, link)
+    parent_mesh = ttnn.open_mesh_device(ttnn.MeshShape(rows, cols))
+    servers = []
+    try:
+        coord = intermesh.physical_chip_coord(parent_mesh, endpoint_chip)
+        server_submesh = parent_mesh.create_submesh(ttnn.MeshShape(1, 1), coord)
+        logger.info(
+            "[t3knic][t3k-server] endpoint physical chip %d is mesh coordinate %s of %dx%d",
+            endpoint_chip,
+            tuple(coord),
+            rows,
+            cols,
+        )
+        # static_intermesh_t3k_server: this Server owns the cable-side connection and stamps
+        # pre-seeded routes into its responses. remote_mesh_id is the Galaxy mesh those responses
+        # are addressed to. Both are Server ctor arguments (not env) in the internode-kvm design.
+        shard_count = int(os.environ.get("T3KNIC_SERVER_SHARDS", "1"))
+        if shard_count < 1 or shard_count > 8:
+            raise ValueError(f"T3KNIC_SERVER_SHARDS must be in [1, 8]; got {shard_count}")
+        for worker_group in range(shard_count):
+            servers.append(
+                kvcache_manager.Server(
+                    server_submesh,
+                    static_intermesh_t3k_server=True,
+                    static_intermesh_remote_mesh_id=args.remote_mesh_id,
+                    worker_group=worker_group,
+                )
+            )
+        logger.info(
+            "[t3knic][t3k-server] %d Server shards started; all_ready=%s",
+            shard_count,
+            all(server.is_ready() for server in servers),
+        )
+        for server in servers:
+            _require_server_ready(server)
+
+        if args.ready_file:
+            ready_path = pathlib.Path(args.ready_file)
+            ready_path.parent.mkdir(parents=True, exist_ok=True)
+            temporary_path = ready_path.with_name(f"{ready_path.name}.tmp.{os.getpid()}")
+            temporary_path.write_text("ready\n", encoding="utf-8")
+            os.replace(temporary_path, ready_path)
+        logger.info(
+            "[t3knic][t3k-server] ready. Galaxy side: "
+            "T3KNIC_INTERMESH_ROLE=galaxy T3KNIC_INTERMESH_CABLE=%d "
+            "T3KNIC_INTERMESH_LINK=%d ready_file=%s",
+            cable,
+            link,
+            args.ready_file,
+        )
+
+        stop = threading.Event()
+
+        def _stop(signum, _frame):
+            logger.info("[t3knic][t3k-server] signal %d received; shutting down", signum)
+            stop.set()
+
+        signal.signal(signal.SIGINT, _stop)
+        signal.signal(signal.SIGTERM, _stop)
+        started = time.monotonic()
+
+        # Report the Server's own work counters, not just liveness.
+        def _counters():
+            out = []
+            try:
+                out.append(f"moves_completed={sum(server.moves_completed() for server in servers)}")
+            except Exception as exc:  # noqa: BLE001 - diagnostics must never stop the Server
+                out.append(f"moves_completed=<{type(exc).__name__}>")
+            return " ".join(out)
+
+        want_counters = os.environ.get("T3KNIC_SERVER_COUNTERS") == "1"
+        if want_counters:
+            logger.info("[t3knic][t3k-server] counters at start: %s", _counters())
+        while not stop.wait(timeout=60.0):
+            logger.info(
+                "[t3knic][t3k-server] alive %.1f min; is_ready=%s%s",
+                (time.monotonic() - started) / 60.0,
+                all(server.is_ready() for server in servers),
+                (" " + _counters()) if want_counters else "",
+            )
+    finally:
+        if args.ready_file:
+            try:
+                os.remove(args.ready_file)
+            except FileNotFoundError:
+                pass
+            except OSError:
+                logger.exception("[t3knic][t3k-server] could not remove %s", args.ready_file)
+        _close_servers_then_mesh(servers, parent_mesh, ttnn)
+        logger.info("[t3knic][t3k-server] stopped")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
