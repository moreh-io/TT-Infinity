--- /dev/null
+++ b/lmcache-t3knic/benchmarks/run_cross_node_ttft.sh
@@ -0,0 +1,348 @@
+#!/usr/bin/env bash
+# One command for the cross-node KV benchmark: start the KV server on the T3K, start vLLM on the
+# Galaxy, send one cold and two warm ISL 3296 requests, print the numbers, put everything back.
+#
+#   PLUGIN=YOUR_PLUGIN_PATH PLUGIN_PY=YOUR_PLUGIN_PYTHON T3K_HOST=YOUR_T3K_SSH_ALIAS \
+#       MODEL=YOUR_MODEL_PATH LINK=YOUR_LINK_INDEX ./run_cross_node_ttft.sh
+#   KVM_DISABLE=1 PLUGIN=YOUR_PLUGIN_PATH PLUGIN_PY=YOUR_PLUGIN_PYTHON \
+#       MODEL=YOUR_MODEL_PATH ./run_cross_node_ttft.sh
+#
+# Assumes the cable is already trained as described by the matching kvcache-manager usage guide;
+# it does not reset devices or retrain links. Run it from a checkout that is built on BOTH hosts.
+set -uo pipefail
+
+TT_REPO=${TT_REPO:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)}
+KVM_DISABLE=${KVM_DISABLE:-0}             # 1 = run vLLM without LMCache/KVM
+T3K_HOST=${T3K_HOST:-}
+if [ "$KVM_DISABLE" != 1 ]; then
+    : "${T3K_HOST:?set T3K_HOST to the ssh alias of the T3K box}"
+fi
+T3K_REPO=${T3K_REPO:-$TT_REPO}          # the same branch, built, on the T3K
+MODEL=${MODEL:?set MODEL to the Qwen3-32B weights}
+SHARED=${SHARED:-$HOME/t3knic}          # ready marker + start gate; scp'd if not a shared FS
+LINK=${LINK:-}
+if [ "$KVM_DISABLE" != 1 ]; then
+    : "${LINK:?set LINK to the deployment-validated cable index}"
+fi
+PORT=${PORT:-8000}
+REQUESTS=${REQUESTS:-3}
+OSL=${OSL:-16}
+PROMPT_TOKENS=${PROMPT_TOKENS:-}
+MAX_MODEL_LEN=${MAX_MODEL_LEN:-4096}
+MAX_NUM_SEQS=${MAX_NUM_SEQS:-1}
+INTER_REQUEST_DELAY=${INTER_REQUEST_DELAY:-0}
+BENCHMARK_DRIVER=${BENCHMARK_DRIVER:-ttft}
+T3KNIC_INTERMESH_LINK_COUNT=${T3KNIC_INTERMESH_LINK_COUNT:-1}
+T3KNIC_SERVER_SHARDS=${T3KNIC_SERVER_SHARDS:-1}
+T3KNIC_WIRE_MODE=${T3KNIC_WIRE_MODE:-device}
+PLUGIN=${PLUGIN:?set PLUGIN to the canonically patched vLLM TT plugin checkout}
+PLUGIN_PY=${PLUGIN_PY:?set PLUGIN_PY to the plugin environment interpreter}
+T3K_PY=${T3K_PY:-$T3K_REPO/python_env/bin/python3}
+OUT=${OUT:-$(mktemp -d)}
+
+READY=$SHARED/server.ready
+GATE=$SHARED/start_gate
+SERVE_PID=""
+GATE_PID=""
+CLEANING_UP=0
+
+log() { printf '%s %s\n' "$(date +%H:%M:%S)" "$*"; }
+
+cleanup() {
+    [ "$CLEANING_UP" = 1 ] && return
+    CLEANING_UP=1
+
+    # vLLM's EngineCore is a child process which owns the TT worker and its mesh.  Give the API
+    # server time to drive EngineCoreProc.shutdown -> TTWorker.shutdown -> close_mesh_device.
+    # Killing EngineCore after a fixed three-second sleep strands the active fabric firmware on
+    # the Galaxy gateway, and the next process then dies while probing that core's heartbeat.
+    if [ -n "$SERVE_PID" ]; then
+        kill -TERM "$SERVE_PID" 2>/dev/null
+        for _ in $(seq 1 120); do
+            kill -0 "$SERVE_PID" 2>/dev/null || break
+            sleep 1
+        done
+        # Keep cleanup bounded even if the API process itself ignores TERM.  By this point it has
+        # had two minutes to request an orderly EngineCore shutdown.
+        kill -0 "$SERVE_PID" 2>/dev/null && kill -KILL "$SERVE_PID" 2>/dev/null
+        wait "$SERVE_PID" 2>/dev/null
+    fi
+
+    # The API process can exit before its independently named engine finishes closing 32 devices.
+    # Keep waiting for that normal child shutdown before sending it a signal of our own.
+    for _ in $(seq 1 120); do
+        pgrep -f "^VLLM::EngineCore" >/dev/null || break
+        sleep 1
+    done
+
+    # A failed API-server shutdown can leave the engine behind.  TERM still lets its Python
+    # lifecycle run; KILL is only the last resort after another bounded wait.
+    if pgrep -f "^VLLM::EngineCore" >/dev/null; then
+        pkill -TERM -f "^VLLM::EngineCore" 2>/dev/null
+        for _ in $(seq 1 60); do
+            pgrep -f "^VLLM::EngineCore" >/dev/null || break
+            sleep 1
+        done
+    fi
+    pgrep -f "^VLLM::EngineCore" >/dev/null && pkill -KILL -f "^VLLM::EngineCore" 2>/dev/null
+
+    # Signal only the server's python, not the wrapper that owns the T3K's device lock: killing the
+    # wrapper leaves that lock behind and every later run on that host waits for it.
+    if [ "$KVM_DISABLE" != 1 ]; then
+        ssh -o BatchMode=yes -n "$T3K_HOST" '
+            for p in $(pgrep -f "[t]3k_kvcache_server"); do
+                case "$(cat /proc/$p/comm 2>/dev/null)" in python*) kill -INT $p 2>/dev/null;; esac
+            done
+            for i in $(seq 1 30); do pgrep -f "[t]3k_kvcache_server" >/dev/null || break; sleep 1; done
+            for p in $(pgrep -f "[t]3k_kvcache_server"); do
+                case "$(cat /proc/$p/comm 2>/dev/null)" in python*) kill -KILL $p 2>/dev/null;; esac
+            done' 2>/dev/null
+    fi
+}
+trap cleanup EXIT INT TERM
+
+mkdir -p "$OUT"
+if [ "$KVM_DISABLE" != 1 ]; then
+    mkdir -p "$SHARED"
+    rm -f "$READY" "$READY.tmp" "$GATE"
+    ssh -o BatchMode=yes -n "$T3K_HOST" "mkdir -p '$SHARED'; rm -f '$READY' '$GATE'"
+fi
+
+# ---------------------------------------------------------------- T3K KV server
+# It goes first and then parks at the gate. Run both hosts' device discovery at once and they
+# knock over each other's Ethernet heartbeat, so the Galaxy only starts once this side is idle.
+if [ "$KVM_DISABLE" != 1 ]; then
+    log "starting the KV server on $T3K_HOST"
+    ssh -o BatchMode=yes "$T3K_HOST" bash -s > "$OUT/server.log" 2>&1 <<EOT &
+cd "$T3K_REPO" || exit 1
+export TT_METAL_HOME="$T3K_REPO" PYTHONUNBUFFERED=1
+export PYTHONPATH="$T3K_REPO:$T3K_REPO/lmcache-t3knic:$T3K_REPO/ttnn"
+export T3KNIC_INTERMESH_ROLE=t3k T3KNIC_INTERMESH_CABLE=$LINK T3KNIC_INTERMESH_LINK=0
+export T3KNIC_INTERMESH_LINK_COUNT=$T3KNIC_INTERMESH_LINK_COUNT
+export T3KNIC_SERVER_SHARDS=$T3KNIC_SERVER_SHARDS
+export TT_METAL_FABRIC_ROUTER_SYNC_TIMEOUT_MS=240000
+"$T3K_PY" -m lmcache_t3knic.t3knic_lmcache.t3k_kvcache_server \
+    --ready-file "$READY" --start-gate "$GATE" --start-gate-timeout 900
+EOT
+
+    for i in $(seq 1 150); do
+        grep -qa "waiting for start gate" "$OUT/server.log" 2>/dev/null && break
+        grep -qaE "Traceback|Timed out" "$OUT/server.log" 2>/dev/null && {
+            log "KV server failed to start:"; grep -aE "Traceback|Error|Timed out" "$OUT/server.log" | tail -5; exit 1; }
+        sleep 2
+    done
+    grep -qa "waiting for start gate" "$OUT/server.log" || { log "KV server never reached the start gate"; exit 1; }
+    log "KV server is at the gate"
+else
+    log "KVM disabled; skipping the T3K KV server"
+fi
+
+# ---------------------------------------------------------------- Galaxy vLLM
+cd "$TT_REPO"
+export TT_METAL_HOME=$TT_REPO
+# $TT_REPO/ttnn must be on the path, not just $TT_REPO: without it `import ttnn` falls
+# through to whatever ttnn the venv has installed, which is a different checkout and fails
+# later as a kernel-build error that names no cause.
+export PYTHONPATH=$TT_REPO:$TT_REPO/lmcache-t3knic:$TT_REPO/ttnn
+export TT_METAL_CACHE=${TT_METAL_CACHE:-$HOME/.cache/tt-metal-$(basename "$TT_REPO")}
+export TT_CACHE_PATH=${TT_CACHE_PATH:-$HOME/.cache/tt-model-$(basename "$TT_REPO")}
+export VLLM_PLUGINS=tt,tt_model_registry VLLM_ENABLE_V1_MULTIPROCESSING=0
+export MESH_DEVICE=T3K HF_MODEL=$MODEL VLLM_RPC_TIMEOUT=900000
+# Must be set before the process starts: rtoptions reads it when the MetalContext is built, and the
+# 10 s default is not enough for two hosts to find each other.
+export TT_METAL_FABRIC_ROUTER_SYNC_TIMEOUT_MS=240000
+KV_ARGS=()
+if [ "$KVM_DISABLE" != 1 ]; then
+    export VLLM_TT_T3KNIC_URL='t3knic://static-intermesh:0?mode=external'
+    export T3KNIC_INTERMESH_ROLE=galaxy T3KNIC_INTERMESH_CABLE=$LINK T3KNIC_INTERMESH_LINK=0
+    export T3KNIC_INTERMESH_LINK_COUNT=$T3KNIC_INTERMESH_LINK_COUNT
+    export T3KNIC_SERVER_SHARDS=$T3KNIC_SERVER_SHARDS
+    export T3KNIC_SERVER_READY=$READY T3KNIC_SERVER_READY_TIMEOUT=900
+    export KVM_CLIENT_ESTABLISH_TIMEOUT_MS=60000
+    export T3KNIC_WIRE_MODE=$T3KNIC_WIRE_MODE T3KNIC_WIRE_MASTER_COORD=${T3KNIC_WIRE_MASTER_COORD:-0,0}
+    export T3KNIC_BUF_REUSE=1 T3KNIC_FILL_ARENA=1
+    # Without this the first cache hit includes model-side resumed-prefill trace compilation.
+    export TT_WARMUP_PREFILL_RESUMED=${TT_WARMUP_PREFILL_RESUMED:-1}
+    export T3KNIC_TIMING_LOG=${T3KNIC_TIMING_LOG:-4} T3KNIC_WIRE_AGG=${T3KNIC_WIRE_AGG:-26}
+    export LMCACHE_CONFIG_FILE=${LMCACHE_CONFIG_FILE:-$SHARED/lmcache.yaml}
+    [ -s "$LMCACHE_CONFIG_FILE" ] || { log "no LMCache config at $LMCACHE_CONFIG_FILE; see the matching kvcache-manager docs/usage.md"; exit 1; }
+    KV_ARGS=(
+        --kv-transfer-config
+        '{"kv_connector":"T3knicKVConnector","kv_role":"kv_both","kv_connector_module_path":"lmcache_t3knic.t3knic_lmcache.t3knic_kv_connector"}'
+    )
+else
+    unset LMCACHE_CONFIG_FILE VLLM_TT_T3KNIC_URL
+    unset T3KNIC_INTERMESH_ROLE T3KNIC_INTERMESH_CABLE T3KNIC_INTERMESH_LINK
+    unset T3KNIC_INTERMESH_LINK_COUNT T3KNIC_SERVER_SHARDS
+    unset T3KNIC_SERVER_READY T3KNIC_SERVER_READY_TIMEOUT KVM_CLIENT_ESTABLISH_TIMEOUT_MS
+    unset T3KNIC_WIRE_MODE T3KNIC_WIRE_MASTER_COORD T3KNIC_BUF_REUSE T3KNIC_FILL_ARENA
+    unset T3KNIC_TIMING_LOG T3KNIC_WIRE_AGG TT_WARMUP_PREFILL_RESUMED
+fi
+
+log "starting vLLM on this host"
+"$PLUGIN_PY" "$PLUGIN/examples/server_example_tt.py" \
+    --model "$MODEL" --port "$PORT" \
+    --max_num_seqs "$MAX_NUM_SEQS" --block_size 128 --max_model_len "$MAX_MODEL_LEN" \
+    --shutdown-timeout 120 \
+    --no-enable-prefix-caching \
+    "${KV_ARGS[@]}" \
+    --additional-config '{"tt":{"fabric_config":"FABRIC_2D","trace_region_size":66147328}}' \
+    > "$OUT/vllm.log" 2>&1 &
+SERVE_PID=$!
+
+# Open the T3K's gate as soon as this side is past discovery. The product Client waits on the
+# ready marker while the T3K finishes constructing every Server shard.
+if [ "$KVM_DISABLE" != 1 ]; then
+    ( for i in $(seq 1 300); do
+          grep -qa "role=galaxy rank ready" "$OUT/vllm.log" 2>/dev/null && {
+              ssh -o BatchMode=yes -n "$T3K_HOST" "touch '$GATE'"
+              break
+          }
+          kill -0 $SERVE_PID 2>/dev/null || break
+          sleep 2
+      done
+      for i in $(seq 1 450); do
+          [ -s "$READY" ] && break
+          if scp -q -o BatchMode=yes "$T3K_HOST:$READY" "$READY.tmp" 2>/dev/null; then
+              mv "$READY.tmp" "$READY"
+              break
+          fi
+          kill -0 $SERVE_PID 2>/dev/null || break
+          sleep 2
+      done ) &
+    GATE_PID=$!
+fi
+
+show_startup_progress() {
+    local progress
+    progress=$(tail -c 131072 "$OUT/vllm.log" 2>/dev/null \
+        | tr '\r' '\n' \
+        | sed 's/\x1b\[[0-9;]*m//g' \
+        | grep -aE '([0-9]+/[0-9]+|[0-9]+%|it/s).*([Ww]eight|[Ll]ayer|tensor|cache)|([Ww]eight|[Ll]ayer|tensor|cache).*([0-9]+/[0-9]+|[0-9]+%|it/s)' \
+        | tail -1 || true)
+    if [ -n "$progress" ] && [ "$progress" != "${LAST_STARTUP_PROGRESS:-}" ]; then
+        printf '  %s\n' "$progress"
+        LAST_STARTUP_PROGRESS=$progress
+    fi
+}
+
+UP=0
+LAST_STARTUP_PROGRESS=
+for i in $(seq 1 240); do
+    curl -s -m 3 "localhost:$PORT/v1/models" 2>/dev/null | grep -q '"id"' && { UP=1; break; }
+    kill -0 $SERVE_PID 2>/dev/null || break
+    grep -qaE "Traceback|TT_FATAL|EngineDeadError" "$OUT/vllm.log" && break
+    show_startup_progress
+    sleep 5
+done
+[ -n "$GATE_PID" ] && kill "$GATE_PID" 2>/dev/null
+if [ "$UP" != 1 ]; then
+    log "vLLM did not come up; last errors:"
+    sed 's/\x1b\[[0-9;]*m//g' "$OUT/vllm.log" | grep -aE "Traceback|Error|TT_FATAL|TT_THROW|t3knic" | tail -12
+    log "full logs in $OUT"
+    exit 1
+fi
+log "vLLM is up"
+
+# Prime the resumed-prefill execution path outside the measured workload. The first request stores
+# a separate synthetic prefix; the extended second request restores it and compiles/captures the
+# requested tail bucket. AIPerf starts only after both requests and the final PUT drain delay.
+if [ "${PREWARM_RESUMED_PREFILL:-0}" = 1 ] && [ "$KVM_DISABLE" != 1 ]; then
+    PREWARM_RESUMED_PREFIX_TOKENS=${PREWARM_RESUMED_PREFIX_TOKENS:-4096}
+    PREWARM_RESUMED_TAIL_TOKENS=${PREWARM_RESUMED_TAIL_TOKENS:-1024}
+    PREWARM_RESUMED_DELAY=${PREWARM_RESUMED_DELAY:-1}
+    log "priming resumed prefill: prefix=$PREWARM_RESUMED_PREFIX_TOKENS tail=$PREWARM_RESUMED_TAIL_TOKENS"
+    "$PLUGIN_PY" "$TT_REPO/lmcache-t3knic/benchmarks/t3knic_ttft.py" \
+        --base "http://localhost:$PORT" --max-tokens 1 \
+        --prime-prefix-tokens "$PREWARM_RESUMED_PREFIX_TOKENS" \
+        --prime-resumed-tail "$PREWARM_RESUMED_TAIL_TOKENS" \
+        --inter-request-delay "$PREWARM_RESUMED_DELAY" || exit $?
+    sleep "$PREWARM_RESUMED_DELAY"
+fi
+
+# ---------------------------------------------------------------- measure
+echo
+case "$BENCHMARK_DRIVER" in
+    ttft)
+        TTFT_PROMPT_ARGS=()
+        if [ -n "$PROMPT_TOKENS" ]; then
+            TTFT_PROMPT_ARGS=(--prompt-tokens "$PROMPT_TOKENS")
+        fi
+        "$PLUGIN_PY" "$TT_REPO/lmcache-t3knic/benchmarks/t3knic_ttft.py" \
+            --base "http://localhost:$PORT" --requests "$REQUESTS" --max-tokens "$OSL" \
+            --inter-request-delay "$INTER_REQUEST_DELAY" "${TTFT_PROMPT_ARGS[@]}"
+        rc=$?
+        ;;
+    agentx)
+        AIPERF_CLI=${AIPERF_CLI:?set AIPERF_CLI to the isolated aiperf executable}
+        CONC=${CONC:-1}
+        DURATION=${DURATION:-1200}
+        AGENTX_REQUEST_COUNT=${AGENTX_REQUEST_COUNT:-}
+        AGENTX_DATASET_ENTRIES=${AGENTX_DATASET_ENTRIES:-393}
+        AGENTX_WARMUP_REQUESTS_PER_LANE=${AGENTX_WARMUP_REQUESTS_PER_LANE:-1}
+        AGENTX_TRAJECTORY_START_MIN_RATIO=${AGENTX_TRAJECTORY_START_MIN_RATIO:-0.25}
+        AGENTX_TRAJECTORY_START_MAX_RATIO=${AGENTX_TRAJECTORY_START_MAX_RATIO:-0.75}
+        PUBLIC_DATASET=${PUBLIC_DATASET:-semianalysis_cc_traces_weka_062126}
+        STOP_ARGS=(--benchmark-duration "$DURATION" --benchmark-grace-period 30)
+        if [ -n "$AGENTX_REQUEST_COUNT" ]; then
+            STOP_ARGS+=(--request-count "$AGENTX_REQUEST_COUNT")
+        fi
+        WARMUP_ARGS=()
+        if [ "$AGENTX_WARMUP_REQUESTS_PER_LANE" -gt 0 ]; then
+            WARMUP_ARGS=(--warmup-requests-per-lane "$AGENTX_WARMUP_REQUESTS_PER_LANE")
+        fi
+        if [ -n "${AGENTX_INPUT_DIR:-}" ]; then
+            DATASET_ARGS=(
+                --custom-dataset-type weka_trace
+                --input-file "$AGENTX_INPUT_DIR"
+                --unsafe-override
+            )
+        else
+            DATASET_ARGS=(--public-dataset "$PUBLIC_DATASET")
+        fi
+        mkdir -p "$OUT/aiperf_artifacts"
+        "$AIPERF_CLI" profile \
+            --scenario inferencex-agentx-mvp \
+            --url "http://localhost:$PORT" \
+            --endpoint /v1/chat/completions \
+            --endpoint-type chat \
+            --streaming \
+            --model "$MODEL" \
+            --tokenizer "$MODEL" \
+            --concurrency "$CONC" \
+            "${STOP_ARGS[@]}" \
+            --stats-interval 30 \
+            --random-seed 42 \
+            --failed-request-threshold 0.10 \
+            --trajectory-start-min-ratio "$AGENTX_TRAJECTORY_START_MIN_RATIO" \
+            --trajectory-start-max-ratio "$AGENTX_TRAJECTORY_START_MAX_RATIO" \
+            "${WARMUP_ARGS[@]}" \
+            --trace-idle-gap-cap-seconds 300 \
+            --warmup-grace-period 1800 \
+            --use-server-token-count \
+            --no-gpu-telemetry \
+            --tokenizer-trust-remote-code \
+            --max-context-length "$MAX_MODEL_LEN" \
+            --num-dataset-entries "$AGENTX_DATASET_ENTRIES" \
+            --slice-duration 1.0 \
+            --output-artifact-dir "$OUT/aiperf_artifacts" \
+            "${DATASET_ARGS[@]}"
+        rc=$?
+        ;;
+    *)
+        log "unknown BENCHMARK_DRIVER=$BENCHMARK_DRIVER (expected ttft or agentx)"
+        rc=2
+        ;;
+esac
+
+if [ "$KVM_DISABLE" != 1 ]; then
+    echo
+    echo "wire throughput (python-level kvcache_manager put/get):"
+    sed 's/\x1b\[[0-9;]*m//g' "$OUT/vllm.log" | grep -aoE "\[t3knic\]\[wire\] (PUT|GET) .*" | tail -4 | sed 's/^/  /'
+    echo
+    log "logs: $OUT/vllm.log  $OUT/server.log"
+else
+    echo
+    log "logs: $OUT/vllm.log"
+fi
+exit $rc
