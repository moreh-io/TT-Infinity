+chan_id_t ControlPlane::get_static_intermesh_endpoint_eth_channel() const {
+    return get_static_intermesh_endpoint_eth_channel(0);
+}
+
+chan_id_t ControlPlane::get_static_intermesh_endpoint_eth_channel(uint32_t lane) const {
+    TT_FATAL(
+        fabric_router_config_.static_intermesh_endpoint_role != StaticIntermeshEndpointRole::DISABLED,
+        "Cannot resolve a static inter-mesh link for a disabled endpoint");
+
+    const auto physical_chip = fabric_router_config_.static_intermesh_endpoint_physical_chip;
+    const auto& remote_connections = cluster_.get().get_cluster_desc()->get_ethernet_connections_to_remote_devices();
+    const auto chip_it = remote_connections.find(physical_chip);
+    TT_FATAL(
+        chip_it != remote_connections.end(),
+        "No live cross-host Ethernet links found on static inter-mesh endpoint chip {}",
+        physical_chip);
+
+    std::vector<chan_id_t> channels;
+    channels.reserve(chip_it->second.size());
+    for (const auto& [channel, _] : chip_it->second) {
+        channels.push_back(static_cast<chan_id_t>(channel));
+    }
+    std::sort(channels.begin(), channels.end());
+
+    const auto link_count = fabric_router_config_.static_intermesh_endpoint_link_count;
+    TT_FATAL(link_count > 0, "Static inter-mesh endpoint link count must be positive");
+    TT_FATAL(
+        lane < link_count, "Static inter-mesh lane {} is out of range for configured link count {}", lane, link_count);
+    const auto link_index = fabric_router_config_.static_intermesh_endpoint_link_index + lane;
+    TT_FATAL(
+        link_index < channels.size(),
+        "Static inter-mesh link index {} is out of range for endpoint chip {} with {} live cross-host links",
+        link_index,
+        physical_chip,
+        channels.size());
+    return channels[link_index];
+}
+
+bool ControlPlane::is_static_intermesh_endpoint_eth_channel(chan_id_t channel) const {
+    if (fabric_router_config_.static_intermesh_endpoint_role == StaticIntermeshEndpointRole::DISABLED) {
+        return false;
+    }
+    for (uint32_t lane = 0; lane < fabric_router_config_.static_intermesh_endpoint_link_count; ++lane) {
+        if (channel == get_static_intermesh_endpoint_eth_channel(lane)) {
+            return true;
+        }
+    }
+    return false;
+}
