 namespace tt::tt_fabric::builder_config {
 
+uint32_t static_z_edge_skip_directions_bitmask(uint32_t chip_id, uint32_t fabric_ns, uint32_t fabric_ew) {
+    const uint32_t row = chip_id / fabric_ew;
+    const uint32_t col = chip_id % fabric_ew;
+    // A static Z router replaces one physically absent cardinal source slot.
+    // Select exactly one missing direction even at a corner: this keeps the
+    // Z-router layout identical for edge and corner gateways (worker + three
+    // forwarding sources), while individual mesh routers may still compact
+    // every physically absent source direction.
+    if (col == 0) {
+        return 1u << eth_chan_directions::WEST;
+    }
+    if (col + 1 == fabric_ew) {
+        return 1u << eth_chan_directions::EAST;
+    }
+    if (row == 0) {
+        return 1u << eth_chan_directions::NORTH;
+    }
+    if (row + 1 == fabric_ns) {
+        return 1u << eth_chan_directions::SOUTH;
+    }
+    return 0;
+}
+
+uint32_t static_mesh_edge_skip_directions_bitmask(uint32_t chip_id, uint32_t fabric_ns, uint32_t fabric_ew) {
+    // A mesh router already excludes its own direction from the three cardinal
+    // source positions. Replace exactly one additional physically absent edge
+    // source with the local Z source. This gives worker + two cardinal + Z = 4
+    // channels on both an edge and a corner; removing every corner boundary
+    // would incorrectly collapse the layout to three channels.
+    return static_z_edge_skip_directions_bitmask(chip_id, fabric_ns, fabric_ew);
+}
+
 uint32_t get_sender_channel_count(const bool is_2D_routing) {
     return is_2D_routing ? builder_config::num_sender_channels_2d : builder_config::num_sender_channels_1d;
 }
