+# T3K <-> Galaxy link-1 benchmark topology.
+# Mesh 0 is the 4x8 Galaxy and mesh 1 is the 2x4 T3K.  Only the directly
+# connected endpoint pair participates in the inter-mesh connection.
+
+mesh_descriptors {
+  name: "GALAXY"
+  arch: WORMHOLE_B0
+  device_topology { dims: [ 4, 8 ] }
+  host_topology { dims: [ 1, 1 ] }
+  channels { count: 2 policy: RELAXED }
+}
+
+mesh_descriptors {
+  name: "T3K"
+  arch: WORMHOLE_B0
+  device_topology { dims: [ 2, 4 ] }
+  host_topology { dims: [ 1, 1 ] }
+  channels { count: 2 policy: RELAXED }
+}
+
+graph_descriptors {
+  name: "T3K_GALAXY_LINK1"
+  type: "FABRIC"
+  instances { mesh { mesh_descriptor: "GALAXY" mesh_id: 0 } }
+  instances { mesh { mesh_descriptor: "T3K" mesh_id: 1 } }
+
+  connections {
+    nodes { mesh { mesh_descriptor: "GALAXY" mesh_id: 0 device_id: 24 } }
+    nodes { mesh { mesh_descriptor: "T3K" mesh_id: 1 device_id: 1 } }
+    channels { count: 2 policy: RELAXED }
+  }
+}
+
+top_level_instance { graph { graph_descriptor: "T3K_GALAXY_LINK1" graph_id: 0 } }
