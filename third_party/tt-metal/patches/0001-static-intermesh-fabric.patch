+    const uint16_t dst_mesh = static_cast<uint16_t>((packed_route >> 5) & 0xFFFFu);
+    const uint8_t ns_hops = static_cast<uint8_t>((packed_route >> 21) & 0xFu);
+    const uint8_t ew_hops = static_cast<uint8_t>((packed_route >> 25) & 0xFu);
+    const uint8_t ns_dir = static_cast<uint8_t>((packed_route >> 29) & 1u);
+    const uint8_t ew_dir = static_cast<uint8_t>((packed_route >> 30) & 1u);
