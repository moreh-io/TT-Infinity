+RawCopyRegion validate_raw_copy_region(
+    const ttnn::Tensor& tensor,
+    std::optional<uint32_t> byte_offset,
+    std::optional<uint32_t> num_bytes,
+    size_t host_num_bytes) {
+    const uint32_t offset = byte_offset.value_or(0);
+    const uint32_t buffer_size = tensor.buffer()->size();
+    const uint32_t bytes = num_bytes.value_or(buffer_size);
+    TT_FATAL(bytes <= host_num_bytes, "destination/source tensor has {} bytes, copy needs {}", host_num_bytes, bytes);
+    TT_FATAL(
+        static_cast<uint64_t>(offset) + static_cast<uint64_t>(bytes) <= buffer_size,
+        "copy region [{}, {}) exceeds device buffer size {}",
+        offset,
+        offset + bytes,
+        buffer_size);
+    return RawCopyRegion{offset, bytes};
+}
+
+bool is_page_aligned_region(const ttnn::Tensor& tensor, const RawCopyRegion& region) {
+    const uint32_t page_size = tensor.buffer()->page_size();
+    return region.offset % page_size == 0 && region.bytes % page_size == 0;
+}
+
+std::optional<tt::tt_metal::BufferRegion> make_aligned_copy_region(
+    const ttnn::Tensor& tensor, const RawCopyRegion& region) {
+    if (region.offset == 0 && region.bytes == tensor.buffer()->size()) {
+        return std::nullopt;
+    }
+    return tt::tt_metal::BufferRegion(region.offset, region.bytes);
+}
+
+RawCopyRegion page_align_region(const ttnn::Tensor& tensor, const RawCopyRegion& region) {
+    const uint32_t page_size = tensor.buffer()->page_size();
+    const uint32_t aligned_offset = (region.offset / page_size) * page_size;
+    const uint32_t end = region.offset + region.bytes;
+    const uint32_t aligned_end = ((end + page_size - 1) / page_size) * page_size;
+    TT_FATAL(aligned_end <= tensor.buffer()->size(), "aligned copy region exceeds device buffer size");
+    return RawCopyRegion{aligned_offset, aligned_end - aligned_offset};
+}
+
+void read_raw_region(
+    const ttnn::Tensor& device_tensor,
+    uint8_t* dst,
+    const RawCopyRegion& region,
+    bool blocking,
+    std::optional<ttnn::QueueId> cq_id) {
+    if (is_page_aligned_region(device_tensor, region)) {
+        const auto copy_region = make_aligned_copy_region(device_tensor, region);
+        if (is_single_coord_mesh_view(device_tensor)) {
+            copy_single_coord_mesh_view_to_torch(device_tensor, dst, copy_region, blocking, cq_id);
+            return;
+        }
+        auto& cq = device_tensor.device()->mesh_command_queue(tt::tt_metal::raw_optional(cq_id));
+        tt::tt_metal::copy_to_host(cq, device_tensor, reinterpret_cast<std::byte*>(dst), copy_region, blocking);
+        return;
+    }
+
+    const auto aligned = page_align_region(device_tensor, region);
+    std::vector<uint8_t> tmp(aligned.bytes);
+    read_raw_region(device_tensor, tmp.data(), aligned, true, cq_id);
+    std::memcpy(dst, tmp.data() + (region.offset - aligned.offset), region.bytes);
+}
+
+void write_raw_region(
+    CpuUint8Tensor src,
+    ttnn::Tensor& device_tensor,
+    const RawCopyRegion& region,
+    bool blocking,
+    std::optional<ttnn::QueueId> cq_id) {
+    if (is_page_aligned_region(device_tensor, region)) {
+        const auto copy_region = make_aligned_copy_region(device_tensor, region);
+        if (is_single_coord_mesh_view(device_tensor)) {
+            copy_single_coord_mesh_view_from_torch(src.data(), device_tensor, copy_region, blocking, cq_id);
+            return;
+        }
+        auto& cq = device_tensor.device()->mesh_command_queue(tt::tt_metal::raw_optional(cq_id));
+        tt::tt_metal::copy_to_device(cq, reinterpret_cast<const std::byte*>(src.data()), device_tensor, copy_region);
+        if (blocking) {
+            cq.finish();
+        }
+        return;
+    }
+
+    const auto aligned = page_align_region(device_tensor, region);
+    std::vector<uint8_t> tmp(aligned.bytes);
+    read_raw_region(device_tensor, tmp.data(), aligned, true, cq_id);
+    std::memcpy(tmp.data() + (region.offset - aligned.offset), src.data(), region.bytes);
+    const auto copy_region = make_aligned_copy_region(device_tensor, aligned);
+    if (is_single_coord_mesh_view(device_tensor)) {
+        copy_single_coord_mesh_view_from_torch(tmp.data(), device_tensor, copy_region, true, cq_id);
+        return;
+    }
+    auto& cq = device_tensor.device()->mesh_command_queue(tt::tt_metal::raw_optional(cq_id));
+    tt::tt_metal::copy_to_device(cq, reinterpret_cast<const std::byte*>(tmp.data()), device_tensor, copy_region);
+    // The temporary staging buffer is owned by this function, so the RMW path
+    // must finish before returning even when the caller requests async writes.
+    cq.finish();
+}
+
+ttnn::Tensor noc_map_host_tensor(const ttnn::Tensor& source, tt::tt_metal::distributed::MeshDevice& mesh_device) {
+    TT_FATAL(source.storage_type() == tt::tt_metal::StorageType::HOST, "source must be a host tensor");
+    TT_FATAL(
+        mesh_device.shape().mesh_size() == 1,
+        "moreh_noc_map_host_tensor currently requires a single-device mesh, got shape {}",
+        mesh_device.shape());
+    const auto& host_tensor = source.host_tensor();
+    TT_FATAL(
+        host_tensor.buffer().shard_coords().size() == 1,
+        "moreh_noc_map_host_tensor requires exactly one populated host shard, got {}",
+        host_tensor.buffer().shard_coords().size());
+
+    const auto pinning = tt::tt_metal::experimental::GetMemoryPinningParameters(mesh_device);
+    TT_FATAL(pinning.can_map_to_noc, "host memory cannot be mapped to NoC on this system");
+    const auto device_range = tt::tt_metal::distributed::MeshCoordinateRangeSet(
+        tt::tt_metal::distributed::MeshCoordinateRange(mesh_device.shape()));
+    auto pinned_host_tensor = host_tensor.transform([&](const tt::tt_metal::HostBuffer& source_buffer) {
+        auto pinned_buffer = source_buffer;
+        TT_FATAL(
+            tt::tt_metal::experimental::HostBufferGetPinnedMemory(pinned_buffer) == nullptr,
+            "source host tensor is already pinned");
+        auto pinned_memory = tt::tt_metal::experimental::PinnedMemory::Create(
+            mesh_device, device_range, pinned_buffer, /*map_to_noc=*/true);
+        const auto coord = tt::tt_metal::distributed::MeshCoordinate::zero_coordinate(mesh_device.shape().dims());
+        auto* device = mesh_device.get_device(coord);
+        TT_FATAL(device != nullptr, "single-device mesh has no device at {}", coord);
+        const auto noc_addr = pinned_memory->get_noc_addr(device->id());
+        TT_FATAL(noc_addr.has_value(), "pinned host tensor has no NoC mapping for device {}", device->id());
+        TT_FATAL(
+            noc_addr->device_id == device->id(),
+            "moreh_noc_map_host_tensor requires an MMIO-attached target; device {} is associated with MMIO device {}",
+            device->id(),
+            noc_addr->device_id);
+        return pinned_buffer;
+    });
+    return ttnn::Tensor(std::move(pinned_host_tensor));
+}
+
+nb::dict pinned_host_tensor_status(const ttnn::Tensor& source, tt::tt_metal::distributed::MeshDevice& mesh_device) {
+    TT_FATAL(source.storage_type() == tt::tt_metal::StorageType::HOST, "source must be a host tensor");
+    TT_FATAL(
+        mesh_device.shape().mesh_size() == 1,
+        "moreh_pinned_host_tensor_status currently requires a single-device mesh, got shape {}",
+        mesh_device.shape());
+    auto host_buffer = tt::tt_metal::host_buffer::get_host_buffer(source.host_tensor());
+    auto pinned_memory = tt::tt_metal::experimental::HostBufferGetPinnedMemory(host_buffer);
+    const auto coord = tt::tt_metal::distributed::MeshCoordinate::zero_coordinate(mesh_device.shape().dims());
+    auto* device = mesh_device.get_device(coord);
+    TT_FATAL(device != nullptr, "single-device mesh has no device at {}", coord);
+
+    nb::dict status;
+    status["attached"] = pinned_memory != nullptr;
+    status["mapped_to_device"] = pinned_memory != nullptr && pinned_memory->get_noc_addr(device->id()).has_value();
+    status["direct_transfer_enqueued"] = pinned_memory != nullptr && pinned_memory->lock_may_block();
+    status["buffer_size"] = pinned_memory != nullptr ? pinned_memory->get_buffer_size() : 0;
+    return status;
+}
+
+void drain_pinned_host_tensor(const ttnn::Tensor& source) {
+    TT_FATAL(source.storage_type() == tt::tt_metal::StorageType::HOST, "source must be a host tensor");
+    auto host_buffer = tt::tt_metal::host_buffer::get_host_buffer(source.host_tensor());
+    auto pinned_memory = tt::tt_metal::experimental::HostBufferGetPinnedMemory(host_buffer);
+    TT_FATAL(pinned_memory != nullptr, "source host tensor has no PinnedMemory attachment");
+    pinned_memory->lock();
+    pinned_memory->unlock();
+}
+
+void bind_moreh_raw_byte_copy(nb::module_& module) {
+    module.def(
+        "moreh_noc_map_host_tensor",
+        &noc_map_host_tensor,
+        nb::arg("source").noconvert(),
+        nb::arg("mesh_device"),
+        R"doc(
+	Create a host tensor view whose storage is pinned and NoC-mapped for a single-device mesh.
+
+	The returned tensor shares the source bytes but carries its own PinnedMemory attachment.
+	Pinning setup is synchronous and should be performed outside timed transfer regions.
+	)doc");
+
+    module.def(
+        "moreh_pinned_host_tensor_status",
+        &pinned_host_tensor_status,
+        nb::arg("source").noconvert(),
+        nb::arg("mesh_device"),
+        R"doc(
+	Return benchmark diagnostics for a NoC-mapped host tensor.
+
+	only when the command queue selected the direct pinned path, and remains
+	observable after the pending event has completed.
+	)doc");
+
+    module.def(
+        "moreh_drain_pinned_host_tensor",
+        &drain_pinned_host_tensor,
+        nb::arg("source").noconvert(),
+        R"doc(
+	Wait for and clear the pending direct-transfer events attached to a pinned host tensor.
+
+	This benchmark helper establishes a fresh ``direct_transfer_enqueued`` observation window.
+	)doc");
+
+    module.def(
+        "moreh_raw_byte_copy_to_torch",
+        [](const ttnn::Tensor& device_tensor,
+           CpuUint8Tensor dst,
+           std::optional<uint32_t> byte_offset,
+           std::optional<uint32_t> num_bytes,
+           bool blocking,
+           std::optional<ttnn::QueueId> cq_id) {
+            validate_raw_byte_device_tensor(device_tensor, "device_tensor");
+            const auto region = validate_raw_copy_region(device_tensor, byte_offset, num_bytes, dst.size());
+            read_raw_region(device_tensor, dst.data(), region, blocking, cq_id);
+        },
+        nb::arg("device_tensor").noconvert(),
+        nb::arg("dst").noconvert(),
+        nb::kw_only(),
+        nb::arg("byte_offset") = std::nullopt,
+        nb::arg("num_bytes") = std::nullopt,
+        nb::arg("blocking") = true,
+        nb::arg("cq_id") = nb::none(),
+        R"doc(
+	Copy raw device tensor bytes directly into an existing CPU torch.uint8-compatible buffer.
+
+	This is intentionally narrow: it is for byte-identical payloads whose physical
+	device buffer is carried as opaque bytes. Supported device tensors are UINT8
+	ROW_MAJOR and BFLOAT8_B TILE. The destination must be a contiguous CPU uint8
+	tensor or uint8 view with enough bytes.
+        )doc");
+
+    module.def(
+        "moreh_region_raw_gather_to_torch",
+        &fused_region_raw_gather_to_torch,
+        nb::arg("latent_tensor").noconvert(),
+        nb::arg("indexer_tensor").noconvert(),
+        nb::arg("dst").noconvert(),
+        nb::arg("slot_mapping").noconvert(),
+        nb::arg("starts"),
+        nb::arg("ends"),
+        nb::arg("memobj_slots"),
+        nb::arg("member_alloc_bytes"),
+        nb::arg("region_bases"),
+        nb::arg("member_widths"),
+        nb::arg("block_size"),
+        nb::arg("dp_size"),
+        nb::arg("blocks_per_dp"),
+        nb::arg("tp_size"),
+        nb::arg("rank"),
+        nb::kw_only(),
+        nb::arg("blocking") = true,
+        nb::arg("cq_id") = nb::none(),
+        R"doc(
+        Plan DSA region-raw runs and enqueue latent + indexer D2H gathers in one C++ call.
+
+        This avoids materializing member_runs as Python list[list[int]] and then
+        parsing them back into C++ for gather enqueue. The returned vector contains
+        copied byte counts for latent and indexer.
+        )doc");
+
+    module.def(
+        "moreh_region_raw_scatter_from_torch",
+        &fused_region_raw_scatter_from_torch,
+        nb::arg("src").noconvert(),
+        nb::arg("latent_tensor").noconvert(),
+        nb::arg("indexer_tensor").noconvert(),
+        nb::arg("slot_mapping").noconvert(),
+        nb::arg("starts"),
+        nb::arg("ends"),
+        nb::arg("memobj_slots"),
+        nb::arg("member_alloc_bytes"),
+        nb::arg("region_bases"),
+        nb::arg("member_widths"),
+        nb::arg("block_size"),
+        nb::arg("dp_size"),
+        nb::arg("blocks_per_dp"),
+        nb::arg("tp_size"),
+        nb::arg("rank"),
+        nb::kw_only(),
+        nb::arg("replicate_shards") = false,
+        nb::arg("group_axis") = 0,
+        nb::arg("shard_axis") = 1,
+        nb::arg("blocking") = true,
+        nb::arg("cq_id") = nb::none(),
+        R"doc(
+        Plan DSA region-raw runs and enqueue latent + indexer H2D scatters in one C++ call.
+
+        This avoids materializing member_runs as Python list[list[int]] and then
+        parsing them back into C++ for scatter enqueue. The returned vector contains
+        copied byte counts for latent and indexer. With replicate_shards=True,
+        dp_size/blocks_per_dp/tp_size are interpreted as
+        group_size/blocks_per_group/shard_count and rank is ignored.
+        )doc");
+
+    module.def(
+        "moreh_dsa_block_cyclic_region_raw_gather_to_torch",
+        &fused_dsa_block_cyclic_region_raw_gather_to_torch,
+        nb::arg("latent_tensor").noconvert(),
+        nb::arg("indexer_tensor").noconvert(),
+        nb::arg("dst").noconvert(),
+        nb::arg("slot_mapping").noconvert(),
+        nb::arg("starts"),
+        nb::arg("ends"),
+        nb::arg("memobj_slots"),
+        nb::arg("member_alloc_bytes"),
+        nb::arg("region_bases"),
+        nb::arg("member_widths"),
+        nb::arg("block_size"),
+        nb::arg("blocks_per_rank"),
+        nb::arg("block_cyclic_degree"),
+        nb::kw_only(),
+        nb::arg("blocking") = true,
+        nb::arg("cq_id") = nb::none(),
+        R"doc(
+        Plan GLM DSA CP block-cyclic full-block D2H gathers.
+        )doc");
+
+    module.def(
+        "moreh_dsa_block_cyclic_region_raw_scatter_from_torch",
+        &fused_dsa_block_cyclic_region_raw_scatter_from_torch,
+        nb::arg("src").noconvert(),
+        nb::arg("latent_tensor").noconvert(),
+        nb::arg("indexer_tensor").noconvert(),
+        nb::arg("slot_mapping").noconvert(),
+        nb::arg("starts"),
+        nb::arg("ends"),
+        nb::arg("memobj_slots"),
+        nb::arg("member_alloc_bytes"),
+        nb::arg("region_bases"),
+        nb::arg("member_widths"),
+        nb::arg("source_starts"),
+        nb::arg("block_size"),
+        nb::arg("blocks_per_rank"),
+        nb::arg("block_cyclic_degree"),
+        nb::kw_only(),
+        nb::arg("blocking") = true,
+        nb::arg("cq_id") = nb::none(),
+        R"doc(
+        Plan GLM DSA CP block-cyclic full-block H2D scatters.
+        )doc");
+
+    module.def(
+        "moreh_raw_byte_tp_interleaved_gather_to_torch",
+        &fused_tp_interleaved_region_raw_gather_to_torch,
+        nb::arg("cache_k").noconvert(),
+        nb::arg("cache_v").noconvert(),
+        nb::arg("dst").noconvert(),
+        nb::arg("slot_mapping").noconvert(),
+        nb::arg("starts"),
+        nb::arg("ends"),
+        nb::arg("memobj_slots"),
+        nb::arg("member_alloc_bytes"),
+        nb::arg("region_bases"),
+        nb::arg("shard_block_bytes"),
+        nb::arg("block_bytes"),
+        nb::arg("block_size"),
+        nb::arg("dp_size"),
+        nb::arg("blocks_per_dp"),
+        nb::arg("tp_size"),
+        nb::kw_only(),
+        nb::arg("blocking") = true,
+        nb::arg("cq_id") = nb::none(),
+        R"doc(
+        Plan Qwen-style TP-interleaved K/V region-raw runs and enqueue K + V D2H gathers.
+        )doc");
+
+    module.def(
+        "moreh_raw_byte_tp_interleaved_scatter_from_torch",
+        &fused_tp_interleaved_region_raw_scatter_from_torch,
+        nb::arg("src").noconvert(),
+        nb::arg("cache_k").noconvert(),
+        nb::arg("cache_v").noconvert(),
+        nb::arg("slot_mapping").noconvert(),
+        nb::arg("starts"),
+        nb::arg("ends"),
+        nb::arg("memobj_slots"),
+        nb::arg("member_alloc_bytes"),
+        nb::arg("region_bases"),
+        nb::arg("shard_block_bytes"),
+        nb::arg("block_bytes"),
+        nb::arg("block_size"),
+        nb::arg("dp_size"),
+        nb::arg("blocks_per_dp"),
+        nb::arg("tp_size"),
+        nb::kw_only(),
+        nb::arg("blocking") = true,
+        nb::arg("cq_id") = nb::none(),
+        R"doc(
+        Plan Qwen-style TP-interleaved K/V region-raw runs and enqueue K + V H2D scatters.
+        )doc");
+
+    module.def(
+        "moreh_raw_byte_copy_from_torch",
+        [](CpuUint8Tensor src,
+           ttnn::Tensor& device_tensor,
+           std::optional<uint32_t> byte_offset,
+           std::optional<uint32_t> num_bytes,
+           bool blocking,
+           std::optional<ttnn::QueueId> cq_id) {
+            validate_raw_byte_device_tensor(device_tensor, "device_tensor");
+            const auto region = validate_raw_copy_region(device_tensor, byte_offset, num_bytes, src.size());
+            write_raw_region(src, device_tensor, region, blocking, cq_id);
+        },
+        nb::arg("src").noconvert(),
+        nb::arg("device_tensor").noconvert(),
+        nb::kw_only(),
+        nb::arg("byte_offset") = std::nullopt,
+        nb::arg("num_bytes") = std::nullopt,
+        nb::arg("blocking") = true,
+        nb::arg("cq_id") = nb::none(),
+        R"doc(
+	Copy a contiguous CPU torch.uint8-compatible buffer into a raw device tensor region.
+
+	The caller is responsible for choosing a byte region aligned with the packed
+	device payload layout. Supported device tensors are UINT8 ROW_MAJOR and
+	BFLOAT8_B TILE. Set blocking=false only when the caller will separately
+	synchronize the target device before the source buffer can be reused.
+        )doc");
+}
