+
+namespace ttnn::operations::experimental::moreh_paged_fill_cache_varlen::program {
+
+using namespace tt::constants;
+
+namespace {
+
+struct CB {
+    tt::DataFormat data_format;
+    uint32_t num_tiles;
+    uint32_t id;
+    uint32_t page_size = 0;
+
+    CircularBufferConfig to_circular_buffer_config() const {
+        const auto ps = page_size > 0 ? page_size : tt::tile_size(data_format);
+        return CircularBufferConfig(num_tiles * ps, {{static_cast<tt::CBIndex>(id), data_format}})
+            .set_page_size(static_cast<tt::CBIndex>(id), ps);
+    }
+};
+
+}  // namespace
+
+MorehPagedFillCacheVarlenProgramFactory::cached_program_t MorehPagedFillCacheVarlenProgramFactory::create(
+    const operation_attributes_t&, const tensor_args_t& tensor_args, tensor_return_value_t&) {
+    const auto& k_fill = tensor_args.k_fill_value;
+    const auto& v_fill = tensor_args.v_fill_value;
+    const auto& cu_seqlens_tensor = tensor_args.cu_seqlens;
+    const auto& page_table_tensor = tensor_args.page_table;
+    const auto& start_positions_tensor = tensor_args.start_positions;
+    const auto& cache_k = tensor_args.cache_k;
+    const auto& cache_v = tensor_args.cache_v;
+
+    Program program{};
+
+    tt::DataFormat cb_data_format = tt::tt_metal::datatype_to_dataformat_converter(k_fill.dtype());
+
+    // k_fill_value / v_fill_value: [1, num_kv_heads, total_tokens, head_dim]
+    // cache_k / cache_v: [max_num_blocks, num_kv_heads, block_size, head_dim]
+    // cu_seqlens: [batch_size + 1] (ROW_MAJOR, INT32)
+    // page_table: [batch_size, max_num_blocks_per_seq] (ROW_MAJOR, INT32)
+    const uint32_t num_kv_heads = k_fill.padded_shape()[1];
+    const uint32_t total_tokens = k_fill.padded_shape()[2];
+    const uint32_t head_dim = k_fill.padded_shape()[3];
+
+    const uint32_t block_size = cache_k.padded_shape()[2];
+
+    const uint32_t total_tokens_t = total_tokens / TILE_HEIGHT;
+    const uint32_t Wt = head_dim / TILE_WIDTH;
+    const uint32_t block_size_t = block_size / TILE_HEIGHT;
+
+    // Work is distributed as: each "block of work" = one tile-row across all Wt columns
+    // Total work = num_kv_heads * total_tokens_t
+    uint32_t num_blocks_of_work = num_kv_heads * total_tokens_t;
+
+    uint32_t page_table_stick_size_B = page_table_tensor.buffer()->aligned_page_size();
+    TT_FATAL(
+        page_table_stick_size_B % 32 == 0,
+        "page table page size in bytes must be a multiple of 32 due to address alignment");
+    tt::DataFormat page_table_data_format = tt::tt_metal::datatype_to_dataformat_converter(page_table_tensor.dtype());
+
+    uint32_t cu_seqlens_stick_size_B = cu_seqlens_tensor.buffer()->aligned_page_size();
+    uint32_t start_positions_stick_size_B = start_positions_tensor.buffer()->aligned_page_size();
+    uint32_t max_batch_size = page_table_tensor.padded_shape()[0];
+
+    tt::tt_metal::IDevice* device = k_fill.device();
+
+    auto compute_with_storage_grid_size = device->compute_with_storage_grid_size();
+    uint32_t num_cores_x = compute_with_storage_grid_size.x;
+    uint32_t num_cores_y = compute_with_storage_grid_size.y;
+
+    bool row_major = true;
+    uint32_t num_cores, num_blocks_per_core_group_1, num_blocks_per_core_group_2;
+    CoreRangeSet all_cores, core_group_1, core_group_2;
+
+    std::tie(
+        num_cores, all_cores, core_group_1, core_group_2, num_blocks_per_core_group_1, num_blocks_per_core_group_2) =
+        tt::tt_metal::split_work_to_cores(compute_with_storage_grid_size, num_blocks_of_work, row_major);
+
+    // Circular Buffers
+    const auto cb_k_meta = CB{
+        .data_format = cb_data_format,
+        .num_tiles = Wt * 2,  // double buffered
+        .id = tt::CBIndex::c_0,
+    };
+    CreateCircularBuffer(program, all_cores, cb_k_meta.to_circular_buffer_config());
+
+    const auto cb_v_meta = CB{
+        .data_format = cb_data_format,
+        .num_tiles = Wt * 2,  // double buffered
+        .id = tt::CBIndex::c_1,
+    };
+    CreateCircularBuffer(program, all_cores, cb_v_meta.to_circular_buffer_config());
+
+    const auto cb_page_table_meta = CB{
+        .data_format = page_table_data_format,
+        .num_tiles = 1,
+        .id = tt::CBIndex::c_2,
+        .page_size = page_table_stick_size_B,
+    };
+    CreateCircularBuffer(program, all_cores, cb_page_table_meta.to_circular_buffer_config());
+
+    // cu_seqlens: (batch_size + 1) int32 values, stored as a single stick
+    const auto cb_cu_seqlens_meta = CB{
+        .data_format = tt::DataFormat::RawUInt32,
+        .num_tiles = 1,
+        .id = tt::CBIndex::c_3,
+        .page_size = cu_seqlens_stick_size_B,
+    };
+    CreateCircularBuffer(program, all_cores, cb_cu_seqlens_meta.to_circular_buffer_config());
+
+    // start_positions: [batch_size] int32 values, stored as a single stick
+    const auto cb_start_positions_meta = CB{
+        .data_format = tt::DataFormat::RawUInt32,
+        .num_tiles = 1,
+        .id = tt::CBIndex::c_4,
+        .page_size = start_positions_stick_size_B,
+    };
+    CreateCircularBuffer(program, all_cores, cb_start_positions_meta.to_circular_buffer_config());
+
+    auto* k_fill_buffer = k_fill.buffer();
+    auto* v_fill_buffer = v_fill.buffer();
+    auto* cache_k_buffer = cache_k.buffer();
+    auto* cache_v_buffer = cache_v.buffer();
+    auto* page_table_buffer = page_table_tensor.buffer();
+    auto* cu_seqlens_buffer = cu_seqlens_tensor.buffer();
+    auto* start_positions_buffer = start_positions_tensor.buffer();
+
+    // Reader compile-time args (positional: TensorAccessorArgs only)
+    std::vector<uint32_t> reader_compile_time_args;
+    TensorAccessorArgs(k_fill_buffer).append_to(reader_compile_time_args);
+    TensorAccessorArgs(v_fill_buffer).append_to(reader_compile_time_args);
+    TensorAccessorArgs(cu_seqlens_buffer).append_to(reader_compile_time_args);
+
+    std::unordered_map<std::string, uint32_t> reader_named_ctas = {
+        {"cb_k", cb_k_meta.id},
+        {"cb_v", cb_v_meta.id},
+        {"cb_cu_seqlens", cb_cu_seqlens_meta.id},
+        {"Wt", Wt},
+        {"total_tokens_t", total_tokens_t},
+        {"max_batch_size", max_batch_size},
+        {"cu_seqlens_stick_size", cu_seqlens_stick_size_B},
+    };
+
+    // Writer compile-time args (positional: TensorAccessorArgs only)
+    std::vector<uint32_t> writer_compile_time_args;
+    TensorAccessorArgs(cache_k_buffer).append_to(writer_compile_time_args);
+    TensorAccessorArgs(cache_v_buffer).append_to(writer_compile_time_args);
+    TensorAccessorArgs(page_table_buffer).append_to(writer_compile_time_args);
+    TensorAccessorArgs(start_positions_buffer).append_to(writer_compile_time_args);
+
+    std::unordered_map<std::string, uint32_t> writer_named_ctas = {
+        {"cb_k", cb_k_meta.id},
+        {"cb_v", cb_v_meta.id},
+        {"cb_page_table", cb_page_table_meta.id},
+        {"cb_cu_seqlens", cb_cu_seqlens_meta.id},
+        {"cb_start_positions", cb_start_positions_meta.id},
+        {"num_kv_heads", num_kv_heads},
+        {"total_tokens_t", total_tokens_t},
+        {"block_size_t", block_size_t},
+        {"Wt", Wt},
+        {"page_table_stick_size", page_table_stick_size_B},
+        {"max_batch_size", max_batch_size},
+        {"start_positions_stick_size", start_positions_stick_size_B},
+    };
+
+    tt::tt_metal::KernelHandle reader_kernel_id = tt::tt_metal::CreateKernel(
+        program,
+        "ttnn/cpp/ttnn/operations/experimental/moreh_paged_fill_cache_varlen/device/kernels/"
+        "dataflow/reader_fill_cache_varlen.cpp",
+        all_cores,
+        tt::tt_metal::ReaderDataMovementConfig(reader_compile_time_args, {}, reader_named_ctas));
+
+    tt::tt_metal::KernelHandle writer_kernel_id = tt::tt_metal::CreateKernel(
+        program,
+        "ttnn/cpp/ttnn/operations/experimental/moreh_paged_fill_cache_varlen/device/kernels/"
+        "dataflow/writer_fill_cache_varlen.cpp",
+        all_cores,
+        tt::tt_metal::WriterDataMovementConfig(writer_compile_time_args, {}, writer_named_ctas));
+
+    uint32_t g1_numcores = core_group_1.num_cores();
+    uint32_t g2_numcores = core_group_2.num_cores();
+
+    const auto& cores = grid_to_cores(num_cores, num_cores_x, num_cores_y, row_major);
+
+    for (uint32_t i = 0, num_blocks_written = 0; i < num_cores; i++) {
+        const CoreCoord& core = cores.at(i);
+        uint32_t num_blocks_per_core = 0;
+        if (i < g1_numcores) {
+            num_blocks_per_core = num_blocks_per_core_group_1;
+        } else if (i < g1_numcores + g2_numcores) {
+            num_blocks_per_core = num_blocks_per_core_group_2;
+        } else {
+            num_blocks_per_core = 0;
+        }
+
+        tt::tt_metal::SetRuntimeArgs(
+            program,
+            reader_kernel_id,
+            core,
+            {
+                k_fill_buffer->address(),
+                v_fill_buffer->address(),
+                cu_seqlens_buffer->address(),
+                num_blocks_written * Wt,  // start_tile_id
+                num_blocks_per_core,
+            });
+
+        tt::tt_metal::SetRuntimeArgs(
+            program,
+            writer_kernel_id,
+            core,
+            {
+                cache_k_buffer->address(),
+                cache_v_buffer->address(),
+                page_table_buffer->address(),
+                start_positions_buffer->address(),
+                num_blocks_written,  // start_row_num
+                num_blocks_per_core,
+            });
+        num_blocks_written += num_blocks_per_core;
+    }
+
+    return {
+        std::move(program),
+        {.reader_kernel_id = reader_kernel_id,
+         .writer_kernel_id = writer_kernel_id,
+         .num_cores = num_cores,
+         .g1_numcores = g1_numcores,
+         .g2_numcores = g2_numcores,
+         .num_blocks_per_core_group_1 = num_blocks_per_core_group_1,
+         .num_blocks_per_core_group_2 = num_blocks_per_core_group_2,
+         .Wt = Wt,
+         .cores = cores}};
+}
+
+void MorehPagedFillCacheVarlenProgramFactory::override_runtime_arguments(
+    cached_program_t& cached_program,
+    const operation_attributes_t&,
+    const tensor_args_t& tensor_args,
+    tensor_return_value_t&) {
+    auto& program = cached_program.program;
+    auto& shared_variables = cached_program.shared_variables;
+
+    auto* k_fill_buffer = tensor_args.k_fill_value.buffer();
+    auto* v_fill_buffer = tensor_args.v_fill_value.buffer();
+    auto* cu_seqlens_buffer = tensor_args.cu_seqlens.buffer();
+    auto* cache_k_buffer = tensor_args.cache_k.buffer();
+    auto* cache_v_buffer = tensor_args.cache_v.buffer();
+    auto* page_table_buffer = tensor_args.page_table.buffer();
+    auto* start_positions_buffer = tensor_args.start_positions.buffer();
+
+    auto& reader_kernel_id = shared_variables.reader_kernel_id;
+    auto& writer_kernel_id = shared_variables.writer_kernel_id;
+    auto& cores = shared_variables.cores;
+    auto& g1_numcores = shared_variables.g1_numcores;
+    auto& g2_numcores = shared_variables.g2_numcores;
+    auto& num_blocks_per_core_group_1 = shared_variables.num_blocks_per_core_group_1;
+    auto& num_blocks_per_core_group_2 = shared_variables.num_blocks_per_core_group_2;
+    auto& Wt = shared_variables.Wt;
+
+    auto& reader_args_by_core = GetRuntimeArgs(program, reader_kernel_id);
+    auto& writer_args_by_core = GetRuntimeArgs(program, writer_kernel_id);
+
+    for (uint32_t i = 0, num_blocks_written = 0; i < cores.size(); i++) {
+        const CoreCoord& core = cores.at(i);
+        uint32_t num_blocks_per_core = 0;
+        if (i < g1_numcores) {
+            num_blocks_per_core = num_blocks_per_core_group_1;
+        } else if (i < g1_numcores + g2_numcores) {
+            num_blocks_per_core = num_blocks_per_core_group_2;
+        } else {
+            num_blocks_per_core = 0;
+        }
+
+        auto& reader_args = reader_args_by_core.at(core.x).at(core.y);
+        reader_args[0] = k_fill_buffer->address();
+        reader_args[1] = v_fill_buffer->address();
+        reader_args[2] = cu_seqlens_buffer->address();
+        reader_args[3] = num_blocks_written * Wt;
+        reader_args[4] = num_blocks_per_core;
+
+        auto& writer_args = writer_args_by_core.at(core.x).at(core.y);
+        writer_args[0] = cache_k_buffer->address();
+        writer_args[1] = cache_v_buffer->address();
+        writer_args[2] = page_table_buffer->address();
+        writer_args[3] = start_positions_buffer->address();
+        writer_args[4] = num_blocks_written;
+        writer_args[5] = num_blocks_per_core;
+
+        num_blocks_written += num_blocks_per_core;
+    }
+}
+
+}  // namespace ttnn::operations::experimental::moreh_paged_fill_cache_varlen::program
