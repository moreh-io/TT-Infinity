+    const Tensor& cu_seqlens,
+    const Tensor& page_table,
+    const Tensor& start_positions,
+    const Tensor& cache_k,
+    const Tensor& cache_v) {
+    using OperationType =
+        ttnn::operations::experimental::moreh_paged_fill_cache_varlen::MorehPagedFillCacheVarlenDeviceOperation;
+    ttnn::device_operation::launch<OperationType>(
+        OperationType::operation_attributes_t{},
+        OperationType::tensor_args_t{
+            .k_fill_value = k_fill_value,
+            .v_fill_value = v_fill_value,
+            .cu_seqlens = cu_seqlens,
+            .page_table = page_table,
+            .start_positions = start_positions,
+            .cache_k = cache_k,
+            .cache_v = cache_v});
+}
