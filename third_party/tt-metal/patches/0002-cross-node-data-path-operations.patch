+namespace ttnn::operations::experimental::moreh_raw_byte_copy::detail {
+
+namespace nb = nanobind;
+
+using CpuUint8Tensor = nb::ndarray<nb::array_api, uint8_t, nb::c_contig, nb::device::cpu>;
+using CpuInt64Tensor = nb::ndarray<nb::array_api, int64_t, nb::c_contig, nb::device::cpu>;
+
+std::shared_ptr<tt::tt_metal::distributed::MeshBuffer> mesh_buffer_view(const ttnn::Tensor& tensor) {
+    const auto& backing = tensor.device_storage().get_mesh_buffer();
+    return tt::tt_metal::distributed::MeshBuffer::create(
+        backing.global_config(), backing.device_local_config(), backing.device(), backing.address());
+}
+
+bool is_supported_raw_byte_tensor(const ttnn::Tensor& tensor) {
+    const bool is_uint8_rm =
+        tensor.dtype() == tt::tt_metal::DataType::UINT8 && tensor.layout() == tt::tt_metal::Layout::ROW_MAJOR;
+    const bool is_bfp8_tile =
+        tensor.dtype() == tt::tt_metal::DataType::BFLOAT8_B && tensor.layout() == tt::tt_metal::Layout::TILE;
+    return is_uint8_rm || is_bfp8_tile;
+}
+
+void validate_raw_byte_device_tensor(const ttnn::Tensor& tensor, const char* name) {
+    const bool is_device = tensor.storage_type() == tt::tt_metal::StorageType::DEVICE;
+    TT_FATAL(is_device, "{} must be on device", name);
+
+    const bool has_buffer = tensor.buffer() != nullptr;
+    TT_FATAL(has_buffer, "{} must have a device buffer", name);
+
+    const bool is_supported = is_supported_raw_byte_tensor(tensor);
+    TT_FATAL(
+        is_supported,
+        "{} must be UINT8 ROW_MAJOR or BFLOAT8_B TILE, got dtype={} layout={}",
+        name,
+        tensor.dtype(),
+        tensor.layout());
+
+    const bool is_interleaved = tensor.memory_config().memory_layout() == tt::tt_metal::TensorMemoryLayout::INTERLEAVED;
+    TT_FATAL(is_interleaved, "{} must use interleaved memory layout", name);
+}
+
+bool is_single_coord_mesh_view(const ttnn::Tensor& tensor) {
+    return tensor.device()->num_devices() > 1 && tensor.device_storage().get_coords().size() == 1;
+}
+
+// Temporary GLM51 toy P/D support path: some raw-cache tensors can be views on a
+// single coordinate of a multi-device mesh. Keep this branch narrow until the
+// underlying mesh tensor host-copy API handles that case directly.
+void copy_single_coord_mesh_view_to_torch(
+    const ttnn::Tensor& device_tensor,
+    uint8_t* dst,
+    const std::optional<tt::tt_metal::BufferRegion>& region,
+    bool blocking,
+    std::optional<ttnn::QueueId> cq_id) {
+    const auto& coords = device_tensor.device_storage().get_coords();
+    tt::tt_metal::distributed::ShardDataTransfer transfer{coords.front()};
+    transfer.host_data(reinterpret_cast<void*>(dst)).region(region);
+    auto& cq = device_tensor.device()->mesh_command_queue(tt::tt_metal::raw_optional(cq_id));
+    cq.enqueue_read_shards({transfer}, mesh_buffer_view(device_tensor), blocking);
+}
+
+// See copy_single_coord_mesh_view_to_torch(). This mirrors the same temporary
+// shard-copy handling for host-to-device writes.
+void copy_single_coord_mesh_view_from_torch(
+    const uint8_t* src,
+    ttnn::Tensor& device_tensor,
+    const std::optional<tt::tt_metal::BufferRegion>& region,
+    bool blocking,
+    std::optional<ttnn::QueueId> cq_id) {
+    const auto& coords = device_tensor.device_storage().get_coords();
+    tt::tt_metal::distributed::ShardDataTransfer transfer{coords.front()};
+    transfer.host_data(const_cast<uint8_t*>(src)).region(region);
+    auto& cq = device_tensor.device()->mesh_command_queue(tt::tt_metal::raw_optional(cq_id));
+    cq.enqueue_write_shards(mesh_buffer_view(device_tensor), {transfer}, blocking);
+}
+
+struct RawCopyRegion {
+    uint32_t offset;
+    uint32_t bytes;
+};
+
+struct RegionRawByteRun {
+    uint32_t shard_index;
+    uint32_t device_byte_offset;
+    uint32_t num_bytes;
+    uint64_t host_byte_offset;
+};
+
+bool fits_u32(int64_t value) {
+    return value >= 0 && static_cast<uint64_t>(value) <= std::numeric_limits<uint32_t>::max();
+}
+
+bool fits_host_offset(int64_t value) {
+    return value >= 0 && static_cast<uint64_t>(value) <= std::numeric_limits<size_t>::max();
+}
+
+bool append_region_raw_member_run(
+    std::vector<RegionRawByteRun>& runs,
+    int64_t shard_index,
+    int64_t src_row,
+    int64_t rows,
+    int64_t dst_row,
+    int64_t member_width,
+    int64_t member_alloc_bytes,
+    int64_t region_base,
+    int64_t memobj_slot) {
+    const int64_t src_byte_offset = src_row * member_width;
+    const int64_t num_bytes = rows * member_width;
+    const int64_t dst_byte_offset = region_base + memobj_slot * member_alloc_bytes + dst_row * member_width;
+    if (!fits_u32(shard_index) || !fits_u32(src_byte_offset) || !fits_u32(num_bytes) ||
+        !fits_host_offset(dst_byte_offset)) {
+        return false;
+    }
+
+    RegionRawByteRun run{
+        static_cast<uint32_t>(shard_index),
+        static_cast<uint32_t>(src_byte_offset),
+        static_cast<uint32_t>(num_bytes),
+        static_cast<uint64_t>(dst_byte_offset)};
+    if (!runs.empty()) {
+        auto& prev = runs.back();
+        if (prev.shard_index == run.shard_index &&
+            static_cast<uint64_t>(prev.device_byte_offset) + prev.num_bytes == run.device_byte_offset &&
+            static_cast<uint64_t>(prev.host_byte_offset) + prev.num_bytes == run.host_byte_offset &&
+            static_cast<uint64_t>(prev.num_bytes) + run.num_bytes <= std::numeric_limits<uint32_t>::max()) {
+            prev.num_bytes += run.num_bytes;
+            return true;
+        }
+    }
+    runs.push_back(run);
+    return true;
+}
+
+bool append_region_raw_explicit_run(
+    std::vector<RegionRawByteRun>& runs,
+    int64_t shard_index,
+    int64_t device_byte_offset,
+    int64_t num_bytes,
+    int64_t host_byte_offset) {
+    if (!fits_u32(shard_index) || !fits_u32(device_byte_offset) || !fits_u32(num_bytes) ||
+        !fits_host_offset(host_byte_offset) || num_bytes <= 0) {
+        return false;
+    }
+
+    RegionRawByteRun run{
+        static_cast<uint32_t>(shard_index),
+        static_cast<uint32_t>(device_byte_offset),
+        static_cast<uint32_t>(num_bytes),
+        static_cast<uint64_t>(host_byte_offset)};
+    if (!runs.empty()) {
+        auto& prev = runs.back();
+        if (prev.shard_index == run.shard_index &&
+            static_cast<uint64_t>(prev.device_byte_offset) + prev.num_bytes == run.device_byte_offset &&
+            static_cast<uint64_t>(prev.host_byte_offset) + prev.num_bytes == run.host_byte_offset &&
+            static_cast<uint64_t>(prev.num_bytes) + run.num_bytes <= std::numeric_limits<uint32_t>::max()) {
+            prev.num_bytes += run.num_bytes;
+            return true;
+        }
+    }
+    runs.push_back(run);
+    return true;
+}
+
+int64_t mesh_shard_index(
+    int64_t group, int64_t shard, int64_t group_size, int64_t shard_count, int64_t group_axis, int64_t shard_axis) {
+    // The caller validates axes. Flatten the logical 2D mesh in row-major
+    // order: flat_index = coords[0] * axis_sizes[1] + coords[1].
+    int64_t axis_sizes[2] = {0, 0};
+    int64_t coords[2] = {0, 0};
+    axis_sizes[group_axis] = group_size;
+    axis_sizes[shard_axis] = shard_count;
+    coords[group_axis] = group;
+    coords[shard_axis] = shard;
+    return coords[0] * axis_sizes[1] + coords[1];
+}
+
+std::optional<std::vector<std::vector<RegionRawByteRun>>> build_region_raw_mesh_runs(
+    CpuInt64Tensor slot_mapping,
+    const std::vector<int64_t>& starts,
+    const std::vector<int64_t>& ends,
+    const std::vector<int64_t>& memobj_slots,
+    const std::vector<int64_t>& member_alloc_bytes,
+    const std::vector<int64_t>& region_bases,
+    const std::vector<int64_t>& member_widths,
+    int64_t block_size,
+    int64_t dp_size,
+    int64_t blocks_per_dp,
+    int64_t tp_size,
+    int64_t rank,
+    int64_t group_axis = 0,
+    int64_t shard_axis = 1) {
+    const size_t chunks = memobj_slots.size();
+    const size_t members = member_widths.size();
+    if (chunks == 0 || starts.size() != chunks || ends.size() != chunks || members == 0 ||
+        member_alloc_bytes.size() != members || region_bases.size() != members) {
+        return std::nullopt;
+    }
+    if (slot_mapping.ndim() != 1 || block_size <= 0 || dp_size <= 0 || blocks_per_dp <= 0 || tp_size <= 0 || rank < 0 ||
+        rank >= tp_size || group_axis < 0 || group_axis > 1 || shard_axis < 0 || shard_axis > 1 ||
+        group_axis == shard_axis) {
+        return std::nullopt;
+    }
+
+    std::vector<int64_t> member_rows;
+    member_rows.reserve(members);
+    for (size_t member = 0; member < members; ++member) {
+        const int64_t width = member_widths.at(member);
+        const int64_t alloc_bytes = member_alloc_bytes.at(member);
+        if (width <= 0 || alloc_bytes <= 0 || alloc_bytes % width != 0) {
+            return std::nullopt;
+        }
+        member_rows.push_back(alloc_bytes / width);
+    }
+    const int64_t target_rows = member_rows.front();
+    if (target_rows <= 0 || target_rows % block_size != 0) {
+        return std::nullopt;
+    }
+    for (int64_t rows : member_rows) {
+        if (rows != target_rows) {
+            return std::nullopt;
+        }
+    }
+
+    const int64_t num_slots = static_cast<int64_t>(slot_mapping.shape(0));
+    const int64_t rows_per_dp = blocks_per_dp * block_size;
+    const int64_t num_device_tensors = dp_size * tp_size;
+    const int64_t* slots = slot_mapping.data();
+    std::vector<std::vector<RegionRawByteRun>> member_runs(members);
+    for (size_t member = 0; member < members; ++member) {
+        member_runs[member].reserve(chunks);
+    }
+
+    for (size_t chunk = 0; chunk < chunks; ++chunk) {
+        const int64_t start = starts.at(chunk);
+        const int64_t end = ends.at(chunk);
+        if (start < 0 || end <= start || end > num_slots || end - start > target_rows) {
+            return std::nullopt;
+        }
+
+        const int64_t logical_rows = end - start;
+        const int64_t first_slot = slots[start];
+        if (first_slot < 0 || first_slot % block_size != 0) {
+            return std::nullopt;
+        }
+
+        for (int64_t row = 0; row < target_rows; row += block_size) {
+            const int64_t slot = row < logical_rows ? slots[start + row] : first_slot + row;
+            if (slot < 0 || slot % block_size != 0) {
+                return std::nullopt;
+            }
+            if (row < logical_rows) {
+                int64_t rows_to_check = logical_rows - row;
+                if (rows_to_check > block_size) {
+                    rows_to_check = block_size;
+                }
+                for (int64_t intra = 0; intra < rows_to_check; ++intra) {
+                    if (slots[start + row + intra] != slot + intra) {
+                        return std::nullopt;
+                    }
+                }
+            }
+
+            const int64_t block = slot / block_size;
+            const int64_t dp = block / blocks_per_dp;
+            if (dp < 0 || dp >= dp_size) {
+                return std::nullopt;
+            }
+            const int64_t local_src_row = (block - dp * blocks_per_dp) * block_size;
+            if (local_src_row < 0 || local_src_row + block_size > rows_per_dp) {
+                return std::nullopt;
+            }
+            const int64_t shard_index = mesh_shard_index(dp, rank, dp_size, tp_size, group_axis, shard_axis);
+            if (shard_index < 0 || shard_index >= num_device_tensors) {
+                return std::nullopt;
+            }
+
+            for (size_t member = 0; member < members; ++member) {
+                if (!append_region_raw_member_run(
+                        member_runs[member],
+                        shard_index,
+                        local_src_row,
+                        block_size,
+                        row,
+                        member_widths.at(member),
+                        member_alloc_bytes.at(member),
+                        region_bases.at(member),
+                        memobj_slots.at(chunk))) {
+                    return std::nullopt;
+                }
+            }
+        }
+    }
+
+    return member_runs;
+}
+
+std::optional<std::vector<std::vector<RegionRawByteRun>>> build_tp_interleaved_region_raw_mesh_runs(
+    CpuInt64Tensor slot_mapping,
+    const std::vector<int64_t>& starts,
+    const std::vector<int64_t>& ends,
+    const std::vector<int64_t>& memobj_slots,
+    const std::vector<int64_t>& member_alloc_bytes,
+    const std::vector<int64_t>& region_bases,
+    int64_t shard_block_bytes,
+    int64_t block_bytes,
+    int64_t block_size,
+    int64_t dp_size,
+    int64_t blocks_per_dp,
+    int64_t tp_size) {
+    const size_t chunks = memobj_slots.size();
+    const size_t members = member_alloc_bytes.size();
+    if (chunks == 0 || starts.size() != chunks || ends.size() != chunks || members == 0 ||
+        region_bases.size() != members) {
+        return std::nullopt;
+    }
+    if (slot_mapping.ndim() != 1 || shard_block_bytes <= 0 || block_bytes <= 0 || block_size <= 0 || dp_size <= 0 ||
+        blocks_per_dp <= 0 || tp_size <= 0 || block_bytes != shard_block_bytes * tp_size) {
+        return std::nullopt;
+    }
+
+    std::vector<int64_t> member_blocks;
+    member_blocks.reserve(members);
+    for (size_t member = 0; member < members; ++member) {
+        const int64_t alloc_bytes = member_alloc_bytes.at(member);
+        if (alloc_bytes <= 0 || alloc_bytes % block_bytes != 0) {
+            return std::nullopt;
+        }
+        member_blocks.push_back(alloc_bytes / block_bytes);
+    }
+
+    const int64_t num_slots = static_cast<int64_t>(slot_mapping.shape(0));
+    const int64_t num_device_tensors = dp_size * tp_size;
+    const int64_t* slots = slot_mapping.data();
+    std::vector<std::vector<RegionRawByteRun>> member_runs(members);
+
+    for (size_t chunk = 0; chunk < chunks; ++chunk) {
+        const int64_t start = starts.at(chunk);
+        const int64_t end = ends.at(chunk);
+        if (start < 0 || end < start || end > num_slots) {
+            return std::nullopt;
+        }
+        const int64_t logical_rows = end - start;
+        if (logical_rows == 0) {
+            continue;
+        }
+
+        const int64_t first_slot = slots[start];
+        if (first_slot < 0 || first_slot % block_size != 0) {
+            return std::nullopt;
+        }
+
+        std::vector<int64_t> blocks;
+        blocks.reserve((logical_rows + block_size - 1) / block_size);
+        for (int64_t pos = 0; pos < logical_rows; ++pos) {
+            const int64_t slot = slots[start + pos];
+            if (slot < 0) {
+                return std::nullopt;
+            }
+            const int64_t block = slot / block_size;
+            const int64_t intra = slot % block_size;
+            if (intra != pos % block_size) {
+                return std::nullopt;
+            }
+            if (intra == 0) {
+                blocks.push_back(block);
+            } else if (blocks.empty() || blocks.back() != block) {
+                return std::nullopt;
+            }
+        }
+
+        for (int64_t member_block_count : member_blocks) {
+            if (static_cast<int64_t>(blocks.size()) > member_block_count) {
+                return std::nullopt;
+            }
+        }
+
+        for (size_t chunk_block = 0; chunk_block < blocks.size(); ++chunk_block) {
+            const int64_t block = blocks.at(chunk_block);
+            const int64_t dp = block / blocks_per_dp;
+            const int64_t local_block = block - dp * blocks_per_dp;
+            if (dp < 0 || dp >= dp_size || local_block < 0 || local_block >= blocks_per_dp) {
+                return std::nullopt;
+            }
+            for (int64_t tp_rank = 0; tp_rank < tp_size; ++tp_rank) {
+                const int64_t shard_index = dp * tp_size + tp_rank;
+                if (shard_index < 0 || shard_index >= num_device_tensors) {
+                    return std::nullopt;
+                }
+                const int64_t device_byte_offset = local_block * shard_block_bytes;
+                const int64_t member_block_offset = static_cast<int64_t>(chunk_block) * block_bytes;
+                const int64_t tp_host_offset = tp_rank * shard_block_bytes;
+                for (size_t member = 0; member < members; ++member) {
+                    const int64_t host_byte_offset = region_bases.at(member) +
+                                                     memobj_slots.at(chunk) * member_alloc_bytes.at(member) +
+                                                     member_block_offset + tp_host_offset;
+                    if (!append_region_raw_explicit_run(
+                            member_runs.at(member),
+                            shard_index,
+                            device_byte_offset,
+                            shard_block_bytes,
+                            host_byte_offset)) {
+                        return std::nullopt;
+                    }
+                }
+            }
+        }
+    }
+
+    return member_runs;
+}
+
+std::optional<std::vector<std::vector<RegionRawByteRun>>> build_dsa_block_cyclic_region_raw_mesh_runs(
+    CpuInt64Tensor slot_mapping,
+    const std::vector<int64_t>& starts,
+    const std::vector<int64_t>& ends,
+    const std::vector<int64_t>& memobj_slots,
+    const std::vector<int64_t>& member_alloc_bytes,
+    const std::vector<int64_t>& region_bases,
+    const std::vector<int64_t>& member_widths,
+    const std::vector<int64_t>& source_starts,
+    int64_t block_size,
+    int64_t blocks_per_rank,
+    int64_t block_cyclic_degree) {
+    TT_FATAL(member_widths.size() == 2, "DSA block-cyclic raw copy expects exactly latent/indexer members");
+    TT_FATAL(member_alloc_bytes.size() == 2, "DSA block-cyclic raw copy expects exactly two member alloc sizes");
+    TT_FATAL(region_bases.size() == 2, "DSA block-cyclic raw copy expects exactly two region bases");
+    const size_t chunks = memobj_slots.size();
+    const size_t members = member_widths.size();
+    if (chunks == 0 || starts.size() != chunks || ends.size() != chunks || members == 0 ||
+        member_alloc_bytes.size() != members || region_bases.size() != members ||
+        (!source_starts.empty() && source_starts.size() != chunks)) {
+        return std::nullopt;
+    }
+    if (slot_mapping.ndim() != 1 || block_size <= 0 || blocks_per_rank <= 0 || block_cyclic_degree <= 0) {
+        return std::nullopt;
+    }
+
+    std::vector<int64_t> member_block_bytes;
+    std::vector<int64_t> member_blocks;
+    member_block_bytes.reserve(members);
+    member_blocks.reserve(members);
+    for (size_t member = 0; member < members; ++member) {
+        const int64_t width = member_widths.at(member);
+        const int64_t alloc_bytes = member_alloc_bytes.at(member);
+        if (width <= 0 || alloc_bytes <= 0) {
+            return std::nullopt;
+        }
+        const int64_t block_bytes = width * block_size;
+        if (block_bytes <= 0 || alloc_bytes % block_bytes != 0) {
+            return std::nullopt;
+        }
+        member_block_bytes.push_back(block_bytes);
+        member_blocks.push_back(alloc_bytes / block_bytes);
+    }
+    const int64_t target_blocks = member_blocks.front();
+    if (target_blocks <= 0) {
+        return std::nullopt;
+    }
+    for (int64_t blocks : member_blocks) {
+        if (blocks != target_blocks) {
+            return std::nullopt;
+        }
+    }
+
+    const int64_t num_slots = static_cast<int64_t>(slot_mapping.shape(0));
+    const int64_t* slots = slot_mapping.data();
+    auto canonical_physical_block = [&](int64_t local_virtual_block, int64_t fallback_slot) -> std::optional<int64_t> {
+        const int64_t group_start = local_virtual_block * block_size * block_cyclic_degree;
+        const int64_t group_end = std::min(group_start + block_size * block_cyclic_degree, num_slots);
+        if (group_start < 0 || group_start >= group_end) {
+            return fallback_slot / block_size;
+        }
+
+        bool have = false;
+        bool all_blocks_same = true;
+        bool all_bases_same = true;
+        int64_t first_block = 0;
+        int64_t first_base = 0;
+        for (int64_t pos = group_start; pos < group_end; ++pos) {
+            const int64_t observed_slot = slots[pos];
+            if (observed_slot < 0) {
+                continue;
+            }
+            const int64_t block = observed_slot / block_size;
+            const int64_t cp_block_offset = (pos % (block_size * block_cyclic_degree)) / block_size;
+            const int64_t base = block - cp_block_offset;
+            if (!have) {
+                first_block = block;
+                first_base = base;
+                have = true;
+                continue;
+            }
+            all_blocks_same = all_blocks_same && (block == first_block);
+            all_bases_same = all_bases_same && (base == first_base);
+        }
+        if (!have) {
+            return fallback_slot / block_size;
+        }
+        if (all_blocks_same) {
+            return first_block;
+        }
+        if (all_bases_same) {
+            return first_base;
+        }
+        return std::nullopt;
+    };
+    std::vector<std::vector<RegionRawByteRun>> member_runs(members);
+    for (size_t chunk = 0; chunk < chunks; ++chunk) {
+        const int64_t start = starts.at(chunk);
+        const int64_t end = ends.at(chunk);
+        if (start < 0 || start % block_size != 0 || end <= start || end > num_slots) {
+            return std::nullopt;
+        }
+        const int64_t logical_rows = end - start;
+        const int64_t source_start = source_starts.empty() ? 0 : source_starts.at(chunk);
+        if (source_start < 0 || source_start % block_size != 0) {
+            return std::nullopt;
+        }
+        const int64_t source_block_start = source_start / block_size;
+        const int64_t logical_blocks = (logical_rows + block_size - 1) / block_size;
+        if (source_block_start < 0 || source_block_start + logical_blocks > target_blocks) {
+            return std::nullopt;
+        }
+        const int64_t copy_blocks = logical_blocks;
+
+        const int64_t first_slot = slots[start];
+        if (first_slot < 0 || first_slot % block_size != 0) {
+            return std::nullopt;
+        }
+
+        for (int64_t chunk_block = 0; chunk_block < copy_blocks; ++chunk_block) {
+            const int64_t row = chunk_block * block_size;
+            const int64_t slot = slots[start + row];
+            if (slot < 0 || slot % block_size != 0) {
+                return std::nullopt;
+            }
+            if (row < logical_rows) {
+                int64_t rows_to_check = logical_rows - row;
+                if (rows_to_check > block_size) {
+                    rows_to_check = block_size;
+                }
+                for (int64_t intra = 0; intra < rows_to_check; ++intra) {
+                    if (slots[start + row + intra] != slot + intra) {
+                        return std::nullopt;
+                    }
+                }
+            }
+
+            // Match CacheWriteMode.BlockCyclic fill-cache semantics:
+            // token position chooses the CP owner; the page-table entry chooses
+            // the owner-local physical cache block. The slot stream may be
+            // native vLLM block ids or already DCP-local, so canonicalize the
+            // physical page-table block within the CP virtual block group.
+            const int64_t global_virtual_block = (start + row) / block_size;
+            const int64_t shard_index = global_virtual_block % block_cyclic_degree;
+            const int64_t local_virtual_block = global_virtual_block / block_cyclic_degree;
+            const auto physical_block = canonical_physical_block(local_virtual_block, slot);
+            if (!physical_block.has_value() || physical_block.value() <= 0) {
+                return std::nullopt;
+            }
+            const int64_t local_block = physical_block.value();
+            if (local_block < 0 || local_block >= blocks_per_rank) {
+                return std::nullopt;
+            }
+
+            for (size_t member = 0; member < members; ++member) {
+                const int64_t block_bytes = member_block_bytes.at(member);
+                const int64_t device_byte_offset = local_block * block_bytes;
+                const int64_t host_block = source_block_start + chunk_block;
+                const int64_t host_byte_offset = region_bases.at(member) +
+                                                 memobj_slots.at(chunk) * member_alloc_bytes.at(member) +
+                                                 host_block * block_bytes;
+                if (!append_region_raw_explicit_run(
+                        member_runs.at(member), shard_index, device_byte_offset, block_bytes, host_byte_offset)) {
+                    return std::nullopt;
+                }
+            }
+        }
+    }
+
+    return member_runs;
+}
+
+std::vector<uint32_t> member_byte_counts(const std::vector<std::vector<RegionRawByteRun>>& member_runs) {
+    std::vector<uint32_t> counts;
+    counts.reserve(member_runs.size());
+    for (const auto& runs : member_runs) {
+        uint64_t total = 0;
+        for (const auto& run : runs) {
+            total += run.num_bytes;
+            TT_FATAL(total <= std::numeric_limits<uint32_t>::max(), "region raw member bytes exceed u32");
+        }
+        counts.push_back(static_cast<uint32_t>(total));
+    }
+    return counts;
+}
+
+void gather_region_raw_runs_to_torch(
+    const ttnn::Tensor& device_tensor,
+    const CpuUint8Tensor& dst,
+    const std::vector<RegionRawByteRun>& runs,
+    bool blocking,
+    std::optional<ttnn::QueueId> cq_id,
+    const char* tensor_name) {
+    const auto shards = ttnn::distributed::get_device_tensors(device_tensor);
+    TT_FATAL(!shards.empty(), "{} has no mesh shards", tensor_name);
+    if (runs.empty()) {
+        return;
+    }
+
+    std::vector<tt::tt_metal::distributed::ShardDataTransfer> transfers;
+    transfers.reserve(runs.size());
+    for (size_t run_index = 0; run_index < runs.size(); ++run_index) {
+        const auto& run = runs.at(run_index);
+        TT_FATAL(
+            run.shard_index < shards.size(),
+            "{} gather run {} shard_index {} exceeds shard count {}",
+            tensor_name,
+            run_index,
+            run.shard_index,
+            shards.size());
+        TT_FATAL(run.num_bytes > 0, "{} gather run {} num_bytes must be > 0", tensor_name, run_index);
+
+        const auto& shard = shards.at(run.shard_index);
+        validate_raw_byte_device_tensor(shard, tensor_name);
+        const auto& coords = shard.device_storage().get_coords();
+        TT_FATAL(
+            coords.size() == 1, "{} shard {} maps to {} mesh coordinates", tensor_name, run.shard_index, coords.size());
+
+        const uint32_t shard_bytes = shard.buffer()->size();
+        TT_FATAL(
+            static_cast<uint64_t>(run.device_byte_offset) + static_cast<uint64_t>(run.num_bytes) <= shard_bytes,
+            "{} gather run {} source region [{}, {}) exceeds shard {} size {}",
+            tensor_name,
+            run_index,
+            run.device_byte_offset,
+            run.device_byte_offset + run.num_bytes,
+            run.shard_index,
+            shard_bytes);
+        const uint32_t page_size = shard.buffer()->page_size();
+        TT_FATAL(
+            run.device_byte_offset % page_size == 0 && run.num_bytes % page_size == 0,
+            "{} gather run {} source region offset={} bytes={} must align to shard page size {}",
+            tensor_name,
+            run_index,
+            run.device_byte_offset,
+            run.num_bytes,
+            page_size);
+        TT_FATAL(
+            static_cast<uint64_t>(run.host_byte_offset) + static_cast<uint64_t>(run.num_bytes) <= dst.size(),
+            "{} gather run {} dst offset {} plus copy size {} exceeds destination size {}",
+            tensor_name,
+            run_index,
+            run.host_byte_offset,
+            run.num_bytes,
+            dst.size());
+
+        const std::optional<tt::tt_metal::BufferRegion> copy_region =
+            run.device_byte_offset == 0 && run.num_bytes == shard_bytes
+                ? std::nullopt
+                : std::make_optional<tt::tt_metal::BufferRegion>(run.device_byte_offset, run.num_bytes);
+        auto transfer = tt::tt_metal::distributed::ShardDataTransfer{coords.front()}
+                            .host_data(static_cast<void*>(dst.data() + run.host_byte_offset))
+                            .region(copy_region);
+        transfers.push_back(std::move(transfer));
+    }
+
+    auto& cq = device_tensor.device()->mesh_command_queue(tt::tt_metal::raw_optional(cq_id));
+    cq.enqueue_read_shards(transfers, mesh_buffer_view(device_tensor), blocking);
+}
+
+void scatter_region_raw_runs_from_torch(
+    const CpuUint8Tensor& src,
+    ttnn::Tensor& device_tensor,
+    const std::vector<RegionRawByteRun>& runs,
+    bool blocking,
+    std::optional<ttnn::QueueId> cq_id,
+    const char* tensor_name) {
+    const auto shards = ttnn::distributed::get_device_tensors(device_tensor);
+    TT_FATAL(!shards.empty(), "{} has no mesh shards", tensor_name);
+    if (runs.empty()) {
+        return;
+    }
+
+    std::vector<tt::tt_metal::distributed::ShardDataTransfer> transfers;
+    transfers.reserve(runs.size());
+    for (size_t run_index = 0; run_index < runs.size(); ++run_index) {
+        const auto& run = runs.at(run_index);
+        TT_FATAL(
+            run.shard_index < shards.size(),
+            "{} scatter run {} shard_index {} exceeds shard count {}",
+            tensor_name,
+            run_index,
+            run.shard_index,
+            shards.size());
+        TT_FATAL(run.num_bytes > 0, "{} scatter run {} num_bytes must be > 0", tensor_name, run_index);
+
+        const auto& shard = shards.at(run.shard_index);
+        validate_raw_byte_device_tensor(shard, tensor_name);
+        const auto& coords = shard.device_storage().get_coords();
+        TT_FATAL(
+            coords.size() == 1, "{} shard {} maps to {} mesh coordinates", tensor_name, run.shard_index, coords.size());
+
+        const uint32_t shard_bytes = shard.buffer()->size();
+        TT_FATAL(
+            static_cast<uint64_t>(run.device_byte_offset) + static_cast<uint64_t>(run.num_bytes) <= shard_bytes,
+            "{} scatter run {} destination region [{}, {}) exceeds shard {} size {}",
+            tensor_name,
+            run_index,
+            run.device_byte_offset,
+            run.device_byte_offset + run.num_bytes,
+            run.shard_index,
+            shard_bytes);
+        const uint32_t page_size = shard.buffer()->page_size();
+        TT_FATAL(
+            run.device_byte_offset % page_size == 0 && run.num_bytes % page_size == 0,
+            "{} scatter run {} destination region offset={} bytes={} must align to shard page size {}",
+            tensor_name,
+            run_index,
+            run.device_byte_offset,
+            run.num_bytes,
+            page_size);
+        TT_FATAL(
+            static_cast<uint64_t>(run.host_byte_offset) + static_cast<uint64_t>(run.num_bytes) <= src.size(),
+            "{} scatter run {} src offset {} plus copy size {} exceeds source size {}",
+            tensor_name,
+            run_index,
+            run.host_byte_offset,
+            run.num_bytes,
+            src.size());
+
+        const std::optional<tt::tt_metal::BufferRegion> copy_region =
+            run.device_byte_offset == 0 && run.num_bytes == shard_bytes
+                ? std::nullopt
+                : std::make_optional<tt::tt_metal::BufferRegion>(run.device_byte_offset, run.num_bytes);
+        auto transfer = tt::tt_metal::distributed::ShardDataTransfer{coords.front()}
+                            .host_data(static_cast<void*>(src.data() + run.host_byte_offset))
+                            .region(copy_region);
+        transfers.push_back(std::move(transfer));
+    }
+
+    auto& cq = device_tensor.device()->mesh_command_queue(tt::tt_metal::raw_optional(cq_id));
+    cq.enqueue_write_shards(mesh_buffer_view(device_tensor), transfers, blocking);
+}
