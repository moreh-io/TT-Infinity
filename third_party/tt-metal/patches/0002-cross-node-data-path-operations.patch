+
+namespace ttnn::operations::experimental::moreh_paged_fill_cache_varlen::detail {
+
+namespace nb = nanobind;
+
+void bind_moreh_paged_fill_cache_varlen(nb::module_& module) {
+    ttnn::bind_function<"moreh_paged_fill_cache_varlen", "ttnn.experimental.">(
+        module,
+        R"doc(
+moreh_paged_fill_cache_varlen(
+    k_fill_value: ttnn.Tensor,
+    v_fill_value: ttnn.Tensor,
+    cu_seqlens: ttnn.Tensor,
+    page_table: ttnn.Tensor,
+    start_positions: ttnn.Tensor,
+    cache_k: ttnn.Tensor,
+    cache_v: ttnn.Tensor,
+    *,
+    mesh_coords: set[ttnn.MeshCoordinate] = None
+) -> None
+
+Fill paged KV cache in-place from packed variable-length K/V tensors.
+
+This operation fills cache_k and cache_v in-place using packed (concatenated) key/value tensors
+with variable-length sequences indicated by cu_seqlens. Supports chunked prefill via start_positions.
+
+Args:
+    * :attr:`k_fill_value`: Packed key tensor [1, num_kv_heads, total_tokens, head_dim]
+    * :attr:`v_fill_value`: Packed value tensor [1, num_kv_heads, total_tokens, head_dim]
+    * :attr:`cu_seqlens`: Cumulative sequence lengths [max_batch_size + 1], INT32, ROW_MAJOR
+    * :attr:`page_table`: Page table [batch_size, max_num_blocks_per_seq], INT32, ROW_MAJOR
+    * :attr:`start_positions`: Per-request cache start positions [batch_size], INT32, ROW_MAJOR (must be multiples of 32)
+    * :attr:`cache_k`: Paged key cache [max_num_blocks, num_kv_heads, block_size, head_dim]
+    * :attr:`cache_v`: Paged value cache [max_num_blocks, num_kv_heads, block_size, head_dim]
+
+Keyword Args:
+    * :attr:`mesh_coords`: Optional set of mesh coordinates to execute on.
+
+Example:
+    >>> ttnn.experimental.moreh_paged_fill_cache_varlen(
+    ...     k_packed, v_packed, cu_seqlens, page_table, start_positions, cache_k, cache_v)
+)doc",
+        ttnn::overload_t{
+            +[](const ttnn::Tensor& k_fill_value,
+                const ttnn::Tensor& v_fill_value,
+                const ttnn::Tensor& cu_seqlens,
+                const ttnn::Tensor& page_table,
+                const ttnn::Tensor& start_positions,
+                const ttnn::Tensor& cache_k,
+                const ttnn::Tensor& cache_v) {
+                return ttnn::experimental::moreh_paged_fill_cache_varlen(
+                    k_fill_value, v_fill_value, cu_seqlens, page_table, start_positions, cache_k, cache_v);
+            },
+            nb::arg("k_fill_value").noconvert(),
+            nb::arg("v_fill_value").noconvert(),
+            nb::arg("cu_seqlens").noconvert(),
+            nb::arg("page_table").noconvert(),
+            nb::arg("start_positions").noconvert(),
+            nb::arg("cache_k").noconvert(),
+            nb::arg("cache_v").noconvert(),
+        });
+}
+
+}  // namespace ttnn::operations::experimental::moreh_paged_fill_cache_varlen::detail
