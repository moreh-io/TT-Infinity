+
+#include "moreh_paged_fill_cache_varlen_device_operation.hpp"
+
+#include "ttnn/device_operation.hpp"
+#include "ttnn/tensor/tensor.hpp"
+
+namespace ttnn::operations::experimental::moreh_paged_fill_cache_varlen {
+
+MorehPagedFillCacheVarlenDeviceOperation::program_factory_t
+MorehPagedFillCacheVarlenDeviceOperation::select_program_factory(const operation_attributes_t&, const tensor_args_t&) {
+    return program::MorehPagedFillCacheVarlenProgramFactory{};
+}
+
+void MorehPagedFillCacheVarlenDeviceOperation::validate_on_program_cache_miss(
+    [[maybe_unused]] const operation_attributes_t& operation_attributes, const tensor_args_t& tensor_args) {
+    const auto& k_fill = tensor_args.k_fill_value;
+    const auto& v_fill = tensor_args.v_fill_value;
+    const auto& cu_seqlens = tensor_args.cu_seqlens;
+    const auto& page_table = tensor_args.page_table;
+    const auto& start_positions = tensor_args.start_positions;
+    const auto& cache_k = tensor_args.cache_k;
+    const auto& cache_v = tensor_args.cache_v;
+
+    // Device and storage validation
+    TT_FATAL(
+        k_fill.storage_type() == StorageType::DEVICE && v_fill.storage_type() == StorageType::DEVICE,
+        "k_fill_value and v_fill_value must be on device!");
+    TT_FATAL(
+        cache_k.storage_type() == StorageType::DEVICE && cache_v.storage_type() == StorageType::DEVICE,
+        "cache_k and cache_v must be on device!");
+    TT_FATAL(cu_seqlens.storage_type() == StorageType::DEVICE, "cu_seqlens must be on device!");
+    TT_FATAL(page_table.storage_type() == StorageType::DEVICE, "page_table must be on device!");
+
+    TT_FATAL(
+        k_fill.device() == cache_k.device() && v_fill.device() == cache_v.device() &&
+            k_fill.device() == v_fill.device(),
+        "All tensors must be on the same device!");
+
+    TT_FATAL(start_positions.storage_type() == StorageType::DEVICE, "start_positions must be on device!");
+
+    TT_FATAL(
+        k_fill.buffer() != nullptr && v_fill.buffer() != nullptr && cu_seqlens.buffer() != nullptr &&
+            page_table.buffer() != nullptr && start_positions.buffer() != nullptr && cache_k.buffer() != nullptr &&
+            cache_v.buffer() != nullptr,
+        "All tensors must be allocated in buffers on device!");
+
+    // Layout validation
+    TT_FATAL(k_fill.layout() == Layout::TILE, "k_fill_value must be tilized");
+    TT_FATAL(v_fill.layout() == Layout::TILE, "v_fill_value must be tilized");
+    TT_FATAL(cache_k.layout() == Layout::TILE, "cache_k must be tilized");
+    TT_FATAL(cache_v.layout() == Layout::TILE, "cache_v must be tilized");
+
+    // Data type validation — fill_value and cache must share the same dtype
+    TT_FATAL(
+        k_fill.dtype() == cache_k.dtype(),
+        "k_fill_value dtype ({}) must match cache_k dtype ({})",
+        k_fill.dtype(),
+        cache_k.dtype());
+    TT_FATAL(
+        v_fill.dtype() == cache_v.dtype(),
+        "v_fill_value dtype ({}) must match cache_v dtype ({})",
+        v_fill.dtype(),
+        cache_v.dtype());
+    TT_FATAL(
+        cache_k.dtype() == DataType::FLOAT32 || cache_k.dtype() == DataType::BFLOAT16 ||
+            cache_k.dtype() == DataType::BFLOAT8_B || cache_k.dtype() == DataType::BFLOAT4_B,
+        "cache_k dtype must be FLOAT32, BFLOAT16, BFLOAT8_B, or BFLOAT4_B, got {}",
+        cache_k.dtype());
+
+    // Memory layout validation
+    TT_FATAL(
+        cache_k.memory_config().memory_layout() == TensorMemoryLayout::INTERLEAVED,
+        "Only interleaved cache is supported");
+    TT_FATAL(
+        cache_v.memory_config().memory_layout() == TensorMemoryLayout::INTERLEAVED,
+        "Only interleaved cache is supported");
+
+    // Shape validation
+    // k_fill_value: [1, num_kv_heads, total_tokens, head_dim]
+    // v_fill_value: [1, num_kv_heads, total_tokens, head_dim]
+    // cache_k: [max_num_blocks, num_kv_heads, block_size, head_dim]
+    // cache_v: [max_num_blocks, num_kv_heads, block_size, head_dim]
+    // cu_seqlens: [batch_size + 1] (ROW_MAJOR, INT32)
+    // page_table: [batch_size, max_num_blocks_per_seq] (ROW_MAJOR, INT32)
+    TT_FATAL(k_fill.logical_shape()[0] == 1, "k_fill_value first dim must be 1, got {}", k_fill.logical_shape()[0]);
+    TT_FATAL(v_fill.logical_shape()[0] == 1, "v_fill_value first dim must be 1, got {}", v_fill.logical_shape()[0]);
+    TT_FATAL(k_fill.logical_shape()[-1] == cache_k.logical_shape()[-1], "head_dim of k_fill_value must match cache_k");
+    TT_FATAL(v_fill.logical_shape()[-1] == cache_v.logical_shape()[-1], "head_dim of v_fill_value must match cache_v");
+    TT_FATAL(
+        k_fill.logical_shape() == v_fill.logical_shape(), "k_fill_value and v_fill_value must have the same shape");
+    TT_FATAL(cache_k.logical_shape() == cache_v.logical_shape(), "cache_k and cache_v must have the same shape");
+
+    // cu_seqlens validation
+    TT_FATAL(cu_seqlens.layout() == Layout::ROW_MAJOR, "cu_seqlens must be ROW_MAJOR layout");
+    TT_FATAL(cu_seqlens.dtype() == DataType::INT32, "cu_seqlens must be INT32");
+
+    // page_table validation — INT32, DRAM (interleaved), ROW_MAJOR
+    TT_FATAL(page_table.layout() == Layout::ROW_MAJOR, "page_table must be ROW_MAJOR layout");
+    TT_FATAL(page_table.dtype() == DataType::INT32, "page_table must be INT32");
+    TT_FATAL(
+        page_table.memory_config().memory_layout() == TensorMemoryLayout::INTERLEAVED,
+        "page_table must be interleaved (DRAM)");
+
+    TT_FATAL(
+        page_table.logical_shape()[1] <= cache_k.logical_shape()[0],
+        "max_num_blocks_per_seq ({}) must be <= max_num_blocks ({})",
+        page_table.logical_shape()[1],
+        cache_k.logical_shape()[0]);
+
+    // start_positions validation — INT32, ROW_MAJOR, [batch_size]
+    TT_FATAL(start_positions.layout() == Layout::ROW_MAJOR, "start_positions must be ROW_MAJOR layout");
+    TT_FATAL(start_positions.dtype() == DataType::INT32, "start_positions must be INT32");
+    TT_FATAL(
+        start_positions.logical_shape()[0] == page_table.logical_shape()[0],
+        "start_positions size ({}) must match batch_size ({})",
+        start_positions.logical_shape()[0],
+        page_table.logical_shape()[0]);
+}
+
+void MorehPagedFillCacheVarlenDeviceOperation::validate_on_program_cache_hit(
+    const operation_attributes_t& operation_attributes, const tensor_args_t& tensor_args) {
+    validate_on_program_cache_miss(operation_attributes, tensor_args);
+}
+
+spec_return_value_t MorehPagedFillCacheVarlenDeviceOperation::compute_output_specs(
+    const operation_attributes_t&, const tensor_args_t& tensor_args) {
+    return {tensor_args.cache_k.tensor_spec(), tensor_args.cache_v.tensor_spec()};
+}
+
+tensor_return_value_t MorehPagedFillCacheVarlenDeviceOperation::create_output_tensors(
+    const operation_attributes_t&, const tensor_args_t& tensor_args) {
+    return {tensor_args.cache_k, tensor_args.cache_v};
+}
+
+std::tuple<operation_attributes_t, tensor_args_t> MorehPagedFillCacheVarlenDeviceOperation::invoke(
+    const Tensor& k_fill_value,
+    const Tensor& v_fill_value,
+    const Tensor& cu_seqlens,
+    const Tensor& page_table,
+    const Tensor& start_positions,
+    const Tensor& cache_k,
+    const Tensor& cache_v) {
+    return {
+        operation_attributes_t{},
+        tensor_args_t{
+            .k_fill_value = k_fill_value,
+            .v_fill_value = v_fill_value,
+            .cu_seqlens = cu_seqlens,
+            .page_table = page_table,
+            .start_positions = start_positions,
+            .cache_k = cache_k,
+            .cache_v = cache_v}};
+}
+
