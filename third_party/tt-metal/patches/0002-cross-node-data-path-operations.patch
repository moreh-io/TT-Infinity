index 0000000000000000000000000000000000000000..a3e5b9108f26014cc412c64c0644794272dad265
--- /dev/null
+++ b/ttnn/cpp/ttnn/operations/experimental/moreh_paged_fill_cache_varlen/device/kernels/dataflow/reader_fill_cache_varlen.cpp
@@ -0,0 +1,105 @@
+
+// SPDX-License-Identifier: Apache-2.0
+//
+// Reader kernel for moreh_paged_fill_cache_varlen
+//
+// Reads packed K and V tiles from DRAM, plus cu_seqlens for the writer to use.
+// Each core processes a contiguous range of tile-rows from the packed K/V tensors.
+
+#include <stdint.h>
+
+#include "api/dataflow/dataflow_api.h"
+
+void kernel_main() {
+    // CB IDs
+    constexpr uint32_t cb_k = get_named_compile_time_arg_val("cb_k");
+    constexpr uint32_t cb_v = get_named_compile_time_arg_val("cb_v");
+    constexpr uint32_t cb_cu_seqlens = get_named_compile_time_arg_val("cb_cu_seqlens");
+
+    // constexprs
+    constexpr uint32_t Wt = get_named_compile_time_arg_val("Wt");
+    constexpr uint32_t total_tokens_t = get_named_compile_time_arg_val("total_tokens_t");
+    constexpr uint32_t max_batch_size = get_named_compile_time_arg_val("max_batch_size");
+    constexpr uint32_t cu_seqlens_stick_size = get_named_compile_time_arg_val("cu_seqlens_stick_size");
+
+    constexpr auto k_args = TensorAccessorArgs<0>();
+    constexpr auto v_args = TensorAccessorArgs<k_args.next_compile_time_args_offset()>();
+    constexpr auto cu_seqlens_args = TensorAccessorArgs<v_args.next_compile_time_args_offset()>();
+
+    // Runtime args
+    uint32_t argidx = 0;
+    const uint32_t k_addr = get_arg_val<uint32_t>(argidx++);
+    const uint32_t v_addr = get_arg_val<uint32_t>(argidx++);
+    const uint32_t cu_seqlens_addr = get_arg_val<uint32_t>(argidx++);
+    const uint32_t start_tile_id = get_arg_val<uint32_t>(argidx++);
+    const uint32_t num_rows = get_arg_val<uint32_t>(argidx++);
+
+    const auto k_reader = TensorAccessor(k_args, k_addr, get_tile_size(cb_k));
+    const auto v_reader = TensorAccessor(v_args, v_addr, get_tile_size(cb_k));
+    const auto cu_seqlens_reader = TensorAccessor(cu_seqlens_args, cu_seqlens_addr, cu_seqlens_stick_size);
+
+    constexpr uint32_t TILE_SIZE = 32;
+    const uint32_t tile_bytes = get_tile_size(cb_k);
+    const uint32_t start_row_num = start_tile_id / Wt;
+
+    // Read cu_seqlens once into CB (shared with writer)
+    cb_reserve_back(cb_cu_seqlens, 1);
+    uint32_t cu_seqlens_l1_addr = get_write_ptr(cb_cu_seqlens);
+    uint64_t cu_seqlens_noc_addr = cu_seqlens_reader.get_noc_addr(0);
+    noc_async_read(cu_seqlens_noc_addr, cu_seqlens_l1_addr, cu_seqlens_stick_size);
+    noc_async_read_barrier();
+    cb_push_back(cb_cu_seqlens, 1);
+
+    // Find actual_total_tokens by binary searching for the -1 boundary in cu_seqlens
+    // cu_seqlens layout: [0, cs1, ..., cs_{valid_max_batch_size}, -1, -1, ...]
+    volatile tt_l1_ptr uint32_t* cu_seqlens_ptr = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(cu_seqlens_l1_addr);
+    uint32_t bs_lo = 0, bs_hi = max_batch_size;
+    while (bs_lo < bs_hi) {
+        uint32_t mid = (bs_lo + bs_hi + 1) >> 1;
+        if (cu_seqlens_ptr[mid] != (uint32_t)-1) {
+            bs_lo = mid;
+        } else {
+            bs_hi = mid - 1;
+        }
+    }
+    uint32_t actual_total_tokens = cu_seqlens_ptr[bs_lo];
+
+    // Read K and V tiles together per row
+    uint32_t tile_id = start_tile_id;
+    for (uint32_t row = 0; row < num_rows; ++row) {
+        uint32_t row_id = start_row_num + row;
+        uint32_t global_token_tile = row_id % total_tokens_t;
+        uint32_t global_token_pos = global_token_tile * TILE_SIZE;
+
+        if (global_token_pos >= actual_total_tokens) {
+            tile_id += Wt;
+            continue;  // skip DRAM read and CB push — writer will also skip
+        }
+
+        // Read K tiles
+        cb_reserve_back(cb_k, Wt);
+        uint32_t l1_write_addr = get_write_ptr(cb_k);
+        uint32_t cur_tile_id = tile_id;
+        for (uint32_t w = 0; w < Wt; ++w) {
+            noc_async_read_tile(cur_tile_id, k_reader, l1_write_addr);
+            l1_write_addr += tile_bytes;
+            cur_tile_id++;
+        }
+        noc_async_read_barrier();
+        cb_push_back(cb_k, Wt);
+
+        // Read V tiles (same tile offset, different tensor)
+        cb_reserve_back(cb_v, Wt);
+        l1_write_addr = get_write_ptr(cb_v);
+        cur_tile_id = tile_id;
+        for (uint32_t w = 0; w < Wt; ++w) {
+            noc_async_read_tile(cur_tile_id, v_reader, l1_write_addr);
+            l1_write_addr += tile_bytes;
+            cur_tile_id++;
+        }
+        noc_async_read_barrier();
+        cb_push_back(cb_v, Wt);
+
+        tile_id += Wt;
+    }
+}
diff --git a/ttnn/cpp/ttnn/operations/experimental/moreh_paged_fill_cache_varlen/device/kernels/dataflow/writer_fill_cache_varlen.cpp b/ttnn/cpp/ttnn/operations/experimental/moreh_paged_fill_cache_varlen/device/kernels/dataflow/writer_fill_cache_varlen.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..ffc08b82612a76b39c2609344376fa4f68befd45
--- /dev/null
+++ b/ttnn/cpp/ttnn/operations/experimental/moreh_paged_fill_cache_varlen/device/kernels/dataflow/writer_fill_cache_varlen.cpp
@@ -0,0 +1,199 @@
+
+// SPDX-License-Identifier: Apache-2.0
+//
+// Writer kernel for moreh_paged_fill_cache_varlen
+//
+// For each tile-row assigned to this core:
+// 1. Determine which request it belongs to via binary search on cu_seqlens
+// 2. Compute the local position within that request
+// 3. Look up the page table for that request to get the physical block
+// 4. Write K and V tiles to the correct cache location
+
+#include <stdint.h>
+
+#include "api/dataflow/dataflow_api.h"
+
+// Binary search: find the request index for a given global token position.
+// cu_seqlens is [0, len0, len0+len1, ...], size = max_batch_size + 1
+// Returns req_idx such that cu_seqlens[req_idx] <= token_pos < cu_seqlens[req_idx + 1]
+inline uint32_t find_request_idx(
+    const volatile tt_l1_ptr uint32_t* cu_seqlens_ptr, uint32_t max_batch_size, uint32_t token_pos) {
+    uint32_t lo = 0;
+    uint32_t hi = max_batch_size;  // search in [0, max_batch_size)
+    while (lo < hi) {
+        uint32_t mid = (lo + hi + 1) >> 1;
+        if (cu_seqlens_ptr[mid] <= token_pos) {
+            lo = mid;
+        } else {
+            hi = mid - 1;
+        }
+    }
+    return lo;
+}
+
+// 0 matches vLLM's null_block id (block_id=0 is reserved as null).
+constexpr uint32_t SKIP_PAGE_TABLE_ENTRY = 0;
+
+void kernel_main() {
+    // CB IDs
+    constexpr uint32_t cb_k = get_named_compile_time_arg_val("cb_k");
+    constexpr uint32_t cb_v = get_named_compile_time_arg_val("cb_v");
+    constexpr uint32_t cb_page_table = get_named_compile_time_arg_val("cb_page_table");
+    constexpr uint32_t cb_cu_seqlens = get_named_compile_time_arg_val("cb_cu_seqlens");
+    constexpr uint32_t cb_start_positions = get_named_compile_time_arg_val("cb_start_positions");
+
+    // constexprs
+    constexpr uint32_t num_kv_heads = get_named_compile_time_arg_val("num_kv_heads");
+    constexpr uint32_t total_tokens_t = get_named_compile_time_arg_val("total_tokens_t");
+    constexpr uint32_t block_size_t = get_named_compile_time_arg_val("block_size_t");
+    constexpr uint32_t Wt = get_named_compile_time_arg_val("Wt");
+    constexpr uint32_t page_table_stick_size = get_named_compile_time_arg_val("page_table_stick_size");
+    constexpr uint32_t max_batch_size = get_named_compile_time_arg_val("max_batch_size");
+    constexpr uint32_t start_positions_stick_size = get_named_compile_time_arg_val("start_positions_stick_size");
+
+    constexpr uint32_t block_stride = num_kv_heads * block_size_t * Wt;
+
+    constexpr auto cache_k_args = TensorAccessorArgs<0>();
+    constexpr auto cache_v_args = TensorAccessorArgs<cache_k_args.next_compile_time_args_offset()>();
+    constexpr auto page_table_args = TensorAccessorArgs<cache_v_args.next_compile_time_args_offset()>();
+    constexpr auto start_positions_args = TensorAccessorArgs<page_table_args.next_compile_time_args_offset()>();
+
+    // Runtime args
+    uint32_t argidx = 0;
+    const uint32_t cache_k_addr = get_arg_val<uint32_t>(argidx++);
+    const uint32_t cache_v_addr = get_arg_val<uint32_t>(argidx++);
+    const uint32_t page_table_addr = get_arg_val<uint32_t>(argidx++);
+    const uint32_t start_positions_addr = get_arg_val<uint32_t>(argidx++);
+    const uint32_t start_row_num = get_arg_val<uint32_t>(argidx++);
+    const uint32_t num_rows = get_arg_val<uint32_t>(argidx++);
+
+    const auto cache_k_writer = TensorAccessor(cache_k_args, cache_k_addr, get_tile_size(cb_k));
+    const auto cache_v_writer = TensorAccessor(cache_v_args, cache_v_addr, get_tile_size(cb_k));
+    const auto page_table_reader = TensorAccessor(page_table_args, page_table_addr, page_table_stick_size);
+    const auto start_positions_reader =
+        TensorAccessor(start_positions_args, start_positions_addr, start_positions_stick_size);
+
+    constexpr uint32_t TILE_SIZE = 32;
+    const uint32_t tile_bytes = get_tile_size(cb_k);
+
+    // Wait for cu_seqlens from reader
+    cb_wait_front(cb_cu_seqlens, 1);
+    volatile tt_l1_ptr uint32_t* cu_seqlens_ptr =
+        reinterpret_cast<volatile tt_l1_ptr uint32_t*>(get_read_ptr(cb_cu_seqlens));
+
+    // Read start_positions into CB
+    cb_reserve_back(cb_start_positions, 1);
+    uint32_t start_positions_l1_addr = get_write_ptr(cb_start_positions);
+    uint64_t start_positions_noc_addr = start_positions_reader.get_noc_addr(0);
+    noc_async_read(start_positions_noc_addr, start_positions_l1_addr, start_positions_stick_size);
+    noc_async_read_barrier();
+    cb_push_back(cb_start_positions, 1);
+    cb_wait_front(cb_start_positions, 1);
+    volatile tt_l1_ptr uint32_t* start_positions_ptr =
+        reinterpret_cast<volatile tt_l1_ptr uint32_t*>(get_read_ptr(cb_start_positions));
+
+    // Find actual_total_tokens by binary searching for the -1 boundary in cu_seqlens
+    // cu_seqlens layout: [0, cs1, ..., cs_{valid_max_batch_size}, -1, -1, ...]
+    uint32_t bs_lo = 0, bs_hi = max_batch_size;
+    while (bs_lo < bs_hi) {
+        uint32_t mid = (bs_lo + bs_hi + 1) >> 1;
+        if (cu_seqlens_ptr[mid] != (uint32_t)-1) {
+            bs_lo = mid;
+        } else {
+            bs_hi = mid - 1;
+        }
+    }
+    uint32_t actual_total_tokens = cu_seqlens_ptr[bs_lo];
+
+    // We'll cache the current request's page table to avoid reloading it every row
+    uint32_t cached_req_idx = (uint32_t)-1;
+    volatile tt_l1_ptr uint32_t* page_table_ptr = nullptr;
+    bool page_table_cached = false;
+
+    // Process K and V tiles together per row
+    for (uint32_t row_id = start_row_num; row_id < start_row_num + num_rows; ++row_id) {
+        uint32_t cur_head = row_id / total_tokens_t;
+        uint32_t global_token_tile = row_id % total_tokens_t;
+        uint32_t global_token_pos = global_token_tile * TILE_SIZE;
+
+        // Skip padding rows beyond valid token range (reader also skips these)
+        if (global_token_pos >= actual_total_tokens) {
+            continue;
+        }
+
+        // Binary search to find which request this token belongs to
+        uint32_t req_idx = find_request_idx(cu_seqlens_ptr, max_batch_size, global_token_pos);
+
+        // Load page table for this request if not cached
+        if (req_idx != cached_req_idx) {
+            if (page_table_cached) {
+                cb_pop_front(cb_page_table, 1);
+            }
+            cb_reserve_back(cb_page_table, 1);
+            uint32_t page_table_l1_addr = get_write_ptr(cb_page_table);
+            uint64_t page_table_noc_addr = page_table_reader.get_noc_addr(req_idx);
+            noc_async_read(page_table_noc_addr, page_table_l1_addr, page_table_stick_size);
+            noc_async_read_barrier();
+            cb_push_back(cb_page_table, 1);
+            cb_wait_front(cb_page_table, 1);
+            page_table_ptr = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(get_read_ptr(cb_page_table));
+            cached_req_idx = req_idx;
+            page_table_cached = true;
+        }
+
+        // Local position within request (in tokens), offset by start_positions for chunked prefill
+        uint32_t req_start_token = cu_seqlens_ptr[req_idx];
+        uint32_t local_token_pos = global_token_pos - req_start_token;
+        uint32_t cache_token_pos = local_token_pos + start_positions_ptr[req_idx];
+        uint32_t cache_seq_tile = cache_token_pos / TILE_SIZE;
+
+        // Convert virtual seq tile to physical tile id
+        uint32_t virtual_block = cache_seq_tile / block_size_t;
+        uint32_t physical_block = page_table_ptr[virtual_block];
+        uint32_t physical_tile_id = SKIP_PAGE_TABLE_ENTRY;
+        // Skip null (0) AND any negative entry. vLLM marks unused/padded slots
+        // with -1 (0xFFFFFFFF); the t3knic multi-device retrieve also uses -1 to
+        // skip the non-target DP group. Without the negative check, -1 becomes a
+        // huge physical_tile_id -> interleaved OOB write into unrelated DRAM.
+        if (physical_block != SKIP_PAGE_TABLE_ENTRY && (int32_t)physical_block >= 0) {
+            uint32_t head_offset = cur_head * block_size_t * Wt;
+            uint32_t block_offset = (cache_seq_tile % block_size_t) * Wt;
+            physical_tile_id = physical_block * block_stride + head_offset + block_offset;
+        }
+
+        // Write K tiles
+        cb_wait_front(cb_k, Wt);
+        if (physical_tile_id != SKIP_PAGE_TABLE_ENTRY) {
+            uint32_t l1_read_addr = get_read_ptr(cb_k);
+            uint32_t k_phys_id = physical_tile_id;
+            for (uint32_t w = 0; w < Wt; ++w) {
+                noc_async_write_tile(k_phys_id, cache_k_writer, l1_read_addr);
+                l1_read_addr += tile_bytes;
+                k_phys_id += 1;
+            }
+            noc_async_write_barrier();
+        }
+        cb_pop_front(cb_k, Wt);
+
+        // Write V tiles (same physical location, different cache)
+        cb_wait_front(cb_v, Wt);
+        if (physical_tile_id != SKIP_PAGE_TABLE_ENTRY) {
+            uint32_t l1_read_addr = get_read_ptr(cb_v);
+            uint32_t v_phys_id = physical_tile_id;
+            for (uint32_t w = 0; w < Wt; ++w) {
+                noc_async_write_tile(v_phys_id, cache_v_writer, l1_read_addr);
+                l1_read_addr += tile_bytes;
+                v_phys_id += 1;
+            }
+            noc_async_write_barrier();
+        }
+        cb_pop_front(cb_v, Wt);
+    }
+
+    // Done with metadata buffers
+    if (page_table_cached) {
+        cb_pop_front(cb_page_table, 1);
+    }
+    cb_pop_front(cb_cu_seqlens, 1);
+    cb_pop_front(cb_start_positions, 1);
+}
diff --git a/ttnn/cpp/ttnn/operations/experimental/moreh_paged_fill_cache_varlen/device/moreh_paged_fill_cache_varlen_device_operation.cpp b/ttnn/cpp/ttnn/operations/experimental/moreh_paged_fill_cache_varlen/device/moreh_paged_fill_cache_varlen_device_operation.cpp
