+std::vector<uint32_t> replicated_region_raw_scatter_from_torch(
+    CpuUint8Tensor src,
+    ttnn::Tensor& latent_tensor,
+    ttnn::Tensor& indexer_tensor,
+    CpuInt64Tensor slot_mapping,
+    const std::vector<int64_t>& starts,
+    const std::vector<int64_t>& ends,
+    const std::vector<int64_t>& memobj_slots,
+    const std::vector<int64_t>& member_alloc_bytes,
+    const std::vector<int64_t>& region_bases,
+    const std::vector<int64_t>& member_widths,
+    int64_t block_size,
+    int64_t group_size,
+    int64_t blocks_per_group,
+    int64_t shard_count,
+    int64_t group_axis,
+    int64_t shard_axis,
+    bool blocking,
+    std::optional<ttnn::QueueId> cq_id) {
+    validate_raw_byte_device_tensor(latent_tensor, "latent_tensor");
+    validate_raw_byte_device_tensor(indexer_tensor, "indexer_tensor");
+    TT_FATAL(group_size > 0, "replicated raw-byte shard scatter requires group_size > 0");
+    TT_FATAL(shard_count > 0, "replicated raw-byte shard scatter requires shard_count > 0");
+    const auto latent_shards = ttnn::distributed::get_device_tensors(latent_tensor);
+    const auto indexer_shards = ttnn::distributed::get_device_tensors(indexer_tensor);
+    TT_FATAL(!latent_shards.empty(), "latent_tensor has no mesh shards");
+    TT_FATAL(!indexer_shards.empty(), "indexer_tensor has no mesh shards");
+    TT_FATAL(
+        latent_shards.size() == indexer_shards.size(),
+        "replicated raw-byte shard scatter requires matching latent/indexer shard counts, got {} and {}",
+        latent_shards.size(),
+        indexer_shards.size());
+    const uint64_t expected_shards = static_cast<uint64_t>(group_size) * static_cast<uint64_t>(shard_count);
+    TT_FATAL(
+        expected_shards == latent_shards.size(),
+        "replicated raw-byte shard scatter group_size={} shard_count={} maps to {} shards, but tensors have {} shards",
+        group_size,
+        shard_count,
+        expected_shards,
+        latent_shards.size());
+
+    std::vector<std::vector<RegionRawByteRun>> all_member_runs(2);
+    for (int64_t shard = 0; shard < shard_count; ++shard) {
+        auto member_runs = build_region_raw_mesh_runs(
+            slot_mapping,
+            starts,
+            ends,
+            memobj_slots,
+            member_alloc_bytes,
+            region_bases,
+            member_widths,
+            block_size,
+            group_size,
+            blocks_per_group,
+            shard_count,
+            shard,
+            group_axis,
+            shard_axis);
+        TT_FATAL(member_runs.has_value(), "replicated raw-byte shard scatter cannot represent shard {}", shard);
+        TT_FATAL(member_runs->size() == 2, "replicated raw-byte shard scatter expects exactly two member run lists");
+        for (std::size_t member = 0; member < all_member_runs.size(); ++member) {
+            all_member_runs[member].insert(
+                all_member_runs[member].end(), member_runs->at(member).begin(), member_runs->at(member).end());
+        }
+    }
+    scatter_region_raw_runs_from_torch(
+        src, latent_tensor, all_member_runs.at(0), blocking, cq_id, "latent_tensor shards");
+    scatter_region_raw_runs_from_torch(
+        src, indexer_tensor, all_member_runs.at(1), blocking, cq_id, "indexer_tensor shards");
+    return member_byte_counts(all_member_runs);
+}
